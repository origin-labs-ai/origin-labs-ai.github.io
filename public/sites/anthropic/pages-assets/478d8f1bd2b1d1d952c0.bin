,[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}]}]\n92:T54f,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003eimport\u003c/span\u003e anthropic\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003eclient \u003cspan class=\"lk\"\u003e=\u003c/span\u003e anthropic.Anthropic()\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003emessage \u003cspan class=\"lk\"\u003e=\u003c/span\u003e client.messages.create(\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lj dc\"\u003e    model\u003c/span\u003e\u003cspan class=\"lk\"\u003e=\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"claude-opus-5-5\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lj dc\"\u003e    max_tokens\u003c/span\u003e\u003cspan class=\"lk\"\u003e=\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e1024\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lj dc\"\u003e    messages\u003c/span\u003e\u003cspan class=\"lk\"\u003e=\u003c/span\u003e[\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l3 dn\"\u003e            \"role\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"user\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l3 dn\"\u003e            \"content\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"Hello, Claude\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    ],\u003c/span\u003e\n\u003cspan class=\"line\"\u003e)\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003efor\u003c/span\u003e block \u003cspan class=\"lk dl\"\u003ein\u003c/span\u003e message.content:\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e    if\u003c/span\u003e block.type \u003cspan class=\"lk\"\u003e==\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"text\"\u003c/span\u003e:\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 dt\"\u003e        print\u003c/span\u003e(block.text)\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e93:T777,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003eimport\u003c/span\u003e\u003cspan class=\"dc\"\u003e Anthropic\u003c/span\u003e\u003cspan class=\"lk dl\"\u003e from\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"@anthropic-ai/sdk\"\u003c/span\u003e;\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003econst\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e client\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"lk d4\"\u003e new\u003c/span\u003e\u003cspan class=\"li dt\"\u003e Anthropic\u003c/span\u003e();\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003econst\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e msg\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"lk dl\"\u003e await\u003c/span\u003e\u003cspan class=\"dc\"\u003e client\u003c/span\u003e.\u003cspan class=\"dc\"\u003emessages\u003c/span\u003e.\u003cspan class=\"li dt\"\u003ecreate\u003c/span\u003e({\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e  model:\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"claude-opus-5-5\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e  max_tokens:\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e 1024\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e  messages:\u003c/span\u003e [\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e      role:\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"user\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e      content:\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"Hello, Claude\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e  ]\u003c/span\u003e\n\u003cspan class=\"line\"\u003e});\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003efor\u003c/span\u003e (\u003cspan class=\"lk d4\"\u003econst\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e block\u003c/span\u003e\u003cspan class=\"lk d4\"\u003e of\u003c/span\u003e\u003cspan class=\"dc\"\u003e msg\u003c/span\u003e.\u003cspan class=\"dc\"\u003econtent\u003c/span\u003e) {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e  if\u003c/span\u003e (\u003cspan class=\"dc\"\u003eblock\u003c/span\u003e.\u003cspan class=\"dc\"\u003etype\u003c/span\u003e\u003cspan class=\"lk\"\u003e ===\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"text\"\u003c/span\u003e) {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e    console\u003c/span\u003e.\u003cspan class=\"li dt\"\u003elog\u003c/span\u003e(\u003cspan class=\"dc\"\u003eblock\u003c/span\u003e.\u003cspan class=\"dc\"\u003etext\u003c/span\u003e);\u003c/span\u003e\n\u003cspan class=\"line\"\u003e  }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e}\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e6c:[\"$\",\"$L8c\",null,{\"serverPath\":\"/docs/en/home\",\"children\":[null,[null,[[\"$\",\"div\",\"0\",{\"className\":\"min-h-screen\",\"data-testid\":\"docs-home-page\",\"children\":[[\"$\",\"section\",\"0\",{\"className\":\"mx-auto max-w-6xl px-xl @container/hero pt-16 print:pt-4\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-start gap