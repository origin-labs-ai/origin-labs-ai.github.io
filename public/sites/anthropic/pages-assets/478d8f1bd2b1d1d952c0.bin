<span class="line"></span>
<span class="line">client <span class="lk">=</span> anthropic.Anthropic()</span>
<span class="line"></span>
<span class="line">message <span class="lk">=</span> client.messages.create(</span>
<span class="line"><span class="lj dc">    model</span><span class="lk">=</span><span class="l3 dn">"claude-opus-5-5"</span>,</span>
<span class="line"><span class="lj dc">    max_tokens</span><span class="lk">=</span><span class="l1 di">1024</span>,</span>
<span class="line"><span class="lj dc">    messages</span><span class="lk">=</span>[</span>
<span class="line">        {</span>
<span class="line"><span class="l3 dn">            "role"</span>: <span class="l3 dn">"user"</span>,</span>
<span class="line"><span class="l3 dn">            "content"</span>: <span class="l3 dn">"Hello, Claude"</span>,</span>
<span class="line">        }</span>
<span class="line">    ],</span>
<span class="line">)</span>
<span class="line"><span class="lk dl">for</span> block <span class="lk dl">in</span> message.content:</span>
<span class="line"><span class="lk dl">    if</span> block.type <span class="lk">==</span><span class="l3 dn"> "text"</span>:</span>
<span class="line"><span class="l1 dt">        print</span>(block.text)</span></code></pre></div></div></div></div></div></div></div></div></section><section class="mx-auto max-w-6xl px-xl flex flex-col gap-lg pt-8 pb-12"><div class="flex flex-col gap-xs"><div class="text-caption font-medium text-muted">Platform</div><h2 class="text-title font-medium text-primary">Choose how you build</h2><p class="max-w-lg text-heading text-secondary">Pick the developer surface that matches your approach, and the infrastructure that fits your stack.</p></div><div class="grid grid-cols-1 gap-lg lg:grid-cols-2"><div data-cds="Card" data-size="lg" class="group/card relative isolate flex flex-col rounded-card after:pointer-events-none after:absolute after:inset-0 after:rounded-[inherit] after:shadow-card-ring after:content-[&#x27;&#x27;] has-[[data-cds=CardLink]:focus-visible]:after:shadow-focus stacks:after:transform-none! stacks:[&amp;&gt;.cds-card-fill]:transform-none! stacks:[--cds-card-press-d:0px] stacks:has-[[data-cds=CardLink]:active]:after:bg-neutral-hover stacks:not-contrast-more:after:shadow-none stacks:has-[[data-cds=CardLink]]:after:shadow-none stacks:not-contrast-more:[&amp;&gt;.cds-card-fill]:bg-fill-card stacks:has-[[data-cds=CardLink]]:after:bg-fill-card stacks:has-[[data-cds=CardLink]]:not-has-[[data-cds=CardLink]:active]:hover:after:bg-neutral stacks:has-[[data-cds=CardLink]]:[&amp;&gt;.cds-card-fill]:bg-transparent stacks:has-[[data-cds=CardLink]]:not-has-[[data-cds=CardLink]:active]:hover:[&amp;&gt;.cds-card-fill:not(.bg-surface-2)]:[--cds-surface-2:var(--cds-fizzy-lake-color-card-hover)] gap-lg"><span aria-hidden="true" class="cds-card-fill pointer-events-none absolute inset-0 -z-[1] m-0 rounded-[inherit]"></span><div data-cds-card-body="" class="cds-card-body flex min-h-0 flex-1 flex-col self-stretch [gap:inherit] [align-items:inherit] [justify-content:inherit] rounded-[inherit] p-lg"><div data-cds="CardMedia" class="self-stretch -mx-pad-lg overflow-hidden first: