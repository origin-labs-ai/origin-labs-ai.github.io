03e    MaxTokens\u003c/span\u003e: \u003cspan class=\"l1 di\"\u003e1024\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e    Messages\u003c/span\u003e: []\u003cspan class=\"lj d2\"\u003eanthropic\u003c/span\u003e.\u003cspan class=\"lj d2\"\u003eMessageParam\u003c/span\u003e{\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e      anthropic\u003c/span\u003e.\u003cspan class=\"li dt\"\u003eNewUserMessage\u003c/span\u003e(\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e        anthropic\u003c/span\u003e.\u003cspan class=\"li dt\"\u003eNewTextBlock\u003c/span\u003e(\u003cspan class=\"l3 dn\"\u003e\"Hello, Claude\"\u003c/span\u003e),\u003c/span\u003e\n\u003cspan class=\"line\"\u003e      ),\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e  },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e)\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003efor\u003c/span\u003e\u003cspan class=\"dc\"\u003e _\u003c/span\u003e, \u003cspan class=\"dc\"\u003eblock\u003c/span\u003e\u003cspan class=\"lk\"\u003e :=\u003c/span\u003e\u003cspan class=\"lk dl\"\u003e range\u003c/span\u003e\u003cspan class=\"dc\"\u003e msg\u003c/span\u003e.\u003cspan class=\"dc\"\u003eContent\u003c/span\u003e {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e  if\u003c/span\u003e\u003cspan class=\"dc\"\u003e textBlock\u003c/span\u003e, \u003cspan class=\"dc\"\u003eok\u003c/span\u003e\u003cspan class=\"lk\"\u003e :=\u003c/span\u003e\u003cspan class=\"dc\"\u003e block\u003c/span\u003e.\u003cspan class=\"li dt\"\u003eAsAny\u003c/span\u003e().(\u003cspan class=\"lj d2\"\u003eanthropic\u003c/span\u003e.\u003cspan class=\"lj d2\"\u003eTextBlock\u003c/span\u003e); \u003cspan class=\"dc\"\u003eok\u003c/span\u003e {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e    fmt\