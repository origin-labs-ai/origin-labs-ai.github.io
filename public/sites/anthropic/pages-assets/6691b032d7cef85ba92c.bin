003cspan class=\"l3 dn\"\u003e\"example.com\"\u003c/span\u003e, \u003cspan class=\"l3 dn\"\u003e\"trusteddomain.org\"\u003c/span\u003e],\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e  // Optional: Never include results from these domains\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"blocked_domains\"\u003c/span\u003e: [\u003cspan class=\"l3 dn\"\u003e\"untrustedsource.com\"\u003c/span\u003e],\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e  // Optional: Localize search results\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"user_location\"\u003c/span\u003e: {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e    \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"approximate\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e    \"city\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"San Francisco\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e    \"region\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"California\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e    \"country\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"US\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e    \"timezone\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"America/Los_Angeles\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e  }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e}\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003ec1:[\"$\",\"$L120\",\"64\",{\"language\":\"json\",\"label\":\"JSON\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L10d\",null,{\"wrap\":false,\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$121\"}}]}]}]\nc2:[\"$\",\"p\",\"66\",{\"children\":[\"All web search tool versions accept \",[\"$\",\"code\",\"1\",{\"children\":[\"allowed_callers\"]}],\", which controls whether Claude calls web search directly or from code execution through \",[\"$\",\"$Laa\",\"3\",{\"href\":\"#dynamic-filtering\",\"untracked\":false,\"children\":[\"dynamic filtering\"]}],\". On \",[\"$\",\"code\",\"5\",{\"children\":[\"web_search_20260209\"]}],\" and later it defaults to \",[\"$\",\"code\",\"7\",{\"children\":[\"[\\\"code_execution_20260120\\\"]\"]}],\" instead of \",[\"$\",\"code\",\"9\",{\"children\":[\"[\\\"direct\\\"]\"]}],\". See \",[\"$\",\"$Laa\",\"11\",{\"href\":\"/docs/en/agents-and-tools/tool-use/server-tools#zdr-and-allowed-callers\",\"untracked\":false,\"children\":[\"ZDR and allowed_callers\"]}],\" for how to configure it. \",[\"$\",\"code\",\"13\",{\"children\":[\"web_search_20260318\"]}],\" and later also accept \",[\"$\",\"$Laa\",\"15\",{\"href\":\"#response-inclusion\",\"untracked\":false,\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"response_inclusion\"]}]]}],\".\"]}]\nc3:[\"$\",\"h3\",\"68\",{\"id\":\"max-uses\",\"className\":\"group\",\"children\":[[\"Max uses\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Lac\",null,{\"id\":\"max-uses\",\"name\":\"Max uses\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nc4:[\"$\",\"p\",\"70\",{\"children\":[\"The \",[\"$\",\"code\",\"1\",{\"children\":[\"max_uses\"]}],\" parameter limits the number of searches in a single turn. Single-fact queries typically use 1–3 searches; comparative or multientity research can use 10 or more.\"]}]\nc5:[\"$\",\"p\",\"72\",{\"children\":[\"Failed searches count against the limit. If Claude calls web search directly more times than allowed, the \",[\"$\",\"code\",\"1\",{\"children\":[\"web_search_tool_result\"]}],\" is an error with the \",[\"$\",\"code\",\"3\",{\"children\":[\"max_uses_exceeded\"]}],\" error code. If Claude calls web search from code execution more times than allowed, the code execution run ends with an error.\"]}]\nc6:[\"$\",\"p\",\"74\",{\"children\":[\"A turn can span several requests. A request continues a turn when it resumes after \",[\"$\",\"$Laa\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/server-tools#the-server-side-loop-and-pause-turn\",\"untracked\":false,\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"pause_turn\"]}]]}],\" or when its last message contains only \",[\"$\",\"code\",\"3\",{\"children\":[\"tool_result\"]}],\" blocks. Searches from earlier requests in that turn count against the limit, unless Claude ran them from code execution through \",[\"$\",\"$Laa\",\"5\",{\"href\":\"#dynamic-filtering\",\"untracked\":false,\"children\":[\"dynamic filtering\"]}],\".\"]}]\nc7:[\"$\",\"h3\",\"76\",{\"id\":\"domain-filtering\",\"className\":\"group\",\"children\":[[\"Domain filtering\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Lac\",null,{\"id\":\"domain-filtering\",\"name\":\"Domain filtering\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nc8:[\"$\",\"p\",\"78\",{\"children\":[\"Provide \",[\"$\",\"code\",\"1\",{\"children\":[\"allowed_domains\"]}],\" or \",[\"$\",\"code\",\"3\",{\"children\":[\"blocked_domains\"]}],\", not both. If a request includes both, the API returns a 400 error. Entries are bare domains with an optional path, for example \",[\"$\",\"code\",\"5\",{\"children\":[\"example.com\"]}],\" or \",[\"$\",\"code\",\"7\",{\"children\":[\"example.com/blog\"]}],\", without a scheme.\"]}]\nc9:[\"$\",\"p\",\"80\",{\"children\":[\"For the full domain filtering rules, see \",[\"$\",\"$Laa\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/server-tools#domain-filtering\",\"untracked\":false,\"children\":[\"Domain filtering\"]}],\" in the Server tools guide.\"]}]\nca:[\"$\",\"p\",\"82\",{\"children\":[\"On \",[\"$\",\"$Laa\",\"1\",{\"href\":\"/docs/en/managed-agents/overview\",\"untracked\":false,\"children\":[\"Claude Managed Agents\"]}],\", set these fields on the \",[\"$\",\"code\",\"3\",{\"children\":[\"web_search\"]}],\" entry of the agent toolset; see \",[\"$\",\"$Laa\",\"5\",{\"href\":\"/docs/en/managed-agents/tools-web-restrictions\",\"untracked\":false,\"children\":[\"Restrict web search and web fetch domains\"]}],\".\"]}]\ncb:[\"$\",\"h3\",\"84\",{\"id\":\"localization\",\"className\":\"group\",\"children\":[[\"Localization\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Lac\",null,{\"id\":\"localization\",\"name\":\"Localization\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ncc:[\"$\",\"p\",\"86\",{\"children\":[\"The \",[\"$\",\"code\",\"1\",{\"children\":[\"user_location\"]}],\" parameter allows you to localize search results based on a user’s location. Provide at least one of \",[\"$\",\"code\",\"3\",{\"children\":[\"city\"]}],\", \",[\"$\",\"code\",\"5\",{\"children\":[\"region\"]}],\", \",[\"$\",\"code\",\"7\",{\"children\":[\"country\"]}],\", or \",[\"$\",\"code\",\"9\",{\"children\":[\"timezone\"]}],\".\"]}]\ncd:[\"$\",\"ul\",\"88\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"type\"]}],\": The type of location (must be \",[\"$\",\"code\",\"2\",{\"children\":[\"approximate\"]}],\")\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"city\"]}],\": The city name\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"region\"]}],\": The region or state\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"country\"]}],\": The two-letter \",[\"$\",\"$Laa\",\"2\",{\"href\":\"https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2\",\"untracked\":false,\"children\":[\"ISO 3166-1 alpha-2\"]}],\" country code (the API rejects an unsupported code with a 400 error)\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"timezone\"]}],\": The \",[\"$\",\"$Laa\",\"2\",{\"href\":\"https://en.wikipedia.org/wiki/List_of_tz_database_time_zones\",\"untracked\":false,\"children\":[\"IANA time zone ID\"]}]]}],\"\\n\"]}]\nce:[\"$\",\"p\",\"90\",{\"children\":[\"On Claude Managed Agents, the \",[\"$\",\"code\",\"1\",{\"children\":[\"web_search\"]}],\" entry of the agent toolset also accepts \",[\"$\",\"code\",\"3\",{\"children\":[\"user_location\"]}],\"; see the \",[\"$\",\"$Laa\",\"5\",{\"href\":\"/docs/en/managed-agents/tools-web-restrictions#settings\",\"untracked\":false,\"children\":[\"web tool settings\"]}],\".\"]}]\ncf:[\"$\",\"h3\",\"92\",{\"id\":\"response-inclusion\",\"className\":\"group\",\"children\":[[\"Response inclusion\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Lac\",null,{\"id\":\"response-inclusion\",\"name\":\"Response inclusion\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nd0:[\"$\",\"$Lab\",\"94\",{\"variant\":\"muted\",\"id\":\"$undefined\",\"icon\":\"$undefined\",\"className\":\"prose-block print:break-inside-avoid print:[:is(h2,h3,h4)+\u0026]:break-after-avoid\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"Requires \",[\"$\",\"code\",\"1\",{\"children\":[\"web_search_20260318\"]}],\" or later.\"]}]]}]\nd1:[\"$\",\"p\",\"96\",{\"children\":[\"The \",[\"$\",\"code\",\"1\",{\"children\":[\"response_inclusion\"]}],\" parameter controls how search result blocks appear in the API response when a completed \",[\"$\",\"$Laa\",\"3\",{\"href\":\"/docs/en/agents-and-tools/tool-use/code-execution-tool\",\"untracked\":false,\"children\":[\"code execution\"]}],\" call in the same response consumed the result. Set \",[\"$\",\"code\",\"5\",{\"children\":[\"\\\"response_inclusion\\\": \\\"excluded\\\"\"]}],\" to drop those nested \",[\"$\",\"code\",\"7\",{\"children\":[\"server_tool_use\"]}],\" and result block pairs entirely from the response, for agentic workflows that don’t need the raw search content. Token usage is unaffected, because Claude reads the code’s output rather than these blocks. The default is \",[\"$\",\"code\",\"9\",{\"children\":[\"\\\"full\\\"\"]}],\". The API always returns results from direct calls, or from code execution calls that paused before completing, in full so that you can send them back in the next request.\"]}]\nd2:[\"$\",\"$L120\",\"98\",{\"language\":\"json\",\"label\":\"JSON\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L10d\",null,{\"wrap\":false,\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cpre class=\\\"shiki\\\"\u003e\u003ccode\u003e\u003cspan class=\\\"line\\\"\u003e{\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"tools\\\"\u003c/span\u003e: [\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e    {\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e      \\\"type\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"web_search_20260318\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e      \\\"name\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"web_search\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e      \\\"response_inclusion\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"excluded\\\"\u003c/span\u003e\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e    }\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e  ]\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e}\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\"}}]}]}]\nd3:[\"$\",\"h2\",\"100\",{\"id\":\"response\",\"className\":\"group\",\"children\":[[\"Response\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Lac\",null,{\"id\":\"response\",\"name\":\"Response\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nd4:[\"$\",\"p\",\"102\",{\"children\":[\"Here’s an example response structure:\"]}]\n122:T1418,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e{\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"role\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"assistant\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"content\"\u003c/span\u003e: [\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e    // 1. Claude's decision to search\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"text\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"text\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"I'll search for when Claude Shannon was born.\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e    // 2. The search query used\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"server_tool_use\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"id\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"srvtoolu_01WYG3ziw53XMcoyKL4XcZmE\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"name\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"web_search\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"input\"\u003c/span\u003e: {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e        \"query\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"claude shannon birth date\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e      }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e    // 3. Search results\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"web_search_tool_result\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"tool_use_id\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"srvtoolu_01WYG3ziw53XMcoyKL4XcZmE\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"content\"\u003c/span\u003e: [\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"web_search_result\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"url\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"https://en.wikipedia.org/wiki/Claude_Shannon\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"title\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"Claude Shannon - Wikipedia\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"encrypted_content\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"EqgfCioIARgBIiQ3YTAwMjY1Mi1mZjM5LTQ1NGUtODgxNC1kNjNjNTk1ZWI3Y...\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"page_age\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"April 30, 2025\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e      ]\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"text\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"Based on the search results, \"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"text\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e    // 4. Claude's response with citations\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"text\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"Claude Shannon was born on April 30, 1916, in Petoskey, Michigan\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"text\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"citations\"\u003c/span\u003e: [\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"web_search_result_location\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"url\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"https://en.wikipedia.org/wiki/Claude_Shannon\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"title\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"Claude Shannon - Wikipedia\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"encrypted_index\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"Eo8BCioIAhgBIiQyYjQ0OWJmZi1lNm..\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"cited_text\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"Claude Elwood Shannon (April 30, 1916 – February 24, 2001) was an American mathematician, electrical engineer, computer scientist, cryptographer and i...\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e      ]\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e  ],\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"id\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"msg_a930390d3a\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"usage\"\u003c/span\u003e: {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e    \"input_tokens\"\u003c/span\u003e: \u003cspan class=\"l1 di\"\u003e6039\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e    \"output_tokens\"\u003c/span\u003e: \u003cspan class=\"l1 di\"\u003e931\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e    \"server_tool_use\"\u003c/span\u003e: {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"web_search_requests\"\u003c/span\u003e: \u003cspan class=\"l1 di\"\u003e1\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e  },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"stop_reason\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"end_turn\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e}\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003ed5:[\"$\",\"$L120\",\"104\",{\"language\":\"json\",\"label\":\"Output\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L10d\",null,{\"wrap\":false,\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$122\"}}]}]}]\nd6:[\"$\",\"p\",\"106\",{\"children\":[\"This example shows a direct search. When a search runs through \",[\"$\",\"$Laa\",\"1\",{\"href\":\"#dynamic-filtering\",\"untracked\":false,\"children\":[\"dynamic filtering\"]}],\", the response also contains the result blocks of the \",[\"$\",\"