alse,\"children\":[\"error code\"]}],\" inside a search result.\"]}]]}]\nbc:[\"$\",\"p\",\"54\",{\"children\":[\"For how your organization’s web search settings apply in Claude Managed Agents sessions, see \",[\"$\",\"$Laa\",\"1\",{\"href\":\"/docs/en/managed-agents/tools-web-restrictions\",\"untracked\":false,\"children\":[\"Restrict web search and web fetch domains\"]}],\".\"]}]\nbd:[\"$\",\"p\",\"56\",{\"children\":[\"Provide the web search tool in your API request:\"]}]\n117:Ta60,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"lj dt\"\u003ecurl\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e https://api.anthropic.com/v1/messages\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -H\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"\u003c/span\u003e\u003cspan class=\"l4 dd\"\u003ex-api-key\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"dc\"\u003e$ANTHROPIC_API_KEY\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -H\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"\u003c/span\u003e\u003cspan class=\"l4 dd\"\u003eanthropic-version\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l2 dv\"\u003e2026-10-21\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -H\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"\u003c/span\u003e\u003cspan class=\"l4 dd\"\u003econtent-type\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003eapplication/json\"\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -d\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e '\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"model\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"claude-opus-5-5\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"max_tokens\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l2 dk\"\u003e4096\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"messages\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: [\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e      {\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e        \"role\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"user\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e        \"content\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"What is the weather in NYC?\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e      }\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e    ],\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"tools\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: [{\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan cl