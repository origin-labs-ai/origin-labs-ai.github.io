\"wrap\":false,\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cpre class=\\\"shiki\\\"\u003e\u003ccode\u003e\u003cspan class=\\\"line\\\"\u003e{\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"tools\\\"\u003c/span\u003e: [\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e    {\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e      \\\"type\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"web_search_20260318\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e      \\\"name\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"web_search\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e      \\\"response_inclusion\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"excluded\\\"\u003c/span\u003e\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e    }\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e  ]\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e}\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\"}}]}]}]\nbc:[\"$\",\"h2\",\"100\",{\"id\":\"response\",\"className\":\"group\",\"children\":[[\"Response\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L95\",null,{\"id\":\"response\",\"name\":\"Response\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nbd:[\"$\",\"p\",\"102\",{\"children\":[\"Here’s an example response structure:\"]}]\n10b:T1418,3c:o1418,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e{\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"role\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"assistant\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"content\"\u003c/span\u003e: [\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e    // 1. Claude's decision to search\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"text\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"text\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"I'll search for when Claude Shannon was born.\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e    // 2. The search query used\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"server_tool_use\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"id\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"srvtoolu_01WYG3ziw53XMcoyKL4XcZmE\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"name\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"web_search\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"input\"\u003c/span\u003e: {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e        \"query\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"claude shannon birth date\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e      }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e    // 3. Search results\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"web_search_tool_result\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"tool_use_id\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"srvtoolu_01WYG3ziw53XMcoyKL4XcZmE\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"content\"\u003c/span\u003e: [\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"web_search_result\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"url\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"https://en.wikipedia.org/wiki/Claude_Shannon\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"title\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"Claude Shannon - Wikipedia\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"encrypted_content\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"EqgfCioIARgBIiQ3YTAwMjY1Mi1mZjM5LTQ1NGUtODgxNC1kNjNjNTk1ZWI3Y...\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"page_age\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"April 30, 2025\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e      ]\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"text\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"Based on the search results, \"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"text\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e    // 4. Claude's response with citations\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"text\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"Claude Shannon was born on April 30, 1916, in Petoskey, Michigan\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"text\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"citations\"\u003c/span\u003e: [\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"web_search_result_location\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"url\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"https://en.wikipedia.org/wiki/Claude_Shannon\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"title\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"Claude Shannon - Wikipedia\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"encrypted_index\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"Eo8BCioIAhgBIiQyYjQ0OWJmZi1lNm..\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"cited_text\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"Claude Elwood Shannon (April 30, 1916 – February 24, 2001) was an American mathematician, electrical engineer, computer scientist, cryptographer and i...\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e      ]\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e  ],\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"id\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"msg_a930390d3a\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"usage\"\u003c/span\u003e: {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e    \"input_tokens\"\u003c/span\u003e: \u003cspan class=\"l1 di\"\u003e6039\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e    \"output_tokens\"\u003c/span\u003e: \u003cspan class=\"l1 di\"\u003e931\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e    \"server_tool_use\"\u003c/span\u003e: {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"web_search_requests\"\u003c/span\u003e: \u003cspan class=\"l1 di\"\u003e1\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e  },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"stop_reason\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"end_turn\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e}\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e3c:o1000,be:[\"$\",\"$L109\",\"104\",{\"language\":\"json\",\"label\":\"Output\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$Lf6\",null,{\"wrap\":false,\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$10b\"}}]}]}]\nbf:[\"$\",\"p\",\"106\",{\"children\":[\"This example shows a direct search. When a search runs through \",[\"$\",\"$L93\",\"1\",{\"href\":\"#dynamic-filtering\",\"untracked\":false,\"children\":[\"dynamic filtering\"]}],\", the response also contains the result blocks of the \",[\"$\",\"$L93\",\"3\",{\"href\":\"/docs/en/agents-and-tools/tool-use/code-execution-tool\",\"untracked\":false,\"children\":[\"code execution tool\"]}],\", and each nested \",[\"$\",\"code\",\"5\",{\"children\":[\"server_tool_use\"]}],\" and \",[\"$\",\"code\",\"7\",{\"children\":[\"web_search_tool_result\"]}],\" pair carries a \",[\"$\",\"code\",\"9\",{\"children\":[\"caller\"]}],\" field identifying the code execution call that made it.\"]}]\nc0:[\"$\",\"h3\",\"108\",{\"id\":\"search-results\",\"className\":\"group\",\"children\":[[\"Search results\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L95\",null,{\"id\":\"search-results\",\"name\":\"Search results\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nc1:[\"$\",\"p\",\"110\",{\"children\":[\"Search results include:\"]}]\nc2:[\"$\",\"ul\",\"112\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"url\"]}],\": The URL of the source page\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"title\"]}],\": The title of the source page\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"page_age\"]}],\": When the site was last updated\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"encrypted_content\"]}],\": Encrypted content that you must pass back in multi-turn conversations\"]}],\"\\n\"]}]\nc3:[\"$\",\"p\",\"114\",{\"children\":[\"To continue a conversation that contains search results, send the assistant’s content blocks back exactly as you received them, including each result’s \",[\"$\",\"code\",\"1\",{\"children\":[\"encrypted_content\"]}],\". The API decrypts that content in later requests to restore the search results in Claude’s context. If \",[\"$\",\"code\",\"3\",{\"children\":[\"encrypted_content\"]}],\" is missing or modified, the request fails with a 400 validation error.\"]}]\nc4:[\"$\",\"h3\",\"116\",{\"id\":\"citations\",\"className\":\"group\",\"children\":[[\"Citations\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L95\",null,{\"id\":\"citations\",\"name\":\"Citations\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nc5:[\"$\",\"p\",\"118\",{\"children\":[\"Citations are always enabled for web search, and each \",[\"$\",\"code\",\"1\",{\"children\":[\"web_search_result_location\"]}],\" includes:\"]}]\nc6:[\"$\",\"ul\",\"120\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"url\"]}],\": The URL of the cited source\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"title\"]}],\": The title of the cited source\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"encrypted_index\"]}],\": A reference that must be passed back for multi-turn conversations\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"cited_text\"]}],\": Up to 150 characters of the cited content\"]}],\"\\n\"]}]\nc7:[\"$\",\"p\",\"122\",{\"children\":[\"The web search citation fields \",[\"$\",\"code\",\"1\",{\"children\":[\"cited_text\"]}],\", \",[\"$\",\"code\",\"3\",{\"children\":[\"title\"]}],\", and \",[\"$\",\"code\",\"5\",{\"children\":[\"url\"]}],\" do not count toward input or output token usage.\"]}]\nc8:[\"$\",\"$L94\",\"124\",{\"variant\":\"muted\",\"id\":\"$undefined\",\"icon\":\"$undefined\",\"className\":\"prose-block print:break-inside-avoid print:[:is(h2,h3,h4)+\u0026]:break-after-avoid\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"When displaying API outputs directly to end users, citations must be include3c:o1000,d to the original source. If you are making modifications to API outputs, including by reprocessing or combining them with your own material before displaying them to end users, display citations as appropriate based on consultation with your legal team.\"]}]]}]\nc9:[\"$\",\"h3\",\"126\",{\"id\":\"errors\",\"className\":\"group\",\"children\":[[\"Errors\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L95\",null,{\"id\":\"errors\",\"name\":\"Errors\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nca:[\"$\",\"p\",\"128\",{\"children\":[\"When the web search tool encounters an error (such as hitting rate limits), the Claude API still returns a 200 (success) response. The error is represented within the response body using the following structure:\"]}]\ncb:[\"$\",\"$L109\",\"130\",{\"language\":\"json\",\"label\":\"Output\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$Lf6\",null,{\"wrap\":false,\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cpre class=\\\"shiki\\\"\u003e\u003ccode\u003e\u003cspan class=\\\"line\\\"\u003e{\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"type\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"web_search_tool_result\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"tool_use_id\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"srvtoolu_a93jad\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"content\\\"\u003c/span\u003e: {\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e    \\\"type\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"web_search_tool_result_error\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e    \\\"error_code\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"max_uses_exceeded\\\"\u003c/span\u003e\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e  }\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e}\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\"}}]}]}]\ncc:[\"$\",\"p\",\"132\",{\"children\":[\"On an error, \",[\"$\",\"code\",\"1\",{\"children\":[\"content\"]}],\" is a single error object rather than a list of result blocks. A search that succeeds but matches no results returns an empty \",[\"$\",\"code\",\"3\",{\"children\":[\"content\"]}],\" list, not an error.\"]}]\ncd:[\"$\",\"p\",\"134\",{\"children\":[\"These are the possible error codes:\"]}]\nce:[\"$\",\"ul\",\"136\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"too_many_requests\"]}],\": Rate limit exceeded\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"invalid_tool_input\"]}],\": Invalid search query parameter\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"max_uses_exceeded\"]}],\": Maximum web search tool uses exceeded\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"query_too_long\"]}],\": Query exceeds maximum length\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"request_too_large\"]}],\": The search request is too large, typically because of a long domain filter list\"]}],\"\\n\",[\"$\",\"li\",\"11\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"unavailable\"]}],\": An internal error occurred\"]}],\"\\n\"]}]\ncf:[\"$\",\"h3\",\"138\",{\"id\":\"pause-turn-stop-reason\",\"className\":\"group\",\"children\":[[[\"$\",\"code\",\"0\",{\"children\":[\"pause_turn\"]}],\" stop reason\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L95\",null,{\"id\":\"pause-turn-stop-reason\",\"name\":\"pause_turn stop reason\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nd0:[\"$\",\"p\",\"140\",{\"children\":[\"The API can pause a long-running search turn and return \",[\"$\",\"code\",\"1\",{\"children\":[\"stop_reason: \\\"pause_turn\\\"\"]}],\". To continue, send the paused assistant message back unchanged in a new request.\"]}]\nd1:[\"$\",\"p\",\"142\",{\"children\":[\"If Claude calls web search and one of your client tools in the same group of parallel tool calls, the API returns \",[\"$\",\"code\",\"1\",{\"children\":[\"stop_reason: \\\"tool_use\\\"\"]}],\" instead and does not run the search yet. To continue, ret3c:o737,urn the client tool results, and the API runs the search in the next request. See \",[\"$\",\"$L93\",\"3\",{\"href\":\"/docs/en/agents-and-tools/tool-use/server-tools#mixing-server-tools-and-client-tools-in-one-turn\",\"untracked\":false,\"children\":[\"Mixing server tools and client tools in one turn\"]}],\".\"]}]\nd2:[\"$\",\"p\",\"144\",{\"children\":[\"For the server-side loop and \",[\"$\",\"code\",\"1\",{\"children\":[\"pause_turn\"]}],\" handling, see \",[\"$\",\"$L93\",\"3\",{\"href\":\"/docs/en/agents-and-tools/tool-use/server-tools#the-server-side-loop-and-pause-turn\",\"untracked\":false,\"children\":[\"The server-side loop and pause_turn\"]}],\" in the Server tools guide.\"]}]\nd3:[\"$\",\"h2\",\"146\",{\"id\":\"prompt-caching\",\"className\":\"group\",\"children\":[[\"Prompt caching\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L95\",null,{\"id\":\"prompt-caching\",\"name\":\"Prompt caching\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nd4:[\"$\",\"p\",\"148\",{\"children\":[\"To cache tool definitions across turns, see \",[\"$\",\"$L93\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/tool-use-with-prompt-caching\",\"untracked\":false,\"children\":[\"Tool use with prompt caching\"]}],\".\"]}]\nd5:[\"$\",\"h2\",\"150\",{\"id\":\"streaming\",\"className\":\"group\",\"children\":[[\"Streaming\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L95\",null,{\"id\":\"streaming\",\"name\":\"Streaming\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nd6:[\"$\",\"p\",\"152\",{\"children\":[\"With streaming enabled, you receive search events as part of the stream. There is a pause while the search runs:\"]}]\n10c:Td63,3c:od63,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003eevent: message_start\u003c/span\u003e\n\u003cspan class=\"line\"\u003edata: {\u003cspan class=\"l5 dc\"\u003e\"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"message_start\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"message\"\u003c/span\u003e: {\u003cspan class=\"l5 dc\"\u003e\"id\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"msg_abc123\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"message\"\u003c/span\u003e}}\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003eevent: content_block_start\u003c/span\u003e\n\u003cspan class=\"line\"\u003edata: {\u003cspan class=\"l5 dc\"\u003e\"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"content_block_start\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"index\"\u003c/span\u003e: \u003cspan class=\"l1 di\"\u003e0\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"content_block\"\u003c/span\u003e: {\u003cspan class=\"l5 dc\"\u003e\"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"text\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"text\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"\"\u003c/span\u003e}}\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e// Claude's decision to search\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003eevent: content_block_start\u003c/span\u003e\n\u003cspan class=\"line\"\u003edata: {\u003cspan class=\"l5 dc\"\u003e\"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"content_block_start\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"index\"\u003c/span\u003e: \u003cspan class=\"l1 di\"\u003e1\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"content_block\"\u003c/span\u003e: {\u003cspan class=\"l5 dc\"\u003e\"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"server_tool_use\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"id\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"srvtoolu_xyz789\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"name\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"web_search\"\u003c/span\u003e}}\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e// Search query streamed\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003eevent: content_block_delta\u003c/span\u003e\n\u003cspan class=\"line\"\u003edata: {\u003cspan class=\"l5 dc\"\u003e\"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"content_block_delta\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"index\"\u003c/span\u003e: \u003cspan class=\"l1 di\"\u003e1\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"delta\"\u003c/span\u003e: {\u003cspan class=\"l5 dc\"\u003e\"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"input_json_delta\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"partial_json\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"{\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e\\\"\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003equery\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e\\\"\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e:\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e\\\"\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003elatest quantum computing breakthroughs 2025\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e\\\"\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e}\"\u003c/span\u003e}}\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e// Pause while search runs\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e// Search results streamed\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003eevent: content_block_start\u003c/span\u003e\n\u003cspan class=\"line\"\u003edata: {\u003cspan class=\"l5 dc\"\u003e\"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"content_block_start\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"index\"\u003c/span\u003e: \u003cspan class=\"l1 di\"\u003e2\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"content_block\"\u003c/span\u003e: {\u003cspan class=\"l5 dc\"\u003e\"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"web_search_tool_result\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"tool_use_id\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"srvtoolu_xyz789\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"content\"\u003c/span\u003e: [{\u003cspan class=\"l5 dc\"\u003e\"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"web_search_result\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"title\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"Quantum Computing Breakthroughs in 2025\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"url\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"https://example.com\"\u003c/span\u003e}]}}\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e// Claude's response with citations (omitted in this example)\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e3c:o1000,d7:[\"$\",\"$L109\",\"154\",{\"language\":\"sse\",\"label\":\"Output\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$Lf6\",null,{\"wrap\":false,\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$10c\"}}]}]}]\nd8:[\"$\",\"h2\",\"156\",{\"id\":\"batch-requests\",\"className\":\"group\",\"children\":[[\"Batch requests\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L95\",null,{\"id\":\"batch-requests\",\"name\":\"Batch requests\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nd9:[\"$\",\"p\",\"158\",{\"children\":[\"You can include the web search tool in the \",[\"$\",\"$L93\",\"1\",{\"href\":\"/docs/en/build-with-claude/batch-processing\",\"untracked\":false,\"children\":[\"Message Batches API\"]}],\". Web search tool calls through the Message Batches API are priced the same as those in regular Messages API requests.\"]}]\nda:[\"$\",\"p\",\"160\",{\"children\":[\"To protect shared capacity, the Batches API throttles web search requests for each organization, so large batches with many searches might take longer to complete. You can see your organization’s web search rate limit on the \",[\"$\",\"$L93\",\"1\",{\"href\":\"/usage/limits\",\"untracked\":false,\"children\":[\"Rate limits\"]}],\" page in the Claude Console. To request a higher limit, contact sales from that page.\"]}]\ndb:[\"$\",\"h2\",\"162\",{\"id\":\"usage-and-pricing\",\"className\":\"group\",\"children\":[[\"Usage and pricing\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L95\",null,{\"id\":\"usage-and-pricing\",\"name\":\"Usage and pricing\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ndc:[\"$\",\"p\",\"164\",{\"children\":[\"Web search usage is charged in addition to token usage:\"]}]\ndd:[\"$\",\"$L109\",\"166\",{\"language\":\"json\",\"label\":\"$undefined\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$Lf6\",null,{\"wrap\":false,\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cpre class=\\\"shiki\\\"\u003e\u003ccode\u003e\u003cspan class=\\\"line\\\"\u003e{\u003c/span\u003e\\n\u00