children\":[\"Claude searches when the request depends on information that is current, changing, or outside its training data:\"]}]\naf:[\"$\",\"ul\",\"28\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Recent events, news, or announcements\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Current prices, rates, scores, or statistics\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"Information about specific organizations, people, or products that might have changed\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"Explicit requests to search or look something up\"]}],\"\\n\"]}]\nb0:[\"$\",\"p\",\"30\",{\"children\":[\"Claude answers directly without searching when the request draws on stable knowledge:\"]}]\nb1:[\"$\",\"ul\",\"32\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Established facts, math, science fundamentals, or coding concepts\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Creative writing or brainstorming\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"Analysis of content already provided in the conversation\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"Conversational turns and greetings\"]}],\"\\n\"]}]\nb2:[\"$\",\"p\",\"34\",{\"children\":[\"Triggering is steerable through your system prompt: you can encourage Claude to search more readily or to prefer answering directly. To enforce a limit, use \",[\"$\",\"$Laa\",\"1\",{\"href\":\"#max-uses\",\"untracked\":false,\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"max_uses\"]}]]}],\" to cap the number of searches in a turn.\"]}]\nb3:[\"$\",\"h3\",\"36\",{\"id\":\"dynamic-filtering\",\"className\":\"group\",\"children\":[[\"Dynamic filtering\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Lac\",null,{\"id\":\"dynamic-filtering\",\"name\":\"Dynamic filtering\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nb4:[\"$\",\"p\",\"38\",{\"children\":[\"With basic web search, every search result is loaded into Claude’s context window, and much of that content can be irrelevant to the request. With \",[\"$\",\"code\",\"1\",{\"children\":[\"web_search_20260209\"]}],\" or later, Claude instead writes and runs code that filters the results first, so only relevant content reaches the context window. This reduces token use on search-heavy requests.\"]}]\nb5:[\"$\",\"p\",\"40\",{\"children\":[\"Dynamic filtering runs web search from inside \",[\"$\",\"$Laa\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/code-execution-tool\",\"untracked\":false,\"children\":[\"code execution\"]}],\": on \",[\"$\",\"code\",\"3\",{\"children\":[\"web_search_20260209\"]}],\" and later, the tool’s \",[\"$\",\"code\",\"5\",{\"children\":[\"allowed_callers\"]}],\" field defaults to \",[\"$\",\"code\",\"7\",{\"children\":[\"[\\\"code_execution_20260120\\\"]\"]}],\", and when dynamic filtering runs, the API provisions the code execution it needs for the request automatically. You don’t need to add the code execution tool to \",[\"$\",\"code\",\"9\",{\"children\":[\"tools\"]}],\" yourself. There are no additional charges for code execution calls made this way beyond the standard token costs.\"]}]\nb6:[\"$\",\"p\",\"42\",{\"children\":[\"To call web search directly, without dynamic filtering, set \",[\"$\",\"code\",\"1\",{\"children\":[\"allowed_callers: [\\\"direct\\\"]\"]}],\". Models that don’t support programmatic tool calling require this setting. Without it, the API returns a 400 error that tells you to set it.\"]}]\nb7:[\"$\",\"$Lab\",\"44\",{\"variant\":\"muted\",\"id\":\"$undefined\",\"icon\":\"$undefined\",\"className\":\"prose-block print:break-inside-avoid print:[:is(h2,h3,h4)+\u0026]:break-after-avoid\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"The web search tool (with and without dynamic filtering) is available on the Claude API, \",[\"$\",\"$Laa\",\"1\",{\"href\":\"/docs/en/build-with-claude/claude-platform-on-aws\",\"untracked\":false,\"children\":[\"Claude Platform on AWS\"]}],\", \",[\"$\",\"$Laa\",\"3\",{\"href\":\"/docs/en/build-with-claude/claude-models-on-google-cloud/anthropic-managed\",\"untracked\":false,\"children\":[\"Claude Models on Google Cloud (Anthropic managed)\"]}],\", and \",[\"$\",\"$Laa\",\"5\",{\"href\":\"/docs/en/build-with-claude/claude-in-microsoft-foundry\",\"untracked\":false,\"children\":[\"Microsoft Foundry\"]}],\". On Microsoft Foundry, deployments \",[\"$\",\"$Laa\",\"7\",{\"href\":\"/docs/en/build-with-claude/claude-in-microsoft-foundry#additional-features-not-supported-when-hosted-on-azure\",\"untracked\":false,\"children\":[\"hosted on Azure\"]}],\" support only the basic web search tool (\",[\"$\",\"code\",\"9\",{\"children\":[\"web_search_20250305\"]}],\", without dynamic filtering). Deployments hosted on Anthropic support all versions. On Claude Models on Google Cloud (Google managed), only the basic web search tool (without dynamic filtering) is available.\"]}]]}]\nb8:[\"$\",\"p\",\"46\",{\"children\":[\"The following examples use \",[\"$\",\"code\",\"1\",{\"children\":[\"web_search_20260318\"]}],\":\"]}]\n10e:Ta07,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"lj dt\"\u003ecurl\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e https://api.anthropic.com/v1/messages\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -H\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"\u003c/span\u003e\u003cspan class=\"l4 dd\"\u003ex-api-key\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"dc\"\u003e$ANTHROPIC_API_KEY\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -H\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"\u003c/span\u003e\u003cspan class=\"l4 dd\"\u003eanthropic-version\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l2 dv\"\u003e2026-10-21\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -H\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"\u003c/span\u003e\u003cspan class=\"l4 dd\"\u003econtent-type\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003eapplication/json\"\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -d\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e '\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"model\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"claude-opus-5-5\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"max_tokens\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l2 dk\"\u003e4096\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"messages\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: [\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e      {\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e        \"role\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"user\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e        \"content\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"Search for the current prices of AAPL and GOOGL, then calculate which has a better P/E ratio.\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e      }\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e    ],\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"tools\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: [{\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e      \"type\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"web_search_20260318\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e      \"name\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"web_search\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e    }]\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e  }\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e'\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e10f:T5bf,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"lj dt\"\u003eant\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e messages\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e create\u003c/span\u003e\u003cspan class=\"lk\"\u003e \u0026lt;\u0026lt;\u003c/span\u003e'YAML'\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dd\"\u003emodel\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003eclaude-opus-5-5\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dd\"\u003emax_tokens\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l2 dk\"\u003e4096\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dd\"\u003emessages\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e:\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e  - \u003c/span\u003e\u003cspan class=\"l4 dd\"\u003erole\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003euser\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dd\"\u003e    content\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"ld dm\"\u003e\u0026gt;\u003c/span\u003e\u003cspan class=\"ld dd\"\u003e-\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l3 dn\"\u003e      Search for the current prices of AAPL and GOOGL, then calculate\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l3 dn\"\u003e      which has a better P/E ratio.\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dd\"\u003etools\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e:\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e  - \u003c/span\u003e\u003cspan class=\"l4 dd\"\u003etype\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003eweb_search_20260318\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dd\"\u003e    name\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003eweb_search\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line