en\":[\"encrypted_content\"]}],\" is missing or modified, the request fails with a 400 validation error.\"]}]\ndb:[\"$\",\"h3\",\"116\",{\"id\":\"citations\",\"className\":\"group\",\"children\":[[\"Citations\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Lac\",null,{\"id\":\"citations\",\"name\":\"Citations\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ndc:[\"$\",\"p\",\"118\",{\"children\":[\"Citations are always enabled for web search, and each \",[\"$\",\"code\",\"1\",{\"children\":[\"web_search_result_location\"]}],\" includes:\"]}]\ndd:[\"$\",\"ul\",\"120\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"url\"]}],\": The URL of the cited source\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"title\"]}],\": The title of the cited source\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"encrypted_index\"]}],\": A reference that must be passed back for multi-turn conversations\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"cited_text\"]}],\": Up to 150 characters of the cited content\"]}],\"\\n\"]}]\nde:[\"$\",\"p\",\"122\",{\"children\":[\"The web search citation fields \",[\"$\",\"code\",\"1\",{\"children\":[\"cited_text\"]}],\", \",[\"$\",\"code\",\"3\",{\"children\":[\"title\"]}],\", and \",[\"$\",\"code\",\"5\",{\"children\":[\"url\"]}],\" do not count toward input or output token usage.\"]}]\ndf:[\"$\",\"$Lab\",\"124\",{\"variant\":\"muted\",\"id\":\"$undefined\",\"icon\":\"$undefined\",\"className\":\"prose-block print:break-inside-avoid print:[:is(h2,h3,h4)+\u0026]:break-after-avoid\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"When displaying API outputs directly to end users, citations must be included to the original source. If you are making modifications to API outputs, including by reprocessing or combining them with your own material before displaying them to end users, display citations as appropriate based on consultation with your legal team.\"]}]]}]\ne0:[\"$\",\"h3\",\"126\",{\"id\":\"errors\",\"className\":\"group\",\"children\":[[\"Errors\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Lac\",null,{\"id\":\"errors\",\"name\":\"Errors\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ne1:[\"$\",\"p\",\"128\",{\"children\":[\"When the web search tool encounters an error (such as hitting rate limits), the Claude API still returns a 200 (success) response. The error is represented within the response body using the following structure:\"]}]\ne2:[\"$\",\"$L120\",\"130\",{\"language\":\"json\",\"label\":\"Output\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L10d\",null,{\"wrap\":false,\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cpre class=\\\"shiki\\\"\u003e\u003ccode\u003e\u003cspan class=\\\"line\\\"\u003e{\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"type\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"web_search_tool_result\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"tool_use_id\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"srvtoolu_a93jad\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"content\\\"\u003c/span\u003e: {\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e    \\\"type\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"web_search_tool_result_error\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e    \\\"error_code\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"max_uses_exceeded\\\"\u003c/span\u003e\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e  }\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e}\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\"}}]}]}]\ne3:[\"$\",\"p\",\"132\",{\"children\":[\"On an error, \",[\"$\",\"code\",\"1\",{\"children\":[\"content\"]}],\" is a single error object rather than a list of result blocks. A search that succeeds but matches no results returns an empty \",[\"$\",\"code\",\"3\",{\"children\":[\"content\"]}],\" list, not an error.\"]}]\ne4:[\"$\",\"p\",\"134\",{\"children\":[\"These are the possible error codes:\"]}]\ne5:[\"$\",\"ul\",\"136\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"too_many_requests\"]}],\": Rate limit exceeded\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"invalid_tool_input\"]}],\": Invalid search query parameter\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"max_uses_exceeded\"]}],\": Maximum web search tool uses exceeded\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"query_too_long\"]}],\": Query exceeds maximum length\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"request_too_large\"]}],\": The search request is too large, typically because of a long domain filter list\"]}],\"\\n\",[\"$\",\"li\",\"11\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"unavailable\"]}],\": An internal error occurred\"]}],\"\\n\"]}]\ne6:[\"$\",\"h3\",\"138\",{\"id\":\"pause-turn-stop-reason\",\"className\":\"group\",\"children\":[[[\"$\",\"code\",\"0\",{\"children\":[\"pause_turn\"]}],\" stop reason\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Lac\",null,{\"id\":\"pause-turn-stop-reason\",\"name\":\"pause_turn stop reason\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ne7:[\"$\",\"p\",\"140\",{\"children\":[\"The API can pause a long-running search turn and return \",[\"$\",\"code\",\"1\",{\"children\":[\"stop_reason: \\\"pause_turn\\\"\"]}],\". To continue, send the paused assistant message back unchanged in a new request.\"]}]\ne8:[\"$\",\"p\",\"142\",{\"children\":[\"If Claude calls web search and one of your client tools in the same group of parallel tool calls, the API returns \",[\"$\",\"code\",\"1\",{\"children\":[\"stop_reason: \\\"tool_use\\\"\"]}],\" instead and does not run the search yet. To continue, return the client tool results, and the API runs the search in the next request. See \",[\"$\",\"$Laa\",\"3\",{\"href\":\"/docs/en/agents-and-tools/tool-use/server-tools#mixing-server-tools-and-client-tools-in-one-turn\",\"untracked\":false,\"children\":[\"Mixing server tools and client tools in one turn\"]}],\".\"]}]\ne9:[\"$\",\"p\",\"144\",{\"children\":[\"For the server-side loop and \",[\"$\",\"code\",\"1\",{\"children\":[\"pause_turn\"]}],\" handling, see \",[\"$\",\"$Laa\",\"3\",{\"href\":\"/docs/en/agents-and-tools/tool-use/server-tools#the-server-side-loop-and-pause-turn\",\"untracked\":false,\"children\":[\"The server-side loop and pause_turn\"]}],\" in the Server tools guide.\"]}]\nea:[\"$\",\"h2\",\"146\",{\"id\":\"prompt-caching\",\"className\":\"group\",\"children\":[[\"Prompt caching\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Lac\",null,{\"id\":\"prompt-caching\",\"name\":\"Prompt caching\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\neb:[\"$\",\"p\",\"148\",{\"children\":[\"To cache tool definitions across turns, see \",[\"$\",\"$Laa\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/tool-use-with-prompt-caching\",\"untracked\":false,\"children\":[\"Tool use with prompt caching\"]}],\".\"]}]\nec:[\"$\",\"h2\",\"150\",{\"id\":\"streaming\",\"className\":\"group\",\"children\":[[\"Streaming\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Lac\",null,{\"id\":\"streaming\",\"name\":\"Streaming\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ned:[\"$\",\"p\",\"152\",{\"children\":[\"With streaming enabled, you receive search events as part of the stream. There is a pause while the search runs:\"]}]\n123:Td63,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003eevent: message_start\u003c/span\u003e\n\u003cspan class=\"line\"\u003edata: {\u003cspan class=\"l5 dc\"\u003e\"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"message_start\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"message\"\u003c/span\u003e: {\u003cspan class=\"l5 dc\"\u003e\"id\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"msg_abc123\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"message\"\u003c/span\u003e}}\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003eevent: content_block_start\u003c/span\u003e\n\u003cspan class=\"line\"\u003edata: {\u003cspan class=\"l5 dc\"\u003e\"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"content_block_start\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"index\"\u