squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] stacks:transition-[box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1.25rem * var(--cds-rem-scale, 1));font-weight:433.3" aria-hidden="true"></span></span></button><span role="status" class="sr-only"></span></span></div></div><div data-orientation="horizontal" data-activation-direction="none" id="base-ui-_R_6evcqalubtabsknr5td9leailb_" role="tabpanel" tabindex="-1" data-index="-1" class="cds-reset outline-none focus-visible:outline-hidden data-[ending-style]:hidden"><div data-not-prose="true" tabindex="0" class="relative h-full py-4 pl-4 text-code overflow-x-auto focus-visible:-outline-offset-2 print:overflow-visible"><div class="inline-block min-w-full pr-4 print:block" data-code-source="" translate="no"><pre class="shiki"><code><span class="line">client <span class="lk">=</span> anthropic.Anthropic()</span>
<span class="line"></span>
<span class="line">response <span class="lk">=</span> client.messages.create(</span>
<span class="line"><span class="lj dc">    model</span><span class="lk">=</span><span class="l3 dn">"claude-opus-5-5"</span>,</span>
<span class="line"><span class="lj dc">    max_tokens</span><span class="lk">=</span><span class="l1 di">4096</span>,</span>
<span class="line"><span class="lj dc">    messages</span><span class="lk">=</span>[{<span class="l3 dn">"role"</span>: <span class="l3 dn">"user"</span>, <span class="l3 dn">"content"</span>: <span class="l3 dn">"What's the weather in NYC?"</span>}],</span>
<span class="line"><span class="lj dc">    tools</span><span class="lk">=</span>[{<span class="l3 dn">"type"</span>: <span class="l3 dn">"web_search_20250305"</span>, <span class="l3 dn">"name"</span>: <span class="l3 dn">"web_search"</span>, <span class="l3 dn">"max_uses"</span>: <span class="l1 di">5</span>}],</span>
<span class="line">)</span>
<span class="line"><span class="l1 dt">print</span>(response)</span></code></pre></div></div></div></div></div>
<h2 id="tool-definition" class="group">Tool definition<span class="relative hidden h-[1em] w-0 align-middle lg:inline-block"><span role="status" aria-live="polite" class="sr-only"></span><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" data-size="xs" class="cds-reset group/btn isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-fizzy-lake-color-icon-only-disabled)] absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100" aria-label="Copy link to Tool definition" id="_R_kffcqalubtabsknr5td9leailb_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] stacks:transition-[box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1rem * var(--cds-rem-scale, 1));font-weight:533.3" aria-hidden="true"></span></span></button></span></h2>
<p>The web search tool supports the following parameters:</p>
<div data-copy-scope="" class="overflow-hidden rounded-card border bg-surface-2 print:[p+&amp;]:break-before-avoid group relative prose-block [&amp;&gt;[data-not-prose]]:mt-0"><div class="flex items-center justify-between gap-2 border-b px-4 py-1 print:break-after-avoid print:py-sm not-prose"><div class="flex min-w-0 items-center gap-2 text-caption text-muted">JSON</div><div class="flex shrink-0 items-center gap-1 print:hidden"><span class="contents group-[:not(:has([data-code-source]))]/codegroup:hidden"><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" data-size="sm" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-fizzy-lake-color-icon-only-disabled)] text-muted" aria-label="Copy code" id="_R_7igfcqalubtabsknr5td9leailb_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] stacks:transition-[box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1.25rem * var(--cds-rem-scale, 1));font-weight:433.3" aria-hidden="true"></span></span></button><span role="status" class="sr-only"></span></span></div></div><div data-not-prose="true" tabindex="0" class="relative h-full py-4 pl-4 text-code overflow-x-auto focus-visible:-outline-offset-2 print:overflow-visible"><div class="inline-block min-w-full pr-4 print:block" data-code-source="" translate="no"><pre class="shiki"><code><span class="line">{</span>
<span class="line"><span class="l5 dc">  "type"</span>: <span class="l3 dn">"web_search_20250305"</span>,</span>
<span class="line"><span class="l5 dc">  "name"</span>: <span class="l3 dn">"web_search"</span>,</span>
<span class="line"></span>
<span class="line"><span class="lg d7">  // Optional: Limit the number of searches</span></span>
<span class="line"><span class="l5 dc">  "max_uses"</span>: <span class="l1 di">5</span>,</span>
<span class="line"></span>
<span class="line"><span class="lg d7">  // Optional: Only include results from these domains.</span></span>
<span class="line"><span class="lg d7">  // Use allowed_domains or blocked_domains, not both.</span></span>
<span class="line"><span class="l5 dc">  "allowed_domains"</span>: [<span class="l3 dn">"example.com"</span>, <span class="l3 dn">"trusteddomain.org"</span>],</span>
<span class="line"></span>
<span class="line"><span class="lg d7">  // Optional: Never include results from these domains</span></span>
<span class="line"><span class="l5 dc">  "blocked_domains"</span>: [<span class="l3 dn">"untrustedsource.com"</span>],</span>
<span class="line"></span>
<span class="line"><span class="lg d7">  // Optional: Localize search results</span></span>
<span class="line"><span class="l5 dc">  "user_location"</span>: {</span>
<span class="line"><span class="l5 dc">    "type"</span>: <span class="l3 dn">"approximate"</span>,</span>
<span class="line"><span class="l5 dc">    "city"</span>: <span class="l3 dn">"San Francisco"</span>,</span>
<span class="line"><span class="l5 dc">    "region"</span>: <span class="l3 dn">"California"</span>,</span>
<span class="line"><span class="l5 dc">    "country"</span>: <span class="l3 dn">"US"</span>,</span>
<span class="line"><span class="l5 dc">    "timezone"</span>: <span class="l3 dn">"America/Los_Angeles"</span></span>
<span class="line">  }</span>
<span class="line">}</span></code></pre></div></div></div>
<p>All web search tool versions accept <code>allowed_callers</code>, which controls whether Claude calls web search directly or from code execution through <a href="#dynamic-filtering">dynamic filtering</a>. On <code>web_search_20260209</code> and later it defaults to <code>[&quot;code_execution_20260120&quot;]</code> instead of <code>[&quot;direct&quot;]</code>. See <a href="/docs/en/agents-and-tools/tool-use/server-tools#zdr-and-allowed-callers">ZDR and allowed_callers</a> for how to configure it. <code>web_search_20260318</code> and later also accept <a href="#response-inclusion"><code>response_inclusion</code></a>.</p>
<h3 id="max-uses" class="group">Max uses<span class="relative hidden h-[1em] w-0 align-middle lg:inline-block"><span role="status" aria-live="polite" class="sr-only"></span><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" data-size="xs" class="cds-reset group/btn isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-fizzy-lake-color-icon-only-disabled)] absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100" aria-label="Copy link to Max uses" id="_R_khfcqalubtabsknr5td9leailb_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] stacks:transition-[box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1rem * var(--cds-rem-scale, 1));font-weight:533.3" aria-hidden="true"></span></span></button></span></h3>
<p>The <code>max_uses</code> parameter limits the number of searches in a single turn. Single-fact queries typically use 1–3 searches; comparative or multientity research can use 10 or more.</p>
<p>Failed searches count against the limit. If Claude calls web search directly more times than allowed, the <code>web_search_tool_result</code> is an error with the <code>max_uses_exceeded</code> error code. If Claude calls web search from code execution more times than allowed, the code execution run ends with an error.</p>
<p>A turn can span several requests. A request continues a turn when it resumes after <a href="/docs/en/agents-and-tools/tool-use/server-tools#the-server-side-loop-and-pause-turn"><code>pause_turn</code></a> or when its last message contains only <code>tool_result</code> blocks. Searches from earlier requests in that turn count against the limit, unless Claude ran them from code execution through <a href="#dynamic-filtering">dynamic filtering</a>.</p>
<h3 id="domain-filtering" class="group">Domain filtering<span class="relative hidden h-[1em] w-0 align-middle lg:inline-block"><span role="status" aria-live="polite" class="sr-only"></span><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" data-size="xs" class="cds-reset group/btn isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-fizzy-lake-color-icon-only-disabled)] absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100" aria-label="Copy link to Domain filtering" id="_R_kjfcqalubtabsknr5td9leailb_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] stacks:transition-[box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1rem * var(--cds-rem-scale, 1));font-weight:533.3" aria-hidden="true"></span></span></button></span></h3>
<p>Provide <code>allowed_domains</code> or <code>blocked_domains</code>, not both. If a request includes both, the API returns a 400 error. Entries are bare domains with an optional path, for example <code>example.com</code> or <code>example.com/blog</code>, without a scheme.</p>
<p>For the full domain filtering rules, see <a href="/docs/en/agents-and-tools/tool-use/server-tools#domain-filtering">Domain filtering</a> in the Server tools guide.</p>
<p>On <a href="/docs/en/managed-agents/overview">Claude Managed Agents</a>, set these fields on the <code>web_search</code> entry of the agent toolset; see <a href="/docs/en/managed-agents/tools-web-restrictions">Restrict web search and web fetch domains</a>.</p>
<h3 id="localization" class="group">Localization<span class="relative hidden h-[1em] w-0 align-middle lg:inline-block"><span role="status" aria-live="polite" class="sr-only"></span><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" data-size="xs" class="cds-reset group/btn isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-fizzy-lake-color-icon-only-disabled)] absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100" aria-label="Copy link to Localization" id="_R_klfcqalubtabsknr5td9leailb_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] stacks:transition-[box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1rem * var(--cds-rem-scale, 1));font-weight:533.3" aria-hidden="true"></span></span></button></span></h3>
<p>The <code>user_location</code> parameter allows you to localize search results based on a user’s location. Provide at least one of <code>city</code>, <code>region</code>, <code>country</code>, or <code>timezone</code>.</p>
<ul>
<li><code>type</code>: The type of location (must be <code>approximate</code>)</li>
<li><code>city</code>: The city name</li>
<li><code>region</code>: The region or state</li>
<li><code>country</code>: The two-letter <a href="https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2" target="_blank" rel="noopener noreferrer">ISO 3166-1 alpha-2</a> country code (the API rejects an unsupported code with a 400 error)</li>
<li><code>timezone</code>: The <a href="https://en.wikipedia.org/wiki/List_of_tz_database_time_zones" target="_blank" rel="noopener noreferrer">IANA time zone ID</a></li>
</ul>
<p>On Claude Managed Agents, the <code>web_search</code> entry of the agent toolset also accepts <code>user_location</code>; see the <a href="/docs/en/managed-agents/tools-web-restrictions#settings">web tool settings</a>.</p>
