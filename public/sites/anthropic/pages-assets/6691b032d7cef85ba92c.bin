/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"title\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"Quantum Computing Breakthroughs in 2025\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"url\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"https://example.com\"\u003c/span\u003e}]}}\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e// Claude's response with citations (omitted in this example)\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003eee:[\"$\",\"$L120\",\"154\",{\"language\":\"sse\",\"label\":\"Output\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L10d\",null,{\"wrap\":false,\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$123\"}}]}]}]\nef:[\"$\",\"h2\",\"156\",{\"id\":\"batch-requests\",\"className\":\"group\",\"children\":[[\"Batch requests\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Lac\",null,{\"id\":\"batch-requests\",\"name\":\"Batch requests\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nf0:[\"$\",\"p\",\"158\",{\"children\":[\"You can include the web search tool in the \",[\"$\",\"$Laa\",\"1\",{\"href\":\"/docs/en/build-with-claude/batch-processing\",\"untracked\":false,\"children\":[\"Message Batches API\"]}],\". Web search tool calls through the Message Batches API are priced the same as those in regular Messages API requests.\"]}]\nf1:[\"$\",\"p\",\"160\",{\"children\":[\"To protect shared capacity, the Batches API throttles web search requests for each organization, so large batches with many searches might take longer to complete. You can see your organization’s web search rate limit on the \",[\"$\",\"$Laa\",\"1\",{\"href\":\"/usage/limits\",\"untracked\":false,\"children\":[\"Rate limits\"]}],\" page in the Claude Console. To request a higher limit, contact sales from that page.\"]}]\nf2:[\"$\",\"h2\",\"162\",{\"id\":\"usage-and-pricing\",\"className\":\"group\",\"children\":[[\"Usage and pricing\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Lac\",null,{\"id\":\"usage-and-pricing\",\"name\":\"Usage and pricing\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nf3:[\"$\",\"p\",\"164\",{\"children\":[\"Web search usage is charged in addition to token usage:\"]}]\nf4:[\"$\",\"$L120\",\"166\",{\"language\":\"json\",\"label\":\"$undefined\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L10d\",null,{\"wrap\":false,\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cpre class=\\\"shiki\\\"\u003e\u003ccode\u003e\u003cspan class=\\\"line\\\"\u003e{\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"usage\\\"\u003c/span\u003e: {\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e    \\\"input_tokens\\\"\u003c/span\u003e: \u003cspan class=\\\"l1 di\\\"\u003e105\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e    \\\"output_tokens\\\"\u003c/span\u003e: \u003cspan class=\\\"l1 di\\\"\u003e6039\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e    \\\"cache_read_input_tokens\\\"\u003c/span\u003e: \u003cspan class=\\\"l1 di\\\"\u003e7123\u003c/span\u003e,\u003c/span\u003e\\n\u0