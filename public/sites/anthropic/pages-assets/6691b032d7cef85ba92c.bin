",{\"children\":[\"With \",[\"$\",\"code\",\"1\",{\"children\":[\"web_search_20260209\"]}],\" and later versions, Claude can write and run code that filters the search results before they reach the context window (\",[\"$\",\"strong\",\"3\",{\"children\":[\"dynamic filtering\"]}],\"), keeping only relevant information. Dynamic filtering is available with Claude 4.6 and later models and \",[\"$\",\"$L93\",\"5\",{\"href\":\"https://anthropic.com/glasswing\",\"untracked\":false,\"children\":[\"Claude Mythos Preview\"]}],\".\"]}],\"\\n\",[\"$\",\"p\",\"4\",{\"children\":[\"Three versions of the web search tool are available:\"]}],\"\\n\",[\"$\",\"ul\",\"6\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"web_search_20250305\"]}],\": basic web search\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"web_search_20260209\"]}],\": adds \",[\"$\",\"$L93\",\"2\",{\"href\":\"#dynamic-filtering\",\"untracked\":false,\"children\":[\"dynamic filtering\"]}]]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"web_search_20260318\"]}],\": adds \",[\"$\",\"$L93\",\"2\",{\"href\":\"#response-inclusion\",\"untracked\":false,\"children\":[\"response inclusion\"]}],\" control for agentic workflows\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",\"8\",{\"children\":[\"The examples on this page use \",[\"$\",\"code\",\"1\",{\"children\":[\"web_search_20250305\"]}],\" for basic search and \",[\"$\",\"code\",\"3\",{\"children\":[\"web_search_20260318\"]}],\" for dynamic filtering.\"]}],\"\\n\",[\"$\",\"$L94\",\"10\",{\"variant\":\"muted\",\"id\":\"$undefined\",\"icon\":\"$undefined\",\"className\":\"prose-block print:break-inside-avoid print:[:is(h2,h3,h4)+\u0026]:break-after-avoid\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"For \",[\"$\",\"$L93\",\"1\",{\"href\":\"https://anthropic.com/glasswing\",\"untracked\":false,\"children\":[\"Claude Mythos Preview\"]}],\", web search is