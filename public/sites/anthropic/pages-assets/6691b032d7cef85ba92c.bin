\",\"$La8\",null,{\"moduleIds\":[\"16322934317281289640\"]}],[\"$\",\"$La9\",null,{\"id\":\"feature-api-support\",\"cards\":[{\"title\":\"Messages API\",\"icon\":\"ChatSimple\",\"mark\":\"opt-in\",\"availability\":\"Available\",\"usage\":[\"Add a `web_search` tool to the request's `tools`. Settings such as `max_uses`, domain lists and `user_location` go on that tool.\"]},{\"title\":\"Managed Agents\",\"icon\":\"Agent\",\"mark\":\"opt-in\",\"availability\":\"Available\",\"usage\":[\"On by default in the agent toolset, without `max_uses`, `citations` or `cache_control`.\"]}],\"words\":{\"apiCard.usage\":\"Usage\",\"apiCard.useInstead\":\"Use {feature} instead.\",\"apiCard.differs\":\"Usage differs by product\",\"column.status\":\"Status\",\"column.apis\":\"APIs\",\"column.cloud_provider\":\"Cloud platforms\",\"column.models\":\"Models\",\"leftOut.notSupported\":\"Not supported\",\"box.or\":\"or\",\"betaHeaders.column\":\"Header\",\"arrangement.endpoints\":\"Applicable endpoints\",\"arrangement.learnMore\":\"Learn more\",\"arrangement.excludes\":\"Excludes {models}\",\"status.supported\":\"Available\"},\"children\":\"$undefined\"}]]}]]\na1:[[\"$\",\"p\",\"0\",{\"children\":[\"The web search tool gives Claude direct access to real-time web content, allowing it to answer questions with up-to-date information beyond its knowledge cutoff. The response includes citations for sources drawn from search results.\"]}],\"\\n\",[\"$\",\"p\",\"2\",{\"children\":[\"With \",[\"$\",\"code\",\"1\",{\"children\":[\"web_search_20260209\"]}],\" and later versions, Claude can write and run code that filters the search results before they reach the context window (\",[\"$\",\"strong\",\"3\",{\"children\":[\"dynamic filtering\"]}],\"), keeping only relevant information. Dynamic filtering is available with Claude 4.6 and later models and \",[\"$\",\"$Laa\",\"5\",{\"href\":\"https://anthropic.com/glasswing\",\"untracked\":false,\"children\":[\"Claude Mythos Preview\"]}],\".\"]}],\"\\n\",[\"$\