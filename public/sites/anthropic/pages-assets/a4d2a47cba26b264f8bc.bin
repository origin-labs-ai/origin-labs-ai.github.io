s="c-card__item c-card__item--decoration" style="width: 220px;"><img alt="The Future of Cyber Security Conference" class="u-object-fit" loading="lazy" src="https://cloudsecurityalliance.org/rails/active_storage/blobs/redirect/eyJfcmFpbHMiOnsiZGF0YSI6Njg3NzAsInB1ciI6ImJsb2JfaWQifX0=--6d678039606f1cedf4335ede0a92dec45b76ef38/leeds_cyber_500x400.jpg" /></div><div class="c-card__item" style="width: calc(100% - 220px);"><h6 class="u-mb8">The Future of Cyber Securit...</h6><p class="u-text-color-gray-400">November 18, 2026 <span>-</span> November 18, 2026 <span>|</span> Leeds, West Yorkshire</p><div><a target="_blank" rel="noopener" href="https://cyberleeds.events/2026/en/page/registration-1"><span>Register now</span> <i class="fas fa-arrow-right-long"></i></a></div></div><a target="_blank" rel="noopener" class="u-position-center" href="https://cyberleeds.events/2026/en/page/registration-1"></a></div><div class="c-card c-card--exhibit c-card--actionable c-card--exhibit-right" id="event-card-1673"><div class="c-card__item c-card__item--decoration" style="width: 220px;"><img alt="Pitchapalooza 2026: Frontier Ready" class="u-object-fit" loading="lazy" src="https://cloudsecurityalliance.org/rails/active_storage/blobs/redirect/eyJfcmFpbHMiOnsiZGF0YSI6NjgyNzgsInB1ciI6ImJsb2JfaWQifX0=--0c62d64822dc93e4a3a13f14e3fb6c5cc90b1055/Pitchapalooza%20generic%20event%20listing.png" /></div><div class="c-card__item" style="width: calc(100% - 220px);"><h6 class="u-mb8">Pitchapalooza 2026: Frontie...</h6><p class="u-text-color-gray-400">November 18, 2026 <span>-</span> November 19, 2026 <span>|</span> Virtual</p><div><a target="_blank" rel="noopener" href="https://cloudsecurityalliance.org/p/pitchapalooza-judges-and-participants-2026"><span>Register now</span> <i class="fas fa-arrow-right-long"></i></a></div></div><a target="_blank" rel="noopener" class="u-position-center" href="https://cloudsecurityalliance.org/p/pitchapalooza-judges-and-participants-2026"></a></div></div></div></div><div class="webinars-selected" data-dynamic-content-options="fade-in 0.5s" style="display:none;"><div class="o-flex-grid o-flex-grid--row o-flex-grid o-flex-grid--row--gap-2x"><div class="o-flex-grid o-flex-grid--column u-flex-is-5"><div class="c-card c-card--exhibit c-card--actionable" id="event-card-506"><div class="c-card__item c-card__item--decoration" style=""><img alt="Cloudbytes Webinar Series" class="u-object-fit" loading="lazy" src="https://cloudsecurityalliance.org/rails/active_storage/blobs/redirect/eyJfcmFpbHMiOnsiZGF0YSI6NDc0MzMsInB1ciI6ImJsb2JfaWQifX0=--d7b5bc4e3ad57b160e33edd5b3b170ad715a7409/CloudBytes%20500x400.png" /></div><div class="c-card__item" style=""><h6 class="u-mb8">Cloudbytes Webinar Series</h6><p class="u-text-color-gray-400">January 2024 <span>-</span> December 31, 2027 <span>|</span> Virtual</p><div class="u-mb16"><a target="_blank" rel="noopener" href="https://www.csacloudbytes.com/"><span>Register now</span> <i class="fas fa-arrow-right-long"></i></a></div></div><a target="_blank" rel="noopener" class="u-position-center" href="https://www.csacloudbytes.com/"></a></div></div><div class="o-flex-grid o-flex-grid--column u-flex-is-7"><div class="c-card c-card--exhibit c-card--actionable c-card--exhibit-right" id="event-card-988"><div class="c-card__item c-card__item--decoration" style="width: 220px;"><img alt="Cloud Security Alliance on YouTube" class="u-object-fit" loading="lazy" src="https://cloudsecurityalliance.org/rails/active_storage/blobs/redirect/eyJfcmFpbHMiOnsiZGF0YSI6NjA3OTAsInB1ciI6ImJsb2JfaWQifX0=--1d0bea058aa53d31c5ba6e582417b539d1f660ea/YouTube-500x400.png" /></div><div class="c-card__item" style="width: calc(100% - 220px);"><h6 class="u-mb8">Cloud Security Alliance on ...</h6><p class="u-text-color-gray-400">January 2024 <span>-</span> December 31, 2027 <span>|</span> YouTube</p><div><a target="_blank" rel="noopener" href="https://www.youtube.com/channel/UCrcG6ZtsBPz3xkUZU6asVhA"><span>Register now</span> <i class="fas fa-arrow-right-long"></i></a></div></div><a target="_blank" rel="noopener" class="u-position-center" href="https://www.youtube.com/channel/UCrcG6ZtsBPz3xkUZU6asVhA"></a></div><div class="c-card c-card--exhibit c-card--actionable c-card--exhibit-right" id="event-card-1392"><div class="c-card__item c-card__item--decoration" style="width: 220px;"><img alt="CSA Research Webinar Series" class="u-object-fit" loading="lazy" src="https://cloudsecurityalliance.org/rails/active_storage/blobs/redirect/eyJfcmFpbHMiOnsiZGF0YSI6NDc0MzUsInB1ciI6ImJsb2JfaWQifX0=--4d92663431fc41a2349c9158f8b1fd0709d29c00/Research%20500x400.png" /></div><div class="c-card__item" style="width: calc(100% - 220px);"><h6 class="u-mb8">CSA Research Webinar Series</h6><p class="u-text-color-gray-400">January 1, 2025 <span>-</span> December 31, 2027 <span>|</span> Virtual</p><div><a target="_blank" rel="noopener" href="https://www.brighttalk.com/channel/16947"><span>Register now</span> <i class="fas fa-arrow-right-long"></i></a></div></div><a target="_blank" rel="noopener" class="u-position-center" href="https://www.brighttalk.com/channel/16947"></a></div></div></div></div><div class="blogs-selected" data-dynamic-content-options="fade-in 0.5s" style="display:none;"><div class="o-flex-grid o-flex-grid--row u-flex-gap2x"><div class="o-flex-grid o-flex-grid--column u-flex-is-5"><div class="c-card c-card--exhibit c-card--actionable"><div class="c-card__item c-card__item--decoration" style=""><img width="350" height="233" srcset="https://cloudsecurityalliance.org/rails/active_storage/representations/redirect/eyJfcmFpbHMiOnsiZGF0YSI6NTYyODIsInB1ciI6ImJsb2JfaWQifX0=--dfb4b6bfa6d376cad8fefb447cd21cdb0507697d/eyJfcmFpbHMiOnsiZGF0YSI6eyJmb3JtYXQiOiJqcGVnIiwiYXV0b19vcmllbnQiOnRydWUsInJvdGF0ZSI6MCwiZ3Jhdml0eSI6ImNlbnRlciIsImJhY2tncm91bmQiOiJub25lIiwicmVzaXplIjoiMzUweDIzMyJ9LCJwdXIiOiJ2YXJpYXRpb24ifX0=--f4ee8f21797f76a14a4d582677ffd97be4cf075a/Untitled%20(27).jpeg 1x,
                 https://cloudsecurityalliance.org/rails/active_storage/representations/redirect/eyJfcmFpbHMiOnsiZGF0YSI6NTYyODIsInB1ciI6ImJsb2JfaWQifX0=--dfb4b6bfa6d376cad8fefb447cd21cdb0507697d/eyJfcmFpbHMiOnsiZGF0YSI6eyJmb3JtYXQiOiJqcGVnIiwiYXV0b19vcmllbnQiOnRydWUsInJvdGF0ZSI6MCwiZ3Jhdml0eSI6ImNlbnRlciIsImJhY2tncm91bmQiOiJub25lIiwicmVzaXplIjoiNzAweDQ2NiJ9LCJwdXIiOiJ2YXJpYXRpb24ifX0=--d47633c600599e1ae2d57c1081cb044f962f2d6c/Untitled%20(27).jpeg 2x" loading="lazy" class="u-object-fit" alt="Input Privacy vs. Output Privacy: Choosing a PET" src="https://cloudsecurityalliance.org/rails/active_storage/representations/redirect/eyJfcmFpbHMiOnsiZGF0YSI6NTYyODIsInB1ciI6ImJsb2JfaWQifX0=--dfb4b6bfa6d376cad8fefb447cd21cdb0507697d/eyJfcmFpbHMiOnsiZGF0YSI6eyJmb3JtYXQiOiJqcGVnIiwiYXV0b19vcmllbnQiOnRydWUsInJvdGF0ZSI6MCwiZ3Jhdml0eSI6ImNlbnRlciIsImJhY2tncm91bmQiOiJub25lIiwicmVzaXplIjoiMzUweDIzMyJ9LCJwdXIiOiJ2YXJpYXRpb24ifX0=--f4ee8f21797f76a14a4d582677ffd97be4cf075a/Untitled%20(27).jpeg" /><div class="c-tag c-tag--small c-tag--gradient-teal" style="position: absolute; bottom: 10px; left: 10px;">Zero Trust</div></div><div class="c-card__item" style=""><h6>Input Privacy vs. Output Privacy: Choosing a PET</h6><p class="u-text-color-gray-400 u-mb16">Published: 11/06/2026</p></div><a target="_blank" rel="noopener" class="u-position-center" href="/articles/input-privacy-vs-output-privacy-choosing-a-pet"></a></div></div><div class="o-flex-grid o-flex-grid--column u-flex-is-7"><div class="c-card c-card--exhibit c-card--actionable c-card--exhibit-right"><div class="c-card__item c-card__item--decoration" style="width: 220px;"><img width="350" height="233" srcset="https://cloudsecurityalliance.org/rails/active_storage/representations/redirect/eyJfcmFpbHMiOnsiZGF0YSI6Njg5MTAsInB1ciI6ImJsb2JfaWQifX0=--633f8855cc51d1a26fd84d11528bc2540d07a978/eyJfcmFpbHMiOnsiZGF0YSI6eyJmb3JtYXQiOiJqcGVnIiwiYXV0b19vcmllbnQiOnRydWUsInJvdGF0ZSI6MCwiZ3Jhdml0eSI6ImNlbnRlciIsImJhY2tncm91bmQiOiJub25lIiwicmVzaXplIjoiMzUweDIzMyJ9LCJwdXIiOiJ2YXJpYXRpb24ifX0=--f4ee8f21797f76a14a4d582677ffd97be4cf075a/Blog%20Image%20(20).jpeg 1x,
                 https://cloudsecurityalliance.org/rails/active_storage/representations/redirect/eyJfcmFpbHMiOnsiZGF0YSI6Njg5MTAsInB1ciI6ImJsb2JfaWQifX0=--633f8855cc51d1a26fd84d11528bc2540d07a978/eyJfcmFpbHMiOnsiZGF0YSI6eyJmb3JtYXQiOiJqcGVnIiwiYXV0b19vcmllbnQiOnRydWUsInJvdGF0ZSI6MCwiZ3Jhdml0eSI6ImNlbnRlciIsImJhY2tncm91bmQiOiJub25lIiwicmVzaXplIjoiNzAweDQ2NiJ9LCJwdXIiOiJ2YXJpYXRpb24ifX0=--d47633c600599e1ae2d57c1081cb044f962f2d6c/Blog%20Image%20(20).jpeg 2x" loading="lazy" class="u-object-fit" alt="AI Governance Isn&#39;t a Chore Problem. It&#39;s an Architecture Problem." src="https://cloudsecurityalliance.org/rails/active_storage/representations/redirect/eyJfcmFpbHMiOnsiZGF0YSI6Njg5MTAsInB1ciI6ImJsb2JfaWQifX0=--633f8855cc51d1a26fd84d11528bc2540d07a978/eyJfcmFpbHMiOnsiZGF0YSI6eyJmb3JtYXQiOiJqcGVnIiwiYXV0b19vcmllbnQiOnRydWUsInJvdGF0ZSI6MCwiZ3Jhdml0eSI6ImNlbnRlciIsImJhY2tncm91bmQiOiJub25lIiwicmVzaXplIjoiMzUweDIzMyJ9LCJwdXIiOiJ2YXJpYXRpb24ifX0=--f4ee8f21797f76a14a4d582677ffd97be4cf075a/Blog%20Image%20(20).jpeg" /><div class="c-tag c-tag--small c-tag--gradient-orange" style="position: absolute; bottom: 10px; left: 10px;">AI</div></div><div class="c-card__item" style="width: calc(100% - 220px);"><h6>AI Governance Isn&#39;t a Chore Problem. It&#39;s an Architecture Problem.</h6><p class="u-text-color-gray-400 u-mb16">Published: 11/06/2026</p></div><a target="_blank" rel="noopener" class="u-position-center" href="/articles/ai-governance-isn-t-a-chore-problem-it-s-an-architecture-problem"></a></div><div class="c-card c-card--exhibit c-card--actionable c-card--exhibit-right"><div class="c-card__item c-card__item--decoration" style="width: 220px;"><img width="350" height="233" srcset="https://cloudsecurityalliance.org/rails/active_storage/representations/redirect/eyJfcmFpbHMiOnsiZGF0YSI6NTg2MDQsInB1ciI6ImJsb2JfaWQifX0=--1379faf9caa9466476e16bb0edc968246d39e181/eyJfcmFpbHMiOnsiZGF0YSI6eyJmb3JtYXQiOiJqcGVnIiwiYXV0b19vcmllbnQiOnRydWUsInJvdGF0ZSI6MCwiZ3Jhdml0eSI6ImNlbnRlciIsImJhY2tncm91bmQiOiJub25lIiwicmVzaXplIjoiMzUweDIzMyJ9LCJwdXIiOiJ2YXJpYXRpb24ifX0=--f4ee8f21797f76a14a4d582677ffd97be4cf075a/Untitled%20(82).jpeg 1x,
                 https://cloudsecurityalliance.org/rails/active_storage/representations/redirect/eyJfcmFpbHMiOnsiZGF0YSI6NTg2MDQsInB1ciI6ImJsb2JfaWQifX0=--1379faf9caa9466476e16bb0edc968246d39e181/eyJfcmFpbHMiOnsiZGF0YSI6eyJmb3JtYXQiOiJqcGVnIiwiYXV0b19vcmllbnQiOnRydWUsInJvdGF0ZSI6MCwiZ3Jhdml0eSI6ImNlbnRlciIsImJhY2tncm91bmQiOiJub25lIiwicmVzaXplIjoiNzAweDQ2NiJ9LCJwdXIiOiJ2YXJpYXRpb24ifX0=--d47633c600599e1ae2d57c1081cb044f962f2d6c/Untitled%20(82).jpeg 2x" loading="lazy" class="u-object-fit" alt="The CSA Triangle Chapter&#39;s Year of Innovation and Strategic Partnerships: 2026 Highlights" src="https://cloudsecurityalliance.org/rails/active_storage/representations/redirect/eyJfcmFpbHMiOnsiZGF0YSI6NTg2MDQsInB1ciI6ImJsb2JfaWQifX0=--1379faf9caa9466476e16bb0edc968246d39e181/eyJfcmFpbHMiOnsiZGF0YSI6eyJmb3JtYXQiOiJqcGVnIiwiYXV0b19vcmllbnQiOnRydWUsInJvdGF0ZSI6MCwiZ3Jhdml0eSI6ImNlbnRlciIsImJhY2tncm91bmQiOiJub25lIiwicmVzaXplIjoiMzUweDIzMyJ9LCJwdXIiOiJ2YXJpYXRpb24ifX0=--f4ee8f21797f76a14a4d582677ffd97be4cf075a/Untitled%20(82).jpeg" /><div class="c-tag c-tag--small c-tag--gradient-orange" style="position: absolute; bottom: 10px; left: 10px;">AI</div></div><div class="c-card__item" style="width: calc(100% - 220px);"><h6>The CSA Triangle Chapter&#39;s Year of Innovation and Strategic Partnerships: 2026 Highlights</h6><p class="u-text-color-gray-400 u-mb16">Published: 11/05/2026</p></div><a target="_blank" rel="noopener" class="u-position-center" href="/articles/the-csa-triangle-chapter-s-year-of-innovation-and-strategic-partnerships-2026-highlights"></a></div></div></div></div></div></div></div></div><script>// avoid loading the turbo:load event listener multiple times by using a global variable.
if (window.homepage_carousel_manager_loaded === undefined) {
  create_carousels();
}

// The following function manages the carousels on the homepage, peforming the following tasks:
// 1. Destroy the carousels when the user leaves the homepage.
// 2. Create the carousels when the user enters the homepage.
// 3. Update the carousels when the user navigates to a different tab in the "education" section.
//
function create_carousels()
{
  var carousels = {};

  document.addEventListener("turbo:load", () => {
    const view_courses_content = document.querySelector("#view-courses-content");
    const certificates_content = document.querySelector("#certificates-content");

    // 1. If we leave the homepage, destroy all carousels, to avoid javascript errors:

    if (not_on_homepage()) {
      Object.values(carousels).forEach((value) => {
        value.destroy();
      });
      carousels = {};
      return;
    }

    // 2. Create the 4 carousels on the homepage and store them in hash for future reference:

    carousels["hero_carousel"] = new Glide("#hero_carousel", {
      type: "carousel",
      gap: 0,
      startAt: 0,
      perView: 1,
      autoplay: 5000,
      hoverpause: true,
      animationDuration: 1000,
      animationTimingFunc: "ease-in-out",
    });

    carousels["initiatives-carousel"] = new Glide("#initiatives-carousel", {
      type: "carousel",
      gap: 32,
      perView: 3,
      breakpoints: {
        900: {
          perView: 2,
          peek: { before: 0, after: 130 },
        },
        768: {
          perView: 1,
          peek: { before: 0, after: 130 },
        },
      },
    });

    carousels["certificates-content"] = new Glide("#certificates-content", {
      type: "carousel",
      gap: 32,
      perView: 3,
      breakpoints: {
        800: {
          perView: 2,
          peek: { before: 0, after: 130 },
        },
        500: {
          perView: 1,
          peek: { before: 0, after: 130 },
        },
      },
    });

    carousels["view-courses-content"] = new Glide("#view-courses-content", {
      type: "carousel",
      gap: 32,
      perView: 3,
      breakpoints: {
        800: {
          perView: 2,
          peek: { before: 0, after: 130 },
        },
        500: {
          perView: 1,
          peek: { before: 0, after: 130 },
        },
      },
    });

    carousels["who-we-are-carousel"] = new Glide("#who-we-are-carousel", {
      type: "carousel",
      gap: 16,
      perView: 3,
      dragThreshold: false,
      swipeThreshold: false,
      breakpoints: {
        768: {
          dragThreshold: 120,
          swipeThreshold: 80,
          perView: 2,
          peek: { before: 0, after: 110 },
        },
        500: {
          dragThreshold: 120,
          swipeThreshold: 80,
          perView: 1,
          peek: { before: 0, after: 110 },
        },
      },
    });

    Object.values(carousels).forEach((value) => {
      value.mount();
    });

    // now that glidejs is loaded, we can mark the manager as loaded.
    window.homepage_carousel_manager_loaded = true;

    // 3. Update the carousels when the user navigates to a different tab in the "education" section:

    // The 2 carousels in the "education" section are shown dynamically when the user selects a specific tab..
    // Glide.js does not support dynamic content, so we need to update the carousels when the content is shown.
    // We use the "dynamic-content:show" event to trigger the update (see the dynamic-content stimulus controller).
    view_courses_content.addEventListener("dynamic-content:show", (event) => {
      carousels["view-courses-content"].update();
    });

    certificates_content.addEventListener("dynamic-content:show", (event) => {
      carousels["certificates-content"].update();
    });
  });
}

function not_on_homepage() {
  return document.querySelector("#hero_carousel") === null;
