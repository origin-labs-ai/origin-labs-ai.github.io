slotUnfocused__kGd8Y" style="--slot-scale:0.85"><button type="button" class="FoundryCards_cardLink__u_iM6" tabindex="-1" aria-label="Scientific models"><div class="FoundryCards_copy__qvbmf"><h3 class="FoundryCards_heading__23Nzi">Scientific models</h3><p class="FoundryCards_body__irG5H">Predict structures and generate sequences without leaving your workflow.</p></div><div class="FoundryCards_iconBg__16IJi"><img alt="" loading="lazy" width="400" height="400" decoding="async" data-nimg="1" class="FoundryCards_bg__aunlY" style="color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/7CPYjlUITohZMbv5XDNFrX/63575b2a01358f6b6dc6a433d10487ad/scientific_models_bg.jpg"/><span class="FoundryCards_iconWrap__qU8ZV" style="--icon-url:url(&quot;https://images.ctfassets.net/kzeezny59h5p/TtAddIPSetYYhSU2ZawgN/27d8b4c443fa033b95fcf218134fb8ac/scientific_models_icon.svg&quot;)"><img alt="" loading="lazy" width="200" height="200" decoding="async" data-nimg="1" class="FoundryCards_iconOverlay__c40WN" style="color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/TtAddIPSetYYhSU2ZawgN/27d8b4c443fa033b95fcf218134fb8ac/scientific_models_icon.svg"/><span class="FoundryCards_iconMask__CNpcq" aria-hidden="true"></span></span></div></button></div><div class="FoundryCards_cardSlot__8TR2l FoundryCards_slotUnfocused__kGd8Y" style="--slot-scale:0.85"><button type="button" class="FoundryCards_cardLink__u_iM6" tabindex="-1" aria-label="Connectors"><div class="FoundryCards_copy__qvbmf"><h3 class="FoundryCards_heading__23Nzi">Connectors</h3><p class="FoundryCards_body__irG5H">Pull instrument data straight into an agent&#x27;s next step, no manual transfer.</p></div><div class="FoundryCards_iconBg__16IJi"><img alt="" loading="lazy" width="400" height="400" decoding="async" data-nimg="1" class="FoundryCards_bg__aunlY" style="color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/6JrdpfJoxXtgB70vudSbEV/1f627220bec49af754aca1792f3ae984/connectors_bg.jpg"/><span class="FoundryCards_iconWrap__qU8ZV" style="--icon-url:url(&quot;https://images.ctfassets.net/kzeezny59h5p/272eIzY9M0QGdrZTBKPm2b/c6eaf14a6ccf40bc29a472a67ca9daaf/connectors_icon.svg&quot;)"><img alt="" loading="lazy" width="200" height="200" decoding="async" data-nimg="1" class="FoundryCards_iconOverlay__c40WN" style="color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/272eIzY9M0QGdrZTBKPm2b/c6eaf14a6ccf40bc29a472a67ca9daaf/connectors_icon.svg"/><span class="FoundryCards_iconMask__CNpcq" aria-hidden="true"></span></span></div></button></div><div class="FoundryCards_cardSlot__8TR2l FoundryCards_slotUnfocused__kGd8Y FoundryCards_cardDark__ST9Vz" style="--slot-scale:0.85"><button type="button" class="FoundryCards_cardLink__u_iM6" tabindex="-1" aria-label="Start today"><div class="FoundryCards_copy__qvbmf"><h3 class="FoundryCards_heading__23Nzi">Start today</h3><p class="FoundryCards_body__irG5H">Tell us about your program to start building Science Foundries.</p><span class="FoundryCards_cta__LEvWh" aria-hidden="true">Get in touch</span></div></button></div></div></div><button type="button" class="FoundryCards_arrow__GHoWt FoundryCards_arrowNext__tSu9m" aria-label="Next card"><svg width="10.5" height="21" viewBox="0 0 10.5 21" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.5 1.54883L12 12.0488L1.5 22.5488" stroke="#000DB5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div></div></section><section class="TimedTabs_root__DPLav"><svg class="TimedTabs_hiddenDefs__0xDsm" width="0" height="0" aria-hidden="true" focusable="false"><defs><linearGradient id="timedTabsSparkleGrad-R2ppvkq" x1="-0.14071" y1="0.307206" x2="9.40319" y2="13.3405" gradientUnits="userSpaceOnUse"><stop offset="0.206731" stop-color="#D8C8F5"></stop><stop offset="0.7529" stop-color="#6764F2"></stop></linearGradient></defs></svg><div class="hpContainer"><div class="intro TimedTabs_intro__6kyLH"><h2 class="introHeading">Everything for teams across discovery, pre-clinical, and process development</h2></div><div class="TimedTabs_layout__ALvHT"><div class="TimedTabs_tabsCol__IP7bK"><ul class="TimedTabs_tabs__0bJlB" role="tablist" aria-orientation="vertical"><li class="TimedTabs_tab__f6hrk TimedTabs_isActive__T__XP"><button type="button" id="timed-tab-R2ppvkq-0" class="TimedTabs_tabTrigger__WvpYK" role="tab" aria-selected="true" aria-controls="timed-tab-panel-R2ppvkq-0" tabindex="0"><h3 class="TimedTabs_tabHeading__on76X">Notebook</h3><span class="TimedTabs_tabSubheading__JDM7L"><svg class="TimedTabs_sparkle__cqK8F" width="13" height="16" viewBox="0 0 13 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5.73588 0.521923C5.54042 5.63469 2.47133 7.135 0.523857 7.29678C0.238491 7.32049 0 7.54739 0 7.83373C0 8.12008 0.238491 8.34697 0.523857 8.37068C2.47133 8.53247 5.54042 10.0328 5.73588 15.1455C5.74688 15.4332 5.97909 15.6675 6.26699 15.6675C6.55489 15.6675 6.7871 15.4332 6.7981 15.1455C6.99356 10.0328 10.0626 8.53247 12.0101 8.37068C12.2955 8.34697 12.534 8.12008 12.534 7.83373C12.534 7.54738 12.2955 7.32049 12.0101 7.29679C10.0626 7.135 6.99356 5.63469 6.7981 0.521923C6.7871 0.234233 6.55489 0 6.26699 0C5.97909 0 5.74688 0.234233 5.73588 0.521923Z" fill="url(#timedTabsSparkleGrad-R2ppvkq)"></path></svg><span>Record, retrieve, and share your work</span></span></button><div id="timed-tab-panel-R2ppvkq-0" class="TimedTabs_tabPanel__ZQNNL" role="tabpanel" aria-labelledby="timed-tab-R2ppvkq-0" aria-hidden="false"><div class="TimedTabs_tabPanelInner__Z1_2o"><p class="TimedTabs_tabBody__nshq1">Capture and structure data with templatized notebook entries. The underlying entities, samples, and results are recorded automatically. No duplicates and knowledge isn’t lost between teams.</p><a class="TimedTabs_tabCta__VOckG" href="/notebook">Learn more<svg class="TimedTabs_ctaChevron__2h7Br" width="4" height="7" viewBox="0 0 4 7" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M0.75 0.75L3 3.5L0.75 6.25" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div><div class="TimedTabs_divider__1632a"><div class="TimedTabs_dividerFill__Ib6oM"></div></div></li><li class="TimedTabs_tab__f6hrk"><button type="button" id="timed-tab-R2ppvkq-1" class="TimedTabs_tabTrigger__WvpYK" role="tab" aria-selected="false" aria-controls="timed-tab-panel-R2ppvkq-1" tabindex="-1"><h3 class="TimedTabs_tabHeading__on76X">Automation</h3><span class="TimedTabs_tabSubheading__JDM7L"><svg class="TimedTabs_sparkle__cqK8F" width="13" height="16" viewBox="0 0 13 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5.73588 0.521923C5.54042 5.63469 2.47133 7.135 0.523857 7.29678C0.238491 7.32049 0 7.54739 0 7.83373C0 8.12008 0.238491 8.34697 0.523857 8.37068C2.47133 8.53247 5.54042 10.0328 5.73588 15.1455C5.74688 15.4332 5.97909 15.6675 6.26699 15.6675C6.55489 15.6675 6.7871 15.4332 6.7981 15.1455C6.99356 10.0328 10.0626 8.53247 12.0101 8.37068C12.2955 8.34697 12.534 8.12008 12.534 7.83373C12.534 7.54738 12.2955 7.32049 12.0101 7.29679C10.0626 7.135 6.99356 5.63469 6.7981 0.521923C6.7871 0.234233 6.55489 0 6.26699 0C5.97909 0 5.74688 0.234233 5.73588 0.521923Z" fill="url(#timedTabsSparkleGrad-R2ppvkq)"></path></svg><span>Go from instrument run to scientific decision automatically</span></span></button><div id="timed-tab-panel-R2ppvkq-1" class="TimedTabs_tabPanel__ZQNNL" role="tabpanel" aria-labelledby="timed-tab-R2ppvkq-1" aria-hidden="true" inert=""><div class="TimedTabs_tabPanelInner__Z1_2o"><p class="TimedTabs_tabBody__nshq1">Connect workcells, liquid handlers, and analytical instruments to your scientific record. Send instructions, get results linked to the original experiments, then turn the workflow into an optimized template.</p><a class="TimedTabs_tabCta__VOckG" href="/automation">Learn more<svg class="TimedTabs_ctaChevron__2h7Br" width="4" height="7" viewBox="0 0 4 7" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M0.75 0.75L3 3.5L0.75 6.25" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div><div class="TimedTabs_divider__1632a"><div class="TimedTabs_dividerFill__Ib6oM"></div></div></li><li class="TimedTabs_tab__f6hrk"><button type="button" id="timed-tab-R2ppvkq-2" class="TimedTabs_tabTrigger__WvpYK" role="tab" aria-selected="false" aria-controls="timed-tab-panel-R2ppvkq-2" tabindex="-1"><h3 class="TimedTabs_tabHeading__on76X">Developer Platform</h3><span class="TimedTabs_tabSubheading__JDM7L"><svg class="TimedTabs_sparkle__cqK8F" width="13" height="16" viewBox="0 0 13 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5.73588 0.521923C5.54042 5.63469 2.47133 7.135 0.523857 7.29678C0.238491 7.32049 0 7.54739 0 7.83373C0 8.12008 0.238491 8.34697 0.523857 8.37068C2.47133 8.53247 5.54042 10.0328 5.73588 15.1455C5.74688 15.4332 5.97909 15.6675 6.26699 15.6675C6.55489 15.6675 6.7871 15.4332 6.7981 15.1455C6.99356 10.0328 10.0626 8.53247 12.0101 8.37068C12.2955 8.34697 12.534 8.12008 12.534 7.83373C12.534 7.54738 12.2955 7.32049 12.0101 7.29679C10.0626 7.135 6.99356 5.63469 6.7981 0.521923C6.7871 0.234233 6.55489 0 6.26699 0C5.97909 0 5.74688 0.234233 5.73588 0.521923Z" fill="url(#timedTabsSparkleGrad-R2ppvkq)"></path></svg><span>Build, connect, and automate R&amp;D with a full developer suite</span></span></button><div id="timed-tab-panel-R2ppvkq-2" class="TimedTabs_tabPanel__ZQNNL" role="tabpanel" aria-labelledby="timed-tab-R2ppvkq-2" aria-hidden="true" inert=""><div class="TimedTabs_tabPanelInner__Z1_2o"><p class="TimedTabs_tabBody__nshq1">Develop on Benchling with REST APIs, SDKs, and shareable apps your team controls. Tap a directory of partner connectors and models, or use vibe coding to build your own applications.</p><a class="TimedTabs_tabCta__VOckG" href="/developer-platform">Learn more<svg class="TimedTabs_ctaChevron__2h7Br" width="4" height="7" viewBox="0 0 4 7" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M0.75 0.75L3 3.5L0.75 6.25" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div><div class="TimedTabs_divider__1632a"><div class="TimedTabs_dividerFill__Ib6oM"></div></div></li><li class="TimedTabs_tab__f6hrk"><button type="button" id="timed-tab-R2ppvkq-3" class="TimedTabs_tabTrigger__WvpYK" role="tab" aria-selected="false" aria-controls="timed-tab-panel-R2ppvkq-3" tabindex="-1"><h3 class="TimedTabs_tabHeading__on76X">Ecosystem</h3><span class="TimedTabs_tabSubheading__JDM7L"><svg class="TimedTabs_sparkle__cqK8F" width="13" height="16" viewBox="0 0 13 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5.73588 0.521923C5.54042 5.63469 2.47133 7.135 0.523857 7.29678C0.238491 7.32049 0 7.54739 0 7.83373C0 8.12008 0.238491 8.34697 0.523857 8.37068C2.47133 8.53247 5.54042 10.0328 5.73588 15.1455C5.74688 15.4332 5.97909 15.6675 6.26699 15.6675C6.55489 15.6675 6.7871 15.4332 6.7981 15.1455C6.99356 10.0328 10.0626 8.53247 12.0101 8.37068C12.2955 8.34697 12.534 8.12008 12.534 7.83373C12.534 7.54738 12.2955 7.32049 12.0101 7.29679C10.0626 7.135 6.99356 5.63469 6.7981 0.521923C6.7871 0.234233 6.55489 0 6.26699 0C5.97909 0 5.74688 0.234233 5.73588 0.521923Z" fill="url(#timedTabsSparkleGrad-R2ppvkq)"></path></svg><span>Connect your team to the right AI and technology tools</span></span></button><div id="timed-tab-panel-R2ppvkq-3" class="TimedTabs_tabPanel__ZQNNL" role="tabpanel" aria-labelledby="timed-tab-R2ppvkq-3" aria-hidden="true" inert=""><div class="TimedTabs_tabPanelInner__Z1_2o"><p class="TimedTabs_tabBody__nshq1">Choose from a library of scientific models, connectors, automation tools, and partner apps, all built for Benchling&#x27;s data model. Install them quickly and get back to doing science.</p><a class="TimedTabs_tabCta__VOckG" href="/ecosystem">Learn more<svg class="TimedTabs_ctaChevron__2h7Br" width="4" height="7" viewBox="0 0 4 7" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M0.75 0.75L3 3.5L0.75 6.25" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div><div class="TimedTabs_divider__1632a"><div class="TimedTabs_dividerFill__Ib6oM"></div></div></li><li class="TimedTabs_tab__f6hrk"><button type="button" id="timed-tab-R2ppvkq-4" class="TimedTabs_tabTrigger__WvpYK" role="tab" aria-selected="false" aria-controls="timed-tab-panel-R2ppvkq-4" tabindex="-1"><h3 class="TimedTabs_tabHeading__on76X">Validated Cloud</h3><span class="TimedTabs_tabSubheading__JDM7L"><svg class="TimedTabs_sparkle__cqK8F" width="13" height="16" viewBox="0 0 13 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5.73588 0.521923C5.54042 5.63469 2.47133 7.135 0.523857 7.29678C0.238491 7.32049 0 7.54739 0 7.83373C0 8.12008 0.238491 8.34697 0.523857 8.37068C2.47133 8.53247 5.54042 10.0328 5.73588 15.1455C5.74688 15.4332 5.97909 15.6675 6.26699 15.6675C6.55489 15.6675 6.7871 15.4332 6.7981 15.1455C6.99356 10.0328 10.0626 8.53247 12.0101 8.37068C12.2955 8.34697 12.534 8.12008 12.534 7.83373C12.534 7.54738 12.2955 7.32049 12.0101 7.29679C10.0626 7.135 6.99356 5.63469 6.7981 0.521923C6.7871 0.234233 6.55489 0 6.26699 0C5.97909 0 5.74688 0.234233 5.73588 0.521923Z" fill="url(#timedTabsSparkleGrad-R2ppvkq)"></path></svg><span>Stay compliant from discovery through development</span></span></button><div id="timed-tab-panel-R2ppvkq-4" class="TimedTabs_tabPanel__ZQNNL" role="tabpanel" aria-labelledby="timed-tab-R2ppvkq-4" aria-hidden="true" inert=""><div class="TimedTabs_tabPanelInner__Z1_2o"><p class="TimedTabs_tabBody__nshq1">Validated Cloud offers a single, dedicated tenant from discovery through development without switching systems. Compliance controls for 21 CFR Part 11 and Annex 11 are built into the platform.</p><a class="TimedTabs_tabCta__VOckG" href="/validated-cloud">Learn more<svg class="TimedTabs_ctaChevron__2h7Br" width="4" height="7" viewBox="0 0 4 7" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M0.75 0.75L3 3.5L0.75 6.25" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div><div class="TimedTabs_divider__1632a"><div class="TimedTabs_dividerFill__Ib6oM"></div></div></li><li class="TimedTabs_tab__f6hrk"><button type="button" id="timed-tab-R2ppvkq-5" class="TimedTabs_tabTrigger__WvpYK" role="tab" aria-selected="false" aria-controls="timed-tab-panel-R2ppvkq-5" tabindex="-1"><h3 class="TimedTabs_tabHeading__on76X">Security and compliance</h3><span class="TimedTabs_tabSubheading__JDM7L"><svg class="TimedTabs_sparkle__cqK8F" width="13" height="16" viewBox="0 0 13 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5.73588 0.521923C5.54042 5.63469 2.47133 7.135 0.523857 7.29678C0.238491 7.32049 0 7.54739 0 7.83373C0 8.12008 0.238491 8.34697 0.523857 8.37068C2.47133 8.53247 5.54042 10.0328 5.73588 15.1455C5.74688 15.4332 5.97909 15.6675 6.26699 15.6675C6.55489 15.6675 6.7871 15.4332 6.7981 15.1455C6.99356 10.0328 10.0626 8.53247 12.0101 8.37068C12.2955 8.34697 12.534 8.12008 12.534 7.83373C12.534 7.54738 12.2955 7.32049 12.0101 7.29679C10.0626 7.135 6.99356 5.63469 6.7981 0.521923C6.7871 0.234233 6.55489 0 6.26699 0C5.97909 0 5.74688 0.234233 5.73588 0.521923Z" fill="url(#timedTabsSparkleGrad-R2ppvkq)"></path></svg><span>Operate with enterprise-grade security and privacy</span></span></button><div id="timed-tab-panel-R2ppvkq-5" class="TimedTabs_tabPanel__ZQNNL" role="tabpanel" aria-labelledby="timed-tab-R2ppvkq-5" aria-hidden="true" inert=""><div class="TimedTabs_tabPanelInner__Z1_2o"><p class="TimedTabs_tabBody__nshq1">Benchling maintains SOC 2 Type II, ISO 27001, GDPR, and CCPA compliance, so your data stays protected under the same standards trusted by leading biopharma c