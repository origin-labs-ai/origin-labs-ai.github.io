on:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/42Dht26CrOVhF1Vj8J2Lq6/e319d6dcc363fced2dc1a6cdacc8e198/drive-download-20261014T194456Z-1-001_xaira.svg"/></li><li class="LogoTicker_logo__KlBt2" aria-hidden="true"><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="LogoTicker_image__dKyuj" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/4dGq2WfKKaKUSLCFzDQ9XB/53945a7b1a6ae8f6c1808c29332f6c90/enveda_1.png"/></li><li class="LogoTicker_logo__KlBt2" aria-hidden="true"><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="LogoTicker_image__dKyuj" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/itZBEY0MR6s3yTfaerqvU/27627c027b2b756cbbdaafb6e53bbabe/drive-download-20261014T194456Z-1-001_generate.svg"/></li><li class="LogoTicker_logo__KlBt2" aria-hidden="true"><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="LogoTicker_image__dKyuj" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/25eL1Qy9PBGhxqEzJWd1yH/490c8c4d9c8d683ea309c00bcff90da9/drive-download-20261014T194456Z-1-001_Vertex.svg"/></li></ul></section><section class="TabbedCards_root__BZKEx"><div class="hpContainer"><div class="intro TabbedCards_intro__cawZp"><h2 class="introHeading">Better, faster decisions with Science Foundries </h2><p class="introBody TabbedCards_introBody__nYIU_"></p></div><div class="TabbedCards_card__a2Ee4"><div class="TabbedCards_tabs__2Zwt6" role="tablist"><button type="button" id="R1ppvkq-tab-0" class="TabbedCards_tab__OkCUD TabbedCards_isActive__4S8wy" role="tab" aria-selected="true" aria-controls="R1ppvkq-panel-0" tabindex="0">Agents</button><button type="button" id="R1ppvkq-tab-1" class="TabbedCards_tab__OkCUD" role="tab" aria-selected="false" aria-controls="R1ppvkq-panel-1" tabindex="-1">Models</button><button type="button" id="R1ppvkq-tab-2" class="TabbedCards_tab__OkCUD" role="tab" aria-selected="false" aria-controls="R1ppvkq-panel-2" tabindex="-1">Scientific Context</button></div><div class="TabbedCards_panels__orf2f"><div id="R1ppvkq-panel-0" class="TabbedCards_panel__79Bv1 TabbedCards_isActive__4S8wy" role="tabpanel" aria-labelledby="R1ppvkq-tab-0" aria-hidden="false"><div class="TabbedCards_cardMain__AdcW0"><div class="TabbedCards_cardContent__Z5w18"><img alt="A white product screenshot of creating a Benchling new agent" loading="lazy" width="776" height="457" decoding="async" data-nimg="1" class="TabbedCards_cardMedia__6x_36" style="color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/6XOPTIIfYdbX57Mb28xi21/13e456e9351c5d467d9c4881046c2126/Agents__1_.png"/></div><div class="TabbedCards_cardText__EzZJZ"><p class="TabbedCards_cardBody__7e00F">Build complete agentic workflows guided by scientists, across all your R&amp;D programs.</p><blockquote class="TabbedCards_cardQuote__HhbJC"><p class="TabbedCards_cardQuoteBody__NbM4S">AI and automation are transforming the drug discovery process. Science Foundries are the perfect complement to automated labs. Teams of agents keep science moving by automating the data capture, analysis, and handoffs needed to turn one experiment into the next.</p><footer class="TabbedCards_cardQuoteAttribution__ndyiI"><img alt="John McGee" loading="lazy" width="36" height="36" decoding="async" data-nimg="1" class="TabbedCards_cardQuotePhoto__NVZoy" style="color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/5qxenUuC87mczPFA1sOrqh/4a3f963d46d6f2d00f4a30325920b985/JohnMcgee.png"/><div class="TabbedCards_cardQuoteAttributionText__jOcfw"><span class="TabbedCards_cardQuoteName__Zz0Uf">John McGee, Ph.D.</span><span class="TabbedCards_cardQuoteTitle__lafgE">Scientific Co-Founder and Executive Vice President, Head of Platform, Parabilis Medicines</span></div></footer><cite class="TabbedCards_cardQuoteLogo__4KlD3"><img alt="parabilis" loading="lazy" width="100" height="23" decoding="async" data-nimg="1" style="color:transparent;height:1.9375rem" src="https://images.ctfassets.net/kzeezny59h5p/4sbN3KSLpUYuCNDOT6vMvL/840b5063f9f96264a5f84a97944b7d52/parabilis_1.png"/></cite></blockquote></div></div></div><div id="R1ppvkq-panel-1" class="TabbedCards_panel__79Bv1" role="tabpanel" aria-labelledby="R1ppvkq-tab-1" aria-hidden="true" inert=""><div class="TabbedCards_cardMain__AdcW0"><div class="TabbedCards_cardContent__Z5w18"><img alt="Models: Lilly TuneLab, AlphaFold, Boltz-2, Claude, OpenAI, Chai Discovery, Gemini" loading="lazy" width="776" height="457" decoding="async" data-nimg="1" class="TabbedCards_cardMedia__6x_36" style="color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/3MdewrB5wEYcJCfj43jg2Y/51536ff30c0c94703cf16678599fbfdd/Models__1_.png"/></div><div class="TabbedCards_cardText__EzZJZ"><p class="TabbedCards_cardBody__7e00F">Access the best intelligence with agents over scientific models. Predict structures, generate sequences, assess properties, and more.</p><blockquote class="TabbedCards_cardQuote__HhbJC"><p class="TabbedCards_cardQuoteBody__NbM4S">This past year, we saw our Boltz de-novo protein design and binding prediction models make incredible strides with adoption across hundreds of thousands users. Now, it’s all about integration, linking models with experiments, leveraging agents that learn from experimental data.</p><footer class="TabbedCards_cardQuoteAttribution__ndyiI"><img alt="Gabriele Corso" loading="lazy" width="36" height="36" decoding="async" data-nimg="1" class="TabbedCards_cardQuotePhoto__NVZoy" style="color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/4FLoLGgPK5vVEJmh42pyj4/66d5ab78b061e9e0148269150a3eda0d/1681875455377.jpg"/><div class="TabbedCards_cardQuoteAttributionText__jOcfw"><span class="TabbedCards_cardQuoteName__Zz0Uf">Gabriele Corso</span><span class="TabbedCards_cardQuoteTitle__lafgE">Founder, Boltz</span></div></footer><cite class="TabbedCards_cardQuoteLogo__4KlD3"><img alt="Boltz" loading="lazy" width="100" height="23" decoding="async" data-nimg="1" style="color:transparent;height:1.5rem" src="https://images.ctfassets.net/kzeezny59h5p/3PhfCTCJz62u1wiWL9SV75/ddfd0d832311b7ef38790eea3ab95508/drive-download-20261014T194456Z-1-001_Boltz__only_for_models_quote__NOT_a_customer_.svg"/></cite></blockquote></div></div></div><div id="R1ppvkq-panel-2" class="TabbedCards_panel__79Bv1" role="tabpanel" aria-labelledby="R1ppvkq-tab-2" aria-hidden="true" inert=""><div class="TabbedCards_cardMain__AdcW0"><div class="TabbedCards_cardContent__Z5w18"><img alt="decision support placeholder" loading="lazy" width="776" height="457" decoding="async" data-nimg="1" class="TabbedCards_cardMedia__6x_36" style="color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/7rjL388Vo2AWDNpMQeilOz/4aff2f906058cc1658fa8f8e83252ae5/Scientific_context.png"/></div><div class="TabbedCards_cardText__EzZJZ"><p class="TabbedCards_cardBody__7e00F">Our team of agents knows your science and connects historical data, current experiments, and external data for every program.</p><blockquote class="TabbedCards_cardQuote__HhbJC"><p class="TabbedCards_cardQuoteBody__NbM4S">We leveraged Benchling AI to ingest nearly 1,000 historical reports and saw 100% accuracy in natural language queries across the body of data, outperforming several approaches we had tried previously.</p><footer class="TabbedCards_cardQuoteAttribution__ndyiI"><img alt="Hanne Bak" loading="lazy" width="36" height="36" decoding="async" data-nimg="1" class="TabbedCards_cardQuotePhoto__NVZoy" style="color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/25BI01v6PNXPpD0dPupmcL/3c830d284655c5c85047be37aa5d749b/Hanne_Bak.png"/><div class="TabbedCards_cardQuoteAttributionText__jOcfw"><span class="TabbedCards_cardQuoteName__Zz0Uf">Hanne Bak</span><span class="TabbedCards_cardQuoteTitle__lafgE"> SVP PAPD, Regeneron</span></div></footer><cite class="TabbedCards_cardQuoteLogo__4KlD3"><img alt="Regeneron" loading="lazy" width="100" height="23" decoding="async" data-nimg="1" style="color:transparent;height:1rem" src="https://images.ctfassets.net/kzeezny59h5p/1z3FGBCk0qql40bABkGXv3/6494ae964e5061b3e17aafd2a00b04ae/drive-download-20261014T194456Z-1-001_Regeneron_logo.svg"/></cite></blockquote></div></div></div></div></div></div></section><section class="FoundryCards_root__s_sgl"><div class="ParticleField_root__kLzQe" aria-hidden="true"></div><div class="hpContainer"><div class="intro FoundryCards_intro__dF2Iv"><h2 class="introHeading">Build your Foundries</h2><p class="introBody">Science Foundries are teams of agents that run a complete R&amp;D workflow, guided by your scientists. Start with these building blocks.</p></div><ul class="FoundryCards_cards__fqaj4 staggerList"><li class="FoundryCards_card__YvZJ6 staggerItem" style="--stagger-index:0"><a class="FoundryCards_cardLink__u_iM6" href="/biologics"><div class="FoundryCards_copy__qvbmf"><h3 class="FoundryCards_heading__23Nzi">Biology</h3><p class="FoundryCards_body__irG5H">Automate biology workflows end-to-end, with agents guided by your scientists.</p></div><div class="FoundryCards_iconBg__16IJi"><img alt="" loading="lazy" width="400" height="400" decoding="async" data-nimg="1" class="FoundryCards_bg__aunlY" style="color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/3lEiAZr6KJTGKLkuYb7dVN/682d803755a1a6191e6bd0cf446e4da1/biology_bg.jpg"/><span class="FoundryCards_iconWrap__qU8ZV" style="--icon-url:url(&quot;https://images.ctfassets.net/kzeezny59h5p/423zXMYfyr84yrAAJPgmov/9f4ad9b427aa341975b8363541cd6b17/biology_icon.svg&quot;)"><img alt="" loading="lazy" width="200" height="200" decoding="async" data-nimg="1" class="FoundryCards_iconOverlay__c40WN" style="color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/423zXMYfyr84yrAAJPgmov/9f4ad9b427aa341975b8363541cd6b17/biology_icon.svg"/><span class="FoundryCards_iconMask__CNpcq" aria-hidden="true"></span></span></div></a></li><li class="FoundryCards_card__YvZJ6 staggerItem" style="--stagger-index:1"><a class="FoundryCards_cardLink__u_iM6" href="/chemistry"><div class="FoundryCards_copy__qvbmf"><h3 class="FoundryCards_heading__23Nzi">Chemistry</h3><p class="FoundryCards_body__irG5H">Design molecules, capture reactions, and apply predictive models across R&amp;D workflows.</p></div><div class="FoundryCards_iconBg__16IJi"><img alt="" loading="lazy" width="400" height="400" decoding="async" data-nimg="1" class="FoundryCards_bg__aunlY" style="color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/3UCtnArLc3bC7sPcq4skHI/fe73446d805081c14fbc49659799d428/chemistry_bg.jpg"/><span class="FoundryCards_iconWrap__qU8ZV" style="--icon-url:url(&quot;https://images.ctfassets.net/kzeezny59h5p/1xX8TNQb9XrHOp9xvVXiDf/2645cd470f414ce913a7df1d8f3418d3/chemistry_icon.svg&quot;)"><img alt="" loading="lazy" width="200" height="200" decoding="async" data-nimg="1" class="FoundryCards_iconOverlay__c40WN" style="color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/1xX8TNQb9XrHOp9xvVXiDf/2645cd470f414ce913a7df1d8f3418d3/chemistry_icon.svg"/><span class="FoundryCards_iconMask__CNpcq" aria-hidden="true"></span></span></div></a></li><li class="FoundryCards_card__YvZJ6 staggerItem" style="--stagger-index:2"><a class="FoundryCards_cardLink__u_iM6" href="/solutions/rna-therapeutics-rd"><div class="FoundryCards_copy__qvbmf"><h3 class="FoundryCards_heading__23Nzi">RNA and Peptides</h3><p class="FoundryCards_body__irG5H"> Model and register modified RNA, oligos, and peptides, ready for agents to act on.</p></div><div class="FoundryCards_iconBg__16IJi"><img alt="" loading="lazy" width="400" height="400" decoding="async" data-nimg="1" class="FoundryCards_bg__aunlY" style="color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/3AgDn0UTOJ2AAsGXXEhwsG/239372159daa76dceec4d8417aaab4ba/RNA_peptides_bg.jpg"/><span class="FoundryCards_iconWrap__qU8ZV" style="--icon-url:url(&quot;https://images.ctfassets.net/kzeezny59h5p/4pqMCt4bjp0lVa0abygtrB/48b488b7babf6e50da2b48e4b1d19c9a/RNA_peptides_icon.svg&quot;)"><img alt="" loading="lazy" width="200" height="200" decoding="async" data-nimg="1" class="FoundryCards_iconOverlay__c40WN" style="color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/4pqMCt4bjp0lVa0abygtrB/48b488b7babf6e50da2b48e4b1d19c9a/RNA_peptides_icon.svg"/><span class="FoundryCards_iconMask__CNpcq" aria-hidden="true"></span></span></div></a></li><li class="FoundryCards_card__YvZJ6 staggerItem" style="--stagger-index:3"><a class="FoundryCards_cardLink__u_iM6" href="/bioprocess"><div class="FoundryCards_copy__qvbmf"><h3 class="FoundryCards_heading__23Nzi">Development</h3><p class="FoundryCards_body__irG5H">Draft your next DoE with agents informed by historical data, run designs, and execution results.</p></div><div class="FoundryCards_iconBg__16IJi"><img alt="" loading="lazy" width="400" height="400" decoding="async" data-nimg="1" class="FoundryCards_bg__aunlY" style="color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/2aGdyr6j0WOjDnTveLPgTd/003b8cd12454be12cfea90c44397c3cd/development_bg.jpg"/><span class="FoundryCards_iconWrap__qU8ZV" style="--icon-url:url(&quot;https://images.ctfassets.net/kzeezny59h5p/4aGrRkTGVbT5LywDarqlVx/957934d1204772bbbe98c122cc602626/development_icon.svg&quot;)"><img alt="" loading="lazy" width="200" height="200" decoding="async" data-nimg="1" class="FoundryCards_iconOverlay__c40WN" style="color:transparent" src="https://images.ctfassets.net/kzeezny59h5p/4aGrRkTGVbT5LywDarqlVx/957934d1204772bbbe98c122cc602626/development_icon.svg"/><span class="FoundryCards_iconMask__CNpcq" aria-hidden="true"></span></span></div></a></li><li class="FoundryCards_card__YvZJ6 staggerItem" style="--stagger-index:4"><a class="FoundryCards_cardLink__u_iM6" href="/direc