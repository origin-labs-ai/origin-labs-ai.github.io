":\"leadership\",\"content\":{\"__typename\":\"PageEvergreenContent\"}}},{\"internalPage\":null,\"name\":\"Contact Us\",\"linkType\":\"Internal\",\"url\":\"/contact-us\",\"openInNewTab\":false}]}},{\"internalPage\":null,\"name\":\"Join Us\",\"linkType\":\"Internal\",\"url\":null,\"openInNewTab\":false,\"subNavCollection\":{\"items\":[{\"internalPage\":null,\"name\":\"Careers\",\"linkType\":\"Internal\",\"url\":\"/careers\",\"openInNewTab\":false},{\"name\":\"Life at Benchling\",\"linkType\":\"Internal\",\"url\":null,\"openInNewTab\":false,\"internalPage\":{\"slug\":\"life-at-benchling\",\"content\":{\"__typename\":\"PageCareers\"}}},{\"name\":\"DEI\",\"linkType\":\"Internal\",\"url\":null,\"openInNewTab\":false,\"internalPage\":{\"slug\":\"dei\",\"content\":{\"__typename\":\"PageCareers\"}}},{\"name\":\"University Recruiting\",\"linkType\":\"Internal\",\"url\":null,\"openInNewTab\":false,\"internalPage\":{\"slug\":\"university-recruiting\",\"content\":{\"__typename\":\"PageCareers\"}}}]}}]}}]}},\"preview\":\"$undefined\",\"image\":null,\"featuredSummary\":\"\",\"backupTitle\":\"Homepage\",\"seo\":{\"name\":\"Homepage\",\"title\":\"Infinite program team for R\u0026D | Benchling\",\"description\":\"Benchling is a cloud-based platform for biotechnology research and development and the only biology-first platform for scientific data, collaboration, and insights.\",\"noIndex\":null,\"noFollow\":null,\"canonicalTag\":null},\"footerType\":null,\"navigationType\":null,\"pageType\":\"PageEvergreenContent\",\"localizationNav\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"Homepage_homepage__GthSW\",\"children\":[[\"$\",\"$L25\",null,{\"heading\":\"Your infinite program team for R\u0026D\",\"body\":\"Build Science Foundries to drive greater speed and better decisions.\",\"primaryCta\":{\"label\":\"Request a demo\",\"href\":\"/request-demo\"},\"secondaryCta\":{\"label\":null,\"href\":null},\"video\":\"https://videos.ctfassets.net/kzeezny59h5p/6cudUYhVRLeZRfhayOEPH1/0f567d2d5be7f7685917843ae66dd27d/Foundry-Hero_02_Less-Compression.mp4\",\"videoMobile\":\"https://videos.ctfassets.net/kzeezny59h5p/2xi7E8k19y2IxsLx4YTvbw/aeca128482cb280e65db385129dc62bd/Foundry-Hero_02_Vert.mp4\",\"poster\":\"https://images.ctfassets.net/kzeezny59h5p/4eH0tjk2R3eNvMQ7YyoGxj/5478c170264f3e8b66265b26ba0c7a7c/videoframe_0.png\",\"promptsCtaLabel\":\"Build your Science Foundry\",\"promptsCtaHref\":\"/science-foundries-inquiry\",\"prompts\":[{\"label\":\"Agentic Workflows\",\"prompt\":\"Build me a foundry for antibody discovery. Include agents to generate sequences, plan cloning, coordinate lab work, analyze results, and recommend the next round of designs.\"},{\"label\":\"Historical Context\",\"prompt\":\"Extract process parameters, yields, and quality results from these manufacturing batch records. Compare performance across batches.\"},{\"label\":\"Experimental Insights\",\"prompt\":\"Create an interactive SAR visualization for these compounds. Include a potency heat map, molecule cards, and an analysis of how R-group substitutions affect IC50.\"},{\"label\":\"Faster Decisions\",\"prompt\":\"Evaluate mouse models for our next study. Compare candidates to historical study results, flag models we've already tested, and recommend which to prioritize.\"}]}],[\"$\",\"$L26\",null,{\"heading\":\"1,300+ biotechs run their science on Benchling\",\"logos\":[{\"name\":\"Sanofi\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/76AqLPhlrzpvw9mqWNhk47/39a08dafc23dee495a2b348c0b58ffee/drive-download-20261014T194456Z-1-001_Sanofi_logo.svg\"},{\"name\":\"Moderna\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/71o3A06vsb7tgylwrbu9Il/84d7b81321d315df55127c8c61047223/drive-download-20261014T194456Z-1-001_Moderna.svg\"},{\"name\":\"Novonesis\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/1vJzpuu3bKXUFYJEjbcjsi/eaef29d9b485eaaf3f80da0f0712e612/drive-download-20261014T194456Z-1-001_Novonesis_logo.svg\"},{\"name\":\"Beam Therapeutics\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/4zOBPYKoqVJJtsPTlnrjrg/558d3150892f40e8007a0ccedb3ed17e/drive-download-20261014T194456Z-1-001_Beam_Therapeutics_logo.svg\"},{\"name\":\"Altos\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/1daKXcKrZR9V6OU37VtYVo/c3eec0b61e6650d0f9b21b634817eff0/drive-download-20261014T194456Z-1-001_Altos_Labs_logo.svg\"},{\"name\":\"Parabilis Medicines\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/4sbN3KSLpUYuCNDOT6vMvL/840b5063f9f96264a5f84a97944b7d52/parabilis_1.png\"},{\"name\":\"AstraZeneca\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/1X6LKiJAy9x5WzVj6YdRKR/1caa46f6fda2230fb937c57e4810ee39/astrazeneca_1.png\"},{\"name\":\"Gilead\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/3TYpTPII7WTnvZW8aoKraZ/f28c30304ba8dc3d7808b74a2687279d/drive-download-20261014T194456Z-1-001_Gilead_logo.svg\"},{\"name\":\"Bayer\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/5me0D6Y5UyI26z0Oc7j59f/781e038f368bde06fc63634da994fa91/drive-download-20261014T194456Z-1-001_Logo_Bayer.svg\"},{\"name\":\"Regeneron\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/1z3FGBCk0qql40bABkGXv3/6494ae964e5061b3e17aafd2a00b04ae/drive-download-20261014T194456Z-1-001_Regeneron_logo.svg\"},{\"name\":\"Merck\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/4xZAkKOUD7Y92NRFE46Ftu/07075a3bf4f1f093051ed57be15955ac/drive-download-20261014T194456Z-1-001_Merck_logo.svg\"},{\"name\":\"Bristol Myers Squibb\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/TYe8XQFrVYR7p69P0rto1/d0e95a899c1ad3906ab5ea9947bd8995/drive-download-20261014T194456Z-1-001_BMS-Logo-updated.svg\"},{\"name\":\"Insitro\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/7h7frzMOlCyqxt888dOqDv/e17afba429719258a8bf27c4b86e920d/drive-download-20261014T194456Z-1-001_Insitro_id4Ss5N6Aw_0.svg\"},{\"name\":\"Xaira Therapeutics\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/42Dht26CrOVhF1Vj8J2Lq6/e319d6dcc363fced2dc1a6cdacc8e198/drive-download-20261014T194456Z-1-001_xaira.svg\"},{\"name\":\"Enveda\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/4dGq2WfKKaKUSLCFzDQ9XB/53945a7b1a6ae8f6c1808c29332f6c90/enveda_1.png\"},{\"name\":\"Generate Biomedicines\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/itZBEY0MR6s3yTfaerqvU/27627c027b2b756cbbdaafb6e53bbabe/drive-download-20261014T194456Z-1-001_generate.svg\"},{\"name\":\"Vertex\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/25eL1Qy9PBGhxqEzJWd1yH/490c8c4d9c8d683ea309c00bcff90da9/drive-download-20261014T194456Z-1-001_Vertex.svg\"}]}],[\"$\",\"$L27\",null,{\"heading\":\"Better, faster decisions with Science Foundries \",\"body\":null,\"cards\":[{\"link\":\"\",\"heading\":\"Agents\",\"body\":\"Build complete agentic workflows guided by scientists, across all your R\u0026D programs.\",\"quote\":\"AI and automation are transforming the drug discovery process. Science Foundries are the perfect complement to automated labs. Teams of agents keep science moving by automating the data capture, analysis, and handoffs needed to turn one experiment into the next.\",\"quoteLogo\":{\"name\":\"parabilis\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/4sbN3KSLpUYuCNDOT6vMvL/840b5063f9f96264a5f84a97944b7d52/parabilis_1.png\",\"height\":31},\"quoteAttribution\":{\"name\":\"John McGee, Ph.D.\",\"title\":\"Scientific Co-Founder and Executive Vice President, Head of Platform, Parabilis Medicines\",\"photo\":{\"src\":\"https://images.ctfassets.net/kzeezny59h5p/5qxenUuC87mczPFA1sOrqh/4a3f963d46d6f2d00f4a30325920b985/JohnMcgee.png\",\"alt\":\"John McGee\"}},\"media\":{\"src\":\"https://images.ctfassets.net/kzeezny59h5p/6XOPTIIfYdbX57Mb28xi21/13e456e9351c5d467d9c4881046c2126/Agents__1_.png\",\"alt\":\"A white product screenshot of creating a Benchling new agent\"}},{\"link\":\"\",\"heading\":\"Models\",\"body\":\"Access the best intelligence with agents over scientific models. Predict structures, generate sequences, assess properties, and more.\",\"quote\":\"This past year, we saw our Boltz de-novo protein design and binding prediction models make incredible strides with adoption across hundreds of thousands users. Now, it’s all about integration, linking models with experiments, leveraging agents that learn from experimental data.\",\"quoteLogo\":{\"name\":\"Boltz\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/3PhfCTCJz62u1wiWL9SV75/ddfd0d832311b7ef38790eea3ab95508/drive-download-20261014T194456Z-1-001_Boltz__only_for_models_quote__NOT_a_customer_.svg\",\"height\":24},\"quoteAttribution\":{\"name\":\"Gabriele Corso\",\"title\":\"Founder, Boltz\",\"photo\":{\"src\":\"https://images.ctfassets.net/kzeezny59h5p/4FLoLGgPK5vVEJmh42pyj4/66d5ab78b061e9e0148269150a3eda0d/1681875455377.jpg\",\"alt\":\"Gabriele Corso\"}},\"media\":{\"src\":\"https://images.ctfassets.net/kzeezny59h5p/3MdewrB5wEYcJCfj43jg2Y/51536ff30c0c94703cf16678599fbfdd/Models__1_.png\",\"alt\":\"Models: Lilly TuneLab, AlphaFold, Boltz-2, Claude, OpenAI, Chai Discovery, Gemini\"}},{\"link\":\"\",\"heading\":\"Scientific Context\",\"body\":\"Our team of agents knows your science and connects historical data, current experiments, and external data for every program.\",\"quote\":\"We leveraged Benchling AI to ingest nearly 1,000 historical reports and saw 100% accuracy in natural language queries across the body of data, outperforming several approaches we had tried previously.\",\"quoteLogo\":{\"name\":\"Regeneron\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/1z3FGBCk0qql40bABkGXv3/6494ae964e5061b3e17aafd2a00b04ae/drive-download-20261014T194456Z-1-001_Regeneron_logo.svg\",\"height\":16},\"quoteAttribution\":{\"name\":\"Hanne Bak\",\"title\":\" SVP PAPD, Regeneron\",\"photo\":{\"src\":\"https://images.ctfassets.net/kzeezny59h5p/25BI01v6PNXPpD0dPupmcL/3c830d284655c5c85047be37aa5d749b/Hanne_Bak.png\",\"alt\":\"Hanne Bak\"}},\"media\":{\"src\":\"https://images.ctfassets.net/kzeezny59h5p/7rjL388Vo2AWDNpMQeilOz/4aff2f906058cc1658fa8f8e83252ae5/Scientific_context.png\",\"alt\":\"decision support placeholder\"}}]}],[\"$\",\"$L28\",null,{\"heading\":\"Build your Foundries\",\"body\":\"Science Foundries are teams of agents that run a complete R\u0026D workflow, guided by your scientists. Start with these building blocks.\",\"cards\":[{\"link\":\"/biologics\",\"heading\":\"Biology\",\"body\":\"Automate biology workflows end-to-end, with agents guided by your scientists.\",\"icon\":\"https://images.ctfassets.net/kzeezny59h5p/423zXMYfyr84yrAAJPgmov/9f4ad9b427aa341975b8363541cd6b17/biology_icon.svg\",\"bg\":\"https://images.ctfassets.net/kzeezny59h5p/3lEiAZr6KJTGKLkuYb7dVN/682d803755a1a6191e6bd0cf446e4da1/biology_bg.jpg\"},{\"link\":\"/chemistry\",\"heading\":\"Chemistry\",\"body\":\"Design molecules, capture reactions, and apply predictive models across R\u0026D workflows.\",\"icon\":\"https://images.ctfassets.net/kzeezny59h5p/1xX8TNQb9XrHOp9xvVXiDf/2645cd470f414ce913a7df1d8f3418d3/chemistry_icon.svg\",\"bg\":\"https://images.ctfassets.net/kzeezny59h5p/3UCtnArLc3bC7sPcq4skHI/fe73446d805081c14fbc49659799d428/chemistry_bg.jpg\"},{\"link\":\"/solutions/rna-therapeutics-rd\",\"heading\":\"RNA and Peptides\",\"body\":\" Model and register modified RNA, oligos, and peptides, ready for agents to act on.\",\"icon\":\"https://images.ctfassets.net/kzeezny59h5p/4pqMCt4bjp0lVa0abygtrB/48b488b7babf6e50da2b48e4b1d19c9a/RNA_peptides_icon.svg\",\"bg\":\"https://images.ctfassets.net/kzeezny59h5p/3AgDn0UTOJ2AAsGXXEhwsG/239372159daa76dceec4d8417aaab4ba/RNA_peptides_bg.jpg\"},{\"link\":\"/bioprocess\",\"heading\":\"Development\",\"body\":\"Draft your next DoE with agents informed by historical data, run designs, and execution results.\",\"icon\":\"https://images.ctfassets.net/kzeezny59h5p/4aGrRkTGVbT5LywDarqlVx/957934d1204772bbbe98c122cc602626/development_icon.svg\",\"bg\":\"https://images.ctfassets.net/kzeezny59h5p/2aGdyr6j0WOjDnTveLPgTd/003b8cd12454be12cfea90c44397c3cd/development_bg.jpg\"},{\"link\":\"/direct-ordering\",\"heading\":\"Direct ordering\",\"body\":\"Order materials and synthesize sequences automatically, no waiting on an email.\",\"icon\":\"https://images.ctfassets.net/kzeezny59h5p/6ucDP2JXqsmPeofUDwZYH6/cbc8e0fe277e8b53521f6eb1138c01f3/Direct_ordering_icon.svg\",\"bg\":\"https://images.ctfassets.net/kzeezny59h5p/5D7NirF2uLdDgXRODnkfx9/d91d21eee486f90abae70f935a09d7fe/ADCs_bg.jpg\"},{\"link\":\"/pipebio\",\"heading\":\"Antibody\",\"body\":\"Formulate antibodies with full lineage, then let agents run the DBTL loop end-to-end.\",\"icon\":\"https://images.ctfassets.net/kzeezny59h5p/QxCyWdIslZHIzmXmhGzFn/e359661bf1d9a3b9928ade28943ec755/antibody_icon.svg\",\"bg\":\"https://images.ctfassets.net/kzeezny59h5p/23jJxhoUqazyDEMwxmvBw3/f591d72ee2bc840592c94c627478b2da/antibody_bg.jpg\"},{\"link\":\"/notebook\",\"heading\":\"Next-gen ELN\",\"body\":\"Capture structured results automatically as agents complete each step.\",\"icon\":\"https://images.ctfassets.net/kzeezny59h5p/4JiM2XzWjTZe94A15CfTAi/5115387ef0452c463559b2a37b04262b/ELN_LIMS_icon.svg\",\"bg\":\"https://images.ctfassets.net/kzeezny59h5p/2HaHgSlNT9xBujRsIaxm6h/dc9a1a257351e1d3a7dd7f5b1c734762/ELN_LIMS_bg.jpg\"},{\"link\":\"/ai/models\",\"heading\":\"Scientific models\",\"body\":\"Predict structures and generate sequences without leaving your workflow.\",\"icon\":\"https://images.ctfassets.net/kzeezny59h5p/TtAddIPSetYYhSU2ZawgN/27d8b4c443fa033b95fcf218134fb8ac/scientific_models_icon.svg\",\"bg\":\"https://images.ctfassets.net/kzeezny59h5p/7CPYjlUITohZMbv5XDNFrX/63575b2a01358f6b6dc6a433d10487ad/scientific_models_bg.jpg\"},{\"link\":\"/ai/connectors\",\"heading\":\"Connectors\",\"body\":\"Pull instrument data straight into an agent's next step, no manual transfer.\",\"icon\":\"https://images.ctfassets.net/kzeezny59h5p/272eIzY9M0QGdrZTBKPm2b/c6eaf14a6ccf40bc29a472a67ca9daaf/connectors_icon.svg\",\"bg\":\"https://images.ctfassets.net/kzeezny59h5p/6JrdpfJoxXtgB70vudSbEV/1f627220bec49af754aca1792f3ae984/connectors_bg.jpg\"},{\"link\":\"/science-foundries-inquiry\",\"heading\":\"Start today\",\"body\":\"Tell us about your program to start building Science Foundries.\",\"dark\":true,\"ctaLabel\":\"Get in touch\"}]}],[\"$\",\"$L29\",null,{\"heading\":\"Everything for teams across discovery, pre-clinical, and process development\",\"tabs\":[{\"heading\":\"Notebook\",\"subheading\":\"Record, retrieve, and share your work\",\"body\":\"Capture and structure data with templatized notebook entries. The underlying entities, samples, and results are recorded automatically. No duplicates and knowledge isn’t lost between teams.\",\"cta\":{\"label\":\"Learn more\",\"href\":\"/notebook\"},\"media\":{\"src\":\"https://images.ctfassets.net/kzeezny59h5p/6g1A2KXZKH7r0KUY3wD7os/7ab3e804be0488825091f040315c2086/01-Notebook.png\",\"alt\":\"Notebook screenshot\"}},{\"heading\":\"Automation\",\"subheading\":\"Go from instrument run to scientific decision automatically\",\"body\":\"Connect workcells, liquid handlers, and analytical instruments to your scientific record. Send instructions, get results linked to the original experiments, then turn the workflow into an optimized template.\",\"cta\":{\"label\":\"Learn more\",\"href\":\"/automation\"},\"media\":{\"src\":\"https://images.ctfassets.net/kzeezny59h5p/3tBNuSEsQEXJ3jLTax0FF/4d351d50a69a85c4789e7dc7faa278f0/02-Automation.jpg\",\"alt\":\"Automation screenshot\"}},{\"heading\":\"Developer Platform\",\"subheading\":\"Build, connect, and automate R\u0026D with a full developer suite\",\"body\":\"Develop on Benchling with REST APIs, SDKs, and shareable apps your team controls. Tap a directory of partner connectors and models, or use vibe coding to build your own applications.\",\"cta\":{\"label\":\"Learn more\",\"href\":\"/developer-platform\"},\"media\":{\"src\":\"https://images.ctfassets.net/kzeezny59h5p/6TVJdZz1Xx2shx7Cr6yryh/a775b0acff7cd0ae184c2a918a0ac0ac/03-Developer-Platform.png\",\"alt\":\"Developer platform screenshot\"}},{\"heading\":\"Ecosystem\",\"subheading\":\"Connect your team to the right AI and technology tools\",\"body\":\"Choose from a library of scientific models, connectors, automation tools, and partner apps, all built for Benchling's data model. Install them quickly and get back to doing science.\",\"cta\":{\"label\":\"Learn more\",\"href\":\"/ecosystem\"},\"media\":{\"src\":\"https://images.ctfassets.net/kzeezny59h5p/5QHl8fnz1qFh9NjNFa2Wxl/e5008904fa29e1ea441908ceca69fcc8/04-Ecosystem.jpg\",\"alt\":\"Ecosystem screenshot\"}},{\"heading\":\"Validated Cloud\",\"subheading\":\"Stay compliant from discovery through development\",\"body\":\"Validated Cloud offers a single, dedicated tenant from discovery through development without switching systems. Compliance controls for 21 CFR Part 11 and Annex 11 are built into the platform.\",\"cta\":{\"label\":\"Learn more\",\"href\":\"/validated-cloud\"},\"media\":{\"src\":\"https://images.ctfassets.net/kzeezny59h5p/5muGUzYaxtf5mgPKsRl3n6/e7f4e4f4fff29e6f5671ded3fe1fe804/05-Validated_Cloud.jpg\",\"alt\":\"Validated cloud screenshot\"}},{\"heading\":\"Security and compliance\",\"subheading\":\"Operate with enterprise-grade security and privacy\",\"body\":\"Benchling maintains SOC 2 Type II, ISO 27001, GDPR, and CCPA compliance, so your data stays protected under the same standards trusted by leading biopharma companies.\",\"cta\":{\"label\":\"Learn more\",\"href\":\"/trust\"},\"media\":{\"src\":\"https://images.ctfassets.net/kzeezny59h5p/7Hfq75zRMzfqJcNekt35Mq/98896afcd99d9fef5090c53c584fcca9/06-Security___compliance.jpg\",\"alt\":\"Security \u0026 compliance screenshot\"}}]}],[\"$\",\"$L2a\",null,{\"heading\":\"Built for the pace of modern R\u0026D\",\"stats\":[{\"link\":\"https://www.benchling.com/customer-stories/gilead-partnering-with-benchling-to-improve-large-molecule-bioprocess\",\"prepend\":\"\",\"stat\":\"63\",\"append\":\"%\",\"label\":\"reduction in time spent on data capture, search, and collection\",\"logo\":{\"name\":\"Gilead\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/4YUCKwJEJtzBiAFLCELb2N/c7231e7551c4fa33abd408512e0dc74e/Gilead.svg\"}},{\"link\":\"https://www.benchling.com/customer-stories/elevatebio-going-digital-to-accelerate-cell-and-gene-therapy-research-and\",\"prepend\":\"\",\"stat\":\"10\",\"append\":\"x\",\"label\":\"increase in throughput and higher success rates\",\"logo\":{\"name\":\"ElevateBio\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/1nK5xBmyRwesuWnqoO1C5W/47675ffcf3b0336e5eb3fa2f515cc2c8/ElevateBio-Logo_1.svg\"}},{\"link\":\"https://www.benchling.com/customer-stories/ac-immune-pioneering-precision-medicine-to-diagnose-treat-and-prevent\",\"prepend\":\"\",\"stat\":\"4\",\"append\":\"h\",\"label\":\"per week saved per scientist\",\"logo\":{\"name\":\"AC Immune\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/5UB6rCiKI1AogRfP3dQyRy/c4527e92e27a012a8d5d10e6019743bb/ac-immune-Gray_1.png\"}}]}],[\"$\",\"$L2b\",null,{\"heading\":\"How teams are shipping science, faster\",\"cta\":{\"label\":\"See all case studies\",\"href\":\"/customer-stories#:~:text=Explore%20our%20customer%20stories\"},\"cards\":[{\"link\":\"https://www.benchling.com/customer-stories/benchling-builds-digital-data-foundation-powering-sanofi-ai-driven-r-and-d\",\"logo\":{\"name\":\"sanofi\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/K3DoZKhyBe9myydVVOM7i/cb85ce580ec0ddca80a884243a16fca6/sanofi_logo_dark_grey.png\"},\"image\":{\"src\":\"https://images.ctfassets.net/kzeezny59h5p/10HPAVneQ9nyvjkz1VsELh/ccc6ca8e91e7c608671bfbbfcb58a6db/Sanofi-Customer-Story.png\",\"alt\":\"\"},\"heading\":\"Benchling builds digital data foundation powering Sanofi AI-driven R\u0026D\"},{\"link\":\"https://www.benchling.com/blog/prime-medicine-used-benchlings-ai-scientist\",\"logo\":{\"name\":\"prime medicine\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/6Qz8Jzzx9tEDmzJEeVGqg6/b2143e846ffea185df6c38a4a49e4c8a/Prime-Medicine-Logo_1.svg\"},\"image\":{\"src\":\"https://images.ctfassets.net/kzeezny59h5p/1iYnYyTLouiNeoIJi8GNJp/53d90f6d7083f8441ceddf9551f77c03/Frame_1000002901.png\"},\"heading\":\"How Prime Medicine scientists used Benchling AI to accelerate PM359’s path to BLA\"},{\"link\":\"https://www.benchling.com/customer-stories/novonesis-how-1-500-novonesis-employees-across-the-globe-accelerate-research\",\"logo\":{\"name\":\"novonesis\",\"src\":\"https://images.ctfassets.net/kzeezny59h5p/6A7mVl4BFdqiwlnZiphyuw/b16cc39dc1f0c7611448f6d520ebd9cc/Novonesis_logo_dark_grey.png\"},\"image\":{\"src\":\"https://images.ctfassets.net/kzeezny59h5p/22eDvt7otPOG2LNB1MabbA/2d5b8fbc313051780a676a27db7959e4/Novonesis-Customer-Story.png\",\"alt\":\"\"},\"heading\":\"How 1,500 Novonesis employees across the globe accelerate research with Benchling\"}]}],[\"$\",\"$L2c\",null,{\"heading\":\"Assemble your infinite program team\",\"primaryCta\":{\"label\":\"Start for free\",\"href\":\"/signup\"},\"secondaryCta\":{\"label\":\"Request a demo\",\"href\":\"/request-demo\"}}]]}]}]\n"])</script><script>self.__next_f.push([1,"1f:[[\"$\",\"meta\",\"0\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"1\",{\"charSet\":\"utf-8\"}],[\"$\",\"title\",\"2\",{\"children\":\"Infinite program team for R\u0026D | Benchling\"}],[\"$\",\"meta\",\"3\",{\"name\":\"description\",\"content\":\"Benchling is a cloud-based platform for biotechnology research and development and the only biology-first platform for scientific data, collaboration, and insights.\"}],[\"$\",\"meta\",\"4\",{\"name\":\"robots\",\"content\":\"index, follow, nocache\"}],[\"$\",\"meta\",\"5\",{\"name\":\"googlebot\",\"content\":\"index, follow\"}],[\"$\",\"link\",\"6\",{\"rel\":\"canonical\",\"href\":\"https://www.benchling.com\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:title\",\"content\":\"Infinite program team for R\u0026D | Benchling\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:description\",\"content\":\"Benchling is a cloud-based platform for biotechnology research and development and the only biology-first platform for scientific data, collaboration, and insights.\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:image\",\"content\":\"https://www.benchling.com/assets/images/benchling.com.png\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:creator\",\"content\":\"@benchling\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:title\",\"content\":\"Infinite program team for R\u0026D | Benchling\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:description\",\"content\":\"Benchling is a cloud-based platform for biotechnology research and development and the only biology-first platform for scientific data, collaboration, and insights.\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:image\",\"content\":\"https://www.benchling.com/assets/images/benchling.com.png\"}]]\n15:null\n"])</script></body></html>