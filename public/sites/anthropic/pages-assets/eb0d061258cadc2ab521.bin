c4f2ae2109c939-200x200-png\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"$40\"},\"name\":\"Drew Breunig\",\"slug\":\"drew-breunig\"}],\"category\":\"Agent Skills\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-11-04\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"most-agentic-work-will-become-workflows\"},\"startsAt\":null,\"summary\":\"Repeated agent interactions reveal useful workflows. Capturing those patterns as reusable skills and code helps improve consistency and preserve knowledge across tools.\",\"tag\":\"Agent Workflows\",\"thumbnail\":{\"_type\":\"image\",\"alt\":\"Illustration of Drew Breunig and a robot resting beside a worn, winding path, while smaller robots carry out tasks along a new, direct path.\",\"asset\":{\"_ref\":\"image-3ed3ab926d8d8a2abbea49936ac8e0ab8a52e620-1671x941-png\",\"_type\":\"reference\"}},\"title\":\"Most agentic work will become workflows\"},{\"_type\":\"blog\",\"authors\":[{\"headshot\":{\"alt\":null,\"asset\":{\"_ref\":\"image-61d746ab7969a62b3364123ff29e03d4d015a5a4-400x400-png\",\"_type\":\"reference\"},\"crop\":{\"_type\":\"sanity.imageCrop\",\"bottom\":0.1881871644080798,\"left\":0.1281854598141993,\"right\":0.05454700417625499,\"top\":0},\"hotspot\":{\"_type\":\"sanity.imageHotspot\",\"height\":0.8118128355919202,\"width\":0.8172675360095457,\"x\":0.5368192278189721,\"y\":0.4059064177959601},\"lqip\":\"$41\"},\"name\":\"J.R. Storment\",\"slug\":\"j-r-storment\"}],\"category\":\"Enterprise \u0026 Production\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-11-03\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"total-cost-of-ai-over-value-realized\"},\"startsAt\":null,\"summary\":\"J.R. Storment is Executive Director of the Tokenomics Foundation, a Linux Foundation project.\",\"tag\":\"Observability\",\"thumbnail\":{\"_type\":\"image\",\"alt\":\"A balance scale tips toward a small collection of AI infrastructure costs, outweighing a tall stack of tokens. J.R. Storment explains the surprising result to Alf.\",\"asset\":{\"_ref\":\"image-4beba43cbd33850d35aa52f312e58c4d17bc7467-1672x941-png\",\"_type\":\"reference\"}},\"title\":\"Total cost of AI over value realized\"},{\"_type\":\"blog\",\"authors\":[{\"headshot\":{\"alt\":null,\"asset\":{\"_ref\":\"image-b2a2e03cf5baa4ada47dccb4cfabb3e29c5dc1b9-2000x2000-png\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/png;base64,\"},\"name\":\"Agentic AI Foundation\",\"slug\":\"agentic-ai-foundation\"}],\"category\":\"Foundation Events\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":\"AAIF\",\"publishedAt\":\"2026-11-02\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"four-cool-things-from-agntcon-mcpcon\"},\"startsAt\":null,\"summary\":\"Four cool things from AGNTCon + MCPCon North America in San Jose: topographic MCP slides, Kids’ Day, a coding interface on a Playdate, and a phone booth full of questions.\",\"tag\":null,\"thumbnail\":{\"_type\":\"image\",\"alt\":\"Pastel comic-style illustration of conference attendees, children playing with a dancing robot and video game, two people in a self-driving car, a contour map display and a white telephone booth.\",\"asset\":{\"_ref\":\"image-7ccbb3bedc67df2e88e943876107e91c49100d0c-1672x941-png\",\"_type\":\"reference\"}},\"title\":\"Four cool things from AGNTCon + MCPCon\"},{\"_type\":\"blog\",\"authors\":[{\"headshot\":{\"alt\":null,\"asset\":{\"_ref\":\"image-152d0d3ff423eb8649ef858fa2571187b0b40dee-224x224-png\",\"_type\":\"reference\"},\"crop\":{\"_type\":\"sanity.imageCrop\",\"bottom\":0,\"left\":0.12273075939657378,\"right\":0.09545725730844626,\"top\":0.22091536691383287},\"hotspot\":{\"_type\":\"sanity.imageHotspot\",\"height\":0.7790846330861672,\"width\":0.78181198329498,\"x\":0.5136367510440638,\"y\":0.6104576834569164},\"lqip\":\"$42\"},\"name\":\"Jakub Kopecky\",\"slug\":\"jakub-kopecky\"},{\"headshot\":{\"alt\":null,\"asset\":{\"_ref\":\"image-dafff6c7a5b62ffe3e08c1fc8372bdc999b93f5d-800x800-png\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"$43\"},\"name\":\"Jiri Spilka\",\"slug\":\"jiri-spilka\"}],\"category\":null,\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-10-30\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"we-added-toon-to-our-mcp-server-then-removed-it\"},\"startsAt\":null,\"summary\":\"After a 30-day trial of TOON, Apify switched its MCP server’s text output back to JSON, sharing lessons about token costs, traffic patterns, and testing real workloads.\",\"tag\":null,\"thumbnail\":{\"_type\":\"image\",\"alt\":\"A cartoon robot leans out of a silver sports car speeding past a TOON road sign, while two engineers stand beside a “Back to the JSON” billboard.\",\"asset\":{\"_ref\":\"image-7b97275856c3aaf7a41737eba5be1b5790e6d48f-1735x906-png\",\"_type\":\"reference\"}},\"title\":\"We added TOON to our MCP server, then removed it\"},{\"_type\":\"blog\",\"authors\":[{\"headshot\":{\"alt\":null,\"asset\":{\"_ref\":\"image-0eaab7511bc0a5c799a078f45e2995a7247aea7a-96x96-jpg\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/jpeg;base64,\"},\"name\":\"Steve Kearns\",\"slug\":\"steve-kearns\"}],\"category\":\"Voice Agents\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-10-29\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"where-voice-agents-fail-in-production-part-2-tools-recovery-and-observability\"},\"startsAt\":null,\"summary\":\"Tool failures, uncertain retries, and handoffs in production voice agents, with a focus on recovery, evaluation, and observability.\",\"tag\":\"Voice AI\",\"thumbnail\":{\"_type\":\"image\",\"alt\":\"A man uses a magnifying glass to inspect a disconnected cable inside a smiling robot’s open chest panel, revealing a warning light and internal components.\",\"asset\":{\"_ref\":\"image-df32f52ab90efb2b62a931d1cb1fd6025a8d24c9-1672x941-png\",\"_type\":\"reference\"}},\"title\":\"Where voice agents fail in production: Part 2 - tools, recovery, and observability\"},{\"_type\":\"blog\",\"authors\":[{\"headshot\":{\"alt\":null,\"asset\":{\"_ref\":\"image-1dd5386f8261d6692079a175d28ee931b9bff793-400x400-jpg\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/jpeg;base64,\"},\"name\":\"Austin Anderson\",\"slug\":\"austin-anderson\"}],\"category\":\"MCP\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-10-28\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"agents-are-applying-for-jobs-building-an-open-protocol-for-hiring\"},\"startsAt\":null,\"summary\":\"OJCP proposes a structured way for AI agents to discover jobs, apply, verify identity and consent, and track application status using MCP and WebMCP.\",\"tag\":\"MCP\",\"thumbnail\":{\"_type\":\"image\",\"alt\":\"Illustration of Austin Anderson interviewing a robot job applicant, with a second robot taking notes and OJCP application steps displayed in the background.\",\"asset\":{\"_ref\":\"image-9cacc36e0edfd82f307715672bdb43facbfea084-1672x941-png\",\"_type\":\"reference\"}},\"title\":\"Agents are applying for jobs: building an open protocol for hiring\"},{\"_type\":\"blog\",\"authors\":[{\"headshot\":{\"alt\":null,\"asset\":{\"_ref\":\"image-df577e904b12e51620f5c1e48bf0c86dc7a01f4e-400x400-png\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"$44\"},\"name\":\"Mayank Debnath\",\"slug\":\"mayank-debnath\"}],\"category\":\"Cloud \u0026 Infrastructure\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-10-27\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"isolating-agent-generated-code-with-mcp-and-microsandbox\"},\"startsAt\":null,\"summary\":\"How MCP and Microsandbox work together to isolate agent-generated code, with a practical example covering microVM execution, tool interfaces, resource limits, and network access.\",\"tag\":\"MCP\",\"thumbnail\":{\"_type\":\"image\",\"alt\":\"Cartoon illustration of Mayank Debnath and a friendly AI robot securing code inside a transparent sandbox, with servers and conveyor belts in the background.\",\"asset\":{\"_ref\":\"image-21cf3b6a2b9db41822c9e420583e035a1a394df6-1672x941-png\",\"_type\":\"reference\"}},\"title\":\"Isolating agent-generated code with MCP and Microsandbox\"},{\"_type\":\"blog\",\"authors\":[{\"headshot\":{\"alt\":null,\"asset\":{\"_ref\":\"image-0eaab7511bc0a5c799a078f45e2995a7247aea7a-96x96-jpg\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/jpeg;base64,\"},\"name\":\"Steve Kearns\",\"slug\":\"steve-kearns\"}],\"category\":\"Voice Agents\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-10-27\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"where-voice-agents-fail-in-production-part-1-latency-turns-and-interruptions\"},\"startsAt\":null,\"summary\":\"Why do voice agents fail even when the transcript looks correct? Explore the challenges of latency, turn detection, interruptions, and conversation state in production.\",\"tag\":\"Voice AI\",\"thumbnail\":{\"_type\":\"image\",\"alt\":\"Cartoon illustration of a man and a voice AI robot talking, with overlapping orange and purple audio waveforms showing an interruption mid-conversation.\",\"asset\":{\"_ref\":\"image-5bc785ca54ef060b4dee7d6d20e6b90600caf044-1672x941-png\",\"_type\":\"reference\"}},\"title\":\"Where voice agents fail in production: Part 1 - latency, turns, and interruptions\"},{\"_type\":\"blog\",\"authors\":[{\"headshot\":{\"alt\":\"Max Körbächer\",\"asset\":{\"_ref\":\"image-c0ea485a025271994d39ba6431e753f490d180dd-1000x1658-jpg\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/jpeg;base64,\"},\"name\":\"Max Körbächer\",\"slug\":\"max-korbacher\"}],\"category\":\"Agents in Production\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":\"Ambassador\",\"publishedAt\":\"2026-10-26\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"the-infrastructure-factory-a-foundation-for-agentic-ai\"},\"startsAt\":null,\"summary\":\"Agentic AI needs an infrastructure factory alongside software and AI factories, with capacity, policy, and costs managed through repeatable services.\",\"tag\":\"MCP\",\"thumbnail\":{\"_type\":\"image\",\"alt\":\"Illustration of Max Körbächer and a robot agent working on an automated factory production line, with server modules, conveyor belts, and robotic machinery.\",\"asset\":{\"_ref\":\"image-5f8d4940fbb87f007919476d332622a2392a3ff0-1672x941-png\",\"_type\":\"reference\"}},\"title\":\"The infrastructure factory: a foundation for agentic AI\"},{\"_type\":\"blog\",\"authors\":[{\"headshot\":{\"alt\":\"yaron's headshot\",\"asset\":{\"_ref\":\"image-a6d412520c62dc886b2a46c68e91c5f8eb589750-200x200-jpg\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/jpeg;base64,\"},\"name\":\"Yaron Schneider\",\"slug\":\"yaron-schneider\"}],\"category\":\"Goose\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":\"Member\",\"publishedAt\":\"2026-10-23\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"introducing-dapr-durable-execution-for-goose\"},\"startsAt\":null,\"summary\":\"goose can execute complex tasks. Now, with Dapr Durable Execution, it can survive crashes and resume its work without starting over.\",\"tag\":null,\"thumbnail\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-c797d1d313b7b4e902965c23316e839ed044a3cb-1672x941-png\",\"_type\":\"reference\"}},\"title\":\"Introducing Dapr Durable Execution for goose: AI agents that pick up where they left off\"}],\"cta\":{\"_type\":\"cta\",\"external\":\"https://aaif.io/news\",\"internal\":{\"_type\":\"page\",\"slug\":\"news\"},\"label\":\"Explore More\",\"target\":\"_self\",\"type\":\"internal\",\"variant\":\"default\"},\"image\":null,\"label\":\"Press \u0026 News\",\"pressNewsItems\":[{\"_type\":\"pressNews\",\"authors\":[],\"category\":\"Press Release\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-10-22\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"agentic-ai-foundation-announces-four-new-projects\"},\"startsAt\":null,\"summary\":\"AAIF reaches 10 projects in its first year, with new contributions from Alibaba, Anthropic, Hugging Face, and OpenAI\",\"tag\":null,\"thumbnail\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-184f16ebdce9c0079c2834f4cd8e91b5bb02a242-1600x900-png\",\"_type\":\"reference\"}},\"title\":\"Agentic AI Foundation Announces Four New Projects: Agent Skills, Open Responses, OpenEnv, and OpenSandbox\"},{\"_type\":\"pressNews\",\"authors\":[],\"category\":\"Press Release\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-10-22\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"agentic-ai-foundation-surpasses-300-members\"},\"startsAt\":null,\"summary\":\"Ant Group, Gates Foundation, MongoDB, Nutanix, Royal Bank of Canada, Vercel, and Vultr join as Gold Members, reflecting growing demand for open, trusted standards for agentic AI.\",\"tag\":null,\"thumbnail\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-6f20505f593d62581e1ab63b9251f48dc33663c7-1200x627-png\",\"_type\":\"reference\"}},\"title\":\"Agentic AI Foundation Surpasses 300 Members in Less Than One Year\"},{\"_type\":\"pressNews\",\"authors\":[],\"category\":\"Members\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-09-15\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"agentic-ai-foundation-welcomes-the-gates-foundation\"},\"startsAt\":null,\"summary\":\"Collaboration will bring the needs of underserved communities into the open ecosystem shaping agentic AI\",\"tag\":null,\"thumbnail\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-62394ca2c0689fc4dc190b3d252dfddbd1df0683-1200x627-svg\",\"_type\":\"reference\"}},\"title\":\"Agentic AI Foundation Welcomes the Gates Foundation to Help Expand the Benefits of Agentic AI Globally\"},{\"_type\":\"pressNews\",\"authors\":[],\"category\":\"MCP\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-09-13\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"agentic-ai-foundation-launches-mcpa-certification\"},\"startsAt\":null,\"summary\":\"The first official certification for MCP validates builders’ understanding of MCP architecture, security, and implementation as adoption of the protocol grows.\",\"tag\":null,\"thumbnail\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-b764578aaab451dd780af63cab757a0cf0d175f5-1200x627-png\",\"_type\":\"reference\"}},\"title\":\"Agentic AI Foundation Launches MCPA Certification to Validate MCP Expertise\"},{\"_type\":\"pressNews\",\"authors\":[],\"category\":\"Foundation Events\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-08-24\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"agntcon-mcpcon-japan-to-convene-builders-advancing-production-ready-agentic-ai\"},\"startsAt\":null,\"summary\":\"Industry leaders and open source innovators from SoftBank, Hitachi, NTT, Google, Microsoft, Anthropic, and more will gather in Tokyo to explore the standards, infrastructure, security and governance needed to operate AI agents in production.\",\"tag\":null,\"thumbnail\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-8037f9e9a13348acf214dbcbad4faf65139bdeaf-1200x628-png\",\"_type\":\"reference\"}},\"title\":\"AGNTCon + MCPCon Japan to Convene Builders Advancing Production-Ready Agentic AI\"},{\"_type\":\"pressNews\",\"authors\":[],\"category\":\"Agent2Agent (A2A)\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-08-17\",\"redirectLink\":\"https://www.axios.com/2026/08/17/a2a-agentic-ai-foundation-open-ai-standards\",\"slug\":{\"_type\":\"slug\",\"current\":\"google-backed-agentic-a2a-protocol-gets-a-new-home\"},\"startsAt\":null,\"summary\":\"The Agent2Agent Protocol (A2A), a Google-created standard for AI agents to talk to one another, is moving to the Agentic AI Foundation, backers of the emerging standard told Axios.\",\"tag\":null,\"thumbnail\":null,\"title\":\"Google-backed agentic A2A protocol gets a new home\"},{\"_type\":\"pressNews\",\"authors\":[],\"category\":\"Members\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-08-12\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"agentic-ai-foundation-welcomes-57-new-members\"},\"startsAt\":null,\"summary\":\"Alibaba, Visa, and Wells Fargo join as Gold Members as demand for open agentic AI infrastructure accelerates globally\",\"tag\":null,\"thumbnail\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-dfa057f7819b8b73b75dd6884b1b72625670e24a-1200x627-png\",\"_type\":\"reference\"}},\"title\":\"Agentic AI Foundation Welcomes 57 New Members, Gaining Major Financial Services Players and APAC Leaders\"},{\"_type\":\"pressNews\",\"authors\":[],\"category\":\"MCP\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-07-28\",\"redirectLink\":\"https://venturebeat.com/orchestration/mcp-just-got-its-biggest-update-ever-heres-what-changes-for-ai-agents\",\"slug\":{\"_type\":\"slug\",\"current\":\"mcp-just-got-its-biggest-update-ever-here-s-what-changes-for-ai-agents\"},\"startsAt\":null,\"summary\":\"The Model Context Protocol, the open standard that has quietly become the connective tissue between AI agents and the world's software, is getting its largest update since Anthropic released it twenty months ago — a sweeping architectural revision that its maintainers and backers say finally makes agentic AI ready for massive enterprise production deployments.\",\"tag\":null,\"thumbnail\":null,\"title\":\"MCP just got its biggest update ever — here’s what changes for AI agents\"},{\"_type\":\"pressNews\",\"authors\":[],\"category\":null,\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-05-18\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"agentic-ai-foundation-adds-43-new-members\"},\"startsAt\":null,\"summary\":\"Financial services, infrastructure, security, and public sector organizations join AAIF’s growing community to help shape the standards behind production-grade agentic AI\",\"tag\":null,\"thumbnail\":{\"_type\":\"image\",\"alt\":\"Agentic AI Foundation Adds 43 New Members as Enterprise and Government Adoption of Open Agent Standards Accelerates\",\"asset\":{\"_ref\":\"image-24dae2820853ee1d953356b12239b8fcd6364c8f-1200x627-png\",\"_type\":\"reference\"}},\"title\":\"Agentic AI Foundation Adds 43 New Members as Enterprise and Government Adoption of Open Agent Standards Accelerates\"},{\"_type\":\"pressNews\",\"authors\":[],\"category\":null,\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-04-02\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"agentic-ai-foundation-announces-global-2026-events-program\"},\"startsAt\":null,\"summary\":\"Agentic AI Foundation Expanded global schedule brings agentic AI ecosystem together across ten cities, with flagship AGNTCon + MCPCon events and regional MCP Dev Summits driving standards adoption SAN FRANCISCO...\",\"tag\":null,\"thumbnail\":{\"_type\":\"image\",\"alt\":\"Agentic AI Foundation Announces Global 2026 Events Program Anchored by AGNTCon + MCPCon North America and Europe\",\"asset\":{\"_ref\":\"image-7eb4721f11596ac971e625155421953f8b528976-775x404-png\",\"_type\":\"reference\"}},\"title\":\"Agentic AI Foundation Announces Global 2026 Events Program Anchored by AGNTCon + MCPCon North America and Europe\"},{\"_type\":\"pressNews\",\"authors\":[],\"category\":null,\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-02-24\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"aaif-welcomes-97-new-members\"},\"startsAt\":null,\"summary\":\"Agentic AI Foundation Agentic AI Foundation Welcomes 97 New Members As Demand for Open, Collaborative Agent Standardization Increases Industry leading organizations unite under neutral Foundation led by new governing board...\",\"tag\":null,\"thumbnail\":{\"_type\":\"image\",\"alt\":\"Agentic AI Foundation Welcomes 97 New Members As Demand for Open, Collaborative Agent Standardization Increases\",\"asset\":{\"_ref\":\"image-986687c0910b39d02538dc728c7aaf066dc0ae3f-1200x627-png\",\"_type\":\"reference\"}},\"title\":\"Agentic AI Foundation Welcomes 97 New Members As Demand for Open, Collaborative Agent Standardization Increases\"},{\"_type\":\"pressNews\",\"authors\":[],\"category\":null,\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-02-23\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"mcp-dev-summit-north-america-2026-schedule\"},\"startsAt\":null,\"summary\":\"Agentic AI Foundation New York City event will explore how open standards and shared infrastructure enable secure, scalable AI agents in production Summary The Agentic AI Foundation today announced the...\",\"tag\":null,\"thumbnail\":{\"_type\":\"image\",\"alt\":\"Agentic AI Foundation Unveils MCP Dev Summit North America 2026 Schedule\",\"asset\":{\"_ref\":\"image-42c8b8286e91e97591eca1503797ae28ef9590a6-1200x627-png\",\"_type\":\"reference\"}},\"title\":\"Agentic AI Foundation Unveils MCP Dev Summit North America 2026 Schedule\"}],\"primaryCTA\":null,\"secondaryCTA\":null,\"source\":\"latest\",\"type\":\"pressNews\"}],\"visibleTo\":null},{\"_key\":\"f8bdaac60eae\",\"_type\":\"tabsCTA\",\"backgroundMedia\":null,\"cta\":null,\"description\":[{\"_key\":\"17e27ac723ec\",\"_type\":\"block\",\"children\":[{\"_key\":\"f39c26b7a376\",\"_type\":\"span\",\"marks\":[],\"text\":\"Get your organization listed on the AAIF Landscape to stand in front of enterprise buyers and investors. Submit an application today.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"dialogBackgroundMedia\":null,\"eyebrow\":\"Startups\",\"heading\":{\"_type\":\"heading\",\"fontSize\":\"3XL\",\"text\":\"Get listed on the AAIF landscape\",\"type\":\"h2\"},\"hidden\":true,\"media\":{\"_type\":\"media\",\"image\":{\"alt\":\"Startup's section bg image\",\"desktop\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-a222ab8e546d182ebc9f4d012ee32c4deb3e0231-4320x2994-webp\",\"_type\":\"reference\"},\"hasAlpha\":false,\"lqip\":\"data:image/jpeg;base64,\"},\"mobile\":null},\"type\":\"image\"},\"primaryCTA\":null,\"secondaryCTA\":null,\"tabs\":[{\"_key\":\"04cd7dd114ef\",\"blogItems\":null,\"cta\":null,\"description\":[{\"_key\":\"9723593792e5\",\"_type\":\"block\",\"children\":[{\"_key\":\"2484a8bff26c\",\"_type\":\"span\",\"marks\":[],\"text\":\"Visibility with enterprise buyers and investors. Credibility from being part of the standards conversation. Access to working groups.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"eyebrow\":\"The value\",\"image\":null,\"label\":\"Why List\",\"media\":{\"_type\":\"media\",\"image\":{\"_type\":\"object\",\"alt\":\"Why List\",\"desktop\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-713922efc376e667f0dfee3afaa4392771f1433b-1776x1176-webp\",\"_type\":\"reference\"}}},\"type\":\"image\"},\"pressNewsItems\":null,\"primaryCTA\":{\"_type\":\"cta\",\"external\":\"https://aaif.io/contact\",\"internal\":null,\"label\":\"Submit an application\",\"target\":\"_self\",\"type\":\"external\",\"variant\":\"default\"},\"secondaryCTA\":{\"_type\":\"cta\",\"external\":\"https://aaif.io/contact\",\"internal\":null,\"label\":\"Learn more\",\"target\":\"_self\",\"type\":\"external\",\"variant\":\"text\"},\"title\":{\"_type\":\"heading\",\"hidden\":false,\"hideOnDesktop\":false,\"hideOnMobile\":false,\"text\":\"Why get listed on AAIF\",\"type\":\"h2\"}},{\"_key\":\"3fd355e32d3f\",\"blogItems\":null,\"cta\":null,\"description\":[{\"_key\":\"1c27c8012ef9\",\"_type\":\"block\",\"children\":[{\"_key\":\"3963f35edc32\",\"_type\":\"span\",\"marks\":[],\"text\":\"Contribute to open decision-making, shape protocol direction, and ensure standards remain transparent, accountable, and built for everyone—not controlled by a few.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"eyebrow\":\"Benefits\",\"image\":null,\"label\":\"What you get\",\"media\":{\"_type\":\"media\",\"image\":{\"_type\":\"object\",\"alt\":\"What you get\",\"desktop\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-5ea98ee6d0ece00a5b5daae445d5acce027cb32b-1776x1176-webp\",\"_type\":\"reference\"}}},\"type\":\"image\"},\"pressNewsItems\":null,\"primaryCTA\":{\"_type\":\"cta\",\"external\":\"https://aaif.io/contact\",\"internal\":null,\"label\":\"Submit an application\",\"target\":\"_self\",\"type\":\"external\",\"variant\":\"default\"},\"secondaryCTA\":{\"_type\":\"cta\",\"external\":\"https://aaif.io/contact\",\"internal\":null,\"label\":\"Learn more\",\"target\":\"_self\",\"type\":\"external\",\"variant\":\"text\"},\"title\":{\"_type\":\"heading\",\"hidden\":false,\"hideOnDesktop\":false,\"hideOnMobile\":false,\"text\":\"Top benefits of listing with AAIF\",\"type\":\"h2\"}},{\"_key\":\"5baa29b7a298\",\"blogItems\":null,\"cta\":null,\"description\":[{\"_key\":\"b8ca843ee929\",\"_type\":\"block\",\"children\":[{\"_key\":\"956a60220fa6\",\"_type\":\"span\",\"marks\":[],\"text\":\"Access open tools and shared standards to monitor, trace, and optimize system performance—so you can build with clarity, not guesswork.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"eyebrow\":\"Step-by-steps\",\"image\":null,\"label\":\"How to apply\",\"media\":{\"_type\":\"media\",\"image\":{\"_type\":\"object\",\"alt\":\"How to apply\",\"desktop\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-259bcc2ea2473cfe2794e31e329f7dfb3957212a-1776x1176-webp\",\"_type\":\"reference\"}}},\"type\":\"image\"},\"pressNewsItems\":null,\"primaryCTA\":{\"_type\":\"cta\",\"external\":\"https://aaif.io/contact\",\"internal\":null,\"label\":\"Submit an application\",\"target\":\"_self\",\"type\":\"external\",\"variant\":\"default\"},\"secondaryCTA\":{\"_type\":\"cta\",\"external\":\"https://aaif.io/contact\",\"internal\":null,\"label\":\"Learn more\",\"target\":\"_self\",\"type\":\"external\",\"variant\":\"text\"},\"title\":{\"_type\":\"heading\",\"hidden\":false,\"hideOnDesktop\":false,\"hideOnMobile\":false,\"text\":\"Let's walk you through the process\",\"type\":\"h2\"}}],\"visibleTo\":null},{\"_key\":\"25ed2903718e\",\"_type\":\"workingGroupsSection\",\"backgroundMedia\":null,\"cta\":{\"_type\":\"cta\",\"internal\":{\"_type\":\"page\",\"slug\":\"working-groups\"},\"label\":\"Learn More About Working Groups\",\"target\":\"_self\",\"type\":\"internal\",\"variant\":\"default\"},\"description\":[{\"_key\":\"f670420ad9e5\",\"_type\":\"block\",\"children\":[{\"_key\":\"0076ad4c7b93\",\"_type\":\"span\",\"marks\":[],\"text\":\"AAIF Working Groups bring members together to collaborate on focused initiatives, share expertise, and drive practical outcomes across the AI ecosystem.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"dialogBackgroundMedia\":null,\"eyebrow\":\"Where decisions happen\",\"heading\":{\"_type\":\"heading\",\"fontSize\":\"3XL\",\"hidden\":false,\"hideOnDesktop\":false,\"hideOnMobile\":false,\"text\":\"Working groups that matter\",\"type\":\"h2\"},\"hidden\":false,\"hideOnDesktop\":false,\"hideOnMobile\":false,\"items\":[{\"_id\":\"seed.workingGroup.accuracy-and-reliability\",\"_type\":\"workingGroups\",\"cta\":{\"_type\":\"cta\",\"internal\":null,\"type\":\"internal\"},\"summary\":\"Bringing operational rigor to agents — defining what reliability, accuracy, and consistency mean for autonomous systems, including failure management, SLA definition, and recovery protocols.\",\"thumbnail\":{\"alt\":\"Accuracy \u0026 Reliability image\",\"asset\":{\"_ref\":\"image-3214352df5dc471f303b8c35975dc7cdb8e92829-1246x786-webp\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"$45\"},\"title\":\"Accuracy \u0026 Reliability\"},{\"_id\":\"seed.workingGroup.agentic-commerce\",\"_type\":\"workingGroups\",\"cta\":{\"_type\":\"cta\",\"internal\":null,\"type\":\"internal\"},\"summary\":\"Enabling agents to participate in commerce — covering discovery, negotiation, payment authorization, and the protocols needed for trustworthy autonomous transactions.\",\"thumbnail\":{\"alt\":\"Agentic Commerce image\",\"asset\":{\"_ref\":\"image-e8b19fbd4e3396c9fcb67bea6b2a4984a94de318-1245x786-webp\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/jpeg;base64,\"},\"title\":\"Agentic Commerce\"},{\"_id\":\"seed.workingGroup.governance-risk-and-regulatory-alignment\",\"_type\":\"workingGroups\",\"cta\":{\"_type\":\"cta\",\"internal\":null,\"type\":\"internal\"},\"summary\":\"Creating shared frameworks to align agentic innovation with legal, ethical, and regulatory expectations, including risk classification and regulatory mapping (e.g. the EU AI Act).\",\"thumbnail\":{\"alt\":\"Governance, Risk \u0026 Regulatory Alignment image\",\"asset\":{\"_ref\":\"image-d119ea9cd8943d3bc73e17625e24af52996bec24-1245x786-webp\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/jpeg;base64,\"},\"title\":\"Governance, Risk \u0026 Regulatory Alignment\"},{\"_id\":\"seed.workingGroup.identity-and-trust\",\"_type\":\"workingGroups\",\"cta\":{\"_type\":\"cta\",\"internal\":null,\"type\":\"internal\"},\"summary\":\"Defining portable identity and dynamic trust for autonomous agents — delegation protocols, cross-domain identity, and how permissions flow across agent-to-agent interactions.\",\"thumbnail\":{\"alt\":\"Identity \u0026 Trust image\",\"asset\":{\"_ref\":\"image-1da6ac7196be51dc3f825e209923ba438a8d4131-1245x786-webp\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/jpeg;base64,\"},\"title\":\"Identity \u0026 Trust\"},{\"_id\":\"seed.workingGroup.observability-and-traceability\",\"_type\":\"workingGroups\",\"cta\":{\"_type\":\"cta\",\"internal\":null,\"type\":\"internal\"},\"summary\":\"Making agent behavior observable, explainable, and traceable across platforms — covering execution tracing, cross-system correlation, audit \u0026 forensics, and standardized metrics.\",\"thumbnail\":{\"alt\":\"Observability \u0026 Traceability image\",\"asset\":{\"_ref\":\"image-83cac259a79073a8378df7c84a79dfcd1814deda-1245x786-webp\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/jpeg;base64,\"},\"title\":\"Observability \u0026 Traceability\"},{\"_id\":\"seed.workingGroup.security-and-privacy\",\"_type\":\"workingGroups\",\"cta\":{\"_type\":\"cta\",\"internal\":null,\"type\":\"internal\"},\"summary\":\"Establishing the industry benchmark for secure agentic operations, with a focus on security-by-design, standardized best practices, and adversarial testing methodologies.\",\"thumbnail\":{\"alt\":\"Security \u0026 Privacy image\",\"asset\":{\"_ref\":\"image-c7c306156eb84a45859c9300cb34bc96c5c86769-1245x786-webp\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/jpeg;base64,\"},\"title\":\"Security \u0026 Privacy\"},{\"_id\":\"seed.workingGroup.workflows-and-process-integration\",\"_type\":\"workingGroups\",\"cta\":{\"_type\":\"cta\",\"internal\":null,\"type\":\"internal\"},\"summary\":\"Guiding the transition from agents completing isolated tasks to fulfilling roles in complex, multi-step business processes — covering handoff protocols, role definitions, and state guarantees.\",\"thumbnail\":{\"alt\":\"Workflows \u0026 Process Integration image\",\"asset\":{\"_ref\":\"image-e11234cfc36ba4cd4a3a861617e1deb68894163a-1245x786-webp\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/jpeg;base64,\"},\"title\":\"Workflows \u0026 Process Integration\"},{\"_id\":\"seed.workingGroup.taxonomy-and-landscape\",\"_type\":\"workingGroups\",\"cta\":{\"_type\":\"cta\",\"internal\":null,\"type\":\"internal\"},\"summary\":\"This cross-working group workstream curates and maintains a glossary of agentic AI terms (the Taxonomy) and an ecosystem map (the Landscape) for the AAIF, so every Working Group can work from the same definitions and one view of the ecosystem.\",\"thumbnail\":{\"alt\":\"Taxonomy \u0026 Landscape Image\",\"asset\":{\"_ref\":\"image-b985e32bf636052230c769372b358ab91a496f58-4640x6960-jpg\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/jpeg;base64,\"},\"title\":\"Taxonomy \u0026 Landscape\"}],\"media\":{\"_type\":\"media\",\"image\":{\"alt\":\"working group section bg\",\"desktop\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-1761398b9fc3b6fb5fa43f3b7098a9bdeadd58e6-4320x2460-webp\",\"_type\":\"reference\"},\"hasAlpha\":true,\"lqip\":\"data:image/png;base64,\"},\"mobile\":null},\"type\":\"image\",\"video\":{\"videoConfig\":{\"autoplay\":true,\"showControls\":true},\"videoType\":\"file\"}},\"primaryCTA\":null,\"secondaryCTA\":null,\"tabs\":null,\"visibleTo\":null},{\"_key\":\"4598b7e74cd6\",\"_type\":\"merchStoreSection\",\"backgroundMedia\":null,\"collections\":[{\"_id\":\"0c2113cd-24e9-44b3-854d-e541e9dff738\",\"image\":{\"alt\":\"Agents \u0026 Standards Unisex Sweatshirt\",\"asset\":{\"_ref\":\"image-9b19de3cb1433ddf6e46cea8a37e37521ce24507-2000x2000-webp\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/jpeg;base64,\"},\"link\":\"https://merch.aaif.io/products/unisex-sweatshirt-1\",\"linkLabel\":\"Shop Collection\",\"title\":\"Agents \u0026 Standards Unisex Sweatshirt\"},{\"_id\":\"a48ec889-9c03-468d-be04-b9dea1296a6b\",\"image\":{\"alt\":\"Cookin Unisex Full Zip Hoodie\",\"asset\":{\"_ref\":\"image-644c89dfdb14fdede3f6d83fb3c2f31f3c3980e7-2000x2000-jpg\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/jpeg;base64,\"},\"link\":\"https://merch.aaif.io/products/unisex-full-zip-hoodie\",\"linkLabel\":\"Shop Collection\",\"title\":\"Cookin Unisex Full Zip Hoodie\"},{\"_id\":\"3278b709-81ab-42e3-98ba-46387dc88f10\",\"image\":{\"alt\":\"Ask me about my agents Enamel Mug\",\"asset\":{\"_ref\":\"image-32d84918c727f02959fbf46ca110ace01861e5a8-2000x2000-webp\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/jpeg;base64,\"},\"link\":\"https://merch.aaif.io/products/enamel-mug\",\"linkLabel\":\"Shop Collection\",\"title\":\"Ask me about my agents Enamel Mug\"}],\"cta\":{\"_type\":\"cta\",\"external\":\"https://merch.aaif.io/\",\"internal\":null,\"label\":\"Shop the store\",\"target\":\"_self\",\"type\":\"external\",\"variant\":\"default\"},\"description\":[{\"_key\":\"7e3d75d39b04\",\"_type\":\"block\",\"children\":[{\"_key\":\"1e6b9cc2fa64\",\"_type\":\"span\",\"marks\":[],\"text\":\"The Agentic AI Foundation supports the people and projects building agents in the open.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"dialogBackgroundMedia\":null,\"eyebrow\":\"Merch Store\",\"heading\":{\"_type\":\"heading\",\"fontSize\":\"3XL\",\"hidden\":false,\"hideOnDesktop\":false,\"hideOnMobile\":false,\"text\":\"Agentic AI Foundation Store\",\"type\":\"h2\"},\"hidden\":false,\"hideOnDesktop\":false,\"hideOnMobile\":false,\"limit\":3,\"media\":null,\"primaryCTA\":null,\"secondaryCTA\":null,\"source\":\"ordered\",\"tabs\":null,\"visibleTo\":null},{\"_key\":\"e2561af2183e\",\"_type\":\"testimonial\",\"backgroundMedia\":null,\"cta\":null,\"description\":[{\"_key\":\"2c8b2b64404d\",\"_type\":\"block\",\"children\":[{\"_key\":\"618961594440\",\"_type\":\"span\",\"marks\":[],\"text\":\"Discover amazing stories about AAIF influence in the community and overall on the future\"}],\"markDefs\":[],\"style\":\"normal\"}],\"dialogBackgroundMedia\":null,\"eyebrow\":\"Testimonials\",\"heading\":{\"_type\":\"heading\",\"fontSize\":\"3XL\",\"text\":\"What people in the community say\",\"type\":\"h2\"},\"hidden\":true,\"media\":null,\"primaryCTA\":null,\"secondaryCTA\":null,\"tabs\":null,\"testimonials\":[{\"_key\":\"3855321f79e5\",\"author\":\"Jordan Park\",\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-5d2b163079bb223ff95442ad6548aedd985d16b2-144x144-webp\",\"_type\":\"reference\"},\"lqip\":\"$46\"},\"quote\":[{\"_key\":\"4183065674ae\",\"_type\":\"block\",\"children\":[{\"_key\":\"9384fd771624\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\\"AAIF is the only organization that brings together the brightest minds in agentic AI to build a better future for all. I\\\\'m proud to be a member.\\\"\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"_key\":\"e227dd434bbb\",\"author\":\"Alex Rivera\",\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-a6d412520c62dc886b2a46c68e91c5f8eb589750-200x200-jpg\",\"_type\":\"reference\"},\"lqip\":\"data:image/jpeg;base64,\"},\"quote\":[{\"_key\":\"5b0fc8091884\",\"_type\":\"block\",\"children\":[{\"_key\":\"fd5f448e25ef\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\\"Open standards have always been the oxygen of the internet. AAIF is doing the same for agentic AI — and doing it in the open.\\\"\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"_key\":\"dd52df35ba6f\",\"author\":\"Morgan Lee\",\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-5d2b163079bb223ff95442ad6548aedd985d16b2-144x144-webp\",\"_type\":\"reference\"},\"lqip\":\"$47\"},\"quote\":[{\"_key\":\"20795b3418e0\",\"_type\":\"block\",\"children\":[{\"_key\":\"3ed5a983c6dd\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\\"Being part of the working groups here is the most signal-dense conversation I have all week. No fluff, just builders shipping.\\\"\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"_key\":\"79bdf79a779e\",\"author\":\"Priya Desai\",\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-a7d693076ef333216820b683635ac0d15c3328ad-228x221-jpg\",\"_type\":\"reference\"},\"lqip\":\"data:image/jpeg;base64,\"},\"quote\":[{\"_key\":\"fe93b214bac4\",\"_type\":\"block\",\"children\":[{\"_key\":\"3f8277a7148a\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\\"You can feel the governance and the engineering in the same room — that\\\\'s rare and that\\\\'s what makes AAIF work.\\\"\"}],\"markDefs\":[],\"style\":\"normal\"}]}],\"visibleTo\":null},{\"_key\":\"444aa1d34327\",\"_type\":\"faq\",\"backgroundMedia\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-3584ed66db7ee18b076485677d61e49c2d3bfd84-1440x760-svg\",\"_type\":\"reference\"},\"image\":null},\"cta\":{\"_type\":\"cta\",\"external\":\"https://aaif.io/contact\",\"internal\":{\"_type\":\"page\",\"slug\":\"contact\"},\"label\":\"See all FAQs\",\"type\":\"internal\",\"variant\":\"default\"},\"dialogBackgroundMedia\":null,\"eyebrow\":\"Faq\",\"faqs\":[{\"_id\":\"ebcf88f3-9fde-4be1-94f7-d618bb10c6a2\",\"answer\":[{\"_key\":\"seed1wgq4xe5\",\"_type\":\"block\",\"children\":[{\"_key\":\"seed1x7mizea\",\"_type\":\"span\",\"marks\":[],\"text\":\"AAIF is open to entrepreneurs seeking cutting-edge AI solutions, researchers exploring the frontiers of agentic AI, and developers eager to build the next generation of AI agents.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"question\":\"How do I join AAIF?\"},{\"_id\":\"7f8258bb-d0e9-414a-a395-9d3f7a957e9b\",\"answer\":[{\"_key\":\"seed1t5hw3ze\",\"_type\":\"block\",\"children\":[{\"_key\":\"seed1uk9h898\",\"_type\":\"span\",\"marks\":[],\"text\":\"You can create projects directly from your dashboard after signing up. Each project gets its own workspace for collaboration.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"question\":\"How can I create projects?\"},{\"_id\":\"5f254999-b337-4744-b4fe-af1dd9d78c48\",\"answer\":[{\"_key\":\"seed228gs30t\",\"_type\":\"block\",\"children\":[{\"_key\":\"seed23pt7zix\",\"_type\":\"span\",\"marks\":[],\"text\":\"Yes, AAIF offers a free tier with access to core features. Premium tiers are available for advanced collaboration and enterprise needs.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"question\":\"Is AAIF free?\"}],\"heading\":{\"_type\":\"heading\",\"fontSize\":\"3XL\",\"text\":\"Your questions, our answers\",\"type\":\"h2\"},\"hidden\":true,\"media\":null,\"primaryCTA\":null,\"secondaryCTA\":null,\"settings\":{\"backgroundMedia\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-42949d1a137ce2c8e6948c821a4972b651fcc3f2-1440x760-png\",\"_type\":\"reference\"},\"image\":null},\"cta\":{\"_type\":\"cta\",\"external\":\"https://aaif.io/contact\",\"internal\":{\"_type\":\"page\",\"slug\":\"contact\"},\"label\":\"See all FAQs\",\"type\":\"internal\",\"variant\":\"default\"},\"description\":null,\"eyebrow\":\"Faq\",\"faqs\":[{\"_id\":\"ebcf88f3-9fde-4be1-94f7-d618bb10c6a2\",\"answer\":[{\"_key\":\"seed1wgq4xe5\",\"_type\":\"block\",\"children\":[{\"_key\":\"seed1x7mizea\",\"_type\":\"span\",\"marks\":[],\"text\":\"AAIF is open to entrepreneurs seeking cutting-edge AI solutions, researchers exploring the frontiers of agentic AI, and developers eager to build the next generation of AI agents.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"question\":\"How do I join AAIF?\"},{\"_id\":\"7f8258bb-d0e9-414a-a395-9d3f7a957e9b\",\"answer\":[{\"_key\":\"seed1t5hw3ze\",\"_type\":\"block\",\"children\":[{\"_key\":\"seed1uk9h898\",\"_type\":\"span\",\"marks\":[],\"text\":\"You can create projects directly from your dashboard after signing up. Each project gets its own workspace for collaboration.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"question\":\"How can I create projects?\"},{\"_id\":\"5f254999-b337-4744-b4fe-af1dd9d78c48\",\"answer\":[{\"_key\":\"seed228gs30t\",\"_type\":\"block\",\"children\":[{\"_key\":\"seed23pt7zix\",\"_type\":\"span\",\"marks\":[],\"text\":\"Yes, AAIF offers a free tier with access to core features. Premium tiers are available for advanced collaboration and enterprise needs.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"question\":\"Is AAIF free?\"},{\"_id\":\"4d29919c-298a-4f9c-b901-6c61e49521cf\",\"answer\":[{\"_key\":\"seed1z5eghfe\",\"_type\":\"block\",\"children\":[{\"_key\":\"seed20e7ggr9\",\"_type\":\"span\",\"marks\":[],\"text\":\"Members get access to exclusive research, community events, project collaboration tools, and networking opportunities with leading AI practitioners.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"question\":\"What benefits do members get?\"},{\"_id\":\"1334060c-248b-45a0-9df3-de28266b16a5\",\"answer\":[{\"_key\":\"seed1q6lz4tz\",\"_type\":\"block\",\"children\":[{\"_key\":\"seed1rfrja2u\",\"_type\":\"span\",\"marks\":[],\"text\":\"AAIF is a community-driven platform for advancing agentic AI research, collaboration, and open-source development.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"question\":\"What is AAIF for?\"}],\"heading\":{\"_type\":\"heading\",\"fontSize\":\"3XL\",\"text\":\"Your questions, our answers\",\"type\":\"h2\"}},\"tabs\":null,\"useDefaultSettings\":false,\"visibleTo\":null}],\"seo\":{\"keywords\":\"aaif\",\"metaDescription\":\"Agentic AI Foundation (AAIF) is the neutral and open foundation built on transparency, collaboration, and standardization to advance the public interest in agentic AI innovation.\",\"metaTitle\":\"Agentic AI Foundation (AAIF) - Open Standards for Agentic AI\",\"noFollow\":false,\"noIndex\":false,\"ogImageRef\":\"image-0d789315229cb4e247cac3c8fadd2b23f8fbb020-1200x627-png\"},\"slug\":{\"_type\":\"slug\",\"current\":\"home\"},\"tierOrdering\":[{\"blockOrder\":[\"754da41937ac\",\"5256941de7c4\",\"7221070ee699\",\"b0c54a20c1c0\"],\"tier\":\"agentic-aI\"},{\"blockOrder\":[\"9c6a45325dd7\",\"eb255f5d8590\",\"3fcdf14db578\",\"fcd574acf0d7\",\"2377a2b0af27\",\"ba26198653ca\",\"d855f64eb58a\",\"033bcc4d8aa2\",\"f8bdaac60eae\",\"25ed2903718e\",\"e2561af2183e\",\"444aa1d34327\"],\"tier\":\"enterprise-buyer\"}],\"title\":\"Home\"},\"filteredPage\":{\"_id\":\