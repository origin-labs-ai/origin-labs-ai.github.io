dfcd1814deda-1245x786.webp?auto=format&amp;crop=entropy&amp;fit=crop&amp;h=142&amp;q=75&amp;w=204 204w, https://cdn.sanity.io/images/4o10fa7h/production/83cac259a79073a8378df7c84a79dfcd1814deda-1245x786.webp?auto=format&amp;crop=entropy&amp;fit=crop&amp;h=284&amp;q=75&amp;w=408 408w, https://cdn.sanity.io/images/4o10fa7h/production/83cac259a79073a8378df7c84a79dfcd1814deda-1245x786.webp?auto=format&amp;crop=entropy&amp;fit=crop&amp;h=426&amp;q=75&amp;w=612 612w, https://cdn.sanity.io/images/4o10fa7h/production/83cac259a79073a8378df7c84a79dfcd1814deda-1245x786.webp?auto=format&amp;crop=entropy&amp;fit=crop&amp;h=568&amp;q=75&amp;w=816 816w" src="https://cdn.sanity.io/images/4o10fa7h/production/83cac259a79073a8378df7c84a79dfcd1814deda-1245x786.webp?auto=format&amp;crop=entropy&amp;fit=crop&amp;h=284&amp;q=75&amp;w=408" width="408" height="284"/></div><div class="flex flex-col items-start gap-y-4 p-3"><div class="flex flex-col items-start gap-y-2"><h3 class="text-white text-h3 font-normal">Observability &amp; Traceability</h3><p class="text-body-md text-neutral-100">Making agent behavior observable, explainable, and traceable across platforms — covering execution tracing, cross-system correlation, audit &amp; forensics, and standardized metrics.</p></div><a class="inline-flex items-center justify-center gap-2.5 whitespace-nowrap font-semibold text-body-sm transition-colors cursor-pointer bg-white text-text border border-neutral-200 rounded-lg h-[3.625rem] px-[1.125rem] py-1 group" href="/working-groups/observability-traceability">View Working Group<div class="size-9 grid place-items-center relative"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 23.387 23.387" width="1.5em" height="1.5em" aria-hidden="true" class="relative z-1 size-6 bg-white rounded-full"><path fill="#FF702D" d="M23.387 11.693C23.387 5.235 18.15 0 11.693 0S0 5.235 0 11.693s5.235 11.694 11.693 11.694 11.694-5.236 11.694-11.694"></path><path fill="#fff" d="M7.989 5.571h2.147v2.147H7.989