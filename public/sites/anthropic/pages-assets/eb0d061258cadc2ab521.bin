At\":\"2025-12-01\",\"quote\":\"How MCP, coding agents, and next-gen analytics could complete the final loop: AI systems that ship features and decide what to build.\",\"slug\":\"will-mcp-analytics-power-software-that-evolves-itself\",\"title\":\"Will MCP Analytics Power Software That Evolves Itself?\",\"videoUrl\":\"https://www.youtube.com/watch?v=05Bud8AUb7Q\"},{\"_id\":\"seed.interview.PZiLs2Cj728\",\"_type\":\"interview\",\"authorAvatar\":null,\"authorName\":\"Arnav Balyan\",\"authorRole\":\"Founder, Concierge AI\",\"image\":{\"alt\":\"Building Stateful, Transactional MCP Servers — Concierge AI Demo\",\"asset\":{\"_ref\":\"image-85f1b84955d08c7164f53706d0eafa27de6fda3e-1280x720-jpg\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/jpeg;base64,\"},\"partner\":\"Concierge AI\",\"publishedAt\":\"2026-02-18\",\"quote\":\"In this episode of The Context, Arnav Balyan, Founder of Concierge AI, walks through how to design transactional, staged MCP workflows.\",\"slug\":\"building-stateful-transactional-mcp-servers-concierge-ai-demo\",\"title\":\"Building Stateful, Transactional MCP Servers — Concierge AI Demo\",\"videoUrl\":\"https://www.youtube.com/watch?v=PZiLs2Cj728\"},{\"_id\":\"seed.interview.UFkzPjEAzO0\",\"_type\":\"interview\",\"authorAvatar\":null,\"authorName\":\"Austin Born \u0026 Shubham Palriwala\",\"authorRole\":\"CEO, Shinzo Labs \u0026 CEO, Agnost AI\",\"image\":{\"alt\":\"How Much of Your Product Can You Build With AI Agents?\",\"asset\":{\"_ref\":\"image-4189756b01f1198fac0b159686648d3419a525f9-1280x720-jpg\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/jpeg;base64,\"},\"partner\":\"Shinzo Labs / Agnost AI\",\"publishedAt\":\"2025-12-06\",\"quote\":\"Q\u0026A clip: whether founders and small teams are using AI agents, MCP servers, and automated analytics in their own development workflows.\",\"slug\":\"how-much-of-your-product-can-you-build-with-ai-agents\",\"title\":\"How Much of Your Product Can You Build With AI Agents?\",\"videoUrl\":\"https://www.youtube.com/watch?v=UFkzPjEAzO0\"},{\"_id\":\"seed.interview.ayCJYEMrCK4\",\"_type\":\"interview\",\"authorAvatar\":null,\"authorName\":\"Sam Partee \u0026 Nate Barbettini\",\"authorRole\":\"CTO \u0026 Founding Engineer, Arcade.dev\",\"image\":{\"alt\":\"The Dark Side of MCP Servers\",\"asset\":{\"_ref\":\"image-23654fab6846ce3ae5153bec5b0bb3d8b753d655-1280x720-jpg\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/jpeg;base64,\"},\"partner\":\"Arcade.dev\",\"publishedAt\":\"2026-05-13\",\"quote\":\"I'm joined by Sam Partee (CTO) and Nate Barbettini (Founding Engineer) — the team building Arcade.dev, an MCP runtime focused on secure AI agent infrastructure, authorization, and production-ready agent deployments.\",\"slug\":\"the-dark-side-of-mcp-servers\",\"title\":\"The Dark Side of MCP Servers\",\"videoUrl\":\"https://www.youtube.com/watch?v=ayCJYEMrCK4\"}],\"media\":{\"_type\":\"media\",\"image\":null,\"type\":\"video\",\"video\":{\"thumbnail\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-fd2554c03da7d0c91b1c89b2090f17da665c355a-1920x1098-webp\",\"_type\":\"reference\"}},\"videoConfig\":{\"autoplay\":true},\"videoFile\":{\"_type\":\"file\",\"asset\":{\"_ref\":\"file-90f927259f7b3dd37c1977ee4333f9664d8ab6cd-mp4\",\"_type\":\"reference\"}},\"videoType\":\"file\"}},\"primaryCTA\":null,\"secondaryCTA\":null,\"tabs\":[{\"_key\":\"4aebf5f762ba\",\"cta\":{\"_type\":\"cta\",\"external\":\"https://aaif.io/interviews\",\"label\":\"See more\",\"relative\":\"/\",\"target\":\"_self\",\"type\":\"relative\",\"variant\":\"default\"},\"interviews\":[{\"_key\":\"ed67c4ff82d2\",\"_ref\":\"seed.interview.UFkzPjEAzO0\",\"_type\":\"reference\"},{\"_key\":\"e6d7bae6d29c\",\"_ref\":\"seed.interview.ayCJYEMrCK4\",\"_type\":\"reference\"},{\"_key\":\"37aac48e0832\",\"_ref\":\"seed.interview.PZiLs2Cj728\",\"_type\":\"reference\"},{\"_key\":\"f50fabaa7024\",\"_ref\":\"seed.interview.05Bud8AUb7Q\",\"_type\":\"reference\"}],\"label\":\"Interviews\",\"mediaType\":\"interview\"},{\"_key\":\"c01df35b34e1\",\"cta\":{\"_type\":\"cta\",\"external\":\"https://aaif.io/podcasts\",\"label\":\"See More\",\"target\":\"_self\",\"type\":\"external\",\"variant\":\"default\"},\"label\":\"Podcasts\",\"mediaType\":\"podcast\"}],\"visibleTo\":null},{\"_key\":\"ba26198653ca\",\"_type\":\"writtenContentHub\",\"backgroundMedia\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-b911d21d5bc4fdb4ce3ef31c2e2b9abfca92091b-4630x2919-webp\",\"_type\":\"reference\"},\"image\":null},\"cta\":null,\"description\":[{\"_key\":\"de586776b355\",\"_type\":\"block\",\"children\":[{\"_key\":\"e8b3a3bb7236\",\"_type\":\"span\",\"marks\":[],\"text\":\"Insights and perspectives from the builders, contributors, and innovators advancing the field.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"dialogBackgroundMedia\":null,\"eyebrow\":\"Read what matters\",\"heading\":{\"_type\":\"heading\",\"fontSize\":\"3XL\",\"text\":\"Learn from the people building agentic AI\",\"type\":\"h2\"},\"media\":null,\"primaryCTA\":null,\"secondaryCTA\":null,\"tabs\":[{\"_key\":\"2a5bac9f8df2\",\"blogItems\":[{\"_type\":\"blog\",\"authors\":[{\"headshot\":{\"alt\":\"Vikram Vaswani\",\"asset\":{\"_ref\":\"image-ad9556ac12b6b79ba209555723e8006e50a252fd-898x1183-jpg\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"data:image/jpeg;base64,\"},\"name\":\"Vikram Vaswani\",\"slug\":\"vikram-vaswani\"}],\"category\":\"OpenSandbox\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":\"Ambassador\",\"publishedAt\":\"2026-11-06\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"give-goose-sandbox-powers-with-opensandbox-and-mcp\"},\"startsAt\":null,\"summary\":\"Connect goose to OpenSandbox over MCP to create and use local sandboxes, run code safely, and understand the setup’s current security limitations.\",\"tag\":\"Goose\",\"thumbnail\":{\"_type\":\"image\",\"alt\":\"Illustration of Vikram watching as goose and Alf build shipping-container-shaped sand blocks inside a fenced sandbox, with tools and finished sand containers nearby.\",\"asset\":{\"_ref\":\"image-879660938a19d92cee894d61d5f2497de6889750-1677x938-png\",\"_type\":\"reference\"}},\"title\":\"Give goose sandbox powers with OpenSandbox and MCP\"},{\"_type\":\"blog\",\"authors\":[{\"headshot\":{\"alt\":null,\"asset\":{\"_ref\":\"image-b603441c1e5bac264199537c1b7e6a3fceb9a6aa-400x400-png\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"$39\"},\"name\":\"Suryaprakash Lakshmanan\",\"slug\":\"suryaprakash-lakshmanan\"}],\"category\":\"Community\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-11-05\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"let-the-model-suggest-let-code-decide-notes-from-aaif-chennai-connect-2\"},\"startsAt\":null,\"summary\":\"A recap of AAIF Chennai Connect #2, covering practical approaches to multi-agent consistency, deterministic workflows, tool discovery, CI failure triage, and stateless MCP.\",\"tag\":\"MCP\",\"thumbnail\":{\"_type\":\"image\",\"alt\":\"Illustrated blog banner showing a speaker presenting a whiteboard workflow diagram at AAIF Chennai Connect #2 with Chennai landmarks in the background.\",\"asset\":{\"_ref\":\"image-632b6dff6923a32ad5463d1c9f011e21e80e94ba-1673x940-png\",\"_type\":\"reference\"}},\"title\":\"Let the model suggest, let code decide: notes from AAIF Chennai Connect #2\"},{\"_type\":\"blog\",\"authors\":[{\"headshot\":{\"alt\":null,\"asset\":{\"_ref\":\"image-99203052ad6572734bfefba09bc4f2ae2109c939-200x200-png\",\"_type\":\"reference\"},\"crop\":null,\"hotspot\":null,\"lqip\":\"$3a\"},\"name\":\"Drew Breunig\",\"slug\":\"drew-breunig\"}],\"category\":\"Agent Skills\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-11-04\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"most-agentic-work-will-become-workflows\"},\"startsAt\":null,\"summary\":\"Repeated agent interactions reveal useful workflows. Capturing those patterns as reusable skills and code helps improve consistency and preserve knowledge across tools.\",\"tag\":\"Agent Workflows\",\"thumbnail\":{\"_type\":\"image\",\"alt\":\"Illustration of Drew Breunig and a robot resting beside a worn, winding path, while smaller robots carry out tasks along a new, direct path.\",\"asset\":{\"_ref\":\"image-3ed3ab926d8d8a2abbea49936ac8e0ab8a52e620-1671x941-png\",\"_type\":\"reference\"}},\"title\":\"Most agentic work will become workflows\"},{\"_type\":\"blog\",\"authors\":[{\"headshot\":{\"alt\":null,\"asset\":{\"_ref\":\"image-61d746ab7969a62b3364123ff29e03d4d015a5a4-400x400-png\",\"_type\":\"reference\"},\"crop\":{\"_type\":\"sanity.imageCrop\",\"bottom\":0.1881871644080798,\"left\":0.1281854598141993,\"right\":0.05454700417625499,\"top\":0},\"hotspot\":{\"_type\":\"sanity.imageHotspot\",\"height\":0.8118128355919202,\"width\":0.8172675360095457,\"x\":0.5368192278189721,\"y\":0.4059064177959601},\"lqip\":\"$3b\"},\"name\":\"J.R. Storment\",\"slug\":\"j-r-storment\"}],\"category\":\"Enterprise \u0026 Production\",\"endsAt\":null,\"hosts\":null,\"location\":null,\"peopleType\":null,\"publishedAt\":\"2026-11-03\",\"redirectLink\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"total-cost-of-ai-over-value-realized\"},\"startsAt\":null,\"summary\":\"J.R. Storment is Executive Director of the Tokenomics Foundation, a Linux Foundation project.\",\"tag\":\"Observability\",\"thumbnail\":{\"_type\":\"image\",\"alt\":\"A balance scale tips toward a small collection of AI infrastructure costs, outweighing a tall stack of tokens. J.R. Storment explains the surprising result to Alf.\",\"asset\":{\"_ref\":\"image-4beba43cbd33850d35aa52f312e58c4d17bc7467-1672x941-png\",\"_type\":\"reference\"}},\"title\":\"Total cost of AI over value realized\"},{\"_type\":\"blog\",\"authors\":[{\"headshot\":{\"alt\":null,\"asset\":{\"_ref\":\"