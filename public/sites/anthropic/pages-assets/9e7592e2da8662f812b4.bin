et.webp&quot;);--mark-w:2.1067;--mark-h:0.4747"></span></div><span class="CardHub-module-scss-module__om9dLG__edge" aria-hidden="true"></span></div><div class="CardHub-module-scss-module__om9dLG__body"><h3 class="CardHub-module-scss-module__om9dLG__title text-body-2">Pictet turns weeks of work into hours with Claude Code</h3></div></a><a href="/customers/dxc" class="CardHub-module-scss-module__om9dLG__card CardHub-module-scss-module__om9dLG__cardCountOn"><div class="CardHub-module-scss-module__om9dLG__plate"><span class="CardHub-module-scss-module__om9dLG__mark CardHub-module-scss-module__om9dLG__markInk" style="--logo-mask:url(&quot;/static/count-on-claude/card-logos/dxc.webp&quot;);--mark-w:2.4876;--mark-h:0.402" role="img" aria-label="DXC"></span><div class="CardHub-module-scss-module__om9dLG__photo" aria-hidden="true"><span class="CardHub-module-scss-module__om9dLG__mark CardHub-module-scss-module__om9dLG__markLight" style="--logo-mask:url(&quot;/static/count-on-claude/card-logos/dxc.webp&quot;);--mark-w:2.4876;--mark-h:0.402"></span></div><span class="CardHub-module-scss-module__om9dLG__edge" aria-hidden="true"></span></div><div class="CardHub-module-scss-module__om9dLG__body"><h3 class="CardHub-module-scss-module__om9dLG__title text-body-2">DXC brings Claude to the insurance backbone running billions of policies</h3></div></a><a href="/customers/atlassian" class="CardHub-module-scss-module__om9dLG__card CardHub-module-scss-module__om9dLG__cardCountOn"><div class="CardHub-module-scss-module__om9dLG__plate"><span class="CardHub-module-scss-module__om9dLG__mark CardHub-module-scss-module__om9dLG__markInk" style="--logo-mask:url(&quot;/static/count-on-claude/card-logos/atlassian.webp&quot;);--mark-w:2.8394;--mark-h:0.3522" role="img" aria-label="Atlassian"></span><div class="CardHub-module-scss-module__om9dLG__photo" aria-hidden="true"><span class="CardHub-module-scss-module__om9dLG__mark CardHub-module-scss-module__om9dLG__markLight" style="--logo-mask:url(&quot;