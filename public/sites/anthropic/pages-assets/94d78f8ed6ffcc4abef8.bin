ss="bxgyUW_table" style="--table-cols-lg:449fr 393fr 321fr 240fr 166fr 111fr;--table-cols-md:437fr 381fr 207fr 2rem;visibility:hidden"><header aria-hidden="true" class="bxgyUW_header"><div data-column="title">Title</div><div data-column="description">Description</div><div data-column="category">Category</div><div data-column="images">Images</div><div data-column="date">Date</div><div class="bxgyUW_header-constellation"><svg class="xjGFCq_icon" viewBox="0 0 36 18" width="36" height="18" aria-hidden="true" focusable="false"><path class="xjGFCq_lines" data-stage="a" d="M15.07 9.65L11.2 10.51M15.46 7.41L11.91 5.19M20.93 8.35L24.8 7.49M20.54 10.59L24.09 12.81"></path><path class="xjGFCq_lines" data-stage="b" d="M8.31 9.17L11.58 6.77M13.67 7.98L13.25 11.76M16.83 6L20.38 7.25M24.51 6.99L27.49 5.51"></path><path class="xjGFCq_lines" data-stage="c" d="M8.21 7.63L9.29 10.87M12.25 13L16.5 13M22.43 12.35L26.3 11.49M20.97 10.39L22.9 6.96"></path><g class="xjGFCq_dot" style="--ax:-9px;--ay:2px;--bx:-11.5px;--by:1.5px;--cx:-10.5px;--cy:-3.5px"><circle cx="18" cy="9" r="1.75"></circle></g><g class="xjGFCq_dot" style="--ax:-8px;--ay:-5px;--bx:-5px;--by:5px;--cx:-8px;--cy:4px"><circle cx="18" cy="9" r="1.75"></circle></g><g class="xjGFCq_dot" style="--ax:0px;--ay:0px;--bx:-4px;--by:-4px;--cx:1.5px;--cy:4px"><circle cx="18" cy="9" r="2.5"></circle></g><g class="xjGFCq_dot" style="--ax:9px;--ay:-2px;--bx:4.5px;--by:-1px;--cx:10.5px;--cy:2px"><circle cx="18" cy="9" r="1.75"></circle></g><g class="xjGFCq_dot" style="--ax:8px;--ay:5px;--bx:11.5px;--by:-4.5px;--cx:6px;--cy:-4px"><circle cx="18" cy="9" r="1.75"></circle></g></svg></div></header><ul><li class="bxgyUW_row" data-listing-row="d23b7a32-b56f-43f0-8e57-6fe44ca657b8"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/project-eve-claude-plays-mmorpgs"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">Project EVE: Claude plays MMORPGs</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/project-eve-claude-plays-mmorpgs"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>AI models may one day participate in real companies and markets. In this project, we turned to a different setting: massively multiplayer online role-playing games—virtual worlds that in many ways reflect the complexity of the real world. </p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/frontier-red-team">Frontier Red Team</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/bb70e05a91a7d1bc73821ac72aaa1bfaf5a5011f.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/87e9682fdbe68c128f9f5f16d2ad89f37899a21e.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/781486c32cbc2268410d54b82c3019d0e43fab39.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/c12bf30108ac1cf257b49425756a99f3729a00a3.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/></div></div><div class="bxgyUW_date"><time>Nov 6, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="Project EVE: Claude plays MMORPGs details"><div class="bxgyUW_details-meta"><div>Nov 6, 2026</div><div><a class="wN10Da_link" href="/research/team/frontier-red-team">Frontier Red Team</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/project-eve-claude-plays-mmorpgs"><h3>Project EVE: Claude plays MMORPGs</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/project-eve-claude-plays-mmorpgs"><p>AI models may one day participate in real companies and markets. In this project, we turned to a different setting: massively multiplayer online role-playing games—virtual worlds that in many ways reflect the complexity of the real world. </p></a></div></div><button aria-label="Show details for Project EVE: Claude plays MMORPGs" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="680a8d41-92ef-4c9b-b9df-50846dcdb8ce"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/discovering-vulnerabilities-with-claude"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">Discovering and exploiting vulnerabilities in critical, real-world software with Claude</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/discovering-vulnerabilities-with-claude"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>Over the past few months, we’ve used an unreleased, internal research model to find critical vulnerabilities in some of the world’s most widely used software, such as browsers and operating systems. In this post, we share details of five attack chains, which led to remote code execution and other critical impacts with little to no user interaction.</p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/frontier-red-team">Frontier Red Team</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"></div></div><div class="bxgyUW_date"><time>Oct 27, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="Discovering and exploiting vulnerabilities in critical, real-world software with Claude details"><div class="bxgyUW_details-meta"><div>Oct 27, 2026</div><div><a class="wN10Da_link" href="/research/team/frontier-red-team">Frontier Red Team</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/discovering-vulnerabilities-with-claude"><h3>Discovering and exploiting vulnerabilities in critical, real-world software with Claude</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/discovering-vulnerabilities-with-claude"><p>Over the past few months, we’ve used an unreleased, internal research model to find critical vulnerabilities in some of the world’s most widely used software, such as browsers and operating systems. In this post, we share details of five attack chains, which led to remote code execution and other critical impacts with little to no user interaction.</p></a></div></div><button aria-label="Show details for Discovering and exploiting vulnerabilities in critical, real-world software with Claude" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="a08af3e0-c027-420b-8b7b-75ba8931625a"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/formal-verification"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">LLMs are making formal software verification feasible at a much larger scale</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/formal-verification"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>We used Claude to prove security properties in over 100 real-world open-source libraries over the span of a few weeks.</p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/frontier-red-team">Frontier Red Team</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/02207cbc6f46e272fe9a0fa7929cb8ec29578e74.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Line chart of the share of 36 verification tasks completed by token budget per agent for Opus 5.5, Fable 5.1, and Opus 5. Opus 5.5 finishes proofs with the fewest tokens." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/5078468fa7e09774b1ab6e86984ec5691d3d11fa.gif?fm=jpeg&amp;w=48&amp;h=48&amp;fit=crop" alt="Chart of 36 proofs in finishing order, with arcs joining proofs that share a file and bars showing the tokens spent on each proof compared with an agent working alone." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/8e295614d599d548fbd2ff97ed3cc3e62f501b2b.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Block chart of the proofs for libcups, freerdp, and libzmq, showing how much of each part was identical, lightly edited, edited more or new." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/></div></div><div class="bxgyUW_date"><time>Oct 22, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="LLMs are making formal software verification feasible at a much larger scale details"><div class="bxgyUW_details-meta"><div>Oct 22, 2026</div><div><a class="wN10Da_link" href="/research/team/frontier-red-team">Frontier Red Team</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/formal-verification"><h3>LLMs are making formal software verification feasible at a much larger scale</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/formal-verification"><p>We used Claude to prove security properties in over 100 real-world open-source libraries over the span of a few weeks.</p></a></div></div><button aria-label="Show details for LLMs are making formal software verification feasible at a much larger scale" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="96afbd13-0f0e-40f1-ab63-c703e9fb4748"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/attack-surface-reduction"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">Using Claude to reduce the attack surface of code</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/attack-surface-reduction"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>Automated attack surface analysis and reduction can meaningfully improve the security of deployed software in the near term. In this post, we preview data we’ve collected from applying attack surface reduction techniques to large open-source codebases using Claude.</p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/frontier-red-team">Frontier Red Team</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/38c02924e2b97c9123f9f91add29b1e2b63665a3.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/></div></div><div class="bxgyUW_date"><time>Oct 20, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="Using Claude to reduce the attack surface of code details"><div class="bxgyUW_details-meta"><div>Oct 20, 2026</div><div><a class="wN10Da_link" href="/research/team/frontier-red-team">Frontier Red Team</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/attack-surface-reduction"><h3>Using Claude to reduce the attack surface of code</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/attack-surface-reduction"><p>Automated attack surface analysis and reduction can meaningfully improve the security of deployed software in the near term. In this post, we preview data we’ve collected from applying attack surface reduction techniques to large open-source codebases using Claude.</p></a></div></div><button aria-label="Show details for Using Claude to reduce the attack surface of code" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="article-e5fc8ba8-ecae-41ae-b6b9-4b53ed412eb5"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/expectations-for-the-future"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">Working at the frontier shapes expectations for the future</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/expectations-for-the-future"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>We’re sharing two reports: the first covers how AI is changing employment inside Anthropic, and the second looks at the gap between how the public and Anthropic employees expect AI to affect work and the economy.</p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/economics">Economics</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"></div></div><div class="bxgyUW_date"><time>Oct 16, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="Working at the frontier shapes expectations for the future details"><div class="bxgyUW_details-meta"><div>Oct 16, 2026</div><div><a class="wN10Da_link" href="/research/team/economics">Economics</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/expectations-for-the-future"><h3>Working at the frontier shapes expectations for the future</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/expectations-for-the-future"><p>We’re sharing two reports: the first covers how AI is changing employment inside Anthropic, and the second looks at the gap between how the public and Anthropic employees expect AI to affect work and the economy.</p></a></div></div><button aria-label="Show details for Working at the frontier shapes expectations for the future" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="article-d3dd3ae5-150b-4d1d-96b3-72aea6e35ba2"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/ecdsa-curve-origins"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">Claude reveals ECDSA curve origins</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/ecdsa-curve-origins"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>The decades-old mystery of the origins of one of the most popular cryptographic standards has been explained.</p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/frontier-red-team">Frontier Red Team</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/cf1ddefd34e0a2f003744349e26aae4d4377c144.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/81b039a62222e0fb4b228c99020eb00aee88e0bc.jpg?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/e8e7bb885a5e83cbcfe80e5b25f5ef7203c558ba.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/8d33bd1699b059f1fe077e1f00cf11b5dc39ae32.jpg?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/42548edc427fbef163f51d35a46abe256db19966.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/></div></div><div class="bxgyUW_date"><time>Oct 16, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="Claude reveals ECDSA curve origins details"><div class="bxgyUW_details-meta"><div>Oct 16, 2026</div><div><a class="wN10Da_link" href="/research/team/frontier-red-team">Frontier Red Team</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/ecdsa-curve-origins"><h3>Claude reveals ECDSA curve origins</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/ecdsa-curve-origins"><p>The decades-old mystery of the origins of one of the most popular cryptographic standards has been explained.</p></a></div></div><button aria-label="Show details for Claude reveals ECDSA curve origins" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="article-8d15dc1c-2b77-4242-954b-5289889e0aa2"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/employment-at-anthropic"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">How employment is changing at Anthropic</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/employment-at-anthropic"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>How has AI restructured work and employment at Anthropic? As a company at the frontier of AI adoption, Anthropic could be a leading indicator of how AI will shift work organization, hiring, and labor demand across the economy.</p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/economics">Economics</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/164be0e20d6b2acfe62e955314f8a3597f79ed15.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/042b829f8c8850b596dfb6feaa323d1e911b21bb.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/1865c3a561e790824826f29a27c771ce62c67eaf.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/15abba062e588ec86e0f9466f16bccbc701444e3.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/f68fdd1f18d36b4e45e17f0aaaa49541bade7dcd.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/></div></div><div class="bxgyUW_date"><time>Oct 16, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="How employment is changing at Anthropic details"><div class="bxgyUW_details-meta"><div>Oct 16, 2026</div><div><a class="wN10Da_link" href="/research/team/economics">Economics</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/employment-at-anthropic"><h3>How employment is changing at Anthropic</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/employment-at-anthropic"><p>How has AI restructured work and employment at Anthropic? As a company at the frontier of AI adoption, Anthropic could be a leading indicator of how AI will shift work organization, hiring, and labor demand across the economy.</p></a></div></div><button aria-label="Show details for How employment is changing at Anthropic" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="article-32c463e9-cf7c-4a03-82db-41b2a4cf85fb"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/ai-expectations-gap"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">The AI expectations gap</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/ai-expectations-gap"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>How will AI reshape the economy in the years ahead? What is the core source of disagreement about AI&#x27;s future impact on the economy? This note presents new survey evidence on these questions. </p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/economics">Economics</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/0f1da70f67b1d1106cf896237abb69033ff810e5.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/ee5b9b5d8af4bc1f38cc3451e98a15e6d38aa067.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/28963a3d0ad7315ec336b3cac3b0547324e02f0d.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/4c3da1aa5e255c4f6fe62ef2dfb521473ac8d105.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/23b4644432371743e7aab1c386977d1157826002.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/></div></div><div class="bxgyUW_date"><time>Oct 16, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="The AI expectations gap details"><div class="bxgyUW_details-meta"><div>Oct 16, 2026</div><div><a class="wN10Da_link" href="/research/team/economics">Economics</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/ai-expectations-gap"><h3>The AI expectations gap</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/ai-expectations-gap"><p>How will AI reshape the economy in the years ahead? What is the core source of disagreement about AI&#x27;s future impact on the economy? This note presents new survey evidence on these questions. </p></a></div></div><button aria-label="Show details for The AI expectations gap" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="article-ba7e6823-b18c-4753-a36b-4b1d477b60d9"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/self-replicating-ai"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">AI models may be capable of self-replicating without access to a datacenter</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/self-replicating-ai"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>Our experiments suggest that small AI models may be only months away from being capable enough to self-replicate on commercial IoT devices, like Android TVs and smart ovens.</p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/frontier-red-team">Frontier Red Team</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/25459a064b25f10689f20e258fb4f1f0291ea083.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Flow diagram of the replication stages: network enumeration, initial access and payload delivery (with opportunistic privilege escalation), inference setup, and replication. The first stages are grouped as ‘cyber exploit (not our focus)’ and inference setup is marked ‘our focus’." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/9d35ab77dd3402cadb0011b20cc7b9960f7ea265.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="The same flow diagram with every stage except inference setup faded." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/86a08001fc009111290ff7fa0c9a5fc9ec2525b9.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Screenshot of a device search engine’s results page. Identifying details are covered, some by labels such as ‘smart camera admin page’." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/></div></div><div class="bxgyUW_date"><time>Oct 12, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="AI models may be capable of self-replicating without access to a datacenter details"><div class="bxgyUW_details-meta"><div>Oct 12, 2026</div><div><a class="wN10Da_link" href="/research/team/frontier-red-team">Frontier Red Team</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/self-replicating-ai"><h3>AI models may be capable of self-replicating without access to a datacenter</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/self-replicating-ai"><p>Our experiments suggest that small AI models may be only months away from being capable enough to self-replicate on commercial IoT devices, like Android TVs and smart ovens.</p></a></div></div><button aria-label="Show details for AI models may be capable of self-replicating without access to a datacenter" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="article-4bdb410b-d0c3-4c8f-acee-e1cb27eb43cd"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/launching-opt-in-vuln-finding-service-for-open-source"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">Launching an opt-in vulnerability-finding service for open-source software</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/launching-opt-in-vuln-finding-service-for-open-source"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>We’re making available OSS Scanner, an opt-in vulnerability scanner for the open-source ecosystem that’s informed by our experience using Claude to find vulnerabilities during Project Glasswing.</p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/frontier-red-team">Frontier Red Team</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"></div></div><div class="bxgyUW_date"><time>Oct 8, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="Launching an opt-in vulnerability-finding service for open-source software details"><div class="bxgyUW_details-meta"><div>Oct 8, 2026</div><div><a class="wN10Da_link" href="/research/team/frontier-red-team">Frontier Red Team</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/launching-opt-in-vuln-finding-service-for-open-source"><h3>Launching an opt-in vulnerability-finding service for open-source software</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/launching-opt-in-vuln-finding-service-for-open-source"><p>We’re making available OSS Scanner, an opt-in vulnerability scanner for the open-source ecosystem that’s informed by our experience using Claude to find vulnerabilities during Project Glasswing.</p></a></div></div><button aria-label="Show details for Launching an opt-in vulnerability-finding service for open-source software" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="article-762ab1c0-19a5-4632-b0ab-c2d47a440298"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/what-work-can-robots-do"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">What work can robots do?</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/what-work-can-robots-do"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>We built an index of how well today’s robots can perform US job tasks. Robots can already do three-quarters of physical tasks, mostly in limited settings, but are cost-competitive for just 0.3% of them.</p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/economics">Economics</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/fbed704c01c8149969125dcab143c9baf921ed76.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Task robot exposure rubric" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/8e64ebbd731479af4c35c9e746ec333449dd935d.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Example task exposure ratings" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/1dfbdcd3ec1d2f240502194d008e9cc66ec2f364.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Job tasks by robot exposure" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/889fc5dfe3ba1248a3edd7529060d9d3c0b3683c.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Most exposed occupations" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/69b30954b469594889d620026cbace6f8ef5ad87.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Occupation characteristics by robot exposure" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/></div></div><div class="bxgyUW_date"><time>Sep 30, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="What work can robots do? details"><div class="bxgyUW_details-meta"><div>Sep 30, 2026</div><div><a class="wN10Da_link" href="/research/team/economics">Economics</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/what-work-can-robots-do"><h3>What work can robots do?</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/what-work-can-robots-do"><p>We built an index of how well today’s robots can perform US job tasks. Robots can already do three-quarters of physical tasks, mostly in limited settings, but are cost-competitive for just 0.3% of them.</p></a></div></div><button aria-label="Show details for What work can robots do?" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="article-c4acb156-0f4c-4f71-9d24-98aa93006675"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/your-thoughts-on-ai"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">What do you want from AI? </h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/your-thoughts-on-ai"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>We’re launching a new study using Anthropic Interviewer to learn from your experiences with AI. </p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/societal-impacts">Societal Impacts</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"></div></div><div class="bxgyUW_date"><time>Sep 29, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="What do you want from AI?  details"><div class="bxgyUW_details-meta"><div>Sep 29, 2026</div><div><a class="wN10Da_link" href="/research/team/societal-impacts">Societal Impacts</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/your-thoughts-on-ai"><h3>What do you want from AI? </h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/your-thoughts-on-ai"><p>We’re launching a new study using Anthropic Interviewer to learn from your experiences with AI. </p></a></div></div><button aria-label="Show details for What do you want from AI? " class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="article-0f657136-5f69-4d4f-96f2-f0a18992d56a"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/glm-5-3-and-the-spread-of-advanced-cyber-capabilities"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">GLM-5.3 and the spread of advanced cyber capabilities</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/glm-5-3-and-the-spread-of-advanced-cyber-capabilities"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>Like Claude Mythos Preview, GLM-5.3 has strong capabilities for autonomously building end-to-end cyber exploits. But unlike other frontier models, GLM-5.3 has been released without meaningful safeguards to limit misuse.</p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/frontier-red-team">Frontier Red Team</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/2ad7fd1ae4078dafd234d7de91af06c028dd7ca0.jpg?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Two bar charts. Top: share of attempts that built a working exploit on 41 Chrome V8 bugs — Claude Mythos Preview at 14% and GLM-5.3 at 12%, while Claude Opus 4.6, GLM-5.2, Kimi K3, and DeepSeek V4.1-Flash score at or near 0%. Bottom: how often each model engaged with malicious cyber-attack orders — GLM-5.3 rises from 0% on a bare order to 64% with a false cover story, 92% with prefilled reasoning, and 100% when abliterated, while Claude Opus 5 stays at 0%." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/c6201190841aee092e0a0db527b6219224187b8f.jpg?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Two line charts of exploitation success versus output-token budget on a log scale. On ExploitBench, Claude Mythos Preview reaches 14% and GLM-5.3 reaches 12%, while Kimi K3, DeepSeek-V4.1-Flash, Claude Opus 4.6, and GLM-5.2 stay at or near 0%. On Anthropic&#x27;s internal Binary Exploitation benchmark, Mythos Preview reaches 6% and GLM-5.3 reaches 4%; all other models score 0%." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/112c1452d1bcef571dfd70abed890abf5677f5a9.jpg?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Redacted screenshot of an exploit page generated by GLM-5.3. A banner reads &quot;Sandbox escaped — web content read /root/.ssh/id_rsa (1896 bytes),&quot; above a live exploit log and the exfiltrated SSH private key, demonstrating a drive-by browser exploit chain stealing a file from the victim&#x27;s computer." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/30385675797a82dba572c10ffeefe734e1eb760c.jpg?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Two bar charts on abliteration. Top: mean refusal rate across three harmful-request benchmarks falls from 95% to 6% for abliterated GLM-5.3 and from 95% to 14% for abliterated GLM-5.3-Flash, while Claude models refuse about 96% and cannot be abliterated because their weights are not released. Bottom: capability scores on GPQA-Diamond and CyberGym are nearly unchanged after abliteration." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/14006409417e998005a3150ebadbc8276653851b.jpg?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Table showing how often each model tried to connect to a remote target after a harmful cyber-attack order. GLM-5.3 engages 0% on a bare order but 64% with a false cover story, 92% with prefilled reasoning, and 100% when abliterated; GLM-5.3-Flash follows a similar pattern. Claude Opus 4.8, Opus 5, and Mythos 5 stay at 0% in all applicable conditions; prefilling and abliteration are not possible against the Claude API." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/></div></div><div class="bxgyUW_date"><time>Sep 29, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="GLM-5.3 and the spread of advanced cyber capabilities details"><div class="bxgyUW_details-meta"><div>Sep 29, 2026</div><div><a class="wN10Da_link" href="/research/team/frontier-red-team">Frontier Red Team</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/glm-5-3-and-the-spread-of-advanced-cyber-capabilities"><h3>GLM-5.3 and the spread of advanced cyber capabilities</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/glm-5-3-and-the-spread-of-advanced-cyber-capabilities"><p>Like Claude Mythos Preview, GLM-5.3 has strong capabilities for autonomously building end-to-end cyber exploits. But unlike other frontier models, GLM-5.3 has been released without meaningful safeguards to limit misuse.</p></a></div></div><button aria-label="Show details for GLM-5.3 and the spread of advanced cyber capabilities" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="article-d688b7e4-0c57-4c8a-8d35-3c40dc59ed5f"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/project-swap"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">Project Swap: What happens when agents trade for us?</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/project-swap"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>To see what works and what breaks when agents are sent into a market, we made a miniature market of Claudes.</p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/economics">Economics</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/a8936f794301eb9dd120c61a94eb4e91b574c540.jpg?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Diagram of the experiment&#x27;s three stages: participants brief their agents about the book they brought and what they hope to read; agents trade either through a centralized clearinghouse or by negotiating directly on a decentralized trading floor; each agent then hands its person the book it traded for." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/73277a71d4d5e7b0e753fb6a06d8e6f1004148e2.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Scatter plot comparing where Claude&#x27;s ranking placed each book against where the participant&#x27;s own ranking placed it. The fitted line has a slope of 0.30 (95% interval 0.24 to 0.35), well below the perfect-agreement diagonal, showing Claude&#x27;s rankings only partially matched participants&#x27; true preferences." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/f96f6de0c3ca2fc417ce8f3363370ba359e010ec.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Waterfall chart decomposing the market&#x27;s shortfall. In the decentralized market, scores fall from a best possible 0.89 mainly due to Claude&#x27;s representation of preferences (−0.29), with agent-to-agent bargaining costing only −0.05, leaving 0.55. Under a centralized trading rule, scores fall from 0.82 to 0.60, again driven by representation (−0.23)." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/27aeae61ccd83f2036d232a430fee3435694b95f.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Dot plot of allocation efficiency by model. With every agent on one model: Haiku 0.75, Sonnet 0.80, Opus 0.88, Fable 0.86. On mixed floors pairing Opus with each model, whole-floor efficiency is 0.82 with Haiku, 0.83 with Sonnet, and 0.86 with Fable." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/></div></div><div class="bxgyUW_date"><time>Sep 24, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="Project Swap: What happens when agents trade for us? details"><div class="bxgyUW_details-meta"><div>Sep 24, 2026</div><div><a class="wN10Da_link" href="/research/team/economics">Economics</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/project-swap"><h3>Project Swap: What happens when agents trade for us?</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/project-swap"><p>To see what works and what breaks when agents are sent into a market, we made a miniature market of Claudes.</p></a></div></div><button aria-label="Show details for Project Swap: What happens when agents trade for us?" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="article-61423a6a-3e07-4345-b433-0c52c034c2c1"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/intelligence-targeting-conventional-weapons-capabilities"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">Measuring tactical intelligence targeting and conventional weapons capabilities of AI models</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/intelligence-targeting-conventional-weapons-capabilities"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>Anthropic’s Frontier Red Team developed new evaluations to measure AI capabilities in tactical intelligence targeting and conventional weapons development.</p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/frontier-red-team">Frontier Red Team</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/5d3407b14c21d7d9ff007fabe7ec31b9211250b6.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Bar charts of three drone flight-software evals: Opus 5 leads each task, then the Mythos models; Sonnet 5 and Kimi K3 trail." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/705ec9bb8164b0ed83790e7ba586e5e30594369d.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Bar chart of drone strike rates by setting: Opus 5 leads with 80% on a parked, high-visibility car; hardest settings near 0%." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/f0250a95621ed26b19c68b170ae30b8df7208f07.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Bar charts of payload drops by setting: most models land within 5 m of still targets; only Opus 5 (28%) copes with wind." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/c6122be642a10bb9c30f992dc6290dca1e94a015.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Bar charts of flying without GPS: most models arrive on clean GPS; almost none get within 5 m once GPS is denied or spoofed." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/></div></div><div class="bxgyUW_date"><time>Sep 10, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="Measuring tactical intelligence targeting and conventional weapons capabilities of AI models details"><div class="bxgyUW_details-meta"><div>Sep 10, 2026</div><div><a class="wN10Da_link" href="/research/team/frontier-red-team">Frontier Red Team</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/intelligence-targeting-conventional-weapons-capabilities"><h3>Measuring tactical intelligence targeting and conventional weapons capabilities of AI models</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/intelligence-targeting-conventional-weapons-capabilities"><p>Anthropic’s Frontier Red Team developed new evaluations to measure AI capabilities in tactical intelligence targeting and conventional weapons development.</p></a></div></div><button aria-label="Show details for Measuring tactical intelligence targeting and conventional weapons capabilities of AI models" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="b7d3d957-1831-4140-932e-41dc8c211c55"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/institute/econ-scenarios"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">Scenarios for our economic future</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/institute/econ-scenarios"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>Anthropic’s Economics team is sharing a new model of how AI may affect economic growth, jobs, wages, and more by 2030. The model lets you explore the scenarios, tell us what you think will happen, and see how your answers compare to +10,000 Americans.</p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/economics">Economics</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"></div></div><div class="bxgyUW_date"><time>Sep 9, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="Scenarios for our economic future details"><div class="bxgyUW_details-meta"><div>Sep 9, 2026</div><div><a class="wN10Da_link" href="/research/team/economics">Economics</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/institute/econ-scenarios"><h3>Scenarios for our economic future</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/institute/econ-scenarios"><p>Anthropic’s Economics team is sharing a new model of how AI may affect economic growth, jobs, wages, and more by 2030. The model lets you explore the scenarios, tell us what you think will happen, and see how your answers compare to +10,000 Americans.</p></a></div></div><button aria-label="Show details for Scenarios for our economic future" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="article-6c187aba-2d24-49db-a741-06e3571284f1"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/enabling-independent-research"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">Enabling independent research on how people use Claude</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/enabling-independent-research"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>We ran a pilot giving external researchers access to aggregate, real-world Claude usage data. In this post, we share high-level results and what we learned running this pilot.</p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/societal-impacts">Societal Impacts</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"></div></div><div class="bxgyUW_date"><time>Aug 26, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="Enabling independent research on how people use Claude details"><div class="bxgyUW_details-meta"><div>Aug 26, 2026</div><div><a class="wN10Da_link" href="/research/team/societal-impacts">Societal Impacts</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/enabling-independent-research"><h3>Enabling independent research on how people use Claude</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/enabling-independent-research"><p>We ran a pilot giving external researchers access to aggregate, real-world Claude usage data. In this post, we share high-level results and what we learned running this pilot.</p></a></div></div><button aria-label="Show details for Enabling independent research on how people use Claude" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="article-4f64553b-a348-4229-8813-46615a120c2b"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/multiagent-systems"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">Patterns and problems in emerging multiagent systems</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/multiagent-systems"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>Here, we identify a few examples of behavioral tendencies in current frontier models and show how they can produce unexpected systemic failures, in hopes of starting a conversation about mitigating these risks.</p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/frontier-red-team">Frontier Red Team</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/feceb2a7f4dd73e103b86b20db65ef7f12803ced.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Vulnerabilities found vs. tokens sampled: coordinated Mythos Preview agents found 266, coordinated Opus 4.8 agents found 41." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/34ffa8cc39ef8e749c5a371b5cb2c8df2dbd3e8f.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Merged PR fraction fell as agents rose from 10 to 80, steeply for Sonnet 4.6 and Opus 4.6; code sharing stayed low for all." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/44ab8ecc322cb19845a71799856050cfdda1d04e.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="PR activity, 80 agents: Sonnet 4.6 and Opus 4.6 opened 876 and 980 PRs but closed few; newer models closed most they opened." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/de379282e02b51bb7b8b978addcbb0a7ef49c691.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Gullibility curve: routing accuracy fell as the bad source lied more. Mythos 5 held near 0.85; Sonnet models fell to 0.62." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/48c8600f4196d90ac35237f711f2978c27ebbfce.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Group accuracy by model: Mythos 5 groups scored about 85%; other models scored 17–36%, far below solo ceilings near 100%." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/></div></div><div class="bxgyUW_date"><time>Aug 13, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="Patterns and problems in emerging multiagent systems details"><div class="bxgyUW_details-meta"><div>Aug 13, 2026</div><div><a class="wN10Da_link" href="/research/team/frontier-red-team">Frontier Red Team</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/multiagent-systems"><h3>Patterns and problems in emerging multiagent systems</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/multiagent-systems"><p>Here, we identify a few examples of behavioral tendencies in current frontier models and show how they can produce unexpected systemic failures, in hopes of starting a conversation about mitigating these risks.</p></a></div></div><button aria-label="Show details for Patterns and problems in emerging multiagent systems" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="article-38ab22b2-9637-4433-a20c-47dd388bac34"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/reviewing-the-evidence-on-worker-retraining-programs"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">Reviewing the evidence on worker retraining programs</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/reviewing-the-evidence-on-worker-retraining-programs"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>We&#x27;re sharing a review of the evidence on worker retraining programs, coauthored by independent researcher David Roodman and Anthropic&#x27;s Maxim Massenkoff.</p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/economics">Economics</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"></div></div><div class="bxgyUW_date"><time>Aug 12, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="Reviewing the evidence on worker retraining programs details"><div class="bxgyUW_details-meta"><div>Aug 12, 2026</div><div><a class="wN10Da_link" href="/research/team/economics">Economics</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/reviewing-the-evidence-on-worker-retraining-programs"><h3>Reviewing the evidence on worker retraining programs</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/reviewing-the-evidence-on-worker-retraining-programs"><p>We&#x27;re sharing a review of the evidence on worker retraining programs, coauthored by independent researcher David Roodman and Anthropic&#x27;s Maxim Massenkoff.</p></a></div></div><button aria-label="Show details for Reviewing the evidence on worker retraining programs" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="article-f8d94ae8-46d8-45ce-915a-131710ae0fd9"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/discovering-cryptographic-weaknesses"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">Discovering cryptographic weaknesses with Claude</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/discovering-cryptographic-weaknesses"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>Cryptographic algorithms. The first attack significantly weakens HAWK, a digital signature scheme that was built for a future world where quantum computers are able to break existing standards. The second identifies a new way to attack round-reduced AES, the most widely used symmetric cipher. </p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/frontier-red-team">Frontier Red Team</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"></div></div><div class="bxgyUW_date"><time>Jul 28, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="Discovering cryptographic weaknesses with Claude details"><div class="bxgyUW_details-meta"><div>Jul 28, 2026</div><div><a class="wN10Da_link" href="/research/team/frontier-red-team">Frontier Red Team</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/discovering-cryptographic-weaknesses"><h3>Discovering cryptographic weaknesses with Claude</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/discovering-cryptographic-weaknesses"><p>Cryptographic algorithms. The first attack significantly weakens HAWK, a digital signature scheme that was built for a future world where quantum computers are able to break existing standards. The second identifies a new way to attack round-reduced AES, the most widely used symmetric cipher. </p></a></div></div><button aria-label="Show details for Discovering cryptographic weaknesses with Claude" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="article-9e69ef36-5ba6-486c-9a25-d2a46ba5beb3"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/project-pilot"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">Project Pilot: Can AI control a drone?</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/project-pilot"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>Working with Andon Labs, we’ve developed a new series of evaluations that assess AI models’ ability to use a flying drone, culminating in a new benchmark: Drone-Bench.</p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/frontier-red-team">Frontier Red Team</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/8c0ba5e5f359c6935badec5612eb608c27958fbf.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Drone-Bench step chart: four of five tasks reach near 100% of baseline by mid-2026, while Reconstruct lags at about 47%." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/af663cbd16ca4072d246f34e2faf44236e832ef4.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Four views of the same simulated corridor: floor segmentation, edge detection, line detection, and vanishing-point estimate." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/7713a1ff0377744cfd0849e70c1c75a41ef8cd28.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Drone-Bench chart: models&#x27; average run trails their best run by about six months in progress towards baseline." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/></div></div><div class="bxgyUW_date"><time>Jul 24, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="Project Pilot: Can AI control a drone? details"><div class="bxgyUW_details-meta"><div>Jul 24, 2026</div><div><a class="wN10Da_link" href="/research/team/frontier-red-team">Frontier Red Team</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/project-pilot"><h3>Project Pilot: Can AI control a drone?</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/project-pilot"><p>Working with Andon Labs, we’ve developed a new series of evaluations that assess AI models’ ability to use a flying drone, culminating in a new benchmark: Drone-Bench.</p></a></div></div><button aria-label="Show details for Project Pilot: Can AI control a drone?" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="article-d49f3ae6-3d7a-4686-ab23-dcaeec62cc2e"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/how-canada-uses-claude"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">How Canada uses Claude: Findings from the Anthropic Economic Index</h3></span></span></a></div><div class="bxgyUW_description"></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/economics">Economics</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/976607f5799ad2170a43fb842885ad697cc4cf99.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/3649d38ac832156ac80b100cd74ddf0bdcf07b7f.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/d516d578022988a44fbb996da6021ac6b98a281e.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/f7eb168843405b5ab28dc1c7b06b70829d5ef7f3.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/32a27e954b2b7b19e394c358431c528904b3516d.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/></div></div><div class="bxgyUW_date"><time>Jul 14, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="How Canada uses Claude: Findings from the Anthropic Economic Index details"><div class="bxgyUW_details-meta"><div>Jul 14, 2026</div><div><a class="wN10Da_link" href="/research/team/economics">Economics</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/how-canada-uses-claude"><h3>How Canada uses Claude: Findings from the Anthropic Economic Index</h3></a></div></div><button aria-label="Show details for How Canada uses Claude: Findings from the Anthropic Economic Index" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="article-90c4f564-6770-4348-9dec-622fb8a76c4c"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/claude-values-models-languages"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">Claude’s values across models and languages</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/claude-values-models-languages"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>New research into how the values expressed by Claude vary across the top 20 languages on Claude.ai.</p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/societal-impacts">Societal Impacts</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/8d3b08bfc9db6428c5fc9ffa8b1f382b5f6970d1.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Four value profile cards in two pairs, one comparing the values expressed by Opus 4.6 and Opus 4.7 and the other comparing the values expressed by Claude in English and by Claude in Arabic. Each card has four arrows depicting the magnitude and direction of Claude’s lean on each of the four axes (Deference vs. Caution, Warmth vs. Rigor, Depth vs. Brevity, Candor vs. Execution). Opus 4.7 leans most strongly toward Caution and Depth, and also toward Rigor and Candor. Opus 4.6 leans toward Deference, Rigor, Brevity, and Execution. Claude in English leans toward Caution, Rigor, Depth, and Candor. Claude in Arabic leans most strongly toward Warmth, and also toward Deference,  Brevity, and Execution." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/5a5594a13a50747e92ba19586633600016a5a66a.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt=" Four dot plots, one per value axis. Each axis is a number line between two contrasting value groups, and every one of the values is positioned on the axis by how many times more it contributes to that axis than the average value contribution. Most values (roughly 250 to 280 per axis) contribute less than the average and sit in the center, while the strongest contributors are labeled at the ends. The axes and their labeled top values can be summarized as: Deference (accommodation, adaptability, respect for preferences, engagement) vs. Caution (responsible communication, responsibility, responsible guidance, harm reduction); Warmth (positive framing, warmth, positivity, encouragement) vs. Rigor (rigor, accuracy, transparency, efficiency); Depth (nuance, depth and substance, user empowerment, critical thinking) vs. Brevity (brevity, respect for preferences, compliance, accommodation); Candor (intellectual honesty, honesty, intellectual humility, transparency) vs. Execution (results orientation, optimization, action orientation, order). " width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/72c44ba8ebad6eae8eed6a2165cb233e6536e1eb.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Three value profile cards comparing Sonnet 4.6, Opus 4.6, and Opus 4.7 across the four value axes (Deference vs. Caution, Warmth vs. Rigor, Depth vs. Brevity, Candor vs. Execution). Each card shows the model’s average position in standard deviations from the mean across all conversations, and its distinctive behaviors. Sonnet 4.6 leans toward deference (0.14σ), warmth (0.17σ), and brevity (0.14σ), and its distinctive behaviors include affirming the user’s ideas and work, mirroring the user’s tone and formality, using humor and playfulness, offering comfort without judgment, and adding creative elements to what it produces. Opus 4.6 leans toward rigor (0.10σ), deference (0.09σ), and brevity (0.08σ), and its distinctive behaviors include getting straight to the point and staying within the scope of the user’s request. Opus 4.7 leans toward caution (0.24σ), and depth (0.23σ), and its distinctive behaviors include pushing back on false assumptions, flagging risks unprompted, giving candid critiques of the user’s work, explaining its reasoning, acknowledging its errors and limitations, and suggesting next steps for the user." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/></div></div><div class="bxgyUW_date"><time>Jul 13, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="Claude’s values across models and languages details"><div class="bxgyUW_details-meta"><div>Jul 13, 2026</div><div><a class="wN10Da_link" href="/research/team/societal-impacts">Societal Impacts</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/claude-values-models-languages"><h3>Claude’s values across models and languages</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/claude-values-models-languages"><p>New research into how the values expressed by Claude vary across the top 20 languages on Claude.ai.</p></a></div></div><button aria-label="Show details for Claude’s values across models and languages" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li><li class="bxgyUW_row" data-listing-row="article-ee18f994-1ff7-4275-abb6-459121e24375"><div class="_2Zn0cq_container bxgyUW_expander" data-expanded="false"><div class="bxgyUW_summary" data-peek="true"><div class="bxgyUW_title"><a class="bxgyUW_title-link" href="/research/claude-plays-robotics"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><h3 class="font-medium">Claude plays robotics</h3></span></span></a></div><div class="bxgyUW_description"><a tabindex="-1" class="bxgyUW_above-link" href="/research/claude-plays-robotics"><span class="mpFHfW_panningText bxgyUW_panning" data-progress="init"><span class="mpFHfW_nowrapText" style="transform:none"><p>In project Fetch, we examined how humans can use models to get robots to perform complex tasks. Now, we investigate many models on a large variety of different robotics tasks in simulation, to see how good models are at controlling robots themselves. </p></span></span></a></div><div class="bxgyUW_category"><a class="wN10Da_link bxgyUW_above-link bxgyUW_category-link" href="/research/team/frontier-red-team">Frontier Red Team</a></div><div class="bxgyUW_images"><div class="h86hma_thumbnailsGrid bxgyUW_thumbnails"><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/b82f549f17f19f77687b44191441c71d07e6d198.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Bar graph showing per-model embodiment score by interface. Mythos Preview scores the highest at 0.389, while Opus 4 scores the lowest at 0.115." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/30b4c51653aeadd65678de6844ac245e288c5390.gif?fm=jpeg&amp;w=48&amp;h=48&amp;fit=crop" alt="Visualization of an AI agent playing a game where it controls a set of flippers, seeking to maximize the ball’s time in the air." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/67a32f2391eda5c15032f42833f02db57c3bafad.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Six bar graphs showing different AI models&#x27; classic control performance on various tasks, both directly and via code control: pendulum balance (direct and code), hopper velocity (direct and code), and TwinFlipper air time (direct and code). " width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/aaecef16d5f8fa1375accc602429b0c561f3664c.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Three bar graphs showing models&#x27; classic control performance when training an RL policy to perform three tasks: pendulum balance, hopper velocity, and TwinFlipper air time." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/><img class="h86hma_thumbnailsGridThumbnail" src="https://assets.claude.com/c7015fa90f5134a5178d14b42372a79bf74b015b.png?w=48&amp;q=75&amp;fm=webp&amp;fit=max" alt="Three bar graphs with performance intervals showing various AI models&#x27; performance at directly controlling a robotic quadruped." width="24" height="24" loading="lazy" decoding="async" style="object-fit:cover"/></div></div><div class="bxgyUW_date"><time>Jul 9, 2026</time></div></div><div class="bxgyUW_details" aria-hidden="true" inert="" role="region" aria-label="Claude plays robotics details"><div class="bxgyUW_details-meta"><div>Jul 9, 2026</div><div><a class="wN10Da_link" href="/research/team/frontier-red-team">Frontier Red Team</a></div></div><a tabindex="-1" class="bxgyUW_details-title" href="/research/claude-plays-robotics"><h3>Claude plays robotics</h3></a><a tabindex="-1" class="bxgyUW_details-description" href="/research/claude-plays-robotics"><p>In project Fetch, we examined how humans can use models to get robots to perform complex tasks. Now, we investigate many models on a large variety of different robotics tasks in simulation, to see how good models are at controlling robots themselves. </p></a></div></div><button aria-label="Show details for Claude plays robotics" class="hN4zBq_tiny-more-button hN4zBq_state-closed bxgyUW_more-button" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></li></ul></div><div class="Q47Mqq_pagination"><button data-component="Button" data-variant="secondary" class="f9ZZrG_button f9ZZrG_corner-small f9ZZrG_variant-secondary f9ZZrG_size-small f9ZZrG_icon-format-trailing">See more<span class="f9ZZrG_icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0" aria-hidden="true"><path d="M10 3C10.2761 3.00006 10.5 3.2239 10.5 3.5V15.293L14.6465 11.1465C14.8418 10.9514 15.1583 10.9513 15.3536 11.1465C15.5487 11.3417 15.5486 11.6583 15.3536 11.8535L10.3535 16.8535C10.2598 16.9473 10.1326 17 10 17C9.90062 17 9.8042 16.9703 9.72268 16.916L9.64651 16.8535L4.6465 11.8535C4.45138 11.6582 4.45128 11.3417 4.6465 11.1465C4.84172 10.9513 5.15827 10.9514 5.35353 11.1465L9.50003 15.293V3.5C9.50003 3.22386 9.72389 3 10 3Z"></path></svg></span></button></div></div><p class="Q47Mqq_status" role="status"></p></div></section></div></section><section class="ZSMdoa_root ZSMdoa_flushTop" data-theme="ivory"><div class="kMamaW_OffRampContainer" style="visibility:hidden"><div><div class="kMamaW_OffRampHeading" style="visibility:hidden"><h2 class="tOQyXa_headline-2" data-component="Headline"><span class="kMamaW_heading-block"><span class="i2IE5q_align--center">Explore the Institute teams&#x27; work</span></span></h2></div><div class="kMamaW_spread" style="--team-count:3"><div class="kMamaW_list-item js-stagger-item" style="visibility:hidden"><div class="kMamaW_item-header"><span aria-hidden="true" class="_6xvBMG_mark kMamaW_item-image" style="mask-image:url(https://assets.claude.com/5102f55f68299284e26dabae1375deff5e538e29.png);mask-size:1800% 1700%;mask-position:0% 0%"></span><div><a href="/research/team/economics"><h3 class="tOQyXa_headline-6 kMamaW_item-title" data-component="Headline">Economics</h3></a><p class="text-caption-1 kMamaW_PostsCount">26<!-- --> posts</p></div></div><div><p class="body-2 serif">Studies and monitors the impact of AI systems on individuals, firms, and economies.</p></div></div><div class="kMamaW_list-item js-stagger-item" style="visibility:hidden"><div class="kMamaW_item-header"><span aria-hidden="true" class="_6xvBMG_mark kMamaW_item-image" style="mask-image:url(https://assets.claude.com/663211028c156bfbdf1a963f81356ffdea0bae52.png);mask-size:1800% 1700%;mask-position:0% 0%"></span><div><a href="/research/team/frontier-red-team"><h3 class="tOQyXa_headline-6 kMamaW_item-title" data-component="Headline">Frontier Red Team</h3></a><p class="text-caption-1 kMamaW_PostsCount">38<!-- --> posts</p></div></div><div><p class="body-2 serif">Stress-tests AI systems to understand the full extent of their current capabilities and anticipate what comes next.</p></div></div><div class="kMamaW_list-item js-stagger-item" style="visibility:hidden"><div class="kMamaW_item-header"><span aria-hidden="true" class="_6xvBMG_mark kMamaW_item-image" style="mask-image:url(https://assets.claude.com/06e1cdaa25af79cda50a3b7fc8f73acfead50b97.png);mask-size:1800% 1700%;mask-position:0% 0%"></span><div><a href="/research/team/societal-impacts"><h3 class="tOQyXa_headline-6 kMamaW_item-title" data-component="Headline">Societal Impacts</h3></a><p class="text-caption-1 kMamaW_PostsCount">25<!-- --> posts</p></div></div><div><p class="body-2 serif">Studies how AI affects people, both individually and collectively.</p></div></div></div></div></div></section></article><!--$--><!--/$--></main><footer class="theme-slate dU5k9q_footer"><span hidden=""></span><div data-clip-path-nav="true" class="WXQxba_overlayNav theme-slate"></div><span aria-hidden="true" class="dU5k9q_underNavEdge"></span><div class="dU5k9q_footerLayout"><div class="dU5k9q_logo"><a aria-label="Anthropic home" href="/"><svg width="35" height="24" viewBox="0 0 35 24" fill="none" class="dU5k9q_logoAbbreviated"><path d="M-0.00143743 24L9.56656 -1.90735e-06H15.0546L24.6226 24H19.2626L17.3106 18.96H7.29456L5.34256 24H-0.00143743ZM9.02256 14.496H15.5826L12.3026 6.064L9.02256 14.496ZM29.0386 24L19.4706 -1.90735e-06H24.7186L34.2866 24H29.0386Z" fill="currentColor"></path></svg><svg class="dU5k9q_logoWordmark" width="570" height="64" viewBox="0 0 570 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Anthropic"><path d="M139.492 12.9945H160.265V62.9392H173.525V12.9945H194.298V1.06077H139.492V12.9945Z" fill="currentColor"></path><path d="M116.066 44.3757L88.221 1.06077H73.1934V62.9392H86.011V19.6243L113.856 62.9392H128.884V1.06077H116.066V44.3757Z" fill="currentColor"></path><path d="M247.337 25.7238H218.166V1.06077H204.906V62.9392H218.166V37.6575H247.337V62.9392H260.597V1.06077H247.337V25.7238Z" fill="currentColor"></path><path d="M24.663 1.06077L0 62.9392H13.7901L18.834 49.9447H44.6365L49.6796 62.9392H63.4696L38.8066 1.06077H24.663ZM23.2946 38.453L31.7348 16.7072L40.175 38.453H23.2946Z" fill="currentColor"></path><path d="M370.475 0C352.619 0 339.978 13.2597 339.978 32.0884C339.978 50.7403 352.619 64 370.475 64C388.243 64 400.796 50.7403 400.796 32.0884C400.796 13.2597 388.243 0 370.475 0ZM370.475 51.6243C360.044 51.6243 353.68 44.1989 353.68 32.0884C353.68 19.8011 360.044 12.3757 370.475 12.3757C380.818 12.3757 387.094 19.8011 387.094 32.0884C387.094 44.1989 380.818 51.6243 370.475 51.6243Z" fill="currentColor"></path><path d="