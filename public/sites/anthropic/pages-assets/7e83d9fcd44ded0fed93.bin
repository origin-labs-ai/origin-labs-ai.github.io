ult\"]\n72:I[27201,[\"$6\"],\"IconMark\"]\nb:[\"$\",\"article\",null,{\"className\":\"bg-default\",\"data-nav-surface\":\"$undefined\",\"data-page-surface\":\"$undefined\",\"children\":[[\"$\",\"$L6e\",null,{\"initial\":\"ivory-light\"}],[[\"$\",\"$1\",\"0\",{\"children\":[null,[\"$\",\"section\",null,{\"className\":\"ZSMdoa_root theme-ivory theme-surface ZSMdoa_flushBottom\",\"id\":\"$undefined\",\"ref\":\"$undefined\",\"style\":\"$undefined\",\"data-theme\":\"ivory\",\"data-nav-surface\":\"ivory-light\",\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"className\":\"_4T7hfG_wrapper\",\"data-theme\":\"light\",\"children\":[[\"$\",\"div\",null,{\"className\":\"_4T7hfG_header-wrapper\",\"children\":[null,[\"$\",\"h1\",null,{\"className\":\"text-headline-3 _4T7hfG_headline\",\"ref\":\"$undefined\",\"children\":\"Anthropic’s Responsible Scaling Policy\"}],[\"$\",\"p\",null,{\"className\":\"tOQyXa_body-1--serif _4T7hfG_summary\",\"data-component\":\"Body\",\"children\":\"Anticipating and securing against emerging threats that accompany increasingly powerful models\"}]]}],\"$undefined\",[\"$\",\"p\",null,{\"className\":\"tOQyXa_body-3 _4T7hfG_date\",\"data-component\":\"Body\",\"children\":[\"Last updated \",[\"$\",\"time\",null,{\"dateTime\":\"2026-08-14\",\"children\":\"Aug 14, 2026\"}]]}],[\"$\",\"div\",null,{\"className\":\"_4T7hfG_links\",\"children\":[[\"$\",\"$L6f\",\"0\",{\"aria-label\":\"Read Anthropic's Responsible Scaling Policy\",\"className\":\"text-body-3 _4T7hfG_link\",\"link\":{\"_type\":\"link\",\"text\":\"Read Anthropic's Responsible Scaling Policy\",\"url\":\"https://www-cdn.anthropic.com/files/4zrzovbb/website/0bacdc8440ea96e62a8766d99ebe1d4eea6d5f3a.pdf\",\"page\":null,\"modalId\":null,\"fileAsset\":null,\"openInNewTab\":null},\"children\":[[\"$\",\"span\",null,{\"children\":\"Read Anthropic's Responsible Scaling Policy\"}],[\"$\",\"$L70\",null,{\"fill\":\"currentColor\"}]]}]]}]]}]]}]]}],[\"$\",\"$1\",\"1\",{\"children\":[null,[\"$\",\"section\",null,{\"className\":\"ZSMdoa_root theme-ivory theme-surface\",\"id\":\"$undefined\",\"ref\":\"$undefined\",\"style\":\"$undefined\",\"data-theme\":\"ivory\",\"data-nav-surface\":\"ivory-light\",\"children\":[\"$undefined\",[\"$\",\"$L71\",null,{\"body\":[{\"_key\":\"af57d4646208\",\"_type\":\"block\",\"children\":[{\"_key\":\"7a5a3e9f47fb\",\"_type\":\"span\",\"marks\":[],\"text\":\"As frontier AI models advance, we believe they will bring about transformative benefits for our society and economy. AI could accelerate scientific discoveries, revolutionize healthcare, enhance our education system, and create entirely new domains for human creativity and innovation. Frontier AI models also, however, present new challenges and risks that warrant careful study and effective safeguards. \"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c7cdd32d82de\",\"_type\":\"block\",\"children\":[{\"_key\":\"3e24924943b9\",\"_type\":\"span\",\"marks\":[],\"text\":\"In September 2023, we released the first version of our Responsible Scaling Policy (RSP). We believe that risk governance in this rapidly evolving domain should be proportional, iterative, and exportable. In that spirit, we have continued to refine the RSP over time and will use this page to inform the public of any developments.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8882e42975ee\",\"_type\":\"block\",\"children\":[{\"_key\":\"e9eb3fe9ec700\",\"_type\":\"span\",\"marks\":[],\"text\":\"Current and Prior Versions\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"f6c1018eabce\",\"_type\":\"toutCallout\",\"cta\":{\"_type\":\"link\",\"text\":\"See the pdf\",\"url\":\"https://cdn.sanity.io/files/4zrzovbb/website/0bacdc8440ea96e62a8766d99ebe1d4eea6d5f3a.pdf\",\"page\":null,\"modalId\":null,\"fileAsset\":null,\"openInNewTab\":null},\"illustration\":{\"backgroundColor\":\"cactus\",\"illustration\":{\"_type\":\"illustration\",\"description\":\"Spiral-bound notebook with page\",\"image\":{\"description\":null,\"height\":1000,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/790fc54de4c3ffa06f5909e3db2316e6b211246b.svg\",\"width\":1000}}},\"summary\":\"Version 2.2 (effective May 14, 2025)\",\"title\":\"Read the current version of the RSP\",\"markDefs\":null},{\"_key\":\"371dd71dc4bd\",\"_type\":\"toutCallout\",\"cta\":{\"_type\":\"link\",\"text\":\"See the PDF\",\"url\":null,\"page\":null,\"modalId\":null,\"fileAsset\":{\"url\":\"https://assets.claude.com/b7a5629e40b391b2adfb4cc8c0888ac9d6bfddf6.pdf\",\"originalFilename\":\"RSP Noncompliance Reporting and Anti-Retaliation Policy.pdf\"},\"openInNewTab\":null},\"illustration\":{\"backgroundColor\":\"cactus\",\"illustration\":{\"_type\":\"illustration\",\"description\":\"Large spiral-bound notebook with detailed graphic representation of pages and binding\",\"image\":{\"description\":null,\"height\":1000,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/b123ea797eafd3c7d8a74263d85075fb6a56d82a.svg\",\"width\":1000}}},\"title\":\"RSP Noncompliance Reporting and Anti-Retaliation Policy\",\"markDefs\":null},{\"_key\":\"69154261c05f\",\"_type\":\"block\",\"children\":[{\"_key\":\"c97fdc580b4b\",\"_type\":\"span\",\"marks\":[\"b29e9c0d7309\"],\"text\":\"Version 3.4\"},{\"_key\":\"da774f932937\",\"_type\":\"span\",\"marks\":[],\"text\":\" and \"},{\"_key\":\"814e494af125\",\"_type\":\"span\",\"marks\":[\"9b763a99d8bc\"],\"text\":\"redline\"},{\"_key\":\"c32abcde418e\",\"_type\":\"span\",\"marks\":[],\"text\":\" (effective July 8, 2026)\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"b29e9c0d7309\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www-cdn.anthropic.com/files/4zrzovbb/website/0bacdc8440ea96e62a8766d99ebe1d4eea6d5f3a.pdf\"},{\"_key\":\"9b763a99d8bc\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www-cdn.anthropic.com/files/4zrzovbb/website/fbfdce5e4e825a3e089085205a842a9ae8ffac99.pdf\"}],\"style\":\"normal\"},{\"_key\":\"e508d61f22a6\",\"_type\":\"block\",\"children\":[{\"_key\":\"f94645686293\",\"_type\":\"span\",\"marks\":[\"18a734ab6652\"],\"text\":\"Version 3.3\"},{\"_key\":\"0f6f2b7b37fa\",\"_type\":\"span\",\"marks\":[],\"text\":\" and \"},{\"_key\":\"e105d4e0cb0f\",\"_type\":\"span\",\"marks\":[\"5d221c4dbbba\"],\"text\":\"redline\"},{\"_key\":\"68b38055a1c6\",\"_type\":\"span\",\"marks\":[],\"text\":\" (effective May 26, 2026)\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"5d221c4dbbba\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www-cdn.anthropic.com/files/4zrzovbb/website/dd0ec579bee2cd144069c478ede3e35ea080ad02.pdf\"},{\"_key\":\"18a734ab6652\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www-cdn.anthropic.com/files/4zrzovbb/website/c11e84981d0a7281a1b229f3fa6af0da66eaf43f.pdf\"}],\"style\":\"normal\"},{\"_key\":\"fcf58a088fda\",\"_type\":\"block\",\"children\":[{\"_key\":\"423755d0dfab\",\"_type\":\"span\",\"marks\":[\"27e93e6fe7de\"],\"text\":\"Version 3.2\"},{\"_key\":\"8016e356736c\",\"_type\":\"span\",\"marks\":[],\"text\":\" and \"},{\"_key\":\"45a887e06883\",\"_type\":\"span\",\"marks\":[\"91bce585a952\"],\"text\":\"redline\"},{\"_key\":\"c952cf18f476\",\"_type\":\"span\",\"marks\":[],\"text\":\" (effective April 29, 2026)\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"27e93e6fe7de\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www-cdn.anthropic.com/files/4zrzovbb/website/28c6241900d90410628a8a2003a5572faae4365a.pdf\"},{\"_key\":\"91bce585a952\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www-cdn.anthropic.com/files/4zrzovbb/website/7c534a9e7a82d4411dd568d85ffbcd14ac243a62.pdf\"}],\"style\":\"normal\"},{\"_key\":\"fb65d37460f1\",\"_type\":\"block\",\"children\":[{\"_key\":\"423755d0dfab\",\"_type\":\"span\",\"marks\":[\"ed2ac9d69c0a\"],\"text\":\"Version 3.1\"},{\"_key\":\"ce6c70d36d65\",\"_type\":\"span\",\"marks\":[],\"text\":\"  and \"},{\"_key\":\"c34e55aa2639\",\"_type\":\"span\",\"marks\":[\"1baf6e903f64\"],\"text\":\"redline\"},{\"_key\":\"1f5c0bfcc26b\",\"_type\":\"span\",\"marks\":[],\"text\":\" (effective April 2, 2026)\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"ed2ac9d69c0a\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www-cdn.anthropic.com/files/4zrzovbb/website/bf04581e4f329735fd90634f6a1962c13c0bd351.pdf\"},{\"_key\":\"1baf6e903f64\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www-cdn.anthropic.com/files/4zrzovbb/website/64cb0ac5eb0f8030187131f490827323e3d53308.pdf\"}],\"style\":\"normal\"},{\"_key\":\"76b3bc01b2d4\",\"_type\":\"block\",\"children\":[{\"_key\":\"68a8cd01ccad\",\"_type\":\"span\",\"marks\":[\"abdab6f2634d\"],\"text\":\"Version 3.0\"},{\"_key\":\"426be9cf5b82\",\"_type\":\"span\",\"marks\":[],\"text\":\" (effective February 24, 2026)\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"abdab6f2634d\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://anthropic.com/responsible-scaling-policy/rsp-v3-0\"}],\"style\":\"normal\"},{\"_key\":\"7d68fb198182\",\"_type\":\"block\",\"children\":[{\"_key\":\"3035d62342360\",\"_type\":\"span\",\"marks\":[\"e8ae27915395\"],\"text\":\"Version 2.2\"},{\"_key\":\"bb8cfab8e0c3\",\"_type\":\"span\",\"marks\":[],\"text\":\" and \"},{\"_key\":\"f698a4284f6e\",\"_type\":\"span\",\"marks\":[\"72e033b20ddf\"],\"text\":\"redline\"},{\"_key\":\"cd4a3427da30\",\"_type\":\"span\",\"marks\":[],\"text\":\" (effective May 14, 2025)\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"e8ae27915395\",\"_type\":\"link\",\"href\":\"https://www-cdn.anthropic.com/872c653b2d0501d6ab44cf87f43e1dc4853e4d37.pdf\"},{\"_key\":\"72e033b20ddf\",\"_type\":\"link\",\"href\":\"https://www-cdn.anthropic.com/files/4zrzovbb/website/ee775bdcf76b2e2af32d658c934f460383d07c46.pdf\"}],\"style\":\"normal\"},{\"_key\":\"9abfafd9466a\",\"_type\":\"block\",\"children\":[{\"_key\":\"190dafdabf48\",\"_type\":\"span\",\"marks\":[\"4c8e4f4a78b0\"],\"text\":\"Version 2.1\"},{\"_key\":\"d666b3cef10f\",\"_type\":\"span\",\"marks\":[],\"text\":\" (effective March 31, 2025)\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"4c8e4f4a78b0\",\"_type\":\"link\",\"href\":\"https://www-cdn.anthropic.com/17310f6d70ae5627f55313ed067afc1a762a4068.pdf\"}],\"style\":\"normal\"},{\"_key\":\"b72d01de4332\",\"_type\":\"block\",\"children\":[{\"_key\":\"3ea1a6c059a4\",\"_type\":\"span\",\"marks\":[\"5bb99b3b3543\"],\"text\":\"Version 2.0\"},{\"_key\":\"1023b74a2bd0\",\"_type\":\"span\",\"marks\":[],\"text\":\" (effective October 15, 2024)\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"5bb99b3b3543\",\"_type\":\"link\",\"href\":\"https://www-cdn.anthropic.com/616dee633636e5bd309cb73aed8622e80fe47839.pdf\"}],\"style\":\"normal\"},{\"_key\":\"91742064ad87\",\"_type\":\"block\",\"children\":[{\"_key\":\"fb068bb287e60\",\"_type\":\"span\",\"marks\":[\"664409951e1e\"],\"text\":\"Version 1.0\"},{\"_key\":\"fb068bb287e61\",\"_type\":\"span\",\"marks\":[],\"text\":\" (effective September 19, 2023)\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"664409951e1e\",\"_type\":\"link\",\"href\":\"https://www-cdn.anthropic.com/1adf000c8f675958c2ee23805d91aaade1cd4613/responsible-scaling-policy.pdf\"}],\"style\":\"normal\"},{\"_key\":\"500183267fce\",\"_type\":\"block\",\"children\":[{\"_key\":\"4f06a190e60f\",\"_type\":\"span\",\"marks\":[],\"text\":\"Risk Reports\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"ebe0fef07656\",\"_type\":\"block\",\"children\":[{\"_key\":\"863e829658e0\",\"_type\":\"span\",\"marks\":[\"9472e2e48ca0\"],\"text\":\"Redacted Risk Report August 2026\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"9472e2e48ca0\",\"_type\":\"link\",\"blank\":true,\"href\":\"https://anthropic.com/aug-2026-risk-report\"}],\"style\":\"normal\"},{\"_key\":\"7c1d08455e7d\",\"_type\":\"block\",\"children\":[{\"_key\":\"863e829658e0\",\"_type\":\"span\",\"marks\":[\"f6f7bc19171b\"],\"text\":\"Redacted Risk Report February 2026\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"f6f7bc19171b\",\"_type\":\"link\",\"blank\":true,\"href\":\"https://anthropic.com/feb-2026-risk-report\"}],\"style\":\"normal\"},{\"_key\":\"98d44f454c93\",\"_type\":\"block\",\"children\":[{\"_key\":\"cc187cca4d72\",\"_type\":\"span\",\"marks\":[],\"text\":\"August 14, 2026\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"a0a62ec236c2\",\"_type\":\"block\",\"children\":[{\"_key\":\"6fe74d663236\",\"_type\":\"span\",\"marks\":[],\"text\":\"We shared our \"},{\"_key\":\"ca3916c1d183\",\"_type\":\"span\",\"marks\":[\"f3377dfefbce\"],\"text\":\"August 2026 Risk Report\"},{\"_key\":\"44851f96697d\",\"_type\":\"span\",\"marks\":[],\"text\":\". Our Risk Reports aim to provide a direct, candid, and informative description of how we see the risks of our\\nsystems and our state of preparedness for them (particularly the catastrophic risks addressed in our Responsible Scaling Policy). It covers the risks of Anthropic's models and actions between our previous February 2026 risk report and the report's coverage date of July 15, as well as our mitigations for those risks and our forward-looking plans in each category.\"}],\"markDefs\":[{\"_key\":\"f3377dfefbce\",\"_type\":\"link\",\"blank\":true,\"href\":\"https://www.anthropic.com/aug-2026-risk-report\"}],\"style\":\"normal\"},{\"_key\":\"d286906323e3\",\"_type\":\"block\",\"children\":[{\"_key\":\"22d61ffb305f\",\"_type\":\"span\",\"marks\":[],\"text\":\"July 8, 2026\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"de0b6281a6c6\",\"_type\":\"block\",\"children\":[{\"_key\":\"f479f16415f8\",\"_type\":\"span\",\"marks\":[],\"text\":\"This version 3.4 update does the following: 1) revises our threshold for automated R\u0026D to better track the threat model of concern; 2) revises our requirement to share fully unredacted Risk Reports internally (we no longer require sharing with all regular-clearance Anthropic staff, and instead require sharing with at least 200 Anthropic employees); 3) allows Risk Reports to analyze risks as of a given coverage date, rather than necessarily as of the date of publication (to avoid requiring rushed analysis of particularly recent changes); 4) requires public Risk Reports to contain indications of where material was redacted; 5) clarifies that external review of our Risk Reports can involve multiple external reviewers reviewing different unredacted sections of the Risk Report, so long as all parts of the unredacted report are evaluated by at least one external reviewer.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e1e010aaf1b3\",\"_type\":\"block\",\"children\":[{\"_key\":\"cc187cca4d72\",\"_type\":\"span\",\"marks\":[],\"text\":\"May 26, 2026\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"79d6d7bae28e\",\"_type\":\"block\",\"children\":[{\"_key\":\"cc187cca4d72\",\"_type\":\"span\",\"marks\":[],\"text\":\"This version 3.3 update does the following: 1) revises our threshold for novel chemical/biological weapons production to better track the threat model of concern; 2) refines our approach to off-cycle updates regarding the risks of individual models; and 3) makes minor terminology changes.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"24c0d784504d\",\"_type\":\"block\",\"children\":[{\"_key\":\"04c3c017e93e\",\"_type\":\"span\",\"marks\":[],\"text\":\"April 29, 2026\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"3d8f2225eef2\",\"_type\":\"block\",\"children\":[{\"_key\":\"5e4df2d6a21e\",\"_type\":\"span\",\"marks\":[],\"text\":\"Version 3.2 of our RSP authorizes the LTBT to request external review of Risk Reports, gives the LTBT the power to approve our selection of external reviewers, and formalizes a requirement that we provide the LTBT with regular briefings.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e004784fb4fa\",\"_type\":\"block\",\"children\":[{\"_key\":\"4c03ee9ce74e\",\"_type\":\"span\",\"marks\":[],\"text\":\"April 2, 2026\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"6954829c733e\",\"_type\":\"block\",\"children\":[{\"_key\":\"f25b5b10bbeb\",\"_type\":\"span\",\"marks\":[],\"text\":\"We are updating our \"},{\"_key\":\"406a53392dc6\",\"_type\":\"span\",\"marks\":[\"c49f12509532\"],\"text\":\"Frontier Safety Roadmap\"},{\"_key\":\"8670255e652b\",\"_type\":\"span\",\"marks\":[],\"text\":\", because we have achieved two of the goals we had set for our AI safety work. We have now launched the planned moonshot R\u0026D projects, and we have replaced the goal of launching them with more detailed goals for ongoing projects. We have also completed the goal of creating a “comprehensive internal report to identify how our Safeguards could be improved by updating our data retention policies”.\"}],\"markDefs\":[{\"_key\":\"c49f12509532\",\"_type\":\"link\",\"href\":\"http://anthropic.com/responsible-scaling-policy/roadmap\"}],\"style\":\"normal\"},{\"_key\":\"9c56a60ab12d\",\"_type\":\"block\",\"children\":[{\"_key\":\"fe8a9411810e\",\"_type\":\"span\",\"marks\":[],\"text\":\"We have also made two minor updates to the text of the Responsible Scaling Policy, updating it to version 3.1. After we released the v3 update, readers noted two areas on which our language could be clarified. We have therefore made the following updates, neither of which significantly change the substance of the policy:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6cb5b2fe591a\",\"_type\":\"block\",\"children\":[{\"_key\":\"663751c4d92e\",\"_type\":\"span\",\"marks\":[],\"text\":\"We now include a clearer definition of the AI R\u0026D capability threshold. For example, in v3, our language around AI doubling the rate of progress (“compress two years of 2018 – 2024 AI progress into a single year”) could have been read as AI “doubling the rate of progress in aggregate AI capabilities”, or “doubling the productivity of researchers”. In v3.1, we are clear that we mean the former and not the latter.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c370a37af5c0\",\"_type\":\"block\",\"children\":[{\"_key\":\"83d9c77870d7\",\"_type\":\"span\",\"marks\":[],\"text\":\"We now clarify that, even if not required by the RSP, we remain free to take measures such as pausing the development of our AI systems in any circumstances in which we deem them appropriate. This was true of RSP v3, but it is stated more clearly in the v3.1 update.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5c8b4c12bf8e\",\"_type\":\"block\",\"children\":[{\"_key\":\"9cd7d21711b4\",\"_type\":\"span\",\"marks\":[],\"text\":\"There are also a number of smaller edits for style and clarity elsewhere in the policy.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f55efb7cae32\",\"_type\":\"block\",\"children\":[{\"_key\":\"8d4545739533\",\"_type\":\"span\",\"marks\":[],\"text\":\"As we noted in the \"},{\"_key\":\"1e8071598f67\",\"_type\":\"span\",\"marks\":[\"e714222673a1\"],\"text\":\"post announcing RSP v3\"},{\"_key\":\"230bc8d56f7b\",\"_type\":\"span\",\"marks\":[],\"text\":\", the policy is a living document. As we learn more about its operation in the real world, we expect to make further changes, all of which will be logged both on this page and in a changelog in the policy document itself.\"}],\"markDefs\":[{\"_key\":\"e714222673a1\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/news/responsible-scaling-policy-v3\"}],\"style\":\"normal\"},{\"_key\":\"f999e4b38513\",\"_type\":\"block\",\"children\":[{\"_key\":\"3c838e386e8a\",\"_type\":\"span\",\"marks\":[],\"text\":\"March 24, 2026\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"2a43a5b4a759\",\"_type\":\"block\",\"children\":[{\"_key\":\"b1276e69df04\",\"_type\":\"span\",\"marks\":[],\"text\":\"We posted an update to our RSP Noncompliance Reporting and Anti-Retaliation Policy, which we released internally in February 2026. It expands reporting channels, introduces a pathway for employees to make informal inquiries about potential RSP violations, and aligns with RSP Version 3.0. The policy document can be found at the link above.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3d62cdb66c2a\",\"_type\":\"block\",\"children\":[{\"_key\":\"18374f93d512\",\"_type\":\"span\",\"marks\":[],\"text\":\"February 24, 2026\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"a4b41338424f\",\"_type\":\"block\",\"children\":[{\"_key\":\"2e4af4ecf8a9\",\"_type\":\"span\",\"marks\":[],\"text\":\"Version 3.0 is a comprehensive rewrite of the RSP. The reasoning behind the rewrite can be found \"},{\"_key\":\"575435199324\",\"_type\":\"span\",\"marks\":[\"53aaf2b063e4\"],\"text\":\"here\"},{\"_key\":\"81af4dac50a8\",\"_type\":\"span\",\"marks\":[],\"text\":\".\\n\\nThis new version of the RSP involves the publication of \"},{\"_key\":\"36bf8d839189\",\"_type\":\"span\",\"marks\":[\"cd21fe135838\"],\"text\":\"Frontier Safety Roadmaps\"},{\"_key\":\"44f7cec0bf34\",\"_type\":\"span\",\"marks\":[],\"text\":\" with detailed safety goals, and \"},{\"_key\":\"c8334865e760\",\"_type\":\"span\",\"marks\":[\"47169c4864f4\"],\"text\":\"Risk Reports\"},{\"_key\":\"cbd1e5a9dd4a\",\"_type\":\"span\",\"marks\":[],\"text\":\" that quantify risk across all our deployed models.\"}],\"markDefs\":[{\"_key\":\"53aaf2b063e4\",\"_type\":\"link\",\"href\":\"https://anthropic.com/news/responsible-scaling-policy-v3\"},{\"_key\":\"cd21fe135838\",\"_type\":\"link\",\"href\":\"https://anthropic.com/responsible-scaling-policy/roadmap\"},{\"_key\":\"47169c4864f4\",\"_type\":\"link\",\"href\":\"https://anthropic.com/feb-2026-risk-report\"}],\"style\":\"normal\"},{\"_key\":\"8ac5cd8a8e17\",\"_type\":\"block\",\"children\":[{\"_key\":\"ff09f856470f\",\"_type\":\"span\",\"marks\":[],\"text\":\"February 10, 2026\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"d26cdc7a762d\",\"_type\":\"block\",\"children\":[{\"_key\":\"b8cb430739bc\",\"_type\":\"span\",\"marks\":[],\"text\":\"Our RSP requires that once models cross the AI R\u0026D-4 capability threshold, we develop an affirmative case identifying the most immediate and relevant misalignment risks from models pursuing misaligned goals and explaining how we have mitigated them. Our determination is that Claude Opus 4.6 does not cross this threshold.\\n\\nHowever, as we noted in the \"},{\"_key\":\"9efc8e0e4388\",\"_type\":\"span\",\"marks\":[\"37af23f3f4be\"],\"text\":\"Claude Opus 4.5 System Card\"},{\"_key\":\"678168dfbb53\",\"_type\":\"span\",\"marks\":[],\"text\":\" and the \"},{\"_key\":\"2f93bce5403b\",\"_type\":\"span\",\"marks\":[\"420be1147a6b\"],\"text\":\"Claude Opus 4.6 System Card\"},{\"_key\":\"9e15860ddb2f\",\"_type\":\"span\",\"marks\":[],\"text\":\", confidently ruling out this threshold is becoming increasingly difficult, and doing so requires assessments that are more subjective than we would like. Rather than rely solely on those assessments, we committed during the launch of Claude Opus 4.5 to writing sabotage risk reports for all future frontier models clearly exceeding Opus 4.5's capabilities. Today, consistent with that commitment, we are publishing the external-facing version of the Sabotage Risk Report we prepared for Claude Opus 4.6.\"}],\"markDefs\":[{\"_key\":\"420be1147a6b\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://anthropic.com/claude-opus-4-6-system-card\"},{\"_key\":\"37af23f3f4be\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://anthropic.com/claude-opus-4-5-system-card\"}],\"style\":\"normal\"},{\"_key\":\"4a6227e01b57\",\"_type\":\"block\",\"children\":[{\"_key\":\"5fe3c61ccc4c\",\"_type\":\"span\",\"marks\":[\"efbcac302535\"],\"text\":\"Read the Sabotage Risk Report\"}],\"markDefs\":[{\"_key\":\"efbcac302535\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://anthropic.com/claude-opus-4-6-risk-report\"}],\"style\":\"normal\"},{\"_key\":\"465fe0596754\",\"_type\":\"block\",\"children\":[{\"_key\":\"4f87ea045282\",\"_type\":\"span\",\"marks\":[],\"text\":\"May 14, 2025\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"d040e72caa6c\",\"_type\":\"block\",\"children\":[{\"_key\":\"024a01c402de\",\"_type\":\"span\",\"marks\":[],\"text\":\"Version 2.2 implements a minor revision, amending a footnote to exclude both sophisticated insiders and state-compromised insiders from the scope of the ASL-3 Security Standard. Previously, only “highly sophisticated state-compromised insiders” were explicitly excluded. For more details, please see the changelog appended to the policy.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"00c4aded409f\",\"_type\":\"block\",\"children\":[{\"_key\":\"d1d7679f851c\",\"_type\":\"span\",\"marks\":[],\"text\":\"March 31, 2025\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"f314511fe218\",\"_type\":\"block\",\"children\":[{\"_key\":\"6f6620260ae70\",\"_type\":\"span\",\"marks\":[],\"text\":\"Version 2.1 reflected minor updates clarifying which Capability Thresholds would require enhanced safeguards beyond our current ASL-3 standards. First, we have added a new capability threshold related to CBRN development, which defines capabilities that could substantially uplift the development capabilities of moderately resourced state programs. Second, we have disaggregated our existing AI R\u0026D capability thresholds, separating them into two distinct levels (the ability to fully automate entry-level AI research work, and the ability to cause dramatic acceleration in the rate of effective scaling) and have provided additional detail on the corresponding Required Safeguards. Finally, we have adopted a general commitment to reevaluate our Capability Thresholds whenever we upgrade to a new set of Required Safeguards.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"85380a340131\",\"_type\":\"block\",\"children\":[{\"_key\":\"a6da4f441549\",\"_type\":\"span\",\"marks\":[],\"text\":\"October 15, 2024\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"9c138c352ddd\",\"_type\":\"block\",\"children\":[{\"_key\":\"aee57682240a\",\"_type\":\"span\",\"marks\":[],\"text\":\"Planned ASL-3 Safeguards\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"70aa9c20b80e\",\"_type\":\"block\",\"children\":[{\"_key\":\"14db48cc65ae0\",\"_type\":\"span\",\"marks\":[],\"text\":\"In our Responsible Scaling Policy, reaching certain Capability Thresholds requires us to upgrade our safeguards to the ASL-3 Security Standard or the ASL-3 Deployment Standard. Our RSP contains requirements for meeting these standards, and also says we will publicly release key information related to the evaluation and deployment of our models (not including sensitive details). Below, we give non-binding descriptions of our future ASL-3 safeguard plans. We hope sharing these plans will offer useful insights for organizations working on similar systems, and contribute to conversations about emerging best practices.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5afffeb610d0\",\"_type\":\"block\",\"children\":[{\"_key\":\"317c7524b000\",\"_type\":\"span\",\"marks\":[],\"text\":\"Deployment Safeguards\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"13dca2b42a94\",\"_type\":\"block\",\"children\":[{\"_key\":\"89a35fc74a890\",\"_type\":\"span\",\"marks\":[],\"text\":\"Our teams are currently developing and building ASL-3 Deployment Safeguards to mitigate catastrophic risks associated with more advanced models. These safeguards are being designed to prevent misuse of capabilities that could enable severe harm, particularly in relation to chemical, biological, radiological, and nuclear (CBRN) technologies. This overview outlines the planned technical architecture and design of these safeguards, with a focus on the technical aspects and safety considerations of this developing system.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"bf0bd93cbc70\",\"_type\":\"block\",\"children\":[{\"_key\":\"861eb53b63610\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Multi-layered defense-in-depth architecture\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ccd6c1f165a2\",\"_type\":\"block\",\"children\":[{\"_key\":\"65f13c1ae1c90\",\"_type\":\"span\",\"marks\":[],\"text\":\"Our deployment safeguards will employ a defense-in-depth strategy with four main layers, each designed to catch potential misuse that might pass through previous barriers. The four layers will be:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e4ec1cfca8c4\",\"_type\":\"block\",\"children\":[{\"_key\":\"11efba3bda030\",\"_type\":\"span\",\"marks\":[],\"text\":\"Access controls to tailor safeguards to the deployment context and group of expected users.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6e959dc94be0\",\"_type\":\"block\",\"children\":[{\"_key\":\"6e17a916b5f80\",\"_type\":\"span\",\"marks\":[],\"text\":\"Real-time prompt and completion classifiers and completion interventions for immediate online filtering.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2cf406619c03\",\"_type\":\"block\",\"children\":[{\"_key\":\"0e947ed21fcc0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Asynchronous monitoring classifiers for a more detailed analysis of the completions for threats.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"507cb1ce6b8d\",\"_type\":\"block\",\"children\":[{\"_key\":\"dc2435d9b7b00\",\"_type\":\"span\",\"marks\":[],\"text\":\"Post-hoc jailbreak detection with rapid response procedures to quickly address any threats.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8e98a1f171b8\",\"_type\":\"block\",\"children\":[{\"_key\":\"a39f20d9aca70\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Access controls\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"03d2390191f7\",\"_type\":\"block\",\"children\":[{\"_key\":\"35f054ac17760\",\"_type\":\"span\",\"marks\":[],\"text\":\"General access to AI models (e.g. Claude.ai and our API) will use our standard safeguards. However, we recognize that in certain cases, such as safety testing, it may be necessary to tailor these safeguards. To balance security concerns with the need for flexibility, we are developing a tiered access system that allows for nuanced control over safeguard adjustments. At the core of this system will be an enhanced due diligence process under which we will evaluate potential partners based on two key criteria: their overall trustworthiness and the beneficial nature of their use-case. This vetting process will act as a compensating control when a partner’s use-case requires adjusting the standard deployment of our safeguards.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ed960352e62f\",\"_type\":\"block\",\"children\":[{\"_key\":\"1512a787b2da0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Real-time prompt and completion classifiers\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6b49dcdd8468\",\"_type\":\"block\",\"children\":[{\"_key\":\"4fa5855af3860\",\"_type\":\"span\",\"marks\":[],\"text\":\"Our online prompt and completion classifiers are machine learning models that will analyze user inputs and AI-generated outputs in real-time. The completion classifiers will use a streaming implementation, whereby the classifier updates the score as tokens are generated, rather than waiting for the entire completion. This approach aims to minimize delays to the end user while maintaining the safety standards.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"612bfcf5a58c\",\"_type\":\"block\",\"children\":[{\"_key\":\"bc28f159ef600\",\"_type\":\"span\",\"marks\":[],\"text\":\"In order to stay up to date on newly discovered harmful patterns, jailbreaks, and obfuscation techniques, the classifiers will be regularly updated using data from other elements of our deployment safeguards including our asynchronous monitoring system and insights from our incident response protocol, bug bounty program, and internal and external red-teaming efforts.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2538e7ecb699\",\"_type\":\"block\",\"children\":[{\"_key\":\"0de2a73b36380\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Asynchronous monitoring classifiers\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c85dd83f299c\",\"_type\":\"block\",\"children\":[{\"_key\":\"669125171ad80\",\"_type\":\"span\",\"marks\":[],\"text\":\"Asynchronous classification will allow us to perform computationally intensive evaluations to provide a deeper level of scrutiny than the real-time classifiers alone, without impacting user-facing latency.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"94d8e5bf0ddc\",\"_type\":\"block\",\"children\":[{\"_key\":\"4e3c6bab28c40\",\"_type\":\"span\",\"marks\":[],\"text\":\"To allow for flexible monitoring processes, our monitoring system will be organized like a flowchart. One implementation could start with simpler AI models like Claude 3 Haiku to quickly and economically scan content and trigger a detailed analysis with an advanced model like Claude 3.5 Sonnet if anything suspicious is found. This setup will be designed to be adapted and updated easily to respond to new threats by adding new AI models or analysis steps.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a805a7610432\",\"_type\":\"block\",\"children\":[{\"_key\":\"f2f9ee3a4cce0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Post-hoc jailbreak detection\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2ed0393d39d3\",\"_type\":\"block\",\"children\":[{\"_key\":\"081f2ad4371a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Our jailbreak rapid response procedures will be designed to identify and mitigate attempts to bypass the sets of safety measures described above.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f984e8fc2bd1\",\"_type\":\"block\",\"children\":[{\"_key\":\"0eafc397d7b10\",\"_type\":\"span\",\"marks\":[],\"text\":\"A new jailbreak could be detected by the asynchronous classifiers or through the bug-bounty program. The rapid-response protocol will involve mitigating the impact of the jailbreak by initiating patching. In an instance where a jailbreak patch is unable to be immediately implemented, we will maintain the capability to adjust the model’s prompting to reinforce safety constraints. For edge cases or situations requiring human judgment, there will be protocols for escalation to human reviewers.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ca6228a10aaf\",\"_type\":\"block\",\"children\":[{\"_key\":\"141044110a9c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Our process for minimizing jailbreak risks will include rapid retraining, validation, and testing of classifiers against newly discovered patterns and real-world scenarios. The effectiveness of jailbreak detection and response will be enhanced by collaboration and information sharing. To this end, we are developing a rapid response process for sharing threat intelligence with relevant partners.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"77b000ef548e\",\"_type\":\"block\",\"children\":[{\"_key\":\"e0a1030f8c6d0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Ongoing work\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d41534889361\",\"_type\":\"block\",\"children\":[{\"_key\":\"e4cc9d758a600\",\"_type\":\"span\",\"marks\":[],\"text\":\"By implementing multiple defense layers, from real-time classifiers to asynchronous monitoring and rapid response systems, we hope to create a deployment safeguards infrastructure that is adaptable to various deployment scenarios.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8b9d2a0b6f0b\",\"_type\":\"block\",\"children\":[{\"_key\":\"e2238d01bd920\",\"_type\":\"span\",\"marks\":[],\"text\":\"The success of this system will depend on the integration and improvement of individual components. As implementation of these safeguards progresses, new challenges and opportunities for innovation in AI safety are likely to emerge. Ongoing research into areas such as balancing security and model utility, improving scalability and performance, enhancing adversarial robustness, and maintaining cross-platform consistency will be crucial in addressing these challenges.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1694c02c65c9\",\"_type\":\"block\",\"children\":[{\"_key\":\"afaecbb3e69e0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Security Safeguards\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"7ca3128fedde\",\"_type\":\"block\",\"children\":[{\"_key\":\"ba2b3e3862110\",\"_type\":\"span\",\"marks\":[],\"text\":\"The following sections outline the key security controls we plan to implement as part of our ASL-3 safeguards. Many of these security measures are already in place and are dedicated to enhancing our existing ASL-2 controls. In presenting this information, we have carefully balanced the need for transparency with the imperative to protect sensitive security details. As such, this overview provides a high-level description of our planned controls, offering insight into our security approach without compromising our defenses against potential threats.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"10c8d40ab6e0\",\"_type\":\"block\",\"children\":[{\"_key\":\"f3e8da3af4f60\",\"_type\":\"span\",\"marks\":[],\"text\":\"Access management and compartmentalization: Implement multiple clearance levels, data classification, and granular, per-role permission sets to govern employee access to sensitive assets and data including training techniques and hyperparameters. Use multi-tier compartmentalization controls based on asset type to limit blast radius from attacks and reduce insider risk. Educate employees on insider risk and establish a structured insider threat program to incentivize risk reporting.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"cb1861c4d5f4\",\"_type\":\"block\",\"children\":[{\"_key\":\"78a38b74dc6e0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Researcher tooling security: Enhance usability and security of research tools by preventing unnecessary access and limiting user privileges to only what is essential. Provide robust, user-friendly tooling without direct access to model weights.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d73e92166189\",\"_type\":\"block\",\"children\":[{\"_key\":\"7a5bf818469a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Software inventory management: Create a comprehensive software inventory list through automated scanning. Implement strict software inventory management to track all software components used in development and deployment. Regularly monitor inventory to effectively manage risks and maintain a secure environment.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"77e5471ee6f2\",\"_type\":\"block\",\"children\":[{\"_key\":\"3055e38868b90\",\"_type\":\"span\",\"marks\":[],\"text\":\"Software supply chain security: Monitor publicly known critical security issues in third-party dependencies. Conduct consistent scanning of all third-party dependencies and maintain a comprehensive vulnerability data repository. Proactively scan all incoming packages to enable download of only secure packages and reduce risk of introducing vulnerabilities.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"956e53c1487a\",\"_type\":\"block\",\"children\":[{\"_key\":\"677383d8fd110\",\"_type\":\"span\",\"marks\":[],\"text\":\"Artifact integrity and provenance: Leverage frameworks (e.g., SLSA) to improve security controls for software build and deployment. Require packages to have provenance metadata.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6cb090491530\",\"_type\":\"block\",\"children\":[{\"_key\":\"d33b4d2af07f0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Binary authorization for endpoints: Enforce binary authorization on every endpoint to allow only trusted, approved software to run. Follow a strict process for approving any software that needs local installation on machines. Use centrally managed execution policies to prevent unauthorized or malicious code. Limit attacker actions through strict security policies and detailed logging for swift incident detection and response.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"87a2a029600d\",\"_type\":\"block\",\"children\":[{\"_key\":\"84d7b5c6f7b90\",\"_type\":\"span\",\"marks\":[],\"text\":\"Endpoint patching: Use device management software (e.g., Mobile Device Management) to update all devices to the latest, most secure OS and software versions. Monitor for publicly disclosed vulnerabilities in third-party software and quickly deploy patches or mitigate risks. Restrict access for devices that fall behind on critical updates until patches are applied. Implement automated patching processes to close any manual oversight gaps.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"530eed971383\",\"_type\":\"block\",\"children\":[{\"_key\":\"7760bcfbdb8f0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Hardware procurement: Source employee endpoints directly from vetted manufacturers for secure chain of custody. Maintain a curated list of approved, recommended hardware and peripherals and provide employees with securely sourced peripherals.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b062feb66574\",\"_type\":\"block\",\"children\":[{\"_key\":\"e2ab395e68870\",\"_type\":\"span\",\"marks\":[],\"text\":\"Executive Risk Council: Establish an Executive Risk Council sponsored by executive leadership to oversee security programs. Follow a risk-based approach aligned with ISO 27001 standard. Perform periodic reviews to assess our security program's adherence to obligations deriving appropriately from both internal factors (e.g., adopted industry practices, contractual commitments, internal policies) and appropriate external factors (e.g., regulations and statutes).\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9cf1d6f27d14\",\"_type\":\"block\",\"children\":[{\"_key\":\"798d91a1a3f10\",\"_type\":\"span\",\"marks\":[],\"text\":\"Access control for model weights: Implement multi-party authorization and mandatory code review on production code to remove persistent, high-privilege access to model weights. Grant temporary access and only via the smallest set of necessary permissions to reduce risk of weights exfiltration. Require hardware authentication device prompt, justification and employee approval to grant access.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e9cd3492b2b1\",\"_type\":\"block\",\"children\":[{\"_key\":\"9c82e028182f0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Infrastructure policy: Require all new production infrastructure to be defined in Infrastructure As Code (IaC) before promotion to production environments. Require infrastructure changes be reviewed by the Security team.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ae06e7e22b6f\",\"_type\":\"block\",\"children\":[{\"_key\":\"ff71cefd68bc0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Cloud security posture management: Reduce risk of compromise due to cloud misconfiguration by defining and implementing internal standards and best practices. Conduct regular audits of cloud environments and promptly remediate any identified gaps.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a748f9b547b4\",\"_type\":\"block\",\"children\":[{\"_key\":\"056fe935e1ca0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Red teaming and penetration testing: Partner with a diverse range of external red team and penetration testing experts. Simulate sophisticated attacks, including insider threat and software supply chain compromise scenarios, to identify vulnerabilities. Build an in-house security team with wide-ranging expertise, including APT defense, insider risk, incident response, and secure design.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5cdf9da41e2d\",\"_type\":\"block\",\"children\":[{\"_key\":\"dcec4efecf5d0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Centralized log management and analysis: Centralize storage of major security-centric log sources in a SIEM/SOAR platform. Enable manual and automated analysis, log retention, rule creation and execution for detections and response workflows. Implement orchestration and response playbooks for automated alert investigation. Use a casebook workflow for security analysts to manage incidents.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8af3390b2c77\",\"_type\":\"block\",\"children\":[{\"_key\":\"0c67a12ea2b70\",\"_type\":\"span\",\"marks\":[],\"text\":\"Access monitoring for critical assets: Conduct manual monitoring of access to model weights and high value IP, including recurring automated detections. Build automated detection across all major log sources for access to critical assets. Leverage additional threat intelligence to continuously improve detections.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"50e3768e9888\",\"_type\":\"block\",\"children\":[{\"_key\":\"b4f94b542aa60\",\"_type\":\"span\",\"marks\":[],\"text\":\"Deception technology: Install and monitor honeypots (including fake model weights) for high precision detection of unauthorized system access. Implement deception technology in a realistic way to trick attackers and gain insights into their tactics.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b36830b2cb9d\",\"_type\":\"block\",\"children\":[{\"_key\":\"6b39ea4b35970\",\"_type\":\"span\",\"marks\":[],\"text\":\"Physical security: Conduct regular Technical Surveillance Countermeasures (TSCM) at physical spaces using advanced detection equipment and techniques. Tailor TSCM sweeps to specific events, threats or incidents that may trigger an inspection. Regularly sweep physical premises for intruders and conduct physical security red-teaming\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"540800112594\",\"_type\":\"block\",\"children\":[{\"_key\":\"ab42bc2744a30\",\"_type\":\"span\",\"marks\":[],\"text\":\"Planned Capability Assessments\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"f03fdc7d5225\",\"_type\":\"block\",\"children\":[{\"_key\":\"365b4d9da801\",\"_type\":\"span\",\"marks\":[],\"text\":\"We plan to publish additional details on our capability assessment methodology in the near future. For information about our past capability assessments, please see our overviews for \"},{\"_key\":\"9df93f21ef79\",\"_type\":\"span\",\"marks\":[\"4b98424f9acd\"],\"text\":\"Claude 3.0 Opus\"},{\"_key\":\"b498a56c3e3d\",\"_type\":\"span\",\"marks\":[],\"text\":\" and \"},{\"_key\":\"ef548d80c5343\",\"_type\":\"span\",\"marks\":[\"4181e04ce7bf\"],\"text\":\"Claude 3.5 Sonnet\"},{\"_key\":\"ef548d80c5344\",\"_type\":\"span\",\"marks\":[],\"text\":\". \"}],\"markDefs\":[{\"_key\":\"4181e04ce7bf\",\"_type\":\"link\",\"href\":\"https://www-cdn.anthropic.com/fed9cc193a14b84131812372d8d5857f8f304c52/Model_Card_Claude_3_Addendum.pdf\"},{\"_key\":\"4b98424f9acd\",\"_type\":\"link\",\"href\":\"https://www-cdn.anthropic.com/f2986af8d052f26236f6251da62d16172cfabd6e/claude-3-model-card.pdf\"}],\"style\":\"normal\"},{\"_key\":\"766704a3c5cd\",\"_type\":\"block\",\"children\":[{\"_key\":\"ec5a71f4a34e0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Learning from Experience\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"0fede7024e59\",\"_type\":\"block\",\"children\":[{\"_key\":\"6d16d40998110\",\"_type\":\"span\",\"marks\":[],\"text\":\"We have learned a lot in our first year with the previous RSP in effect, and are using this update as an opportunity to reflect on what has worked well and what makes sense to update in the policy. As part of this, we reviewed how well we adhered to the framework and identified a small number of instances where we fell short of meeting the full letter of its requirements. These areas were:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"84f6f3a4f72a\",\"_type\":\"block\",\"children\":[{\"_key\":\"9134b9e21b740\",\"_type\":\"span\",\"marks\":[],\"text\":\"Our most recent evaluations were completed 3 days later than the 3-month interval. This delay allowed our teams to refine their capability elicitation, resulting in higher-quality evaluations. To resolve this issue, the new policy clarifies the ambiguous definition of the evaluation interval, and extends the interval to 6 months to avoid lower-quality, rushed elicitation.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ba11da3b0ab5\",\"_type\":\"block\",\"children\":[{\"_key\":\"997636ae17fd0\",\"_type\":\"span\",\"marks\":[],\"text\":\"In our most recent evaluations, we updated our autonomy evaluation from the specified placeholder tasks, even though an ambiguity in the previous policy could be interpreted as also requiring a policy update. We believe the updated evaluations provided a stronger assessment of the specified “tasks taking an expert 2-8 hours” benchmark. The updated policy resolves the ambiguity, and in the future we intend to proactively clarify policy ambiguities.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"805fdfcd4f64\",\"_type\":\"block\",\"children\":[{\"_key\":\"18e75d432ab40\",\"_type\":\"span\",\"marks\":[],\"text\":\"Some of our evaluations lacked some basic elicitation techniques such as best-of-N or chain-of-thought prompting. Our internal Capability Report discloses these limitations, and we believe the risk of substantial under-elicitation is low. We are now systematically tracking these gaps to avoid future under-elicitation.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"fb7c95362017\",\"_type\":\"block\",\"children\":[{\"_key\":\"da7807f338310\",\"_type\":\"span\",\"marks\":[],\"text\":\"Our evaluations in one domain were not explicitly designed to establish the 6x scaling buffer mentioned in the previous policy. Since our current techniques aren’t capable of giving confident buffer predictions, we instead relied on empirical observations and rough predictions. We believe this presents minimal risk at present, where capability improvements happen more smoothly with scale, but in the future, quantitative predictions may become necessary. We have updated the new policy to note this situation.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3821f8bed385\",\"_type\":\"block\",\"children\":[{\"_key\":\"f75ed3ef473c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"In all cases, we found these instances posed minimal risk to the safety of our models. From our review, we learned two valuable lessons to incorporate into our updated framework: we needed to incorporate more flexibility into our policies, and we needed to improve our process for tracking compliance with the RSP.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4686d267ec15\",\"_type\":\"block\",\"children\":[{\"_key\":\"d5456ffae8f60\",\"_type\":\"span\",\"marks\":[],\"text\":\"Since we first released the RSP a year ago, our goal has been to offer an example of a framework that others might draw inspiration from when crafting their own AI risk governance policies. We hope that proactively sharing our experiences implementing our own policy will help other companies in implementing their own risk management frameworks and contribute to the establishment of best practices across the AI ecosystem.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"tableOfContents\":\"$undefined\",\"downloads\":null}]]}]]}]]]}]\n18:[[\"$\",\"title\",\"0\",{\"children\":\"Anthropic’s Responsible Scaling Policy \\\\ Anthropic\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Stay informed about the latest updates to our Responsible Scaling Policy. Learn how Anthropic maintains safety and reliability in AI development.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"msapplication-TileColor\",\"content\":\"141413\"}],[\"$\",\"meta\",\"3\",{\"name\":\"msapplication-config\",\"content\":\"/browserconfig.xml\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://www.anthropic.com/responsible-scaling-policy\"}],[\"$\",\"meta\",\"5\",{\"name\":\"google-site-verification\",\"content\":\"BqiAW_sWOg-KrPk-Accxm6ge9dtnFEyV6DB6vzVZSGs\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:title\",\"content\":\"Anthropic’s Responsible Scaling Policy\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:description\",\"content\":\"Stay informed about the latest updates to our Responsible Scaling Policy. Learn how Anthropic maintains safety and reliability in AI development.\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:url\",\"content\":\"https://www.anthropic.com/responsible-scaling-policy\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:image\",\"content\":\"https://assets.claude.com/f206078bb0920966fe2255156c317f4274ebe652.png\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:image:alt\",\"content\":\"Anthropic logo\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:site\",\"content\":\"@AnthropicAI\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:creator\",\"content\":\"@AnthropicAI\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:title\",\"content\":\"Anthropic’s Responsible Scaling Policy\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:description\",\"content\":\"Stay informed about the latest updates to our Responsible Scaling Policy. Learn how Anthropic maintains safety and reliability in AI development.\"}],[\"$\",\"meta\",\"17\",{\"name\":\"twitter:image\",\"content\":\"https://assets.claude.com/f206078bb0920966fe2255156c317f4274ebe652.png\"}],[\"$\",\"meta\",\"18\",{\"name\":\"twitter:image:alt\",\"content\":\"Anthropic logo\"}],[\"$\",\"link\",\"19\",{\"rel\":\"shortcut icon\",\"href\":\"/favicon.ico\"}],[\"$\",\"link\",\"20\",{\"rel\":\"icon\",\"href\":\"/images/icons/favicon-32x32.png\"}],[\"$\",\"link\",\"21\",{\"rel\":\"apple-touch-icon\",\"href\":\"/images/icons/apple-touch-icon.png\"}],[\"$\",\"link\",\"22\",{\"rel\":\"apple-touch-icon\",\"href\":\"/images/icons/apple-touch-icon.png\",\"sizes\":\"180x180\"}],[\"$\",\"link\",\"23\",{\"rel\":\"mask-icon\",\"href\":\"/images/icons/safari-pinned-tab.svg\",\"color\":\"141413\"}],[\"$\",\"$L72\",\"24\",{}]]\n1b:null\n"])</script></body></html>