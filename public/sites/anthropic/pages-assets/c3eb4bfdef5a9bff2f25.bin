\u003emessage\u003c/span\u003e.\u003cspan class=\"dc\"\u003econtent\u003c/span\u003e);\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e15f:[\"$\",\"$L15a\",\".$3\",{\"wrap\":false,\"language\":\"typescript\",\"label\":\"TypeScript\",\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$18a\"}}]}]\n18b:T691,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"lj d2\"\u003eAnthropicClient\u003c/span\u003e\u003cspan class=\"lj dc\"\u003e client\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"lk d4\"\u003e new\u003c/span\u003e();\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003evar\u003c/span\u003e\u003cspan class=\"lj dc\"\u003e parameters\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"lk d4\"\u003e new\u003c/span\u003e\u003cspan class=\"lj d2\"\u003e MessageCreateParams\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e{\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e    Model\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"dc\"\u003e Model\u003c/span\u003e.\u003cspan class=\"dc\"\u003eClaudeOpus5_5\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e    MaxTokens\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e 1024\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e    System\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"You are a helpful coding assistant specializing in Python.\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e   