ds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1rem * var(--cds-rem-scale, 1));font-weight:533.3" aria-hidden="true"></span></span></button></span></h3>
<p>Claude’s latest models have a more concise and natural communication style compared to previous models:</p>
<ul>
<li><strong>More direct and grounded:</strong> Provides fact-based progress reports rather than self-celebratory updates</li>
<li><strong>More conversational:</strong> Slightly more fluent and colloquial, less machine-like</li>
<li><strong>Less verbose:</strong> Might skip detailed summaries for efficiency unless prompted otherwise</li>
</ul>
<p>This means Claude might skip verbal summaries after tool calls, jumping directly to the next action. If you prefer more visibility into its work:</p>
<div data-copy-scope="" class="overflow-hidden rounded-card border bg-surface-2 print:[p+&amp;]:break-before-avoid group relative prose-block [&amp;&gt;[data-not-prose]]:mt-0"><div class="flex items-center justify-between gap-2 border-b px-4 py-1 print:break-after-avoid print:py-sm not-prose"><div class="flex min-w-0 items-center gap-2 text-caption text-muted">Sample prompt</div><div class="flex shrink-0 items-center gap-1 print:hidden"><span class="contents group-[:not(:has([data-code-source]))]/codegroup:hidden"><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" data-size="sm" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-fizzy-lake-color-icon-only-disabled)] text-muted" aria-label="Copy code" id="_R_f4lvcqalubtabsknr5td9leailb_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] stacks:transition-[box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1.25rem * var(--cds-rem-scale, 1));font-weight:433.3" aria-hidden="true"></span></span></button><span role="status" class="sr-only"></span></span></div></div><div data-not-prose="true" class="relative h-full py-4 pl-4 text-code code-block-wrap"><pre class="block w-full pr-4" data-code-source="" translate="no"><code>After completing a task that involves tool use, provide a quick summary of the work you&#x27;ve done.</code></pre></div></div>
<p>Claude Opus 5 is an exception on verbosity: its default user-facing responses run longer than prior models’, and raising or lowering <a href="/docs/en/build-with-claude/effort">effort</a> does not reliably change visible response length. Prompt explicitly for conciseness instead. See <a href="/docs/en/build-with-claude/prompt-engineering/prompting-claude-opus-5#response-length-and-verbosity">Prompting Claude Opus 5</a> for a sample instruction. Claude Fable 5.1 has the opposite tendency during agentic work: it writes fewer user-facing updates between tool calls. Ask for progress text explicitly, and remove any instruction telling it to keep that text brief. See <a href="/docs/en/build-with-claude/prompt-engineering/prompting-claude-fable-5-1#ask-for-user-facing-progress-updates">Ask for user-facing progress updates</a>.</p>
<h3 id="control-the-format-of-responses" class="group">Control the format of responses<span class="relative hidden h-[1em] w-0 align-middle lg:inline-block"><span role="status" aria-live="polite" class="sr-only"></span><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" data-size="xs" class="cds-reset group/btn isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-fizzy-lake-color-icon-only-disabled)] absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100" aria-label="Copy link to Control the format of responses" id="_R_18mvcqalubtabsknr5td9leailb_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] stacks:transition-[box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1rem * var(--cds-rem-scale, 1));font-weight:533.3" aria-hidden="true"></span></span></button></span></h3>
<p>There are a few particularly effective ways to steer output formatting:</p>
<ol>
<li>
<p><strong>Tell Claude what to do instead of what not to do</strong></p>
<ul>
<li>Instead of: “Do not use markdown in your response”</li>
<li>Try: “Your response should be composed of smoothly flowing prose paragraphs.”</li>
</ul>
</li>
<li>
<p><strong>Use XML format indicators</strong></p>
<ul>
<li>Try: “Write the prose sections of your response in &lt;smoothly_flowing_prose_paragraphs&gt; tags.”</li>
</ul>
</li>
<li>
<p><strong>Match your prompt style to the output you want</strong></p>
<p>The formatting style used in your prompt might influence Claude’s response style. If you are still experiencing steerability issues with output formatting, try matching your prompt style to the output style you want as closely as possible. For example, removing markdown from your prompt can reduce the volume of markdown in the output.</p>
</li>
<li>
<p><strong>Use detailed prompts for specific formatting preferences</strong></p>
<p>For more control over markdown and formatting usage, provide explicit guidance:</p>
</li>
</ol>
<div data-copy-scope="" class="overflow-hidden rounded-card border bg-surface-2 print:[p+&amp;]:break-before-avoid group relative prose-block [&amp;&gt;[data-not-prose]]:mt-0"><div class="flex items-center justify-between gap-2 border-b px-4 py-1 print:break-after-avoid print:py-sm not-prose"><div class="flex min-w-0 items-center gap-2 text-caption text-muted">Sample prompt to minimize markdown</div><div class="flex shrink-0 items-center gap-1 print:hidden"><span class="contents group-[:not(:has([data-code-source]))]/codegroup:hidden"><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" data-size="sm" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-fizzy-lake-color-icon-only-disabled)] text-muted" aria-label="Copy code" id="_R_f4ofcqalubtabsknr5td9leailb_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] stacks:transition-[box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1.25rem * var(--cds-rem-scale, 1));font-weight:433.3" aria-hidden="true"></span></span></button><span role="status" class="sr-only"></span></span></div></div><div data-not-prose="true" class="relative h-full py-4 pl-4 text-code code-block-wrap"><div class="block w-full pr-4" data-code-source="" translate="no"><pre class="shiki"><code><span class="line">&lt;avoid_excessive_markdown_and_bullet_points&gt;</span>
<span class="line">When writing reports, documents, technical explanations, analyses, or any <span class="nowrap">long-form</span></span>
<span class="line">content, write in clear, flowing prose using complete paragraphs and sentences. Use</span>
<span class="line">standard paragraph breaks for organization and reserve markdown primarily for `inline</span>
<span class="line">code`, code blocks (```...```), and simple headings (## and ###). Avoid using **bold**</span>
<span class="line">and *italics*.</span>
<span class="line"></span>
<span class="line">DO NOT use ordered lists (1. ...) or unordered lists (*) unless: a) you're presenting</span>
<span class="line">truly discrete items where a list format is the best option, or b) the user explicitly</span>
<span class="line">requests a list or ranking</span>
<span class="line"></span>
<span class="line">Instead of listing items with bullets or numbers, incorporate them naturally into</span>
<span class="line">sentences. This guidance applies especially to technical writing. Using prose instead of</span>
<span class="line">excessive formatting will improve user satisfaction. NEVER output a series of overly</span>
<span class="line">short bullet points.</span>
<span class="line"></span>
<span class="line">Your goal is readable, flowing text that guides the reader naturally through ideas</span>
<span class="line">rather than fragmenting information into isolated points.</span>
<span class="line">&lt;/avoid_excessive_markdown_and_bullet_points&gt;</span></code></pre></div></div></div>
<p>Claude Fable 5.1 already formats less than earlier models, so on that model a block like this can suppress structure the content needs. Remove it, or replace it with the shorter rule in <a href="/docs/en/build-with-claude/prompt-engineering/prompting-claude-fable-5-1#formatting-in-chat">Formatting in chat</a>.</p>
<h3 id="la-te-x-output" class="group">LaTeX output<span class="relative hidden h-[1em] w-0 align-middle lg:inline-block"><span role="status" aria-live="polite" class="sr-only"></span><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" data-size="xs" class="cds-reset group/btn isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-fizzy-lake-color-icon-only-disabled)] absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100" aria-label="Copy link to LaTeX output" id="_R_18pfcqalubtabsknr5td9leailb_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] stacks:transition-[box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1rem * var(--cds-rem-scale, 1));font-weight:533.3" aria-hidden="true"></span></span></button></span></h3>
<p>Claude’s latest models default to LaTeX for mathematical expressions, equations, and technical explanations. If you prefer plain text, add the following instructions to your prompt:</p>
<div data-copy-scope="" class="overflow-hidden rounded-card border bg-surface-2 print:[p+&amp;]:break-before-avoid group relative prose-block [&amp;&gt;[data-not-prose]]:mt-0"><div class="flex items-center justify-between gap-2 border-b px-4 py-1 print:break-after-avoid print:py-sm not-prose"><div class="flex min-w-0 items-center gap-2 text-caption text-muted">Sample prompt</div><div class="flex shrink-0 items-center gap-1 print:hidden"><span class="contents group-[:not(:has([data-code-source]))]/codegroup:hidden"><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" data-size="sm" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-fizzy-lake-color-icon-only-disabled)] text-muted" aria-label="Copy code" id="_R_f4qfcqalubtabsknr5td9leailb_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] stacks:transition-[box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1.25rem * var(--cds-rem-scale, 1));font-weight:433.3" aria-hidden="true"></span></span></button><span role="status" class="sr-only"></span></span></div></div><div data-not-prose="true" class="relative h-full py-4 pl-4 text-code code-block-wrap"><pre class="block w-full pr-4" data-code-source="" translate="no"><code>Format your response in plain text only. Do not use LaTeX, MathJax, or any markup
notation such as \( \), $, or \frac{}{}. Write all math expressions using standard text
characters (e.g., &quot;/&quot; for division, &quot;*&quot; for multiplication, and &quot;^&quot; for exponents).</code></pre></div></div>
<h3 id="document-creation" class="group">Document creation<span class="relative hidden h-[1em] w-0 align-middle lg:inline-block"><span role="status" aria-live="polite" class="sr-only"></span><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" data-size="xs" class="cds-reset group/btn isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-fizzy-lake-color-icon-only-disabled)] absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100" aria-label="Copy link to Document creation" id="_R_18qvcqalubtabsknr5td9leailb_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] stacks:transition-[box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1rem * var(--cds-rem-scale, 1));font-weight:533.3" aria-hidden="true"></span></span></button></span></h3>
<p>Claude’s latest models create presentations, animations, and visual documents with strong instruction following, and usually produce usable output on the first try.</p>
<p>For best results with document creation:</p>
<div data-copy-scope="" class="overflow-hidden rounded-card border bg-surface-2 print:[p+&amp;]:break-before-avoid group relative prose-block [&amp;&gt;[data-not-prose]]:mt-0"><div class="flex items-center justify-between gap-2 border-b px-4 py-1 print:break-after-avoid print:py-sm not-prose"><div class="flex min-w-0 items-center gap-2 text-caption text-muted">Sample prompt</div><div class="flex shrink-0 items-center gap-1 print:hidden"><span class="contents group-[:not(:has([data-code-source]))]/codegroup:hidden"><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" data-size="sm" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-fizzy-lake-color-icon-only-disabled)] text-muted" aria-label="Copy code" id="_R_f4sfcqalubtabsknr5td9leailb_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] stacks:transition-[box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1.25rem * var(--cds-rem-scale, 1));font-weight:433.3" aria-hidden="true"></span></span></button><span role="status" class="sr-only"></span></span></div></div><div data-not-prose="true" class="relative h-full py-4 pl-4 text-code code-block-wrap"><pre class="block w-full pr-4" data-code-source="" translate="no"><code>Create a professional presentation on [topic]. Include thoughtful design elements,
visual hierarchy, and engaging animations where appropriate.</code></pre></div></div>
<h3 id="migrating-away-from-prefilled-responses" class="group">Migrating away from prefilled responses<span class="relative hidden h-[1em] w-0 align-middle lg:inline-block"><span role="status" aria-live="polite" class="sr-only"></span><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" data-size="xs" class="cds-reset group/btn isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-fizzy-lake-color-icon-only-disabled)] absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100" aria-label="Copy link to Migrating away from prefilled responses" id="_R_18svcqalubtabsknr5td9leailb_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] stacks:transition-[box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1rem * var(--cds-rem-scale, 1));font-weight:533.3" aria-hidden="true"></span></span></button></span></h3>
<p>Starting with Claude 4.6 models and <a href="https://anthropic.com/glasswing" target="_blank" rel="noopener noreferrer">Claude Mythos Preview</a>, prefilled responses (providing a partial assistant message for Claude to continue from) on the last assistant turn are no longer supported. Requests with prefilled assistant messages to these models return a 400 error. Model intelligence and instruction following have advanced such that most use cases of prefill no longer require it. Earlier models continue to support prefills, and adding assistant messages elsewhere in the conversation is not affected.</p>
<p>Here are common prefill scenarios and how to migrate away from them:</p>
<div data-orientation="vertical" data-cds="Accordion" class="group/accordion font-sans divide-y prose-block" style="--accordion-px:var(--cds-pad-md);--accordion-radius:var(--cds-radius)"><div data-orientation="vertical" data-hidden="" data-index="-1" data-closed="" class="group-hover/accordion:[&amp;:has(+*:not([data-disabled])&gt;[data-cds=AccordionHeader]:hover)]:border-b-transparent group-hover/accordion:[&amp;[data-closed]:not([data-disabled]):has(&gt;[data-cds=AccordionHeader]:hover)]:border-b-transparent touch:[&amp;:has(+*:not([data-disabled])&gt;[data-cds=AccordionHeader]:active)]:border-b-transparent touch:[&amp;[data-closed]:not([data-disabled]):has(&gt;[data-cds=AccordionHeader]:active)]:border-b-transparent"><h3 data-orientation="vertical" data-hidden="" data-index="-1" data-closed="" data-cds="AccordionHeader" class="flex mx-outset w-stretch" style="--cds-outset-x:var(--accordion-px)"><button type="button" data-value="" data-orientation="vertical" data-hidden="" data-index="-1" tabindex="0" aria-disabled="false" aria-expanded="false" id="base-ui-_R_ufcqalubtabsknr5td9leailbH2_" data-size="lg" class="cds-reset group/acc flex w-full items-start gap-sm min-h-control rounded-[var(--accordion-radius)] px-[var(--accordion-px)] py-[calc((var(--cds-h-control)_-_1lh)_/_2)] font-sans text-start text-body font-medium font-control text-primary outline-none focus-visible:outline-hidden hover:bg-fill-ghost-hover touch:active:bg-fill-ghost-hover focus-visible:bg-fill-ghost-hover focus-visible:[box-shadow:inset_0_0_0_1px_var(--cds-fill-accent)] data-[disabled]:opacity-disabled data-[disabled]:pointer-events-none stacks:focus-visible:bg-fill-ghost-selected select-text"><span class="min-w-0 flex-1 break-words">Controlling output formatting</span><span data-cds-accordion-caret="" class="flex h-[1lh] shrink-0 items-center"><span data-cds="Icon" style="font-size:calc(1.5rem * var(--cds-rem-scale, 1));font-weight:433.3;font-variation-settings:&quot;opsz&quot; 24;width:0.8333333333333334em;height:0.8333333333333334em;contain:layout paint;pointer-events:none" class="transition-transform duration-fast motion-reduce:transition-none -rotate-90 page-rtl:rotate-90 text-muted group-data-[panel-open]/acc:rotate-0 group-data-[panel-open]/acc:page-rtl:rotate-0 stacks:not-in-[tr[data-dimmed]]:[--cds-text-muted:var(--cds-fizzy-lake-color-secondary)]" aria-hidden="true"></span></span></button></h3><div data-orientation="vertical" data-hidden="" data-index="-1" data-closed="" data-starting-style="" hidden="" id="base-ui-_R_ufcqalubtabsknr5td9leailbH1_" aria-labelledby="base-ui-_R_ufcqalubtabsknr5td9leailbH2_" role="region" style="--accordion-panel-height:auto;--accordion-panel-width:auto" class="break-words h-[var(--cds-disclosure-panel-height)] transition-[height] duration-base ease-out motion-reduce:transition-none data-[starting-style]:h-0 data-[ending-style]:h-0 data-[starting-style]:[clip-path:inset(-8px_-100vw_0_-100vw)] data-[ending-style]:[clip-path:inset(-8px_-100vw_0_-100vw)] data-[animating]:[clip-path:inset(-8px_-100vw_0_-100vw)] data-[starting-style]:contain-layout data-[ending-style]:contain-layout data-[animating]:contain-layout text-body font-normal text-secondary [--cds-disclosure-panel-height:var(--accordion-panel-height)]"><div class="py-md"><div class="text-prose"><p>Prefills have been used to force specific output formats such as JSON/YAML, classification, and similar patterns where the prefill constrains Claude to a particular structure.</p><p><strong>Migration:</strong> The <a href="/docs/en/build-with-claude/structured-outputs">structured outputs</a> feature is designed specifically to constrain Claude’s responses to follow a given schema. Try asking the model to conform to your output structure first, as newer models can reliably match complex schemas when told to, especially if implemented with retries. For classification tasks, use either tools with an enum field containing your valid labels or structured outputs.</p></div></div></div></div></div>
<div data-orientation="vertical" data-cds="Accordion" class="group/accordion font-sans divide-y prose-block" style="--accordion-px:var(--cds-pad-md);--accordion-radius:var(--cds-radius)"><div data-orientation="vertical" data-hidden="" data-index="-1" data-closed="" class="group-hover/accordion:[&amp;:has(+*:not([data-disabled])&gt;[data-cds=AccordionHeader]:hover)]:border-b-transparent group-hover/accordion:[&amp;[data-closed]:not([data-disabled]):has(&gt;[data-cds=AccordionHeader]:hover)]:border-b-transparent touch:[&amp;:has(+*:not([data-disabled])&gt;[data-cds=AccordionHeader]:active)]:border-b-transparent touch:[&amp;[data-closed]:not([data-disabled]):has(&gt;[data-cds=AccordionHeader]:active)]:border-b-transparent"><h3 data-orientation="vertical" data-hidden="" data-index="-1" data-closed="" data-cds="AccordionHeader" class="flex mx-outset w-stretch" style="--cds-outset-x:var(--accordion-px)"><button type="button" data-value="" data-orientation="vertical" data-hidden="" data-index="-1" tabindex="0" aria-disabled="false" aria-expanded="false" id="base-ui-_R_uvcqalubtabsknr5td9leailbH2_" data-size="lg" class="cds-reset group/acc flex w-full items-start gap-sm min-h-control rounded-[var(--accordion-radius)] px-[var(--accordion-px)] py-[calc((var(--cds-h-control)_-_1lh)_/_2)] font-sans text-start text-body font-medium font-control text-primary outline-none focus-visible:outline-hidden hover:bg-fill-ghost-hover touch:active:bg-fill-ghost-hover focus-visible:bg-fill-ghost-hover focus-visible:[box-shadow:inset_0_0_0_1px_var(--cds-fill-accent)] data-[disabled]:opacity-disabled data-[disabled]:pointer-events-none stacks:focus-visible:bg-fill-ghost-selected select-text"><span class="min-w-0 flex-1 break-words">Eliminating preambles</span><span data-cds-accordion-caret="" class="flex h-[1lh] shrink-0 items-center"><span data-cds="Icon" style="font-size:calc(1.5rem * var(--cds-rem-scale, 1));font-weight:433.3;font-variation-settings:&quot;opsz&quot; 24;width:0.8333333333333334em;height:0.8333333333333334em;contain:layout paint;pointer-events:none" class="transition-transform duration-fast motion-reduce:transition-none -rotate-90 page-rtl:rotate-90 text-muted group-data-[panel-open]/acc:rotate-0 group-data-[panel-open]/acc:page-rtl:rotate-0 stacks:not-in-[tr[data-dimmed]]:[--cds-text-muted:var(--cds-fizzy-lake-color-secondary)]" aria-hidden="true"></span></span></button></h3><div data-orientation="vertical" data-hidden="" data-index="-1" data-closed="" data-starting-style="" hidden="" id="base-ui-_R_uvcqalubtabsknr5td9leailbH1_" aria-labelledby="base-ui-_R_uvcqalubtabsknr5td9leailbH2_" role="region" style="--accordion-panel-height:auto;--accordion-panel-width:auto" class="break-words h-[var(--cds-disclosure-panel-height)] transition-[height] duration-base ease-out motion-reduce:transition-none data-[starting-style]:h-0 data-[ending-style]:h-0 data-[starting-style]:[clip-path:inset(-8px_-100vw_0_-100vw)] data-[ending-style]:[clip-path:inset(-8px_-100vw_0_-100vw)] data-[animating]:[clip-path:inset(-8px_-100vw_0_-100vw)] data-[starting-style]:contain-layout data-[ending-style]:contain-layout data-[animating]:contain-layout text-body font-normal text-secondary [--cds-disclosure-panel-height:var(--accordion-panel-height)]"><div class="py-md"><div class="text-prose"><p>Prefills such as <code>Here is the requested summary:\n</code> were used to skip introductory text.</p><p><strong>Migration:</strong> Use direct instructions in the system prompt: “Respond directly without preamble. Do not start with phrases like ‘Here is...’, ‘Based on...’, etc.” Alternatively, direct the model to output within XML tags, use structured outputs, or use tool calling. If the occasional preamble slips through, strip it in post-processing.</p></div></div></div></div></div>
<div data-orientation="vertical" data-cds="Accordion" class="group/accordion font-sans divide-y prose-block" style="--accordion-px:var(--cds-pad-md);--accordion-radius:var(--cds-radius)"><div data-orientation="vertical" data-hidden="" data-index="-1" data-closed="" class="group-hover/accordion:[&amp;:has(+*:not([data-disabled])&gt;[data-cds=AccordionHeader]:hover)]:border-b-transparent group-hover/accordion:[&amp;[data-closed]:not([data-disabled]):has(&gt;[data-cds=AccordionHeader]:hover)]:border-b-transparent touch:[&amp;:has(+*:not([data-disabled])&gt;[data-cds=AccordionHeader]:active)]:border-b-transparent touch:[&amp;[data-closed]:not([data-disabled]):has(&gt;[data-cds=AccordionHeader]:active)]:border-b-transparent"><h3 data-orientation="vertical" data-hidden="" data-index="-1" data-closed="" data-cds="AccordionHeader" class="flex mx-outset w-stretch" style="--cds-outset-x:var(--accordion-px)"><button type="button" data-value="" data-orientation="vertical" data-hidden="" data-index="-1" tabindex="0" aria-disabled="false" aria-expanded="false" id="base-ui-_R_vfcqalubtabsknr5td9leailbH2_" data-size="lg" class="cds-reset group/acc flex w-full items-start gap-sm min-h-control rounded-[var(--accordion-radius)] px-[var(--accordion-px)] py-[calc((var(--cds-h-control)_-_1lh)_/_2)] font-sans text-start text-body font-medium font-control text-primary outline-none focus-visible:outline-hidden hover:bg-fill-ghost-hover touch:active:bg-fill-ghost-hover focus-visible:bg-fill-ghost-hover focus-visible:[box-shadow:inset_0_0_0_1px_var(--cds-fill-accent)] data-[disabled]:opacity-disabled data-[disabled]:pointer-events-none stacks:focus-visible:bg-fill-ghost-selected select-text"><span class="min-w-0 flex-1 break-words">Avoiding bad refusals</span><span data-cds-accordion-caret="" class="flex h-[1lh] shrink-0 items-center"><span data-cds="Icon" style="font-size:calc(1.5rem * var(--cds-rem-scale, 1));font-weight:433.3;font-variation-settings:&quot;opsz&quot; 24;width:0.8333333333333334em;height:0.8333333333333334em;contain:layout paint;pointer-events:none" class="transition-transform duration-fast motion-reduce:transition-none -rotate-90 page-rtl:rotate-90 text-muted group-data-[panel-open]/acc:rotate-0 group-data-[panel-open]/acc:page-rtl:rotate-0 stacks:not-in-[tr[data-dimmed]]:[--cds-text-muted:var(--cds-fizzy-lake-color-secondary)]" aria-hidden="true"></span></span></button></h3><div data-orientation="vertical" data-hidden="" data-index="-1" data-closed="" data-starting-style="" hidden="" id="base-ui-_R_vfcqalubtabsknr5td9leailbH1_" aria-labelledby="base-ui-_R_vfcqalubtabsknr5td9leailbH2_" role="region" style="--accordion-panel-height:auto;--accordion-panel-width:auto" class="break-words h-[var(--cds-disclosure-panel-height)] transition-[height] duration-base ease-out motion-reduce:transition-none data-[starting-style]:h-0 data-[ending-style]:h-0 data-[starting-style]:[clip-path:inset(-8px_-100vw_0_-100vw)] data-[ending-style]:[clip-path:inset(-8px_-100vw_0_-100vw)] data-[animating]:[clip-path:inset(-8px_-100vw_0_-100vw)] data-[starting-style]:contain-layout data-[ending-style]:contain-layout data-[animating]:contain-layout text-body font-normal text-secondary [--cds-disclosure-panel-height:var(--accordion-panel-height)]"><div class="py-md"><div class="text-prose"><p>Prefills were used to steer around unnecessary refusals.</p><p><strong>Migration:</strong> Claude is much better at appropriate refusals now. Clear prompting within the <code>user</code> message without prefill should be sufficient.</p></div></div></div></div></div>
<div data-orientation="vertical" data-cds="Accordion" class="group/accordion font-sans divide-y prose-block" style="--accordion-px:var(--cds-pad-md);--accordion-radius:var(--cds-radius)"><div data-orientation="vertical" data-hidden="" data-index="-1" data-closed="" class="group-hover/accordion:[&amp;:has(+*:not([data-disabled])&gt;[data-cds=AccordionHeader]:hover)]:border-b-transparent group-hover/accordion:[&amp;[data-closed]:not([data-disabled]):has(&gt;[data-cds=AccordionHeader]:hover)]:border-b-transparent touch:[&amp;:has(+*:not([data-disabled])&gt;[data-cds=AccordionHeader]:active)]:border-b-transparent touch:[&amp;[data-closed]:not([data-disabled]):has(&gt;[data-cds=AccordionHeader]:active)]:border-b-transparent"><h3 data-orientation="vertical" data-hidden="" data-index="-1" data-closed="" data-cds="AccordionHeader" class="flex mx-outset w-stretch" style="--cds-outset-x:var(--accordion-px)"><button type="button" data-value="" data-orientation="vertical" data-hidden="" data-index="-1" tabindex="0" aria-disabled="false" aria-expanded="false" id="base-ui-_R_vvcqalubtabsknr5td9leailbH2_" data-size="lg" class="cds-reset group/acc flex w-full items-start gap-sm min-h-control rounded-[var(--accordion-radius)] px-[var(--accordion-px)] py-[calc((var(--cds-h-control)_-_1lh)_/_2)] font-sans text-start text-body font-medium font-control text-primary outline-none focus-visible:outline-hidden hover:bg-fill-ghost-hover touch:active:bg-fill-ghost-hover focus-visible:bg-fill-ghost-hover focus-visible:[box-shadow:inset_0_0_0_1px_var(--cds-fill-accent)] data-[disabled]:opacity-disabled data-[disabled]:pointer-events-none stacks:focus-visible:bg-fill-ghost-selected select-text"><span class="min-w-0 flex-1 break-words">Continuations</span><span data-cds-accordion-caret="" class="flex h-[1lh] shrink-0 items-center"><span data-cds="Icon" style="font-size:calc(1.5rem * var(--cds-rem-scale, 1));font-weight:433.3;font-variation-settings:&quot;opsz&quot; 24;width:0.8333333333333334em;height:0.8333333333333334em;contain:layout paint;pointer-events:none" class="transition-transform duration-fast motion-reduce:transition-none -rotate-90 page-rtl:rotate-90 text-muted group-data-[panel-open]/acc:rotate-0 group-data-[panel-open]/acc:page-rtl:rotate-0 stacks:not-in-[tr[data-dimmed]]:[--cds-text-muted:var(--cds-fizzy-lake-color-secondary)]" aria-hidden="true"></span></span></button></h3><div data-orientation="vertical" data-hidden="" data-index="-1" data-closed="" data-starting-style="" hidden="" id="base-ui-_R_vvcqalubtabsknr5td9leailbH1_" aria-labelledby="base-ui-_R_vvcqalubtabsknr5td9leailbH2_" role="region" style="--accordion-panel-height:auto;--accordion-panel-width:auto" class="break-words h-[var(--cds-disclosure-panel-height)] transition-[height] duration-base ease-out motion-reduce:transition-none data-[starting-style]:h-0 data-[ending-style]:h-0 data-[starting-style]:[clip-path:inset(-8px_-100vw_0_-100vw)] data-[ending-style]:[clip-path:inset(-8px_-100vw_0_-100vw)] data-[animating]:[clip-path:inset(-8px_-100vw_0_-100vw)] data-[starting-style]:contain-layout data-[ending-style]:contain-layout data-[animating]:contain-layout text-body font-normal text-secondary [--cds-disclosure-panel-height:var(--accordion-panel-height)]"><div class="py-md"><div class="text-prose"><p>Prefills were used to continue partial completions, resume interrupted responses, or extend a previous generation from where it ended.</p><p><strong>Migration:</strong> Move the continuation to the user message, and include the final text from the interrupted response: “Your previous response was interrupted and ended with `[previous_response]`. Continue from where you left off.” If this is part of error-handling or incomplete-response-handling and there is no UX penalty, retry the request.</p></div></div></div></div></div>
