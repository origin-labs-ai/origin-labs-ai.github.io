",\"$76\",\"$77\",\"$78\",\"$79\",\"$7a\",\"$7b\",\"$7c\",\"$7d\",\"$7e\",\"$7f\",\"$80\",\"$81\"],\"$170\"]\n8b:[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"model-specific-guidance\",\"name\":\"Model-specific guidance\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]\n8c:[\"$\",\"p\",\"8\",{\"children\":[\"Each of these models has its own prompting page. Read the one for your model first, then the techniques that follow.\"]}]\n3c:o103a,8d:[\"$\",\"div\",\"10\",{\"className\":\"prose-scroll relative print:overflow-visible\",\"children\":[\"$\",\"table\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"thead\",\"0\",{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"th\",\"0\",{\"children\":[\"Model\"]}],[\"$\",\"th\",\"1\",{\"children\":[\"Guide\"]}],[\"$\",\"th\",\"2\",{\"children\":[\"What’s different\"]}]]}]]}],[\"$\",\"tbody\",\"1\",{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"\",\"children\":[\"Claude Fable 5.1 and Claude Mythos 5.1\"]}],[\"$\",\"td\",\"1\",{\"className\":\"\",\"children\":[[\"$\",\"$L88\",\"0\",{\"href\":\"/docs/en/build-with-claude/prompt-engineering/prompting-claude-fable-5-1\",\"untracked\":false,\"children\":[\"Prompting Claude Fable 5.1\"]}]]}],[\"$\",\"td\",\"2\",{\"className\":\"\",\"children\":[\"Differences from Claude Fable 5: effort levels, finishing long tasks, user-facing progress updates, passing thinking blocks back unchanged, tool-call batching in agent loops, search triggering at low effort, formatting, and writing density.\"]}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"\",\"children\":[\"Claude Fable 5 and Claude Mythos 5\"]}],[\"$\",\"td\",\"1\",{\"className\":\"\",\"children\":[[\"$\",\"$L88\",\"0\",{\"href\":\"/docs/en/build-with-claude/prompt-engineering/prompting-claude-fable-5\",\"untracked\":false,\"children\":[\"Prompting Claude Fable 5\"]}]]}],[\"$\",\"td\",\"2\",{\"className\":\"\",\"children\":[\"Differences from Claude Opus 4.8: effort levels, instruction following, long-run progress claims, memory systems, and the \",[\"$\",\"code\",\"1\",{\"children\":[\"reasoning_extraction\"]}],\" refusal category.\"]}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"docs-nowrap\",\"children\":[\"Claude Sonnet 5.5\"]}],[\"$\",\"td\",\"1\",{\"className\":\"\",\"children\":[[\"$\",\"$L88\",\"0\",{\"href\":\"/docs/en/build-with-claude/prompt-engineering/prompting-claude-sonnet-5-5\",\"untracked\":false,\"children\":[\"Prompting Claude Sonnet 5.5\"]}]]}],[\"$\",\"td\",\"2\",{\"className\":\"\",\"children\":[\"Differences from Claude Sonnet 5: effort calibration, initiative and scope, running without up-front thinking, JSON output on reasoning tasks, user-facing progress updates, tool use in chat, mid-turn user messages, verification on coding tasks, tool-call handling, complex visual inputs, and safeguard refusals.\"]}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"docs-nowrap\",\"children\":[\"Claude Sonnet 5\"]}],[\"$\",\"td\",\"1\",{\"className\":\"\",\"children\":[[\"$\",\"$L88\",\"0\",{\"href\":\"/docs/en/build-with-claude/prompt-engineering/prompting-claude-sonnet-5\",\"untracked\":false,\"children\":[\"Prompting Claude Sonnet 5\"]}]]}],[\"$\",\"td\",\"2\",{\"className\":\"\",\"children\":[\"Differences from Claude Sonnet 4.6: response length, effort and thinking-depth calibration, tool use triggering, literal instruction following, and design and frontend defaults.\"]}]]}],[\"$\",\"tr\",\"4\",{\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"docs-nowrap\",\"children\":[\"Claude Opus 5.5\"]}],[\"$\",\"td\",\"1\",{\"className\":\"\",\"children\":[[\"$\",\"$L88\",\"0\",{\"href\":\"/docs/en/build-with-claude/prompt-engineering/prompting-claude-opus-5-5\",\"untracked\":false,\"children\":[\"Prompting Claude Opus 5.5\"]}]]}],[\"$\",\"td\",\"2\",{\"className\":\"\",\"children\":[\"Differences from Claude Opus 5: effort calibration, prompts written for thinking disabled, user-facing progress updates, safeguard refusals, and tools for complex visual inputs.\"]}]]}],[\"$\",\"tr\",\"5\",{\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"docs-nowrap\",\"children\":[\"Claude Opus 5\"]}],[\"$\",\"td\",\"1\",{\"className\":\"\",\"children\":[[\"$\",\"$L88\",\"0\",{\"href\":\"/docs/en/build-with-claude/prompt-engineering/prompting-claude-opus-5\",\"untracked\":false,\"children\":[\"Prompting Claude Opus 5\"]}]]}],[\"$\",\"td\",\"2\",{\"className\":\"\",\"children\":[\"Differences from prior Opus models: response length and verbosity, user-facing progress updates, written deliverable length, task scope and over-verification, subagent control, and self-correction.\"]}]]}],[\"$\",\"tr\",\"6\",{\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"docs-nowrap\",\"children\":[\"Claude Opus 4.8\"]}],[\"$\",\"td\",\"1\",{\"className\":\"\",\"children\":[[\"$\",\"$L88\",\"0\",{\"href\":\"/docs/en/build-with-claude/prompt-engineering/prompting-claude-opus-4-8\",\"untracked\":false,\"children\":[\"Prompting Claude Opus 4.8\"]}]]}],\"$L13e\"]}],\"$L13f\"]}]]}]}]\n3c:o1000,8e:[\"$\",\"h2\",\"12\",{\"id\":\"general-principles\",\"className\":\"group\",\"children\":[[\"General principles\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"general-principles\",\"name\":\"General principles\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n8f:[\"$\",\"p\",\"14\",{\"children\":[\"The techniques in this section and the sections that follow apply to current Claude models, including Claude Fable 5.1, Claude Mythos 5.1, Claude Fable 5, and Claude Mythos 5. Where a technique names a specific model, treat it as measured on that model and re-check it against your own evals before applying it to another.\"]}]\n90:[\"$\",\"h3\",\"16\",{\"id\":\"be-clear-and-direct\",\"className\":\"group\",\"children\":[[\"Be clear and direct\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"be-clear-and-direct\",\"name\":\"Be clear and direct\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n91:[\"$\",\"p\",\"18\",{\"children\":[\"Claude responds well to clear, explicit instructions. Being specific about the output you want can help enhance results. If you want Claude to do more than the task strictly requires, explicitly request it rather than relying on the model to infer this from vague prompts.\"]}]\n92:[\"$\",\"p\",\"20\",{\"children\":[\"Think of Claude as a brilliant but new employee who lacks context on your norms and workflows. The more precisely you explain what you want, the better the result.\"]}]\n93:[\"$\",\"p\",\"22\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Key test:\"]}],\" Show your prompt to a colleague with minimal context on the task and ask them to follow it. If they’d be confused, Claude will be too.\"]}]\n94:[\"$\",\"ul\",\"24\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Be specific about the output format and constraints you want.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Provide instructions as sequential steps using numbered lists or bullet points when the order or completeness of steps matters.\"]}],\"\\n\"]}]\n95:[\"$\",\"$L140\",\"26\",{\"title\":\"Example: Creating an analytics dashboard\",\"defaultOpen\":true,\"children\":[[\"$\",\"p\",\"0\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Less effective:\"]}]]}],[\"$\",\"$L141\",\"1\",{\"language\":\"text\",\"label\":\"$undefined\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"children\":[\"$\",\"code\",null,{\"children\":\"Create an analytics dashboard\"}]}]}]}],[\"$\",\"p\",\"2\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"More effective:\"]}]]}],[\"$\",\"$L141\",\"3\",{\"language\":\"text\",\"label\":\"$undefined\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"div\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cpre class=\\\"shiki\\\"\u003e\u003ccode\u003e\u003cspan class=\\\"line\\\"\u003eCreate an analytics dashboard. Include as many relevant features and interactions as possible. Go beyond the basics to create a \u003cspan class=\\\"nowrap\\\"\u003efully-featured\u003c/span\u003e implementation.\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\"}}]}]}]]}]\n96:[\"$\",\"h3\",\"28\",{\"id\":\"add-context-to-improve-performance\",\"className\":\"group\",\"children\":[[\"Add context to improve performance\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"add-context-to-improve-performance\",\"name\":\"Add context to improve performance\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n97:[\"$\",\"p\",\"30\",{\"children\":[\"Providing context or motivation behind your instructions, such as explaining to Claude why such behavior is important, can give Claude more information a3c:o1000,bout your goals and help it deliver more targeted responses.\"]}]\n98:[\"$\",\"$L140\",\"32\",{\"title\":\"Example: Formatting preferences\",\"defaultOpen\":true,\"children\":[[\"$\",\"p\",\"0\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Less effective:\"]}]]}],[\"$\",\"$L141\",\"1\",{\"language\":\"text\",\"label\":\"$undefined\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"children\":[\"$\",\"code\",null,{\"children\":\"NEVER use ellipses\"}]}]}]}],[\"$\",\"p\",\"2\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"More effective:\"]}]]}],[\"$\",\"$L141\",\"3\",{\"language\":\"text\",\"label\":\"$undefined\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"div\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cpre class=\\\"shiki\\\"\u003e\u003ccode\u003e\u003cspan class=\\\"line\\\"\u003eYour response will be read aloud by a \u003cspan class=\\\"nowrap\\\"\u003etext-to-speech\u003c/span\u003e engine, so never use ellipses since the \u003cspan class=\\\"nowrap\\\"\u003etext-to-speech\u003c/span\u003e engine will not know how to pronounce them.\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\"}}]}]}]]}]\n99:[\"$\",\"p\",\"34\",{\"children\":[\"Claude can generalize from the explanation.\"]}]\n9a:[\"$\",\"h3\",\"36\",{\"id\":\"use-examples-effectively\",\"className\":\"group\",\"children\":[[\"Use examples effectively\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"use-examples-effectively\",\"name\":\"Use examples effectively\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n9b:[\"$\",\"p\",\"38\",{\"children\":[\"Examples are one of the most reliable ways to steer Claude’s output format, tone, and structure. A few well-crafted examples (known as few-shot or multishot prompting) improve accuracy and consistency.\"]}]\n9c:[\"$\",\"p\",\"40\",{\"children\":[\"When adding examples, make them:\"]}]\n9d:[\"$\",\"ul\",\"42\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Relevant:\"]}],\" Mirror your actual use case closely.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Diverse:\"]}],\" Cover edge cases and vary enough that Claude doesn’t pick up unintended patterns.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Structured:\"]}],\" Wrap examples in \",[\"$\",\"code\",\"2\",{\"children\":[\"\u003cexample\u003e\"]}],\" tags (multiple examples in \",[\"$\",\"code\",\"4\",{\"children\":[\"\u003cexamples\u003e\"]}],\" tags) so Claude can distinguish them from instructions.\"]}],\"\\n\"]}]\n9e:[\"$\",\"$L89\",\"44\",{\"variant\":\"muted\",\"id\":\"$undefined\",\"icon\":[\"$\",\"$L8a\",null,{\"name\":\"Lightbulb\",\"size\":\"auto\"}],\"className\":\"prose-block print:break-inside-avoid print:[:is(h2,h3,h4)+\u0026]:break-after-avoid\",\"children\":[\"Include 3–5 examples for best results. You can also ask Claude to evaluate your examples for relevance and diversity, or to generate additional ones based on your initial set.\"]}]\n9f:[\"$\",\"h3\",\"46\",{\"id\":\"structure-prompts-with-xml-tags\",\"className\":\"group\",\"children\":[[\"Structure prompts with XML tags\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"structure-prompts-with-xml-tags\",\"name\":\"Structure prompts with XML tags\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\na0:[\"$\",\"p\",\"48\",{\"children\":[\"XML tags help Claude parse complex prompts unambiguously, especially when your prompt mixes instructions, context, examples, and variable inputs. Wrapping each type of content in its own tag (for example, \",[\"$\",\"code\",\"1\",{\"children\":[\"\u003cinstructions\u003e\"]}],\", \",[\"$\",\"code\",\"3\",{\"children\":[\"\u003ccontext\u003e\"]}],\", \",[\"$\",\"code\",\"5\",{\"children\":[\"\u003cinput\u003e\"]}],\") reduces misinterpretation.\"]}]\na1:[\"$\",\"p\",\"50\",{\"children\":[\"Best practices:\"]}]\na2:[\"$\",\"ul\",\"52\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"childr3c:o394,en\":[\"Use consistent, descriptive tag names across your prompts.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Nest tags when content has a natural hierarchy (documents inside \",[\"$\",\"code\",\"1\",{\"children\":[\"\u003cdocuments\u003e\"]}],\", each inside \",[\"$\",\"code\",\"3\",{\"children\":[\"\u003cdocument index=\\\"n\\\"\u003e\"]}],\").\"]}],\"\\n\"]}]\na3:[\"$\",\"h3\",\"54\",{\"id\":\"give-claude-a-role\",\"className\":\"group\",\"children\":[[\"Give Claude a role\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"give-claude-a-role\",\"name\":\"Give Claude a role\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\na4:[\"$\",\"p\",\"56\",{\"children\":[\"Setting a role in the system prompt focuses Claude’s behavior and tone for your use case. Even a single sentence makes a difference:\"]}]\n145:T874,3c:o874,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"lj dt\"\u003ecurl\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e https://api.anthropic.com/v1/messages\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -H\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"\u003c/span\u003e\u003cspan class=\"l4 dd\"\u003econtent-type\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003eapplication/json\"\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -H\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"\u003c/span\u003e\u003cspan class=\"l4 dd\"\u003ex-api-key\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"dc\"\u003e$ANTHROPIC_API_KEY\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -H\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"\u003c/span\u003e\u003cspan class=\"l4 dd\"\u003eanthropic-version\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l2 dv\"\u003e2026-10-21\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -d\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e '\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"model\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"claude-opus-5-5\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"max_tokens\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l2 dk\"\u003e1024\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"system\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"You are a helpful coding assistant specializing in Python.\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"messages\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: [\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e      {\u003c/span\u003e\u003cspan class=\"l4 dj\"\u003e\"role\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"user\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e, \u003c/span\u003e\u003cspan class=\"l4 dj\"\u003e\"content\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"How do I sort a list of dictionaries by key?\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e}\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e    ]\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e  }\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e'\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e3c:o8d7,146:T430,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"lj dt\"\u003eant\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e messages\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e create\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  --model\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e claude-opus-5-5\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  --max-tokens\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e 1024\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  --system\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"You are a helpful coding assistant specializing in Python.\"\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  --message\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e '\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e{\u003c/span\u003e\u003cspan class=\"l4 dd\"\u003erole\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003euser\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e, \u003c/span\u003e\u003cspan class=\"l4 dd\"\u003econtent\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"How do I sort a list of dictionaries by key?\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e}\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e'\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003ea5:[\"$\",\"$L144\",\"58\",{\"children\":[[\"$\",\"$L143\",\".$0\",{\"wrap\":false,\"language\":\"bash\",\"label\":\"cURL\",\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$145\"}}]}],[\"$\",\"$L143\",\".$1\",{\"wrap\":false,\"language\":\"bash\",\"label\":\"CLI\",\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$146\"}}]}],\"$L147\",\"$L148\",\"$L149\",\"$L14a\",\"$L14b\",\"$L14c\",\"$L14d\"]}]\na6:[\"$\",\"h3\",\"60\",{\"id\":\"long-context-prompting\",\"className\":\"group\",\"children\":[[\"Long context prompting\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"long-context-prompting\",\"name\":\"Long context prompting\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\na7:[\"$\",\"p\",\"62\",{\"children\":[\"When working with large documents or data-rich inputs (20k+ tokens), structure your prompt carefully to get the best results:\"]}]\n14e:T863,3c:o863,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"d9\"\u003e\u0026lt;\u003c/span\u003e\u003cspan class=\"l5 d4\"\u003edocuments\u003c/span\u003e\u003cspan class=\"d9\"\u003e\u0026gt;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"d9\"\u003e  \u0026lt;\u003c/span\u003e\u003cspan class=\"l5 d4\"\u003edocument\u003c/span\u003e\u003cspan class=\"l1 dc\"\u003e index\u003c/span\u003e=\u003cspan class=\"l3 dn\"\u003e\"1\"\u003c/span\u003e\u003cspan class=\"d9\"\u003e\u0026gt;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"d9\"\u003e    \u0026lt;\u003c/span\u003e\u003cspan class=\"l5 d4\"\u003esource\u003c/span\u003e\u003cspan class=\"d9\"\u003e\u0026gt;\u003c/span\u003eannual_report_2023.pdf\u003cspan class=\"d9\"\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=\"l5 d4\"\u003esource\u003c/span\u003e\u003cspan class=\"d9\"\u003e\u0026gt;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"d9\"\u003e    \u0026lt;\u003c/span\u003e\u003cspan class=\"l5 d4\"\u003edocument_content\u003c/span\u003e\u003cspan class=\"d9\"\u003e\u0026gt;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e      {{ANNUAL_REPORT}}\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"d9\"\u003e    \u0026lt;/\u003c/span\u003e\u003cspan class=\"l5 d4\"\u003edocument_content\u003c/span\u003e\u003cspan class=\"d9\"\u003e\u0026gt;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"d9\"\u003e  \u0026lt;/\u003c/span\u003e\u003cspan class=\"l5 d4\"\u003edocument\u003c/span\u003e\u003cspan class=\"d9\"\u003e\u0026gt;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"d9\"\u003e  \u0026lt;\u003c/span\u003e\u003cspan class=\"l5 d4\"\u003edocument\u003c/span\u003e\u003cspan class=\"l1 dc\"\u003e index\u003c/span\u003e=\u003cspan class=\"l3 dn\"\u003e\"2\"\u003c/span\u003e\u003cspan class=\"d9\"\u003e\u0026gt;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"d9\"\u003e    \u0026lt;\u003c/span\u003e\u003cspan class=\"l5 d4\"\u003esource\u003c/span\u003e\u003cspan class=\"d9\"\u003e\u0026gt;\u003c/span\u003ecompetitor_analysis_q2.xlsx\u003cspan class=\"d9\"\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=\"l5 d4\"\u003esource\u003c/span\u003e\u003cspan class=\"d9\"\u003e\u0026gt;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"d9\"\u003e    \u0026lt;\u003c/span\u003e\u003cspan class=\"l5 d4\"\u003edocument_content\u003c/span\u003e\u003cspan class=\"d9\"\u003e\u0026gt;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e      {{COMPETITOR_ANALYSIS}}\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"d9\"\u003e    \u0026lt;/\u003c/span\u003e\u003cspan class=\"l5 d4\"\u003edocument_content\u003c/span\u003e\u003cspan class=\"d9\"\u003e\u0026gt;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"d9\"\u003e  \u0026lt;/\u003c/span\u003e\u003cspan class=\"l5 d4\"\u003edocument\u003c/span\u003e\u003cspan class=\"d9\"\u003e\u0026gt;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"d9\"\u003e\u0026lt;/\u003c/span\u003e\u003cspan class=\"l5 d4\"\u003edocuments\u003c/span\u003e\u003cspan class=\"d9\"\u003e\u0026gt;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003eAnalyze the annual report and competitor analysis. Identify strategic advantages and recommend Q3 focus areas.\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e3c:o5e0,a8:[\"$\",\"ul\",\"64\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Put long-form data at the top:\"]}],\" Place your long documents and inputs near the top of your prompt, above your query, instructions, and examples. This improves performance across all models.\"]}],\"\\n\",[\"$\",\"$L89\",\"3\",{\"variant\":\"muted\",\"id\":\"$undefined\",\"icon\":\"$undefined\",\"className\":\"prose-block print:break-inside-avoid print:[:is(h2,h3,h4)+\u0026]:break-after-avoid\",\"children\":[\"Queries at the end can improve response quality by up to 30 percent in tests, especially with complex, multidocument inputs.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Structure document content and metadata with XML tags:\"]}],\" When using multiple documents, wrap each document in \",[\"$\",\"code\",\"2\",{\"children\":[\"\u003cdocument\u003e\"]}],\" tags with \",[\"$\",\"code\",\"4\",{\"children\":[\"\u003cdocument_content\u003e\"]}],\" and \",[\"$\",\"code\",\"6\",{\"children\":[\"\u003csource\u003e\"]}],\" (and other metadata) subtags for clarity.\"]}],\"\\n\",[\"$\",\"$L140\",\"3\",{\"title\":\"Example multidocument structure\",\"children\":[[\"$\",\"$L141\",\"0\",{\"language\":\"xml\",\"label\":\"$undefined\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":false,\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$14e\"}}]}]}]]}],\"\\n\"]}],\"\\n\",\"$L14f\",\"\\n\"]}]\n3c:o1000,a9:[\"$\",\"h3\",\"66\",{\"id\":\"model-self-knowledge\",\"className\":\"group\",\"children\":[[\"Model self-knowledge\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"model-self-knowledge\",\"name\":\"Model self-knowledge\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\naa:[\"$\",\"p\",\"68\",{\"children\":[\"If you would like Claude to identify itself correctly in your application or use specific API strings:\"]}]\nab:[\"$\",\"$L141\",\"70\",{\"language\":\"text\",\"label\":\"Sample prompt for model identity\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"children\":[\"$\",\"code\",null,{\"children\":\"The assistant is Claude, created by Anthropic. The current model is Claude Opus 5.5.\"}]}]}]}]\nac:[\"$\",\"p\",\"72\",{\"children\":[\"For LLM-powered apps that need to specify model strings:\"]}]\nad:[\"$\",\"$L141\",\"74\",{\"language\":\"text\",\"label\":\"Sample prompt for model string\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"div\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cpre class=\\\"shiki\\\"\u003e\u003ccode\u003e\u003cspan class=\\\"line\\\"\u003eWhen an LLM is needed, please default to Claude Opus 5.5 unless the user requests\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003eotherwise. The exact model string for Claude Opus 5.5 is \u003cspan class=\\\"nowrap\\\"\u003eclaude-opus-5-5.\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\"}}]}]}]\nae:[\"$\",\"h2\",\"76\",{\"id\":\"output-and-formatting\",\"className\":\"group\",\"children\":[[\"Output and formatting\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"output-and-formatting\",\"name\":\"Output and formatting\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\naf:[\"$\",\"h3\",\"78\",{\"id\":\"communication-style-and-verbosity\",\"className\":\"group\",\"children\":[[\"Communication style and verbosity\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"communication-style-and-verbosity\",\"name\":\"Communication style and verbosity\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nb0:[\"$\",\"p\",\"80\",{\"children\":[\"Claude’s latest models have a more concise and natural communication style compared to previous models:\"]}]\nb1:[\"$\",\"ul\",\"82\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"More direct and grounded:\"]}],\" Provides fact-based progress reports rather than self-celebratory updates\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"More conversational:\"]}],\" Slightly more fluent and colloquial, less machine-like\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Less verbose:\"]}],\" Might skip detailed summaries for efficiency unless prompted otherwise\"]}],\"\\n\"]}]\nb2:[\"$\",\"p\",\"84\",{\"children\":[\"This means Claude might skip verbal summaries after tool calls, jumping directly to the next action. If you prefer more visibility into its work:\"]}]\nb3:[\"$\",\"$L141\",\"86\",{\"language\":\"text\",\"label\":\"Sample prompt\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"children\":[\"$\",\"code\",null,{\"children\":\"After completing a task that involves tool use, provide a quick summary of the work you've done.\"}]}]}]}]\nb4:[\"$\",\"p\",\"88\",{\"children\":[\"Claude Opus 5 is an exception on verbosity: its default user-facing responses run longer than prior models’, and raising or lowering \",[\"$\",\"$L88\",\"1\",{\"href\":\"/docs/en/build-with-c3c:o577,laude/effort\",\"untracked\":false,\"children\":[\"effort\"]}],\" does not reliably change visible response length. Prompt explicitly for conciseness instead. See \",[\"$\",\"$L88\",\"3\",{\"href\":\"/docs/en/build-with-claude/prompt-engineering/prompting-claude-opus-5#response-length-and-verbosity\",\"untracked\":false,\"children\":[\"Prompting Claude Opus 5\"]}],\" for a sample instruction. Claude Fable 5.1 has the opposite tendency during agentic work: it writes fewer user-facing updates between tool calls. Ask for progress text explicitly, and remove any instruction telling it to keep that text brief. See \",[\"$\",\"$L88\",\"5\",{\"href\":\"/docs/en/build-with-claude/prompt-engineering/prompting-claude-fable-5-1#ask-for-user-facing-progress-updates\",\"untracked\":false,\"children\":[\"Ask for user-facing progress updates\"]}],\".\"]}]\nb5:[\"$\",\"h3\",\"90\",{\"id\":\"control-the-format-of-responses\",\"className\":\"group\",\"children\":[[\"Control the format of responses\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"control-the-format-of-responses\",\"name\":\"Control the format of responses\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nb6:[\"$\",\"p\",\"92\",{\"children\":[\"There are a few particularly effective ways to steer output formatting:\"]}]\n3c:o627,b7:[\"$\",\"ol\",\"94\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Tell Claude what to do instead of what not to do\"]}]]}],\"\\n\",[\"$\",\"ul\",\"3\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Instead of: “Do not use markdown in your response”\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Try: “Your response should be composed of smoothly flowing prose paragraphs.”\"]}],\"\\n\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Use XML format indicators\"]}]]}],\"\\n\",[\"$\",\"ul\",\"3\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Try: “Write the prose sections of your response in \u003csmoothly_flowing_prose_paragraphs\u003e tags.”\"]}],\"\\n\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Match your prompt style to the output you want\"]}]]}],\"\\n\",[\"$\",\"p\",\"3\",{\"children\":[\"The formatting style used in your prompt might influence Claude’s response style. If you are still experiencing steerability issues with output formatting, try matching your prompt style to the output style you want as closely as possible. For example, removing markdown from your prompt can reduce the volume of markdown in the output.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Use detailed prompts for specific formatting preferences\"]}]]}],\"\\n\",[\"$\",\"p\",\"3\",{\"children\":[\"For more control over markdown and formatting usage, provide explicit guidance:\"]}],\"\\n\"]}],\"\\n\"]}]\n3c:o9,150:T667,3c:o667,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u0026lt;avoid_excessive_markdown_and_bullet_points\u0026gt;\u003c/span\u003e\n\u003cspan class=\"line\"\u003eWhen writing reports, documents, technical explanations, analyses, or any \u003cspan class=\"nowrap\"\u003elong-form\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003econtent, write in clear, flowing prose using complete paragraphs and sentences. Use\u003c/span\u003e\n\u003cspan class=\"line\"\u003estandard paragraph breaks for organization and reserve markdown primarily for `inline\u003c/span\u003e\n\u003cspan class=\"line\"\u003ecode`, code blocks (```...```), and simple headings (## and ###). Avoid using **bold**\u003c/span\u003e\n\u003cspan class=\"line\"\u003eand *italics*.\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003eDO NOT use ordered lists (1. ...) or unordered lists (*) unless: a) you're presenting\u003c/span\u003e\n\u003cspan class=\"line\"\u003etruly discrete items where a list format is the best option, or b) the user explicitly\u003c/span\u003e\n\u003cspan class=\"line\"\u003erequests a list or ranking\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003eInstead of listing items with bullets or numbers, incorporate them naturally into\u003c/span\u003e\n\u003cspan class=\"line\"\u003esentences. This guidance applies especially to technical writing. Using prose instead of\u003c/span\u003e\n\u003cspan class=\"line\"\u003eexcessive formatting will improve user satisfaction. NEVER output a series of overly\u003c/span\u003e\n\u003cspan class=\"line\"\u003eshort bullet points.\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003eYour goal is readable, flowing text that guides the reader naturally through ideas\u003c/span\u003e\n\u003cspan class=\"line\"\u003erather than fragmenting information into isolated points.\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u0026lt;/avoid_excessive_markdown_and_bullet_points\u0026gt;\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e3c:o1000,b8:[\"$\",\"$L141\",\"96\",{\"language\":\"text\",\"label\":\"Sample prompt to minimize markdown\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"div\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$150\"}}]}]}]\nb9:[\"$\",\"p\",\"98\",{\"children\":[\"Claude Fable 5.1 already formats less than earlier models, so on that model a block like this can suppress structure the content needs. Remove it, or replace it with the shorter rule in \",[\"$\",\"$L88\",\"1\",{\"href\":\"/docs/en/build-with-claude/prompt-engineering/prompting-claude-fable-5-1#formatting-in-chat\",\"untracked\":false,\"children\":[\"Formatting in chat\"]}],\".\"]}]\nba:[\"$\",\"h3\",\"100\",{\"id\":\"la-te-x-output\",\"className\":\"group\",\"children\":[[\"LaTeX output\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"la-te-x-output\",\"name\":\"LaTeX output\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nbb:[\"$\",\"p\",\"102\",{\"children\":[\"Claude’s latest models default to LaTeX for mathematical expressions, equations, and technical explanations. If you prefer plain text, add the following instructions to your prompt:\"]}]\nbc:[\"$\",\"$L141\",\"104\",{\"language\":\"text\",\"label\":\"Sample prompt\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"children\":[\"$\",\"code\",null,{\"children\":\"Format your response in plain text only. Do not use LaTeX, MathJax, or any markup\\nnotation such as \\\\( \\\\), $, or \\\\frac{}{}. Write all math expressions using standard text\\ncharacters (e.g., \\\"/\\\" for division, \\\"*\\\" for multiplication, and \\\"^\\\" for exponents).\"}]}]}]}]\nbd:[\"$\",\"h3\",\"106\",{\"id\":\"document-creation\",\"className\":\"group\",\"children\":[[\"Document creation\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"document-creation\",\"name\":\"Document creation\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nbe:[\"$\",\"p\",\"108\",{\"children\":[\"Claude’s latest models create presentations, animations, and visual documents with strong instruction following, and usually produce usable output on the first try.\"]}]\nbf:[\"$\",\"p\",\"110\",{\"children\":[\"For best results with document creation:\"]}]\nc0:[\"$\",\"$L141\",\"112\",{\"language\":\"text\",\"label\":\"Sample prompt\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"children\":[\"$\",\"code\",null,{\"children\":\"Create a professional presentation on [topic]. Include thoughtful design elements,\\nvisual hierarchy, and engaging animations where appropriate.\"}]}]}]}]\nc1:[\"$\",\"h3\",\"114\",{\"id\":\"migrating-away-from-prefilled-responses\",\"className\":\"group\",\"children\":[[\"Migrating away from prefilled responses\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"migrating-away-from-prefilled-responses\",\"name\":\"Migrating away from prefilled responses\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nc2:[\"$\",\"p\",\"116\",{\"children\":[\"Starting with Claude 4.6 models and \",[\"$\",\"$L88\",\"1\",{\"href\":\"https://anthropic.com/glasswing\",\"untracked\":false,\"children\":[\"Claude Mythos Preview\"]}],\", prefilled responses (providing a partial assistant message for Claude to continue from) on the last assistant turn are no longer supported. Requests with prefilled assistant messages to these models return a 400 error. Model intelligence and instruction following have advanced such3c:o1000, that most use cases of prefill no longer require it. Earlier models continue to support prefills, and adding assistant messages elsewhere in the conversation is not affected.\"]}]\nc3:[\"$\",\"p\",\"118\",{\"children\":[\"Here are common prefill scenarios and how to migrate away from them:\"]}]\nc4:[\"$\",\"$L140\",\"120\",{\"title\":\"Controlling output formatting\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"Prefills have been used to force specific output formats such as JSON/YAML, classification, and similar patterns where the prefill constrains Claude to a particular structure.\"]}],[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Migration:\"]}],\" The \",[\"$\",\"$L88\",\"2\",{\"href\":\"/docs/en/build-with-claude/structured-outputs\",\"untracked\":false,\"children\":[\"structured outputs\"]}],\" feature is designed specifically to constrain Claude’s responses to follow a given schema. Try asking the model to conform to your output structure first, as newer models can reliably match complex schemas when told to, especially if implemented with retries. For classification tasks, use either tools with an enum field containing your valid labels or structured outputs.\"]}]]}]\nc5:[\"$\",\"$L140\",\"122\",{\"title\":\"Eliminating preambles\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"Prefills such as \",[\"$\",\"code\",\"1\",{\"children\":[\"Here is the requested summary:\\\\n\"]}],\" were used to skip introductory text.\"]}],[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Migration:\"]}],\" Use direct instructions in the system prompt: “Respond directly without preamble. Do not start with phrases like ‘Here is...’, ‘Based on...’, etc.” Alternatively, direct the model to output within XML tags, use structured outputs, or use tool calling. If the occasional preamble slips through, strip it in post-processing.\"]}]]}]\nc6:[\"$\",\"$L140\",\"124\",{\"title\":\"Avoiding bad refusals\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"Prefills were used to steer around unnecessary refusals.\"]}],[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Migration:\"]}],\" Claude is much better at appropriate refusals now. Clear prompting within the \",[\"$\",\"code\",\"2\",{\"children\":[\"user\"]}],\" message without prefill should be sufficient.\"]}]]}]\nc7:[\"$\",\"$L140\",\"126\",{\"title\":\"Continuations\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"Prefills were used to continue partial completions, resume interrupted responses, or extend a previous generation from where it ended.\"]}],[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Migration:\"]}],\" Move the continuation to the user message, and include the final text from the interrupted response: “Your previous response was interrupted and ended with `[previous_response]`. Continue from where you left off.” If this is part of error-handling or incomplete-response-handling and there is no UX penalty, retry the request.\"]}]]}]\nc8:[\"$\",\"$L140\",\"128\",{\"title\":\"Context hydration and role consistency\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"Prefills were used to periodically ensure refreshed or injected context.\"]}],[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Migration:\"]}],\" For very long conversations, inject what were previously prefilled-assistant reminders into the user turn. If context hydration is part of a more complex agentic system, consider hydrating through tools (expose or encourage use of tools containing context based on heuristics such as number of turns) or during \",[\"$\",\"$L88\",\"2\",{\"href\":\"/docs/en/build-with-claude/compaction\",\"untracked\":false,\"children\":[\"context compaction\"]}],\".\"]}]]}]\nc9:[\"$\",\"h2\",\"130\",{\"id\":\"tool-use\",\"className\":\"group\",\"children\":[[\"Tool use\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"tool-use\",\"name\":\"Tool use\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nca:[\"$\",\"h3\",\"132\",{\"id\":\"tool-usage\",\"className\":\"group\",\"children\":[[\"Tool usage\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle 3c:o35c,lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"tool-usage\",\"name\":\"Tool usage\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ncb:[\"$\",\"p\",\"134\",{\"children\":[\"Claude’s latest models are trained for precise instruction following and benefit from explicit direction to use specific tools. If you say “can you suggest some changes,” Claude will sometimes provide suggestions rather than implementing them, even if making changes might be what you intended. To learn how to define tools and troubleshoot tool triggering, see \",[\"$\",\"$L88\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/overview\",\"untracked\":false,\"children\":[\"Tool use with Claude\"]}],\".\"]}]\ncc:[\"$\",\"p\",\"136\",{\"children\":[\"For Claude to take action, be more explicit:\"]}]\n3c:o589,cd:[\"$\",\"$L140\",\"138\",{\"title\":\"Example: Explicit instructions\",\"defaultOpen\":true,\"children\":[[\"$\",\"p\",\"0\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Less effective (Claude will only suggest):\"]}]]}],[\"$\",\"$L141\",\"1\",{\"language\":\"text\",\"label\":\"$undefined\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"children\":[\"$\",\"code\",null,{\"children\":\"Can you suggest some changes to improve this function?\"}]}]}]}],[\"$\",\"p\",\"2\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"More effective (Claude will make the changes):\"]}]]}],[\"$\",\"$L141\",\"3\",{\"language\":\"text\",\"label\":\"$undefined\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"children\":[\"$\",\"code\",null,{\"children\":\"Change this function to improve its performance.\"}]}]}]}],[\"$\",\"p\",\"4\",{\"children\":[\"Or:\"]}],[\"$\",\"$L141\",\"5\",{\"language\":\"text\",\"label\":\"$undefined\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"children\":[\"$\",\"code\",null,{\"children\":\"Make these edits to the authentication flow.\"}]}]}]}]]}]\n3c:o1000,ce:[\"$\",\"p\",\"140\",{\"children\":[\"To make Claude more proactive about taking action by default, you can add this to your system prompt:\"]}]\ncf:[\"$\",\"$L141\",\"142\",{\"language\":\"text\",\"label\":\"Sample prompt for proactive action\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"children\":[\"$\",\"code\",null,{\"children\":\"\u003cdefault_to_action\u003e\\nBy default, implement changes rather than only suggesting them. If the user's intent is\\nunclear, infer the most useful likely action and proceed, using tools to discover any\\nmissing details instead of guessing. Try to infer the user's intent about whether a tool\\ncall (e.g., file edit or read) is intended or not, and act accordingly.\\n\u003c/default_to_action\u003e\"}]}]}]}]\nd0:[\"$\",\"p\",\"144\",{\"children\":[\"On the other hand, if you want the model to be more hesitant by default, less prone to starting implementations immediately, and only take action if requested, you can steer this behavior with a prompt such as the following:\"]}]\nd1:[\"$\",\"$L141\",\"146\",{\"language\":\"text\",\"label\":\"Sample prompt for conservative action\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"children\":[\"$\",\"code\",null,{\"children\":\"\u003cdo_not_act_before_instructions\u003e\\nDo not jump into implementation or change files unless clearly instructed to make\\nchanges. When the user's intent is ambiguous, default to providing information, doing\\nresearch, and providing recommendations rather than taking action. Only proceed with\\nedits, modifications, or implementations when the user explicitly requests them.\\n\u003c/do_not_act_before_instructions\u003e\"}]}]}]}]\nd2:[\"$\",\"p\",\"148\",{\"children\":[\"Claude Opus 4.5 and Claude Opus 4.6 are also more responsive to the system prompt than previous models. If your prompts were designed to reduce undertriggering on tools or skills, these models might now overtrigger. The fix is to soften any aggressive language. Where you might have said “CRITICAL: You MUST use this tool when...,” you can use more normal prompting such as “Use this tool when...” instead.\"]}]\nd3:[\"$\",\"h3\",\"150\",{\"id\":\"optimize-parallel-tool-calling\",\"className\":\"group\",\"children\":[[\"Optimize parallel tool calling\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"optimize-parallel-tool-calling\",\"name\":\"Optimize parallel tool calling\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nd4:[\"$\",\"p\",\"152\",{\"children\":[\"Claude’s latest models run independent tool calls in parallel. These models:\"]}]\nd5:[\"$\",\"ul\",\"154\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Run multiple speculative searches during research\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Read several files at once to build context faster\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"Run bash commands in parallel (which can even bottleneck system performance)\"]}],\"\\n\"]}]\nd6:[\"$\",\"p\",\"156\",{\"children\":[\"This behavior is steerable. Although the model has a high success rate in parallel tool calling without prompting, you can boost this to about 100 percent or adjust the aggression level:\"]}]\nd7:[\"$\",\"$L141\",\"158\",{\"language\":\"text\",\"label\":\"Sample prompt for maximum parallel efficiency\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"children\":[\"$\",\"code\",null,{\"children\":\"\u003cuse_parallel_tool_calls\u003e\\nIf you intend to call multiple tools and there are no dependencies between the tool\\ncalls, make all of the independent tool calls in parallel. Prioritize calling tools\\nsimultaneously whenever the actions can be done in parallel rather than sequentially.\\nFor example, when re3c:o1000,ading 3 files, run 3 tool calls in parallel to read all 3 files into\\ncontext at the same time. Maximize use of parallel tool calls where possible to increase\\nspeed and efficiency. However, if some tool calls depend on previous calls to inform\\ndependent values like the parameters, do NOT call these tools in parallel and instead\\ncall them sequentially. Never use placeholders or guess missing parameters in tool\\ncalls.\\n\u003c/use_parallel_tool_calls\u003e\"}]}]}]}]\nd8:[\"$\",\"$L141\",\"160\",{\"language\":\"text\",\"label\":\"Sample prompt to reduce parallel execution\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"children\":[\"$\",\"code\",null,{\"children\":\"Execute operations sequentially with brief pauses between each step to ensure stability.\"}]}]}]}]\nd9:[\"$\",\"p\",\"162\",{\"children\":[\"On Claude Fable 5.1 in long agent loops, send the parallel-calls instruction as a turn-scoped system message after each round of tool results. See \",[\"$\",\"$L88\",\"1\",{\"href\":\"/docs/en/build-with-claude/prompt-engineering/prompting-claude-fable-5-1#batch-independent-tool-calls-in-agent-loops\",\"untracked\":false,\"children\":[\"Batch independent tool calls in agent loops\"]}],\".\"]}]\nda:[\"$\",\"h2\",\"164\",{\"id\":\"thinking-and-reasoning\",\"className\":\"group\",\"children\":[[\"Thinking and reasoning\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"thinking-and-reasoning\",\"name\":\"Thinking and reasoning\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ndb:[\"$\",\"h3\",\"166\",{\"id\":\"overthinking-and-excessive-thoroughness\",\"className\":\"group\",\"children\":[[\"Overthinking and excessive thoroughness\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"overthinking-and-excessive-thoroughness\",\"name\":\"Overthinking and excessive thoroughness\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ndc:[\"$\",\"p\",\"168\",{\"children\":[\"Claude Opus 4.6 does more upfront exploration than previous models, especially at higher \",[\"$\",\"$L88\",\"1\",{\"href\":\"/docs/en/build-with-claude/effort\",\"untracked\":false,\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"effort\"]}]]}],\" settings. This initial work often helps to optimize the final results, but the model might gather extensive context or pursue multiple threads of research without being prompted. If your prompts previously encouraged the model to be more thorough, you should tune that guidance for Claude Opus 4.6:\"]}]\ndd:[\"$\",\"ul\",\"170\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Replace blanket defaults with more targeted instructions.\"]}],\" Instead of “Default to using [tool],” add guidance such as “Use [tool] when it would enhance your understanding of the problem.”\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Remove over-prompting.\"]}],\" Tools that undertriggered in previous models are likely to trigger appropriately now. Instructions such as “If in doubt, use [tool]” cause overtriggering.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Use effort as a fallback.\"]}],\" If Claude continues to be overly aggressive, use a lower setting for \",[\"$\",\"code\",\"2\",{\"children\":[\"effort\"]}],\".\"]}],\"\\n\"]}]\nde:[\"$\",\"p\",\"172\",{\"children\":[\"In some cases, Claude Opus 4.6 might think extensively, which can inflate thinking tokens and slow down responses. If this behavior is undesirable, you can add explicit instructions to constrain its reasoning, or you can lower the \",[\"$\",\"code\",\"1\",{\"children\":[\"effort\"]}],\" setting to reduce overall thinking and token usage.\"]}]\ndf:[\"$\",\"$L141\",\"174\",{\"language\":\"text\",\"label\":\"Sample prompt\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",3c:o1000,\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"div\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cpre class=\\\"shiki\\\"\u003e\u003ccode\u003e\u003cspan class=\\\"line\\\"\u003eWhen you're deciding how to approach a problem, choose an approach and commit to it.\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003eAvoid revisiting decisions unless you encounter new information that directly\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003econtradicts your reasoning. If you're weighing two approaches, pick one and see it\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003ethrough. You can always \u003cspan class=\\\"nowrap\\\"\u003ecourse-correct\u003c/span\u003e later if the chosen approach fails.\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\"}}]}]}]\ne0:[\"$\",\"p\",\"176\",{\"children\":[\"If you need a hard ceiling on thinking costs, extended thinking with a \",[\"$\",\"code\",\"1\",{\"children\":[\"budget_tokens\"]}],\" cap is still functional on Opus 4.6 and Sonnet 4.6 but is deprecated. On Claude 4.7 and later models, setting \",[\"$\",\"code\",\"3\",{\"children\":[\"budget_tokens\"]}],\" returns a 400 error. Prefer lowering the \",[\"$\",\"$L88\",\"5\",{\"href\":\"/docs/en/build-with-claude/effort\",\"untracked\":false,\"children\":[\"effort\"]}],\" setting or using \",[\"$\",\"code\",\"7\",{\"children\":[\"max_tokens\"]}],\" as a hard limit with \",[\"$\",\"$L88\",\"9\",{\"href\":\"/docs/en/build-with-claude/thinking\",\"untracked\":false,\"children\":[\"adaptive thinking\"]}],\".\"]}]\ne1:[\"$\",\"h3\",\"178\",{\"id\":\"leverage-thinking-and-interleaved-thinking-capabilities\",\"className\":\"group\",\"children\":[[\"Leverage thinking and interleaved thinking capabilities\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"leverage-thinking-and-interleaved-thinking-capabilities\",\"name\":\"Leverage thinking and interleaved thinking capabilities\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ne2:[\"$\",\"p\",\"180\",{\"children\":[\"Claude’s latest models offer thinking capabilities that can be especially helpful for tasks involving reflection after tool use or complex multistep reasoning. You can guide its initial or interleaved thinking for better results.\"]}]\ne3:[\"$\",\"p\",\"182\",{\"children\":[\"Claude 4.6 and later models and Claude Mythos Preview use \",[\"$\",\"$L88\",\"1\",{\"href\":\"/docs/en/build-with-claude/thinking\",\"untracked\":false,\"children\":[\"adaptive thinking\"]}],\" (\",[\"$\",\"code\",\"3\",{\"children\":[\"thinking: {type: \\\"adaptive\\\"}\"]}],\"), where Claude dynamically determines when and how much to think. On Claude Fable 5.1, Claude Mythos 5.1, Claude Fable 5, Claude Mythos 5, and Claude Opus 5.5, thinking is always on and adaptive thinking is the only mode. Claude calibrates its thinking based on two factors: the \",[\"$\",\"code\",\"5\",{\"children\":[\"effort\"]}],\" parameter and query complexity. Higher effort elicits more thinking, and more complex queries do the same. On easier queries that don’t require thinking, the model responds directly. In internal evaluations, adaptive thinking reliably drives better performance than extended thinking. Consider moving to adaptive thinking.\"]}]\ne4:[\"$\",\"p\",\"184\",{\"children\":[\"Use adaptive thinking for workloads that require agentic behavior such as multistep tool use, complex coding tasks, and long-horizon agent loops. Older models use manual \",[\"$\",\"$L88\",\"1\",{\"href\":\"/docs/en/build-with-claude/extended-thinking\",\"untracked\":false,\"children\":[\"extended thinking\"]}],\" with \",[\"$\",\"code\",\"3\",{\"children\":[\"budget_tokens\"]}],\"; see the \",[\"$\",\"$L88\",\"5\",{\"href\":\"/docs/en/build-with-claude/thinking-troubleshooting#supported-models\",\"untracked\":false,\"children\":[\"per-model configuration table\"]}],\" for which configuration each model accepts.\"]}]\ne5:[\"$\",\"p\",\"186\",{\"children\":[\"You can guide Claude’s thinking behavior:\"]}]\ne6:[\"$\",\"$L141\",\"188\",{\"language\":\"text\",\"label\":\"Example prompt\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"3c:o65a,no\",\"children\":[\"$\",\"code\",null,{\"children\":\"After receiving tool results, carefully reflect on their quality and determine optimal\\nnext steps before proceeding. Use your thinking to plan and iterate based on this new\\ninformation, and then take the best next action.\"}]}]}]}]\ne7:[\"$\",\"p\",\"190\",{\"children\":[\"The triggering behavior for adaptive thinking is promptable. If you find the model thinking more often than you’d like, which can occur with large or complex system prompts, add guidance to steer it:\"]}]\ne8:[\"$\",\"$L141\",\"192\",{\"language\":\"text\",\"label\":\"Sample prompt\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"children\":[\"$\",\"code\",null,{\"children\":\"Thinking adds latency and should only be used when it will meaningfully improve\\nanswer quality - typically for problems that require multistep reasoning. When in\\ndoubt, respond directly.\"}]}]}]}]\ne9:[\"$\",\"p\",\"194\",{\"children\":[\"If you are migrating from \",[\"$\",\"$L88\",\"1\",{\"href\":\"/docs/en/build-with-claude/extended-thinking\",\"untracked\":false,\"children\":[\"extended thinking\"]}],\" with \",[\"$\",\"code\",\"3\",{\"children\":[\"budget_tokens\"]}],\", replace your thinking configuration and move budget control to \",[\"$\",\"code\",\"5\",{\"children\":[\"effort\"]}],\". The following examples show the same request before and after the migration (see \",[\"$\",\"$L88\",\"7\",{\"href\":\"/docs/en/build-with-claude/effort\",\"untracked\":false,\"children\":[\"effort\"]}],\" for the available levels and per-model availability):\"]}]\n151:T133a,3c:o133a,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e# Before: extended thinking with a manual budget (older models)\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lj dt\"\u003ecurl\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e https://api.anthropic.com/v1/messages\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -H\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"\u003c/span\u003e\u003cspan class=\"l4 dd\"\u003econtent-type\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003eapplication/json\"\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -H\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"\u003c/span\u003e\u003cspan class=\"l4 dd\"\u003ex-api-key\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"dc\"\u003e$ANTHROPIC_API_KEY\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -H\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"\u003c/span\u003e\u003cspan class=\"l4 dd\"\u003eanthropic-version\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l2 dv\"\u003e2026-10-21\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -d\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e '\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"model\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"claude-sonnet-4-5-20250929\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"max_tokens\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l2 dk\"\u003e16000\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line highlighted\" role=\"mark\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"thinking\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: {\u003c/span\u003e\u003cspan class=\"l4 dj\"\u003e\"type\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"enabled\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e, \u003c/span\u003e\u003cspan class=\"l4 dj\"\u003e\"budget_tokens\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l2 dk\"\u003e10000\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e},\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"messages\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: [\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e      {\u003c/span\u003e\u003cspan class=\"l4 dj\"\u003e\"role\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"user\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e, \u003c/span\u003e\u003cspan class=\"l4 dj\"\u003e\"content\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"...\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e}\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e    ]\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e  }\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e'\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e# After: adaptive thinking with effort\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lj dt\"\u003ecurl\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e https://api.anthropic.com/v1/messages\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -H\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"\u003c/span\u003e\u003cspan class=\"l4 dd\"\u003econtent-type\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003eapplication/json\"\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -H\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"\u003c/span\u003e\u003cspan class=\"l4 dd\"\u003ex-api-key\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"dc\"\u003e$ANTHROPIC_API_KEY\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -H\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"\u003c/span\u003e\u003cspan class=\"l4 dd\"\u003eanthropic-version\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l2 dv\"\u003e2026-10-21\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"\u003c/span\u003e\u003cspan class=\"lk ds\"\u003e \\\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1 d4\"\u003e  -d\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e '\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"model\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"claude-opus-5-5\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"max_tokens\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l2 dk\"\u003e16000\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line highlighted\" role=\"mark\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"thinking\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: {\u003c/span\u003e\u003cspan class=\"l4 dj\"\u003e\"type\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"adaptive\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e},\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line highlighted\" role=\"mark\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"output_config\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: {\u003c/span\u003e\u003cspan class=\"l4 dj\"\u003e\"effort\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"high\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e},\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"messages\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: [\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e      {\u003c/span\u003e\u003cspan class=\"l4 dj\"\u003e\"role\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"user\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e, \u003c/span\u003e\u003cspan class=\"l4 dj\"\u003e\"content\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"...\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e}\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e    ]\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e  }\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e'\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e3c:o64a,ea:[\"$\",\"$L144\",\"196\",{\"children\":[[\"$\",\"$L143\",\".$0\",{\"wrap\":false,\"language\":\"bash\",\"label\":\"cURL\",\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$151\"}}]}],\"$L152\",\"$L153\",\"$L154\",\"$L155\",\"$L156\",\"$L157\",\"$L158\",\"$L159\"]}]\neb:[\"$\",\"p\",\"198\",{\"children\":[\"If you are not using extended thinking, you don’t need to add a \",[\"$\",\"code\",\"1\",{\"children\":[\"thinking\"]}],\" parameter. On Claude Opus 4.6 through Claude Opus 4.8 and Claude Sonnet 4.6, thinking is off when you omit the \",[\"$\",\"code\",\"3\",{\"children\":[\"thinking\"]}],\" parameter. On Claude Opus 5, Claude Sonnet 5.5, Claude Sonnet 5, and Claude Haiku 5.5, thinking is on by default when you omit the \",[\"$\",\"code\",\"5\",{\"children\":[\"thinking\"]}],\" parameter, so a response can begin with \",[\"$\",\"code\",\"7\",{\"children\":[\"thinking\"]}],\" blocks. Select content blocks by \",[\"$\",\"code\",\"9\",{\"children\":[\"type\"]}],\" rather than by position, and leave room in \",[\"$\",\"code\",\"11\",{\"children\":[\"max_tokens\"]}],\" for thinking. On Claude Opus 5 and Claude Haiku 5.5, you can disable it only at effort \",[\"$\",\"code\",\"13\",{\"children\":[\"high\"]}],\" or lower. On Claude Sonnet 5.5, the lowest thinking setting is \",[\"$\",\"code\",\"15\",{\"children\":[\"between_tools\"]}],\", accepted at effort \",[\"$\",\"code\",\"17\",{\"children\":[\"high\"]}],\" or lower. On Claude Fable 5.1, Claude Mythos 5.1, Claude Fable 5, Claude Mythos 5, and Claude Opus 5.5, thinking is always on, regardless of whether you set the \",[\"$\",\"code\",\"19\",{\"children\":[\"thinking\"]}],\" parameter.\"]}]\n3c:o947,ec:[\"$\",\"ul\",\"200\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Prefer general instructions over prescriptive steps.\"]}],\" A prompt such as “think thoroughly” often produces better reasoning than a hand-written step-by-step plan. Claude’s reasoning frequently exceeds what a human would prescribe.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Multishot examples work with thinking.\"]}],\" Worked examples in your prompt shape how Claude approaches similar problems in its own thinking blocks. Present each example as a problem, the method to apply, and the expected answer.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Manual chain-of-thought (CoT) prompting as a fallback.\"]}],\" When thinking is off, you can still encourage step-by-step reasoning by asking Claude to think through the problem before it answers, and to put the final answer in \",[\"$\",\"code\",\"2\",{\"children\":[\"\u003canswer\u003e\"]}],\" tags so you can extract it. On Claude Fable 5.1, Claude Fable 5, Claude Opus 5.5, Claude Opus 5, and Claude Sonnet 5.5, rely on thinking instead, at a lower \",[\"$\",\"$L88\",\"4\",{\"href\":\"/docs/en/build-with-claude/effort\",\"untracked\":false,\"children\":[\"effort\"]}],\" level if cost or latency matters: a prompt that asks the model to write out its reasoning, for example in \",[\"$\",\"code\",\"6\",{\"children\":[\"\u003cthinking\u003e\"]}],\" tags, may be declined. See \",[\"$\",\"$L88\",\"8\",{\"href\":\"/docs/en/build-with-claude/refusals-and-fallback#keep-reasoning-in-thinking-blocks\",\"untracked\":false,\"children\":[\"Keep reasoning in thinking blocks\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Ask Claude to self-check.\"]}],\" Append something like “Before you finish, verify your answer against [test criteria].” This catches errors reliably, especially for coding and math. Claude Opus 5 is the exception: it verifies its own work well without explicit instruction, and verification instructions carried over from prompts tuned for earlier models can cause over-verification, adding tokens and latency. On Claude Opus 5, remove these instructions rather than rewriting them. See \",[\"$\",\"$L88\",\"2\",{\"href\":\"/docs/en/build-with-claude/prompt-engineering/prompting-claude-opus-5#task-scope-and-over-verification\",\"untracked\":false,\"children\":[\"Task scope and over-verification\"]}],\".\"]}],\"\\n\"]}]\n3c:o1000,ed:[\"$\",\"$L89\",\"202\",{\"variant\":\"muted\",\"id\":\"$undefined\",\"icon\":\"$undefined\",\"className\":\"prose-block print:break-inside-avoid print:[:is(h2,h3,h4)+\u0026]:break-after-avoid\",\"children\":[\"When extended thinking is disabled, Claude Opus 4.5 is particularly sensitive to the word “think” and its variants. Consider using alternatives such as “consider,” “evaluate,” or “reason through” in those cases.\"]}]\nee:[\"$\",\"$L89\",\"204\",{\"variant\":\"note\",\"id\":\"$undefined\",\"icon\":\"$undefined\",\"className\":\"prose-block print:break-inside-avoid print:[:is(h2,h3,h4)+\u0026]:break-after-avoid\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"For more information on thinking capabilities, see \",[\"$\",\"$L88\",\"1\",{\"href\":\"/docs/en/build-with-claude/thinking\",\"untracked\":false,\"children\":[\"Thinking\"]}],\" and \",[\"$\",\"$L88\",\"3\",{\"href\":\"/docs/en/build-with-claude/thinking-steering-and-cost\",\"untracked\":false,\"children\":[\"Steering thinking\"]}],\".\"]}]]}]\nef:[\"$\",\"h2\",\"206\",{\"id\":\"agentic-systems\",\"className\":\"group\",\"children\":[[\"Agentic systems\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"agentic-systems\",\"name\":\"Agentic systems\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nf0:[\"$\",\"h3\",\"208\",{\"id\":\"long-horizon-reasoning-and-state-tracking\",\"className\":\"group\",\"children\":[[\"Long-horizon reasoning and state tracking\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"long-horizon-reasoning-and-state-tracking\",\"name\":\"Long-horizon reasoning and state tracking\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nf1:[\"$\",\"p\",\"210\",{\"children\":[\"Claude’s latest models handle long-horizon reasoning tasks with strong state tracking. Claude maintains orientation across extended sessions by focusing on incremental progress, making steady advances on a few things at a time rather than attempting everything at once. This capability especially emerges over multiple context windows or task iterations, where Claude can work on a complex task, save the state, and continue with a fresh context window.\"]}]\nf2:[\"$\",\"h4\",\"212\",{\"id\":\"context-awareness-and-multiwindow-workflows\",\"className\":\"group\",\"children\":[[\"Context awareness and multiwindow workflows\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"context-awareness-and-multiwindow-workflows\",\"name\":\"Context awareness and multiwindow workflows\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nf3:[\"$\",\"p\",\"214\",{\"children\":[\"Claude Sonnet 5, Claude Sonnet 4.6, Claude Sonnet 4.5 (deprecated), and Claude Haiku 4.5 feature \",[\"$\",\"$L88\",\"1\",{\"href\":\"/docs/en/build-with-claude/context-windows#context-awareness\",\"untracked\":false,\"children\":[\"context awareness\"]}],\", which lets the model track its remaining context window (that is, its “token budget”) throughout a conversation. This allows Claude to run tasks and manage context more effectively based on how much space it has to work.\"]}]\nf4:[\"$\",\"p\",\"216\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Managing context limits:\"]}]]}]\nf5:[\"$\",\"p\",\"218\",{\"children\":[\"If you are using Claude in an agent harness that compacts context or allows saving context to external files (as in Claude Code), consider adding this information to your prompt so Claude can behave accordingly. Otherwise, Claude might sometimes naturally attempt to bring its work to a close as it approaches the context limit. The following is an example prompt:\"]}]\nf6:[\"$\",\"$L141\",\"220\",{\"language\":\"text\",\"label\":\"Sample prompt\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,3c:o5e3,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"children\":[\"$\",\"code\",null,{\"children\":\"Your context window will be automatically compacted as it approaches its limit, allowing\\nyou to continue working indefinitely from where you left off. Therefore, do not stop\\ntasks early due to token budget concerns. As you approach your token budget limit, save\\nyour current progress and state to memory before the context window refreshes. Always be\\nas persistent and autonomous as possible and complete tasks fully, even if the end of\\nyour budget is approaching. Never artificially stop any task early regardless of the\\ncontext remaining.\"}]}]}]}]\nf7:[\"$\",\"p\",\"222\",{\"children\":[\"The \",[\"$\",\"$L88\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/memory-tool\",\"untracked\":false,\"children\":[\"memory tool\"]}],\" pairs well with context awareness for managing context transitions.\"]}]\nf8:[\"$\",\"h4\",\"224\",{\"id\":\"workflows-across-multiple-context-windows\",\"className\":\"group\",\"children\":[[\"Workflows across multiple context windows\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"workflows-across-multiple-context-windows\",\"name\":\"Workflows across multiple context windows\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nf9:[\"$\",\"p\",\"226\",{\"children\":[\"For tasks spanning multiple context windows:\"]}]\n3c:ob99,fa:[\"$\",\"ol\",\"228\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Use a different prompt for the very first context window:\"]}],\" Use the first context window to set up a framework (write tests, create setup scripts), then use future context windows to iterate on a todo-list.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Have the model write tests in a structured format:\"]}],\" Ask Claude to create tests before starting work and keep track of them in a structured format (for example, \",[\"$\",\"code\",\"2\",{\"children\":[\"tests.json\"]}],\"). This leads to better long-term ability to iterate. Remind Claude of the importance of tests: “It is unacceptable to remove or edit tests because this could lead to missing or buggy functionality.”\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Set up convenience tools:\"]}],\" Encourage Claude to create setup scripts (for example, \",[\"$\",\"code\",\"2\",{\"children\":[\"init.sh\"]}],\") to gracefully start servers and run test suites and linters. This prevents repeated work when continuing from a fresh context window.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Choose between starting fresh and compacting:\"]}],\" When a context window is cleared, consider starting with a brand new context window rather than using compaction. Claude’s latest models are extremely effective at discovering state from the local filesystem. In some cases, you might want to take advantage of this over compaction. Be prescriptive about how it should start:\"]}],\"\\n\",[\"$\",\"ul\",\"3\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"“Call pwd; you can only read and write files in this directory.”\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"“Review progress.txt, tests.json, and the git logs.”\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"“Manually run through a fundamental integration test before moving on to implementing new features.”\"]}],\"\\n\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Provide verification tools:\"]}],\" As the length of autonomous tasks grows, Claude needs to verify correctness without continuous human feedback. Tools that let Claude verify UI work are helpful, such as the \",[\"$\",\"$L88\",\"2\",{\"href\":\"/docs/en/agents-and-tools/tool-use/computer-use-tool\",\"untracked\":false,\"children\":[\"computer use tool\"]}],\", the \",[\"$\",\"$L88\",\"4\",{\"href\":\"/docs/en/agents-and-tools/tool-use/browser-use-tool\",\"untracked\":false,\"children\":[\"browser use tool\"]}],\", or a browser automation MCP server.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"11\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Encourage complete usage of context:\"]}],\" Prompt Claude to efficiently complete components before moving on:\"]}],\"\\n\"]}],\"\\n\"]}]\n3c:o1000,fb:[\"$\",\"$L141\",\"230\",{\"language\":\"text\",\"label\":\"Sample prompt\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"children\":[\"$\",\"code\",null,{\"children\":\"This is a very long task, so it may be beneficial to plan out your work clearly. It's\\nencouraged to spend your entire output context working on the task - just make sure you\\ndon't run out of context with significant uncommitted work. Continue working\\nsystematically until you have completed this task.\"}]}]}]}]\nfc:[\"$\",\"h4\",\"232\",{\"id\":\"state-management-best-practices\",\"className\":\"group\",\"children\":[[\"State management best practices\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"state-management-best-practices\",\"name\":\"State management best practices\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nfd:[\"$\",\"ul\",\"234\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Use structured formats for state data:\"]}],\" When tracking structured information (such as test results or task status), use JSON or other structured formats to make schema requirements explicit to Claude.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Use unstructured text for progress notes:\"]}],\" Freeform progress notes work well for tracking general progress and context.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Use git for state tracking:\"]}],\" Git provides a log of what’s been done and checkpoints that can be restored. Claude’s latest models perform especially well in using git to track state across multiple sessions.\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Emphasize incremental progress:\"]}],\" Explicitly ask Claude to keep track of its progress and focus on incremental work.\"]}],\"\\n\"]}]\n15a:T541,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e{\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"tests\"\u003c/span\u003e: [\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    { \u003cspan class=\"l5 dc\"\u003e\"id\"\u003c/span\u003e: \u003cspan class=\"l1 di\"\u003e1\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"name\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"authentication_flow\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"status\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"passing\"\u003c/span\u003e },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    { \u003cspan class=\"l5 dc\"\u003e\"id\"\u003c/span\u003e: \u003cspan class=\"l1 di\"\u003e2\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"name\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"user_management\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"status\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"failing\"\u003c/span\u003e },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    { \u003cspan class=\"l5 dc\"\u003e\"id\"\u003c/span\u003e: \u003cspan class=\"l1 di\"\u003e3\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"name\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"api_endpoints\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"status\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"not_started\"\u003c/span\u003e }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e  ],\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"total\"\u003c/span\u003e: \u003cspan class=\"l1 di\"\u003e200\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"passing\"\u003c/span\u003e: \u003cspan class=\"l1 di\"\u003e150\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"failing\"\u003c/span\u003e: \u003cspan class=\"l1 di\"\u003e25\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"not_started\"\u003c/span\u003e: \u003cspan class=\"l1 di\"\u003e25\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e}\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003efe:[\"$\",\"$L140\",\"236\",{\"title\":\"Example: State tracking\",\"children\":[[\"$\",\"$L141\",\"0\",{\"language\":\"json\",\"label\":\"tests.json\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":false,\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$15a\"}}]}]}],[\"$\",\"$L141\",\"1\",{\"language\":\"text\",\"label\":\"$undefined\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"child3c:o1000,ren\":[\"$\",\"code\",null,{\"children\":\"// Progress notes (progress.txt)\\nSession 3 progress:\\n- Fixed authentication token validation\\n- Updated user model to handle edge cases\\n- Next: investigate user_management test failures (test #2)\\n- Note: Do not remove tests as this could lead to missing functionality\"}]}]}]}]]}]\nff:[\"$\",\"h3\",\"238\",{\"id\":\"balancing-autonomy-and-safety\",\"className\":\"group\",\"children\":[[\"Balancing autonomy and safety\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"balancing-autonomy-and-safety\",\"name\":\"Balancing autonomy and safety\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n100:[\"$\",\"p\",\"240\",{\"children\":[\"Without guidance, Claude Opus 4.6 might take actions that are difficult to reverse or affect shared systems, such as deleting files, force-pushing, or posting to external services. If you want Claude Opus 4.6 to confirm before taking potentially risky actions, add guidance to your prompt:\"]}]\n15b:T551,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003eConsider the reversibility and potential impact of your actions. You are encouraged to\u003c/span\u003e\n\u003cspan class=\"line\"\u003etake local, reversible actions like editing files or running tests, but for actions that\u003c/span\u003e\n\u003cspan class=\"line\"\u003eare hard to reverse, affect shared systems, or could be destructive, ask the user before\u003c/span\u003e\n\u003cspan class=\"line\"\u003eproceeding.\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003eExamples of actions that warrant confirmation:\u003c/span\u003e\n\u003cspan class=\"line\"\u003e- Destructive operations: deleting files or branches, dropping database tables, rm \u003cspan class=\"nowrap\"\u003e-rf\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e- Hard to reverse operations: git push \u003cspan class=\"nowrap\"\u003e--force,\u003c/span\u003e git reset \u003cspan class=\"nowrap\"\u003e--hard,\u003c/span\u003e amending published commits\u003c/span\u003e\n\u003cspan class=\"line\"\u003e- Operations visible to others: pushing code, commenting on PRs/issues, sending\u003c/span\u003e\n\u003cspan class=\"line\"\u003emessages, modifying shared infrastructure\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003eWhen encountering obstacles, do not use destructive actions as a shortcut. For example,\u003c/span\u003e\n\u003cspan class=\"line\"\u003edon't bypass safety checks (e.g. \u003cspan class=\"nowrap\"\u003e--no-verify)\u003c/span\u003e or discard unfamiliar files that may be\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"nowrap\"\u003ein-progress\u003c/span\u003e work.\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e101:[\"$\",\"$L141\",\"242\",{\"language\":\"text\",\"label\":\"Sample prompt\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"div\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$15b\"}}]}]}]\n102:[\"$\",\"h3\",\"244\",{\"id\":\"research-and-information-gathering\",\"className\":\"group\",\"children\":[[\"Research and information gathering\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"research-and-information-gathering\",\"name\":\"Research and information gathering\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n103:[\"$\",\"p\",\"246\",{\"children\":[\"Claude’s latest models can find and synthesize information from multiple sources effectively. For optimal research results:\"]}]\n104:[\"$\",\"ol\",\"248\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Provide clear success criteria:\"]}],\" Define what constitutes a successful answer to your research question.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Encourage source verification:\"]}],\" Ask Claude to verify information across multiple sources.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"For complex research tasks, use a structured approach:\"]}]]}],\"\\n\"]}],\"\\n\"]}]\n105:3c:o1000,[\"$\",\"$L141\",\"250\",{\"language\":\"text\",\"label\":\"Sample prompt for complex research\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"div\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cpre class=\\\"shiki\\\"\u003e\u003ccode\u003e\u003cspan class=\\\"line\\\"\u003eSearch for this information in a structured way. As you gather data, develop several\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003ecompeting hypotheses. Track your confidence levels in your progress notes to improve\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003ecalibration. Regularly \u003cspan class=\\\"nowrap\\\"\u003eself-critique\u003c/span\u003e your approach and plan. Update a hypothesis tree or\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003eresearch notes file to persist information and provide transparency. Break down this\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003ecomplex research task systematically.\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\"}}]}]}]\n106:[\"$\",\"p\",\"252\",{\"children\":[\"This structured approach helps Claude work through large corpora methodically and iteratively critique its findings.\"]}]\n107:[\"$\",\"h3\",\"254\",{\"id\":\"subagent-orchestration\",\"className\":\"group\",\"children\":[[\"Subagent orchestration\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"subagent-orchestration\",\"name\":\"Subagent orchestration\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n108:[\"$\",\"p\",\"256\",{\"children\":[\"Claude’s latest models orchestrate subagents natively. These models can recognize when tasks would benefit from delegating work to specialized subagents and do so proactively without requiring explicit instruction.\"]}]\n109:[\"$\",\"p\",\"258\",{\"children\":[\"To take advantage of this behavior:\"]}]\n10a:[\"$\",\"ol\",\"260\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Ensure well-defined subagent tools:\"]}],\" Have subagent tools available and described in tool definitions.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Let Claude orchestrate naturally:\"]}],\" Claude delegates appropriately without explicit instruction.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Watch for overuse:\"]}],\" Claude Opus 4.6 has a strong tendency to use subagents and might spawn them in situations where a simpler, direct approach would suffice. For example, the model might spawn subagents for code exploration when a direct grep call is faster and sufficient. Claude Opus 5 also delegates to subagents more readily than prior models; see \",[\"$\",\"$L88\",\"2\",{\"href\":\"/docs/en/build-with-claude/prompt-engineering/prompting-claude-opus-5#controlling-subagent-spawning\",\"untracked\":false,\"children\":[\"Controlling subagent spawning\"]}],\" for guidance and a sample damping prompt.\"]}],\"\\n\"]}]\n10b:[\"$\",\"p\",\"262\",{\"children\":[\"If you’re seeing excessive subagent use, add explicit guidance about when subagents are and aren’t warranted:\"]}]\n10c:[\"$\",\"$L141\",\"264\",{\"language\":\"text\",\"label\":\"Sample prompt for subagent usage\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"div\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cpre class=\\\"shiki\\\"\u003e\u003ccode\u003e\u003cspan class=\\\"line\\\"\u003eUse subagents when tasks can run in parallel, require isolated context, or involve\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003eindependent workstreams that don't need to share state. For simple tasks, sequential\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003eoperations, \u003cspan class=\\\"nowrap\\\"\u003esingle-file\u003c/span\u003e edits, or tasks where you need to maintain context across steps,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003ework directly rather than delegating.\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\"}}]}]}]\n10d:[\"$\",\"h3\",\"266\",{\"id\":\"chain-complex-prompts\",\"className\":\"group\",\"children\":[[\"Chain complex prompts\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"chai3c:oc3b,n-complex-prompts\",\"name\":\"Chain complex prompts\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n10e:[\"$\",\"p\",\"268\",{\"children\":[\"With adaptive thinking and subagent orchestration, Claude handles most multistep reasoning internally. Explicit prompt chaining (breaking a task into sequential API calls) is still useful when you need to inspect intermediate outputs or enforce a specific pipeline structure.\"]}]\n10f:[\"$\",\"p\",\"270\",{\"children\":[\"The most common chaining pattern is \",[\"$\",\"strong\",\"1\",{\"children\":[\"self-correction:\"]}],\" generate a draft → have Claude review it against criteria → have Claude refine based on the review. Each step is a separate API call so you can log, evaluate, or branch at any point.\"]}]\n110:[\"$\",\"h3\",\"272\",{\"id\":\"reduce-file-creation-in-agentic-coding\",\"className\":\"group\",\"children\":[[\"Reduce file creation in agentic coding\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"reduce-file-creation-in-agentic-coding\",\"name\":\"Reduce file creation in agentic coding\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n111:[\"$\",\"p\",\"274\",{\"children\":[\"Claude’s latest models might sometimes create new files for testing and iteration purposes, particularly when working with code. This approach allows Claude to use files, especially Python scripts, as a ‘temporary scratchpad’ before saving its final output. Using temporary files can improve outcomes particularly for agentic coding use cases.\"]}]\n112:[\"$\",\"p\",\"276\",{\"children\":[\"If you’d prefer to minimize the number of new files left behind, you can instruct Claude to clean up after itself:\"]}]\n113:[\"$\",\"$L141\",\"278\",{\"language\":\"text\",\"label\":\"Sample prompt\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"children\":[\"$\",\"code\",null,{\"children\":\"If you create any temporary new files, scripts, or helper files for iteration, clean up\\nthese files by removing them at the end of the task.\"}]}]}]}]\n114:[\"$\",\"h3\",\"280\",{\"id\":\"overeagerness\",\"className\":\"group\",\"children\":[[\"Overeagerness\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"overeagerness\",\"name\":\"Overeagerness\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n115:[\"$\",\"p\",\"282\",{\"children\":[\"Claude Opus 4.5 and Claude Opus 4.6 have a tendency to overengineer by creating extra files, adding unnecessary abstractions, or building in flexibility that wasn’t requested. If you’re seeing this undesired behavior, add specific guidance to keep solutions minimal.\"]}]\n116:[\"$\",\"p\",\"284\",{\"children\":[\"For example:\"]}]\n15c:T5bd,3c:o5bd,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003eAvoid \u003cspan class=\"nowrap\"\u003eover-engineering.\u003c/span\u003e Only make changes that are directly requested or clearly\u003c/span\u003e\n\u003cspan class=\"line\"\u003enecessary. Keep solutions simple and focused:\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e- Scope: Don't add features, refactor code, or make \"improvements\" beyond what was\u003c/span\u003e\n\u003cspan class=\"line\"\u003easked. A bug fix doesn't need surrounding code cleaned up. A simple feature doesn't need\u003c/span\u003e\n\u003cspan class=\"line\"\u003eextra configurability.\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e- Documentation: Don't add docstrings, comments, or type annotations to code you didn't\u003c/span\u003e\n\u003cspan class=\"line\"\u003echange. Only add comments where the logic isn't \u003cspan class=\"nowrap\"\u003eself-evident.\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e- Defensive coding: Don't add error handling, fallbacks, or validation for scenarios\u003c/span\u003e\n\u003cspan class=\"line\"\u003ethat can't happen. Trust internal code and framework guarantees. Only validate at system\u003c/span\u003e\n\u003cspan class=\"line\"\u003eboundaries (user input, external APIs).\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e- Abstractions: Don't create helpers, utilities, or abstractions for \u003cspan class=\"nowrap\"\u003eone-time\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003eoperations. Don't design for hypothetical future requirements. The right amount of\u003c/span\u003e\n\u003cspan class=\"line\"\u003ecomplexity is the minimum needed for the current task.\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e3c:o1000,117:[\"$\",\"$L141\",\"286\",{\"language\":\"text\",\"label\":\"Sample prompt to minimize overengineering\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"div\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$15c\"}}]}]}]\n118:[\"$\",\"h3\",\"288\",{\"id\":\"avoid-focusing-on-passing-tests-and-hard-coding\",\"className\":\"group\",\"children\":[[\"Avoid focusing on passing tests and hardcoding\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"avoid-focusing-on-passing-tests-and-hard-coding\",\"name\":\"Avoid focusing on passing tests and hardcoding\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n119:[\"$\",\"p\",\"290\",{\"children\":[\"Claude can sometimes focus too heavily on making tests pass at the expense of more general solutions, or might use workarounds such as helper scripts for complex refactoring instead of using standard tools directly. To prevent this behavior and get solutions that generalize:\"]}]\n15d:T52c,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003ePlease write a \u003cspan class=\"nowrap\"\u003ehigh-quality,\u003c/span\u003e \u003cspan class=\"nowrap\"\u003egeneral-purpose\u003c/span\u003e solution using the standard tools\u003c/span\u003e\n\u003cspan class=\"line\"\u003eavailable. Do not create helper scripts or workarounds to accomplish the task more\u003c/span\u003e\n\u003cspan class=\"line\"\u003eefficiently. Implement a solution that works correctly for all valid inputs, not just\u003c/span\u003e\n\u003cspan class=\"line\"\u003ethe test cases. Do not \u003cspan class=\"nowrap\"\u003ehard-code\u003c/span\u003e values or create solutions that only work for specific\u003c/span\u003e\n\u003cspan class=\"line\"\u003etest inputs. Instead, implement the actual logic that solves the problem generally.\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003eFocus on understanding the problem requirements and implementing the correct algorithm.\u003c/span\u003e\n\u003cspan class=\"line\"\u003eTests are there to verify correctness, not to define the solution. Provide a principled\u003c/span\u003e\n\u003cspan class=\"line\"\u003eimplementation that follows best practices and software design principles.\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003eIf the task is unreasonable or infeasible, or if any of the tests are incorrect, please\u003c/span\u003e\n\u003cspan class=\"line\"\u003einform me rather than working around them. The solution should be robust, maintainable,\u003c/span\u003e\n\u003cspan class=\"line\"\u003eand extendable.\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e11a:[\"$\",\"$L141\",\"292\",{\"language\":\"text\",\"label\":\"Sample prompt\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"div\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$15d\"}}]}]}]\n11b:[\"$\",\"h3\",\"294\",{\"id\":\"minimizing-hallucinations-in-agentic-coding\",\"className\":\"group\",\"children\":[[\"Minimizing hallucinations in agentic coding\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"minimizing-hallucinations-in-agentic-coding\",\"name\":\"Minimizing hallucinations in agentic coding\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n11c:[\"$\",\"p\",\"296\",{\"children\":[\"Claude’s latest models are less prone to hallucinations and give more accurate, grounded, intelligent answers based on the code. To encourage this behavior even more and minimize hallucinations:\"]}]\n11d:[\"$\",\"$L141\",\"298\",{\"language\":\"text\",\"label\":\"Sample prompt\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"div\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cpre class=\\\"shiki\\\"\u003e\u003ccode\u003e\u003cspan class=\\\"line\\\"\u003e\u0026lt;investigate_before_answering\u0026gt;\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003eNever speculate about code you have not opened. If the user ref3c:o1000,erences a specific file,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003eyou MUST read the file before answering. Make sure to investigate and read relevant\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003efiles BEFORE answering questions about the codebase. Never make any claims about code\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003ebefore investigating unless you are certain of the correct answer - give grounded and\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"nowrap\\\"\u003ehallucination-free\u003c/span\u003e answers.\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u0026lt;/investigate_before_answering\u0026gt;\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\"}}]}]}]\n11e:[\"$\",\"h2\",\"300\",{\"id\":\"capability-specific-tips\",\"className\":\"group\",\"children\":[[\"Capability-specific tips\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"capability-specific-tips\",\"name\":\"Capability-specific tips\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n11f:[\"$\",\"h3\",\"302\",{\"id\":\"improved-vision-capabilities\",\"className\":\"group\",\"children\":[[\"Improved vision capabilities\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"improved-vision-capabilities\",\"name\":\"Improved vision capabilities\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n120:[\"$\",\"p\",\"304\",{\"children\":[\"Claude Opus 4.5 and Claude Opus 4.6 have improved vision capabilities compared to previous Claude models. They perform better on image processing and data extraction tasks, particularly when there are multiple images present in context. These improvements carry over to computer use, where the models can more reliably interpret screenshots and UI elements. You can also use these models to analyze videos by breaking them up into frames.\"]}]\n121:[\"$\",\"p\",\"306\",{\"children\":[\"One technique that has proven effective to further boost performance is to give Claude a crop tool or \",[\"$\",\"$L88\",\"1\",{\"href\":\"/docs/en/agents-and-tools/agent-skills/overview\",\"untracked\":false,\"children\":[\"agent skill\"]}],\". Testing has shown consistent uplift on image evaluations when Claude is able to “zoom” in on relevant regions of an image. Anthropic has created a \",[\"$\",\"$L88\",\"3\",{\"href\":\"https://platform.claude.com/cookbook/multimodal-crop-tool\",\"untracked\":false,\"children\":[\"recipe for the crop tool\"]}],\".\"]}]\n122:[\"$\",\"h3\",\"308\",{\"id\":\"frontend-design\",\"className\":\"group\",\"children\":[[\"Frontend design\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"frontend-design\",\"name\":\"Frontend design\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n123:[\"$\",\"p\",\"310\",{\"children\":[\"Claude Opus 4.5 and Claude Opus 4.6 build complex, real-world web applications with strong frontend design. However, without guidance, models can default to generic patterns that create what users call the “AI slop” aesthetic. To create distinctive, creative front ends that surprise and delight:\"]}]\n124:[\"$\",\"$L89\",\"312\",{\"variant\":\"muted\",\"id\":\"$undefined\",\"icon\":[\"$\",\"$L8a\",null,{\"name\":\"Lightbulb\",\"size\":\"auto\"}],\"className\":\"prose-block print:break-inside-avoid print:[:is(h2,h3,h4)+\u0026]:break-after-avoid\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"For a detailed guide on improving frontend design, see the blog post on \",[\"$\",\"$L88\",\"1\",{\"href\":\"https://www.claude.com/blog/improving-frontend-design-through-skills\",\"untracked\":false,\"children\":[\"improving frontend design through skills\"]}],\".\"]}]]}]\n125:[\"$\",\"p\",\"314\",{\"children\":[\"For frontend design work outside the API, \",[\"$\",\"$L88\",\"1\",{\"href\":\"https://support.claude.com/en/articles/14604416-get-started-with-claude-design\",\"untracked\":false,\"children\":[\"Claude Design\"]}],\" provides a canvas and design tools where Claude generates and iterates on 3c:o9b,designs interactively.\"]}]\n126:[\"$\",\"p\",\"316\",{\"children\":[\"Here’s a system prompt snippet you can use to encourage better frontend design:\"]}]\n15e:Tb72,3c:ob72,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u0026lt;frontend_aesthetics\u0026gt;\u003c/span\u003e\n\u003cspan class=\"line\"\u003eYou tend to converge toward generic, \"on distribution\" outputs. In frontend design, this\u003c/span\u003e\n\u003cspan class=\"line\"\u003ecreates what users call the \"AI slop\" aesthetic. Avoid this: make creative, distinctive\u003c/span\u003e\n\u003cspan class=\"line\"\u003efrontends that surprise and delight.\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003eFocus on:\u003c/span\u003e\n\u003cspan class=\"line\"\u003e- Typography: Choose fonts that are beautiful, unique, and interesting. Avoid generic\u003c/span\u003e\n\u003cspan class=\"line\"\u003efonts like Arial and Inter; opt instead for distinctive choices that elevate the\u003c/span\u003e\n\u003cspan class=\"line\"\u003efrontend's aesthetics.\u003c/span\u003e\n\u003cspan class=\"line\"\u003e- Color \u0026amp; Theme: Commit to a cohesive aesthetic. Use CSS variables for consistency.\u003c/span\u003e\n\u003cspan class=\"line\"\u003eDominant colors with sharp accents outperform timid, \u003cspan class=\"nowrap\"\u003eevenly-distributed\u003c/span\u003e palettes. Draw\u003c/span\u003e\n\u003cspan class=\"line\"\u003efrom IDE themes and cultural aesthetics for inspiration.\u003c/span\u003e\n\u003cspan class=\"line\"\u003e- Motion: Use animations for effects and \u003cspan class=\"nowrap\"\u003emicro-interactions.\u003c/span\u003e Prioritize \u003cspan class=\"nowrap\"\u003eCSS-only\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003esolutions for HTML. Use Motion library for React when available. Focus on \u003cspan class=\"nowrap\"\u003ehigh-impact\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003emoments: one \u003cspan class=\"nowrap\"\u003ewell-orchestrated\u003c/span\u003e page load with staggered reveals \u003cspan class=\"nowrap\"\u003e(animation-delay)\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003ecreates more delight than scattered \u003cspan class=\"nowrap\"\u003emicro-interactions.\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e- Backgrounds: Create atmosphere and depth rather than defaulting to solid colors. Layer\u003c/span\u003e\n\u003cspan class=\"line\"\u003eCSS gradients, use geometric patterns, or add contextual effects that match the overall\u003c/span\u003e\n\u003cspan class=\"line\"\u003eaesthetic.\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003eAvoid generic \u003cspan class=\"nowrap\"\u003eAI-generated\u003c/span\u003e aesthetics:\u003c/span\u003e\n\u003cspan class=\"line\"\u003e- Overused font families (Inter, Roboto, Arial, system fonts)\u003c/span\u003e\n\u003cspan class=\"line\"\u003e- Clichéd color schemes (particularly purple gradients on white backgrounds)\u003c/span\u003e\n\u003cspan class=\"line\"\u003e- Predictable layouts and component patterns\u003c/span\u003e\n\u003cspan class=\"line\"\u003e- \u003cspan class=\"nowrap\"\u003eCookie-cutter\u003c/span\u003e design that lacks \u003cspan class=\"nowrap\"\u003econtext-specific\u003c/span\u003e character\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003eInterpret creatively and make unexpected choices that feel genuinely designed for the\u003c/span\u003e\n\u003cspan class=\"line\"\u003econtext. Vary between light and dark themes, different fonts, different aesthetics. You\u003c/span\u003e\n\u003cspan class=\"line\"\u003estill tend to converge on common choices (Space Grotesk, for example) across\u003c/span\u003e\n\u003cspan class=\"line\"\u003egenerations. Avoid this: it is critical that you think outside the box!\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u0026lt;/frontend_aesthetics\u0026gt;\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e3c:o6c5,127:[\"$\",\"$L141\",\"318\",{\"language\":\"text\",\"label\":\"Sample prompt for frontend aesthetics\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"div\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$15e\"}}]}]}]\n128:[\"$\",\"p\",\"320\",{\"children\":[\"You can also refer to the \",[\"$\",\"$L88\",\"1\",{\"href\":\"https://github.com/anthropics/claude-code/blob/main/plugins/frontend-design/skills/frontend-design/SKILL.md\",\"untracked\":false,\"children\":[\"full skill definition\"]}],\".\"]}]\n129:[\"$\",\"h3\",\"323\",{\"id\":\"medication-dosing\",\"className\":\"group\",\"children\":[[\"Medication dosing\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"medication-dosing\",\"name\":\"Medication dosing\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n12a:[\"$\",\"p\",\"325\",{\"children\":[\"If people might ask your application about medicine doses, add the block below for the model your application calls to your system prompt, exactly as written. The block has Claude give a child’s dose of an over-the-counter medicine from the product’s label, not from memory. With web search, such as the \",[\"$\",\"$L88\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/web-search-tool\",\"untracked\":false,\"children\":[\"web search tool\"]}],\", Claude checks the label before answering, which adds latency and search costs. Without web search, Claude points the person to the label’s dosing chart, a pharmacist, or the child’s doctor instead of giving a dose.\"]}]\n15f:T5d8,3c:o5d8,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u0026lt;medical_guidance\u0026gt;\u003c/span\u003e\n\u003cspan class=\"line\"\u003eThis applies only when the person explicitly says the medicine is for a child, and isn't a healthcare professional asking for work.\u003c/span\u003e\n\u003cspan class=\"line\"\u003eDosing for children's \u003cspan class=\"nowrap\"\u003eover-the-counter\u003c/span\u003e medicines depends on the child's weight and the specific product. For infants and toddlers, a small error can cause real harm. The product's label is the most reliable source, so Claude reports accurately what it says.\u003c/span\u003e\n\u003cspan class=\"line\"\u003eIf neither the child's age or weight is given, Claude asks for both. If a doctor has prescribed the medicine, Claude defers to the dose on the prescription label and suggests the pharmacist for any questions about it.\u003c/span\u003e\n\u003cspan class=\"line\"\u003eIf web search is available, Claude uses it to find the product's label and confirms it against an official copy of the same label, such as DailyMed. If web search is not available or Claude can't find the label, Claude doesn't give a number from memory and instead points the person to the label's dosing chart, a pharmacist, or the child's doctor. Claude shares what the label states for the child's age and weight: the dose, plus any instruction to ask a doctor. If the label gives no dose for that age or weight, or says not to use the product, Claude says so and refers the person to their doctor or pharmacist.\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u0026lt;/medical_guidance\u0026gt;\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e3c:o1ed,12b:[\"$\",\"$L141\",\"327\",{\"language\":\"text\",\"label\":\"Medication dosing block for Claude Fable 5.1, Claude Fable 5, Claude Opus 5.5, Claude Opus 5, Claude Opus 4.8, Claude Opus 4.7, Claude Opus 4.6, Claude Sonnet 5.5, and Claude Sonnet 5\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"div\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$15f\"}}]}]}]\n160:T6d8,3c:o6d8,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u0026lt;medical_guidance\u0026gt;\u003c/span\u003e\n\u003cspan class=\"line\"\u003eThis applies only when the person explicitly says the medicine is for a child, and isn't a healthcare professional asking for work.\u003c/span\u003e\n\u003cspan class=\"line\"\u003eDosing for children's \u003cspan class=\"nowrap\"\u003eover-the-counter\u003c/span\u003e medicines depends on the child's age or weight and the specific product. For infants and toddlers, a small error can cause real harm. The product's label is the most reliable source, so Claude reports accurately what it says.\u003c/span\u003e\n\u003cspan class=\"line\"\u003eIf neither the child's age or weight is given, Claude asks for both. If a doctor has prescribed the medicine, Claude defers to the dose on the prescription label and suggests the pharmacist for any questions about it.\u003c/span\u003e\n\u003cspan class=\"line\"\u003eIf web search is available, Claude uses it to find the product's label and confirms it against an official copy of the same label, such as DailyMed. If web search is not available or Claude can't find the label, Claude doesn't give a number from memory and instead points the person to the label's dosing chart, a pharmacist, or the child's doctor. Claude shares what the label states for the child's age or weight: the dose, plus any instruction to ask a doctor. If the label gives no dose for that age or weight, or says not to use the product, Claude says so and refers the person to their doctor or pharmacist.\u003c/span\u003e\n\u003cspan class=\"line\"\u003eIf someone mentions emotional distress or a difficult experience and asks about a medication's dose or limit, Claude should not provide the requested information and should instead address the underlying emotional distress.\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u0026lt;/medical_guidance\u0026gt;\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e3c:o797,12c:[\"$\",\"$L141\",\"329\",{\"language\":\"text\",\"label\":\"Medication dosing block for Claude Haiku 5.5\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"div\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$160\"}}]}]}]\n161:T4cd,\u003cmedical_guidance\u003e\nIf web search is available, Claude uses it to find the children's medicine label and confirms it against an official copy of the same label, such as DailyMed. Claude takes a child's dose only from the product's label, either an official copy found with web search or one shared by the person. Unless that label is in this conversation, Claude doesn't state any amount, dose, dosing table, or typical range for a child, including numbers it remembers or works out from the child's weight. Without the label, Claude points the person to a pharmacist or the child's doctor.\nThis applies only to medicine the person explicitly says will be given to a child and not to healthcare professionals asking for work.\nIf a doctor has prescribed the medicine, Claude defers to the dose on the prescription label and suggests the pharmacist for any questions about it.\nIf neither the child's age nor weight is given, Claude asks for both.\nClaude shares what the label states for the child's age or weight: the dose, plus any instruction to ask a doctor. If the label gives no dose for that age or weight, or says not to use the product, Claude says so and refers the person to their doctor or pharmacist.\n\u003c/medical_guidance\u003e12d:[\"$\",\"$L141\",\"331\",{\"language\":\"text\",\"label\":\"Medication dosing block for Claude Sonnet 4.6\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"children\":[\"$\",\"code\",null,{\"children\":\"$161\"}]}]}]}]\n162:T5d2,3c:o5d2,\u003cmedical_guidance\u003e\nWhen someone asks about a medicine for a child and web search is available, Claude uses it to find that medicine's label and confirms it against an official copy, such as DailyMed.\nWhen a medicine is for a child, Claude takes the dose only from the product's label, either an official copy found with web search or one shared by the person. Unless that label is in this conversation, Claude doesn't state any amount, dose, dosing table, or typical range for a child, including numbers it remembers or works out from the child's weight. Without the label, Claude points the person to a pharmacist or the child's doctor.\nClaude gives adults asking about their own medicine the standard dose as usual.\nIf no child is mentioned, Claude answers as it would for an adult.\nIf a doctor has prescribed the medicine for a child, Claude doesn't look up or work out a dose, even from the product's label or the child's weight; it defers to the prescription label and suggests the pharmacist for any questions about it.\nIf neither the child's age nor weight is given, Claude asks for both.\nClaude shares what the label states for the child's age or weight: the dose, plus any instruction to ask a doctor. If the child's age or weight is above or below what the label's chart includes, or the label says not to use the product, Claude says so and refers the person to their doctor or pharmacist. Claude doesn't give doses from charts other than the product's label.\n\u003c/medical_guidance\u003e3c:o38f,12e:[\"$\",\"$L141\",\"333\",{\"language\":\"text\",\"label\":\"Medication dosing block for Claude Haiku 4.5\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L143\",null,{\"wrap\":true,\"children\":[\"$\",\"pre\",null,{\"className\":\"block w-full pr-4\",\"data-code-source\":\"\",\"translate\":\"no\",\"children\":[\"$\",\"code\",null,{\"children\":\"$162\"}]}]}]}]\n12f:[\"$\",\"h2\",\"335\",{\"id\":\"migration-considerations\",\"className\":\"group\",\"children\":[[\"Migration considerations\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"migration-considerations\",\"name\":\"Migration considerations\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n130:[\"$\",\"p\",\"337\",{\"children\":[\"When migrating to current Claude models from earlier generations:\"]}]\n3c:odd1,131:[\"$\",\"ol\",\"339\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Be specific about the behavior you want:\"]}],\" Consider describing exactly what you’d like to see in the output.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Frame your instructions with modifiers:\"]}],\" Adding modifiers that encourage Claude to increase the quality and detail of its output can help better shape Claude’s performance. For example, instead of “Create an analytics dashboard,” use “Create an analytics dashboard. Include as many relevant features and interactions as possible. Go beyond the basics to create a fully-featured implementation.”\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Request specific features explicitly:\"]}],\" Ask explicitly for animations and interactive elements when you want them.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Update thinking configuration:\"]}],\" Claude 4.6 and later models use \",[\"$\",\"$L88\",\"2\",{\"href\":\"/docs/en/build-with-claude/thinking\",\"untracked\":false,\"children\":[\"adaptive thinking\"]}],\" (\",[\"$\",\"code\",\"4\",{\"children\":[\"thinking: {type: \\\"adaptive\\\"}\"]}],\") instead of manual thinking with \",[\"$\",\"code\",\"6\",{\"children\":[\"budget_tokens\"]}],\". On Claude 4.7 and later models, setting \",[\"$\",\"code\",\"8\",{\"children\":[\"budget_tokens\"]}],\" returns a 400 error. Use the \",[\"$\",\"$L88\",\"10\",{\"href\":\"/docs/en/build-with-claude/effort\",\"untracked\":false,\"children\":[\"effort parameter\"]}],\" to control thinking depth.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Migrate away from prefilled responses:\"]}],\" Prefilled responses on the last assistant turn are no longer supported starting with Claude 4.6 models and Claude Mythos Preview. See \",[\"$\",\"$L88\",\"2\",{\"href\":\"#migrating-away-from-prefilled-responses\",\"untracked\":false,\"children\":[\"Migrating away from prefilled responses\"]}],\" for detailed guidance on alternatives.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"11\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Tune anti-laziness prompting:\"]}],\" If your prompts previously encouraged the model to be more thorough or use tools more aggressively, reduce that guidance. Claude 4.6 models are more proactive and might overtrigger on instructions that were needed for previous models.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"13\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Pass thinking blocks back unchanged and keep history append-only:\"]}],\" Append each assistant turn exactly as the API returned it, thinking blocks included. On Claude 5.1 and later models, editing earlier messages, rebuilding \",[\"$\",\"code\",\"2\",{\"children\":[\"system\"]}],\" or \",[\"$\",\"code\",\"4\",{\"children\":[\"tools\"]}],\", or summarizing older turns in place between requests \",[\"$\",\"$L88\",\"6\",{\"href\":\"/docs/en/build-with-claude/thinking#preserved-in-conversation\",\"untracked\":false,\"children\":[\"invalidates every later thinking block\"]}],\". Move those changes to mid-conversation system messages and server-side context management. See \",[\"$\",\"$L88\",\"8\",{\"href\":\"/docs/en/build-with-claude/prompt-engineering/prompting-claude-fable-5-1#keep-the-conversation-history-append-only\",\"untracked\":false,\"children\":[\"Keep the conversation history append-only\"]}],\".\"]}],\"\\n\"]}],\"\\n\"]}]\n3c:o5d9,132:[\"$\",\"p\",\"341\",{\"children\":[\"For detailed migration steps, see the \",[\"$\",\"$L88\",\"1\",{\"href\":\"/docs/en/about-claude/models/migration-guide\",\"untracked\":false,\"children\":[\"Migration guide\"]}],\".\"]}]\n133:[\"$\",\"h3\",\"343\",{\"id\":\"migrating-to-claude-sonnet-5-5\",\"className\":\"group\",\"children\":[[\"Migrating to Claude Sonnet 5.5\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"migrating-to-claude-sonnet-5-5\",\"name\":\"Migrating to Claude Sonnet 5.5\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n134:[\"$\",\"p\",\"345\",{\"children\":[\"See the \",[\"$\",\"$L88\",\"1\",{\"href\":\"/docs/en/models/sonnet-5-5/migration-guide\",\"untracked\":false,\"children\":[\"Claude Sonnet 5.5 migration guide\"]}],\". It covers the breaking changes for code written for Claude Sonnet 5 and the steps from Claude Sonnet 4.6 and earlier, including the removal of manual extended thinking (\",[\"$\",\"code\",\"3\",{\"children\":[\"budget_tokens\"]}],\").\"]}]\n135:[\"$\",\"h2\",\"347\",{\"id\":\"next-steps\",\"className\":\"group\",\"children\":[[\"Next steps\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L13d\",null,{\"id\":\"next-steps\",\"name\":\"Next steps\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n3c:o118e,136:[\"$\",\"div\",\"349\",{\"className\":\"@container prose-block\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid gap-md [\u0026\u003e*]:m-0 grid-cols-1 md:grid-cols-2 print:grid-cols-2\",\"children\":[[\"$\",\"$L163\",\"0\",{\"className\":\"prose-block print:break-inside-avoid\",\"id\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col items-start gap-md\",\"childr