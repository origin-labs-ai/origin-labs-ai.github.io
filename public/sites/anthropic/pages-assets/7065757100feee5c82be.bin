4s;--reveal-stagger:0.1s"><main id="main-content" style="--reveal-index:0"><div class="page-builder-sections locale-text"><section id="heroPictogram" data-section="heroPictogram" data-cta-section="heroPictogram" style="--hero-headline-width:20ch;--hero-text-width:50ch" class="SectionWrapper-module-scss-module__NFbz_a__wrapper theme-main SectionWrapper-module-scss-module__NFbz_a__spacingBottomNone HeroPictogram-module-scss-module__ubGjQq__hero"><div class="container"><div class="AnimatedReveal-module-scss-module__8zH9eW__container HeroPictogram-module-scss-module__ubGjQq__content" style="--reveal-y:16px;--reveal-duration:0.75s;--reveal-delay:0s;--reveal-stagger:0.12s"><h1 class="HeroPictogram-module-scss-module__ubGjQq__eyebrow text-body-2" style="--reveal-index:0">Claude Security</h1><p class="Heading-module-scss-module__AyGdUq__heading text-display-1-serif Heading-module-scss-module__AyGdUq__balance HeroPictogram-module-scss-module__ubGjQq__headline" style="--reveal-index:1">From scan to fix, done seamlessly</p><p class="HeroPictogram-module-scss-module__ubGjQq__subheadline HeroPictogram-module-scss-module__ubGjQq__subheadlineAfterDisplay1 text-body-large-2" style="--reveal-index:2">Claude scans your codebase with Claude Mythos, validates findings, and suggests patches you can review and approve. Available in public beta for Claude Enterprise.</p><div class="HeroPictogram-module-scss-module__ubGjQq__ctaGroup" style="--reveal-index:3"><div role="group" class="ButtonGroup-module-scss-module__HSKYlq__buttonGroup HeroPictogram-module-scss-module__ubGjQq__ctas"><a href="/contact-sales" class="Button-module-scss-module__1SItCG__button Button-module-scss-module__1SItCG__variant-primary Button-module-scss-module__1SItCG__size-main text-body-2" data-cta-position="heroPictogram" data-cta-url="/contact-sales">Contact sales</a><a href="https://academy.claude.com/tutorials/getting-started-with-claude-security" class="Button-module-scss-module__1SItCG__button Button-module-scss-module__1SItCG__variant-secondary Button-module-scss-module__1SItCG__size-main text-body-2" data-cta-position="heroPictogram" data-cta-url="https://academy.claude.com/tutorials/getting-started-with-claude-security">Read the tutorial</a></div></div></div></div></section><section id="featureMediaSpotlight" data-section="featureMediaSpotlight" data-cta-section="featureMediaSpotlight" class="SectionWrapper-module-scss-module__NFbz_a__wrapper theme-main SectionWrapper-module-scss-module__NFbz_a__spacingBottomSmall"><div data-wf-threshold="large" class="container"><div class="grid-12 FeatureMediaSpotlight-module-scss-module__hBsS0a__featureMediaSpotlight"><div class="Video-module-scss-module__miVj5a__video Video-module-scss-module__miVj5a__youtubeEmbed Media-module-scss-module__7ZZCyW__video FeatureMediaSpotlight-module-scss-module__hBsS0a__media FeatureMediaSpotlight-module-scss-module__hBsS0a__ratio16x9" data-youtube-id="0SgCiUfoYo8"><button class="Video-module-scss-module__miVj5a__thumbnailOverlay" aria-label="Play video" data-cta-ignore=""><video class="Video-module-scss-module__miVj5a__coverVideo" poster="https://assets.claude.com/db5b0eb52879bafd5325601021c5431e874ba9f3.png" muted="" loop="" autoPlay="" playsInline="" preload="auto" aria-hidden="true" tabindex="-1"></video><div class="Video-module-scss-module__miVj5a__playButton"><svg width="32" height="32" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="_base-module-scss-module__SsgDWW__vector" aria-hidden="true"><path d="M4 4.0465C4.00028 2.87121 5.29098 2.15224 6.29005 2.7711L15.8927 8.72526C16.8385 9.31185 16.8384 10.6874 15.8927 11.2741L6.29005 17.2283C5.35321 17.8088 4.15995 17.2132 4.01465 16.1677L4 15.9529V4.0465ZM5.76368 3.6217C5.43073 3.41543 5.00029 3.65488 5.00001 4.0465V15.9529L5.00489 16.0251C5.05362 16.3734 5.45152 16.5712 5.76368 16.3777L15.3653 10.4245C15.6805 10.2289 15.6806 9.77038 15.3653 9.57488L5.76368 3.6217Z"></path></svg></div></button></div></div></div></section><section id="featureList" data-section="featureList" data-cta-section="featureList" class="SectionWrapper-module-scss-module__NFbz_a__wrapper theme-accent SectionWrapper-module-scss-module__NFbz_a__spacingBottomNone"><div class="SectionWrapper-module-scss-module__NFbz_a__borderTop"></div><div data-wf-width="inset" class="container SectionWrapper-module-scss-module__NFbz_a__insetFrame"><div class="SectionWrapper-module-scss-module__NFbz_a__inset"><div class="grid-12"><div class="FeatureList-module-scss-module__3G7ECW__inner FeatureList-module-scss-module__3G7ECW__fullWidth"><div class="IntroBlock-module-scss-module__0mSC7a__introBlock IntroBlock-module-scss-module__0mSC7a__spacingBelowLarge FeatureList-module-scss-module__3G7ECW__intro" style="--intro-headline-width:25ch;--intro-text-width:60ch"><div class="Illustration-module-scss-module__pBGuRG__base Illustration-module-scss-module__pBGuRG__pictogram Illustration-module-scss-module__pBGuRG__size-large IntroBlock-module-scss-module__0mSC7a__pictogram" role="img" aria-label="Illustration of an open hand with a padlock symbol overlaid on the palm, representing hand security, digital protection, or privacy concepts."></div><h2 class="Heading-module-scss-module__AyGdUq__heading text-headline-1-serif Heading-module-scss-module__AyGdUq__balance AnimatedHeading-module-scss-module__KoWePa__heading IntroBlock-module-scss-module__0mSC7a__headline IntroBlock-module-scss-module__0mSC7a__headlineBalance" style="--word-stagger:0.05s" aria-label="How teams use Claude Security"><span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:0" aria-hidden="true">How</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:1" aria-hidden="true">teams</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:2" aria-hidden="true">use</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:3" aria-hidden="true">Claude</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:4" aria-hidden="true">Security</span></h2><div class="AnimatedReveal-module-scss-module__8zH9eW__container IntroBlock-module-scss-module__0mSC7a__subheadlineAndCtas" style="--reveal-y:10px;--reveal-duration:0.75s;--reveal-delay:0s;--reveal-stagger:0.1s"><p class="IntroBlock-module-scss-module__0mSC7a__subheadline text-body-large-2" style="--reveal-index:0">Claude reasons through your code like a skilled security researcher. It understands context, traces data flows, and catches vulnerabilities that pattern-matching tools miss. Then it suggests and tracks fixes.</p></div></div><div class="AnimatedReveal-module-scss-module__8zH9eW__container FeatureList-module-scss-module__3G7ECW__list FeatureList-module-scss-module__3G7ECW__horizontal FeatureList-module-scss-module__3G7ECW__cols3" style="--reveal-y:20px;--reveal-duration:0.75s;--reveal-delay:0s;--reveal-stagger:0.1s"><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:0"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="32" height="32" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M8.5 2C12.0899 2 15 4.91015 15 8.5C15 10.1149 14.4094 11.5908 13.4346 12.7275L17.8535 17.1465L17.918 17.2246C18.0461 17.4187 18.0244 17.6827 17.8535 17.8535C17.6827 18.0244 17.4187 18.0461 17.2246 17.918L17.1465 17.8535L12.7275 13.4346C11.5908 14.4094 10.1149 15 8.5 15C4.91015 15 2 12.0899 2 8.5C2 4.91015 4.91015 2 8.5 2ZM8.5 3C5.46243 3 3 5.46243 3 8.5C3 11.5376 5.46243 14 8.5 14C11.5376 14 14 11.5376 14 8.5C14 5.46243 11.5376 3 8.5 3ZM6.22461 6.58203C6.41869 6.45387 6.68265 6.47562 6.85352 6.64648C7.02438 6.81735 7.04613 7.08131 6.91797 7.27539L6.85352 7.35352L5.70703 8.5L6.85352 9.64648C7.04878 9.84175 7.04878 10.1583 6.85352 10.3535C6.65825 10.5488 6.34175 10.5488 6.14648 10.3535L4.64648 8.85352L4.58398 8.77734C4.52963 8.69581 4.5 8.59944 4.5 8.5C4.5 8.36739 4.55272 8.24025 4.64648 8.14648L6.14648 6.64648L6.22461 6.58203ZM8.83203 6.50684C9.10436 6.55222 9.28846 6.8097 9.24316 7.08203L8.74316 10.082C8.69778 10.3544 8.4403 10.5385 8.16797 10.4932C7.89564 10.4478 7.71154 10.1903 7.75684 9.91797L8.25684 6.91797C8.30222 6.64564 8.5597 6.46154 8.83203 6.50684ZM10.1465 6.64648C10.3173 6.47562 10.5813 6.45387 10.7754 6.58203L10.8535 6.64648L12.3535 8.14648C12.4473 8.24025 12.5 8.36739 12.5 8.5C12.5 8.59944 12.4704 8.69581 12.416 8.77734L12.3535 8.85352L10.8535 10.3535C10.6583 10.5488 10.3417 10.5488 10.1465 10.3535C9.95122 10.1583 9.95122 9.84175 10.1465 9.64648L11.293 8.5L10.1465 7.35352L10.082 7.27539C9.95387 7.08131 9.97562 6.81735 10.1465 6.64648Z" /></svg></span><h3 class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Keep up with your code</h3></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-3">Claude runs a deep first scan, then keeps scanning as your code changes. It traces data flows across files and repositories to find vulnerabilities traditional scanners might not detect.</p></div></div></div><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:1"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="32" height="32" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M6.12598 13.918C6.30924 13.7115 6.62551 13.6928 6.83204 13.876C7.03848 14.0592 7.05722 14.3755 6.87403 14.582L4.65626 17.082C4.562 17.1881 4.4271 17.2492 4.28516 17.25C4.17858 17.2506 4.07532 17.2175 3.99024 17.1562L3.91211 17.0859L2.87989 15.9473L2.81934 15.8652C2.70101 15.6651 2.73512 15.4025 2.91407 15.2402C3.09294 15.0782 3.35744 15.0699 3.54493 15.207L3.62012 15.2754L4.27735 16L6.12598 13.918ZM16.5 15C16.7761 15 17 15.2239 17 15.5C17 15.7761 16.7762 16 16.5 16H8.50001C8.22387 16 8.00001 15.7761 8.00001 15.5C8.00002 15.2239 8.22388 15 8.50001 15H16.5ZM6.12598 8.41796C6.30924 8.21153 6.62551 8.19279 6.83204 8.37597C7.03848 8.55923 7.05722 8.87549 6.87403 9.08202L4.65626 11.582C4.562 11.6881 4.4271 11.7492 4.28516 11.75C4.17858 11.7506 4.07532 11.7174 3.99024 11.6562L3.91211 11.5859L2.87989 10.4473L2.81934 10.3652C2.70101 10.1651 2.73512 9.90245 2.91407 9.74023C3.09294 9.5782 3.35744 9.5699 3.54493 9.70702L3.62012 9.77538L4.27735 10.5L6.12598 8.41796ZM16.5 9.49999C16.7761 9.49999 17 9.72386 17 9.99999C17 10.2761 16.7762 10.5 16.5 10.5H8.50001C8.22387 10.5 8.00001 10.2761 8.00001 9.99999C8.00002 9.72387 8.22388 9.5 8.50001 9.49999H16.5ZM6.12598 2.91795C6.30924 2.71153 6.62551 2.69279 6.83204 2.87596C7.03848 3.05922 7.05722 3.37548 6.87403 3.58202L4.65626 6.08202C4.562 6.18813 4.4271 6.24922 4.28516 6.24999C4.17858 6.25056 4.07532 6.21744 3.99024 6.15624L3.91211 6.08592L2.87989 4.94725L2.81934 4.86522C2.70101 4.66513 2.73512 4.40245 2.91407 4.24022C3.09294 4.0782 3.35744 4.0699 3.54493 4.20702L3.62012 4.27538L4.27735 4.99999L6.12598 2.91795ZM16.5 3.99998C16.7761 3.99998 17 4.22386 17 4.49999C17 4.77613 16.7762 4.99999 16.5 4.99999H8.50001C8.22387 4.99998 8.00001 4.77612 8.00001 4.49999C8.00002 4.22386 8.22388 3.99999 8.50001 3.99998H16.5Z" /></svg></span><h3 class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Validate findings</h3></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-3">Every finding passes adversarial verification before it reaches your team. A threat model your team can edit decides what’s worth flagging.</p></div></div></div><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:2"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="32" height="32" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M9.72948 1.57906C9.92087 1.45584 10.178 1.4765 10.3476 1.64059L11.8496 3.09469L13.8779 2.58688L13.9766 2.57223C14.2038 2.56135 14.4156 2.70766 14.4805 2.93453L15.0537 4.94528L17.0654 5.5195C17.3248 5.59359 17.4787 5.86036 17.4131 6.12204L16.9043 8.14939L18.3594 9.65233C18.5469 9.84614 18.5469 10.1538 18.3594 10.3476L16.9043 11.8496L17.4131 13.8779C17.4787 14.1396 17.3249 14.4064 17.0654 14.4805L15.0537 15.0537L14.4805 17.0654C14.4064 17.3249 14.1397 17.4787 13.8779 17.4131L11.8496 16.9043L10.3476 18.3594C10.1538 18.5469 9.84617 18.5469 9.65234 18.3594L8.1494 16.9043L6.12205 17.4131C5.86032 17.4787 5.5936 17.3249 5.51951 17.0654L4.94529 15.0537L2.93454 14.4805C2.67513 14.4064 2.52125 14.1396 2.58688 13.8779L3.09469 11.8496L1.64059 10.3476C1.45314 10.1538 1.45309 9.84613 1.64059 9.65233L3.09469 8.14939L2.58688 6.12204C2.52133 5.86036 2.67514 5.59359 2.93454 5.5195L4.94529 4.94528L5.51951 2.93453L5.55564 2.84274C5.65982 2.64025 5.89297 2.52945 6.12205 2.58688L8.1494 3.09469L9.65234 1.64059L9.72948 1.57906ZM8.64549 4.0068C8.52136 4.127 8.34436 4.17471 8.17674 4.13278L6.34764 3.67379L5.83103 5.48728C5.78953 5.63274 5.68473 5.75062 5.54783 5.80954L5.48728 5.83103L3.6738 6.34763L4.13278 8.17674C4.1747 8.34433 4.12697 8.52135 4.00681 8.64549L2.69528 9.99998L4.00681 11.3545C4.12698 11.4786 4.17466 11.6556 4.13278 11.8232L3.6738 13.6514L5.48728 14.1689L5.54783 14.1904C5.68471 14.2493 5.7895 14.3673 5.83103 14.5127L6.34764 1