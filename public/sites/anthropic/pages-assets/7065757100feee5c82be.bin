ule__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title\",\"children\":\"Keep up with your code\"}]]}],[\"$\",\"div\",null,{\"className\":\"FeatureList-module-scss-module__3G7ECW__itemContent\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-rich-text FeatureList-module-scss-module__3G7ECW__body\",\"style\":\"$undefined\",\"children\":[[\"$\",\"p\",\"42c51c17a960\",{\"className\":\"text-body-3\",\"children\":[\"Claude runs a deep first scan, then keeps scanning as your code changes. It traces data flows across files and repositories to find vulnerabilities traditional scanners might not detect.\"]}]]}],false,[\"$\",\"$L34\",null,{\"ctas\":null,\"variants\":[\"tertiary\"],\"size\":\"small\",\"className\":\"FeatureList-module-scss-module__3G7ECW__ctas\",\"ctaPosition\":\"featureList\"}]]}]]}],[\"$\",\"div\",\"1fb3496dc1f6\",{\"className\":\"FeatureList-module-scss-module__3G7ECW__item\",\"children\":[[\"$\",\"div\",null,{\"className\":\"FeatureList-module-scss-module__3G7ECW__itemHeader\",\"children\":[[\"$\",\"span\",null,{\"className\":\"FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3\",\"children\":[[\"$\",\"svg\",null,{\"width\":32,\"height\":32,\"viewBox\":\"0 0 20 20\",\"fill\":\"currentColor\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"className\":\"FeatureList-module-scss-module__3G7ECW__itemIcon\",\"aria-hidden\":\"true\",\"dangerouslySetInnerHTML\":{\"__html\":\"$52\"}}],null]}],\"$L53\"]}],\"$L54\"]}],\"$L55\"]}]]\n43:[\"$\",\"div\",null,{\"className\":\"CtaBanner-module-scss-module__0Cqcuq__text\",\"children\":[[\"$\",\"p\",null,{\"ref\":\"$undefined\",\"className\":\"Heading-module-scss-module__AyGdUq__heading text-headline-5-serif Heading-module-scss-module__AyGdUq__balance CtaBanner-module-scss-module__0Cqcuq__headline\",\"children\":\"The Claude Security Plugin for Claude Code is now in beta\"}],[\"$\",\"div\",null,{\"className\":\"text-rich-text CtaBanner-