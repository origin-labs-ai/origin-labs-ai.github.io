 14.3485 12.8549L13.3407 10.2963C13.2395 10.0395 13.3661 9.74917 13.6229 9.64789ZM8.90024 7.20842C9.15717 7.10721 9.44747 7.23372 9.54868 7.49065L11.3817 12.143C11.4826 12.3998 11.3563 12.6903 11.0995 12.7915C10.8426 12.8925 10.5523 12.766 10.451 12.5092L8.61898 7.85686C8.5178 7.59999 8.64342 7.30969 8.90024 7.20842ZM7.16975 2.25331C9.17539 1.57852 11.3796 2.58838 12.1639 4.5795L13.1718 7.13811C13.273 7.39504 13.1465 7.68534 12.8895 7.78655C12.6327 7.88749 12.3423 7.76113 12.2411 7.50432L11.2333 4.94571C10.6259 3.40439 8.88406 2.6471 7.3426 3.25429C5.80118 3.86161 5.04399 5.60345 5.65118 7.14494L6.659 9.70355C6.76021 9.96048 6.6337 10.2508 6.37677 10.352C6.11988 10.4531 5.82952 10.3266 5.72833 10.0698L4.7205 7.51116C3.91111 5.45581 4.92107 3.13323 6.97639 2.32362L7.16975 2.25331Z\" /\u003e4b:[\"$\",\"$L33\",null,{\"trigger\":\"scroll\",\"stagger\":0.1,\"y\":20,\"duration\":0.75,\"className\":\"ResourceList-module-scss-module__RXHz9G__items ResourceList-module-scss-module__RXHz9G__grid ResourceList-module-scss-module__RXHz9G__gridCols4\",\"children\":[[\"$\",\"div\",\"79706dcca7b1\",{\"className\":\"ResourceList-module-scss-module__RXHz9G__item\",\"children\":[\"$\",\"$L5a\",null,{\"title\":\"Claude Security Plugin for Claude Code in beta\",\"link\":{\"_type\":\"link\",\"href\":\"https://code.claude.com/docs/en/claude-security\",\"label\":\"Docs\",\"linkType\":\"href\",\"openInNewTab\":false,\"page\":null},\"titleAs\":\"p\",\"icon\":[\"$\",\"svg\",null,{\"width\":20,\"height\":20,\"viewBox\":\"0 0 20 20\",\"fill\":\"currentColor\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"className\":\"$undefined\",\"aria-hidden\":\"true\",\"dangerouslySetInnerHTML\":{\"__html\":\"$5b\"}}],\"meta\":\"$undefined\",\"appearance\":\"card\",\"titleClassName\":\"$undefined\",\"visual\":\"$undefined\",\"visualColor\":\"$undefined\",\"className\":\"ResourceList-module-scss-module__RXHz9G__gridCard\"}]}],[\"$\",\"div\",\"0ef35592de54\",{\"className\":\"ResourceList-module-scss-module__RXHz9G__item\",\"children\":[\"$\",\"$L5a\",null,{\"title\":\"Claude Security is now in public beta\",\"link\":{\"_type\":\"link\",\"href\":\"/resources/articles/claude-security-public-beta\",\"label\":\"Blog\",\"linkType\":\"href\",\"openInNewTab\":false,\"page\":null},\"titleAs\":\"p\",\"icon\":[\"$\",\"svg\",null,{\"width\":20,\"height\":20,\"viewBox\":\"0 0 20 20\",\"fill\":\"currentColor\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"className\":\"$undefined\",\"aria-hidden\":\"true\",\"dangerouslySetInnerHTML\":{\"__html\":\"$5c\"}}],\"meta\":\"$undefined\",\"appearance\":\"card\",\"titleClassName\":\"$undefined\",\"visual\":\"$undefined\",\"visualColor\":\"$undefined\",\"className\":\"ResourceList-module-scss-module__RXHz9G__gridCard\"}]}],\"$L5d\",\"$L5e\"]}]\n4d:[\"$\",\"$L50\",null,{\"as\":\"h2\",\"size\":\"h1\",\"font\":\"serif\",\"trigger\":\"scroll\",\"className"])</script><script nonce="ra8XbZYlV5PcbbCdB45pwg==">self.__next_f.push([1,"\":\"IntroBlock-module-scss-module__0mSC7a__headline IntroBlock-module-scss-module__0mSC7a__headlineBalance\",\"children\":\"FAQ\"}]\n4e:[\"$\",\"div\",null,{\"className\":\"AsideRails-module-scss-module__sFf8jW__root\",\"data-aside-rails\":\"$undefined\",\"data-measure\":\"narrow\",\"children\":[[\"$\",\"div\",null,{\"className\":\"AsideRails-module-scss-module__sFf8jW__content AsideRails-module-scss-module__sFf8jW__contentNarrow\",\"children\":[\"$\",\"div\",null,{\"className\":\"FAQAccordion-module-scss-module__nWoFyW__accordion FAQAccordionLayout-module-scss-module__R1kBVG__column\",\"children\":[null,[\"$\",\"$L5f\",null,{\"items\":[{\"_key\":\"a67e6168d71d\",\"title\":\"Where is this available?\",\"body\":[{\"_key\":\"9902f021b72b\",\"_type\":\"block\",\"children\":[{\"_key\":\"708d67295c2f\",\"_type\":\"span\",\"marks\":[],\"text\":\"Admins can enable Claude Security in the \"},{\"_key\":\"b355e5e7a151\",\"_type\":\"span\",\"marks\":[\"636bf27a1fe8\"],\"text\":\"admin console\"},{\"_key\":\"e68d3c329cb5\",\"_type\":\"span\",\"marks\":[],\"text\":\". See the getting started guide for \"},{\"_key\":\"a81b2ecc1357\",\"_type\":\"span\",\"marks\":[\"dd0c307cd649\"],\"text\":\"setup steps\"},{\"_key\":\"c8f52ebbf453\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"636bf27a1fe8\",\"_type\":\"link\",\"href\":\"http://claude.ai/admin-settings/claude-code\"},{\"_key\":\"dd0c307cd649\",\"_type\":\"link\",\"href\":\"https://academy.claude.com/tutorials/getting-started-with-claude-security\"}],\"style\":\"normal\"},{\"_key\":\"6c25166093a5\",\"_type\":\"block\",\"children\":[{\"_key\":\"a2e3ff0a51d9\",\"_type\":\"span\",\"marks\":[],\"text\":\"The \"},{\"_key\":\"ebdb0aa5167f\",\"_type\":\"span\",\"marks\":[\"0f7858f36f6f\"],\"text\":\"Claude Security plugin\"},{\"_key\":\"e1cf8ffc073d\",\"_type\":\"span\",\"marks\":[],\"text\":\" is now available in beta for all Claude Code users.\"}],\"markDefs\":[{\"_key\":\"0f7858f36f6f\",\"_type\":\"link\",\"href\":\"https://code.claude.com/docs/en/claude-security\"}],\"style\":\"normal\"}]},{\"_key\":\"83e943a0f59d\",\"title\":\"What Mythos access does this give me?\",\"body\":[{\"_key\":\"8ce322b210f6\",\"_type\":\"block\",\"children\":[{\"_key\":\"7d1a3f82831d\",\"_type\":\"span\",\"marks\":[],\"text\":\"Claude Security is powered by our full family of models, including Claude Mythos, with no Cyber Verification Program access required. \"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5f5d86fddf0a\",\"_type\":\"block\",\"children\":[{\"_key\":\"7d1a3f82831d\",\"_type\":\"span\",\"marks\":[],\"text\":\"Create a project, connect your repositories, and Claude Security scans them using our most capable models for cyber, including Claude Mythos models. Validated findings come back with severity ratings and suggested fixes, which you can open in Claude Code and fix using the models available in your account. \"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1e2b8b2a5e05\",\"_type\":\"block\",\"children\":[{\"_key\":\"7d1a3f82831d\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Scans powered by Claude Mythos models are only available in the Claude Security app on Claude.ai. The Claude Security plugin for Claude Code uses the models available in your Claude Code account.\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"_key\":\"3b947787db28\",\"title\":\"What are the security risks I should know about?\",\"body\":[{\"_key\":\"d6c4aa7b978d\",\"_type\":\"block\",\"children\":[{\"_key\":\"6fafce4bfcd8\",\"_type\":\"span\",\"marks\":[],\"text\":\"Claude can make mistakes, so you should always review proposed patches before applying them, especially for critical systems.\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"_key\":\"2dea4c4cc7a9\",\"title\":\"What types of vulnerabilities does Claude Security find?\",\"body\":[{\"_key\":\"94daf04a620e\",\"_type\":\"block\",\"children\":[{\"_key\":\"070181f51262\",\"_type\":\"span\",\"marks\":[],\"text\":\"Claude Security focuses on high-severity vulnerabilities including memory corruption, injection flaws, authentication bypasses, and complex logic errors that pattern-matching tools typically miss. It's particularly effective at finding context-dependent vulnerabilities that require understanding code across multiple files.\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"_key\":\"7520a92feeef\",\"title\":\"How is this different from traditional security tools?\",\"body\":[{\"_key\":\"2a7827266fa9\",\"_type\":\"block\",\"children\":[{\"_key\":\"3cf6f60577d7\",\"_ty"])</script><script nonce="ra8XbZYlV5PcbbCdB45pwg==">self.__next_f.push([1,"pe\":\"span\",\"marks\":[],\"text\":\"Traditional tools often use rule-based pattern matching, which catches known vulnerability patterns but can produce high false positive rates and miss complex issues. Claude Security reasons through your code like a security researcher. It can read Git history, trace data flows, and understand business logic to find real vulnerabilities and generate real fixes.\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"_key\":\"1bd0c8bc8480\",\"title\":\"Does Claude Security work with my existing security tools?\",\"body\":[{\"_key\":\"2df90451bb83\",\"_type\":\"block\",\"children\":[{\"_key\":\"3be92c8229b7\",\"_type\":\"span\",\"marks\":[],\"text\":\"Yes. The Claude Security API lets you pull findings into your ticketing, vulnerability management, and reporting tools. You can also resolve or reopen them from there. Webhooks notify your systems when you receive a new finding.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a4c1e7b29d53\",\"_type\":\"block\",\"children\":[{\"_key\":\"f08b6d3a1c72\",\"_type\":\"span\",\"marks\":[],\"text\":\"Claude Security is also available as an MCP connector in Claude and Claude Code, so an engineer can pull up a finding, start the fix, and mark it resolved in the same session.\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"_key\":\"87fbbca16f49\",\"title\":\"Do I need to schedule scans?\",\"body\":[{\"_key\":\"36a69d259ae9\",\"_type\":\"block\",\"children\":[{\"_key\":\"718d0aaa2fce\",\"_type\":\"span\",\"marks\":[],\"text\":\"No. Choose the branch and scope for each repository, and Claude runs a deep baseline scan. After that it keeps scanning changes regularly based on their risk and complexity, so your findings stay close to the current state of your code.\"}],\"markDefs\":[],\"style\":\"normal\"}]}],\"defaultOpenIndex\":null,\"idBase\":\"faq-e5d063f95b69\",\"questionAs\":\"h3\"}]]}]}],false,false]}]\n53:[\"$\",\"h3\",null,{\"ref\":\"$undefined\",\"className\":\"Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title\",\"children\":\"Validate findings\"}]\n54:[\"$\",\"div\",null,{\"className\":\"FeatureList-module-scss-module__3G7ECW__itemContent\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-rich-text FeatureList-module-scss-module__3G7ECW__body\",\"style\":\"$undefined\",\"children\":[[\"$\",\"p\",\"ca3ca0c37777\",{\"className\":\"text-body-3\",\"children\":[\"Every finding passes adversarial verification before it reaches your team. A threat model your team can edit decides what’s worth flagging.\"]}]]}],false,[\"$\",\"$L34\",null,{\"ctas\":null,\"variants\":[\"tertiary\"],\"size\":\"small\",\"className\":\"FeatureList-module-scss-module__3G7ECW__ctas\",\"ctaPosition\":\"featureList\"}]]}]\n60:T9b2,\u003cpath d=\"M9.72948 1.57906C9.92087 1.45584 10.178 1.4765 10.3476 1.64059L11.8496 3.09469L13.8779 2.58688L13.9766 2.57223C14.2038 2.56135 14.4156 2.70766 14.4805 2.93453L15.0537 4.94528L17.0654 5.5195C17.3248 5.59359 17.4787 5.86036 17.4131 6.12204L16.9043 8.14939L18.3594 9.65233C18.5469 9.84614 18.5469 10.1538 18.3594 10.3476L16.9043 11.8496L17.4131 13.8779C17.4787 14.1396 17.3249 14.4064 17.0654 14.4805L15.0537 15.0537L14.4805 17.0654C14.4064 17.3249 14.1397 17.4787 13.8779 17.4131L11.8496 16.9043L10.3476 18.3594C10.1538 18.5469 9.84617 18.5469 9.65234 18.3594L8.1494 16.9043L6.12205 17.4131C5.86032 17.4787 5.5936 17.3249 5.51951 17.0654L4.94529 15.0537L2.93454 14.4805C2.67513 14.4064 2.52125 14.1396 2.58688 13.8779L3.09469 11.8496L1.64059 10.3476C1.45314 10.1538 1.45309 9.84613 1.64059 9.65233L3.09469 8.14939L2.58688 6.12204C2.52133 5.86036 2.67514 5.59359 2.93454 5.5195L4.94529 4.94528L5.51951 2.93453L5.55564 2.84274C5.65982 2.64025 5.89297 2.52945 6.12205 2.58688L8.1494 3.09469L9.65234 1.64059L9.72948 1.57906ZM8.64549 4.0068C8.52136 4.127 8.34436 4.17471 8.17674 4.13278L6.34764 3.67379L5.83103 5.48728C5.78953 5.63274 5.68473 5.75062 5.54783 5.80954L5.48728 5.83103L3.6738 6.34763L4.13278 8.17674C4.1747 8.34433 4.12697 8.52135 4.00681 8.64549L2.69528 9.99998L4.00681 11.3545C4.12698 11.4786 4.17466 11.6556 4.13278 11.8232L3.6738 13.6514L5.48728 14.1689L5.54783 14.1904C5.68471 14.2493 5.7895 14.3673 5.83103 14.5127L6.34764 16.3252L8.17674 15.8672L8.23924"])</script><script nonce="ra8XbZYlV5PcbbCdB45pwg==">self.__next_f.push([1," 15.8555C8.38736 15.8379 8.