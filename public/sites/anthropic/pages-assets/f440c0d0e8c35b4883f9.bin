s/en/build-with-claude/pdf-support\",\"untracked\":false,\"children\":[\"PDF support\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"We’ve also added token counting, which allows you to determine the total number of tokens in a Message prior to sending it to Claude. Read more in \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/token-counting\",\"untracked\":false,\"children\":[\"Token counting\"]}],\".\"]}],\"\\n\"]}]\n1c6:[\"$\",\"h3\",\"606\",{\"id\":\"october-22nd-2024\",\"className\":\"group\",\"children\":[[\"October 22, 2024\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"october-22nd-2024\",\"name\":\"October 22, 2024\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n1c7:[\"$\",\"ul\",\"608\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve added Anthropic-defined computer use tools to our API for use with the new Claude Sonnet 3.5. Read more in \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/computer-use-tool\",\"untracked\":false,\"children\":[\"Computer use tool\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Claude Sonnet 3.5, our most intelligent model yet, just got an upgrade and is now available on the Claude API. Read more in the \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://www.anthropic.com/claude/sonnet\",\"untracked\":false,\"children\":[\"Claude Sonnet documentation\"]}],\".\"]}],\"\\n\"]}]\n1c8:[\"$\",\"h3\",\"610\",{\"id\":\"october-8th-2024\",\"className\":\"group\",\"children\":[[\"October 8, 2024\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"october-8th-2024\",\"name\":\"October 8, 2024\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n1c9:[\"$\",\"ul\",\"612\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"The Message Batches API is now available in beta. Process large batches of queries asynchronously in the Claude API for 50% less cost. Read more in \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/batch-processing\",\"untracked\":false,\"children\":[\"Batch processing\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"We’ve loosened restrictions on the ordering of \",[\"$\",\"code\",\"1\",{\"children\":[\"user\"]}],\"/\",[\"$\",\"code\",\"3\",{\"children\":[\"assistant\"]}],\" turns in our Messages API. Consecutive \",[\"$\",\"code\",\"5\",{\"children\":[\"user\"]}],\"/\",[\"$\",\"code\",\"7\",{\"children\":[\"assistant\"]}],\" messages will be combined into a single message instead of erroring, and we no longer require the first input message to be a \",[\"$\",\"code\",\"9\",{\"children\":[\"user\"]}],\" message.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"We’ve deprecated the Build and Scale plans in favor of a standard feature suite (formerly referred to as Build), along with additional features that are available through sales. Read more in our \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://claude.com/platform/api\",\"untracked\":false,\"children\":[\"API pricing information\"]}],\".\"]}],\"\\n\"]}]\n1ca:[\"$\",\"h3\",\"614\",{\"id\":\"october-3rd-2024\",\"className\":\"group\",\"children\":[[\"October 3, 2024\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"october-3rd-2024\",\"name\":\"October 3, 2024\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n1cb:[\"$\",\"ul\",\"616\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve added the ability to disable parallel tool use in the API. Set \",[\"$\",\"code\",\"1\",{\"children\":[\"disable_parallel_tool_use: true\"]}],\" in the \",[\"$\",\"code\",\"3\",{\"children\":[\"tool_choice\"]}],\" field to ensure that Claude uses at most one tool. Read more in \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/agents-and-tools/tool-use/parallel-tool-use\",\"untracked\":false,\"children\":[\"Parallel tool use\"]}],\".\"]}],\"\\n\"]}]\n1cc:[\"$\",\"h3\",\"618\",{\"id\":\"september-10th-2024\",\"className\":\"group\",\"children\":[[\"September 10, 2024\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"september-10th-2024\",\"name\":\"September 10, 2024\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n1cd:[\"$\",\"ul\",\"620\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve added Workspaces to the \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://console.anthropic.com\",\"untracked\":false,\"children\":[\"Developer Console\"]}],\". Workspaces allow you to set custom spend or rate limits, group API keys, track usage by project, and control access with user roles. Read more in our \",[\"$\",\"$L97\",\"3\",{\"href\":\"https://www.anthropic.com/news/workspaces\",\"untracked\":false,\"children\":[\"Workspaces blog post\"]}],\".\"]}],\"\\n\"]}]\n1ce:[\"$\",\"h3\",\"622\",{\"id\":\"september-4th-2024\",\"className\":\"group\",\"children\":[[\"September 4, 2024\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"september-4th-2024\",\"name\":\"September 4, 2024\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n1cf:[\"$\",\"ul\",\"624\",{\"children\":[\"\\