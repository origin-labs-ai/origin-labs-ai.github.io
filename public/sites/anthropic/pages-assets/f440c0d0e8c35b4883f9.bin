ate from the Usage and Cost API\"]}],\" or \",[\"$\",\"$L97\",\"15\",{\"href\":\"/docs/en/manage-claude/usage-cost-analytics-api#migrate-from-enterprise-analytics-reports\",\"untracked\":false,\"children\":[\"Migrate from the Claude Enterprise usage and cost reports\"]}],\".\"]}],\"\\n\"]}]\na4:[\"$\",\"h3\",\"25\",{\"id\":\"october-28-2026\",\"className\":\"group\",\"children\":[[\"October 28, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"october-28-2026\",\"name\":\"October 28, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\na5:[\"$\",\"ul\",\"27\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve raised the \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/api/overview#request-size-limits\",\"untracked\":false,\"children\":[\"maximum request size\"]}],\" for the Messages API and the Token Counting API from 32 MB to 128 MB on the first-party Claude API.\"]}],\"\\n\"]}]\na6:[\"$\",\"h3\",\"29\",{\"id\":\"october-23-2026\",\"className\":\"group\",\"children\":[[\"October 23, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"october-23-2026\",\"name\":\"October 23, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\na7:[\"$\",\"ul\",\"31\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"span\",\"0\",{\"id\":\"october-20-2026\",\"children\":\"$undefined\"}],\"The \",[\"$\",\"$L97\",\"2\",{\"href\":\"/docs/en/manage-claude/claude-tag-api\",\"untracked\":false,\"children\":[\"Claude Tag API\"]}],\" is available in beta for Claude Enterprise organizations with the \",[\"$\",\"code\",\"4\",{\"children\":[\"experimental-claude-tag-2026-10-21\"]}],\" beta header. Its \",[\"$\",\"code\",\"6\",{\"children\":[\"/v1/organizations/claude_tag/\"]}],\" endpoints read and change \",[\"$\",\"$L97\",\"8\",{\"href\":\"https://claude.com/docs/claude-tag/overview\",\"untracked\":false,\"children\":[\"Claude Tag\"]}],\" settings on Slack channels and Slack workspaces, show which settings apply in a channel and where each comes from, and attach Access bundles. Call it with an Admin API key that your primary owner creates in claude.ai with the \",[\"$\",\"code\",\"10\",{\"children\":[\"read:claude_tag\"]}],\" or \",[\"$\",\"code\",\"12\",{\"children\":[\"write:claude_tag\"]}],\" scope. It is not available to Claude Platform (Claude Console) organizations.\"]}],\"\\n\"]}]\na8:[\"$\",\"h3\",\"33\",{\"id\":\"october-22-2026\",\"className\":\"group\",\"children\":[[\"October 22, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"october-22-2026\",\"name\":\"October 22, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\na9:[\"$\",\"ul\",\"35\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/claude-models-on-google-cloud/anthropic-managed\",\"untracked\":false,\"children\":[\"Claude Models on Google Cloud (Anthropic managed)\"]}],\", the Claude API operated by Anthropic and reached through your Google Cloud project. Google Cloud IAM controls access. Google Cloud Marketplace handles billing.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/build-with-claude/fast-mode\",\"untracked\":false,\"children\":[\"Fast mode\"]}],\" is available for Claude Opus 5.5 on Claude Models on Google Cloud (Anthropic managed).\"]}],\"\\n\"]}]\naa:[\"$\",\"h3\",\"37\",{\"id\":\"october-21-2026\",\"className\":\"group\",\"children\":[[\"October 21, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"october-21-2026\",\"name\":\"October 21, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nab:[\"$\",\"ul\",\"39\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve released API version \",[\"$\",\"code\",\"1\",{\"children\":[\"2026-10-21\"]}],\". \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/api/migration-2026-10-21\",\"untracked\":false,\"children\":[\"Migrating to API version 2026-10-21\"]}],\" shows how to upgrade.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"We’ve released new versions of the \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/cli-sdks-libraries/overview\",\"untracked\":false,\"children\":[\"client SDKs\"]}],\" and the \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/cli-sdks-libraries/cli/quickstart\",\"untracked\":false,\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"ant\"]}],\" CLI\"]}],\" that send API version \",[\"$\",\"code\",\"5\",{\"children\":[\"2026-10-21\"]}],\" by default: Python SDK 2.0.0, TypeScript SDK 1.0.0, C# SDK 13.0.0, Go SDK 2.0.0, Java SDK 3.0.0, PHP SDK 1.0.0, Ruby SDK 2.0.0, and \",[\"$\",\"code\",\"7\",{\"children\":[\"ant\"]}],\" CLI 2.0.0. See \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/api/migration-2026-10-21#upgrade\",\"untracked\":false,\"children\":[\"Switch to 2026-10-21\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"The new SDK and CLI versions also have breaking changes that don’t depend on the API version, and they are licensed under Apache 2.0 instead of the MIT License. See \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/api/migration-2026-10-21#sdk-changes\",\"untracked\":false,\"children\":[\"SDK and CLI changes\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"We’ve added the \",[\"$\",\"code\",\"1\",{\"children\":[\"enforcement_status\"]}],\" and \",[\"$\",\"code\",\"3\",{\"children\":[\"enforcement_actions\"]}],\" fields to \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/manage-claude/user-profiles\",\"untracked\":false,\"children\":[\"user profiles\"]}],\", so you can see whether Anthropic has restricted or banned one of your end customers. To find the profiles that have an open restriction or ban, \",\"$L1e8\",\" with the new \",[\"$\",\"code\",\"9\",{\"children\":[\"enforcement_status[]\"]}],\" filter. See \",[\"$\",\"$L97\",\"11\",{\"href\":\"/docs/en/manage-claude/user-profiles#check-whether-anthropic-has-restricted-or-banned-a-profile\",\"untracked\":false,\"children\":[\"Check whether Anthropic has restricted or banned a profile\"]}],\".\"]}],\"\\n\"]}]\nac:[\"$\",\"h3\",\"41\",{\"id\":\"october-20-2026-2\",\"className\":\"group\",\"children\":[[\"October 20, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"october-20-2026-2\",\"name\":\"October 20, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nad:[\"$\",\"ul\",\"43\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/manage-claude/inference-hooks\",\"untracked\":false,\"children\":[\"Inference hooks\"]}],\" are out of beta for Claude Enterprise organizations.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"We’ve launched \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/manage-claude/user-profiles\",\"untracked\":false,\"children\":[\"user profiles\"]}],\", so you can tell Anthropic which of your end customers each API request is for. If you operate a platform or gateway, or resell API access, a safety enforcement action can then apply to one end customer instead of your whole organization. The SDK and the \",[\"$\",\"code\",\"3\",{\"children\":[\"ant\"]}],\" CLI support the new \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/api/user_profiles\",\"untracked\":false,\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"/v1/user_profiles\"]}],\" endpoints\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"We’ve added \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/manage-claude/organization-webhooks\",\"untracked\":false,\"children\":[\"organization webhooks\"]}],\" to the \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/manage-claude/admin-api\",\"untracked\":false,\"children\":[\"Admin API\"]}],\", in beta with the \",[\"$\",\"code\",\"5\",{\"children\":[\"webhooks-2026-10-07\"]}],\" beta header. Its \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/api/beta/organization/webhooks\",\"untracked\":false,\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"/v1/organizations/webhooks\"]}],\" endpoints\"]}],\" register webhook endpoints for two event types: one for when Anthropic restricts or bans one of your organization’s user profiles, and one for when the restriction or ban ends. To request access, contact your Anthropic account team.\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"Organization admins can now turn off web fetch for their organization on the \",[\"$\",\"$L97\",\"1\",{\"href\":\"/settings/capabilities\",\"untracked\":false,\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Capabilities\"]}]]}],\" page of the Claude Console. With web fetch off, a Messages API request that includes the web fetch tool fails with a 400 error. In a Claude Managed Agents session, \",[\"$\",\"code\",\"3\",{\"children\":[\"web_fetch\"]}],\" calls return an error result to the agent instead. With web fetch on, admins can also set allowed or blocked domains for web fetch on the same page. See \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/agents-and-tools/tool-use/web-fetch-tool#how-to-use-web-fetch\",\"untracked\":false,\"children\":[\"How to use web fetch\"]}],\" and \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/agents-and-tools/tool-use/server-tools#domain-filtering\",\"untracked\":false,\"children\":[\"Domain filtering\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[\"In Claude Managed Agents, the \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/managed-agents/tools#available-tools\",\"untracked\":false,\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"web_fetch\"]}],\" tool\"]}],\" now follows your organization’s web fetch domain restrictions set on the \",[\"$\",\"$L97\",\"3\",{\"href\":\"/settings/capabilities\",\"untracked\":false,\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Capabilities\"]}]]}],\" page of the Claude Console. A URL, including one reached by a redirect, must pass both the organization’s list and the \",[\"$\",\"code\",\"5\",{\"children\":[\"allowed_domains\"]}],\" or \",[\"$\",\"code\",\"7\",{\"children\":[\"blocked_domains\"]}],\" list on the agent’s \",[\"$\",\"code\",\"9\",{\"children\":[\"web_fetch\"]}],\" tool. See \",[\"$\",\"$L97\",\"11\",{\"href\":\"/docs/en/managed-agents/tools-web-restrictions\",\"untracked\":false,\"children\":[\"Restrict web search and web fetch domains\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"11\",{\"children\":[\"In Claude Managed Agents, sessions follow your organization’s web search settings on the \",[\"$\",\"$L97\",\"1\",{\"href\":\"/settings/capabilities\",\"untracked\":false,\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Capabilities\"]}]]}],\" page of the Claude Console: the \",[\"$\",\"strong\",\"3\",{\"children\":[\"Allow web search\"]}],\" setting since October 6, and its web search domain restrictions since October 14. The agent receives only the search results that both the organization’s domain restrictions and the \",\"$L1e9\",\" or \",\"$L1ea\",\" list on the agent’s \",\"$L1eb\",\" allow. See \",\"$L1ec\",\".\"]}],\"\\n\"]}]\nae:[\"$\",\"h3\",\"45\",{\"id\":\"october-15-2026-5\",\"className\":\"group\",\"children\":[[\"October 15, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"october-15-2026-5\",\"name\":\"October 15, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\naf:[\"$\",\"ul\",\"47\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve added \",[\"$\",\"code\",\"1\",{\"children\":[\"capabilities.thinking.types.between_tools\"]}],\" to the \",\"$L1ed\",\". \",[\"$\",\"code\",\"5\",{\"children\":[\"GET /v1/models\"]}],\" and \",[\"$\",\"code\",\"7\",{\"children\":[\"GET /v1/models/{model_id}\"]}],\" now report whether each model accepts \",[\"$\",\"code\",\"9\",{\"children\":[\"thinking: {type: \\\"between_tools\\\"}\"]}],\", which turns off up-front thinking. See \",[\"$\",\"$L97\",\"11\",{\"href\":\"/docs/en/models/overview#using-the-models-api\",\"untracked\":false,\"children\":[\"Using the Models API\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"span\",\"0\",{\"id\":\"october-19-2026-3\",\"children\":\"$undefined\"}],\"The \",[\"$\",\"$L97\",\"2\",{\"href\":\"/docs/en/manage-claude/compliance-api\",\"untracked\":false,\"children\":[\"Compliance API\"]}],\" now returns the text each organization member saved as \",[\"$\",\"strong\",\"4\",{\"children\":[\"Instructions for Claude\"]}],\" in claude.ai and as \",[\"$\",\"strong\",\"6\",{\"children\":[\"Global instructions\"]}],\" in Cowork, in beta for Claude Enterprise organizations. Call \",[\"$\",\"code\",\"8\",{\"children\":[\"GET /v1/compliance/organizations/{org_uuid}/user_preferences\"]}],\" with your existing Compliance Access Key and the \",[\"$\",\"code\",\"10\",{\"children\":[\"read:compliance_user_data\"]}],\" scope. See \",[\"$\",\"$L97\",\"12\",{\"href\":\"/docs/en/manage-claude/compliance-org-data#list-user-preferences\",\"untracked\":false,\"children\":[\"List user preferences\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"span\",\"0\",{\"id\":\"october-15-2026-4\",\"children\":\"$undefined\"}],[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/fast-mode\",\"untracked\":false,\"children\":[\"Fast mode\"]}],\" is out of research preview for Claude Opus 5.5, and you no longer need to request access. Requests to Claude Opus 5.5 no longer require the \",[\"$\",\"code\",\"3\",{\"children\":[\"fast-mode-2026-02-01\"]}],\" beta header, and requests that still send it keep working. Claude Opus 5.5 now has a default fast mode rate limit in the Start, Build, and Scale usage tiers. Fast mode for Claude Opus 5 and Claude Opus 4.8 remains in research preview. Keep sending the beta header with fast mode requests to those models.\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[[\"$\",\"span\",\"0\",{\"id\":\"october-15-2026-3\",\"children\":\"$undefined\"}],[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/fast-mode\",\"untracked\":false,\"children\":[\"Fast mode\"]}],\" for Claude Opus 5.5 is now available on \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/build-with-claude/claude-in-microsoft-foundry\",\"untracked\":false,\"children\":[\"Claude in Microsoft Foundry\"]}],\" for deployments hosted on Azure.\"]}],\"\\n\"]}]\nb0:[\"$\",\"h3\",\"49\",{\"id\":\"october-14-2026\",\"className\":\"group\",\"children\":[[\"October 14, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"october-14-2026\",\"name\":\"October 14, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nb1:[\"$\",\"ul\",\"51\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/manage-claude/opentelemetry\",\"untracked\":false,\"children\":[\"OpenTelemetry export\"]}],\" in beta, so you can trace Messages API requests and Claude Managed Agents sessions in your observability platform. The Claude SDK emits spans in Python, TypeScript, C#, Go, Java, PHP, and Ruby. To get spans from the API, \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/manage-claude/opentelemetry/api#add-a-destination\",\"untracked\":false,\"children\":[\"add an OpenTelemetry destination\"]}],\" in the Claude Console.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Claude Managed Agents \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/managed-agents/scheduled-deployments\",\"untracked\":false,\"children\":[\"scheduled deployments\"]}],\" are now \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/build-with-claude/claude-platform-on-aws#claude-managed-agents\",\"untracked\":false,\"children\":[\"available on Claude Platform on AWS\"]}],\".\"]}],\"\\n\"]}]\nb2:[\"$\",\"h3\",\"53\",{\"id\":\"october-9-2026\",\"className\":\"group\",\"children\":[[\"October 9, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"october-9-2026\",\"name\":\"October 9, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nb3:[\"$\",\"ul\",\"55\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"You can now let a Claude Managed Agents agent use \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/managed-agents/multiagent-orchestration#dynamic-workflows\",\"untracked\":false,\"children\":[\"dynamic workflows\"]}],\", in beta with the \",[\"$\",\"code\",\"3\",{\"children\":[\"managed-agents-2026-04-01\"]}],\" beta header. For work with many pieces, such as reviewing hundreds of documents, the agent can write a workflow. A workflow is a program that runs many agents in phases and combines their results. The server runs it in the background as a workflow run. To \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/managed-agents/multiagent-orchestration#turn-on-dynamic-workflows\",\"untracked\":false,\"children\":[\"turn dynamic workflows on\"]}],\", set the agent’s \",[\"$\",\"code\",\"7\",{\"children\":[\"multiagent\"]}],\" field to \",[\"$\",\"code\",\"9\",{\"children\":[\"{\\\"type\\\": \\\"multiagent_20261001\\\", \\\"workflows\\\": {\\\"type\\\": \\\"enabled\\\"}}\"]}],\". To guide the agent, tell it in its system prompt when to start a run. Follow each run through \",[\"$\",\"code\",\"11\",{\"children\":[\"workflow_run.*\"]}],\" events on the session’s event stream. See \",[\"$\",\"$L97\",\"13\",{\"href\":\"/docs/en/managed-agents/workflow-runs\",\"untracked\":false,\"children\":[\"Workflow runs\"]}],\".\"]}],\"\\n\"]}]\nb4:[\"$\",\"h3\",\"57\",{\"id\":\"october-8-2026\",\"className\":\"group\",\"children\":[[\"October 8, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"october-8-2026\",\"name\":\"October 8, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nb5:[\"$\",\"ul\",\"59\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/manage-claude/compliance-api\",\"untracked\":false,\"children\":[\"Compliance API\"]}],\" chat endpoints now also return chats from the unified Claude experience, in beta for Claude Enterprise organizations, with your existing Compliance Access Key. See \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/manage-claude/compliance-content-data\",\"untracked\":false,\"children\":[\"Retrieve and delete chats, files, and projects\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"The Compliance API can now download Claude Docs documents as Word files, in beta. See \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/manage-claude/compliance-content-data#retrieve-files-and-artifacts\",\"untracked\":false,\"children\":[\"Retrieve files and artifacts\"]}],\".\"]}],\"\\n\"]}]\nb6:[\"$\",\"h3\",\"61\",{\"id\":\"october-7-2026\",\"className\":\"group\",\"children\":[[\"October 7, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"october-7-2026\",\"name\":\"October 7, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nb7:[\"$\",\"ul\",\"63\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve lowered the price of prompt cache reads on Claude Sonnet 5.5 from $0.20 USD to $0.10 USD per million tokens: 0.05x the base input price instead of 0.1x. Cache writes and all other prices are unchanged. See \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/about-claude/pricing#prompt-caching\",\"untracked\":false,\"children\":[\"Prompt caching pricing\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"span\",\"0\",{\"id\":\"october-7-2026-4\",\"children\":\"$undefined\"}],\"We’ve launched \",[\"$\",\"strong\",\"2\",{\"children\":[\"Claude Haiku 5.5\"]}],\" (\",[\"$\",\"code\",\"4\",{\"children\":[\"claude-haiku-5-5\"]}],\"), our most capable model tuned for high-volume and latency-sensitive work. It has a \",[\"$\",\"$L97\",\"6\",{\"href\":\"/docs/en/build-with-claude/context-windows\",\"untracked\":false,\"children\":[\"1M token context window\"]}],\", 128k max output tokens, and \",[\"$\",\"$L97\",\"8\",{\"href\":\"/docs/en/build-with-claude/thinking\",\"untracked\":false,\"children\":[\"adaptive thinking\"]}],\" with the \",[\"$\",\"$L97\",\"10\",{\"href\":\"/docs/en/build-with-claude/effort\",\"untracked\":false,\"children\":[\"effort parameter\"]}],\". It’s available on the Claude API, \",[\"$\",\"$L97\",\"12\",{\"href\":\"/docs/en/build-with-claude/claude-in-amazon-bedrock\",\"untracked\":false,\"children\":[\"Claude in Amazon Bedrock\"]}],\", \",[\"$\",\"$L97\",\"14\",{\"href\":\"/docs/en/build-with-claude/claude-platform-on-aws\",\"untracked\":false,\"children\":[\"Claude Platform on AWS\"]}],\", \",[\"$\",\"$L97\",\"16\",{\"href\":\"/docs/en/build-with-claude/claude-models-on-google-cloud/google-managed\",\"untracked\":false,\"children\":[\"Claude Models on Google Cloud (Google managed)\"]}],\", and \",[\"$\",\"$L97\",\"18\",{\"href\":\"/docs/en/build-with-claude/claude-in-microsoft-foundry\",\"untracked\":false,\"children\":[\"Claude in Microsoft Foundry\"]}],\". See \",[\"$\",\"$L97\",\"20\",{\"href\":\"/docs/en/models/haiku-5-5/whats-new-haiku-5-5\",\"untracked\":false,\"children\":[\"What’s new in Claude Haiku 5.5\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"Code written for Claude Haiku 4.5 can break on Claude Haiku 5.5. Manual extended thinking (\",[\"$\",\"code\",\"1\",{\"children\":[\"budget_tokens\"]}],\"), the sampling parameters \",[\"$\",\"code\",\"3\",{\"children\":[\"temperature\"]}],\", \",[\"$\",\"code\",\"5\",{\"children\":[\"top_p\"]}],\", and \",[\"$\",\"code\",\"7\",{\"children\":[\"top_k\"]}],\", and assistant message prefill can each return a 400 error. \",[\"$\",\"code\",\"9\",{\"children\":[\"computer_20250124\"]}],\" also returns a 400 error: use the \",[\"$\",\"code\",\"11\",{\"children\":[\"computer_toolset_20260801\"]}],\" toolset on the Claude API and Google Cloud, or \",[\"$\",\"code\",\"13\",{\"children\":[\"computer_20251124\"]}],\" on Amazon Bedrock. A request that sends thinking blocks back after a change to \",[\"$\",\"code\",\"15\",{\"children\":[\"system\"]}],\", \",[\"$\",\"code\",\"17\",{\"children\":[\"tools\"]}],\", or earlier turns can also return a 400 error. Adaptive thinking is on by default, so a response can begin with \",[\"$\",\"code\",\"19\",{\"children\":[\"thinking\"]}],\" blocks, and their text is omitted unless you set \",[\"$\",\"code\",\"21\",{\"children\":[\"thinking.display\"]}],\" to \",[\"$\",\"code\",\"23\",{\"children\":[\"\\\"summarized\\\"\"]}],\". Claude Haiku 5.5 also uses a tokenizer that produces more tokens for the same text. See the \",[\"$\",\"$L97\",\"25\",{\"href\":\"/docs/en/models/haiku-5-5/migration-guide\",\"untracked\":false,\"children\":[\"Claude Haiku 5.5 migration guide\"]}],\" for each change. For model-specific prompting patterns, see \",[\"$\",\"$L97\",\"27\",{\"href\":\"/docs/en/build-with-claude/prompt-engineering/prompting-claude-haiku-5-5\",\"untracked\":false,\"children\":[\"Prompting Claude Haiku 5.5\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[[\"$\",\"span\",\"0\",{\"id\":\"october-7-2026-2\",\"children\":\"$undefined\"}],\"Python SDK 1.12.0 and TypeScript SDK 0.132.0 add classes, in beta, for the \",[\"$\",\"$L97\",\"2\",{\"href\":\"/docs/en/agents-and-tools/tool-use/browser-use-tool\",\"untracked\":false,\"children\":[\"browser use tool\"]}],\" and the \",[\"$\",\"$L97\",\"4\",{\"href\":\"/docs/en/agents-and-tools/tool-use/computer-use-tool\",\"untracked\":false,\"children\":[\"computer use tool\"]}],\". You subclass one and write one method per tool against your own browser or desktop automation. The SDK runs the tool loop, the URL and file policies you set for the browser, and your approval callback. See \",\"$L1ee\",\".\"]}],\"\\n\",\"$L1ef\",\"\\n\",\"$L1f0\",\"\\n\",\"$L1f1\",\"\\n\",\"$L1f2\",\"\\n\"]}]\nb8:[\"$\",\"h3\",\"65\",{\"id\":\"october-6-2026\",\"className\":\"group\",\"children\":[[\"October 6, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"october-6-2026\",\"name\":\"October 6, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nb9:[\"$\",\"ul\",\"67\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve added \",[\"$\",\"code\",\"1\",{\"children\":[\"capabilities.server_tools\"]}],\" to the \",\"$L1f3\",\". \",[\"$\",\"code\",\"5\",{\"children\":[\"GET /v1/models\"]}],\" and \",[\"$\",\"code\",\"7\",{\"children\":[\"GET /v1/models/{model_id}\"]}],\" now report whether each model accepts the web search and code execution tools. To check whether a model accepts the code execution tool, read \",[\"$\",\"code\",\"9\",{\"children\":[\"capabilities.server_tools.code_execution\"]}],\". The top-level \",[\"$\",\"code\",\"11\",{\"children\":[\"capabilities.code_execution\"]}],\" reports whether code can call your request’s other tools. See \",[\"$\",\"$L97\",\"13\",{\"href\":\"/docs/en/models/overview#using-the-models-api\",\"untracked\":false,\"children\":[\"Using the Models API\"]}],\".\"]}],\"\\n\"]}]\nba:[\"$\",\"h3\",\"69\",{\"id\":\"october-5-2026\",\"className\":\"group\",\"children\":[[\"October 5, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"october-5-2026\",\"name\":\"October 5, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nbb:[\"$\",\"ul\",\"71\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve added \",[\"$\",\"code\",\"1\",{\"children\":[\"capabilities.thinking.types.disabled\"]}],\" to the \",\"$L1f4\",\". \",[\"$\",\"code\",\"5\",{\"children\":[\"GET /v1/models\"]}],\" and \",[\"$\",\"code\",\"7\",{\"children\":[\"GET /v1/models/{model_id}\"]}],\" now report whether each model accepts \",[\"$\",\"code\",\"9\",{\"children\":[\"thinking: {type: \\\"disabled\\\"}\"]}],\", which turns thinking off. See \",[\"$\",\"$L97\",\"11\",{\"href\":\"/docs/en/models/overview#using-the-models-api\",\"untracked\":false,\"children\":[\"Using the Models API\"]}],\".\"]}],\"\\n\"]}]\nbc:[\"$\",\"h3\",\"73\",{\"id\":\"october-1-2026\",\"className\":\"group\",\"children\":[[\"October 1, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"october-1-2026\",\"name\":\"October 1, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nbd:[\"$\",\"ul\",\"75\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve added a \",[\"$\",\"code\",\"1\",{\"children\":[\"line\"]}],\" field to the \",\"$L1f5\",\". \",[\"$\",\"code\",\"5\",{\"children\":[\"GET /v1/models\"]}],\" and \",[\"$\",\"code\",\"7\",{\"children\":[\"GET /v1/models/{model_id}\"]}],\" now return the model line each model belongs to. Claude Opus 4.5 and Claude Opus 4.6 both report \",[\"$\",\"code\",\"9\",{\"children\":[\"opus\"]}],\", for example. Use \",[\"$\",\"code\",\"11\",{\"children\":[\"line\"]}],\" to group models without parsing their IDs. \",[\"$\",\"code\",\"13\",{\"children\":[\"line\"]}],\" is \",[\"$\",\"code\",\"15\",{\"children\":[\"null\"]}],\" for a model that belongs to no line. See \",[\"$\",\"$L97\",\"17\",{\"href\":\"/docs/en/models/overview#using-the-models-api\",\"untracked\":false,\"children\":[\"Using the Models API\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/managed-agents/dreams\",\"untracked\":false,\"children\":[\"Dreams\"]}],\" (research preview) now supports Claude Opus 5.5, Claude Fable 5.1, and Claude Sonnet 5.5. See \",[\"$\",\"$L97\",\"2\",{\"href\":\"/docs/en/managed-agents/dreams#feature-availability\",\"untracked\":false,\"children\":[\"Supported models\"]}],\".\"]}],\"\\n\"]}]\nbe:[\"$\",\"h3\",\"77\",{\"id\":\"september-30-2026\",\"className\":\"group\",\"children\":[[\"September 30, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"september-30-2026\",\"name\":\"September 30, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nbf:[\"$\",\"ul\",\"79\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"In Python SDK 1.10.0, TypeScript SDK 0.130.0, C# SDK 12.52.0, Go SDK 1.77.0, Java SDK 2.67.0, PHP SDK 0.53.0, Ruby SDK 1.75.0, and version 1.37.0 of the \",[\"$\",\"code\",\"1\",{\"children\":[\"ant\"]}],\" CLI, the \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/manage-claude/admin-api\",\"untracked\":false,\"children\":[\"Admin API\"]}],\" methods for organization info, members, invites, workspaces, API keys, rate limits, service accounts, workload identity federation, customer-managed encryption keys, and compliance settings are out of beta: call them under \",[\"$\",\"code\",\"5\",{\"children\":[\"client.organization\"]}],\" and \",[\"$\",\"code\",\"7\",{\"children\":[\"ant organization\"]}],\". These releases also keep \",[\"$\",\"code\",\"9\",{\"children\":[\"client.beta.organization\"]}],\" and \",[\"$\",\"code\",\"11\",{\"children\":[\"ant beta:organization\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"We announced the deprecation of the Claude Sonnet 4.5 model (\",[\"$\",\"code\",\"1\",{\"children\":[\"claude-sonnet-4-5-20250929\"]}],\"), with retirement on the Claude API scheduled for November 30, 2026. We recommend migrating to \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/models/sonnet-5-5/migration-guide#migrating-from-sonnet-45\",\"untracked\":false,\"children\":[\"Claude Sonnet 5.5\"]}],\". Read more in \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/about-claude/model-deprecations\",\"untracked\":false,\"children\":[\"Model deprecations\"]}],\".\"]}],\"\\n\"]}]\nc0:[\"$\",\"h3\",\"81\",{\"id\":\"september-28-2026\",\"className\":\"group\",\"children\":[[\"September 28, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"september-28-2026\",\"name\":\"September 28, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nc1:[\"$\",\"ul\",\"83\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched \",[\"$\",\"strong\",\"1\",{\"children\":[\"Claude Sonnet 5.5\"]}],\" (\",[\"$\",\"code\",\"3\",{\"children\":[\"claude-sonnet-5-5\"]}],\"). It’s available on the Claude API, \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/build-with-claude/claude-in-amazon-bedrock\",\"untracked\":false,\"children\":[\"Claude in Amazon Bedrock\"]}],\", \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/build-with-claude/claude-platform-on-aws\",\"untracked\":false,\"children\":[\"Claude Platform on AWS\"]}],\", \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/build-with-claude/claude-models-on-google-cloud/google-managed\",\"untracked\":false,\"children\":[\"Claude Models on Google Cloud (Google managed)\"]}],\", and \",[\"$\",\"$L97\",\"11\",{\"href\":\"/docs/en/build-with-claude/claude-in-microsoft-foundry\",\"untracked\":false,\"children\":[\"Claude in Microsoft Foundry\"]}],\". For its context window, output limits, and prices, see the \",[\"$\",\"$L97\",\"13\",{\"href\":\"/docs/en/models/sonnet-5-5/overview\",\"untracked\":false,\"children\":[\"Claude Sonnet 5.5 model page\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Code written for Claude Sonnet 5 can break on Claude Sonnet 5.5 in five ways. To turn off up-front thinking, send \",[\"$\",\"code\",\"1\",{\"children\":[\"thinking: {\\\"type\\\": \\\"between_tools\\\"}\"]}],\" instead of \",[\"$\",\"code\",\"3\",{\"children\":[\"\\\"disabled\\\"\"]}],\", at \",[\"$\",\"code\",\"5\",{\"children\":[\"high\"]}],\" effort or below. Forced tool use (\",[\"$\",\"code\",\"7\",{\"children\":[\"tool_choice\"]}],\" types \",[\"$\",\"code\",\"9\",{\"children\":[\"any\"]}],\" and \",[\"$\",\"code\",\"11\",{\"children\":[\"tool\"]}],\") returns a 400 error. Thinking blocks are tied to the model and the conversation. On the Claude API and Google Cloud, the earlier \",[\"$\",\"code\",\"13\",{\"children\":[\"computer_20251124\"]}],\" computer use tool isn’t accepted. The advisor tool rejects Claude Opus 4.8, Claude Opus 4.7, and Claude Sonnet 5 as advisors. See \",[\"$\",\"$L97\",\"15\",{\"href\":\"/docs/en/models/sonnet-5-5/whats-new-sonnet-5-5\",\"untracked\":false,\"children\":[\"What’s new in Claude Sonnet 5.5\"]}],\" for each change and the \",[\"$\",\"$L97\",\"17\",{\"href\":\"/docs/en/models/sonnet-5-5/migration-guide\",\"untracked\":false,\"children\":[\"Claude Sonnet 5.5 migration guide\"]}],\" for before-and-after requests. For model-specific prompting patterns, see \",[\"$\",\"$L97\",\"19\",{\"href\":\"/docs/en/build-with-claude/prompt-engineering/prompting-claude-sonnet-5-5\",\"untracked\":false,\"children\":[\"Prompting Claude Sonnet 5.5\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"Thinking blocks that Claude Sonnet 5.5 produces work only in the account that produced them, or in an account linked to it. When another account sends one of these blocks, the API drops the block before the model sees it, and the request succeeds. Blocks from earlier models aren’t affected. See \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/preserved-thinking#account-bound-thinking\",\"untracked\":false,\"children\":[\"Thinking blocks stay with the account that produced them\"]}],\".\"]}],\"\\n\"]}]\nc2:[\"$\",\"h3\",\"85\",{\"id\":\"september-24-2026\",\"className\":\"group\",\"children\":[[\"September 24, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"september-24-2026\",\"name\":\"September 24, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nc3:[\"$\",\"ul\",\"87\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’re resuming billing for refusals that arrive before any output when \",[\"$\",\"code\",\"1\",{\"children\":[\"stop_details.category\"]}],\" is \",[\"$\",\"code\",\"3\",{\"children\":[\"\\\"bio\\\"\"]}],\", \",[\"$\",\"code\",\"5\",{\"children\":[\"\\\"frontier_llm\\\"\"]}],\", or \",[\"$\",\"code\",\"7\",{\"children\":[\"\\\"reasoning_extraction\\\"\"]}],\", the categories where we measure low volumes of false positives. Mid-stream refusals were already billed. Refusals billed under this change are charged like any other request, at the rates of the model that ran it. Refusals before any output in other categories are still not billed, and fallback credit is unchanged. This change applies on all platforms. See \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/build-with-claude/refusals-and-fallback#how-refusals-are-billed\",\"untracked\":false,\"children\":[\"How refusals are billed\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/manage-claude/compliance-api\",\"untracked\":false,\"children\":[\"Compliance API\"]}],\" local session endpoints are out of beta for Claude for Microsoft 365 sessions in Excel, PowerPoint, Word, and Outlook (\",[\"$\",\"code\",\"3\",{\"children\":[\"product_surface\"]}],\" values beginning with \",[\"$\",\"code\",\"5\",{\"children\":[\"office_agents\"]}],\"). See \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/manage-claude/compliance-sessions#retrieve-local-sessions\",\"untracked\":false,\"children\":[\"Sessions on users’ machines\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/manage-claude/compliance-api\",\"untracked\":false,\"children\":[\"Compliance API\"]}],\" \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/manage-claude/compliance-activity-feed\",\"untracked\":false,\"children\":[\"Activity Feed\"]}],\" no longer returns file names, project document names, or artifact titles. The \",[\"$\",\"code\",\"5\",{\"children\":[\"filename\"]}],\" and \",[\"$\",\"code\",\"7\",{\"children\":[\"title\"]}],\" fields on file, project document, and artifact activities are now always empty or omitted, including on activities recorded before this change. To look up a name or title by the ID on the activity, use a Compliance Access Key with the \",[\"$\",\"code\",\"9\",{\"children\":[\"read:compliance_user_data\"]}],\" scope. See \",[\"$\",\"$L97\",\"11\",{\"href\":\"/docs/en/manage-claude/compliance-activity-feed#understand-the-activity-object\",\"untracked\":false,\"children\":[\"Understand the Activity object\"]}],\".\"]}],\"\\n\"]}]\nc4:[\"$\",\"h3\",\"89\",{\"id\":\"september-23-2026\",\"className\":\"group\",\"children\":[[\"September 23, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"september-23-2026\",\"name\":\"September 23, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nc5:[\"$\",\"ul\",\"91\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/build-with-claude/cache-diagnostics\",\"untracked\":false,\"children\":[\"Cache diagnostics\"]}],\" is out of beta on the Claude API and no longer requires the \",[\"$\",\"code\",\"2\",{\"children\":[\"cache-diagnosis-2026-04-07\"]}],\" beta header. Include the \",[\"$\",\"code\",\"4\",{\"children\":[\"diagnostics\"]}],\" object on a Messages request to opt in; requests that still send the header work as before. Responses from \",[\"$\",\"code\",\"6\",{\"children\":[\"POST /v1/messages\"]}],\" now always include the \",[\"$\",\"code\",\"8\",{\"children\":[\"diagnostics\"]}],\" field, which is \",[\"$\",\"code\",\"10\",{\"children\":[\"null\"]}],\" when the request did not include the \",[\"$\",\"code\",\"12\",{\"children\":[\"diagnostics\"]}],\" object.\"]}],\"\\n\"]}]\nc6:[\"$\",\"h3\",\"93\",{\"id\":\"september-22-2026\",\"className\":\"group\",\"children\":[[\"September 22, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"september-22-2026\",\"name\":\"September 22, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nc7:[\"$\",\"ul\",\"95\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched \",[\"$\",\"strong\",\"1\",{\"children\":[\"Claude Opus 5.5\"]}],\" (\",[\"$\",\"code\",\"3\",{\"children\":[\"claude-opus-5-5\"]}],\"), a model for long-running agentic coding and knowledge work. It has a \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/build-with-claude/context-windows\",\"untracked\":false,\"children\":[\"1M token context window\"]}],\" by default, 128k max output tokens, and always-on \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/build-with-claude/thinking\",\"untracked\":false,\"children\":[\"adaptive thinking\"]}],\", at $4 / $20 USD per MTok (Claude Opus 5 is $5 / $25 USD). Claude Opus 5.5 is available on the Claude API, \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/build-with-claude/claude-in-amazon-bedrock\",\"untracked\":false,\"children\":[\"Claude in Amazon Bedrock\"]}],\", \",[\"$\",\"$L97\",\"11\",{\"href\":\"/docs/en/build-with-claude/claude-platform-on-aws\",\"untracked\":false,\"children\":[\"Claude Platform on AWS\"]}],\", \",[\"$\",\"$L97\",\"13\",{\"href\":\"/docs/en/build-with-claude/claude-models-on-google-cloud/google-managed\",\"untracked\":false,\"children\":[\"Claude Models on Google Cloud (Google managed)\"]}],\", and \",[\"$\",\"$L97\",\"15\",{\"href\":\"/docs/en/build-with-claude/claude-in-microsoft-foundry\",\"untracked\":false,\"children\":[\"Claude in Microsoft Foundry\"]}],\". See \",[\"$\",\"$L97\",\"17\",{\"href\":\"/docs/en/models/opus-5-5/whats-new-opus-5-5\",\"untracked\":false,\"children\":[\"What’s new in Claude Opus 5.5\"]}],\" for capabilities, API changes, and migration guidance.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"On Claude Opus 5.5, thinking can’t be disabled: \",[\"$\",\"code\",\"1\",{\"children\":[\"thinking: {\\\"type\\\": \\\"disabled\\\"}\"]}],\" and \",[\"$\",\"code\",\"3\",{\"children\":[\"thinking: {\\\"type\\\": \\\"enabled\\\", ...}\"]}],\" return a 400 error. Omit the \",[\"$\",\"code\",\"5\",{\"children\":[\"thinking\"]}],\" field and control thinking depth with the \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/build-with-claude/effort\",\"untracked\":false,\"children\":[\"effort parameter\"]}],\". \",[\"$\",\"code\",\"9\",{\"children\":[\"tool_choice\"]}],\" types \",[\"$\",\"code\",\"11\",{\"children\":[\"any\"]}],\" and \",[\"$\",\"code\",\"13\",{\"children\":[\"tool\"]}],\" also return a 400 error, as on Claude Fable 5.1; use \",[\"$\",\"code\",\"15\",{\"children\":[\"auto\"]}],\" with \",[\"$\",\"$L97\",\"17\",{\"href\":\"/docs/en/agents-and-tools/tool-use/strict-tool-use\",\"untracked\":false,\"children\":[\"strict tool use\"]}],\". On the Claude API and Google Cloud, \",[\"$\",\"$L97\",\"19\",{\"href\":\"/docs/en/agents-and-tools/tool-use/computer-use-tool\",\"untracked\":false,\"children\":[\"computer use\"]}],\" on this model requires the \",[\"$\",\"code\",\"21\",{\"children\":[\"computer_toolset_20260801\"]}],\" toolset and the earlier \",[\"$\",\"code\",\"23\",{\"children\":[\"computer_20251124\"]}],\" tool returns a 400 error; on Amazon Bedrock, \",[\"$\",\"code\",\"25\",{\"children\":[\"computer_20251124\"]}],\" keeps working. See the \",[\"$\",\"$L97\",\"27\",{\"href\":\"/docs/en/models/opus-5-5/migration-guide#migrating-from-claude-opus-5\",\"untracked\":false,\"children\":[\"Claude Opus 5.5 migration guide\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/build-with-claude/fast-mode\",\"untracked\":false,\"children\":[\"Fast mode\"]}],\" (research preview) is available for Claude Opus 5.5 on the Claude API.\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"Tools can now be defined inside a \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/mid-conversation-system-messages#define-tools-in-a-message-beta\",\"untracked\":false,\"children\":[\"mid-conversation system message\"]}],\", in beta on the Claude API with the \",[\"$\",\"code\",\"3\",{\"children\":[\"inline-tools-2026-09-15\"]}],\" beta header. A \",[\"$\",\"code\",\"5\",{\"children\":[\"tool_addition\"]}],\" block can carry the tool’s full definition (\",[\"$\",\"code\",\"7\",{\"children\":[\"tool: {\\\"type\\\": \\\"tool_definition\\\", \\\"definition\\\": {...}}\"]}],\"), so you can add a tool, change its schema, or move a server tool to a newer version without editing \",[\"$\",\"code\",\"9\",{\"children\":[\"tools\"]}],\" or invalidating the prompt cache. The same header covers adding and removing tools by reference. With the MCP connector’s \",[\"$\",\"code\",\"11\",{\"children\":[\"mcp-client-2026-09-15\"]}],\" beta header as well, the definition can be an MCP toolset, and a response records each server’s fetched tool list in an \",\"$L1f6\",\" block, which pins that list when you send it back.\"]}],\"\\n\"]}]\nc8:[\"$\",\"h3\",\"97\",{\"id\":\"september-18-2026\",\"className\":\"group\",\"children\":[[\"September 18, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"september-18-2026\",\"name\":\"September 18, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nc9:[\"$\",\"ul\",\"99\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"For \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/cache-diagnostics\",\"untracked\":false,\"children\":[\"cache diagnostics\"]}],\", a response to a request that sends the \",[\"$\",\"code\",\"3\",{\"children\":[\"cache-diagnosis-2026-04-07\"]}],\" beta header now always includes the \",[\"$\",\"code\",\"5\",{\"children\":[\"diagnostics\"]}],\" field. The field is \",[\"$\",\"code\",\"7\",{\"children\":[\"null\"]}],\" when the request did not include the \",[\"$\",\"code\",\"9\",{\"children\":[\"diagnostics\"]}],\" object. Previously the field was omitted in that case.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/manage-claude/compliance-api\",\"untracked\":false,\"children\":[\"Compliance API\"]}],\" local session endpoints now also return transcripts of Claude in Chrome sessions (\",[\"$\",\"code\",\"3\",{\"children\":[\"product_surface\"]}],\" value \",[\"$\",\"code\",\"5\",{\"children\":[\"claude_in_chrome\"]}],\"), in beta for Claude Enterprise organizations, with your existing Compliance Access Key and the \",[\"$\",\"code\",\"7\",{\"children\":[\"read:compliance_user_data\"]}],\" scope. See \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/manage-claude/compliance-sessions#retrieve-local-sessions\",\"untracked\":false,\"children\":[\"Sessions on users’ machines\"]}],\".\"]}],\"\\n\"]}]\nca:[\"$\",\"h3\",\"101\",{\"id\":\"september-14-2026\",\"className\":\"group\",\"children\":[[\"September 14, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"september-14-2026\",\"name\":\"September 14, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ncb:[\"$\",\"ul\",\"103\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"The Messages API can now \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/compaction-on-demand\",\"untracked\":false,\"children\":[\"compact a conversation on demand\"]}],\" on the Claude API, in beta with the \",[\"$\",\"code\",\"3\",{\"children\":[\"compact-2026-09-04\"]}],\" beta header. Send the top-level \",[\"$\",\"code\",\"5\",{\"children\":[\"compaction\"]}],\" parameter, and the API returns a signed \",[\"$\",\"code\",\"7\",{\"children\":[\"compaction\"]}],\" block that summarizes the messages you sent. On later requests, send that block first, in place of those messages. You choose when to compact, the request can run in the background, and you can keep recent turns word for word after the summary. On models with preserved thinking, the thinking in those kept turns can stay valid.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"With the \",[\"$\",\"code\",\"1\",{\"children\":[\"thinking-binding-controls-2026-08-01\"]}],\" beta header, the \",[\"$\",\"code\",\"3\",{\"children\":[\"input_transformations\"]}],\" response field gains a second entry type, \",[\"$\",\"code\",\"5\",{\"children\":[\"thinking_mismatch_allowed\"]}],\". It names a thinking block that failed the prefix check on a request where the API doesn’t enforce that check: on Claude Fable 5.1, for example, a request from an account created before August 31, 2026, with \",[\"$\",\"code\",\"7\",{\"children\":[\"prefix_mismatch_behavior\"]}],\" unset. The block still reaches the model unchanged. Log these entries to find history edits in production traffic before you opt into enforcement. See \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/build-with-claude/preserved-thinking#preserved-thinking-controls\",\"untracked\":false,\"children\":[\"Set the mismatch behavior and read \",[\"$\",\"code\",\"1\",{\"children\":[\"input_transformations\"]}]]}],\".\"]}],\"\\n\"]}]\ncc:[\"$\",\"h3\",\"105\",{\"id\":\"september-10-2026\",\"className\":\"group\",\"children\":[[\"September 10, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"september-10-2026\",\"name\":\"September 10, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ncd:[\"$\",\"ul\",\"107\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Claude Managed Agents permission policies now include \",[\"$\",\"code\",\"1\",{\"children\":[\"auto\"]}],\": the server evaluates each agent or MCP tool call and runs it, denies it, or pauses for your approval. \",[\"$\",\"code\",\"3\",{\"children\":[\"agent.tool_use\"]}],\" and \",[\"$\",\"code\",\"5\",{\"children\":[\"agent.mcp_tool_use\"]}],\" events report how each call was evaluated in an \",[\"$\",\"code\",\"7\",{\"children\":[\"evaluation\"]}],\" field alongside \",[\"$\",\"code\",\"9\",{\"children\":[\"evaluated_permission\"]}],\". See \",[\"$\",\"$L97\",\"11\",{\"href\":\"/docs/en/managed-agents/permission-policies#let-the-server-evaluate-each-call-with-auto\",\"untracked\":false,\"children\":[\"Let the server evaluate each call with \",[\"$\",\"code\",\"1\",{\"children\":[\"auto\"]}]]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Version 1.32.0 of the \",[\"$\",\"code\",\"1\",{\"children\":[\"ant\"]}],\" CLI adds \",[\"$\",\"code\",\"3\",{\"children\":[\"ant beta:sessions connect\"]}],\", which attaches your terminal to a Claude Managed Agents session. You can follow the session live, send messages, and allow or deny tool calls that are waiting for approval. Pass \",[\"$\",\"code\",\"5\",{\"children\":[\"--web\"]}],\" to serve the Claude Console’s session viewer locally and open the session there instead. See \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/cli-sdks-libraries/cli/sessions-connect\",\"untracked\":false,\"children\":[\"Connect to a Managed Agents session from your terminal\"]}],\".\"]}],\"\\n\"]}]\nce:[\"$\",\"h3\",\"109\",{\"id\":\"september-9-2026\",\"className\":\"group\",\"children\":[[\"September 9, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"september-9-2026\",\"name\":\"September 9, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ncf:[\"$\",\"ul\",\"111\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"For \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/cache-diagnostics\",\"untracked\":false,\"children\":[\"cache diagnostics\"]}],\", the API now stores a request’s fingerprint only when the request includes the \",[\"$\",\"code\",\"3\",{\"children\":[\"diagnostics\"]}],\" object. A request that sends only the \",[\"$\",\"code\",\"5\",{\"children\":[\"cache-diagnosis-2026-04-07\"]}],\" beta header is still accepted, but no fingerprint is stored. A later turn that points \",[\"$\",\"code\",\"7\",{\"children\":[\"previous_message_id\"]}],\" at it reports \",[\"$\",\"code\",\"9\",{\"children\":[\"previous_message_not_found\"]}],\". Include \",[\"$\",\"code\",\"11\",{\"children\":[\"diagnostics\"]}],\" on every turn, with \",[\"$\",\"code\",\"13\",{\"children\":[\"\\\"previous_message_id\\\": null\"]}],\" on the first.\"]}],\"\\n\"]}]\nd0:[\"$\",\"h3\",\"113\",{\"id\":\"september-3-2026\",\"className\":\"group\",\"children\":[[\"September 3, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"september-3-2026\",\"name\":\"September 3, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nd1:[\"$\",\"ul\",\"115\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Version 1.30.0 of the \",[\"$\",\"code\",\"1\",{\"children\":[\"ant\"]}],\" CLI adds \",[\"$\",\"code\",\"3\",{\"children\":[\"ant apply\"]}],\", which creates and updates agents, environments, skills, memory stores, and deployments from files in your repository. Describe each resource in a file, run \",[\"$\",\"code\",\"5\",{\"children\":[\"ant apply\"]}],\", and approve the plan it prints. Commit the \",[\"$\",\"code\",\"7\",{\"children\":[\"claude-lock.json\"]}],\" lockfile it writes so that later runs, on your machine or in CI, update the same resources instead of creating new ones. See \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/cli-sdks-libraries/cli/apply\",\"untracked\":false,\"children\":[\"Manage resources as code with ant apply\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/build-with-claude/effort#change-effort-mid-conversation-beta\",\"untracked\":false,\"children\":[\"Per-message effort\"]}],\" changes, in beta, are also available on \",[\"$\",\"$L97\",\"2\",{\"href\":\"/docs/en/build-with-claude/claude-models-on-google-cloud/google-managed\",\"untracked\":false,\"children\":[\"Google Cloud\"]}],\" for Claude Fable 5.1, Claude Mythos 5.1, and Claude Opus 5, with the same \",[\"$\",\"code\",\"4\",{\"children\":[\"mid-conversation-output-config-2026-07-01\"]}],\" beta header.\"]}],\"\\n\"]}]\nd2:[\"$\",\"h3\",\"117\",{\"id\":\"september-1-2026\",\"className\":\"group\",\"children\":[[\"September 1, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"september-1-2026\",\"name\":\"September 1, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nd3:[\"$\",\"ul\",\"119\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched \",[\"$\",\"strong\",\"1\",{\"children\":[\"Claude Fable 5.1\"]}],\" (\",[\"$\",\"code\",\"3\",{\"children\":[\"claude-fable-5-1\"]}],\"), the successor to Claude Fable 5 for long-running agentic coding, knowledge work, and research, alongside \",[\"$\",\"strong\",\"5\",{\"children\":[\"Claude Mythos 5.1\"]}],\" (\",[\"$\",\"code\",\"7\",{\"children\":[\"claude-mythos-5-1\"]}],\") for Project Glasswing participants. Both models support a \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/build-with-claude/context-windows\",\"untracked\":false,\"children\":[\"1M token context window\"]}],\" by default, 128k max output tokens, and always-on \",[\"$\",\"$L97\",\"11\",{\"href\":\"/docs/en/build-with-claude/thinking\",\"untracked\":false,\"children\":[\"adaptive thinking\"]}],\", at $10 / $50 USD per MTok, the same as Claude Fable 5, with cache reads cut to $0.25 USD per MTok. Claude Fable 5.1 is available on the Claude API, \",[\"$\",\"$L97\",\"13\",{\"href\":\"/docs/en/build-with-claude/claude-in-amazon-bedrock\",\"untracked\":false,\"children\":[\"Claude in Amazon Bedrock\"]}],\", \",[\"$\",\"$L97\",\"15\",{\"href\":\"/docs/en/build-with-claude/claude-platform-on-aws\",\"untracked\":false,\"children\":[\"Claude Platform on AWS\"]}],\", \",[\"$\",\"$L97\",\"17\",{\"href\":\"/docs/en/build-with-claude/claude-models-on-google-cloud/google-managed\",\"untracked\":false,\"children\":[\"Claude Models on Google Cloud (Google managed)\"]}],\", and \",[\"$\",\"$L97\",\"19\",{\"href\":\"/docs/en/build-with-claude/claude-in-microsoft-foundry\",\"untracked\":false,\"children\":[\"Claude in Microsoft Foundry\"]}],\". See \",[\"$\",\"$L97\",\"21\",{\"href\":\"/docs/en/models/fable-5-1/whats-new-fable-5-1\",\"untracked\":false,\"children\":[\"What’s new in Claude Fable 5.1\"]}],\" for capabilities, API changes, and migration guidance.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Prompt cache reads on Claude Fable 5.1 and Claude Mythos 5.1 cost $0.25 USD per million tokens: 0.025x the base input price, compared with 0.1x on other models. Cache writes are unchanged. See \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/about-claude/pricing#prompt-caching\",\"untracked\":false,\"children\":[\"Prompt caching pricing\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"On Claude Fable 5.1 and Claude Mythos 5.1, \",[\"$\",\"code\",\"1\",{\"children\":[\"tool_choice\"]}],\" types \",[\"$\",\"code\",\"3\",{\"children\":[\"any\"]}],\" and \",[\"$\",\"code\",\"5\",{\"children\":[\"tool\"]}],\" aren’t supported and return a 400 error. \",[\"$\",\"code\",\"7\",{\"children\":[\"auto\"]}],\" and \",[\"$\",\"code\",\"9\",{\"children\":[\"none\"]}],\" are unchanged. To guarantee schema-conformant tool inputs, use \",[\"$\",\"$L97\",\"11\",{\"href\":\"/docs/en/agents-and-tools/tool-use/strict-tool-use\",\"untracked\":false,\"children\":[\"strict tool use\"]}],\" or \",[\"$\",\"$L97\",\"13\",{\"href\":\"/docs/en/build-with-claude/structured-outputs\",\"untracked\":false,\"children\":[\"structured outputs\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"Thinking blocks produced by Claude Fable 5.1 and Claude Mythos 5.1 are preserved only for the model that produced them or a newer one: earlier models can’t read them, and the API drops one replayed to an earlier model. Claude Fable 5.1 accepts thinking blocks from Claude Opus 5, Claude Fable 5, Claude Mythos 5, and earlier Claude models. On Claude Fable 5.1, the API also \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/thinking#preserved-in-conversation\",\"untracked\":false,\"children\":[\"checks that nothing before a block has changed\"]}],\": for new accounts created on or after August 31, 2026, replaying one after the \",[\"$\",\"code\",\"3\",{\"children\":[\"system\"]}],\" prompt, \",[\"$\",\"code\",\"5\",{\"children\":[\"tools\"]}],\", or an earlier message changed returns a 400 error. With the \",[\"$\",\"code\",\"7\",{\"children\":[\"thinking-binding-controls-2026-08-01\"]}],\" beta header, dropped blocks are reported in an \",[\"$\",\"code\",\"9\",{\"children\":[\"input_transformations\"]}],\" response field, and \",[\"$\",\"code\",\"11\",{\"children\":[\"thinking.block_binding.prefix_mismatch_behavior\"]}],\" chooses between rejecting and dropping blocks whose history changed. See \",\"$L1f7\",\".\"]}],\"\\n\",\"$L1f8\",\"\\n\",\"$L1f9\",\"\\n\",\"$L1fa\",\"\\n\",\"$L1fb\",\"\\n\",\"$L1fc\",\"\\n\",\"$L1fd\",\"\\n\"]}]\nd4:[\"$\",\"h3\",\"121\",{\"id\":\"august-27-2026\",\"className\":\"group\",\"children\":[[\"August 27, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"august-27-2026\",\"name\":\"August 27, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nd5:[\"$\",\"ul\",\"123\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"In Python SDK 1.2.0, TypeScript SDK 0.122.0, Go SDK 1.68.0, Java SDK 2.59.0, Ruby SDK 1.67.0, and C# SDK 12.44.0, \",[\"$\",\"code\",\"1\",{\"children\":[\"client.beta.files\"]}],\" and \",[\"$\",\"code\",\"3\",{\"children\":[\"client.beta.skills\"]}],\" no longer send the \",[\"$\",\"code\",\"5\",{\"children\":[\"files-api-2025-04-14\"]}],\" and \",[\"$\",\"code\",\"7\",{\"children\":[\"skills-2025-10-02\"]}],\" beta headers and return the same shapes as \",[\"$\",\"code\",\"9\",{\"children\":[\"client.files\"]}],\" and \",[\"$\",\"code\",\"11\",{\"children\":[\"client.skills\"]}],\". With this change, \",[\"$\",\"code\",\"13\",{\"children\":[\"client.beta.skills.delete()\"]}],\" deletes a Skill together with all of its versions, and the beta Messages type \",[\"$\",\"code\",\"15\",{\"children\":[\"BetaSkill\"]}],\" (the container Skill reference) is renamed \",[\"$\",\"code\",\"17\",{\"children\":[\"BetaContainerSkill\"]}],\". Requests that still send the beta headers keep receiving the beta shapes. See \",[\"$\",\"$L97\",\"19\",{\"href\":\"/docs/en/build-with-claude/files#migrate-from-files-api-2025-04-14\",\"untracked\":false,\"children\":[\"Migrate from \",[\"$\",\"code\",\"1\",{\"children\":[\"files-api-2025-04-14\"]}]]}],\" and \",[\"$\",\"$L97\",\"21\",{\"href\":\"/docs/en/build-with-claude/skills-guide#migrate-from-skills-2025-10-02\",\"untracked\":false,\"children\":[\"Migrate from \",[\"$\",\"code\",\"1\",{\"children\":[\"skills-2025-10-02\"]}]]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"You can now create \",[\"$\",\"strong\",\"1\",{\"children\":[\"personal keys\"]}],\" and \",[\"$\",\"strong\",\"3\",{\"children\":[\"service account keys\"]}],\" in the Claude Console. They act as you or as a \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/manage-claude/workload-identity-federation#service-accounts\",\"untracked\":false,\"children\":[\"service account\"]}],\", with the same permissions, and stop working when the linked account is removed from an organization. This lets organization admins more easily track usage for each account, and ensure key usage is legitimate. These API keys can be scoped to a specific workspace or \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/manage-claude/authentication#select-a-workspace\",\"untracked\":false,\"children\":[\"work on admin endpoints and across any workspace\"]}],\" the account has access to. Workspace API keys remain supported as a legacy option. See \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/manage-claude/authentication#api-keys\",\"untracked\":false,\"children\":[\"API keys in Authentication\"]}],\" for more information.\"]}],\"\\n\"]}]\nd6:[\"$\",\"h3\",\"125\",{\"id\":\"august-26-2026\",\"className\":\"group\",\"children\":[[\"August 26, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"august-26-2026\",\"name\":\"August 26, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nd7:[\"$\",\"ul\",\"127\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/manage-claude/compliance-api\",\"untracked\":false,\"children\":[\"Compliance API\"]}],\" session endpoints are out of beta for Cowork and Claude Code sessions. See \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/manage-claude/compliance-sessions\",\"untracked\":false,\"children\":[\"Retrieve session transcripts\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/manage-claude/compliance-api\",\"untracked\":false,\"children\":[\"Compliance API\"]}],\" local session endpoints now also return transcripts of Claude Science sessions (\",[\"$\",\"code\",\"3\",{\"children\":[\"product_surface\"]}],\" value \",[\"$\",\"code\",\"5\",{\"children\":[\"claude_science\"]}],\") and Claude for Microsoft 365 sessions in Excel, PowerPoint, Word, and Outlook (\",[\"$\",\"code\",\"7\",{\"children\":[\"product_surface\"]}],\" values beginning with \",[\"$\",\"code\",\"9\",{\"children\":[\"office_agents\"]}],\"), in beta for Claude Enterprise organizations, with your existing Compliance Access Key and the \",[\"$\",\"code\",\"11\",{\"children\":[\"read:compliance_user_data\"]}],\" scope. See \",[\"$\",\"$L97\",\"13\",{\"href\":\"/docs/en/manage-claude/compliance-sessions#retrieve-local-sessions\",\"untracked\":false,\"children\":[\"Sessions on users’ machines\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/manage-claude/admin-api\",\"untracked\":false,\"children\":[\"Admin API\"]}],\" is now available in the \",[\"$\",\"code\",\"3\",{\"children\":[\"ant\"]}],\" CLI and the Python, TypeScript, C#, Go, Java, PHP, and Ruby SDKs under \",[\"$\",\"code\",\"5\",{\"children\":[\"client.beta.organization\"]}],\". They cover organization info, members, invites, workspaces and workspace members, API keys, rate limits, service accounts, workload identity federation issuers and rules, and customer-managed encryption keys. Usage and cost reports and the Claude Enterprise user-management and analytics endpoints remain curl-only. The CLI and SDKs read an Admin API key from \",[\"$\",\"code\",\"7\",{\"children\":[\"ANTHROPIC_API_KEY\"]}],\" or an \",[\"$\",\"code\",\"9\",{\"children\":[\"org:admin\"]}],\" OAuth token from \",[\"$\",\"code\",\"11\",{\"children\":[\"ANTHROPIC_AUTH_TOKEN\"]}],\".\"]}],\"\\n\"]}]\nd8:[\"$\",\"h3\",\"129\",{\"id\":\"august-20-2026\",\"className\":\"group\",\"children\":[[\"August 20, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"august-20-2026\",\"name\":\"August 20, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nd9:[\"$\",\"ul\",\"131\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve released \",[\"$\",\"strong\",\"1\",{\"children\":[\"v1.0 of the \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/cli-sdks-libraries/sdks/python\",\"untracked\":false,\"children\":[\"Python SDK\"]}]]}],\". The SDK’s HTTP layer moves from \",[\"$\",\"code\",\"3\",{\"children\":[\"httpx\"]}],\" to \",[\"$\",\"$L97\",\"5\",{\"href\":\"https://httpx2.pydantic.dev\",\"untracked\":false,\"children\":[\"httpx2\"]}],\", a maintained, API-compatible fork: build custom \",[\"$\",\"code\",\"7\",{\"children\":[\"http_client\"]}],\", \",[\"$\",\"code\",\"9\",{\"children\":[\"Timeout\"]}],\", and transport objects from \",[\"$\",\"code\",\"11\",{\"children\":[\"httpx2\"]}],\" (the \",[\"$\",\"code\",\"13\",{\"children\":[\"DefaultHttpxClient\"]}],\" helpers are unchanged), and call \",[\"$\",\"code\",\"15\",{\"children\":[\"httpx2.alias_httpx()\"]}],\" at startup if you rely on tracing or mocking libraries that patch \",[\"$\",\"code\",\"17\",{\"children\":[\"httpx\"]}],\". v1.0 requires Python 3.10 or later and removes long-deprecated surface, including the legacy Text Completions API, the \",[\"$\",\"code\",\"19\",{\"children\":[\"temperature\"]}],\", \",[\"$\",\"code\",\"21\",{\"children\":[\"top_p\"]}],\", and \",[\"$\",\"code\",\"23\",{\"children\":[\"top_k\"]}],\" parameters on Messages methods, and the tool runner’s client-side \",[\"$\",\"code\",\"25\",{\"children\":[\"compaction_control\"]}],\". On the async client, \",[\"$\",\"code\",\"27\",{\"children\":[\".with_raw_response\"]}],\" results now need \",[\"$\",\"code\",\"29\",{\"children\":[\"await response.parse()\"]}],\", and \",[\"$\",\"code\",\"31\",{\"children\":[\"AnthropicBedrock\"]}],\" now raises an error when no AWS region is configured instead of defaulting to \",[\"$\",\"code\",\"33\",{\"children\":[\"us-east-1\"]}],\". See the \",[\"$\",\"$L97\",\"35\",{\"href\":\"https://github.com/anthropics/anthropic-sdk-python/blob/main/MIGRATION.md\",\"untracked\":false,\"children\":[\"v1 migration guide\"]}],\" for every change with before-and-after snippets.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/computer-use-tool\",\"untracked\":false,\"children\":[\"computer use\"]}],\" and \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/agents-and-tools/tool-use/browser-use-tool\",\"untracked\":false,\"children\":[\"browser use\"]}],\" toolsets (\",[\"$\",\"code\",\"5\",{\"children\":[\"computer_toolset_20260801\"]}],\" and \",[\"$\",\"code\",\"7\",{\"children\":[\"browser_toolset_20260801\"]}],\") are now available on \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/build-with-claude/claude-models-on-google-cloud/google-managed\",\"untracked\":false,\"children\":[\"Google Cloud\"]}],\" for Claude Fable 5, Claude Mythos 5, Claude Opus 5, Claude Sonnet 5, and Claude Opus 4.8. Requests use the same \",[\"$\",\"code\",\"11\",{\"children\":[\"tools\"]}],\" entries as on the Claude API.\"]}],\"\\n\"]}]\nda:[\"$\",\"h3\",\"133\",{\"id\":\"august-19-2026\",\"className\":\"group\",\"children\":[[\"August 19, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"august-19-2026\",\"name\":\"August 19, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ndb:[\"$\",\"ul\",\"135\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/computer-use-tool\",\"untracked\":false,\"children\":[\"computer use tool\"]}],\" is out of beta on the Claude API as the \",[\"$\",\"code\",\"3\",{\"children\":[\"computer_toolset_20260801\"]}],\" toolset: no beta header, batch actions (several actions in one turn), \",[\"$\",\"code\",\"5\",{\"children\":[\"zoom\"]}],\" enabled by default, and per-member configuration through \",[\"$\",\"code\",\"7\",{\"children\":[\"configs\"]}],\". Earlier beta versions remain available. Upgrading an existing integration changes the request shape and tool handling; see \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/agents-and-tools/tool-use/computer-use-tool#migrate-from-computer-20251124\",\"untracked\":false,\"children\":[\"Migrate from \",[\"$\",\"code\",\"1\",{\"children\":[\"computer_20251124\"]}]]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"We’ve launched the \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/browser-use-tool\",\"untracked\":false,\"children\":[\"browser use tool\"]}],\" (\",[\"$\",\"code\",\"3\",{\"children\":[\"browser_toolset_20260801\"]}],\"), a client toolset for driving a browser that your application hosts. It works inside a browser viewport rather than a whole desktop, reading the page itself (its accessibility tree, elements, forms, and tabs) and adding element references, form input, tab management, download reporting, and opt-in file upload on top of screenshot-and-click control.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"Both toolsets are available for Claude Fable 5, Claude Mythos 5, Claude Opus 5, Claude Sonnet 5, and Claude Opus 4.8 on the Claude API.\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/files\",\"untracked\":false,\"children\":[\"Files API\"]}],\" is out of beta on the Claude API. Requests to the \",[\"$\",\"code\",\"3\",{\"children\":[\"/v1/files\"]}],\" endpoints, and Messages API requests that reference an uploaded file, no longer require the \",[\"$\",\"code\",\"5\",{\"children\":[\"files-api-2025-04-14\"]}],\" beta header. Requests sent without the header use the current response format: \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/build-with-claude/files#file-expiration\",\"untracked\":false,\"children\":[\"file expiration\"]}],\" (set \",[\"$\",\"code\",\"9\",{\"children\":[\"expires_in_seconds\"]}],\" when you upload a file; file objects report \",[\"$\",\"code\",\"11\",{\"children\":[\"expires_at\"]}],\"), and \",[\"$\",\"code\",\"13\",{\"children\":[\"page\"]}],\" and \",[\"$\",\"code\",\"15\",{\"children\":[\"next_page\"]}],\" \",[\"$\",\"$L97\",\"17\",{\"href\":\"/docs/en/api/overview#pagination\",\"untracked\":false,\"children\":[\"pagination\"]}],\" plus an \",[\"$\",\"code\",\"19\",{\"children\":[\"ids[]\"]}],\" filter when you \",[\"$\",\"$L97\",\"21\",{\"href\":\"/docs/en/build-with-claude/files#list-files\",\"untracked\":false,\"children\":[\"list files\"]}],\". \",[\"$\",\"code\",\"23\",{\"children\":[\"/v1/files\"]}],\" requests that still send the beta header keep working and return the previous response format.\\nTo move an existing integration off the header, see \",[\"$\",\"$L97\",\"25\",{\"href\":\"/docs/en/build-with-claude/files#migrate-from-files-api-2025-04-14\",\"untracked\":false,\"children\":[\"Migrate from \",[\"$\",\"code\",\"1\",{\"children\":[\"files-api-2025-04-14\"]}]]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/agents-and-tools/agent-skills/overview\",\"untracked\":false,\"children\":[\"Agent Skills\"]}],\" and the Skills API (\",[\"$\",\"code\",\"2\",{\"children\":[\"/v1/skills\"]}],\") are out of beta on the Claude API. Requests no longer require the \",[\"$\",\"code\",\"4\",{\"children\":[\"skills-2025-10-02\"]}],\" beta header, including Messages API requests that load Skills through the \",[\"$\",\"code\",\"6\",{\"children\":[\"container\"]}],\" parameter. Requests that still send the header continue to work unchanged. See \",[\"$\",\"$L97\",\"8\",{\"href\":\"/docs/en/build-with-claude/skills-guide\",\"untracked\":false,\"children\":[\"Using Agent Skills with the API\"]}],\".\\nTo move an existing integration off the header, see \",[\"$\",\"$L97\",\"10\",{\"href\":\"/docs/en/build-with-claude/skills-guide#migrate-from-skills-2025-10-02\",\"untracked\":false,\"children\":[\"Migrate from \",\"$L1fe\"]}],\".\"]}],\"\\n\",\"$L1ff\",\"\\n\",\"$L200\",\"\\n\",\"$L201\",\"\\n\",\"$L202\",\"\\n\"]}]\ndc:[\"$\",\"h3\",\"137\",{\"id\":\"august-18-2026\",\"className\":\"group\",\"children\":[[\"August 18, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"august-18-2026\",\"name\":\"August 18, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ndd:[\"$\",\"ul\",\"139\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Workbench is now \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://platform.claude.com/playground\",\"untracked\":false,\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"playground\"]}]]}],\" in the Claude Console. Playground supports every Messages API parameter and includes templates that demonstrate API features such as code execution and web search. It shows the full SDK request and the API response for each run, to help you understand the API and build with it. For more, see the \",[\"$\",\"$L97\",\"3\",{\"href\":\"https://support.claude.com/en/articles/8606378-how-do-i-use-playground\",\"untracked\":false,\"children\":[\"Claude Help Center\"]}],\" or try it at \",[\"$\",\"$L97\",\"5\",{\"href\":\"https://platform.claude.com/playground\",\"untracked\":false,\"children\":[\"platform.claude.com/playground\"]}],\".\"]}],\"\\n\"]}]\nde:[\"$\",\"h3\",\"141\",{\"id\":\"august-11-2026\",\"className\":\"group\",\"children\":[[\"August 11, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"august-11-2026\",\"name\":\"August 11, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ndf:[\"$\",\"ul\",\"143\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/manage-claude/compliance-api\",\"untracked\":false,\"children\":[\"Compliance API\"]}],\" now returns transcripts of Cowork and Claude Code sessions that run on your users’ machines, in beta for Claude Enterprise organizations. \",[\"$\",\"code\",\"3\",{\"children\":[\"GET /v1/compliance/apps/sessions/local\"]}],\" lists sessions across your organization, \",[\"$\",\"code\",\"5\",{\"children\":[\"GET /v1/compliance/apps/sessions/local/{session_id}\"]}],\" retrieves one session’s metadata, and \",[\"$\",\"code\",\"7\",{\"children\":[\"GET /v1/compliance/apps/sessions/local/{session_id}/messages\"]}],\" returns its transcript, all with your existing Compliance Access Key and the \",[\"$\",\"code\",\"9\",{\"children\":[\"read:compliance_user_data\"]}],\" scope. See \",[\"$\",\"$L97\",\"11\",{\"href\":\"/docs/en/manage-claude/compliance-sessions#retrieve-local-sessions\",\"untracked\":false,\"children\":[\"Sessions on users’ machines\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"We’ve added the \",[\"$\",\"code\",\"1\",{\"children\":[\"anthropic-workspace-id\"]}],\" response header to the Claude API. It carries the \",[\"$\",\"code\",\"3\",{\"children\":[\"wrkspc_\"]}],\"-prefixed ID of the workspace that the request’s API key or access token resolved to, including your organization’s Default Workspace. See \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/manage-claude/workspaces#identify-the-workspace-behind-an-api-response\",\"untracked\":false,\"children\":[\"Identify the workspace behind an API response\"]}],\".\"]}],\"\\n\"]}]\ne0:[\"$\",\"h3\",\"145\",{\"id\":\"august-10-2026\",\"className\":\"group\",\"children\":[[\"August 10, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"august-10-2026\",\"name\":\"August 10, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ne1:[\"$\",\"ul\",\"147\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"The introductory pricing for \",[\"$\",\"strong\",\"1\",{\"children\":[\"Claude Sonnet 5\"]}],\" ($2 / $10 USD per MTok) is now the standard price: the previously scheduled increase to $3 / $15 USD per MTok on September 1, 2026, will not occur. See \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/about-claude/pricing\",\"untracked\":false,\"children\":[\"Pricing\"]}],\".\"]}],\"\\n\"]}]\ne2:[\"$\",\"h3\",\"149\",{\"id\":\"august-7-2026\",\"className\":\"group\",\"children\":[[\"August 7, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"august-7-2026\",\"name\":\"August 7, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ne3:[\"$\",\"ul\",\"151\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"You can now set a budget on a Claude Managed Agents session: a hard cap on the session’s spend, priced at public list rates. A session that reaches its budget pauses with the \",[\"$\",\"code\",\"1\",{\"children\":[\"budget_reached\"]}],\" stop reason instead of starting new model requests; changing or removing the budget resumes it. Deployments accept the same budget and apply it to each session they start. See \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/managed-agents/budgets\",\"untracked\":false,\"children\":[\"Session budgets\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"You can now give a Claude Managed Agents session an advisor: a model at least as capable as the agent’s own that the session’s primary thread can consult mid-turn for strategic guidance. Configure it as a \",[\"$\",\"code\",\"1\",{\"children\":[\"{\\\"type\\\": \\\"advisor\\\"}\"]}],\" entry in the agent’s multiagent roster, naming the \",[\"$\",\"code\",\"3\",{\"children\":[\"model\"]}],\" to consult. See \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/managed-agents/multiagent-orchestration#give-the-session-an-advisor\",\"untracked\":false,\"children\":[\"Give the session an advisor\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"You can now control where model inference runs for a Claude Managed Agents agent. Set \",[\"$\",\"code\",\"1\",{\"children\":[\"inference_geo\"]}],\" inside the \",[\"$\",\"code\",\"3\",{\"children\":[\"model\"]}],\" object when you create the agent (see \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/managed-agents/agent-setup#pin-the-inference-geo\",\"untracked\":false,\"children\":[\"Pin the inference geo\"]}],\"), or \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/managed-agents/sessions#pin-the-inference-geo-for-a-session\",\"untracked\":false,\"children\":[\"override it for a single session\"]}],\". See \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/manage-claude/data-residency\",\"untracked\":false,\"children\":[\"Data residency\"]}],\" for the available geos and pricing.\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"Claude Managed Agents sessions can now \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/managed-agents/skills#load-skills-from-a-github-repository\",\"untracked\":false,\"children\":[\"load skills from a GitHub repository\"]}],\". When a session \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/managed-agents/github\",\"untracked\":false,\"children\":[\"mounts a repository\"]}],\", any skills in its root \",[\"$\",\"code\",\"5\",{\"children\":[\".claude/skills\"]}],\" directory are discovered automatically at session start and available to the agent for that session.\"]}],\"\\n\"]}]\ne4:[\"$\",\"h3\",\"153\",{\"id\":\"august-5-2026\",\"className\":\"group\",\"children\":[[\"August 5, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"august-5-2026\",\"name\":\"August 5, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ne5:[\"$\",\"ul\",\"155\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Inference hooks\"]}],\" are now in beta for Claude Enterprise organizations. Point Claude at your organization’s AI security server, and each governed prompt across claude.ai, Cowork, and Claude Code is held for the server’s allow or deny verdict before inference proceeds. Requests are signed, failure handling is configurable, and every denial is recorded in the compliance \",[\"$\",\"$L97\",\"2\",{\"href\":\"/docs/en/manage-claude/compliance-activity-feed\",\"untracked\":false,\"children\":[\"Activity Feed\"]}],\". See \",[\"$\",\"$L97\",\"4\",{\"href\":\"/docs/en/manage-claude/inference-hooks\",\"untracked\":false,\"children\":[\"Inference hooks\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"We’ve retired the Claude Opus 4.1 model (\",[\"$\",\"code\",\"1\",{\"children\":[\"claude-opus-4-1-20250805\"]}],\"). All requests to this model on the Claude API will now return an error. We recommend upgrading to \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/models/opus-5/overview\",\"untracked\":false,\"children\":[\"Claude Opus 5\"]}],\". Researchers can request ongoing access through the \",[\"$\",\"$L97\",\"5\",{\"href\":\"https://support.claude.com/en/articles/9125743-what-is-the-external-researcher-access-program\",\"untracked\":false,\"children\":[\"External Researcher Access Program\"]}],\".\"]}],\"\\n\"]}]\ne6:[\"$\",\"h3\",\"157\",{\"id\":\"august-3-2026\",\"className\":\"group\",\"children\":[[\"August 3, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"august-3-2026\",\"name\":\"August 3, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ne7:[\"$\",\"ul\",\"159\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/manage-claude/compliance-api\",\"untracked\":false,\"children\":[\"Compliance API\"]}],\" now returns transcripts of Cowork sessions started on claude.ai web or mobile, in beta for Claude Enterprise organizations. \",[\"$\",\"code\",\"3\",{\"children\":[\"GET /v1/compliance/apps/sessions/remote\"]}],\" lists sessions and \",[\"$\",\"code\",\"5\",{\"children\":[\"GET /v1/compliance/apps/sessions/remote/{session_id}/messages\"]}],\" returns one session’s transcript, using your existing Compliance Access Key with the \",[\"$\",\"code\",\"7\",{\"children\":[\"read:compliance_user_data\"]}],\" scope. See \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/manage-claude/compliance-sessions#retrieve-remote-sessions\",\"untracked\":false,\"children\":[\"Sessions in the cloud\"]}],\".\"]}],\"\\n\"]}]\ne8:[\"$\",\"h3\",\"161\",{\"id\":\"august-1-2026\",\"className\":\"group\",\"children\":[[\"August 1, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"august-1-2026\",\"name\":\"August 1, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ne9:[\"$\",\"ul\",\"163\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/managed-agents/dreams\",\"untracked\":false,\"children\":[\"Dreams\"]}],\" (research preview) now supports Claude Opus 5. See \",[\"$\",\"$L97\",\"2\",{\"href\":\"/docs/en/managed-agents/dreams#feature-availability\",\"untracked\":false,\"children\":[\"Supported models\"]}],\".\"]}],\"\\n\"]}]\nea:[\"$\",\"h3\",\"165\",{\"id\":\"july-24-2026\",\"className\":\"group\",\"children\":[[\"July 24, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"july-24-2026\",\"name\":\"July 24, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\neb:[\"$\",\"ul\",\"167\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched \",[\"$\",\"strong\",\"1\",{\"children\":[\"Claude Opus 5\"]}],\" (\",[\"$\",\"code\",\"3\",{\"children\":[\"claude-opus-5\"]}],\"), a step-change improvement over Claude Opus 4.8. Claude Opus 5 supports a \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/build-with-claude/context-windows\",\"untracked\":false,\"children\":[\"1M token context window\"]}],\" (both the default and the maximum), 128k max output tokens, and \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/build-with-claude/thinking\",\"untracked\":false,\"children\":[\"thinking\"]}],\" on by default, at $5 / $25 USD per MTok, the same pricing as Claude Opus 4.8. It’s available on the Claude API, \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/build-with-claude/claude-in-amazon-bedrock\",\"untracked\":false,\"children\":[\"Claude in Amazon Bedrock\"]}],\", \",[\"$\",\"$L97\",\"11\",{\"href\":\"/docs/en/build-with-claude/claude-platform-on-aws\",\"untracked\":false,\"children\":[\"Claude Platform on AWS\"]}],\", \",[\"$\",\"$L97\",\"13\",{\"href\":\"/docs/en/build-with-claude/claude-models-on-google-cloud/google-managed\",\"untracked\":false,\"children\":[\"Claude Models on Google Cloud (Google managed)\"]}],\", and \",[\"$\",\"$L97\",\"15\",{\"href\":\"/docs/en/build-with-claude/claude-in-microsoft-foundry\",\"untracked\":false,\"children\":[\"Claude in Microsoft Foundry\"]}],\". See \",[\"$\",\"$L97\",\"17\",{\"href\":\"/docs/en/models/opus-5/overview\",\"untracked\":false,\"children\":[\"What’s new in Claude Opus 5\"]}],\" for new features, behavior changes, and migration guidance, and the \",[\"$\",\"$L97\",\"19\",{\"href\":\"/docs/en/models/overview\",\"untracked\":false,\"children\":[\"models overview\"]}],\" for complete specs.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"On Claude Opus 5, disabling thinking is allowed only at effort \",[\"$\",\"code\",\"1\",{\"children\":[\"high\"]}],\" or below: \",[\"$\",\"code\",\"3\",{\"children\":[\"thinking: {\\\"type\\\": \\\"disabled\\\"}\"]}],\" with effort \",[\"$\",\"code\",\"5\",{\"children\":[\"xhigh\"]}],\" or \",[\"$\",\"code\",\"7\",{\"children\":[\"max\"]}],\" returns a 400 error, a breaking change from Claude Opus 4.8. See \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/models/opus-5/overview\",\"untracked\":false,\"children\":[\"What’s new in Claude Opus 5\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/build-with-claude/effort\",\"untracked\":false,\"children\":[\"Effort\"]}],\" is the primary control for steering Claude Opus 5: the model supports the full ladder (\",[\"$\",\"code\",\"2\",{\"children\":[\"low\"]}],\", \",[\"$\",\"code\",\"4\",{\"children\":[\"medium\"]}],\", \",[\"$\",\"code\",\"6\",{\"children\":[\"high\"]}],\", \",[\"$\",\"code\",\"8\",{\"children\":[\"xhigh\"]}],\", \",[\"$\",\"code\",\"10\",{\"children\":[\"max\"]}],\"), with \",[\"$\",\"code\",\"12\",{\"children\":[\"max\"]}],\" for capability-critical work.\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"Mid-conversation tool changes are now in beta on Claude Fable 5, Claude Mythos 5, Claude Opus 4.8, and Claude Opus 5: add or remove tools between turns of a conversation while preserving the prompt cache. Include the \",[\"$\",\"code\",\"1\",{\"children\":[\"mid-conversation-tool-changes-2026-07-01\"]}],\" beta header in your requests.\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[\"The \",[\"$\",\"code\",\"1\",{\"children\":[\"fallbacks\"]}],\" parameter now supports a \",[\"$\",\"code\",\"3\",{\"children\":[\"\\\"default\\\"\"]}],\" mode, which applies Anthropic’s recommended fallback models by refusal category. Server-side fallback is in beta, and the \",[\"$\",\"code\",\"5\",{\"children\":[\"\\\"default\\\"\"]}],\" mode requires the \",[\"$\",\"code\",\"7\",{\"children\":[\"server-side-fallback-2026-07-01\"]}],\" beta header. See \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/build-with-claude/refusals-and-fallback\",\"untracked\":false,\"children\":[\"Refusals and fallback\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"11\",{\"children\":[\"We’ve removed \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/fast-mode\",\"untracked\":false,\"children\":[\"fast mode\"]}],\" for Claude Opus 4.7. Requests to \",[\"$\",\"code\",\"3\",{\"children\":[\"claude-opus-4-7\"]}],\" with \",[\"$\",\"code\",\"5\",{\"children\":[\"speed: \\\"fast\\\"\"]}],\" now return an error; unlike Claude Opus 4.6, they do not fall back to standard speed. Claude Opus 4.7 itself remains available at standard speed. To continue using fast mode, migrate to \",\"$L203\",\" or Claude Opus 4.8. Read more in \",\"$L204\",\".\"]}],\"\\n\"]}]\nec:[\"$\",\"h3\",\"169\",{\"id\":\"july-22-2026\",\"className\":\"group\",\"children\":[[\"July 22, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"july-22-2026\",\"name\":\"July 22, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ned:[\"$\",\"ul\",\"171\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"You can now set an \",[\"$\",\"code\",\"1\",{\"children\":[\"effort\"]}],\" level on a Claude Managed Agents agent’s model configuration. Pass \",[\"$\",\"code\",\"3\",{\"children\":[\"effort\"]}],\" inside the \",[\"$\",\"code\",\"5\",{\"children\":[\"model\"]}],\" object when you \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/managed-agents/agent-setup#create-an-agent\",\"untracked\":false,\"children\":[\"create the agent\"]}],\". See \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/build-with-claude/effort#effort-levels\",\"untracked\":false,\"children\":[\"Effort levels\"]}],\" for what each level does.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Webhooks for Claude Managed Agents now cover the environment and memory store lifecycle: four \",[\"$\",\"code\",\"1\",{\"children\":[\"environment.*\"]}],\" event types and three \",[\"$\",\"code\",\"3\",{\"children\":[\"memory_store.*\"]}],\" event types. You can react to environment and memory store lifecycle changes without polling. See the Environment events and Memory store events tabs in \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/managed-agents/webhooks#supported-event-types\",\"untracked\":false,\"children\":[\"Supported event types\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"When creating a Claude Managed Agents session, you can now \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/managed-agents/sessions#seed-the-session-with-initial-events\",\"untracked\":false,\"children\":[\"seed it with initial events\"]}],\". Pass \",[\"$\",\"code\",\"3\",{\"children\":[\"initial_events\"]}],\" on \",[\"$\",\"code\",\"5\",{\"children\":[\"POST /v1/sessions\"]}],\" with up to 50 \",[\"$\",\"code\",\"7\",{\"children\":[\"user.message\"]}],\" and \",[\"$\",\"code\",\"9\",{\"children\":[\"user.define_outcome\"]}],\" events. A non-empty list starts the agent loop in the same call, so you don’t need a separate send-events request to start work.\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"The \",[\"$\",\"code\",\"1\",{\"children\":[\"version\"]}],\" field is now optional when \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/managed-agents/agent-setup#update-an-agent\",\"untracked\":false,\"children\":[\"updating a Claude Managed Agents agent\"]}],\". Supply it for optimistic concurrency (a mismatch returns a 409 error), or omit it to apply the update unconditionally. See \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/managed-agents/agent-setup#update-semantics\",\"untracked\":false,\"children\":[\"Update semantics\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[\"Claude Managed Agents session thread event streams now support \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/managed-agents/event-deltas\",\"untracked\":false,\"children\":[\"event deltas\"]}],\". \",[\"$\",\"code\",\"3\",{\"children\":[\"GET /v1/sessions/{session_id}/threads/{thread_id}/stream\"]}],\" accepts the same \",[\"$\",\"code\",\"5\",{\"children\":[\"event_deltas[]\"]}],\" query parameter as the session-level stream, so you can preview a subagent’s text as the model generates it. A connection previews only the thread it’s reading. See \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/managed-agents/event-deltas#preview-session-thread-events\",\"untracked\":false,\"children\":[\"Preview session thread events\"]}],\".\"]}],\"\\n\"]}]\nee:[\"$\",\"h3\",\"173\",{\"id\":\"july-17-2026\",\"className\":\"group\",\"children\":[[\"July 17, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"july-17-2026\",\"name\":\"July 17, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nef:[\"$\",\"ul\",\"175\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"The legacy \",[\"$\",\"strong\",\"1\",{\"children\":[\"Workbench\"]}],\" (\",[\"$\",\"$L97\",\"3\",{\"href\":\"https://platform.claude.com/workbench\",\"untracked\":false,\"children\":[\"platform.claude.com/workbench\"]}],\") in the Claude Console is being sunset with access ending on August 17, 2026. Saved prompts, variables, and evals are not supported in the updated \",[\"$\",\"$L97\",\"5\",{\"href\":\"https://platform.claude.com/playground\",\"untracked\":false,\"children\":[\"Workbench\"]}],\" in the Console. You can export any data you want to keep from the banner and under your \",[\"$\",\"strong\",\"7\",{\"children\":[\"Organizational Settings\"]}],\". For more, see \",[\"$\",\"$L97\",\"9\",{\"href\":\"https://support.claude.com/en/articles/8606378-how-do-i-use-the-workbench\",\"untracked\":false,\"children\":[\"How do I use the Workbench?\"]}],\" in the Claude Help Center.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"The experimental prompt tools APIs for generating, improving, and templatizing prompts (\",[\"$\",\"code\",\"1\",{\"children\":[\"/v1/experimental/generate_prompt\"]}],\", \",[\"$\",\"code\",\"3\",{\"children\":[\"/v1/experimental/improve_prompt\"]}],\", and \",[\"$\",\"code\",\"5\",{\"children\":[\"/v1/experimental/templatize_prompt\"]}],\") are being retired along with the Workbench on August 17, 2026. After removal, requests to these endpoints will return an error.\"]}],\"\\n\"]}]\nf0:[\"$\",\"h3\",\"177\",{\"id\":\"july-15-2026\",\"className\":\"group\",\"children\":[[\"July 15, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"july-15-2026\",\"name\":\"July 15, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nf1:[\"$\",\"ul\",\"179\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/build-with-claude/mid-conversation-system-messages\",\"untracked\":false,\"children\":[\"Mid-conversation system messages\"]}],\" are available on Claude Fable 5, Claude Mythos 5, and Claude Opus 4.8, on the Claude API, \",[\"$\",\"$L97\",\"2\",{\"href\":\"/docs/en/build-with-claude/claude-in-amazon-bedrock\",\"untracked\":false,\"children\":[\"Claude in Amazon Bedrock\"]}],\", and \",[\"$\",\"$L97\",\"4\",{\"href\":\"/docs/en/build-with-claude/claude-models-on-google-cloud/google-managed\",\"untracked\":false,\"children\":[\"Claude Models on Google Cloud (Google managed)\"]}],\". No beta header is required. This corrects earlier availability notes.\"]}],\"\\n\"]}]\nf2:[\"$\",\"h3\",\"181\",{\"id\":\"july-14-2026\",\"className\":\"group\",\"children\":[[\"July 14, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"july-14-2026\",\"name\":\"July 14, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nf3:[\"$\",\"ul\",\"183\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"You can now manage the people in your \",[\"$\",\"strong\",\"1\",{\"children\":[\"Claude Enterprise\"]}],\" (claude.ai) organization with the Admin API (see the \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/api/beta/organization\",\"untracked\":false,\"children\":[\"Admin API reference\"]}],\"), in beta for all Claude Enterprise organizations: list members and look them up by email address, change a member’s role, remove members, send and withdraw invites, manage groups and their membership, and read custom roles. Group and custom-role requests require the \",[\"$\",\"code\",\"5\",{\"children\":[\"anthropic-beta: ce-user-management-2026-07-13\"]}],\" beta header; member and invite requests take no beta header. An Admin API key with the \",[\"$\",\"code\",\"7\",{\"children\":[\"read:org_audit\"]}],\" scope can also call every user-management \",[\"$\",\"code\",\"9\",{\"children\":[\"GET\"]}],\" endpoint. See \",[\"$\",\"$L97\",\"11\",{\"href\":\"/docs/en/manage-claude/user-management\",\"untracked\":false,\"children\":[\"User management\"]}],\".\"]}],\"\\n\"]}]\nf4:[\"$\",\"h3\",\"185\",{\"id\":\"july-10-2026\",\"className\":\"group\",\"children\":[[\"July 10, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"july-10-2026\",\"name\":\"July 10, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nf5:[\"$\",\"ul\",\"187\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/managed-agents/dreams\",\"untracked\":false,\"children\":[\"Dreams\"]}],\" (research preview) now supports Claude Fable 5 and Claude Sonnet 5. See \",[\"$\",\"$L97\",\"2\",{\"href\":\"/docs/en/managed-agents/dreams#feature-availability\",\"untracked\":false,\"children\":[\"Supported models\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"We’ve expanded the \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/manage-claude/access-transparency\",\"untracked\":false,\"children\":[\"Access Transparency\"]}],\" documentation of \",[\"$\",\"code\",\"3\",{\"children\":[\"cmek_preserve\"]}],\" events with a filter example, an example event payload, and two preservation reason codes (\",[\"$\",\"code\",\"5\",{\"children\":[\"policy_violation_investigation\"]}],\", \",[\"$\",\"code\",\"7\",{\"children\":[\"csae_report\"]}],\"). The documentation now also clarifies that a preservation event is written whether the preservation was initiated by a human reviewer or an automated safety pipeline. See \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/manage-claude/access-transparency#cmek-content-preservation\",\"untracked\":false,\"children\":[\"CMEK content preservation\"]}],\".\"]}],\"\\n\"]}]\nf6:[\"$\",\"h3\",\"189\",{\"id\":\"july-8-2026\",\"className\":\"group\",\"children\":[[\"July 8, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"july-8-2026\",\"name\":\"July 8, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nf7:[\"$\",\"ul\",\"191\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"You can now set an expiration when you create an API key or an Admin API key in the \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://platform.claude.com/settings/keys\",\"untracked\":false,\"children\":[\"Claude Console\"]}],\". Choose a preset, a custom duration, or \",[\"$\",\"strong\",\"3\",{\"children\":[\"Never\"]}],\". For keys with a lifetime of at least 7 days, Anthropic emails the creator before expiration. Existing keys are unaffected. The Admin API reports each key’s expiration in the \",\"$L205\",\" field. See \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/manage-claude/authentication#key-expiration\",\"untracked\":false,\"children\":[\"Key expiration in Authentication\"]}],\".\"]}],\"\\n\"]}]\nf8:[\"$\",\"h3\",\"193\",{\"id\":\"july-2-2026\",\"className\":\"group\",\"children\":[[\"July 2, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"july-2-2026\",\"name\":\"July 2, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nf9:[\"$\",\"ul\",\"195\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve added the \",[\"$\",\"code\",\"1\",{\"children\":[\"agent-memory-2026-07-22\"]}],\" beta header, which changes how \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/managed-agents/memory#list-memories\",\"untracked\":false,\"children\":[\"listing memories\"]}],\" (\",[\"$\",\"code\",\"5\",{\"children\":[\"GET /v1/memory_stores/{memory_store_id}/memories\"]}],\") behaves: results are returned in a stable, server-defined order and the \",[\"$\",\"code\",\"7\",{\"children\":[\"order_by\"]}],\" and \",[\"$\",\"code\",\"9\",{\"children\":[\"order\"]}],\" parameters are ignored; \",[\"$\",\"code\",\"11\",{\"children\":[\"depth\"]}],\" accepts only \",[\"$\",\"code\",\"13\",{\"children\":[\"0\"]}],\", \",[\"$\",\"code\",\"15\",{\"children\":[\"1\"]}],\", or being omitted (other values return a \",[\"$\",\"code\",\"17\",{\"children\":[\"400\"]}],\" error); and \",[\"$\",\"code\",\"19\",{\"children\":[\"path_prefix\"]}],\" must end with \",[\"$\",\"code\",\"21\",{\"children\":[\"/\"]}],\" and matches whole path segments instead of a substring. Page cursors issued without the header aren’t valid with it, so restart from the first page when you adopt it. On memory store endpoints, \",[\"$\",\"code\",\"23\",{\"children\":[\"agent-memory-2026-07-22\"]}],\" replaces \",[\"$\",\"code\",\"25\",{\"children\":[\"managed-agents-2026-04-01\"]}],\"; sending both returns a \",[\"$\",\"code\",\"27\",{\"children\":[\"400\"]}],\" error. On July 22, 2026, the \",[\"$\",\"code\",\"29\",{\"children\":[\"managed-agents-2026-04-01\"]}],\" header adopts the same list behavior. See \",[\"$\",\"$L97\",\"31\",{\"href\":\"/docs/en/api/beta-headers#endpoint-specific-headers\",\"untracked\":false,\"children\":[\"Beta headers\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"The Python (0.116.0), TypeScript (0.110.0), Go (1.56.0), Java (2.48.0), Ruby (1.55.0), PHP (0.36.0), C# (12.35.0), and CLI (1.16.0) SDKs now send \",[\"$\",\"code\",\"1\",{\"children\":[\"agent-memory-2026-07-22\"]}],\" on all memory store calls instead of \",[\"$\",\"code\",\"3\",{\"children\":[\"managed-agents-2026-04-01\"]}],\". If your code passes \",[\"$\",\"code\",\"5\",{\"children\":[\"betas\"]}],\" explicitly on memory store calls, replace \",[\"$\",\"code\",\"7\",{\"children\":[\"managed-agents-2026-04-01\"]}],\" with \",[\"$\",\"code\",\"9\",{\"children\":[\"agent-memory-2026-07-22\"]}],\" there rather than adding a second value.\"]}],\"\\n\"]}]\nfa:[\"$\",\"h3\",\"198\",{\"id\":\"july-1-2026\",\"className\":\"group\",\"children\":[[\"July 1, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"july-1-2026\",\"name\":\"July 1, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nfb:[\"$\",\"ul\",\"200\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve restored access to Claude Fable 5 and Claude Mythos 5. See \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://www.anthropic.com/news/redeploying-fable-5\",\"untracked\":false,\"children\":[\"our statement\"]}],\" for more information.\"]}],\"\\n\"]}]\nfc:[\"$\",\"h3\",\"202\",{\"id\":\"june-30-2026\",\"className\":\"group\",\"children\":[[\"June 30, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"june-30-2026\",\"name\":\"June 30, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nfd:[\"$\",\"ul\",\"204\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched \",[\"$\",\"strong\",\"1\",{\"children\":[\"Claude Sonnet 5\"]}],\" (\",[\"$\",\"code\",\"3\",{\"children\":[\"claude-sonnet-5\"]}],\"), the next generation of our Sonnet model family, at introductory pricing of $2 / $10 USD per MTok (made the standard price on August 10, 2026). Claude Sonnet 5 supports a \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/build-with-claude/context-windows\",\"untracked\":false,\"children\":[\"1M token context window\"]}],\", 128k max output tokens, and the same set of tools and platform features as Claude Sonnet 4.6, except \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/api/service-tiers#supported-models\",\"untracked\":false,\"children\":[\"Priority Tier\"]}],\", which is not available on Claude Sonnet 5. Three behavior changes apply when migrating: \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/build-with-claude/thinking\",\"untracked\":false,\"children\":[\"adaptive thinking\"]}],\" is now on by default; manual extended thinking (\",[\"$\",\"code\",\"11\",{\"children\":[\"thinking: {type: \\\"enabled\\\", budget_tokens: N}\"]}],\") is removed and returns a 400 error (it was deprecated on Sonnet 4.6); and setting sampling parameters (\",[\"$\",\"code\",\"13\",{\"children\":[\"temperature\"]}],\", \",[\"$\",\"code\",\"15\",{\"children\":[\"top_p\"]}],\", \",[\"$\",\"code\",\"17\",{\"children\":[\"top_k\"]}],\") to non-default values returns a 400 error. Claude Sonnet 5 also uses a new tokenizer that produces approximately 30% more tokens for the same text. The exact increase depends on the content and workload shape. See \",[\"$\",\"$L97\",\"19\",{\"href\":\"/docs/en/models/sonnet-5/overview\",\"untracked\":false,\"children\":[\"What’s new in Claude Sonnet 5\"]}],\" for details and migration guidance. For behavioral differences and model-specific prompting patterns, see \",[\"$\",\"$L97\",\"21\",{\"href\":\"/docs/en/build-with-claude/prompt-engineering/prompting-claude-sonnet-5\",\"untracked\":false,\"children\":[\"Prompting Claude Sonnet 5\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Claude Managed Agents session event streams now support \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/managed-agents/event-deltas\",\"untracked\":false,\"children\":[\"event deltas\"]}],\". Opt in with the \",[\"$\",\"code\",\"3\",{\"children\":[\"event_deltas[]\"]}],\" query parameter on \",[\"$\",\"code\",\"5\",{\"children\":[\"GET /v1/sessions/{session_id}/events/stream\"]}],\". The \",[\"$\",\"code\",\"7\",{\"children\":[\"event_start\"]}],\" and \",[\"$\",\"code\",\"9\",{\"children\":[\"event_delta\"]}],\" events preview an agent message’s text as it’s generated, before the complete \",[\"$\",\"code\",\"11\",{\"children\":[\"agent.message\"]}],\" event arrives.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/managed-agents/session-operations#listing-sessions\",\"untracked\":false,\"children\":[\"Listing sessions\"]}],\" for Claude Managed Agents now supports backward pagination. \",[\"$\",\"code\",\"2\",{\"children\":[\"GET /v1/sessions\"]}],\" returns a \",[\"$\",\"code\",\"4\",{\"children\":[\"prev_page\"]}],\" cursor alongside \",[\"$\",\"code\",\"6\",{\"children\":[\"next_page\"]}],\"; pass it as the \",[\"$\",\"code\",\"8\",{\"children\":[\"page\"]}],\" parameter to return to the previous page. See \",[\"$\",\"$L97\",\"10\",{\"href\":\"/docs/en/api/overview#pagination\",\"untracked\":false,\"children\":[\"Pagination\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"When creating a Claude Managed Agents session, you can now \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/managed-agents/sessions#override-agent-configuration-for-a-session\",\"untracked\":false,\"children\":[\"override the agent’s configuration for that session\"]}],\". Pass \",[\"$\",\"code\",\"3\",{\"children\":[\"agent\"]}],\" with \",[\"$\",\"code\",\"5\",{\"children\":[\"type: \\\"agent_with_overrides\\\"\"]}],\" to replace the model, system prompt, tools, MCP servers, or skills for a single session. The agent itself is unchanged.\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[\"Claude Managed Agents vaults now support an \",[\"$\",\"code\",\"1\",{\"children\":[\"injection_location\"]}],\" setting on \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/managed-agents/vaults#add-a-credential\",\"untracked\":false,\"children\":[\"environment variable credentials\"]}],\" (the Environment variable tab). It controls whether the credential’s value is substituted, at egress, into the agent’s outbound request headers, the request body, or both.\"]}],\"\\n\",\"$L206\",\"\\n\"]}]\nfe:[\"$\",\"h3\",\"206\",{\"id\":\"june-29-2026\",\"className\":\"group\",\"children\":[[\"June 29, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"june-29-2026\",\"name\":\"June 29, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nff:[\"$\",\"ul\",\"208\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve removed \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/fast-mode\",\"untracked\":false,\"children\":[\"fast mode\"]}],\" for Claude Opus 4.6. Requests to \",[\"$\",\"code\",\"3\",{\"children\":[\"claude-opus-4-6\"]}],\" with \",[\"$\",\"code\",\"5\",{\"children\":[\"speed: \\\"fast\\\"\"]}],\" no longer run at fast speed or premium pricing: they run at standard speed, are billed at standard rates, and do not return an error. The response’s \",[\"$\",\"code\",\"7\",{\"children\":[\"usage.speed\"]}],\" field reports the speed used. To continue using fast mode, migrate to \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/models/opus-4-8/overview\",\"untracked\":false,\"children\":[\"Claude Opus 4.8\"]}],\". Read more in \",[\"$\",\"$L97\",\"11\",{\"href\":\"/docs/en/build-with-claude/fast-mode#supported-models\",\"untracked\":false,\"children\":[\"Fast mode model availability\"]}],\".\"]}],\"\\n\"]}]\n100:[\"$\",\"h3\",\"210\",{\"id\":\"june-26-2026\",\"className\":\"group\",\"children\":[[\"June 26, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"june-26-2026\",\"name\":\"June 26, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n101:[\"$\",\"ul\",\"212\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve raised \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/api/rate-limits\",\"untracked\":false,\"children\":[\"rate limits\"]}],\" across the Claude API. Claude Sonnet and Claude Haiku rate limits now match Claude Opus at every usage tier, and usage tiers have been consolidated into three: Start, Build, and Scale. Most organizations move to a higher tier, no organization receives lower limits than before, and no action is required. You can \",[\"$\",\"$L97\",\"3\",{\"href\":\"/settings/limits\",\"untracked\":false,\"children\":[\"view your tier and current limits\"]}],\" in the Claude Console.\"]}],\"\\n\"]}]\n102:[\"$\",\"h3\",\"214\",{\"id\":\"june-25-2026\",\"className\":\"group\",\"children\":[[\"June 25, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"june-25-2026\",\"name\":\"June 25, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n103:[\"$\",\"ul\",\"216\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve deprecated \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/fast-mode\",\"untracked\":false,\"children\":[\"fast mode\"]}],\" for Claude Opus 4.7, with removal on July 24, 2026. After removal, requests to \",[\"$\",\"code\",\"3\",{\"children\":[\"claude-opus-4-7\"]}],\" with \",[\"$\",\"code\",\"5\",{\"children\":[\"speed: \\\"fast\\\"\"]}],\" will return an error. Migrate to fast mode for Claude Opus 4.8. Read more in \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/build-with-claude/fast-mode#supported-models\",\"untracked\":false,\"children\":[\"Fast mode model availability\"]}],\".\"]}],\"\\n\"]}]\n104:[\"$\",\"h3\",\"218\",{\"id\":\"june-22-2026\",\"className\":\"group\",\"children\":[[\"June 22, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"june-22-2026\",\"name\":\"June 22, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n105:[\"$\",\"ul\",\"220\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"MCP tunnels\"]}],\" (research preview): the management API moved from \",[\"$\",\"code\",\"2\",{\"children\":[\"/v1/organizations/tunnels\"]}],\" on the Admin API to \",[\"$\",\"code\",\"4\",{\"children\":[\"/v1/tunnels\"]}],\" on the Claude API. The new surface uses the \",[\"$\",\"code\",\"6\",{\"children\":[\"anthropic-beta: mcp-tunnels-2026-06-22\"]}],\" header and the \",[\"$\",\"code\",\"8\",{\"children\":[\"workspace:manage_tunnels\"]}],\" WIF scope. The previous surface remains available during a migration window. See the \",[\"$\",\"$L97\",\"10\",{\"href\":\"/docs/en/api/beta/tunnels\",\"untracked\":false,\"children\":[\"Tunnels API reference\"]}],\".\"]}],\"\\n\"]}]\n106:[\"$\",\"h3\",\"222\",{\"id\":\"june-18-2026\",\"className\":\"group\",\"children\":[[\"June 18, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"june-18-2026\",\"name\":\"June 18, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n107:[\"$\",\"ul\",\"224\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"The Python, TypeScript, Go, Java, Ruby, PHP, and C# SDKs now include support for \",[\"$\",\"code\",\"1\",{\"children\":[\"code_execution_20260120\"]}],\", the \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/agents-and-tools/tool-use/code-execution-tool\",\"untracked\":false,\"children\":[\"code execution tool\"]}],\" version that adds REPL state persistence and is the minimum version for \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/agents-and-tools/tool-use/programmatic-tool-calling\",\"untracked\":false,\"children\":[\"programmatic tool calling\"]}],\". To adopt it, set the tool’s \",[\"$\",\"code\",\"7\",{\"children\":[\"type\"]}],\" to \",[\"$\",\"code\",\"9\",{\"children\":[\"code_execution_20260120\"]}],\"; no beta header is required. It’s available on Claude Fable 5, Claude Mythos 5, Claude Opus 4.5 and newer, and Claude Sonnet 4.5 and newer; see the code execution tool’s \",[\"$\",\"$L97\",\"11\",{\"href\":\"/docs/en/agents-and-tools/tool-use/code-execution-tool#availability-feature-support\",\"untracked\":false,\"children\":[\"API support\"]}],\" section.\"]}],\"\\n\"]}]\n108:[\"$\",\"h3\",\"226\",{\"id\":\"june-15-2026\",\"className\":\"group\",\"children\":[[\"June 15, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"june-15-2026\",\"name\":\"June 15, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n109:[\"$\",\"ul\",\"228\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve retired the Claude Sonnet 4 model (\",[\"$\",\"code\",\"1\",{\"children\":[\"claude-sonnet-4-20250514\"]}],\") and the Claude Opus 4 model (\",[\"$\",\"code\",\"3\",{\"children\":[\"claude-opus-4-20250514\"]}],\"). All requests to these models on the Claude API will now return an error. We recommend upgrading to \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/models/overview#latest-models-comparison\",\"untracked\":false,\"children\":[\"Claude Sonnet 4.6\"]}],\" and \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/models/opus-4-8/overview\",\"untracked\":false,\"children\":[\"Claude Opus 4.8\"]}],\" respectively. Researchers can request ongoing access through the \",[\"$\",\"$L97\",\"9\",{\"href\":\"https://support.claude.com/en/articles/9125743-what-is-the-external-researcher-access-program\",\"untracked\":false,\"children\":[\"External Researcher Access Program\"]}],\".\"]}],\"\\n\"]}]\n10a:[\"$\",\"h3\",\"230\",{\"id\":\"june-11-2026\",\"className\":\"group\",\"children\":[[\"June 11, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"june-11-2026\",\"name\":\"June 11, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n10b:[\"$\",\"ul\",\"232\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/code-execution-tool\",\"untracked\":false,\"children\":[\"code execution tool\"]}],\" now supports \",[\"$\",\"code\",\"3\",{\"children\":[\"code_execution_20260521\"]}],\", which discloses the 90-second per-cell execution time limit in the tool description so Claude can budget long-running cells. No beta header is required.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/web-search-tool\",\"untracked\":false,\"children\":[\"web search tool\"]}],\" and \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/agents-and-tools/tool-use/web-fetch-tool\",\"untracked\":false,\"children\":[\"web fetch tool\"]}],\" now support \",[\"$\",\"code\",\"5\",{\"children\":[\"web_search_20260318\"]}],\" and \",[\"$\",\"code\",\"7\",{\"children\":[\"web_fetch_20260318\"]}],\", adding a \",[\"$\",\"code\",\"9\",{\"children\":[\"response_inclusion\"]}],\" parameter to drop consumed result blocks from the API response for agentic workflows. No beta header is required.\"]}],\"\\n\"]}]\n10c:[\"$\",\"h3\",\"234\",{\"id\":\"june-10-2026\",\"className\":\"group\",\"children\":[[\"June 10, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"june-10-2026\",\"name\":\"June 10, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n10d:[\"$\",\"ul\",\"236\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"The \",[\"$\",\"code\",\"1\",{\"children\":[\"GET /v1/environments/{id}/work\"]}],\" endpoint, which lists pending work for a \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/managed-agents/self-hosted-sandboxes\",\"untracked\":false,\"children\":[\"self-hosted sandbox\"]}],\", is now available on \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/build-with-claude/claude-platform-on-aws\",\"untracked\":false,\"children\":[\"Claude Platform on AWS\"]}],\". See \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/api/claude-platform-on-aws-iam-actions\",\"untracked\":false,\"children\":[\"IAM actions for Claude Platform on AWS\"]}],\" for the \",[\"$\",\"code\",\"9\",{\"children\":[\"GetEnvironment\"]}],\" action that authorizes it.\"]}],\"\\n\"]}]\n10e:[\"$\",\"h3\",\"238\",{\"id\":\"june-9-2026\",\"className\":\"group\",\"children\":[[\"June 9, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"june-9-2026\",\"name\":\"June 9, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n10f:[\"$\",\"ul\",\"240\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched \",[\"$\",\"strong\",\"1\",{\"children\":[\"Claude Fable 5\"]}],\" (\",[\"$\",\"code\",\"3\",{\"children\":[\"claude-fable-5\"]}],\"), our most capable model open to all customers, alongside \",[\"$\",\"strong\",\"5\",{\"children\":[\"Claude Mythos 5\"]}],\" (\",[\"$\",\"code\",\"7\",{\"children\":[\"claude-mythos-5\"]}],\") for Project Glasswing participants. Both models support a \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/build-with-claude/context-windows\",\"untracked\":false,\"children\":[\"1M token context window\"]}],\" by default, 128k max output tokens, and always-on \",[\"$\",\"$L97\",\"11\",{\"href\":\"/docs/en/build-with-claude/thinking\",\"untracked\":false,\"children\":[\"adaptive thinking\"]}],\". See \",[\"$\",\"$L97\",\"13\",{\"href\":\"/docs/en/models/fable-5/overview\",\"untracked\":false,\"children\":[\"Claude Fable 5\"]}],\" for specifications, pricing, and availability.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Claude Fable 5 and Claude Mythos 5 use the tokenizer introduced with Claude Opus 4.7. Compared to models before Claude Opus 4.7, the same text produces roughly 30% more tokens. The exact increase depends on the content and workload shape. Use the token counting API with \",[\"$\",\"code\",\"1\",{\"children\":[\"model: \\\"claude-fable-5\\\"\"]}],\" to measure your prompts under the new tokenizer. See \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/build-with-claude/token-counting#token-counts-on-claude-fable-5\",\"untracked\":false,\"children\":[\"Token counts on Claude Fable and Claude Mythos models\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"Claude Fable 5 runs safety classifiers on requests and during response generation. When a classifier declines a request, the Messages API returns \",[\"$\",\"code\",\"1\",{\"children\":[\"stop_reason: \\\"refusal\\\"\"]}],\". You are not billed for a request refused before any output is generated. An opt-in \",[\"$\",\"code\",\"3\",{\"children\":[\"fallbacks\"]}],\" parameter (in beta on the Claude API and Claude Platform on AWS; not supported on the Message Batches API) re-runs refused requests on another model, billed at the fallback model’s rates. See \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/build-with-claude/handling-stop-reasons\",\"untracked\":false,\"children\":[\"Handling stop reasons\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/refusals-and-fallback#refusal-response\",\"untracked\":false,\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"stop_details.category\"]}]]}],\" field on refusal responses now includes \",[\"$\",\"code\",\"3\",{\"children\":[\"\\\"reasoning_extraction\\\"\"]}],\" on Claude Fable 5, returned when a request is blocked under Anthropic’s Terms of Service restrictions on reverse engineering or duplicating model outputs. The existing \",[\"$\",\"code\",\"5\",{\"children\":[\"\\\"cyber\\\"\"]}],\" and \",[\"$\",\"code\",\"7\",{\"children\":[\"\\\"bio\\\"\"]}],\" categories are unchanged. No beta header is required.\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[\"On Claude Fable 5 and Claude Mythos 5, \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/thinking\",\"untracked\":false,\"children\":[\"adaptive thinking\"]}],\" is the only thinking mode: \",[\"$\",\"code\",\"3\",{\"children\":[\"thinking: {\\\"type\\\": \\\"disabled\\\"}\"]}],\" is not supported, and manual extended thinking budgets and assistant prefill are not supported (both return a 400 error).\"]}],\"\\n\",[\"$\",\"li\",\"11\",{\"children\":[\"On Claude Fable 5 and Claude Mythos 5, \",[\"$\",\"code\",\"1\",{\"children\":[\"thinking.display\"]}],\" defaults to \",[\"$\",\"code\",\"3\",{\"children\":[\"\\\"omitted\\\"\"]}],\", the same as Claude Opus 4.8, Claude Opus 4.7, and Claude Mythos Preview; set \",[\"$\",\"code\",\"5\",{\"children\":[\"display: \\\"summarized\\\"\"]}],\" to receive readable thinking summaries. The raw chain of thought is never returned; pass thinking blocks back unchanged in multi-turn conversations on the same model. See \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/build-with-claude/thinking#thinking-output-on-claude-fable-5-and-claude-mythos-5\",\"untracked\":false,\"children\":[\"Thinking output on Claude Fable 5 and Claude Mythos 5\"]}],\".\"]}],\"\\n\",\"$L207\",\"\\n\",\"$L208\",\"\\n\",\"$L209\",\"\\n\",\"$L20a\",\"\\n\",\"$L20b\",\"\\n\",\"$L20c\",\"\\n\"]}]\n110:[\"$\",\"h3\",\"242\",{\"id\":\"june-5-2026\",\"className\":\"group\",\"children\":[[\"June 5, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"june-5-2026\",\"name\":\"June 5, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n111:[\"$\",\"ul\",\"244\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We announced the deprecation of the Claude Opus 4.1 model (\",[\"$\",\"code\",\"1\",{\"children\":[\"claude-opus-4-1-20250805\"]}],\"), with retirement on the Claude API scheduled for August 5, 2026. We recommend migrating to \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/models/opus-4-8/overview\",\"untracked\":false,\"children\":[\"Claude Opus 4.8\"]}],\". Read more in \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/about-claude/model-deprecations\",\"untracked\":false,\"children\":[\"Model deprecations\"]}],\".\"]}],\"\\n\"]}]\n112:[\"$\",\"h3\",\"246\",{\"id\":\"june-2-2026\",\"className\":\"group\",\"children\":[[\"June 2, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"june-2-2026\",\"name\":\"June 2, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n113:[\"$\",\"ul\",\"248\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/advisor-tool\",\"untracked\":false,\"children\":[\"advisor tool\"]}],\" now supports a \",[\"$\",\"code\",\"3\",{\"children\":[\"max_tokens\"]}],\" parameter to cap the advisor model’s output for each call, reducing latency and output token cost for workloads that don’t need full-length advisor responses. Set \",[\"$\",\"code\",\"5\",{\"children\":[\"tools[].max_tokens\"]}],\" on the advisor tool definition; see \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/agents-and-tools/tool-use/advisor-tool#capping-advisor-output\",\"untracked\":false,\"children\":[\"Capping advisor output\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"On the Claude API, you are no longer billed for a request when it returns \",[\"$\",\"code\",\"1\",{\"children\":[\"stop_reason: \\\"refusal\\\"\"]}],\" without Claude having generated any output. See \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/test-and-evaluate/strengthen-guardrails/handle-streaming-refusals\",\"untracked\":false,\"children\":[\"Streaming refusals\"]}],\" for detecting and handling refusals.\"]}],\"\\n\"]}]\n114:[\"$\",\"h3\",\"250\",{\"id\":\"may-29-2026\",\"className\":\"group\",\"children\":[[\"May 29, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"may-29-2026\",\"name\":\"May 29, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n115:[\"$\",\"ul\",\"252\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Claude Managed Agents \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/managed-agents/webhooks\",\"untracked\":false,\"children\":[\"webhooks\"]}],\", \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/managed-agents/multiagent-orchestration\",\"untracked\":false,\"children\":[\"multiagent orchestration\"]}],\", and \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/managed-agents/self-hosted-sandboxes\",\"untracked\":false,\"children\":[\"self-hosted sandboxes\"]}],\" are now available on \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/build-with-claude/claude-platform-on-aws\",\"untracked\":false,\"children\":[\"Claude Platform on AWS\"]}],\". See \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/api/claude-platform-on-aws-iam-actions\",\"untracked\":false,\"children\":[\"IAM actions for Claude Platform on AWS\"]}],\" for the new IAM actions and the \",[\"$\",\"code\",\"11\",{\"children\":[\"AnthropicSelfHostedEnvironmentAccess\"]}],\" managed policy.\"]}],\"\\n\"]}]\n116:[\"$\",\"h3\",\"254\",{\"id\":\"may-28-2026\",\"className\":\"group\",\"children\":[[\"May 28, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"may-28-2026\",\"name\":\"May 28, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n117:[\"$\",\"ul\",\"256\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched \",[\"$\",\"strong\",\"1\",{\"children\":[\"Claude Opus 4.8\"]}],\" (\",[\"$\",\"$L20d\",\"3\",{\"id\":\"claude-opus-4-8\",\"children\":\"$undefined\"}],\"), our most capable model. Claude Opus 4.8 supports a \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/build-with-claude/context-windows\",\"untracked\":false,\"children\":[\"1M token context window\"]}],\" by default on the Claude API, Amazon Bedrock, Google Cloud, and Microsoft Foundry, 128k max output tokens, and the same set of tools and platform features as Claude Opus 4.7. See the \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/about-claude/models/migration-guide\",\"untracked\":false,\"children\":[\"migration guide\"]}],\" for baseline settings, features, and migration guidance.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"We’ve launched \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/mid-conversation-system-messages\",\"untracked\":false,\"children\":[\"mid-conversation system messages\"]}],\". On Claude Opus 4.8, you can send \",[\"$\",\"code\",\"3\",{\"children\":[\"role: \\\"system\\\"\"]}],\" messages after a user turn (subject to \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/build-with-claude/mid-conversation-system-messages#limitations\",\"untracked\":false,\"children\":[\"placement rules\"]}],\") in the \",[\"$\",\"code\",\"7\",{\"children\":[\"messages\"]}],\" array, preserving prompt cache hits when instructions change during a long-running session. No beta header is required.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/refusals-and-fallback#refusal-response\",\"untracked\":false,\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"stop_details\"]}]]}],\" field on refusal responses is now publicly documented; it returns a \",[\"$\",\"code\",\"3\",{\"children\":[\"category\"]}],\" (\",[\"$\",\"code\",\"5\",{\"children\":[\"cyber\"]}],\", \",[\"$\",\"code\",\"7\",{\"children\":[\"bio\"]}],\", or \",[\"$\",\"code\",\"9\",{\"children\":[\"null\"]}],\") and a human-readable \",[\"$\",\"code\",\"11\",{\"children\":[\"explanation\"]}],\", so your application can route different classes of refusal to the right next step. No beta header is required.\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"On Claude Opus 4.8, the \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/effort\",\"untracked\":false,\"children\":[\"effort parameter\"]}],\" defaults to \",[\"$\",\"code\",\"3\",{\"children\":[\"high\"]}],\" across all surfaces, including Claude Code and the Messages API.\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[\"On Claude Opus 4.8, the minimum cacheable prompt length for \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/prompt-caching\",\"untracked\":false,\"children\":[\"prompt caching\"]}],\" is 1,024 tokens, lower than on Claude Opus 4.7.\"]}],\"\\n\",[\"$\",\"li\",\"11\",{\"children\":[\"With \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/thinking\",\"untracked\":false,\"children\":[\"adaptive thinking\"]}],\" enabled, Claude Opus 4.8 triggers reasoning only when a turn needs it, reducing wasted thinking tokens compared to Claude Opus 4.7 at the same effort level.\"]}],\"\\n\",[\"$\",\"li\",\"13\",{\"children\":[\"Claude Opus 4.8 supports \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/vision#high-resolution-image-support-on-claude-opus-4-7\",\"untracked\":false,\"children\":[\"high-resolution image input\"]}],\" (up to 2,576 pixels on the long edge), same as Claude Opus 4.7.\"]}],\"\\n\",[\"$\",\"li\",\"15\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/build-with-claude/task-budgets\",\"untracked\":false,\"children\":[\"Task budgets\"]}],\" now support Claude Opus 4.8.\"]}],\"\\n\",[\"$\",\"li\",\"17\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/advisor-tool\",\"untracked\":false,\"children\":[\"advisor tool\"]}],\" now supports Claude Opus 4.8.\"]}],\"\\n\",[\"$\",\"li\",\"19\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/agents-and-tools/tool-use/computer-use-tool\",\"untracked\":false,\"children\":[\"Computer use\"]}],\" now supports Claude Opus 4.8.\"]}],\"\\n\",[\"$\",\"li\",\"21\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/build-with-claude/fast-mode\",\"untracked\":false,\"children\":[\"Fast mode\"]}],\" for Claude Opus 4.8 is available as a research preview on the Claude API only.\"]}],\"\\n\",[\"$\",\"li\",\"23\",{\"children\":[\"Setting the sampling parameters \",\"$L20e\",\", \",\"$L20f\",\", or \",\"$L210\",\" to a non-default value returns a 400 error on Claude Opus 4.8, same as on Claude Opus 4.7. See the \",\"$L211\",\" for details.\"]}],\"\\n\",\"$L212\",\"\\n\",\"$L213\",\"\\n\",\"$L214\",\"\\n\",\"$L215\",\"\\n\",\"$L216\",\"\\n\"]}]\n118:[\"$\",\"h3\",\"258\",{\"id\":\"may-27-2026\",\"className\":\"group\",\"children\":[[\"May 27, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"may-27-2026\",\"name\":\"May 27, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n119:[\"$\",\"ul\",\"260\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"The Messages API response now includes \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/extended-thinking#budget-rules-and-tuning\",\"untracked\":false,\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"usage.output_tokens_details.thinking_tokens\"]}]]}],\", reporting how many of the billed output tokens were extended thinking. When streaming, the breakdown appears only on the final \",[\"$\",\"code\",\"3\",{\"children\":[\"message_delta\"]}],\" event. No beta header is required.\"]}],\"\\n\"]}]\n11a:[\"$\",\"h3\",\"262\",{\"id\":\"may-19-2026\",\"className\":\"group\",\"children\":[[\"May 19, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"may-19-2026\",\"name\":\"May 19, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n11b:[\"$\",\"ul\",\"264\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/agents-and-tools/mcp-tunnels/overview\",\"untracked\":false,\"children\":[\"MCP tunnels\"]}],\" is now available as a research preview, so you can connect to MCP servers in your private network.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Self-hosted sandboxes are now available for Claude Managed Agents, as an alternative to running tool execution in Anthropic’s infrastructure. See \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/managed-agents/self-hosted-sandboxes\",\"untracked\":false,\"children\":[\"Self-hosted sandboxes\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"With Claude Managed Agents, you can now update the agent’s MCP server and tool configurations associated with an active session.\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"With Claude Managed Agents, large outputs from \",[\"$\",\"code\",\"1\",{\"children\":[\"agent_toolset\"]}],\" and MCP tools exceeding 100k characters (about 25k tokens) are now automatically spilled to a file in the sandbox. The model receives a truncated preview with the file path and can read the full content from there.\"]}],\"\\n\"]}]\n11c:[\"$\",\"h3\",\"266\",{\"id\":\"may-18-2026\",\"className\":\"group\",\"children\":[[\"May 18, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"may-18-2026\",\"name\":\"May 18, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n11d:[\"$\",\"ul\",\"268\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/web-search-tool\",\"untracked\":false,\"children\":[\"web search tool\"]}],\" now returns richer SEC filing data, making it easier to ground financial research agents, earnings analysis, and due-diligence workflows in primary sources with citations.\"]}],\"\\n\"]}]\n11e:[\"$\",\"h3\",\"270\",{\"id\":\"may-13-2026\",\"className\":\"group\",\"children\":[[\"May 13, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"may-13-2026\",\"name\":\"May 13, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n11f:[\"$\",\"ul\",\"272\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/cache-diagnostics\",\"untracked\":false,\"children\":[\"cache diagnostics\"]}],\" in beta. Pass \",[\"$\",\"code\",\"3\",{\"children\":[\"diagnostics.previous_message_id\"]}],\" on a Messages request and the API reports a \",[\"$\",\"code\",\"5\",{\"children\":[\"cache_miss_reason\"]}],\" explaining where the prompt cache prefix diverged from the previous turn. Include the \",[\"$\",\"code\",\"7\",{\"children\":[\"cache-diagnosis-2026-04-07\"]}],\" beta header in your requests.\"]}],\"\\n\"]}]\n120:[\"$\",\"h3\",\"274\",{\"id\":\"may-12-2026\",\"className\":\"group\",\"children\":[[\"May 12, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"may-12-2026\",\"name\":\"May 12, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n121:[\"$\",\"ul\",\"276\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/build-with-claude/fast-mode\",\"untracked\":false,\"children\":[\"Fast mode\"]}],\" (research preview) now supports Claude Opus 4.7. Set \",[\"$\",\"code\",\"2\",{\"children\":[\"speed: \\\"fast\\\"\"]}],\" with \",[\"$\",\"code\",\"4\",{\"children\":[\"model: \\\"claude-opus-4-7\\\"\"]}],\" and the \",[\"$\",\"code\",\"6\",{\"children\":[\"fast-mode-2026-02-01\"]}],\" beta header for significantly faster output token generation at premium pricing. Pricing, rate limits, and access are the same as for Opus 4.6 fast mode; interested customers should join the \",[\"$\",\"$L97\",\"8\",{\"href\":\"https://claude.com/fast-mode\",\"untracked\":false,\"children\":[\"waitlist\"]}],\".\"]}],\"\\n\"]}]\n122:[\"$\",\"h3\",\"278\",{\"id\":\"may-11-2026\",\"className\":\"group\",\"children\":[[\"May 11, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"may-11-2026\",\"name\":\"May 11, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n123:[\"$\",\"ul\",\"280\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched \",[\"$\",\"strong\",\"1\",{\"children\":[\"Claude Platform on AWS\"]}],\", bringing the Claude API to Anthropic-managed infrastructure accessible through AWS, with AWS billing and IAM authentication. Access the full Messages API, Files API, Message Batches API, Claude Managed Agents, Agent Skills, code execution, and tool use through native AWS endpoints. Learn more in \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/build-with-claude/claude-platform-on-aws\",\"untracked\":false,\"children\":[\"Claude Platform on AWS\"]}],\".\"]}],\"\\n\"]}]\n124:[\"$\",\"h3\",\"282\",{\"id\":\"may-6-2026\",\"className\":\"group\",\"children\":[[\"May 6, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"may-6-2026\",\"name\":\"May 6, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n125:[\"$\",\"ul\",\"284\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/managed-agents/multiagent-orchestration\",\"untracked\":false,\"children\":[\"Multiagent orchestration\"]}],\" and \",[\"$\",\"$L97\",\"2\",{\"href\":\"/docs/en/managed-agents/define-outcomes\",\"untracked\":false,\"children\":[\"Outcomes\"]}],\" are now in beta under the standard \",[\"$\",\"code\",\"4\",{\"children\":[\"managed-agents-2026-04-01\"]}],\" beta header.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Claude Managed Agents vault credential background refresh is now supported for \",[\"$\",\"code\",\"1\",{\"children\":[\"mcp_oauth\"]}],\" credentials. See \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/managed-agents/vaults\",\"untracked\":false,\"children\":[\"Authenticate with vaults\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"Webhooks for Claude Managed Agents are now supported. Webhook event types include session and vault lifecycle events. See \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/managed-agents/webhooks\",\"untracked\":false,\"children\":[\"Subscribe to webhooks\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"Additional filtering and sorting options are now supported for Claude Managed Agents. Sessions can be filtered by status, and events can be filtered by type. Events can now be filtered by creation time.\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/managed-agents/dreams\",\"untracked\":false,\"children\":[\"Dreams\"]}],\" for Claude Managed Agents are now available as a research preview. A dream reads an existing memory store alongside past session transcripts and produces a reorganized output memory store with duplicates merged, stale entries replaced, and new insights surfaced. Dream endpoints are gated by the \",[\"$\",\"code\",\"2\",{\"children\":[\"dreaming-2026-04-21\"]}],\" beta header. \",[\"$\",\"$L97\",\"4\",{\"href\":\"https://claude.com/form/claude-managed-agents\",\"untracked\":false,\"children\":[\"Request access\"]}],\" to try it.\"]}],\"\\n\"]}]\n126:[\"$\",\"h3\",\"286\",{\"id\":\"may-4-2026\",\"className\":\"group\",\"children\":[[\"May 4, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"may-4-2026\",\"name\":\"May 4, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n127:[\"$\",\"ul\",\"288\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/manage-claude/workload-identity-federation\",\"untracked\":false,\"children\":[\"Workload Identity Federation\"]}],\". Authenticate workloads to the Claude API with short-lived OIDC tokens from your own identity provider (AWS IAM, Google Cloud, GitHub Actions, Kubernetes, Microsoft Entra ID, Okta, SPIFFE, and more) instead of long-lived static API keys. Configure issuers and federation rules in the Claude Console, and the SDK handles token exchange and refresh automatically. See \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/manage-claude/authentication\",\"untracked\":false,\"children\":[\"Authentication\"]}],\".\"]}],\"\\n\"]}]\n128:[\"$\",\"h3\",\"290\",{\"id\":\"april-30-2026\",\"className\":\"group\",\"children\":[[\"April 30, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"april-30-2026\",\"name\":\"April 30, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n129:[\"$\",\"ul\",\"292\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve retired the 1M token context window beta (\",[\"$\",\"code\",\"1\",{\"children\":[\"context-1m-2025-08-07\"]}],\") for Claude Sonnet 4.5 and Claude Sonnet 4. The beta header now has no effect on these models, and requests exceeding the standard 200k-token context window return an error. To use the 1M context window, migrate to \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/models/overview#latest-models-comparison\",\"untracked\":false,\"children\":[\"Claude Sonnet 4.6\"]}],\" or \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/models/overview#latest-models-comparison\",\"untracked\":false,\"children\":[\"Claude Opus 4.6\"]}],\", where it’s included at standard pricing with no beta header required.\"]}],\"\\n\"]}]\n12a:[\"$\",\"h3\",\"294\",{\"id\":\"april-29-2026\",\"className\":\"group\",\"children\":[[\"April 29, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"april-29-2026\",\"name\":\"April 29, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n12b:[\"$\",\"ul\",\"296\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve released the \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/agents-and-tools/agent-skills/claude-api-skill\",\"untracked\":false,\"children\":[\"Claude API skill\"]}],\", an open-source \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/agents-and-tools/agent-skills/overview\",\"untracked\":false,\"children\":[\"Agent Skill\"]}],\" that gives Claude up-to-date reference material for building on the Messages API and Claude Managed Agents across eight languages. The skill is bundled with Claude Code and available in the \",[\"$\",\"$L97\",\"5\",{\"href\":\"https://github.com/anthropics/skills/tree/main/skills/claude-api\",\"untracked\":false,\"children\":[\"Anthropic skills repository\"]}],\".\"]}],\"\\n\"]}]\n12c:[\"$\",\"h3\",\"298\",{\"id\":\"april-24-2026\",\"className\":\"group\",\"children\":[[\"April 24, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"april-24-2026\",\"name\":\"April 24, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n12d:[\"$\",\"ul\",\"300\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve released the \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/manage-claude/rate-limits-api\",\"untracked\":false,\"children\":[\"Rate Limits API\"]}],\", allowing administrators to programmatically query the rate limits configured for their organization and workspaces.\"]}],\"\\n\"]}]\n12e:[\"$\",\"h3\",\"302\",{\"id\":\"april-23-2026\",\"className\":\"group\",\"children\":[[\"April 23, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"april-23-2026\",\"name\":\"April 23, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n12f:[\"$\",\"ul\",\"304\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Memory for Claude Managed Agents is now in beta under the standard \",[\"$\",\"code\",\"1\",{\"children\":[\"managed-agents-2026-04-01\"]}],\" header. See \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/managed-agents/memory\",\"untracked\":false,\"children\":[\"Using agent memory\"]}],\" for the full integration guide.\"]}],\"\\n\"]}]\n130:[\"$\",\"h3\",\"306\",{\"id\":\"april-20-2026\",\"className\":\"group\",\"children\":[[\"April 20, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"april-20-2026\",\"name\":\"April 20, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n131:[\"$\",\"ul\",\"308\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve retired the Claude Haiku 3 model (\",[\"$\",\"code\",\"1\",{\"children\":[\"claude-3-haiku-20240307\"]}],\"). All requests to this model will now return an error. We recommend upgrading to \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/models/overview#latest-models-comparison\",\"untracked\":false,\"children\":[\"Claude Haiku 4.5\"]}],\".\"]}],\"\\n\"]}]\n132:[\"$\",\"h3\",\"310\",{\"id\":\"april-16-2026\",\"className\":\"group\",\"children\":[[\"April 16, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"april-16-2026\",\"name\":\"April 16, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n133:[\"$\",\"ul\",\"312\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://www.anthropic.com/news/claude-opus-4-7\",\"untracked\":false,\"children\":[\"Claude Opus 4.7\"]}],\", our most capable model for complex reasoning and agentic coding, at the same $5 / $25 USD per MTok pricing as Opus 4.6. See \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/about-claude/models/whats-new-claude-4-7\",\"untracked\":false,\"children\":[\"What’s new in Claude Opus 4.7\"]}],\" for capability improvements, new features, and the updated tokenizer. Opus 4.7 includes API breaking changes versus Opus 4.6; see the \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/about-claude/models/migration-guide\",\"untracked\":false,\"children\":[\"migration guide\"]}],\" before upgrading.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/build-with-claude/claude-in-amazon-bedrock\",\"untracked\":false,\"children\":[\"Claude in Amazon Bedrock\"]}],\" is now open to all Amazon Bedrock customers. Claude Opus 4.7 and Claude Haiku 4.5 are available self-serve from the Bedrock console through the Messages API endpoint at \",[\"$\",\"code\",\"2\",{\"children\":[\"/anthropic/v1/messages\"]}],\", in 27 AWS regions with global and regional endpoints.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"We’ve launched \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/task-budgets\",\"untracked\":false,\"children\":[\"task budgets\"]}],\" in beta on Claude Opus 4.7. Give Claude an advisory token budget for a full agentic loop (thinking, tool calls, tool results, and output) and the model sees a running countdown, using it to prioritize work and finish gracefully as the budget is consumed. Include the \",[\"$\",\"code\",\"3\",{\"children\":[\"task-budgets-2026-03-13\"]}],\" beta header in your requests.\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"Claude Opus 4.7 supports \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/vision#high-resolution-image-support-on-claude-opus-4-7\",\"untracked\":false,\"children\":[\"high-resolution image input\"]}],\", raising the maximum image resolution from 1,568 to 2,576 pixels on the long edge for improved performance on computer use, screenshot understanding, and document analysis. High-resolution support is automatic and requires no beta header; images might use up to approximately 3x more image tokens than on prior models.\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[\"We’ve added the \",[\"$\",\"code\",\"1\",{\"children\":[\"xhigh\"]}],\" \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/build-with-claude/effort\",\"untracked\":false,\"children\":[\"effort\"]}],\" level on Claude Opus 4.7. \",[\"$\",\"code\",\"5\",{\"children\":[\"xhigh\"]}],\" sits between \",[\"$\",\"code\",\"7\",{\"children\":[\"high\"]}],\" and \",[\"$\",\"code\",\"9\",{\"children\":[\"max\"]}],\" and is tuned for long-running agentic and coding tasks (over 30 minutes) with token budgets in the millions. No beta header is required.\"]}],\"\\n\"]}]\n134:[\"$\",\"h3\",\"314\",{\"id\":\"april-14-2026\",\"className\":\"group\",\"children\":[[\"April 14, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"april-14-2026\",\"name\":\"April 14, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n135:[\"$\",\"ul\",\"316\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We announced the deprecation of the Claude Sonnet 4 model (\",[\"$\",\"code\",\"1\",{\"children\":[\"claude-sonnet-4-20250514\"]}],\") and the Claude Opus 4 model (\",[\"$\",\"code\",\"3\",{\"children\":[\"claude-opus-4-20250514\"]}],\"), with retirement on the Claude API scheduled for June 15, 2026. We recommend migrating to \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/models/overview#latest-models-comparison\",\"untracked\":false,\"children\":[\"Claude Sonnet 4.6\"]}],\" and \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/models/opus-4-8/overview\",\"untracked\":false,\"children\":[\"Claude Opus 4.8\"]}],\" respectively. Read more in \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/about-claude/model-deprecations\",\"untracked\":false,\"children\":[\"Model deprecations\"]}],\".\"]}],\"\\n\"]}]\n136:[\"$\",\"h3\",\"318\",{\"id\":\"april-9-2026\",\"className\":\"group\",\"children\":[[\"April 9, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"april-9-2026\",\"name\":\"April 9, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n137:[\"$\",\"ul\",\"320\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched the \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/advisor-tool\",\"untracked\":false,\"children\":[\"advisor tool\"]}],\" in beta. Pair a faster executor model with a higher-intelligence advisor model that provides strategic guidance mid-generation, so long-horizon agentic workloads get close to advisor-solo quality while the bulk of token generation happens at executor-model rates. Include the beta header \",[\"$\",\"code\",\"3\",{\"children\":[\"advisor-tool-2026-03-01\"]}],\" in your requests.\"]}],\"\\n\"]}]\n138:[\"$\",\"h3\",\"322\",{\"id\":\"april-8-2026\",\"className\":\"group\",\"children\":[[\"April 8, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"april-8-2026\",\"name\":\"April 8, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n139:[\"$\",\"ul\",\"324\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched \",[\"$\",\"strong\",\"1\",{\"children\":[\"Claude Managed Agents\"]}],\" in beta, a fully managed agent harness for running Claude as an autonomous agent with secure sandboxing, built-in tools, and server-sent event streaming. Create agents, configure containers, and run sessions through the API. All endpoints require the \",[\"$\",\"code\",\"3\",{\"children\":[\"managed-agents-2026-04-01\"]}],\" beta header. Learn more in \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/managed-agents/overview\",\"untracked\":false,\"children\":[\"Claude Managed Agents overview\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"We’ve launched the \",[\"$\",\"strong\",\"1\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"ant\"]}],\" CLI\"]}],\", a command-line client for the Claude API that enables faster interaction with the Claude API, native integration with Claude Code, and versioning of API resources in YAML files. Learn more in the \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/cli-sdks-libraries/cli/quickstart\",\"untracked\":false,\"children\":[\"CLI quickstart\"]}],\".\"]}],\"\\n\"]}]\n13a:[\"$\",\"h3\",\"326\",{\"id\":\"april-7-2026\",\"className\":\"group\",\"children\":[[\"April 7, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"april-7-2026\",\"name\":\"April 7, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n13b:[\"$\",\"ul\",\"328\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We announced \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://anthropic.com/glasswing\",\"untracked\":false,\"children\":[\"Claude Mythos Preview\"]}],\" is available as a gated research preview for defensive cybersecurity work as part of \",[\"$\",\"$L97\",\"3\",{\"href\":\"https://anthropic.com/glasswing\",\"untracked\":false,\"children\":[\"Project Glasswing\"]}],\". Access is invitation-only.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/api/messages\",\"untracked\":false,\"children\":[\"Messages API\"]}],\" is now available on Amazon Bedrock as a research preview. The new Claude in Amazon Bedrock endpoint at \",[\"$\",\"code\",\"3\",{\"children\":[\"/anthropic/v1/messages\"]}],\" uses the same request shape as the first-party Claude API and runs on AWS-managed infrastructure with zero operator access. Available in \",[\"$\",\"code\",\"5\",{\"children\":[\"us-east-1\"]}],\"; contact your Anthropic account executive to request access. Learn more in \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/build-with-claude/claude-in-amazon-bedrock\",\"untracked\":false,\"children\":[\"Claude in Amazon Bedrock\"]}],\".\"]}],\"\\n\"]}]\n13c:[\"$\",\"h3\",\"330\",{\"id\":\"march-30-2026\",\"className\":\"group\",\"children\":[[\"March 30, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"march-30-2026\",\"name\":\"March 30, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n13d:[\"$\",\"ul\",\"332\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve raised the \",[\"$\",\"code\",\"1\",{\"children\":[\"max_tokens\"]}],\" cap to \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/build-with-claude/batch-processing#extended-output-beta\",\"untracked\":false,\"children\":[\"300k on the Message Batches API\"]}],\" for Claude Opus 4.6 and Sonnet 4.6. Include the \",[\"$\",\"code\",\"5\",{\"children\":[\"output-300k-2026-03-24\"]}],\" beta header to generate longer single-turn outputs for long-form content, structured data, and large code generation tasks.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"We’re retiring the 1M token context window beta for Claude Sonnet 4.5 and Claude Sonnet 4 on \",[\"$\",\"strong\",\"1\",{\"children\":[\"April 30, 2026\"]}],\". After that date, the \",[\"$\",\"code\",\"3\",{\"children\":[\"context-1m-2025-08-07\"]}],\" beta header will have no effect on these models, and requests that exceed the standard 200k-token context window will return an error. To continue using 1M context windows, migrate to \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/models/overview#latest-models-comparison\",\"untracked\":false,\"children\":[\"Claude Sonnet 4.6\"]}],\" or \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/models/overview#latest-models-comparison\",\"untracked\":false,\"children\":[\"Claude Opus 4.6\"]}],\", which support the full 1M token context window at standard pricing with no beta header required.\"]}],\"\\n\"]}]\n13e:[\"$\",\"h3\",\"334\",{\"id\":\"march-18-2026\",\"className\":\"group\",\"children\":[[\"March 18, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"march-18-2026\",\"name\":\"March 18, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n13f:[\"$\",\"ul\",\"336\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve added model capability fields to the \",\"$L217\",\". \",[\"$\",\"code\",\"3\",{\"children\":[\"GET /v1/models\"]}],\" and \",[\"$\",\"code\",\"5\",{\"children\":[\"GET /v1/models/{model_id}\"]}],\" now return \",[\"$\",\"code\",\"7\",{\"children\":[\"max_input_tokens\"]}],\", \",[\"$\",\"code\",\"9\",{\"children\":[\"max_tokens\"]}],\", and a \",[\"$\",\"code\",\"11\",{\"children\":[\"capabilities\"]}],\" object. Query the API to discover what each model supports.\"]}],\"\\n\"]}]\n140:[\"$\",\"h3\",\"338\",{\"id\":\"march-16-2026\",\"className\":\"group\",\"children\":[[\"March 16, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"march-16-2026\",\"name\":\"March 16, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n141:[\"$\",\"ul\",\"340\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched the \",[\"$\",\"code\",\"1\",{\"children\":[\"display\"]}],\" field for extended thinking, letting you omit thinking content from responses for faster streaming. Set \",[\"$\",\"code\",\"3\",{\"children\":[\"thinking.display: \\\"omitted\\\"\"]}],\" to receive thinking blocks with an empty \",[\"$\",\"code\",\"5\",{\"children\":[\"thinking\"]}],\" field and the \",[\"$\",\"code\",\"7\",{\"children\":[\"signature\"]}],\" preserved for multi-turn continuity. Billing is unchanged. Learn more in \",[\"$\",\"$L97\",\"9\",{\"href\":\"/docs/en/build-with-claude/thinking#controlling-thinking-display\",\"untracked\":false,\"children\":[\"Controlling thinking display\"]}],\".\"]}],\"\\n\"]}]\n142:[\"$\",\"h3\",\"342\",{\"id\":\"march-13-2026\",\"className\":\"group\",\"children\":[[\"March 13, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"march-13-2026\",\"name\":\"March 13, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n143:[\"$\",\"ul\",\"344\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/context-windows\",\"untracked\":false,\"children\":[\"1M token context window\"]}],\" is out of beta for Claude Opus 4.6 and Sonnet 4.6, at standard pricing. Requests over 200k tokens work automatically for these models with no beta header required. The 1M token context window remains in beta for Claude Sonnet 4.5 and Sonnet 4.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"We’ve removed the dedicated 1M rate limits for all supported models. Your standard account limits now apply across every context length.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"We’ve raised the media limit from 100 to 600 images or PDF pages for each request when using the 1M token context window.\"]}],\"\\n\"]}]\n144:[\"$\",\"h3\",\"346\",{\"id\":\"february-19-2026\",\"className\":\"group\",\"children\":[[\"February 19, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"february-19-2026\",\"name\":\"February 19, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n145:[\"$\",\"ul\",\"348\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched \",[\"$\",\"strong\",\"1\",{\"children\":[\"automatic caching\"]}],\" for the Messages API. Add a single \",[\"$\",\"code\",\"3\",{\"children\":[\"cache_control\"]}],\" field to your request body and the system automatically caches the last cacheable block, moving the cache point forward as conversations grow. No manual breakpoint management required. Works alongside existing block-level cache control for fine-grained optimization. Available on the Claude API and Microsoft Foundry (preview). Learn more in \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/build-with-claude/prompt-caching#automatic-caching\",\"untracked\":false,\"children\":[\"Automatic caching\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"We’ve retired the Claude Sonnet 3.7 model (\",[\"$\",\"code\",\"1\",{\"children\":[\"claude-3-7-sonnet-20250219\"]}],\") and the Claude Haiku 3.5 model (\",[\"$\",\"code\",\"3\",{\"children\":[\"claude-3-5-haiku-20241022\"]}],\"). All requests to Claude Sonnet 3.7 will now return an error. Requests to Claude Haiku 3.5 on the Claude API will now return an error; it remains available on Amazon Bedrock and Google Cloud. We recommend upgrading to \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/models/overview#latest-models-comparison\",\"untracked\":false,\"children\":[\"Claude Sonnet 4.6\"]}],\" and \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/models/overview#latest-models-comparison\",\"untracked\":false,\"children\":[\"Claude Haiku 4.5\"]}],\" respectively. Researchers can request ongoing access through the \",[\"$\",\"$L97\",\"9\",{\"href\":\"https://support.claude.com/en/articles/9125743-what-is-the-external-researcher-access-program\",\"untracked\":false,\"children\":[\"External Researcher Access Program\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"We announced the deprecation of the Claude Haiku 3 model (\",[\"$\",\"code\",\"1\",{\"children\":[\"claude-3-haiku-20240307\"]}],\"), with retirement scheduled for April 20, 2026. We recommend migrating to \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/models/overview#latest-models-comparison\",\"untracked\":false,\"children\":[\"Claude Haiku 4.5\"]}],\". Read more in \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/about-claude/model-deprecations\",\"untracked\":false,\"children\":[\"Model deprecations\"]}],\".\"]}],\"\\n\"]}]\n146:[\"$\",\"h3\",\"350\",{\"id\":\"february-17-2026\",\"className\":\"group\",\"children\":[[\"February 17, 2026\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"february-17-2026\",\"name\":\"February 17, 2026\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n147:[\"$\",\"ul\",\"352\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://www.anthropic.com/news/claude-sonnet-4-6\",\"untracked\":false,\"children\":[\"launched Claude Sonnet 4.6\"]}],\", our latest balanced model combining speed and intelligence for everyday tasks. Sonnet 4.6 delivers improved agentic search performance while consuming fewer tokens. Sonnet 4.6 supports \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/build-with-claude/extended-thinking\",\"untracked\":false,\"children\":[\"extended thinking\"]}],\" and a \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/build-with-claude/context-windows\",\"untracked\":false,\"children\":[\"1M token context window\"]}],\" (beta). See \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/models/overview\",\"untracked\":false,\"children\":[\"Models \u0026 Pricing\"]}],\" for details.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"API \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/code-execution-tool\",\"untracked\":false,\"children\":[\"code execution\"]}],\" is now \",[\"$\",\"strong\",\"3\",{\"children\":[\"free when used with web search or web fetch\"]}],\". Sandboxed code execution improves model capability and token efficiency. See the \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/agents-and-tools/tool-use/code-execution-tool#usage-and-pricing\",\"untracked\":false,\"children\":[\"pricing details\"]}],\" for standalone usage.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/web-search-tool\",\"untracked\":false,\"children\":[\"web search tool\"]}],\" and \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/agents-and-tools/tool-use/programmatic-tool-calling\",\"untracked\":false,\"children\":[\"programmatic tool calling\"]}],\" are available with no beta header required. Web search and web fetch now support \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/agents-and-tools/tool-use/web-search-tool#dynamic-filtering\",\"untracked\":false,\"children\":[\"dynamic filtering\"]}],\", which uses code execution to filter results before they reach the context window for better performance and reduced token cost.\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/code-execution-tool\",\"untracked\":false,\"children\":[\"code execution tool\"]}],\", \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/agents-and-tools/tool-use/web-fetch-tool\",\"untracked\":false,\"children\":[\"web fetch tool\"]}],\", \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/agents-and-tools/tool-use/tool-search-tool\",\"untracked\":false,\"children\":[\"tool search tool\"]}],\", \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/agents-and-tools/tool-use/define-tools#providing-tool-use-examples\",\"untracked\":false,\