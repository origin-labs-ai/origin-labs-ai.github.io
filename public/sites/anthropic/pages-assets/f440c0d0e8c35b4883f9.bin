ta-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n17f:[\"$\",\"ul\",\"464\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We announced the deprecation of the Claude Sonnet 3.5 models (\",[\"$\",\"code\",\"1\",{\"children\":[\"claude-3-5-sonnet-20240620\"]}],\" and \",[\"$\",\"code\",\"3\",{\"children\":[\"claude-3-5-sonnet-20241022\"]}],\"). These models will be retired on October 28, 2025. We recommend migrating to Claude Sonnet 4.5 (\",[\"$\",\"code\",\"5\",{\"children\":[\"claude-sonnet-4-5-20250929\"]}],\") for improved performance and capabilities. Read more in \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/about-claude/model-deprecations\",\"untracked\":false,\"children\":[\"Model deprecations\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"The 1-hour cache duration for prompt caching no longer requires a beta header. Learn more in \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/prompt-caching#1-hour-cache-duration\",\"untracked\":false,\"children\":[\"1-hour cache duration\"]}],\".\"]}],\"\\n\"]}]\n180:[\"$\",\"h3\",\"466\",{\"id\":\"august-12-2025\",\"className\":\"group\",\"children\":[[\"August 12, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"august-12-2025\",\"name\":\"August 12, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n181:[\"$\",\"ul\",\"468\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched beta support for a \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/context-windows\",\"untracked\":false,\"children\":[\"1M token context window\"]}],\" in Claude Sonnet 4 on the Claude API and Amazon Bedrock.\"]}],\"\\n\"]}]\n182:[\"$\",\"h3\",\"470\",{\"id\":\"august-11-2025\",\"className\":\"group\",\"children\":[[\"August 11, 2025\"],[\"$\",\"span\",