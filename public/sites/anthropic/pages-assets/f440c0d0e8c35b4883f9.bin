lassName\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"august-5-2025\",\"name\":\"August 5, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n187:[\"$\",\"ul\",\"480\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://www.anthropic.com/news/claude-opus-4-1\",\"untracked\":false,\"children\":[\"Claude Opus 4.1\"]}],\", an incremental update to Claude Opus 4 with enhanced capabilities and performance improvements. Opus 4.1 does not allow both \",[\"$\",\"code\",\"3\",{\"children\":[\"temperature\"]}],\" and \",[\"$\",\"code\",\"5\",{\"children\":[\"top_p\"]}],\" parameters to be specified. Use only one. Learn more in \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/models/overview\",\"untracked\":false,\"children\":[\"Models overview\"]}],\".\"]}],\"\\n\"]}]\n188:[\"$\",\"h3\",\"482\",{\"id\":\"july-28-2025\",\"className\":\"group\",\"children\":[[\"July 28, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"july-28-2025\",\"name\":\"July 28, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n189:[\"$\",\"ul\",\"484\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve released \",[\"$\",\"code\",\"1\",{\"children\":[\"text_editor_20250728\"]}],\", an updated text editor tool that fixes some issues from the previous versions and adds an optional \",[\"$\",\"code\",\"3\",{\"children\":[\"max_characters\"]}],\" parameter that allows you to control the truncation length when viewing large files.\"]}],\"\\n\"]}]\n18a:[\"$\",\"h3\",\"486\",{\"id\":\"july-24-2025\",\"className\":\"group\",\"children\":[[\"July 24, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"july-24-2025\",\"name\":\"July 24, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n18b:[\"$\",\"ul\",\"488\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve increased \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/api/rate-limits\",\"untracked\":false,\"children\":[\"rate limits\"]}],\" for Claude Opus 4 on the Claude API to give you more capacity to build and scale with Claude. For customers with \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/api/rate-limits#rate-limits\",\"untracked\":false,\"children\":[\"usage tier 1–4 rate limits\"]}],\", these changes apply immediately to your account: no action needed.\"]}],\"\\n\"]}]\n18c:[\"$\",\"h3\",\"490\",{\"id\":\"july-21-2025\",\"className\":\"group\",\"children\":[[\"July 21, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"july-21-2025\",\"name\":\"July 21, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n18d:[\"$\",\"ul\",\"492\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve retired the Claude 2.0, Claude 2.1, and Claude Sonnet 3 models. All requests to these models will now return an error. Read more in \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/about-claude/model-deprecations\",\"untracked\":false,\"children\":[\"Model deprecations\"]}],\".\"]}],\"\\n\"]}]\n18e:[\"$\",\"h3\",\"494\",{\"id\":\"july-17-2025\",\"className\":\"group\",\"children\":[[\"July 17, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"july-17-2025\",\"name\":\"July 17, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n18f:[\"$\",\"ul\",\"496\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve increased \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/api/rate-limits\",\"untracked\":false,\"children\":[\"rate limits\"]}],\" for Claude Sonnet 4 on the Claude API to give you more capacity to build and scale with Claude. For customers with \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/api/rate-limits#rate-limits\",\"untracked\":false,\"children\":[\"usage tier 1–4 rate limits\"]}],\", these changes apply immediately to your account: no action needed.\"]}],\"\\n\"]}]\n190:[\"$\",\"h3\",\"498\",{\"id\":\"july-3-2025\",\"className\":\"group\",\"children\":[[\"July 3, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"july-3-2025\",\"name\":\"July 3, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n191:[\"$\",\"ul\",\"500\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched search result content blocks in beta, enabling natural citations for RAG applications. Tools can now return search results with proper source attribution, and Claude will automatically cite these sources in its responses, matching the citation quality of web search. This eliminates the need for document workarounds in custom knowledge base applications. Learn more in \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/search-results\",\"untracked\":false,\"children\":[\"Search results\"]}],\". To enable this feature, use the beta header \",[\"$\",\"code\",\"3\",{\"children\":[\"search-results-2025-06-09\"]}],\".\"]}],\"\\n\"]}]\n192:[\"$\",\"h3\",\"502\",{\"id\":\"june-30-2025\",\"className\":\"group\",\"children\":[[\"June 30, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"june-30-2025\",\"name\":\"June 30, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n193:[\"$\",\"ul\",\"504\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We announced the deprecation of the Claude Opus 3 model. Read more in \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/about-claude/model-deprecations\",\"untracked\":false,\"children\":[\"Model deprecations\"]}],\".\"]}],\"\\n\"]}]\n194:[\"$\",\"h3\",\"506\",{\"id\":\"june-23-2025\",\"className\":\"group\",\"children\":[[\"June 23, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"june-23-2025\",\"name\":\"June 23, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n195:[\"$\",\"ul\",\"508\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"In the Console, users with the Developer role can now access the \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://console.anthropic.com/settings/cost\",\"untracked\":false,\"children\":[\"Cost\"]}],\" page. Previously, the Developer role allowed access to the \",[\"$\",\"$L97\",\"3\",{\"href\":\"https://console.anthropic.com/settings/usage\",\"untracked\":false,\"children\":[\"Usage\"]}],\" page, but not the Cost page.\"]}],\"\\n\"]}]\n196:[\"$\",\"h3\",\"510\",{\"id\":\"june-11-2025\",\"className\":\"group\",\"children\":[[\"June 11, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"june-11-2025\",\"name\":\"June 11, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n197:[\"$\",\"ul\",\"512\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/fine-grained-tool-streaming\",\"untracked\":false,\"children\":[\"fine-grained tool streaming\"]}],\" in beta, a feature that enables Claude to stream tool use parameters without buffering / JSON validation. To enable fine-grained tool streaming, use the \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/api/beta-headers\",\"untracked\":false,\"children\":[\"beta header\"]}],\" \",[\"$\",\"code\",\"5\",{\"children\":[\"fine-grained-tool-streaming-2025-05-14\"]}],\".\"]}],\"\\n\"]}]\n198:[\"$\",\"h3\",\"514\",{\"id\":\"may-22-2025\",\"className\":\"group\",\"children\":[[\"May 22, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"may-22-2025\",\"name\":\"May 22, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n199:[\"$\",\"ul\",\"516\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://www.anthropic.com/news/claude-4\",\"untracked\":false,\"children\":[\"Claude Opus 4 and Claude Sonnet 4\"]}],\", our latest models with extended thinking capabilities. Learn more in \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/models/overview\",\"untracked\":false,\"children\":[\"Models overview\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"The default behavior of \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/extended-thinking\",\"untracked\":false,\"children\":[\"extended thinking\"]}],\" in Claude 4 models returns a summary of Claude’s full thinking process, with the full thinking encrypted and returned in the \",[\"$\",\"code\",\"3\",{\"children\":[\"signature\"]}],\" field of \",[\"$\",\"code\",\"5\",{\"children\":[\"thinking\"]}],\" block output.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"We’ve launched \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/thinking#interleaved-thinking\",\"untracked\":false,\"children\":[\"interleaved thinking\"]}],\" in beta, a feature that enables Claude to think in between tool calls. To enable interleaved thinking, use the \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/api/beta-headers\",\"untracked\":false,\"children\":[\"beta header\"]}],\" \",[\"$\",\"code\",\"5\",{\"children\":[\"interleaved-thinking-2025-05-14\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"We’ve launched the \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/files\",\"untracked\":false,\"children\":[\"Files API\"]}],\" in beta, enabling you to upload files and reference them in the Messages API and code execution tool.\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[\"We’ve launched the \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/code-execution-tool\",\"untracked\":false,\"children\":[\"Code execution tool\"]}],\" in beta, a tool that enables Claude to execute Python code in a secure, sandboxed environment.\"]}],\"\\n\",[\"$\",\"li\",\"11\",{\"children\":[\"We’ve launched the \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/agents-and-tools/mcp-connector\",\"untracked\":false,\"children\":[\"MCP connector\"]}],\" in beta, a feature that allows you to connect to remote MCP servers directly from the Messages API.\"]}],\"\\n\",[\"$\",\"li\",\"13\",{\"children\":[\"To increase answer quality and decrease tool errors, we’ve changed the default value for the \",[\"$\",\"code\",\"1\",{\"children\":[\"top_p\"]}],\" \",[\"$\",\"$L97\",\"3\",{\"href\":\"https://en.wikipedia.org/wiki/Top-p_sampling\",\"untracked\":false,\"children\":[\"nucleus sampling\"]}],\" parameter in the Messages API from 0.999 to 0.99 for all models. To revert this change, set \",[\"$\",\"code\",\"5\",{\"children\":[\"top_p\"]}],\" to 0.999.\\nAdditionally, when extended thinking is enabled, you can now set \",[\"$\",\"code\",\"7\",{\"children\":[\"top_p\"]}],\" to values between 0.95 and 1.\"]}],\"\\n\",[\"$\",\"li\",\"15\",{\"children\":[\"Our \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://github.com/anthropics/anthropic-sdk-go\",\"untracked\":false,\"children\":[\"Go SDK\"]}],\" has moved from beta to its first stable release.\"]}],\"\\n\",[\"$\",\"li\",\"17\",{\"children\":[\"We’ve added minute and hour level granularity to the \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://console.anthropic.com/settings/usage\",\"untracked\":false,\"children\":[\"Usage\"]}],\" page of Console alongside 429 error rates on the Usage page.\"]}],\"\\n\"]}]\n19a:[\"$\",\"h3\",\"518\",{\"id\":\"may-21-2025\",\"className\":\"group\",\"children\":[[\"May 21, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"may-21-2025\",\"name\":\"May 21, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n19b:[\"$\",\"ul\",\"520\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Our \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://github.com/anthropics/anthropic-sdk-ruby\",\"untracked\":false,\"children\":[\"Ruby SDK\"]}],\" has moved from beta to its first stable release.\"]}],\"\\n\"]}]\n19c:[\"$\",\"h3\",\"522\",{\"id\":\"may-7-2025\",\"className\":\"group\",\"children\":[[\"May 7, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"may-7-2025\",\"name\":\"May 7, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n19d:[\"$\",\"ul\",\"524\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched a web search tool in the API, allowing Claude to access up-to-date information from the web. Learn more in \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/web-search-tool\",\"untracked\":false,\"children\":[\"Web search tool\"]}],\".\"]}],\"\\n\"]}]\n19e:[\"$\",\"h3\",\"526\",{\"id\":\"may-1-2025\",\"className\":\"group\",\"children\":[[\"May 1, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"may-1-2025\",\"name\":\"May 1, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n19f:[\"$\",\"ul\",\"528\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Cache control must now be specified directly in the parent \",[\"$\",\"code\",\"1\",{\"children\":[\"content\"]}],\" block of \",[\"$\",\"code\",\"3\",{\"children\":[\"tool_result\"]}],\" and \",[\"$\",\"code\",\"5\",{\"children\":[\"document.source\"]}],\". For backwards compatibility, if cache control is detected on the last block in \",[\"$\",\"code\",\"7\",{\"children\":[\"tool_result.content\"]}],\" or \",[\"$\",\"code\",\"9\",{\"children\":[\"document.source.content\"]}],\", it will be automatically applied to the parent block instead. Cache control on any other blocks within \",[\"$\",\"code\",\"11\",{\"children\":[\"tool_result.content\"]}],\" and \",[\"$\",\"code\",\"13\",{\"children\":[\"document.source.content\"]}],\" will result in a validation error.\"]}],\"\\n\"]}]\n1a0:[\"$\",\"h3\",\"530\",{\"id\":\"april-9th-2025\",\"className\":\"group\",\"children\":[[\"April 9, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"april-9th-2025\",\"name\":\"April 9, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n1a1:[\"$\",\"ul\",\"532\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We launched a beta version of the \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://github.com/anthropics/anthropic-sdk-ruby\",\"untracked\":false,\"children\":[\"Ruby SDK\"]}],\".\"]}],\"\\n\"]}]\n1a2:[\"$\",\"h3\",\"534\",{\"id\":\"march-31st-2025\",\"className\":\"group\",\"children\":[[\"March 31, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"march-31st-2025\",\"name\":\"March 31, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n1a3:[\"$\",\"ul\",\"536\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Our \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://github.com/anthropics/anthropic-sdk-java\",\"untracked\":false,\"children\":[\"Java SDK\"]}],\" has moved from beta to its first stable release.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"We’ve moved our \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://github.com/anthropics/anthropic-sdk-go\",\"untracked\":false,\"children\":[\"Go SDK\"]}],\" from alpha to beta.\"]}],\"\\n\"]}]\n1a4:[\"$\",\"h3\",\"538\",{\"id\":\"february-27th-2025\",\"className\":\"group\",\"children\":[[\"February 27, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"february-27th-2025\",\"name\":\"February 27, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n1a5:[\"$\",\"ul\",\"540\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve added URL source blocks for images and PDFs in the Messages API. You can now reference images and PDFs directly through a URL instead of having to base64-encode them. Learn more in \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/vision\",\"untracked\":false,\"children\":[\"Vision\"]}],\" and \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/build-with-claude/pdf-support\",\"untracked\":false,\"children\":[\"PDF support\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"We’ve added support for a \",[\"$\",\"code\",\"1\",{\"children\":[\"none\"]}],\" option to the \",[\"$\",\"code\",\"3\",{\"children\":[\"tool_choice\"]}],\" parameter in the Messages API that prevents Claude from calling any tools. Additionally, you’re no longer required to provide any \",[\"$\",\"code\",\"5\",{\"children\":[\"tools\"]}],\" when including \",[\"$\",\"code\",\"7\",{\"children\":[\"tool_use\"]}],\" and \",[\"$\",\"code\",\"9\",{\"children\":[\"tool_result\"]}],\" blocks.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"We’ve launched an OpenAI-compatible API endpoint, allowing you to test Claude models by changing just your API key, base URL, and model name in existing OpenAI integrations. This compatibility layer supports core chat completions functionality. Learn more in \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/cli-sdks-libraries/libraries/openai-sdk\",\"untracked\":false,\"children\":[\"OpenAI SDK compatibility\"]}],\".\"]}],\"\\n\"]}]\n1a6:[\"$\",\"h3\",\"542\",{\"id\":\"february-24th-2025\",\"className\":\"group\",\"children\":[[\"February 24, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"february-24th-2025\",\"name\":\"February 24, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n1a7:[\"$\",\"ul\",\"544\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://www.anthropic.com/news/claude-3-7-sonnet\",\"untracked\":false,\"children\":[\"Claude Sonnet 3.7\"]}],\", our most intelligent model yet. Claude Sonnet 3.7 can produce near-instant responses or show its extended thinking step-by-step. One model, two ways to think. Learn more about all Claude models in \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/models/overview\",\"untracked\":false,\"children\":[\"Models overview\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"We’ve added vision support to Claude Haiku 3.5, enabling the model to analyze and understand images.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"We’ve released a token-efficient tool use implementation, improving overall performance when using tools with Claude. Learn more in \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/overview\",\"untracked\":false,\"children\":[\"Tool use with Claude\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"We’ve changed the default temperature in the \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://console.anthropic.com/workbench\",\"untracked\":false,\"children\":[\"Console\"]}],\" for new prompts from 0 to 1 for consistency with the default temperature in the API. Existing saved prompts are unchanged.\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[\"We’ve released updated versions of our tools that decouple the text edit and bash tools from the computer use system prompt:\",\"\\n\",[\"$\",\"ul\",\"2\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"bash_20250124\"]}],\": Same functionality as previous version but is independent from computer use. Does not require a beta header.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"text_editor_20250124\"]}],\": Same functionality as previous version but is independent from computer use. Does not require a beta header.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"computer_20250124\"]}],\": Updated computer use tool with new command options including \",[\"$\",\"code\",\"2\",{\"children\":[\"hold_key\"]}],\", \",[\"$\",\"code\",\"4\",{\"children\":[\"left_mouse_down\"]}],\", \",[\"$\",\"code\",\"6\",{\"children\":[\"left_mouse_up\"]}],\", \",[\"$\",\"code\",\"8\",{\"children\":[\"scroll\"]}],\", \",[\"$\",\"code\",\"10\",{\"children\":[\"triple_click\"]}],\", and \",[\"$\",\"code\",\"12\",{\"children\":[\"wait\"]}],\". This tool requires the \",[\"$\",\"code\",\"14\",{\"children\":[\"computer-use-2025-01-24\"]}],\" anthropic-beta header.\\nLearn more in \",[\"$\",\"$L97\",\"16\",{\"href\":\"/docs/en/agents-and-tools/tool-use/overview\",\"untracked\":false,\"children\":[\"Tool use with Claude\"]}],\".\"]}],\"\\n\"]}],\"\\n\"]}],\"\\n\"]}]\n1a8:[\"$\",\"h3\",\"546\",{\"id\":\"february-10th-2025\",\"className\":\"group\",\"children\":[[\"February 10, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"february-10th-2025\",\"name\":\"February 10, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n1a9:[\"$\",\"ul\",\"548\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve added the \",[\"$\",\"code\",\"1\",{\"children\":[\"anthropic-organization-id\"]}],\" response header to all API responses. This header provides the organization ID associated with the API key used in the request.\"]}],\"\\n\"]}]\n1aa:[\"$\",\"h3\",\"550\",{\"id\":\"january-31st-2025\",\"className\":\"group\",\"children\":[[\"January 31, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"january-31st-2025\",\"name\":\"January 31, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n1ab:[\"$\",\"ul\",\"552\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve moved our \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://github.com/anthropics/anthropic-sdk-java\",\"untracked\":false,\"children\":[\"Java SDK\"]}],\" from alpha to beta.\"]}],\"\\n\"]}]\n1ac:[\"$\",\"h3\",\"554\",{\"id\":\"january-23rd-2025\",\"className\":\"group\",\"children\":[[\"January 23, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"january-23rd-2025\",\"name\":\"January 23, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n1ad:[\"$\",\"ul\",\"556\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve launched citations capability in the API, allowing Claude to provide source attribution for information. Learn more in \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/citations\",\"untracked\":false,\"children\":[\"Citations\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"We’ve added support for plain text documents and custom content documents in the Messages API.\"]}],\"\\n\"]}]\n1ae:[\"$\",\"h3\",\"558\",{\"id\":\"january-21st-2025\",\"className\":\"group\",\"children\":[[\"January 21, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"january-21st-2025\",\"name\":\"January 21, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n1af:[\"$\",\"ul\",\"560\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We announced the deprecation of the Claude 2, Claude 2.1, and Claude Sonnet 3 models. Read more in \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/about-claude/model-deprecations\",\"untracked\":false,\"children\":[\"Model deprecations\"]}],\".\"]}],\"\\n\"]}]\n1b0:[\"$\",\"h3\",\"562\",{\"id\":\"january-15th-2025\",\"className\":\"group\",\"children\":[[\"January 15, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"january-15th-2025\",\"name\":\"January 15, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n1b1:[\"$\",\"ul\",\"564\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve updated \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/prompt-caching\",\"untracked\":false,\"children\":[\"prompt caching\"]}],\" to be easier to use. Now, when you set a cache breakpoint, we’ll automatically read from your longest previously cached prefix.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"You can now prefill Claude’s response when using tools.\"]}],\"\\n\"]}]\n1b2:[\"$\",\"h3\",\"566\",{\"id\":\"january-10th-2025\",\"className\":\"group\",\"children\":[[\"January 10, 2025\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"january-10th-2025\",\"name\":\"January 10, 2025\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n1b3:[\"$\",\"ul\",\"568\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve optimized support for \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/batch-processing#using-prompt-caching-with-message-batches\",\"untracked\":false,\"children\":[\"prompt caching in the Message Batches API\"]}],\" to improve cache hit rate.\"]}],\"\\n\"]}]\n1b4:[\"$\",\"h3\",\"570\",{\"id\":\"december-19th-2024\",\"className\":\"group\",\"children\":[[\"December 19, 2024\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"december-19th-2024\",\"name\":\"December 19, 2024\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n1b5:[\"$\",\"ul\",\"572\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve added support for a \",\"$L21a\",\" in the Message Batches API.\"]}],\"\\n\"]}]\n1b6:[\"$\",\"h3\",\"574\",{\"id\":\"december-17th-2024\",\"className\":\"group\",\"children\":[[\"December 17, 2024\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"december-17th-2024\",\"name\":\"December 17, 2024\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n1b7:[\"$\",\"ul\",\"576\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"The following features are now available in the Claude API without a beta header:\",\"\\n\",[\"$\",\"ul\",\"2\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"$L21b\",\": Query available models, validate model IDs, and resolve \",[\"$\",\"$L97\",\"2\",{\"href\":\"/docs/en/models/overview\",\"untracked\":false,\"children\":[\"model aliases\"]}],\" to their canonical model IDs.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/build-with-claude/batch-processing\",\"untracked\":false,\"children\":[\"Message Batches API\"]}],\": Process large batches of messages asynchronously at 50% of the standard API cost.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/build-with-claude/token-counting\",\"untracked\":false,\"children\":[\"Token counting API\"]}],\": Calculate token counts for Messages before sending them to Claude.\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/build-with-claude/prompt-caching\",\"untracked\":false,\"children\":[\"Prompt Caching\"]}],\": Reduce costs by up to 90% and latency by up to 80% by caching and reusing prompt content.\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"/docs/en/build-with-claude/pdf-support\",\"untracked\":false,\"children\":[\"PDF support\"]}],\": Process PDFs to analyze both text and visual content within documents.\"]}],\"\\n\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"We also released new official SDKs:\",\"\\n\",[\"$\",\"ul\",\"2\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"https://github.com/anthropics/anthropic-sdk-java\",\"untracked\":false,\"children\":[\"Java SDK\"]}],\" (alpha)\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$L97\",\"0\",{\"href\":\"https://github.com/anthropics/anthropic-sdk-go\",\"untracked\":false,\"children\":[\"Go SDK\"]}],\" (alpha)\"]}],\"\\n\"]}],\"\\n\"]}],\"\\n\"]}]\n1b8:[\"$\",\"h3\",\"578\",{\"id\":\"december-4th-2024\",\"className\":\"group\",\"children\":[[\"December 4, 2024\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"december-4th-2024\",\"name\":\"December 4, 2024\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n1b9:[\"$\",\"ul\",\"580\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"We’ve added the ability to group by API key on