__sFf8jW__rails\",\"children\":[false,[\"$\",\"div\",null,{\"className\":\"AsideRails-module-scss-module__sFf8jW__rail AsideRails-module-scss-module__sFf8jW__railRight\",\"data-aside-rail\":\"right\",\"children\":[[\"$\",\"$L7f\",\"520e5e6045d6\",{\"item\":{\"_id\":\"520e5e6045d6\",\"variant\":\"note\",\"label\":null,\"heading\":\"Batch processing\",\"text\":\"For Quora, batch processing provides cost savings while also reducing the complexity of running a large number of queries that don't need to be processed in real time.\",\"logo\":{\"_id\":\"T3rRAhXlRSZcnoSVfBb9QE\",\"_type\":\"logo\",\"name\":\"Quora\",\"logo\":\"https://assets.claude.com/58f3aa5e9b4d9b1d91b6387dedf564108fdad825.svg\",\"logoDark\":\"https://assets.claude.com/57d57b7140fe727e3b2f12e9b14ab65986f49edc.svg\",\"logoSquare\":\"https://assets.claude.com/58f3aa5e9b4d9b1d91b6387dedf564108fdad825.svg\"},\"stats\":[],\"prompt\":null,\"buttonLabel\":null,\"buttonVariant\":\"brand\",\"media\":null,\"cta\":{\"_key\":\"0aac1b202ab9\",\"_type\":\"link\",\"label\":\"Read more\",\"linkType\":\"href\",\"href\":\"/resources/articles/message-batches-api\",\"page\":null,\"openInNewTab\":false,\"variant\":\"tertiary\"},\"href\":null,\"hrefLabel\":null},\"locale\":\"en\",\"icon\":\"$undefined\",\"visual\":\"$undefined\",\"ctaPosition\":\"aside\"}]]}]]}]\n8e:[\"$\",\"div\",null,{\"className\":\"IllustratedBackground-module-scss-module__HNnO0a__content\",\"children\":null}]\n8f:[\"$\",\"div\",null,{\"className\":\"MediaStage-module-scss-module__xi5Kya__layout\",\"children\":[[\"$\",\"div\",null,{\"className\":\"MediaStage-module-scss-module__xi5Kya__cards\",\"data-theme\":\"dark\",\"children\":[[\"$\",\"div\",\"10bdd88d2a12\",{\"className\":\"MediaStage-module-scss-module__xi5Kya__card\",\"children\":[[\"$\",\"p\",null,{\"className\":\"MediaStage-module-scss-module__xi5Kya__cardTitle\",\"children\":\"Build your request\"}],[\"$\",\"p\",null,{\"className\":\"MediaStage-module-scss-module__xi5Kya__cardText\",\"children\":\"Classify all customer support tickets into the most relevant category.\\n\\nHere is the list of categories to choose from:\\n{{CATEGORY_LIST}}\\n\\nHere is the content of the support ticket:\\n{{TICKET_CONTENT}}\"}],false,false]}]]}],[\"$\",\"div\",null,{\"className\":\"MediaStage-module-scss-module__xi5Kya__mediaColumn\",\"children\":[\"$\",\"div\",null,{\"className\":\"DocumentPanel-module-scss-module__MuWjkG__panel theme-da"])</script><script nonce="HV0XM4lwilzOt0YtHEUUBg==">self.__next_f.push([1,"rk MediaStage-module-scss-module__xi5Kya__media\",\"children\":[\"$\",\"div\",null,{\"className\":\"DocumentPanel-module-scss-module__MuWjkG__sheet\",\"children\":[[\"$\",\"p\",\"77206a452f55\",{\"className\":\"DocumentPanel-module-scss-module__MuWjkG__p\",\"children\":[\"You are an AI assistant specialized in classifying customer support tickets. Your task is to analyze the content of a given ticket and assign it to the most appropriate category from a predefined list. You will also provide reasoning for your classification decision.\"]}],[\"$\",\"p\",\"c44b124bef99\",{\"className\":\"DocumentPanel-module-scss-module__MuWjkG__p\",\"children\":[\" \"]}],[\"$\",\"p\",\"83a74d448280\",{\"className\":\"DocumentPanel-module-scss-module__MuWjkG__p\",\"children\":[\"First, let's review the available categories:\"]}],[\"$\",\"p\",\"afcb236e9fe3\",{\"className\":\"DocumentPanel-module-scss-module__MuWjkG__p\",\"children\":[\"\u003ccategory_list\u003e\",[\"$\",\"br\",\"node-1\",{}],\"{{CATEGORY_LIST}}\",[\"$\",\"br\",\"node-3\",{}],\"\u003c/category_list\u003e\"]}],[\"$\",\"p\",\"8c64a6ba7a91\",{\"className\":\"DocumentPanel-module-scss-module__MuWjkG__p\",\"children\":[\" \"]}],[\"$\",\"p\",\"0716f330467b\",{\"className\":\"DocumentPanel-module-scss-module__MuWjkG__p\",\"children\":[\"Now, here is the content of the support ticket you need to classify:\"]}],[\"$\",\"p\",\"4e11c3d48a5d\",{\"className\":\"DocumentPanel-module-scss-module__MuWjkG__p\",\"children\":[\"\u003cticket_content\u003e\",[\"$\",\"br\",\"node-1\",{}],\"{{TICKET_CONTENT}}\",[\"$\",\"br\",\"node-3\",{}],\"\u003c/ticket_content\u003e\"]}],[\"$\",\"p\",\"beacd57f23ae\",{\"className\":\"DocumentPanel-module-scss-module__MuWjkG__p\",\"children\":[\" \"]}],[\"$\",\"p\",\"77e760be5475\",{\"className\":\"DocumentPanel-module-scss-module__MuWjkG__p\",\"children\":[\"Please follow these steps to complete the task:\",[\"$\",\"br\",\"node-1\",{}],\"– Carefully read and analyze the ticket content.\",[\"$\",\"br\",\"node-3\",{}],\"– Consider how the content relates to each of the available categories.\",[\"$\",\"br\",\"node-5\",{}],\"– Choose the most appropriate category for the ticket.\",[\"$\",\"br\",\"node-7\",{}],\"– Provide a detailed explanation of your reasoning process.\"]}],[\"$\",\"p\",\"adcff5efe64e\",{\"className\":\"DocumentPanel-module-scss-module__MuWjkG__p\",\"children\":[\" \"]}],[\"$\",\"p\",\"27c59c55bfac\",{\"className\":\"DocumentPanel-module-scss-module__MuWjkG__p\",\"children\":[\"Use the following structure for your response:\",[\"$\",\"br\",\"node-1\",{}],\"\u003cclassification_analysis\u003e\"]}],[\"$\",\"p\",\"2db8e564763a\",{\"className\":\"DocumentPanel-module-scss-module__MuWjkG__p\",\"children\":[\"In this section, break down your thought process:\",[\"$\",\"br\",\"node-1\",{}],\"– Quote the most relevant parts of the ticket content.\",[\"$\",\"br\",\"node-3\",{}],\"– List each category and note how it relates to the ticket content.\",[\"$\",\"br\",\"node-5\",{}],\"– For each category, provide arguments for and against classifying the ticket into that category.\",[\"$\",\"br\",\"node-7\",{}],\"– Rank the top 3 most likely categories.\",[\"$\",\"br\",\"node-9\",{}],\"\u003c/classification_analysis\u003e\"]}],[\"$\",\"p\",\"fa545cc89aed\",{\"className\":\"DocumentPanel-module-scss-module__MuWjkG__p\",\"children\":[\"\u003cclassification\u003e\",\"$La4\",\"\u003ccategory\u003eYour chosen category goes here\u003c/category\u003e\",\"$La5\",\"\u003creasoning\u003eA concise summary of your reasoning for choosing this category\u003c/reasoning\u003e\",\"$La6\",\"\u003c/classification\u003e\"]}],\"$La7\"]}]}]}]]}]\n91:[\"$\",\"h3\",null,{\"ref\":\"$undefined\",\"className\":\"Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title\",\"children\":\"Manage\"}]\n92:[\"$\",\"div\",null,{\"className\":\"FeatureList-module-scss-module__3G7ECW__itemContent\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-rich-text FeatureList-module-scss-module__3G7ECW__body\",\"style\":\"$undefined\",\"children\":[[\"$\",\"p\",\"99f159c08bad\",{\"className\":\"text-body-3\",\"children\":[\"Control API keys, members, token limits, and security per workspace.\"]}]]}],false,[\"$\",\"$L33\",null,{\"ctas\":null,\"variants\":[\"tertiary\"],\"size\":\"small\",\"className\":\"FeatureList-module-scss-module__3G7ECW__ctas\",\"ctaPosition\":\"featureList\"}]]}]\na8:T4b2,\u003cpath d=\"M13.6229 9.64789C13.8798 9.54672 14.1701 9.6724 14.2714 9.92914L15.2792 12.4878C16.0889 14"])</script><script nonce="HV0XM4lwilzOt0YtHEUUBg==">self.__next_f.push([1,".5432 15.0788 16.8666 13.0233 17.6763C11.0323 18.4603 8.79012 17.5367 7.91585 15.6098L7.83577 15.4204L6.82795 12.8618C6.72674 12.6048 6.85325 12.3145 7.11018 12.2133C7.36701 12.1122 7.65732 12.2379 7.75862 12.4946L8.76645 15.0532C9.37368 16.5947 11.1156 17.3528 12.6571 16.7456C14.1986 16.1384 14.9557 14.3965 14.3485 12.8549L13.3407 10.2963C13.2395 10.0395 13.3661 9.74917 13.6229 9.64789ZM8.90024 7.20842C9.15717 7.10721 9.44747 7.23372 9.54868 7.49065L11.3817 12.143C11.4826 12.3998 11.3563 12.6903 11.0995 12.7915C10.8426 12.8925 10.5523 12.766 10.451 12.5092L8.61898 7.85686C8.5178 7.59999 8.64342 7.30969 8.90024 7.20842ZM7.16975 2.25331C9.17539 1.57852 11.3796 2.58838 12.1639 4.5795L13.1718 7.13811C13.273 7.39504 13.1465 7.68534 12.8895 7.78655C12.6327 7.88749 12.3423 7.76113 12.2411 7.50432L11.2333 4.9