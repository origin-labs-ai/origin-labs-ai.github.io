59687 13.5281 7.28188 13.3125 7.10938Z" /></svg></span><p class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Structured outputs</p></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-3">Ensure Claude&#x27;s responses conform to your JSON schema.</p></div></div></div><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:2"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M10 2.5C14.1421 2.5 17.5 5.85786 17.5 10C17.5 14.1421 14.1421 17.5 10 17.5C5.85786 17.5 2.5 14.1421 2.5 10C2.5 5.85786 5.85786 2.5 10 2.5ZM13.3125 7.10938C13.0969 6.93689 12.7819 6.97188 12.6094 7.1875L8.95801 11.751L7.35352 10.1465L7.27539 10.082C7.08131 9.95388 6.81734 9.97563 6.64648 10.1465C6.47563 10.3173 6.45388 10.5813 6.58203 10.7754L6.64648 10.8535L8.64648 12.8535L8.72852 12.9199C8.81649 12.9768 8.92098 13.0048 9.02734 12.999C9.16935 12.9912 9.30178 12.9236 9.39062 12.8125L13.3906 7.8125C13.5631 7.59687 13.5281 7.28188 13.3125 7.10938Z" /></svg></span><p class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Tool use</p></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-3">Allow Claude to interact with hundreds of external tools and APIs so it can perform a wider range of tasks.</p></div></div></div><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:3"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M10 2.5C14.1421 2.5 17.5 5.85786 17.5 10C17.5 14.1421 14.1421 17.5 10 17.5C5.85786 17.5 2.5 14.1421 2.5 10C2.5 5.85786 5.85786 2.5 10 2.5ZM13.3125 7.10938C13.0969 6.93689 12.7819 6.97188 12.6094 7.1875L8.95801 11.751L7.35352 10.1465L7.27539 10.082C7.08131 9.95388 6.81734 9.97563 6.64648 10.1465C6.47563 10.3173 6.45388 10.5813 6.58203 10.7754L6.64648 10.8535L8.64648 12.8535L8.72852 12.9199C8.81649 12.9768 8.92098 13.0048 9.02734 12.999C9.16935 12.9912 9.30178 12.9236 9.39062 12.8125L13.3906 7.8125C13.5631 7.59687 13.5281 7.28188 13.3125 7.10938Z" /></svg></span><p class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Computer use</p></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-3">Let Claude see and operate a browser or desktop to automate work in applications that have no API.</p></div></div></div><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:4"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M10 2.5C14.1421 2.5 17.5 5.85786 17.5 10C17.5 14.1421 14.1421 17.5 10 17.5C5.85786 17.5 2.5 14.1421 2.5 10C2.5 5.85786 5.85786 2.5 10 2.5ZM13.3125 7.10938C13.0969 6.93689 12.7819 6.97188 12.6094 7.1875L8.95801 11.751L7.35352 10.1465L7.27539 10.082C7.08131 9.95388 6.81734 9.97563 6.64648 10.1465C6.47563 10.3173 6.45388 10.5813 6.58203 10.7754L6.64648 10.8535L8.64648 12.8535L8.72852 12.9199C8.81649 12.9768 8.92098 13.0048 9.02734 12.999C9.16935 12.9912 9.30178 12.9236 9.39062 12.8125L13.3906 7.8125C13.5631 7.59687 13.5281 7.28188 13.3125 7.10938Z" /></svg></span><p class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Citations</p></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-3">Ground responses in source documents.</p></div></div></div><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:5"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M10 2.5C14.1421 2.5 17.5 5.85786 17.5 10C17.5 14.1421 14.1421 17.5 10 17.5C5.85786 17.5 2.5 14.1421 2.5 10C2.5 5.85786 5.85786 2.5 10 2.5ZM13.3125 7.10938C13.0969 6.93689 12.7819 6.97188 12.6094 7.1875L8.95801 11.751L7.35352 10.1465L7.27539 10.082C7.08131 9.95388 6.81734 9.97563 6.64648 10.1465C6.47563 10.3173 6.45388 10.5813 6.58203 10.7754L6.64648 10.8535L8.64648 12.8535L8.72852 12.9199C8.81649 12.9768 8.92098 13.0048 9.02734 12.999C9.16935 12.9912 9.30178 12.9236 9.39062 12.8125L13.3906 7.8125C13.5631 7.59687 13.5281 7.28188 13.3125 7.10938Z" /></svg></span><p class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Files</p></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-3">Upload and reference documents across conversations.</p></div></div></div><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:6"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M10 2.5C14.1421 2.5 17.5 5.85786 17.5 10C17.5 14.1421 14.1421 17.5 10 17.5C5.85786 17.5 2.5 14.1421 2.5 10C2.5 5.85786 5.85786 2.5 10 2.5ZM13.3125 7.10938C13.0969 6.93689 12.7819 6.97188 12.6094 7.1875L8.95801 11.751L7.35352 10.1465L7.27539 10.082C7.08131 9.95388 6.81734 9.97563 6.64648 10.1465C6.47563 10.3173 6.45388 10.5813 6.58203 10.7754L6.64648 10.8535L8.64648 12.8535L8.72852 12.9199C8.81649 12.9768 8.92098 13.0048 9.02734 12.999C9.16935 12.9912 9.30178 12.9236 9.39062 12.8125L13.3906 7.8125C13.5631 7.59687 13.5281 7.28188 13.3125 7.10938Z" /></svg></span><p class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Context window</p></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-3">Run more comprehensive and data-intensive use cases with up to 1 million tokens of context.</p></div></div></div><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:7"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M10 2.5C14.1421 2.5 17.5 5.85786 17.5 10C17.5 14.1421 14.1421 17.5 10 17.5C5.85786 17.5 2.5 14.1421 2.5 10C2.5 5.85786 5.85786 2.5 10 2.5ZM13.3125 7.10938C13.0969 6.93689 12.7819 6.97188 12.6094 7.1875L8.95801 11.751L7.35352 10.1465L7.27539 10.082C7.08131 9.95388 6.81734 9.97563 6.64648 10.1465C6.47563 10.3173 6.45388 10.5813 6.58203 10.7754L6.64648 10.8535L8.64648 12.8535L8.72852 12.9199C8.81649 12.9768 8.92098 13.0048 9.02734 12.999C9.16935 12.9912 9.30178 12.9236 9.39062 12.8125L13.3906 7.8125C13.5631 7.59687 13.5281 7.28188 13.3125 7.10938Z" /></svg></span><p class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Compaction</p></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-3">Automatically summarize older context when approaching token limits.</p></div></div></div><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:8"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M10 2.5C14.1421 2.5 17.5 5.85786 17.5 10C17.5 14.1421 14.1421 17.5 10 17.5C5.85786 17.5 2.5 14.1421 2.5 10C2.5 5.85786 5.85786 2.5 10 2.5ZM13.3125 7.10938C13.0969 6.93689 12.7819 6.97188 12.6094 7.1875L8.95801 11.751L7.35352 10.1465L7.27539 10.082C7.08131 9.95388 6.81734 9.97563 6.64648 10.1465C6.47563 10.3173 6.45388 10.5813 6.58203 10.7754L6.64648 10.8535L8.64648 12.8535L8.72852 12.9199C8.81649 12.9768 8.92098 13.0048 9.02734 12.999C9.16935 12.9912 9.30178 12.9236 9.39062 12.8125L13.3906 7.8125C13.5631 7.59687 13.5281 7.28188 13.3125 7.10938Z" /></svg></span><p class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Context editing</p></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-3">Automatically clear tool calls and results.</p></div></div></div><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:9"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M10 2.5C14.1421 2.5 17.5 5.85786 17.5 10C17.5 14.1421 14.1421 17.5 10 17.5C5.85786 17.5 2.5 14.1421 2.5 10C2.5 5.85786 5.85786 2.5 10 2.5ZM13.3125 7.10938C13.0969 6.93689 12.7819 6.97188 12.6094 7.1875L8.95801 11.751L7.35352 10.1465L7.27539 10.082C7.08131 9.95388 6.81734 9.97563 6.64648 10.1465C6.47563 10.3173 6.45388 10.5813 6.58203 10.7754L6.64648 10.8535L8.64648 12.8535L8.72852 12.9199C8.81649 12.9768 8.92098 13.0048 9.02734 12.999C9.16935 12.9912 9.30178 12.9236 9.39062 12.8125L13.3906 7.8125C13.5631 7.59687 13.5281 7.28188 13.3125 7.10938Z" /></svg></span><p class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Web search and fetch</p></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-3">Bring current data from the web into Claude.</p></div></div></div></div></div><aside class="AsideRails-module-scss-module__sFf8jW__rails" aria-label="Side notes"><div class="AsideRails-module-scss-module__sFf8jW__rail AsideRails-module-scss-module__sFf8jW__railRight" data-aside-rail="right"><article class="MarginaliaCard-module-scss-module__b9VA3W__card MarginaliaCard-module-scss-module__b9VA3W__sideCard" data-marginalia-card="stat" data-theme="accent"><div class="MarginaliaCard-module-scss-module__b9VA3W__header MarginaliaCard-module-scss-module__b9VA3W__headerBorder"><p class="MarginaliaCard-module-scss-module__b9VA3W__heading text-caption">Customer story</p></div><div class="MarginaliaCard-module-scss-module__b9VA3W__content"><div class="MarginaliaCard-module-scss-module__b9VA3W__stat"><div class="MarginaliaCard-module-scss-module__b9VA3W__logoRow"><picture class="MarginaliaCard-module-scss-module__b9VA3W__logo"><source srcSet="https://assets.claude.com/4870b3d6c0253cea01b100c98ad2030b8e4f8ce1.svg" media="(prefers-color-scheme: dark)"/><img src="https://assets.claude.com/4870b3d6c0253cea01b100c98ad2030b8e4f8ce1.svg" alt="Atlassian" class="Logo-module-scss-module__j-nrIq__logo" loading="lazy" referrerPolicy="strict-origin-when-cross-origin"/></picture></div><p class="MarginaliaCard-module-scss-module__b9VA3W__statFigure text-headline-3-serif">5 million</p><p class="MarginaliaCard-module-scss-module__b9VA3W__text text-caption">AI agents running in customer business workflows each month</p></div><div class="MarginaliaCard-module-scss-module__b9VA3W__stat MarginaliaCard-module-scss-module__b9VA3W__statDivider"><div class="MarginaliaCard-module-scss-module__b9VA3W__logoRow"><picture class="MarginaliaCard-module-scss-module__b9VA3W__logo"><source srcSet="https://assets.claude.com/900b3e85000444dd43be53f70d6d90a38bac7e76.svg" media="(prefers-color-scheme: dark)"/><img src="https://assets.claude.com/5f87469e4a2c00123682d8b35785892ff55bd4f4.svg" alt="Vibecode" class="Logo-module-scss-module__j-nrIq__logo" loading="lazy" referrerPolicy="strict-origin-when-cross-origin"/></picture></div><p class="MarginaliaCard-module-scss-module__b9VA3W__statFigure text-headline-3-serif">10x</p><p class="MarginaliaCard-module-scss-module__b9VA3W__text text-caption">faster to build production agents</p></div></div></article></div></aside></div></div></div></div></section><section id="featureMediaSpotlight" data-section="featureMediaSpotlight" data-cta-section="featureMediaSpotlight" class="SectionWrapper-module-scss-module__NFbz_a__wrapper theme-accent SectionWrapper-module-scss-module__NFbz_a__spacingBottomNone"><div class="SectionWrapper-module-scss-module__NFbz_a__borderTop"></div><div class="container"><div class="grid-12 FeatureMediaSpotlight-module-scss-module__hBsS0a__featureMediaSpotlight FeatureMediaSpotlight-module-scss-module__hBsS0a__sizeFull"><div class="IntroBlock-module-scss-module__0mSC7a__introBlock IntroBlock-module-scss-module__0mSC7a__spacingBelowLarge FeatureMediaSpotlight-module-scss-module__hBsS0a__intro" style="--intro-headline-width:30ch;--intro-text-width:50ch"><div class="Illustration-module-scss-module__pBGuRG__base Illustration-module-scss-module__pBGuRG__pictogram Illustration-module-scss-module__pBGuRG__size-large IntroBlock-module-scss-module__0mSC7a__pictogram" role="img" aria-label="A waving flag on a pole, rendered in beige and dark gray, showing fabric ripples and a vertical flagpole."></div><span class="Badge-module-scss-module__YOINHa__badge Badge-module-scss-module__YOINHa__large text-caption IntroBlock-module-scss-module__0mSC7a__badge">BETA</span><h2 class="Heading-module-scss-module__AyGdUq__heading text-headline-1-serif Heading-module-scss-module__AyGdUq__balance AnimatedHeading-module-scss-module__KoWePa__heading IntroBlock-module-scss-module__0mSC7a__headline IntroBlock-module-scss-module__0mSC7a__headlineBalance" style="--word-stagger:0.025s" aria-label="Power your most ambitious workloads with Claude Managed Agents"><span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:0" aria-hidden="true">Power</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:1" aria-hidden="true">your</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:2" aria-hidden="true">most</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:3" aria-hidden="true">ambitious</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:4" aria-hidden="true">workloads</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:5" aria-hidden="true">with</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:6" aria-hidden="true">Claude</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:7" aria-hidden="true">Managed</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:8" aria-hidden="true">Agents</span></h2><div class="AnimatedReveal-module-scss-module__8zH9eW__container IntroBlock-module-scss-module__0mSC7a__subheadlineAndCtas" style="--reveal-y:10px;--reveal-duration:0.75s;--reveal-delay:0s;--reveal-stagger:0.1s"><p class="IntroBlock-module-scss-module__0mSC7a__subheadline text-body-large-2" style="--reveal-index:0">Build and deploy long-running agents at scale.</p><div role="group" class="ButtonGroup-module-scss-module__HSKYlq__buttonGroup IntroBlock-module-scss-module__0mSC7a__ctas"><a href="https://platform.claude.com/docs/en/managed-agents/overview" class="Button-module-scss-module__1SItCG__button Button-module-scss-module__1SItCG__variant-primary Button-module-scss-module__1SItCG__size-main text-body-2" target="_blank" rel="noopener noreferrer">Learn more<span class="sr-only" lang="en" data-export-skip=""> (opens in new tab)</span></a><a href="#panel" class="Button-module-scss-module__1SItCG__button Button-module-scss-module__1SItCG__variant-secondary Button-module-scss-module__1SItCG__size-main Button-module-scss-module__1SItCG__hasTrailingIcon text-body-2">See features<span class="Button-module-scss-module__1SItCG__icon"><svg width="20" heigh