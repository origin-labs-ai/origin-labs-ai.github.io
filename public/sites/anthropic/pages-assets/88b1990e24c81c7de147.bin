5947 11.1156 17.3528 12.6571 16.7456C14.1986 16.1384 14.9557 14.3965 14.3485 12.8549L13.3407 10.2963C13.2395 10.0395 13.3661 9.74917 13.6229 9.64789ZM8.90024 7.20842C9.15717 7.10721 9.44747 7.23372 9.54868 7.49065L11.3817 12.143C11.4826 12.3998 11.3563 12.6903 11.0995 12.7915C10.8426 12.8925 10.5523 12.766 10.451 12.5092L8.61898 7.85686C8.5178 7.59999 8.64342 7.30969 8.90024 7.20842ZM7.16975 2.25331C9.17539 1.57852 11.3796 2.58838 12.1639 4.5795L13.1718 7.13811C13.273 7.39504 13.1465 7.68534 12.8895 7.78655C12.6327 7.88749 12.3423 7.76113 12.2411 7.50432L11.2333 4.94571C10.6259 3.40439 8.88406 2.6471 7.3426 3.25429C5.80118 3.86161 5.04399 5.60345 5.65118 7.14494L6.659 9.70355C6.76021 9.96048 6.6337 10.2508 6.37677 10.352C6.11988 10.4531 5.82952 10.3266 5.72833 10.0698L4.7205 7.51116C3.91111 5.45581 4.92107 3.13323 6.97639 2.32362L7.16975 2.25331Z\" /\u003e9b:[\"$\",\"div\",\"2d11dfb8b1e8\",{\"className\":\"ResourceList-module-scss-module__RXHz9G__item\",\"children\":[\"$\",\"$L93\",null,{\"title\":\"Effective harnesses for long-running agents\",\"link\":{\"_type\":\"link\",\"href\":\"https://www.anthropic.com/engineering/effective-harnesses-for-long-running-agents\",\"label\":\"Blog\",\"linkType\":\"href\",\"openInNewTab\":true,\"page\":null},\"titleAs\":\"p\",\"icon\":[\"$\",\"svg\",null,{\"width\":20,\"height\":20,\"viewBox\":\"0 0 20 20\",\"fill\":\"currentColor\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"className\":\"$undefined\",\"aria-hidden\":\"true\",\"dangerouslySetInnerHTML\":{\"__html\":\"$ad\"}}],\"meta\":\"$undefined\",\"appearance\":\"card\",\"titleClassName\":\"$undefined\",\"visual\":\"$undefined\",\"visualColor\":\"$undefined\",\"className\":\"ResourceList-module-scss-module__RXHz9G__gridCard\"}]}]\n9d:[\"$\",\"$L35\",null,{\"as\":\"h3\",\"size\":\"h1\",\"font\":\"serif\",\"trigger\":\"scroll\",\"className\":\"IntroBlock-module-scss-module__0mSC7a__headline IntroBlock-module-scss-module__0mSC7a__headlineBalance\",\"children\":\"See why businesses build on the Claude Platform\"}]\n9e:[\"$\",\"$Lae\",null,{\"items\":[{\"_key\":\"482107b31a77\",\"_type\":\"testimonialQuote\",\"quote\":\"Developers want agents that can take on real software work and finish it. In our testing across GitHub Copilot CLI and VS Code, Claude Opus 5.5 used among the fewest tokens and steps we measured. In VS Code, it solved more terminal tasks tha"])</script><script nonce="HV0XM4lwilzOt0YtHEUUBg==">self.__next_f.push([1,"n Opus 5 in less than half the steps. More than making individual tasks more efficient, it’s making developers’ bigger projects more achievable.\",\"authorName\":\"Mario Rodriguez\",\"authorTitle\":\"Chief Product Officer\",\"authorCompany\":null,\"stat\":null,\"headingLevel\":null,\"description\":null,\"descriptionRich\":null,\"logo\":{\"_id\":\"T3rRAhXlRSZcnoSVfBa2DA\",\"name\":\"GitHub\",\"logo\":\"https://assets.claude.com/ff6655b95f24d2aa0b9bf52c94ef5d5f5e54a70e.svg\",\"logoDark\":\"https://assets.claude.com/e358d7627ad92bfb7462706bb3756549b1d5b892.svg\",\"width\":126,\"height\":36},\"ctas\":null},{\"_key\":\"38ccfcd38e73\",\"_type\":\"testimonialQuote\",\"quote\":\"For Lovable builders, Opus 5.5 means faster builds with the same quality, whether you’re starting from scratch or working on a live app. It gathers context once, makes fewer and more complete edits, and doesn’t get stuck retrying, finishing in a third to half fewer steps and using significantly fewer tokens along the way.\",\"authorName\":\"Fabian Hedin\",\"authorTitle\":\"CTO \u0026 Co-founder\",\"authorCompany\":null,\"stat\":null,\"headingLevel\":null,\"description\":null,\"descriptionRich\":null,\"logo\":{\"_id\":\"kRTXcRwi8Xs0fWgxfvNPZO\",\"name\":\"Lovable\",\"logo\":\"https://assets.claude.com/3700bd9ac51b52bffdb805ac6aa6ea9f45cb4c78.svg\",\"logoDark\":\"https://assets.claude.com/e56be54944deba223d0024c6c6d9a9cae316449d.svg\",\"width\":911,\"height\":155},\"ctas\":null},{\"_key\":\"60d84658d40f\",\"_type\":\"testimonialQuote\",\"quote\":\"With Claude Opus 5.5, we’ve seen a clear improvement in token efficiency across our internal evaluations, as we’ve been able to complete the same tasks both cheaper and faster.\",\"authorName\":\"Aleksandar Mitic\",\"authorTitle\":\"Senior Engineer\",\"authorCompany\":null,\"stat\":null,\"headingLevel\":null,\"description\":null,\"descriptionRich\":null,\"logo\":{\"_id\":\"XNQh23oop7n7SfU9ANspmd\",\"name\":\"Spotify\",\"logo\":\"https://assets.claude.com/ca907a6ebfed4932cb7766ca322936b3c65b2a94.svg\",\"logoDark\":\"https://assets.claude.com/95ea6651445ed111cb4017cf63dec40c671edc65.svg\",\"width\":132,\"height\":37},\"ctas\":null},{\"_key\":\"b88be23e6e20\",\"_type\":\"testimonialQuote\",\"quote\":\"Financial firms need outputs that are consistently correct. At its lowest effort setting, Claude Opus 5.5 beat Opus 5 at high effort on our BigFinance Bench with about 60% fewer output tokens. Its answers are shorter and better structured, and its slides come out denser, more in line with industry standards.\",\"authorName\":\"Strib Walker\",\"authorTitle\":\"Head of Product\",\"authorCompany\":null,\"stat\":null,\"headingLevel\":null,\"description\":null,\"descriptionRich\":null,\"logo\":{\"_id\":\"wf.699dfad2e7de61a539cabeab\",\"name\":\"Rogo\",\"logo\":\"https://assets.claude.com/c0fcb1875e1dc462ab8875733bd22e98359457d6.svg\",\"logoDark\":\"https://assets.claude.com/4b8ea0ccb7cb956c1776a13e618b01facee923e9.svg\",\"width\":88,\"height\":35},\"ctas\":null},{\"_key\":\"bb86188a3db8\",\"_type\":\"testimonialQuote\",\"quote\":\"Claude Opus 5.5 is the first model we’d default to at medium effort. In our testing it matched Opus 5 on high effort, while using 20 to 25% fewer output tokens. On long, messy investigations it always came back with a clear, actionable answer. This means our customers get more done for less.\",\"authorName\":\"Zimu Li\",\"authorTitle\":\"Member of Technical Staff\",\"authorCompany\":null,\"stat\":null,\"headingLevel\":null,\"description\":null,\"descriptionRich\":null,\"logo\":{\"_id\":\"T3rRAhXlRSZcnoSVfBZqzA\",\"name\":\"Factory\",\"logo\":\"https://assets.claude.com/87ed06e3a5284cc3cc54b2e40051da1d15a205af.svg\",\"logoDark\":\"https://assets.claude.com/435d883ac5329b3d90afd2b980d7ae017c8f2de5.svg\",\"width\":164,\"height\":24},\"ctas\":null},{\"_key\":\"1df48b72fca3\",\"_type\":\"testimonialQuote\",\"quote\":\"Our customers use Box AI on enormous amounts of content, so speed and cost are a top priority. In our evaluations, Claude Opus 5.5 used a third of the tokens Opus 5 did, and its answers were 40% less verbose without losing accuracy. We expect that to matter a lot for teams running agents across their content in areas like financial services and the public sector.\",\"authorName\":\"Yashodha Bhavnani\",\"authorTitle\":\"VP of AI Products\",\"authorCompany"])</script><script nonce="HV0XM4lwilzOt0YtHEUUBg==">self.__next_f.push([1,"\":null,\"stat\":null,\"headingLevel\":null,\"description\":null,\"descriptionRich\":null,\"logo\":{\"_id\":\"XNQh23oop7n7SfU9ANu6uZ\",\"name\":\"Box\",\"logo\":\"https://assets.claude.com/f7051ef3388f6fcd83051cffcba21499a021e446.svg\",\"logoDark\":\"https://assets.claude.com/d1817fafe7d93855180ffee0d62fe379cbd49ae5.svg\",\"width\":60,\"height\":32},\"ctas\":null},{\"_key\":\"66147fca7c02\",\"_type\":\"testimonialQuote\",\"quote\":\"In Epic’s early testing, Claude Sonnet 5.5 cleared the same quality bar you’d expect from a higher-tier model, holding up on a system design audit and a data-flow review. The new model managed tens of thousands of lines of code for gameplay system architecture, kept responses snappy, handled multi-hour tasks, and delivered with less prescriptive prompting.\",\"authorName\":\"Daniel Vogel\",\"authorTitle\":\"Chief Operating Officer\",\"authorCompany\":null,\"stat\":null,\"headingLevel\":null,\"description\":null,\"descriptionRich\":null,\"logo\":{\"_id\":\"wf.69a7b7f2a7ecf0634929c10d\",\"name\":\"Epic\",\"logo\":\"https://assets.claude.com/eba99cadd0dd874d08d32b4f4c0cfbea1596372e.png\",\"logoDark\":\"https://assets.claude.com/5a4eafcc1ce27149a32e6428cdb3b0a29f1ba6f8.png\",\"width\":500,\"height\":281},\"ctas\":null},{\"_key\":\"1b60bb40697b\",\"_type\":\"testimonialQuote\",\"quote\":\"Without changing any of our prompts, Claude Sonnet 5.5 did better than Sonnet 5 on almost all of our offline Slackbot evals, in fewer steps and with about 14% fewer output tokens. When someone gives Slackbot a task, quality and speed are what matter most, and Sonnet 5.5 allows Slackbot to deliver better outcomes for users, faster.\",\"authorName\":\"Curtis Allen\",\"authorTitle\":\"Principal Engineer\",\"authorCompany\":null,\"stat\":null,\"headingLevel\":null,\"description\":null,\"descriptionRich\":null,\"logo\":{\"_id\":\"kRTXcRwi8Xs0fWgxfvNfLv\",\"name\":\"Slack\",\"logo\":\"https://assets.claude.com/d28a34b6acf04e16d9b8806ee16d3ca66f00b389.svg\",\"logoDark\":\"https://assets.claude.com/1debe98268e5104c307fa33102e02ab3f21fa8ec.svg\",\"width\":112,\"height\":40},\"ctas\":null},{\"_key\":\"0c46899c70f3\",\"_type\":\"testimonialQuote\",\"quote\":\"We fed Claude Sonnet 5.5 hundreds of real support use cases across replies and escalation requests. It made fewer wrong decisions and resolved tickets faster than the Claude models we use in production today. Tickets were processed 20% faster, getting our customers the help they need without the wait.\",\"authorName\":\"Abhinay Kathuria\",\"authorTitle\":\"Director of AI\",\"authorCompany\":null,\"stat\":null,\"headingLevel\":null,\"description\":null,\"descriptionRich\":null,\"logo\":{\"_id\":\"wf.6a3aad0c176813d48213fe11\",\"name\":\"Zendesk\",\"logo\":\"https://assets.claude.com/eb4ae3eeaffc7fb16618696c1baa3ef6c6224977.svg\",\"logoDark\":\"https://assets.claude.com/493b657f1979856499598410a20713669de7b792.svg\",\"width\":135,\"height\":29},\"ctas\":null},{\"_key\":\"f1e88520549c\",\"_type\":\"testimonialQuote\",\"quote\":\"Claude Fable 5.1 is a leading model for our incident investigation evals, which use real production incidents to assess how effectively our agent, Bits Investigation, can produce root cause analyses. We evaluate our agent's output against root causes identified by our engineers. In these evaluations, it has demonstrated stronger reasoning than Opus 5 and has successfully diagnosed the most complex production incidents we've tested.\",\"authorName\":\"Daniel Shan\",\"authorTitle\":\"Staff Engineer\",\"authorCompany\":null,\"stat\":null,\"headingLevel\":null,\"description\":null,\"descriptionRich\":null,\"logo\":{\"_id\":\"kRTXcRwi8Xs0fWgxfvMUhQ\",\"name\":\"Datadog\",\"logo\":\"https://assets.claude.com/0a17621af2bfc623c9104a3dd9fba2e6ebfc89d5.svg\",\"logoDark\":\"https://assets.claude.com/a63cdd5c782a6b8d4d5fa4628c99fc7428be02dd.svg\",\"width\":146,\"height\":36},\"ctas\":null},{\"_key\":\"b90535bff437\",\"_type\":\"testimonialQuote\",\"quote\":\"We're moving our Opus 5 traffic in Devin to Claude Fable 5.1 on launch day. It matched or edged out Fable 5 in our testing at a lower cost per task, and with the new cache read pricing a Fable-class model is finally economical for the workloads we'd kept on Opus, starting with code review.\",\"authorName\":\"Walden Yan\",\"authorTitle\":\"Co-founder and CPO\",\"auth"])</script><script nonce="HV0XM4lwilzOt0YtHEUUBg==">self.__next_f.push([1,"orCompany\":null,\"stat\":null,\"headingLevel\":null,\"description\":null,\"descriptionRich\":null,\"logo\":{\"_id\":\"T3rRAhXlRSZcnoSVfBZVDG\",\"name\":\"Cognition\",\"logo\":\"https://assets.claude.com/668e21fde8e649dceecf16e585196cbf01f4f916.svg\",\"logoDark\":\"https://assets.claude.com/ffee2dd5c54c6b3ee67ec25b924f4bc4a2d407f1.svg\",\"width\":143,\"height\":29},\"ctas\":null},{\"_key\":\"9f60170a75aa\",\"_type\":\"testimonialQuote\",\"quote\":\"We asked Claude Fable 5.1 to review a clinical research project for Rakuten Medical that three other frontier models had signed off on. It found a gap none of them had seen and insisted on testing it further. It then proposed a completely new hypothesis, turning a dataset we had written off into a new research direction in one afternoon. It's the first time a frontier model like Claude has empowered us to explore new research in this way.\",\"authorName\":\"Felix Giovanni Virgo\",\"authorTitle\":\"Principal AI Engineer\",\"authorCompany\":null,\"stat\":null,\"headingLevel\":null,\"description\":null,\"descriptionRich\":null,\"logo\":{\"_id\":\"T3rRAhXlRSZcnoSVfBbApE\",\"name\":\"Rakuten\",\"logo\":\"https://assets.claude.com/5463fa5a44d12868ceec5ae30bfc8c412cafdeae.svg\",\"logoDark\":\"https://assets.claude.com/3410c2b6d923fd37f3110f8f678929cb45270ab9.svg\",\"width\":106,\"height\":32},\"ctas\":null},{\"_key\":\"f37378a9d78c\",\"_type\":\"testimonialQuote\",\"quote\":\"The standout in Claude Fable 5.1 is the writing: more understandable, more meaningful, and it follows our writing guidance better. In blind tests against Fable 5, I preferred its writing and output. And in Canva Code it built a rhythm game with real music and on-beat gameplay matched to the level it generated, something no other model we tested delivered.\",\"authorName\":\"Danny Wu\",\"authorTitle\":\"Head of AI\",\"authorCompany\":null,\"stat\":null,\"headingLevel\":null,\"description\":null,\"descriptionRich\":null,\"logo\":{\"_id\":\"T3rRAhXlRSZcnoSVfBZBO2\",\"name\":\"Canva\",\"logo\":\"https://assets.claude.com/f047885ca3dadf9a16509752ef150ebb9bd424bb.svg\",\"logoDark\":\"https://assets.claude.com/afa4afea55aef2885485e793e2b02de9ea4b61c3.svg\",\"width\":96,\"height\":31},\"ctas\":null},{\"_key\":\"0cfc00292f00\",\"_type\":\"testimonialQuote\",\"quote\":\"On our research suite, Claude Fable 5.1 set new best scores. On one task it came up with a novel solution along a completely different axis than we'd seen from other models or from human researchers in the past, which took its results well above the previous plateau. It's better at creative problem solving and getting that flash of insight you need to solve a difficult problem.\",\"authorName\":\"Marquis Wong\",\"authorTitle\":\"Principal AI Engineer\",\"authorCompany\":null,\"stat\":null,\"headingLevel\":null,\"description\":null,\"descriptionRich\":null,\"logo\":{\"_id\":\"wf.6a277b0361612d6575e00047\",\"name\":\"IMC Market\",\"logo\":\"https://assets.claude.com/bcc20a819c5837a42089961d8b53d25ef80883d3.svg\",\"logoDark\":\"https://assets.claude.com/2ed4d89abf48d209b830cb003076d89c7493f593.svg\",\"width\":154,\"height\":28},\"ctas\":null},{\"_key\":\"dcf31ad62912\",\"_type\":\"testimonialQuote\",\"quote\":\"The decision to choose Claude was entirely data-driven. We tested multiple model providers side by side, and Claude consistently delivered the best results for case resolution rates and customer satisfaction scores.\",\"authorName\":\"Timothy Addison\",\"authorTitle\":\"Engineering Org Chief of Staff\",\"authorCompany\":null,\"stat\":null,\"headingLevel\":null,\"description\":null,\"descriptionRich\":null,\"logo\":{\"_id\":\"kRTXcRwi8Xs0fWgxfvNjfA\",\"name\":\"StubHub\",\"logo\":\"https://assets.claude.com/d3451a4bfe1c5af7f56f76ab8237c3bab7dd7a9d.svg\",\"logoDark\":\"https://assets.claude.com/5e35771f8b85ce56f043de5d8dd259013615381a.svg\",\"width\":107,\"height\":48},\"ctas\":[{\"_key\":\"09f9931c584f\",\"_type\":\"link\",\"href\":\"/customers/stubhub\",\"label\":\"Read story\",\"linkType\":\"href\",\"openInNewTab\":false,\"variant\":\"tertiary\",\"page\":null}]},{\"_key\":\"30937e4a399c\",\"_type\":\"testimonialQuote\",\"quote\":\"The partnership with Anthropic has been exceptional—their guidance and support have helped our engineering teams maximize the models.\",\"authorName\":\"Joel Hron\",\"authorTitle\":\"CTO\",\"authorCompany\":null,\"st"])</script><script nonce="HV0XM4lwilzOt0YtHEUUBg==">self.__next_f.push([1,"at\":null,\"headingLevel\":null,\"description\":null,\"descriptionRich\":null,\"logo\":{\"_id\":\"XNQh23oop7n7SfU9ANwLpy\",\"name\":\"Thomson Reuters\",\"logo\":\"https://assets.claude.com/3c80d8dc7dbf6556d1137977873dee26eaffae1d.svg\",\"logoDark\":\"https://assets.claude.com/c7c6ef2f7dc2257c429a154f761197f0f02f5790.svg\",\"width\":213,\"height\":31},\"ctas\":[{\"_key\":\"83e526c48395\",\"_type\":\"link\",\"href\":\"/customers/thomson-reuters\",\"label\":\"Read story\",\"linkType\":\"href\",\"openInNewTab\":false,\"variant\":\"tertiary\",\"page\":null}]}],\"columns\":3,\"originals\":\"$undefined\",\"proof\":false}]\na0:[\"$\",\"$L35\",null,{\"as\":\"h2\",\"size\":\"h1\",\"font\":\"serif\",\"trigger\":\"scroll\",\"className\":\"IntroBlock-module-scss-module__0mSC7a__headline IntroBlock-module-scss-module__0mSC7a__headlineBalance\",\"children\":\"Claude models for every job\"}]\na1:[\"$\",\"$Laf\",null,{\"models\":[{\"_key\":\"95e9e6463872\",\"description\":\"Next generation intelligence for long-running agents\",\"capabilities\":[{\"_key\":\"6ac1bc52b5dc\",\"label\":\"Multi-day autonomous projects\"},{\"_key\":\"af89d526f7c7\",\"label\":\"Expert-level work for frontier research\"}],\"ctas\":[{\"_key\":\"ad111b6864db\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/claude/fable\",\"label\":\"Explore Fable\",\"linkType\":\"href\",\"openInNewTab\":true,\"variant\":\"primary\",\"page\":null}],\"model\":{\"_id\":\"wf-aimodel-fable51\",\"name\":\"Fable 5.1\",\"modelId\":null,\"status\":\"current\",\"prices\":{\"cacheRead\":0.25,\"cacheWrite\":12.5,\"input\":10,\"output\":50}}},{\"_key\":\"d8140d9a319d\",\"description\":\"Daily driver for agentic coding and enterprise work\",\"capabilities\":[{\"_key\":\"072f4f318082\",\"label\":\"Long-horizon coding and large migrations\"},{\"_key\":\"d9b772ed140d\",\"label\":\"Multi-step agents across enterprise tools and data\"}],\"ctas\":[{\"_key\":\"bef94fa252bf\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/claude/opus\",\"label\":\"Explore Opus\",\"linkType\":\"href\",\"openInNewTab\":true,\"variant\":\"primary\",\"page\":null}],\"model\":{\"_id\":\"wf-aimodel-opus55\",\"name\":\"Opus 5.5\",\"modelId\":null,\"status\":\"current\",\"prices\":{\"cacheRead\":0.2,\"cacheWrite\":5,\"input\":4,\"output\":20}}},{\"_key\":\"797e091a2dfa\",\"description\":\"High-performance model for coding and agents\",\"capabilities\":[{\"_key\":\"e1fcaf24b930\",\"label\":\"Everyday coding and developer loops\"},{\"_key\":\"3f9fd298e6d9\",\"label\":\"Customer-facing agents and multi-tool workflows at scale\"}],\"ctas\":[{\"_key\":\"785227e1f667\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/claude/sonnet\",\"label\":\"Explore Sonnet\",\"linkType\":\"href\",\"openInNewTab\":true,\"variant\":\"primary\",\"page\":null}],\"model\":{\"_id\":\"wf-aimodel-sonnet55\",\"name\":\"Sonnet 5.5\",\"modelId\":null,\"status\":\"current\",\"prices\":{\"input\":2,\"output\":10,\"cacheWrite\":2.5,\"cacheRead\":0.1}}},{\"_key\":\"b66869a7d609\",\"description\":\"Fastest, most cost-effective model\",\"capabilities\":[{\"_key\":\"730be0b934c1\",\"label\":\"Real-time, latency-sensitive product experiences\"},{\"_key\":\"de2ec1b468f2\",\"label\":\"Sub-agents inside larger multi-model systems\"}],\"ctas\":[{\"_key\":\"473e2ef21b5f\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/claude/haiku\",\"label\":\"Explore Haiku\",\"linkType\":\"href\",\"openInNewTab\":true,\"variant\":\"primary\",\"page\":null}],\"model\":{\"_id\":\"wf-aimodel-haiku45\",\"name\":\"Haiku 5.5\",\"modelId\":null,\"status\":\"current\",\"prices\":{\"input\":0.1,\"output\":0.5,\"cacheWrite\":0.125,\"cacheRead\":0.01,\"longContext\":{\"threshold\":100000,\"input\":0.5,\"output\":2.5,\"cacheWrite\":0.625,\"cacheRead\":0.05}}}}],\"labels\":{\"input\":\"Input\",\"output\":\"Output\",\"caching\":\"Prompt caching\",\"cacheWrite\":\"Write\",\"cacheRead\":\"Read\",\"unit\":\"/ MTok\",\"tierUpTo\":\"Prompts ≤ {threshold} tokens\",\"tierOver\":\"Prompts \u003e {threshold} tokens\"},\"language\":\"en\",\"showBatchToggle\":true,\"batchDiscountPercent\":50,\"batchNote\":[{\"_key\":\"61ed52ceef30\",\"_type\":\"block\",\"children\":[{\"_key\":\"52775181b90d\",\"_type\":\"span\",\"marks\":[],\"text\":\"Save 50% with batch processing. \"},{\"_key\":\"40349b75a06c\",\"_type\":\"span\",\"marks\":[\"d216bdb6f62a\"],\"text\":\"Learn more\"}],\"markDefs\":[{\"_key\":\"d216bdb6f62a\",\"_type\":\"link\",\"href\":\"https://docs.claude.com/en/docs/build-with-claude/batch-processing\",\"openInNewTab\":true}],\"style\":\"normal\"}],\"batchToggleLabel\":\"Batch processing\",\"batchToggleId\":\"model-ca"])</script><script nonce="HV0XM4lwilzOt0YtHEUUBg==">self.__next_f.push([1,"rds-batch-f4b4594c1c3c\",\"sectionKey\":\"f4b4594c1c3c\"}]\na2:[\"$\",\"div\",null,{\"className\":\"text-rich-text ModelCards-module-scss-module__lqrvha__footnotes\",\"style\":\"$undefined\",\"children\":[[\"$\",\"p\",\"db2adba34382\",{\"className\":\"text-body-3\",\"children\":[[\"$\",\"strong\",\"43fc5fe3f875\",{\"children\":[\"For workloads that need to run in the US, US-only inference is available at 1.1x pricing for input and output tokens. \",[\"$\",\"$Lb0\",\"a01c4414928c\",{\"value\":{\"_key\":\"d5a25d57b8af\",\"_type\":\"link\",\"href\":\"https://platform.claude.com/docs/en/build-with-claude/data-residency\"},\"children\":[\"Learn more\"]}],\".\"]}]]}],[\"$\",\"p\",\"ddedfdb7f91e\",{\"className\":\"text-body-3\",\"children\":[\"Get up to 2.5x faster speeds with fast mode for Opus 5.5 at 2x standard pricing. \",[\"$\",\"$Lb0\",\"bb1efedeb2ef\",{\"value\":{\"_key\":\"db7766e733e8\",\"_type\":\"link\",\"href\":\"https://platform.claude.com/docs/en/about-claude/pricing#fast-mode-pricing\"},\"children\":[\"Learn more\"]}],\".\"]}],[\"$\",\"p\",\"2750aa1f691b\",{\"className\":\"text-body-3\",\"children\":[\"Prompt caching pricing reflects 5-minute TTL. Learn about \",[\"$\",\"$Lb0\",\"c9518f7808b8\",{\"value\":{\"_key\":\"8b4370b4ec09\",\"_type\":\"link\",\"href\":\"https://platform.claude.com/docs/en/build-with-claude/prompt-caching#1-hour-cache-duration\"},\"children\":[\"extended prompt caching\"]}],\".\"]}]]}]\na4:[\"$\",\"br\",\"node-1\",{}]\na5:[\"$\",\"br\",\"node-3\",{}]\na6:[\"$\",\"br\",\"node-5\",{}]\na7:[\"$\",\"p\",\"fb078a4ea868\",{\"className\":\"DocumentPanel-module-scss-module__MuWjkG__p\",\"children\":[\"Remember to be thorough in your analysis and clear in your explanation. Your goal is to provide an accurate classification with well-supported reasoning.\"]}]\n"])</script><script nonce="HV0XM4lwilzOt0YtHEUUBg==">self.__next_f.push([1,"b1:I[27201,[\"/_next/static/chunks/d96012bcfc98706a.js\",\"/_next/static/chunks/73e3194f06db260e.js\"],\"IconMark\"]\n16:null\n"])</script><script nonce="HV0XM4lwilzOt0YtHEUUBg==">self.__next_f.push([1,"1a:[[\"$\",\"title\",\"0\",{\"children\":\"Claude Platform | Claude by Anthropic\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Everything your team needs to build AI agents and run them in production: frontier models, a managed harness, context management, and infrastructure.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"robots\",\"content\":\"max-image-preview:large\"}],[\"$\",\"link\",\"3\",{\"rel\":\"canonical\",\"href\":\"https://claude.com/platform/api\"}],[\"$\",\"link\",\"4\",{\"rel\":\"alternate\",\"hrefLang\":\"en\",\"href\":\"https://claude.com/platform/api\"}],[\"$\",\"link\",\"5\",{\"rel\":\"alternate\",\"hrefLang\":\"de\",\"href\":\"https://claude.com/de/platform/api\"}],[\"$\",\"link\",\"6\",{\"rel\":\"alternate\",\"hrefLang\":\"es\",\"href\":\"https://claude.com/es/platform/api\"}],[\"$\",\"link\",\"7\",{\"rel\":\"alternate\",\"hrefLang\":\"fr\",\"href\":\"https://claude.com/fr/platform/api\"}],[\"$\",\"link\",\"8\",{\"rel\":\"alternate\",\"hrefLang\":\"it\",\"href\":\"https://claude.com/it/platform/api\"}],[\"$\",\"link\",\"9\",{\"rel\":\"alternate\",\"hrefLang\":\"ja\",\"href\":\"https://claude.com/ja/platform/api\"}],[\"$\",\"link\",\"10\",{\"rel\":\"alternate\",\"hrefLang\":\"ko\",\"href\":\"https://claude.com/ko/platform/api\"}],[\"$\",\"link\",\"11\",{\"rel\":\"alternate\",\"hrefLang\":\"x-default\",\"href\":\"https: