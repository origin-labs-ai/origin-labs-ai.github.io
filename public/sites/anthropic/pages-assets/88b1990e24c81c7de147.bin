&amp;fm=avif&amp;fit=max 1920w, https://assets.claude.com/47d7f15e3a1a7ee8c9303a801582d2eaeb183fb6.png?w=2400&amp;q=75&amp;fm=avif&amp;fit=max 2400w" sizes="(min-width: 1200px) 1440px, 100vw"/><img alt="Video: Power your most ambitious workloads with Claude Managed Agents" loading="lazy" decoding="async" style="color:transparent" sizes="(min-width: 1200px) 1440px, 100vw" srcSet="https://assets.claude.com/47d7f15e3a1a7ee8c9303a801582d2eaeb183fb6.png?w=640&amp;q=75&amp;fm=webp&amp;fit=max 640w, https://assets.claude.com/47d7f15e3a1a7ee8c9303a801582d2eaeb183fb6.png?w=750&amp;q=75&amp;fm=webp&amp;fit=max 750w, https://assets.claude.com/47d7f15e3a1a7ee8c9303a801582d2eaeb183fb6.png?w=828&amp;q=75&amp;fm=webp&amp;fit=max 828w, https://assets.claude.com/47d7f15e3a1a7ee8c9303a801582d2eaeb183fb6.png?w=1080&amp;q=75&amp;fm=webp&amp;fit=max 1080w, https://assets.claude.com/47d7f15e3a1a7ee8c9303a801582d2eaeb183fb6.png?w=1200&amp;q=75&amp;fm=webp&amp;fit=max 1200w, https://assets.claude.com/47d7f15e3a1a7ee8c9303a801582d2eaeb183fb6.png?w=1920&amp;q=75&amp;fm=webp&amp;fit=max 1920w, https://assets.claude.com/47d7f15e3a1a7ee8c9303a801582d2eaeb183fb6.png?w=2400&amp;q=75&amp;fm=webp&amp;fit=max 2400w" src="https://assets.claude.com/47d7f15e3a1a7ee8c9303a801582d2eaeb183fb6.png?w=2400&amp;q=75&amp;fm=webp&amp;fit=max" width="2344" height="1318" class="Video-module-scss-module__miVj5a__thumbnailImage" referrerPolicy="strict-origin-when-cross-origin"/></picture><div class="Video-module-scss-module__miVj5a__playButton"><svg width="32" height="32" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="_base-module-scss-module__SsgDWW__vector" aria-hidden="true"><path d="M4 4.0465C4.00028 2.87121 5.29098 2.15224 6.29005 2.7711L15.8927 8.72526C16.8385 9.31185 16.8384 10.6874 15.8927 11.2741L6.29005 17.2283C5.35321 17.8088 4.15995 17.2132 4.01465 16.1677L4 15.9529V4.0465ZM5.76368 3.6217C5.43073 3.41543 5.00029 3.65488 5.00001 4.0465V15.9529L5.00489 16.0251C5.05362 16.3734 5.45152 16.5712 5.76368 16.3777L15.3653 10.4245C15.6805 10.2289 15.6806 9.77038 15.3653 9.57488L5.76368 3.6217Z"></path></svg></div></button></div></div></div></section><dialog id="panel" class="SidePanel-module-scss-module__GUH05G__panel" data-theme="dark" data-widget="sidePanel" data-cta-section="customBlock" aria-labelledby="panel-title"><button class="Button-module-scss-module__1SItCG__button Button-module-scss-module__1SItCG__variant-tertiary Button-module-scss-module__1SItCG__size-iconMain Button-module-scss-module__1SItCG__iconOnly text-body-3 SidePanel-module-scss-module__GUH05G__close" type="button" aria-label="Close"><span class="Button-module-scss-module__1SItCG__icon"><div class="_base-module-scss-module__SsgDWW__wrapper" style="width:20px;height:20px"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="_base-module-scss-module__SsgDWW__vector" aria-hidden="true"><path d="M15.1465 4.14642C15.3418 3.95121 15.6583 3.95118 15.8536 4.14642C16.0487 4.34168 16.0488 4.65822 15.8536 4.85346L10.7071 9.99997L15.8536 15.1465C16.0487 15.3417 16.0488 15.6583 15.8536 15.8535C15.6828 16.0244 15.4187 16.0461 15.2247 15.918L15.1465 15.8535L10 10.707L4.85352 15.8535C4.65827 16.0486 4.34168 16.0486 4.14648 15.8535C3.95129 15.6583 3.95142 15.3418 4.14648 15.1465L9.293 9.99997L4.14648 4.85346C3.95142 4.65818 3.95129 4.34162 4.14648 4.14642C4.34168 3.95128 4.65825 3.95138 4.85352 4.14642L10 9.29294L15.1465 4.14642Z"></path></svg></div></span></button><p class="SidePanel-module-scss-module__GUH05G__eyebrow text-body-2">BETA</p><h2 id="panel-title" class="SidePanel-module-scss-module__GUH05G__headline text-headline-4-serif">Built-in capabilities for every agent</h2><div class="SidePanel-module-scss-module__GUH05G__row"><h2 class="SidePanel-module-scss-module__GUH05G__rowTitle text-headline-6-serif">Multiagent orchestration</h2><div class="text-rich-text SidePanel-module-scss-module__GUH05G__rowBody"><p class="text-body-3">Claude delegates to other agents, each with its own independent context window.</p></div></div><div class="SidePanel-module-scss-module__GUH05G__row"><h2 class="SidePanel-module-scss-module__GUH05G__rowTitle text-headline-6-serif">Outcomes</h2><div class="text-rich-text SidePanel-module-scss-module__GUH05G__rowBody"><p class="text-body-3">Agents iterate against pre-defined exit criteria, grading their own work against a rubric.</p></div></div><div class="SidePanel-module-scss-module__GUH05G__row"><h2 class="SidePanel-module-scss-module__GUH05G__rowTitle text-headline-6-serif">Memory tool</h2><div class="text-rich-text SidePanel-module-scss-module__GUH05G__rowBody"><p class="text-body-3">Claude reads and writes to memory stores, so every session gets progressively better.</p></div></div><div class="SidePanel-module-scss-module__GUH05G__row"><h2 class="SidePanel-module-scss-module__GUH05G__rowTitle text-headline-6-serif">Scheduled deployments</h2><div class="text-rich-text SidePanel-module-scss-module__GUH05G__rowBody"><p class="text-body-3">Run agents on a schedule, so recurring work happens without having to trigger a run.</p></div></div><div class="SidePanel-module-scss-module__GUH05G__row"><h2 class="SidePanel-module-scss-module__GUH05G__rowTitle text-headline-6-serif">Self-hosted sandboxes</h2><div class="text-rich-text SidePanel-module-scss-module__GUH05G__rowBody"><p class="text-body-3">Keep sensitive files, packages, and services in your own infrastructure, or use a managed provider.</p></div></div><div class="SidePanel-module-scss-module__GUH05G__row"><h2 class="SidePanel-module-scss-module__GUH05G__rowTitle text-headline-6-serif">Dreaming</h2><div class="text-rich-text SidePanel-module-scss-module__GUH05G__rowBody"><p class="text-body-3">Between sessions, Claude reflects on past runs and codifies what it learned as memory.</p></div></div><div class="SidePanel-module-scss-module__GUH05G__row"><h2 class="SidePanel-module-scss-module__GUH05G__rowTitle text-headline-6-serif">MCP tunnels</h2><div class="text-rich-text SidePanel-module-scss-module__GUH05G__rowBody"><p class="text-body-3">Reach MCP servers in your private network without exposing them to the public internet.</p></div></div><div class="SidePanel-module-scss-module__GUH05G__row"><h2 class="SidePanel-module-scss-module__GUH05G__rowTitle text-headline-6-serif">Vaults</h2><div class="text-rich-text SidePanel-module-scss-module__GUH05G__rowBody"><p class="text-body-3">Keep secrets out of your agent code. Register a credential once and reuse it across sessions.</p></div></div></dialog><section id="featureList" data-section="featureList" data-cta-section="featureList" class="SectionWrapper-module-scss-module__NFbz_a__wrapper theme-accent"><div class="container"><div class="grid-12"><div class="FeatureList-module-scss-module__3G7ECW__inner FeatureList-module-scss-module__3G7ECW__fullWidth"><div class="AnimatedReveal-module-scss-module__8zH9eW__container FeatureList-module-scss-module__3G7ECW__list FeatureList-module-scss-module__3G7ECW__vertical" style="--reveal-y:20px;--reveal-duration:0.75s;--reveal-delay:0s;--reveal-stagger:0.1s"><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:0"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M10 1.99121C10.4707 1.99121 10.9712 2.13317 11.3516 2.45508C12.1747 3.15161 13.5508 3.99292 15.5518 4.20117C16.3217 4.28129 17 4.90867 17 5.75V9.98438C16.9998 12.3468 15.8083 14.5499 13.8311 15.8428L10.8213 17.8105C10.3226 18.1366 9.67739 18.1366 9.17871 17.8105L6.16895 15.8428C4.19174 14.5499 3.00016 12.3467 3 9.98438V5.75C3 4.90867 3.67835 4.28129 4.44824 4.20117C6.44918 3.99292 7.82531 3.15161 8.64844 2.45508L8.79688 2.34277C9.15386 2.09996 9.58822 1.99121 10 1.99121ZM10 2.99121C9.75034 2.99121 9.52329 3.0588 9.36035 3.16895L9.29492 3.21875C8.35364 4.01531 6.7943 4.9629 4.55176 5.19629C4.22301 5.2305 4 5.48676 4 5.75V9.98438C4.00016 12.0093 5.02198 13.8977 6.7168 15.0059L9.72656 16.9736C9.89274 17.0822 10.1073 17.0822 10.2734 16.9736L13.2832 15.0059C14.978 13.8977 15.9998 12.0093 16 9.98438V5.75C16 5.48676 15.777 5.2305 15.4482 5.19629C13.2057 4.9629 11.6464 4.01531 10.7051 3.21875C10.5408 3.0797 10.2852 2.99121 10 2.99121ZM12.1055 7.85254C12.275 7.63461 12.5887 7.59523 12.8066 7.76465C13.0245 7.93416 13.0639 8.24787 12.8945 8.46582L10.0312 12.1484C9.9432 12.2615 9.81003 12.3309 9.66699 12.3398C9.52407 12.3486 9.3845 12.2956 9.2832 12.1943L7.64648 10.5586L7.58203 10.4795C7.45421 10.2856 7.47598 10.0223 7.64648 9.85156C7.81741 9.68064 8.08129 9.6588 8.27539 9.78711L8.35352 9.85156L9.58887 11.0859L12.1055 7.85254Z" /></svg></span><h3 class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Security by design</h3></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-2">Credentials stay out of the sandbox, encryption is built in, and state persists automatically.</p></div></div></div><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:1"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M5 2.5C5.93171 2.5 6.71235 3.13768 6.93457 4H13.75C15.5449 4 17 5.45507 17 7.25C17 9.04493 15.5449 10.5 13.75 10.5H12.707L10.3535 12.8535C10.1583 13.0488 9.84175 13.0488 9.64648 12.8535L7.29297 10.5H6.25C5.00736 10.5 4 11.5074 4 12.75C4 13.9926 5.00736 15 6.25 15H13.0654C13.2877 14.1377 14.0683 13.5 15 13.5C16.1046 13.5 17 14.3954 17 15.5C17 16.6046 16.1046 17.5 15 17.5C14.0683 17.5 13.2877 16.8623 13.0654 16H6.25C4.45507 16 3 14.5449 3 12.75C3 10.9551 4.45507 9.5 6.25 9.5H7.29297L9.64648 7.14648L9.72461 7.08203C9.91869 6.95387 10.1827 6.97562 10.3535 7.14648L12.707 9.5H13.75C14.9926 9.5 16 8.49264 16 7.25C16 6.00736 14.9926 5 13.75 5H6.93457C6.71235 5.86232 5.93171 6.5 5 6.5C3.89543 6.5 3 5.60457 3 4.5C3 3.39543 3.89543 2.5 5 2.5ZM15 14.5C14.4477 14.5 14 14.9477 14 15.5C14 16.0523 14.4477 16.5 15 16.5C15.5523 16.5 16 16.0523 16 15.5C16 14.9477 15.5523 14.5 15 14.5ZM8.20703 10L10 11.793L11.793 10L10 8.20703L8.20703 10ZM5 3.5C4.44772 3.5 4 3.94772 4 4.5C4 5.05228 4.44772 5.5 5 5.5C5.55228 5.5 6 5.05228 6 4.5C6 3.94772 5.55228 3.5 5 3.5Z" /></svg></span><h3 class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Observable end to end</h3></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-2">Session tracing records what every agent did and why, with built-in analytics to improve agent performance.</p></div></div></div><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:2"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M9 3C9.82843 3 10.5 3.67157 10.5 4.5V9.5H15.5C16.3284 9.5 17 10.1716 17 11V15.5C17 16.3284 16.3284 17 15.5 17H4.5C3.67157 17 3 16.3284 3 15.5V4.5C3 3.67157 3.67157 3 4.5 3H9ZM4 15.5C4 15.7761 4.22386 16 4.5 16H9.5V10.5H4V15.5ZM10.5 16H15.5C15.7761 16 16 15.7761 16 15.5V11C16 10.7239 15.7761 10.5 15.5 10.5H10.5V16ZM4.5 4C4.22386 4 4 4.22386 4 4.5V9.5H9.5V4.5C9.5 4.22386 9.27614 4 9 4H4.5Z" /></svg></span><h3 class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Built for Claude</h3></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-2">The underlying harness is optimized for Claude. As the model improves, your agents improve with it.</p></div></div></div></div></div></div></div></section><section id="featureList" data-section="featureList" data-cta-section="featureList" class="SectionWrapper-module-scss-module__NFbz_a__wrapper theme-main"><div class="SectionWrapper-module-scss-module__NFbz_a__borderTop"></div><div data-wf-threshold="small" data-wf-width="full" class="container"><div class="grid-12"><div class="FeatureList-module-scss-module__3G7ECW__inner FeatureList-module-scss-module__3G7ECW__fullWidth"><div class="IntroBlock-module-scss-module__0mSC7a__introBlock IntroBlock-module-scss-module__0mSC7a__mobileLeftPhone IntroBlock-module-scss-module__0mSC7a__spacingBelowLarge FeatureList-module-scss-module__3G7ECW__intro" style="--intro-headline-width:30ch;--intro-text-width:45ch"><div class="Illustration-module-scss-module__pBGuRG__base Illustration-module-scss-module__pBGuRG__pictogram Illustration-module-scss-module__pBGuRG__size-large IntroBlock-module-scss-module__0mSC7a__pictogram" role="img" aria-label="Detailed mechanical gears and cog system. One large central gear with intricate teeth, surrounded by smaller interlocking gears in a complex industrial mechanism design."></div><h2 class="Heading-module-scss-module__AyGdUq__heading text-headline-1-serif Heading-module-scss-module__AyGdUq__balance AnimatedHeading-module-scss-module__KoWePa__heading IntroBlock-module-scss-module__0mSC7a__headline IntroBlock-module-scss-module__0mSC7a__headlineBalance" style="--word-stagger:0.04s" aria-label="Connect to your systems and knowledge"><span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:0" aria-hidden="true">Connect</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:1" aria-hidden="true">to</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:2" aria-hidden="true">your</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:3" aria-hidden="true">systems</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:4" aria-hidden="true">and</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:5" aria-hidden="true">knowledge</span></h2><div class="AnimatedReveal-module-scss-module__8zH9eW__container IntroBlock-module-scss-module__0mSC7a__subheadlineAndCtas" style="--reveal-y:10px;--reveal-duration:0.75s;--reveal-delay:0s;--reveal-stagger:0.1s"><p class="IntroBlock-module-scss-module__0mSC7a__subheadline text-body-large-2" style="--reveal-index:0">Extend and customize what Claude can do.</p></div></div><div class="AnimatedReveal-module-scss-module__8zH9eW__container FeatureList-module-scss-module__3G7ECW__list FeatureList-module-scss-module__3G7ECW__horizontal FeatureList-module-scss-module__3G7ECW__ctasNatural FeatureList-module-scss-module__3G7ECW__autofit FeatureList-module-scss-module__3G7ECW__noWidow FeatureList-module-scss-module__3G7ECW__cols3" style="--reveal-y:20px;--reveal-duration:0.75s;--reveal-delay:0s;--reveal-stagger:0.1s"><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:0"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="32" height="32" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M16.5 15C16.7761 15 17 15.2239 17 15.5C17 15.7761 16.7761 16 16.5 16H3.5C3.22387 16 3.00002 15.7761 3 15.5C3 15.2239 3.22386 15 3.5 15H16.5ZM3.14648 3.14651C3.34175 2.95125 3.65825 2.95125 3.85352 3.14651L7.35352 6.64651C7.54846 6.8418 7.54867 7.15838 7.35352 7.35354L3.85352 10.8545C3.65838 11.0491 3.34162 11.0491 3.14648 10.8545C2.95139 10.6594 2.95173 10.3428 3.14648 10.1475L6.29297 7.00002L3.14648 3.85354C2.95123 3.65828 2.95124 3.34177 3.14648 3.14651ZM16.5 9.50002C16.7761 9.50002 17 9.72388 17 10C17 10.2761 16.7761 10.5 16.5 10.5H10.5C10.2239 10.5 10 10.2761 10 10C10 9.72388 10.2239 9.50002 10.5 9.50002H16.5ZM16.5 4.00002C16.7761 4.00002 17 4.22388 17 4.50002C17 4.77615 16.7761 5.00002 16.5 5.00002H10.5C10.2239 5.00002 10 4.77615 10 4.50002C10 4.22388 10.2239 4.00002 10.5 4.00002H16.5Z" /></svg></span><h3 class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Model Context Protocol (MCP)</h3></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-3">Connect Claude to your tools and data through the open standard for AI integrations.</p></div><div role="group" class="ButtonGroup-module-scss-module__HSKYlq__buttonGroup FeatureList-module-scss-module__3G7ECW__ctas"><a href="https://platform.claude.com/docs/en/agents-and-tools/remote-mcp-servers" class="Button-module-scss-module__1SItCG__button Button-module-scss-module__1SItCG__variant-tertiary Button-module-scss-module__1SItCG__size-small text-caption" target="_blank" rel="noopener noreferrer" data-cta-position="featureList" data-cta-url="https://platform.claude.com/docs/en/agents-and-tools/remote-mcp-servers">Explore MCP<span class="sr-only" lang="en" data-export-skip=""> (opens in new tab)</span></a></div></div></div><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:1"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="32" height="32" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M12.5 3C13.3284 3 14 3.67157 14 4.5V6H14.5C16.433 6 18 7.567 18 9.5V15.5C18 16.3284 17.3284 17 16.5 17H3.5C2.72334 17 2.08461 16.4097 2.00781 15.6533L2 15.5V9.5C2 7.567 3.567 6 5.5 6H6V4.5C6 3.67157 6.67157 3 7.5 3H12.5ZM3 15.5L3.00977 15.6006C3.05629 15.8286 3.25829 16 3.5 16H16.5C16.7761 16 17 15.7761 17 15.5V12H13V12.5C13 12.7761 12.7761 13 12.5 13C12.2239 13 12 12.7761 12 12.5V12H8V12.5C8 12.7761 7.77614 13 7.5 13C7.22386 13 7 12.7761 7 12.5V12H3V15.5ZM5.5 7C4.11929 7 3 8.11929 3 9.5V11H7V10.5C7 10.2239 7.22386 10 7.5 10C7.77614 10 8 10.2239 8 10.5V11H12V10.5C12 10.2239 12.2239 10 12.5 10C12.7761 10 13 10.2239 13 10.5V11H17V9.5C17 8.11929 15.8807 7 14.5 7H5.5ZM7.5 4C7.22386 4 7 4.22386 7 4.5V6H13V4.5C13 4.22386 12.7761 4 12.5 4H7.5Z" /></svg></span><h3 class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Skills</h3></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-3">Teach Claude your expertise, procedures, and best practices through pre-built or customizable skills.</p></div><div role="group" class="ButtonGroup-module-scss-module__HSKYlq__buttonGroup FeatureList-module-scss-module__3G7ECW__ctas"><a href="https://platform.claude.com/docs/en/agents-and-tools/agent-skills/overview" class="Button-module-scss-module__1SItCG__button Button-module-scss-module__1SItCG__variant-tertiary Button-module-scss-module__1SItCG__size-small text-caption" target="_blank" rel="noopener noreferrer" data-cta-position="featureList" data-cta-url="https://platform.claude.com/docs/en/agents-and-tools/agent-skills/overview">Learn more<span class="sr-only" lang="en" data-export-skip=""> (opens in new tab)</span></a></div></div></div><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:2"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="32" height="32" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M13.2901 8.80371C13.3987 8.55001 13.6926 8.43174 13.9463 8.54004C14.2 8.64863 14.3183 8.94253 14.21 9.19629C13.8506 10.036 13.1645 10.75 12.2501 10.75C11.6373 10.75 11.1281 10.4289 10.7501 9.96484C10.372 10.4289 9.86281 10.75 9.25006 10.75C8.6373 10.75 8.12807 10.4289 7.75006 9.96484C7.37204 10.4289 6.86281 10.75 6.25005 10.75C5.97391 10.75 5.75004 10.5261 5.75004 10.25C5.75004 9.97386 5.97391 9.75 6.25005 9.75C6.58769 9.75 7.00453 9.47056 7.29009 8.80371L7.32427 8.73731C7.41436 8.59121 7.57495 8.5 7.75006 8.5C7.95016 8.5 8.13128 8.61975 8.21002 8.80371L8.32232 9.03516C8.5981 9.5359 8.95448 9.75 9.25006 9.75C9.5877 9.75 10.0045 9.47056 10.2901 8.80371L10.3243 8.73731C10.4144 8.59121 10.575 8.5 10.7501 8.5C10.9502 8.5 11.1313 8.61975 11.21 8.80371L11.3223 9.03516C11.5981 9.5359 11.9545 9.75 12.2501 9.75C12.5877 9.75 13.0045 9.47056 13.2901 8.80371Z" />
    <path d="M17.5001 9.5C17.5001 5.35786 14.1422 2 10.0001 2C6.02597 2 2.7738 5.09093 2.51646 8.9999C2.49832 9.27545 2.7239 9.5 3.00005 9.5C3.27619 9.5 3.49804 9.27536 3.51899 9.00001C3.7743 5.64378 6.57844 3 10.0001 3C13.5899 3 16.5001 5.91015 16.5001 9.5C16.5001 13.0899 13.5899 16 10.0001 16L4.14454 16.0039C4.2217 15.9267 4.65715 15.4879 4.97281 15.1696C5.1604 14.9805 5.16561 14.6771 4.98464 14.4817C4.79262 14.2743 4.46658 14.2684 4.26722 14.4687L2.6909 16.0528C2.43618 16.3088 2.43611 16.7225 2.69075 16.9786L4.23274 18.5292C4.43649 18.7341 4.76945 18.7294 4.96735 18.5188C5.15709 18.317 5.15139 18.0007 4.95452 17.8058L4.14454 17.0039L10.0001 17C14.1422 17 17.5001 13.6421 17.5001 9.5Z" /></svg></span><h3 class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Memory stores</h3></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-3">Agents remember across sessions, keeping memory files on your infrastructure.</p></div><div role="group" class="ButtonGroup-module-scss-module__HSKYlq__buttonGroup FeatureList-module-scss-module__3G7ECW__ctas"><a href="https://platform.claude.com/docs/en/managed-agents/memory" class="Button-module-scss-module__1SItCG__button Button-module-scss-module__1SItCG__variant-tertiary Button-module-scss-module__1SItCG__size-small text-caption" target="_blank" rel="noopener noreferrer" data-cta-position="featureList" data-cta-url="https://platform.claude.com/docs/en/managed-agents/memory">Learn more<span class="sr-only" lang="en" data-export-skip=""> (opens in new tab)</span></a></div></div></div></div></div></div></div></section><section id="logoWallCard" data-section="logoWallCard" data-cta-section="logoWallCard" class="SectionWrapper-module-scss-module__NFbz_a__wrapper theme-main SectionWrapper-module-scss-module__NFbz_a__spacingTopNone"><div class="container"><div class="grid-12"><div class="FeatureMediaCard-module-scss-module__0vMEpa__card"><div class="FeatureMediaCard-module-scss-module__0vMEpa__logoGrid" data-theme="neutral"><div class="FeatureMediaCard-module-scss-module__0vMEpa__grid" data-columns="3" style="--grid-columns:3"><div class="FeatureMediaCard-module-scss-module__0vMEpa__cell"><div class="FeatureMediaCard-module-scss-module__0vMEpa__cellInner"><picture class="FeatureMediaCard-module-scss-module__0vMEpa__logoImg"><img src="https://assets.claude.com/443d25ed3f9543590175e4aea995e66cb8218fba.svg" alt="Harvey" class="Logo-module-scss-module__j-nrIq__logo" loading="lazy" referrerPolicy="strict-origin-when-cross-origin"/></picture></div></div><div class="FeatureMediaCard-module-scss-module__0vMEpa__cell"><div class="FeatureMediaCard-module-scss-module__0vMEpa__cellInner"><picture class="FeatureMediaCard-module-scss-module__0vMEpa__logoImg"><img src="https://assets.claude.com/dfdd2ff52c29f3e682bbfcce8c1e0c12c6413f58.jpg" alt="Snowflake" class="Logo-module-scss-module__j-nrIq__logo" loading="lazy" referrerPolicy="strict-origin-when-cross-origin"/></picture></div></div><div class="FeatureMediaCard-module-scss-module__0vMEpa__cell"><div class="FeatureMediaCard-module-scss-module__0vMEpa__cellInner"><picture class="FeatureMediaCard-module-scss-module__0vMEpa__logoImg"><img src="https://assets.claude.com/949ea019337356d5cbd4a3709627af61c877e1c2.jpg" alt="Lovable" class="Logo-module-scss-module__j-nrIq__logo" loading="lazy" referrerPolicy="strict-origin-when-cross-origin"/></picture></div></div><div class="FeatureMediaCard-module-scss-module__0vMEpa__cell"><div class="FeatureMediaCard-module-scss-module__0vMEpa__cellInner"><picture class="FeatureMediaCard-module-scss-module__0vMEpa__logoImg"><img src="https://assets.claude.com/9c819d37b6fa239b368e630436ad64315237bbe8.jpg" alt="GitLab" class="Logo-module-scss-module__j-nrIq__logo" loading="lazy" referrerPolicy="strict-origin-when-cross-origin"/></picture></div></div><div class="FeatureMediaCard-module-scss-module__0vMEpa__cell"><div class="FeatureMediaCard-module-scss-module__0vMEpa__cellInner"><picture class="FeatureMediaCard-module-scss-module__0vMEpa__logoImg"><img src="https://assets.claude.com/7ec6f9759c8e7823688e8eea856085a72f1bbdf0.svg" alt="Hebbia" class="Logo-module-scss-module__j-nrIq__logo" loading="lazy" referrerPolicy="strict-origin-when-cross-origin"/></picture></div></div><div class="FeatureMediaCard-module-scss-module__0vMEpa__cell"><div class="FeatureMediaCard-module-scss-module__0vMEpa__cellInner"><picture class="FeatureMediaCard-module-scss-module__0vMEpa__logoImg"><img src="https://assets.claude.com/7ef1f80dac1e2ab1b9899d196a700800dab0b111.jpg" alt="icon_Base44" class="Logo-module-scss-module__j-nrIq__logo" loading="lazy" referrerPolicy="strict-origin-when-cross-origin"/></picture></div></div><div class="FeatureMediaCard-module-scss-module__0vMEpa__cell"><div class="FeatureMediaCard-module-scss-module__0vMEpa__cellInner"><picture class="FeatureMediaCard-module-scss-module__0vMEpa__logoImg"><img src="https://assets.claude.com/455ddcc0c80ceed37ce0942f0fdef8f4f6b103ec.svg" alt="Legora" class="Logo-module-scss-module__j-nrIq__logo" loading="lazy" referrerPolicy="strict-origin-when-cross-origin"/></picture></div></div><div class="FeatureMediaCard-module-scss-module__0vMEpa__cell"><div class="FeatureMediaCard-module-scss-module__0vMEpa__cellInner"><picture class="FeatureMediaCard-module-scss-module__0vMEpa__logoImg"><img src="https://assets.claude.com/e81eea017af5e9035a0ef893b92a2089e47863d5.svg" alt="CodeRabbit New" class="Logo-module-scss-module__j-nrIq__logo" loading="lazy" referrerPolicy="strict-origin-when-cross-origin"/></picture></div></div><div class="FeatureMediaCard-module-scss-module__0vMEpa__cell"><div class="FeatureMediaCard-module-scss-module__0vMEpa__cellInner"><picture class="FeatureMediaCard-module-scss-module__0vMEpa__logoImg"><img src="https://assets.claude.com/5ee36837a0147e1eada1ee494bdd221f6af08808.jpg" alt="Rogo" class="Logo-module-scss-module__j-nrIq__logo" loading="lazy" referrerPolicy="strict-origin-when-cross-origin"/></picture></div></div></div></div><div class="FeatureMediaCard-module-scss-module__0vMEpa__content"><h2 class="Heading-module-scss-module__AyGdUq__heading text-headline-4-serif Heading-module-scss-module__AyGdUq__balance FeatureMediaCard-module-scss-module__0vMEpa__sideHeadline">Claude Marketplace</h2><div class="text-rich-text FeatureMediaCard-module-scss-module__0vMEpa__body"><p class="text-body-3">Use your existing Anthropic commitment to pay for Claude-powered solutions from our partners.</p></div><div role="group" class="ButtonGroup-module-scss-module__HSKYlq__buttonGroup FeatureMediaCard-module-scss-module__0vMEpa__ctas"><a href="/platform/marketplace" class="Button-module-scss-module__1SItCG__button Button-module-scss-module__1SItCG__variant-secondary Button-module-scss-module__1SItCG__size-mainSmall text-body-3" data-cta-position="featureMediaCard" data-cta-url="/platform/marketplace">Explore partners</a></div></div></div></div></div></section><section id="featureList" data-section="featureList" data-cta-section="featureList" class="SectionWrapper-module-scss-module__NFbz_a__wrapper theme-accent"><div class="SectionWrapper-module-scss-module__NFbz_a__borderTop"></div><div data-wf-threshold="small" data-wf-width="full" class="container"><div class="grid-12"><div class="FeatureList-module-scss-module__3G7ECW__inner FeatureList-module-scss-module__3G7ECW__fullWidth"><div class="IntroBlock-module-scss-module__0mSC7a__introBlock IntroBlock-module-scss-module__0mSC7a__mobileLeftPhone IntroBlock-module-scss-module__0mSC7a__spacingBelowLarge FeatureList-module-scss-module__3G7ECW__intro" style="--intro-headline-width:30ch;--intro-text-width:45ch"><div class="Illustration-module-scss-module__pBGuRG__base Illustration-module-scss-module__pBGuRG__pictogram Illustration-module-scss-module__pBGuRG__size-large IntroBlock-module-scss-module__0mSC7a__pictogram" role="img" aria-label="Illustration of hand shapes showing various hand gestures and positions in beige and black colors, including fingers, palms, and hand forms."></div><h2 class="Heading-module-scss-module__AyGdUq__heading text-headline-1-serif Heading-module-scss-module__AyGdUq__balance AnimatedHeading-module-scss-module__KoWePa__heading IntroBlock-module-scss-module__0mSC7a__headline IntroBlock-module-scss-module__0mSC7a__headlineBalance" style="--word-stagger:0.06666666666666667s" aria-label="Built for enterprise workloads"><span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:0" aria-hidden="true">Built</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:1" aria-hidden="true">for</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:2" aria-hidden="true">enterprise</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:3" aria-hidden="true">workloads</span></h2><div class="AnimatedReveal-module-scss-module__8zH9eW__container IntroBlock-module-scss-module__0mSC7a__subheadlineAndCtas" style="--reveal-y:10px;--reveal-duration:0.75s;--reveal-delay:0s;--reveal-stagger:0.1s"><p class="IntroBlock-module-scss-module__0mSC7a__subheadline text-body-large-2" style="--reveal-index:0">Controls and safeguards for your data.</p></div></div><div class="AnimatedReveal-module-scss-module__8zH9eW__container FeatureList-module-scss-module__3G7ECW__list FeatureList-module-scss-module__3G7ECW__horizontal FeatureList-module-scss-module__3G7ECW__ctasNatural FeatureList-module-scss-module__3G7ECW__autofit FeatureList-module-scss-module__3G7ECW__noWidow FeatureList-module-scss-module__3G7ECW__cols3" style="--reveal-y:20px;--reveal-duration:0.75s;--reveal-delay:0s;--reveal-stagger:0.1s"><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:0"><div class="FeatureList-module-scs