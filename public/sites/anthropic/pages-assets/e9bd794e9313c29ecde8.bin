ath d="M14.128 7.16482C14.3126 6.95983 14.6298 6.94336 14.835 7.12771C15.0402 7.31242 15.0567 7.62952 14.8721 7.83477L10.372 12.835L10.2939 12.9053C10.2093 12.9667 10.1063 13 9.99995 13C9.85833 12.9999 9.72264 12.9402 9.62788 12.835L5.12778 7.83477L5.0682 7.75273C4.95072 7.55225 4.98544 7.28926 5.16489 7.12771C5.34445 6.96617 5.60969 6.95939 5.79674 7.09744L5.87193 7.16482L9.99995 11.7519L14.128 7.16482Z"></path></svg></div></button></h3></div><div data-orientation="vertical" data-hidden="" data-index="-1" data-closed="" class="dU5k9q_accordionItem"><h3 data-orientation="vertical" data-hidden="" data-index="-1" data-closed=""><button type="button" data-value="" data-orientation="vertical" data-hidden="" data-index="-1" tabindex="0" aria-disabled="false" aria-expanded="false" id="base-ui-_R_3l6q6btbH2_" class="dU5k9q_trigger"><span class="dU5k9q_triggerText">Solutions</span><div class="dU5k9q_icon" style="width:20px;height:20px;display:flex;align-items:center;justify-content:center;flex-shrink:0"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M14.128 7.16482C14.3126 6.95983 14.6298 6.94336 14.835 7.12771C15.0402 7.31242 15.0567 7.62952 14.8721 7.83477L10.372 12.835L10.2939 12.9053C10.2093 12.9667 10.1063 13 9.99995 13C9.85833 12.9999 9.72264 12.9402 9.62788 12.835L5.12778 7.83477L5.0682 7.75273C4.95072 7.55225 4.98544 7.28926 5.16489 7.12771C5.34445 6.96617 5.60969 6.95939 5.79674 7.09744L5.87193 7.16482L9.99995 11.7519L14.128 7.16482Z"></path></svg></div></button></h3></div><div data-orientation="vertical" data-hidden="" data-index="-1" data-closed="" class="dU5k9q_accordionItem"><h3 data-orientation="vertical" data-hidden="" data-index="-1" data-closed=""><button type="button" data-value="" data-orientation="vertical" data-hidden="" data-index="-1" tabindex="0" aria-disabled="false" aria-expanded="false" id="base-ui-_R_456q6btbH2_" class="dU5k9q_trigger"><span class="dU5k9q_triggerT