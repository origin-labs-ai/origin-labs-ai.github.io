\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"aria-label\":\"Link to Anthropic's youtube account\",\"children\":[\"$\",\"$L57\",null,{\"width\":24,\"height\":24,\"fill\":\"currentColor\"}]}]}],null,[\"$\",\"li\",\"x\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://x.com/AnthropicAI\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"aria-label\":\"Link to Anthropic's x account\",\"children\":[\"$\",\"$L58\",null,{\"width\":24,\"height\":24,\"fill\":\"currentColor\"}]}]}],[\"$\",\"li\",\"linkedin\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.linkedin.com/company/anthropicresearch\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"aria-label\":\"Link to Anthropic's linkedin account\",\"children\":[\"$\",\"$L59\",null,{\"width\":24,\"height\":24,\"fill\":\"currentColor\"}]}]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"5a:I[512311,[\"$6\",\"$18\",\"$19\",\"$1a\",\"$1b\",\"$1c\",\"$1d\",\"$1e\",\"$1f\",\"$20\",\"$21\",\"$22\",\"$23\",\"$24\",\"$25\",\"$26\",\"$3d\",\"$3e\"],\"default\"]\n5b:I[427114,[\"$6\",\"$18\",\"$19\",\"$1a\",\"$1b\",\"$1c\",\"$1d\",\"$1e\",\"$1f\",\"$20\",\"$21\",\"$22\",\"$23\",\"$24\",\"$25\",\"$26\",\"$3d\",\"$3e\"],\"default\"]\n5d:I[27201,[\"$6\"],\"IconMark\"]\nb:[\"$\",\"div\",null,{\"className\":\"_4c1L5a_page\",\"data-theme\":\"slate\",\"data-page\":\"glasswing\",\"children\":[[\"$\",\"$L5a\",null,{\"hero\":{\"title\":\"Project Glasswing\",\"subtitle\":\"Securing critical software for the AI era\",\"video\":{\"asset\":{\"url\":\"https://assets.claude.com/2f2bb4101e4454b6c0314a90e06e511a667a66f7.webm\"}},\"cta\":{\"label\":\"Continue reading\",\"url\":null}}}],null,[\"$\",\"$L5b\",null,{\"content\":[{\"_key\":\"03ca34c8052f\",\"_type\":\"block\",\"children\":[{\"_key\":\"533e564988fa\",\"_type\":\"span\",\"marks\":[],\"text\":\"Introduction\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"c1da00c5a565\",\"_type\":\"block\",\"children\":[{\"_key\":\"dd31fd40164e\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"October 6, 2026\"},{\"_key\":\"612c82649d5b\",\"_type\":\"span\",\"marks\":[],\"text\":\" - We’re launching a new, expanded version of our Cyber Verification Program (CVP), which makes advanced cyber capabilities and reduced blocking classifiers available to qualifying security professionals. The program now consists of three access tiers, which allow security teams to apply for the level of access that best suits their work. Each tier includes access to our most capable models, including Claude Opus 5.5, Claude Sonnet 5.5, Claude Mythos 5.1, and new models moving forward. Existing members of Project Glasswing will transition to the Specialized Access tier.\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"258e2d8883d7\",\"_type\":\"block\",\"children\":[{\"_key\":\"cf8990e1312b\",\"_type\":\"span\",\"marks\":[\"d1e054c42a32\"],\"text\":\"Learn more\"}],\"markDefs\":[{\"_key\":\"d1e054c42a32\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www.anthropic.com/news/cyber-verification-program\"}],\"style\":\"normal\"},{\"_key\":\"edf19290b93f\",\"_type\":\"block\",\"children\":[{\"_key\":\"029309477155\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"22554a1c3c67\",\"_type\":\"block\",\"children\":[{\"_key\":\"5016b6219183\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"April 7, 2026\"},{\"_key\":\"c06182ec993d\",\"_type\":\"span\",\"marks\":[],\"text\":\" - Today we’re announcing Project Glasswing\"},{\"_key\":\"615657e37135\",\"_type\":\"span\",\"marks\":[\"sup\"],\"text\":\"1\"},{\"_key\":\"0564b58ea2e0\",\"_type\":\"span\",\"marks\":[],\"text\":\", a new initiative that brings together Amazon Web Services, Anthropic, Apple, Broadcom, Cisco, CrowdStrike, Google, JPMorganChase, the Linux Foundation, Microsoft, NVIDIA, and Palo Alto Networks in an effort to secure the world’s most critical software.\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"9314b2fd3160\",\"_type\":\"block\",\"children\":[{\"_key\":\"ced7fea85b94\",\"_type\":\"span\",\"marks\":[],\"text\":\"We formed Project Glasswing because of capabilities we’ve observed in a new frontier model trained by Anthropic that we believe could reshape cybersecurity. Claude Mythos\"},{\"_key\":\"c4a58f335917\",\"_type\":\"span\",\"marks\":[\"sup\"],\"text\":\"2\"},{\"_key\":\"ab9cf8ceff73\",\"_type\":\"span\",\"marks\":[],\"text\":\" Preview is a general-purpose, unreleased frontier model that reveals a stark fact: AI models have reached a level of coding capability where they can surpass all but the most skilled humans at finding and exploiting software vulnerabilities.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"13fe7a5d31a1\",\"_type\":\"block\",\"children\":[{\"_key\":\"51a2a624ae93\",\"_type\":\"span\",\"marks\":[],\"text\":\"Mythos Preview has already found thousands of high-severity vulnerabilities, including some in \"},{\"_key\":\"c03257e11e83\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"every major operating system and web browser\"},{\"_key\":\"036cb1e34d5e\",\"_type\":\"span\",\"marks\":[],\"text\":\". Given the rate of AI progress, it will not be long before such capabilities proliferate, potentially beyond actors who are committed to deploying them safely. The fallout—for economies, public safety, and national security—could be severe. Project Glasswing is an urgent attempt to put these capabilities to work for defensive purposes.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ab5f65ca3ed5\",\"_type\":\"block\",\"children\":[{\"_key\":\"854262cac8be\",\"_type\":\"span\",\"marks\":[],\"text\":\"As part of Project Glasswing, the launch partners listed above will use Mythos Preview as part of their defensive security work; Anthropic will share what we learn so the whole industry can benefit. We have also extended access to a group of over 40 additional organizations that build or maintain critical software infrastructure so they can use the model to scan and secure both first-party and open-source systems. Anthropic is committing up to $100M in usage credits for Mythos Preview across these efforts, as well as $4M in direct donations to open-source security organizations.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"91dede46233b\",\"_type\":\"block\",\"children\":[{\"_key\":\"854262cac8be\",\"_type\":\"span\",\"marks\":[],\"text\":\"Project Glasswing is a starting point. No one organization can solve these cybersecurity problems alone: frontier AI developers, other software companies, security researchers, open-source maintainers, and governments across the world all have essential roles to play. The work of defending the world’s cyber infrastructure might take years; frontier AI capabilities are likely to advance substantially over just the next few months. For cyber defenders to come out ahead, we need to act now.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5081aa616093\",\"_type\":\"gwLogoWall\",\"logos\":[{\"height\":98,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/e502e13077ef08bcbdd72c97f41888788d4c89f7.svg\",\"width\":163},{\"height\":41,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/cb2f944cf68c061e93fd89e0e945d9dc6ad9451b.svg\",\"width\":364},{\"height\":92,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/125f1bbeeba2dd071e4d29160ce988ce475a6c92.svg\",\"width\":77},{\"height\":49,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/b7b374e1d48e34bd2d04b5db82fbbf816c4c9ac0.svg\",\"width\":357},{\"height\":109,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/0e988ed075586563cfe7ecb4c6f04a215f69a805.svg\",\"width\":206},{\"height\":67,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/e375ddf7101c99effad62d5fde8b7e631f29906b.svg\",\"width\":376},{\"height\":83,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/10fb0af0282a5b8ac130e37c7eb492d50de2f188.svg\",\"width\":245},{\"height\":54,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/a9324e63a4d9f05d31fa444e35b0c4111cf6b184.svg\",\"width\":375},{\"height\":84,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/70f5e7ac6a5eb1ee8f8c64dce2477b149d047406.svg\",\"width\":249},{\"height\":69,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/0fbd72b42c8a298814d5dc91f840994f788357cf.svg\",\"width\":321},{\"height\":61,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/3847c02b2ef37db2ce06dec416a4a9d797d7d9d7.svg\",\"width\":321},{\"height\":65,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/08c959c45e713396fddecb7c500319f9287be64e.svg\",\"width\":353}],\"markDefs\":null},{\"_key\":\"7e6e0d70a01d\",\"_type\":\"block\",\"children\":[{\"_key\":\"dacdecaf5899\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0ccdaf3d07ab\",\"_type\":\"gwHeaderIllustration\",\"image\":{\"height\":250,\"mimeType\":\"image/png\",\"url\":\"https://assets.claude.com/510e859d32fce0109359069afa2734b3ca8eb90b.png\",\"width\":250},\"markDefs\":null},{\"_key\":\"0a9df6fabd4a\",\"_type\":\"block\",\"children\":[{\"_key\":\"ea8e249f30ea\",\"_type\":\"span\",\"marks\":[],\"text\":\"Cybersecurity in the age of AI\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"a7862828ce38\",\"_type\":\"block\",\"children\":[{\"_key\":\"2c8dc350a73c\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c7cc8d8bad00\",\"_type\":\"block\",\"children\":[{\"_key\":\"553a73d9d3fc\",\"_type\":\"span\",\"marks\":[],\"text\":\"The software that all of us rely on every day—responsible for running banking systems, storing medical records, linking up logistics networks, keeping power grids functioning, and much more—has always contained bugs. Many are minor, but some are serious security flaws that, if discovered, could allow cyberattackers to hijack systems, disrupt operations, or steal data.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"bf2bbd183f5e\",\"_type\":\"block\",\"children\":[{\"_key\":\"d9c0b8d83ab4\",\"_type\":\"span\",\"marks\":[],\"text\":\"We have already seen the serious consequences of cyberattacks for important \"},{\"_key\":\"c33a74378aa6\",\"_type\":\"span\",\"marks\":[\"b6d9992e9f73\"],\"text\":\"corporate networks\"},{\"_key\":\"0cdd6a71a34c\",\"_type\":\"span\",\"marks\":[],\"text\":\", \"},{\"_key\":\"9fd73cc66a58\",\"_type\":\"span\",\"marks\":[\"96bce0ba0f75\"],\"text\":\"healthcare systems\"},{\"_key\":\"af1b69e67515\",\"_type\":\"span\",\"marks\":[],\"text\":\", \"},{\"_key\":\"5f8c174f83fb\",\"_type\":\"span\",\"marks\":[\"0fd92621e492\"],\"text\":\"energy infrastructure\"},{\"_key\":\"b1b187eb4708\",\"_type\":\"span\",\"marks\":[],\"text\":\", \"},{\"_key\":\"637ff55b02dc\",\"_type\":\"span\",\"marks\":[\"2dc87b500817\"],\"text\":\"transport hubs\"},{\"_key\":\"0f20223048f6\",\"_type\":\"span\",\"marks\":[],\"text\":\", and the information security of \"},{\"_key\":\"790eff9cc6cb\",\"_type\":\"span\",\"marks\":[\"067dba141fd8\"],\"text\":\"government\"},{\"_key\":\"f1813cd03cd7\",\"_type\":\"span\",\"marks\":[],\"text\":\" \"},{\"_key\":\"0b6724ae6048\",\"_type\":\"span\",\"marks\":[\"dca77b79ac62\"],\"text\":\"agencies\"},{\"_key\":\"8cc4e772d666\",\"_type\":\"span\",\"marks\":[],\"text\":\" \"},{\"_key\":\"0bfe753839d5\",\"_type\":\"span\",\"marks\":[\"fde0e9b2285b\"],\"text\":\"across\"},{\"_key\":\"b9bbdeb80ff0\",\"_type\":\"span\",\"marks\":[],\"text\":\" the world. On the global stage, state-sponsored attacks from actors like China, Iran, North Korea, and Russia have threatened to compromise the infrastructure that underpins both civilian life and military readiness. Even smaller-scale attacks, such as those where individual \"},{\"_key\":\"f5ff8b12bb48\",\"_type\":\"span\",\"marks\":[\"739e02f73744\"],\"text\":\"hospitals\"},{\"_key\":\"6a3ec0e56496\",\"_type\":\"span\",\"marks\":[],\"text\":\" or \"},{\"_key\":\"38da3b556f2e\",\"_type\":\"span\",\"marks\":[\"668a3fbe0412\"],\"text\":\"schools\"},{\"_key\":\"50a66761e640\",\"_type\":\"span\",\"marks\":[],\"text\":\" are targeted, can still inflict substantial economic damage, expose sensitive data, and even put lives at risk. The current global financial costs of cybercrime are challenging to estimate, but might be \"},{\"_key\":\"9fb2842db4b1\",\"_type\":\"span\",\"marks\":[\"4ec47244e6ff\"],\"text\":\"around $500B\"},{\"_key\":\"b129623c09d9\",\"_type\":\"span\",\"marks\":[],\"text\":\" every year.\"}],\"markDefs\":[{\"_key\":\"b6d9992e9f73\",\"_type\":\"link\",\"href\":\"https://cloud.google.com/blog/topics/threat-intelligence/oracle-ebusiness-suite-zero-day-exploitation\"},{\"_key\":\"96bce0ba0f75\",\"_type\":\"link\",\"href\":\"https://www.nao.org.uk/reports/investigation-wannacry-cyber-attack-and-the-nhs/\"},{\"_key\":\"0fd92621e492\",\"_type\":\"link\",\"href\":\"https://www.cisa.gov/news-events/news/attack-colonial-pipeline-what-weve-learned-what-weve-done-over-past-two-years\"},{\"_key\":\"2dc87b500817\",\"_type\":\"link\",\"href\":\"https://www.lawfaremedia.org/article/lessons-from-the-european-airports-ransomware-attack\"},{\"_key\":\"067dba141fd8\",\"_type\":\"link\",\"href\":\"https://www.reuters.com/world/us/hackers-solarwinds-breach-stole-data-us-sanctions-policy-intelligence-probes-2021-10-07/\"},{\"_key\":\"dca77b79ac62\",\"_type\":\"link\",\"href\":\"https://www.reuters.com/technology/cybersecurity/us-treasurys-workstations-hacked-cyberattack-by-china-afp-reports-2024-12-30/\"},{\"_key\":\"fde0e9b2285b\",\"_type\":\"link\",\"href\":\"https://lordslibrary.parliament.uk/cyber-security-and-the-uk-government/\"},{\"_key\":\"739e02f73744\",\"_type\":\"link\",\"href\":\"https://www.sciencedirect.com/science/article/pii/S2950386825000103\"},{\"_key\":\"668a3fbe0412\",\"_type\":\"link\",\"href\":\"https://www.vic.gov.au/cyber-incident-impacting-victorian-government-schools\"},{\"_key\":\"4ec47244e6ff\",\"_type\":\"link\",\"href\":\"https://www.governance.ai/research-paper/estimating-global-yearly-cybercrime-damage-costs\"}],\"style\":\"normal\"},{\"_key\":\"831b2edc1125\",\"_type\":\"block\",\"children\":[{\"_key\":\"b129623c09d9\",\"_type\":\"span\",\"marks\":[],\"text\":\"Many flaws in software go unnoticed for years because finding and exploiting them has required expertise held by only a few skilled security experts. With the latest frontier AI models, the cost, effort, and level of expertise required to find and exploit software vulnerabilities have all dropped dramatically. \"},{\"_key\":\"363c37341259\",\"_type\":\"span\",\"marks\":[\"552e70b3a155\"],\"text\":\"Over the past year\"},{\"_key\":\"39a081bf21d5\",\"_type\":\"span\",\"marks\":[],\"text\":\", AI models have become increasingly effective at reading and reasoning about code—in particular, they show a striking ability to spot \"},{\"_key\":\"d5ba0c5bcf50\",\"_type\":\"span\",\"marks\":[\"c10e147c36c6\"],\"text\":\"vulnerabilities\"},{\"_key\":\"c71ec50cc84c\",\"_type\":\"span\",\"marks\":[],\"text\":\" and work out ways to \"},{\"_key\":\"b839a224adad\",\"_type\":\"span\",\"marks\":[\"a5e4123619b1\"],\"text\":\"exploit\"},{\"_key\":\"b419f75872a5\",\"_type\":\"span\",\"marks\":[],\"text\":\" them. Claude Mythos Preview demonstrates a leap in these cyber skills—the vulnerabilities it has spotted have in some cases survived decades of human review and millions of automated security tests, and the exploits it develops are increasingly sophisticated.\"}],\"markDefs\":[{\"_key\":\"552e70b3a155\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/research/building-ai-cyber-defenders\"},{\"_key\":\"c10e147c36c6\",\"_type\":\"link\",\"href\":\"https://red.anthropic.com/2026/firefox/\"},{\"_key\":\"a5e4123619b1\",\"_type\":\"link\",\"href\":\"https://red.anthropic.com/2026/exploit/\"}],\"style\":\"normal\"},{\"_key\":\"43b5c6f93e3c\",\"_type\":\"block\",\"children\":[{\"_key\":\"b419f75872a5\",\"_type\":\"span\",\"marks\":[],\"text\":\"Ten years after the first \"},{\"_key\":\"7d8da31c371d\",\"_type\":\"span\",\"marks\":[\"030073854c1e\"],\"text\":\"DARPA Cyber Grand Challenge\"},{\"_key\":\"c2f1c6e9bf51\",\"_type\":\"span\",\"marks\":[],\"text\":\", frontier AI models are now becoming competitive with the best humans at finding and exploiting vulnerabilities. Without the \"},{\"_key\":\"2bfcc0bbaa48\",\"_type\":\"span\",\"marks\":[\"0ee79c2a09cf\"],\"text\":\"necessary safeguards\"},{\"_key\":\"47a2275b944f\",\"_type\":\"span\",\"marks\":[],\"text\":\", these powerful cyber capabilities could be used to exploit the many existing flaws in the world’s most important software. This could make cyberattacks of all kinds much more frequent and destructive, and empower adversaries of the United States and its allies. Addressing these issues is therefore an important security priority for democratic states.\"}],\"markDefs\":[{\"_key\":\"030073854c1e\",\"_type\":\"link\",\"href\":\"https://www.darpa.mil/research/programs/cyber-grand-challenge\"},{\"_key\":\"0ee79c2a09cf\",\"_type\":\"link\",\"href\":\"https://openai.com/index/strengthening-cyber-resilience/\"}],\"style\":\"normal\"},{\"_key\":\"582e345bceb7\",\"_type\":\"block\",\"children\":[{\"_key\":\"9a3268e1ccf6\",\"_type\":\"span\",\"marks\":[],\"text\":\"Although the risks from AI-augmented cyberattacks are serious, there is reason for optimism: the same capabilities that make AI models dangerous in the wrong hands make them invaluable for finding and fixing flaws in important software—and for producing new software with far fewer security bugs. Project Glasswing is an important step toward giving defenders a durable advantage in the coming AI-driven era of cybersecurity.\\n\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b9a6167b9800\",\"_type\":\"gwWideVideo\",\"autoplay\":false,\"embedUrl\":\"https://www.youtube.com/embed/INGOC6-LLv0\",\"loop\":false,\"muted\":false,\"showControls\":true,\"thumbnail\":{\"asset\":{\"url\":\"https://assets.claude.com/31c3e752a2a15a0406f69cbf4a76ed47f818cb9f.webm\"}},\"markDefs\":null,\"url\":null},{\"_key\":\"d7aefe8af81d\",\"_type\":\"block\",\"children\":[{\"_key\":\"6db8ddd51b3a\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5ae4b40714c0\",\"_type\":\"gwHeaderIllustration\",\"image\":{\"height\":250,\"mimeType\":\"image/png\",\"url\":\"https://assets.claude.com/1c8f5ce2d49c7f8eb2c615e14d06eb70131e96fe.png\",\"width\":250},\"markDefs\":null},{\"_key\":\"de2b692d33a0\",\"_type\":\"block\",\"children\":[{\"_key\":\"f5d9ebcb05ba\",\"_type\":\"span\",\"marks\":[],\"text\":\"Identifying vulnerabilities and exploits with Claude Mythos Preview\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"acceea110158\",\"_type\":\"block\",\"children\":[{\"_key\":\"7bcd3a2214d4\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"cec08111d90e\",\"_type\":\"block\",\"children\":[{\"_key\":\"0acdc62b9358\",\"_type\":\"span\",\"marks\":[],\"text\":\"Over the past few weeks, we have used Claude Mythos Preview to identify thousands of zero-day vulnerabilities (that is, flaws that were previously unknown to the software’s developers), many of them critical, in every major operating system and every major web browser, along with a range of other important pieces of software.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0efcbcdab966\",\"_type\":\"block\",\"children\":[{\"_key\":\"0eba6a4527a9\",\"_type\":\"span\",\"marks\":[],\"text\":\"In a post on our \"},{\"_key\":\"71ec33432fec\",\"_type\":\"span\",\"marks\":[\"c6edf4ac8424\"],\"text\":\"Frontier Red Team blog\"},{\"_key\":\"4466c2cee491\",\"_type\":\"span\",\"marks\":[],\"text\":\", we provide technical details for a subset of these vulnerabilities that have already been patched and, in some cases, the ways that Mythos Preview found to exploit them. It was able to identify nearly all of these vulnerabilities—and develop many related exploits—entirely autonomously, without any human steering. The following are three examples:\"}],\"markDefs\":[{\"_key\":\"c6edf4ac8424\",\"_type\":\"link\",\"blank\":true,\"href\":\"https://red.anthropic.com/2026/mythos-preview \"}],\"style\":\"normal\"},{\"_key\":\"5cce2a6aaf12\",\"_type\":\"block\",\"children\":[{\"_key\":\"236f90b91ac9\",\"_type\":\"span\",\"marks\":[],\"text\":\"Mythos Preview found a 27-year-old vulnerability in OpenBSD—which has a reputation as one of the most security-hardened operating systems in the world and is used to run firewalls and other critical infrastructure. The vulnerability allowed an attacker to remotely crash any machine running the operating system just by connecting to it;\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"bac0535d0344\",\"_type\":\"block\",\"children\":[{\"_key\":\"be19183e3a06\",\"_type\":\"span\",\"marks\":[],\"text\":\"It also discovered a 16-year-old vulnerability in FFmpeg—which is used by innumerable pieces of software to encode and decode video—in a line of code that automated testing tools had hit five million times without ever catching the problem;\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ff2d6c60753e\",\"_type\":\"block\",\"children\":[{\"_key\":\"96872e20925e\",\"_type\":\"span\",\"marks\":[],\"text\":\"The model autonomously found and chained together several vulnerabilities in the Linux kernel—the software that runs most of the world’s servers—to allow an attacker to escalate from ordinary user access to complete control of the machine.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b901971dcd83\",\"_type\":\"block\",\"children\":[{\"_key\":\"ebd5f89541b1\",\"_type\":\"span\",\"marks\":[],\"text\":\"We have reported the above vulnerabilities to the maintainers of the relevant software, and they have all now been patched. For many other vulnerabilities, we are providing a cryptographic hash of the details today (see the Red Team blog), and we will reveal the specifics after a fix is in place.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"79478baecb09\",\"_type\":\"block\",\"children\":[{\"_key\":\"aca189775a55\",\"_type\":\"span\",\"marks\":[],\"text\":\"Evaluation benchmarks such as CyberGym reinforce the substantial difference between Mythos Preview and our next-best model, Claude Opus 4.6:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"54b0da8726bd\",\"_type\":\"gwHorizontalBarGraphCarousel\",\"slides\":[{\"label\":null,\"footnote\":null,\"barGroups\":[{\"description\":\"CyberGym\",\"bars\":[{\"label\":\"Mythos Preview\",\"value\":83.1,\"color\":null,\"highlighted\":true,\"crosshatch\":false},{\"label\":\"Opus 4.6\",\"value\":66.6,\"color\":null,\"highlighted\":false,\"crosshatch\":true}]}]}],\"title\":\"Cybersecurity Vulnerability Reproduction\",\"markDefs\":null},{\"_key\":\"4100a1fe52b1\",\"_type\":\"block\",\"children\":[{\"_key\":\"f9acf5fae41f\",\"_type\":\"span\",\"marks\":[],\"text\":\"In addition to our own work, many of our partners have already been using Claude Mythos Preview for several weeks. This is what they’ve found:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"da3c4fa598b7\",\"_type\":\"gwQuoteCarousel\",\"quotes\":[{\"quote\":\"AI capabilities have crossed a threshold that fundamentally changes the urgency required to protect critical infrastructure from cyber threats, and there is no going back. Our foundational work with these models has shown we can identify and fix security vulnerabilities across hardware and software at a pace and scale previously impossible. That is a profound shift, and a clear signal that the old ways of hardening systems are no longer sufficient. \\n\\nProviders of technology must aggressively adopt new approaches now, and customers need to be ready to deploy. That is why Cisco joined Project Glasswing—this work is too important and too urgent to do alone.\",\"speakerName\":\"Anthony Grieco\",\"speakerTitle\":\"SVP \u0026 Chief Security \u0026 Trust Officer, Cisco\",\"logo\":{\"height\":109,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/0e988ed075586563cfe7ecb4c6f04a215f69a805.svg\",\"width\":206},\"ctaLabel\":\"Read announcement\",\"ctaUrl\":\"https://blogs.cisco.com/news/rising-to-the-era-of-ai-powered-cyber-defense\"},{\"quote\":\"At AWS, we build defenses before threats emerge, from our custom silicon up through the technology stack. Security isn't a phase for us; it's continuous and embedded in everything we do. Our teams analyze over 400 trillion network flows every day for threats, and AI is central to our ability to defend at scale.\\n \\nWe've been testing Claude Mythos Preview in our own security operations, applying it to critical codebases, where it's already helping us strengthen our code. We're bringing deep security expertise to our partnership with Anthropic and are helping to harden Claude Mythos Preview so even more organizations can advance their most ambitious work with security that sets the standard.\",\"speakerName\":\"Amy Herzog\",\"speakerTitle\":\"Vice President and CISO, Amazon Web Services\",\"logo\":{\"height\":98,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/e502e13077ef08bcbdd72c97f41888788d4c89f7.svg\",\"width\":163},\"ctaLabel\":\"Read announcement\",\"ctaUrl\":\"https://aws.amazon.com/blogs/security/building-ai-defenses-at-scale-before-the-threats-emerge\"},{\"quote\":\"As we enter a phase where cybersecurity is no longer bound by purely human capacity, the opportunity to use AI responsibly to improve security and reduce risk at scale is unprecedented. Joining Project Glasswing, with access to Claude Mythos Preview, allows us to identify and mitigate risk early and augment our security and development solutions so we can better protect customers and Microsoft. \\n\\nWhen tested against CTI-REALM, our open-source security benchmark, Claude Mythos Preview showed substantial improvements compared to previous models. We look forward to partnering with Anthropic and the broader industry to improve security outcomes for all.\",\"speakerName\":\"Igor Tsyganskiy\",\"speakerTitle\":\"EVP of Cybersecurity and Microsoft Research, Microsoft\",\"logo\":{\"height\":69,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/0fbd72b42c8a298814d5dc91f840994f788357cf.svg\",\"width\":321},\"ctaLabel\":\"Read announcement\",\"ctaUrl\":\"https://www.microsoft.com/en-us/msrc/blog/2026/04/strengthening-secure-software-global-scale-how-msrc-is-evolving-with-ai\"},{\"quote\":\"The window between a vulnerability being discovered and being exploited by an adversary has collapsed—what once took months now happens in minutes with AI. \\n\\nClaude Mythos Preview demonstrates what is now possible for defenders at scale, and adversaries will inevitably look to exploit the same capabilities. That is not a reason to slow down; it’s a reason to move together, faster. If you want to deploy AI, you need security. That is why CrowdStrike is part of this effort from day one.\",\"speakerName\":\"Elia Zaitsev\",\"speakerTitle\":\"Chief Technology Officer, CrowdStrike\",\"logo\":{\"height\":67,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/e375ddf7101c99effad62d5fde8b7e631f29906b.svg\",\"width\":376},\"ctaLabel\":\"Read announcement\",\"ctaUrl\":\"https://www.crowdstrike.com/en-us/blog/crowdstrike-founding-member-anthropic-mythos-frontier-model-to-secure-ai/\"},{\"quote\":\"In the past, security expertise has been a luxury reserved for organizations with large security teams. Open source maintainers—whose software underpins much of the world’s critical infrastructure—have historically been left to figure out security on their own. Open source software constitutes the vast majority of code in modern systems, including the very systems AI agents use to write new software. \\n\\nBy giving the maintainers of these critical open source codebases access to a new generation of AI models that can proactively identify and fix vulnerabilities at scale, Project Glasswing offers a credible path to changing that equation. This is how AI-augmented security can become a trusted sidekick for every maintainer, not just those who can afford expensive security teams.\",\"speakerName\":\"Jim Zemlin\",\"speakerTitle\":\"CEO, The Linux Foundation\",\"logo\":{\"height\":84,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/70f5e7ac6a5eb1ee8f8c64dce2477b149d047406.svg\",\"width\":249},\"ctaLabel\":\"Read announcement\",\"ctaUrl\":\"https://www.linuxfoundation.org/blog/project-glasswing-gives-maintainers-advanced-ai-to-secure-open-source\"},{\"quote\":\"Promoting the cybersecurity and resiliency of the financial system is central to JPMorganChase's mission, and we believe the industry is strongest when leading institutions work together on shared challenges. Project Glasswing provides a unique, early stage opportunity to evaluate next-generation AI tools for defensive cybersecurity across critical infrastructure both on our own terms and alongside respected technology leaders.\\n\\nWe will take a rigorous, independent approach to determining how to proceed and where we can help. Anthropic's initiative reflects the kind of forward-looking, collaborative approach that this moment demands.\",\"speakerName\":\"Pat Opet\",\"speakerTitle\":\"Chief Information Security Officer, JPMorganChase\",\"logo\":{\"height\":54,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/a9324e63a4d9f05d31fa444e35b0c4111cf6b184.svg\",\"width\":375},\"ctaLabel\":null,\"ctaUrl\":null},{\"quote\":\"Google is pleased to see this cross-industry cybersecurity initiative coming together and to make Mythos Preview available to participants via Vertex AI. It's always been critical that the industry work together on emerging security issues, whether it's post-quantum cryptography, responsible zero-day disclosure, secure open source software, or defense against AI-based attacks.\\n\\nWe have long believed that AI poses new challenges and opens new opportunities in cyber defense, which is why we've built AI-powered tools—such as Big Sleep and CodeMender—to find and fix critical software flaws. We will continue investing in our leading cybersecurity platform and a culture focused on protecting users, customers, the ecosystem, and national security.\",\"speakerName\":\"Heather Adkins\",\"speakerTitle\":\"VP of Security Engineering, Google\",\"logo\":{\"height\":83,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/10fb0af0282a5b8ac130e37c7eb492d50de2f188.svg\",\"width\":245},\"ctaLabel\":\"Read announcement\",\"ctaUrl\":\"https://cloud.google.com/blog/products/ai-machine-learning/claude-mythos-preview-on-vertex-ai\"},{\"quote\":\"Over the past few weeks, we’ve had access to the Claude Mythos Preview model, using it to identify complex vulnerabilities that prior-generation models missed entirely. This is not only a game changer for finding previously hidden vulnerabilities, but it also signals a dangerous shift where attackers can soon find even more zero-day vulnerabilities and develop exploits faster than ever before.\\n\\nIt’s clear that these models need to be in the hands of open source owners and defenders everywhere to find and fix these vulnerabilities before attackers get access. Perhaps even more important: everyone needs to prepare for AI-assisted attackers. There will be more attacks, faster attacks, and more sophisticated attacks. Now is the time to modernize cybersecurity stacks everywhere. We commend Anthropic for partnering with the industry to ensure these powerful capabilities prioritize defense first.\",\"speakerName\":\"Lee Klarich\",\"speakerTitle\":\"Chief Product \u0026 Technology Officer, Palo Alto Networks\",\"logo\":{\"height\":65,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/08c959c45e713396fddecb7c500319f9287be64e.svg\",\"width\":353},\"ctaLabel\":\"Read announcement\",\"ctaUrl\":\"https://www.paloaltonetworks.com/perspectives/weaponized-intelligence/\"}],\"markDefs\":null},{\"_key\":\"9391889455b4\",\"_type\":\"block\",\"children\":[{\"_key\":\"6247dc825771\",\"_type\":\"span\",\"marks\":[],\"text\":\"The powerful cyber capabilities of Claude Mythos Preview are a result of its strong agentic coding and reasoning skills. For example, as shown in the evaluation results below, the model has the highest scores of any model yet developed on a variety of software coding tasks.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3e7055e7f264\",\"_type\":\"gwHorizontalBarGraphCarousel\",\"slides\":[{\"label\":\"Agentic coding\",\"footnote\":\"• SWE-bench Verified, Pro, and Multilingual: Our memorization screens flag a subset of problems in these SWE-bench evals. Excluding any problems that show signs of memorization, Mythos Preview’s margin of improvement over Opus 4.6 holds.\\n• SWE-bench Multimodal: We used an internal implementation for both Mythos Preview and Opus 4.6. Scores are not directly comparable to public leaderboard scores.\\n• Terminal-Bench 2.0: We used the Terminus-2 harness with adaptive thinking at maximum effort and a total task budget of 1 million tokens for each task. All experiments used 1× guaranteed/3× ceiling resource allocation averaged over five attempts per task. Mythos Preview scored 92.1% when we increased timeout limits to four hours and used the Terminal-Bench 2.1 updates.\",\"barGroups\":[{\"description\":\"SWE-bench Pro\",\"bars\":[{\"label\":\"Mythos Preview\",\"value\":77.8,\"color\":\"#FAF9F5\",\"highlighted\":true,\"crosshatch\":false},{\"label\":\"Opus 4.6\",\"value\":53.4,\"color\":null,\"highlighted\":false,\"crosshatch\":true}]},{\"description\":\"Terminal-Bench 2.0\",\"bars\":[{\"label\":\"Mythos Preview\",\"value\":82,\"color\":\"#FAF9F5\",\"highlighted\":true,\"crosshatch\":false},{\"label\":\"Opus 4.6\",\"value\":65.4,\"color\":null,\"highlighted\":false,\"crosshatch\":true}]},{\"description\":\"SWE-bench Multimodal (internal implementation)\",\"bars\":[{\"label\":\"Mythos Preview\",\"value\":59,\"color\":\"#FAF9F5\",\"highlighted\":true,\"crosshatch\":false},{\"label\":\"Opus 4.6\",\"value\":27.1,\"color\":null,\"highlighted\":false,\"crosshatch\":true}]},{\"description\":\"SWE-bench Multilingual\",\"bars\":[{\"label\":\"Mythos Preview\",\"value\":87.3,\"color\":\"#FAF9F5\",\"highlighted\":true,\"crosshatch\":false},{\"label\":\"Opus 4.6\",\"value\":77.8,\"color\":null,\"highlighted\":false,\"crosshatch\":true}]},{\"description\":\"SWE-bench Verified\",\"bars\":[{\"label\":\"Mythos Preview\",\"value\":93.9,\"color\":\"#FAF9F5\",\"highlighted\":true,\"crosshatch\":false},{\"label\":\"Opus 4.6\",\"value\":80.8,\"color\":null,\"highlighted\":false,\"crosshatch\":true}]}]},{\"label\":\"Reasoning\",\"footnote\":\"Humanity’s Last Exam: We have found Mythos still performs well on HLE at low effort, which could indicate some level of memorization.\",\"barGroups\":[{\"description\":\"GPQA Diamond\",\"bars\":[{\"label\":\"Mythos Preview\",\"value\":94.6,\"color\":\"#FAF9F5\",\"highlighted\":true,\"crosshatch\":false},{\"label\":\"Opus 4.6\",\"value\":91.3,\"color\":null,\"highlighted\":false,\"crosshatch\":true}]},{\"description\":\"Humanity’s Last Exam\",\"bars\":[{\"label\":\"Mythos Preview without tools\",\"value\":56.8,\"color\":\"#FAF9F5\",\"highlighted\":true,\"crosshatch\":false},{\"label\":\"Opus 4.6 without tools\",\"value\":40,\"color\":null,\"highlighted\":false,\"crosshatch\":true},{\"label\":\"Mythos Preview with tools\",\"value\":64.7,\"color\":\"#FAF9F5\",\"highlighted\":true,\"crosshatch\":false},{\"label\":\"Opus 4.6 with tools\",\"value\":53.1,\"color\":null,\"highlighted\":false,\"crosshatch\":true}]}]},{\"label\":\"Agentic search and computer use\",\"footnote\":\"BrowseComp: Claude Mythos Preview scores higher than Opus 4.6 while using 4.9× fewer tokens.\",\"barGroups\":[{\"description\":\"BrowseComp\",\"bars\":[{\"label\":\"Mythos Preview\",\"value\":86.9,\"color\":\"#FAF9F5\",\"highlighted\":true,\"crosshatch\":false},{\"label\":\"Opus 4.6\",\"value\":83.7,\"color\":null,\"highlighted\":false,\"crosshatch\":true}]},{\"description\":\"OSWorld-Verified\",\"bars\":[{\"label\":\"Mythos Preview\",\"value\":79.6,\"color\":\"#FAF9F5\",\"highlighted\":true,\"crosshatch\":false},{\"label\":\"Opus 4.6\",\"value\":72.7,\"color\":null,\"highlighted\":false,\"crosshatch\":true}]}]}],\"markDefs\":null},{\"_key\":\"feb19b6432c3\",\"_type\":\"block\",\"children\":[{\"_key\":\"4bbbe440dc34\",\"_type\":\"span\",\"marks\":[],\"text\":\"More information on the model’s capabilities, its safety properties, and its general characteristics can be found in the \"},{\"_key\":\"da72a266e0f7\",\"_type\":\"span\",\"marks\":[\"fe47f6977db1\"],\"text\":\"Claude Mythos Preview system card\"},{\"_key\":\"3ad4f4c19898\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"fe47f6977db1\",\"_type\":\"link\",\"blank\":true,\"href\":\"https://anthropic.com/claude-mythos-preview-system-card\"}],\"style\":\"normal\"},{\"_key\":\"389390f906dd\",\"_type\":\"block\",\"children\":[{\"_key\":\"59b043bf4f11\",\"_type\":\"span\",\"marks\":[],\"text\":\"We do not plan to make Claude Mythos Preview generally available, but our eventual goal is to enable our users to safely deploy Mythos-class models at scale—for cybersecurity purposes, but also for the myriad other benefits that such highly capable models will bring. To do so, we need to make progress in developing cybersecurity (and other) safeguards that detect and block the model’s most dangerous outputs. We plan to launch new safeguards with an upcoming Claude Opus model, allowing us to improve and refine them with a model that does not pose the same level of risk as Mythos Preview\"},{\"_key\":\"bd1feaa24933\",\"_type\":\"span\",\"marks\":[\"sup\"],\"text\":\"3\"},{\"_key\":\"96efcc4447f5\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"bdf98cca5337\",\"_type\":\"block\",\"children\":[{\"_key\":\"3adf6f734289\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"13079c9f1946\",\"_type\":\"block\",\"children\":[{\"_key\":\"26786a911cf6\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"86b38f9502c2\",\"_type\":\"gwHeaderIllustration\",\"image\":{\"height\":250,\"mimeType\":\"image/png\",\"url\":\"https://assets.claude.com/c22ac01f7f4b8d2e963a5958d2f8dc7565cd9c8d.png\",\"width\":250},\"markDefs\":null},{\"_key\":\"e92c90c2cfc8\",\"_type\":\"block\",\"children\":[{\"_key\":\"5f7f82657c5b\",\"_type\":\"span\",\"marks\":[],\"text\":\"Plans for Project Glasswing\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"2d1c6120dbc8\",\"_type\":\"block\",\"children\":[{\"_key\":\"942879863c2f\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d06ef9507a5a\",\"_type\":\"block\",\"children\":[{\"_key\":\"db7ea32d98d0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Today’s announcement is the beginning of a longer-term effort. To be successful, it will require broad involvement from across the technology industry and beyond.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d6c73553c081\",\"_type\":\"block\",\"children\":[{\"_key\":\"1f4dc16c272e\",\"_type\":\"span\",\"marks\":[],\"text\":\"Project Glasswing partners will receive access to Claude Mythos Preview to find and fix vulnerabilities or weaknesses in their foundational systems—systems that represent a very large portion of the world’s shared cyberattack surface. We anticipate this work will focus on tasks like local vulnerability detection, black box testing of binaries, securing endpoints, and penetration testing of systems.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6af1f22a340f\",\"_type\":\"block\",\"children\":[{\"_key\":\"87a9db22904f\",\"_type\":\"span\",\"marks\":[],\"text\":\"Anthropic’s commitment of $100M in model usage credits to Project Glasswing and additional participants will cover substantial usage throughout this research preview. Afterward, Claude Mythos Preview will be available to participants at $25/$125 per million input/output tokens (participants can access the model on the Claude API, Amazon Bedrock, Google Cloud’s Vertex AI, and Microsoft Foundry).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8ac6f667ef97\",\"_type\":\"block\",\"children\":[{\"_key\":\"6b0e33f04fbe\",\"_type\":\"span\",\"marks\":[],\"text\":\"In addition to our commitment of model usage credits, we’ve donated $2.5M to Alpha-Omega and OpenSSF through the Linux Foundation, and $1.5M to the Apache Software Foundation to enable the maintainers of open-source software to respond to this changing landscape (maintainers interested in access can apply through the \"},{\"_key\":\"697e8cde37d4\",\"_type\":\"span\",\"marks\":[\"43794c20006b\"],\"text\":\"Claude for Open Source\"},{\"_key\":\"ca34080dcba5\",\"_type\":\"span\",\"marks\":[],\"text\":\" program).\"}],\"markDefs\":[{\"_key\":\"43794c20006b\",\"_type\":\"link\",\"href\":\"https://claude.com/contact-sales/claude-for-oss\"}],\"style\":\"normal\"},{\"_key\":\"87a2123dd3e6\",\"_type\":\"block\",\"children\":[{\"_key\":\"bf8ba70c3a86\",\"_type\":\"span\",\"marks\":[],\"text\":\"We intend for this work to grow in scope and continue for many months, and we’ll share as much as we can so that other organizations can apply the lessons to their own security. Partners will, to the extent they’re able, share information and best practices with each other; within 90 days, Anthropic will report publicly on what we’ve learned, as well as the vulnerabilities fixed and improvements made that can be disclosed. We will also collaborate with leading security organizations to produce a set of practical recommendations for how security practices should evolve in the AI era. This will potentially include:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"65ed45ac2603\",\"_type\":\"block\",\"children\":[{\"_key\":\"4de6b36b3bd6\",\"_type\":\"span\",\"marks\":[],\"text\":\"Vulnerability disclosure processes;\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"bbc7b5733289\",\"_type\":\"block\",\"children\":[{\"_key\":\"15c83649880f\",\"_type\":\"span\",\"marks\":[],\"text\":\"Software update processes;\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2df4fc2c44a6\",\"_type\":\"block\",\"children\":[{\"_key\":\"567dfdbcc135\",\"_type\":\"span\",\"marks\":[],\"text\":\"Open-source and supply-chain security;\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4f03678ef888\",\"_type\":\"block\",\"children\":[{\"_key\":\"e7b678d4531b\",\"_type\":\"span\",\"marks\":[],\"text\":\"Software development lifecycle and secure-by-design practices;\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a96c0ca79f0b\",\"_type\":\"block\",\"children\":[{\"_key\":\"5909d8fd09ca\",\"_type\":\"span\",\"marks\":[],\"text\":\"Standards for regulated industries;\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"fb5a15da9ffd\",\"_type\":\"block\",\"children\":[{\"_key\":\"611c1910b3cb\",\"_type\":\"span\",\"marks\":[],\"text\":\"Triage scaling and automation; and\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2ef93af3243d\",\"_type\":\"block\",\"children\":[{\"_key\":\"e27ad646b173\",\"_type\":\"span\",\"marks\":[],\"text\":\"Patching automation.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7ce92b26156d\",\"_type\":\"block\",\"children\":[{\"_key\":\"3b9c5680b8d9\",\"_type\":\"span\",\"marks\":[],\"text\":\"Anthropic has also been in ongoing discussions with US government officials about Claude Mythos Preview and its offensive and defensive cyber capabilities. As we noted above, securing critical infrastructure is a top national security priority for democratic countries—the emergence of these cyber capabilities is another reason why the US and its allies must maintain a decisive lead in AI technology. Governments have an essential role to play in helping maintain that lead, and in both assessing and mitigating the national security risks associated with AI models. We are ready to work with local, state, and federal representatives to assist in these tasks.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"fd6f2a072ab7\",\"_type\":\"block\",\"children\":[{\"_key\":\"4dd545ccad96\",\"_type\":\"span\",\"marks\":[],\"text\":\"We are hopeful that Project Glasswing can seed a larger effort across industry and the public sector, with all parties helping to address the biggest questions around the impact of powerful models on security. We invite other AI industry members to join us in helping to set the standards for the industry. In the medium term, an independent, third-party body—one that can bring together private- and public-sector organizations—might be the ideal home for continued work on these large-scale cybersecurity projects.\"}],\"markDefs\":[],\"style\":\"normal\"}]}],\"$L5c\"]}]\ne:null\n14:[[\"$\",\"title\",\"0\",{\"children\":\"Project Glasswing: Securing critical software for the AI era \\\\ Anthropic\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"A new initiative to secure the world’s most critical software and give defenders a durable advantage in the coming AI-driven era of cybersecurity.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"msapplication-TileColor\",\"content\":\"141413\"}],[\"$\",\"meta\",\"3\",{\"name\":\"msapplication-config\",\"content\":\"/browserconfig.xml\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://www.anthropic.com/glasswing\"}],[\"$\",\"meta\",\"5\",{\"name\":\"google-site-verification\",\"content\":\"BqiAW_sWOg-KrPk-Accxm6ge9dtnFEyV6DB6vzVZSGs\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:title\",\"content\":\"Project Glasswing: Securing critical software for the AI era\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:description\",\"content\":\"A new initiative to secure the world’s most critical software and give defenders a durable advantage in the coming AI-driven era of cybersecurity.\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:url\",\"content\":\"https://www.anthropic.com/glasswing\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:image\",\"content\":\"https://assets.claude.com/65641e7846f10255c4a3415a10bbf5793ae87b13.jpg\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:image:alt\",\"content\":\"Anthropic logo\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:site\",\"content\":\"@AnthropicAI\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:creator\",\"content\":\"@AnthropicAI\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:title\",\"content\":\"Project Glasswing: Securing critical software for the AI era\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:description\",\"content\":\"A new initiative to secure the world’s most critical software and give defenders a durable advantage in the coming AI-driven era of cybersecurity.\"}],[\"$\",\"meta\",\"17\",{\"name\":\"twitter:image\",\"content\":\"https://assets.claude.com/65641e7846f10255c4a3415a10bbf5793ae87b13.jpg\"}],[\"$\",\"meta\",\"18\",{\"name\":\"twitter:image:alt\",\"content\":\"Anthropic logo\"}],[\"$\",\"link\",\"19\",{\"rel\":\"shortcut icon\",\"href\":\"/favicon.ico\"}],[\"$\",\"link\",\"20\",{\"rel\":\"icon\",\"href\":\"/images/icons/favicon-32x32.png\"}],[\"$\",\"link\",\"21\",{\"rel\":\"apple-touch-icon\",\"href\":\"/images/icons/apple-touch-icon.png\"}],[\"$\",\"link\",\"22\",{\"rel\":\"apple-touch-icon\",\"href\":\"/images/icons/apple-touch-icon.png\",\"sizes\":\"180x180\"}],[\"$\",\"link\",\"23\",{\"rel\":\"mask-icon\",\"href\":\"/images/icons/safari-pinned-tab.svg\",\"color\":\"141413\"}],[\"$\",\"$L5d\",\"24\",{}]]\n"])</script><script>self.__next_f.push([1,"5c:[\"$\",\"section\",null,{\"id\":\"appendix\",\"className\":\"gbtCqG_appendix\",\"children\":[\"$\",\"div\",null,{\"className\":\"gbtCqG_inner\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"gbtCqG_title\",\"children\":\"APPENDIX\"}],[\"$\",\"div\",null,{\"className\":\"gbtCqG_content\",\"children\":[[\"$\",\"ol\",\"52b524d1d92a-parent\",{\"className\":\"YX8MMq_list body-2\",\"children\":[[\"$\",\"li\",\"52b524d1d92a\",{\"children\":[\"The project is named for the glasswing butterfly, \",[\"$\",\"a\",\"85e91da07452\",{\"href\":\"https://en.wikipedia.org/wiki/Greta_oto\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"children\":[[\"$\",\"em\",\"85e91da07452\",{\"children\":[\"Greta oto\"]}]]}],\". The metaphor can be applied in two ways: the butterfly’s transparent wings let it hide in plain sight, much like the vulnerabilities discussed in this post; they also allow it to evade harm—like the transparency we’re advocating for in our approach.\"]}],[\"$\",\"li\",\"1de9fdd14f05\",{\"children\":[\"From the Ancient Greek for “utterance” or “narrative”: the system of stories through which civilizations made sense of the world.\"]}],[\"$\",\"li\",\"cecbf030c5d1\",{\"children\":[\"Security professionals whose legitimate work is affected by these safeguards will be able to apply to an upcoming Cyber Verification Program.\"]}]]}]]}]]}]}]\n"])</script></body></html>