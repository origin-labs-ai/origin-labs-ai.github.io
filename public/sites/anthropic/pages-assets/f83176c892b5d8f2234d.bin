<!-- Sticky Nav -->
<style>
  .navbar-wr {
    width: 100%;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }
  .nav-fixed {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999;
  }
  .nav-hidden {
    transform: translateY(-110%);
  }
  /* place nav off-screen instantly so it can slide in (no snap) */
  .nav-no-transition {
    transition: none !important;
  }
</style>

<!-- Sticky Nav -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const nav = document.querySelector(".navbar-wr, .biorender-system-project--navbar-wr");
    if (!nav) return;

    const banner = document.querySelector(".top-banner"); // null on pages without it

    // Reserves the nav's height when it goes fixed, so the page doesn't jump.
    const spacer = document.createElement("div");
    spacer.style.display = "none";
    nav.parentNode.insertBefore(spacer, nav.nextSibling);

    let lastScrollY = window.scrollY;
    let pinned = false;
    let ticking = false;
    const threshold = 10;

    const navOffset = () =>
      banner && banner.offsetParent !== null ? banner.offsetHeight : 0;

    const pin = () => {
      const h = nav.offsetHeight;
      nav.style.setProperty("--nav-h", h + "px");
      spacer.style.height = h + "px";
      spacer.style.display = "block";          // hold the layout open

      nav.classList.add("nav-no-transition", "nav-fixed", "nav-hidden");
      void nav.offsetHeight;                   // commit off-screen start state
      nav.classList.remove("nav-no-transition", "nav-hidden"); // slide down in
      pinned = true;
    };

    const reset = () => {
      nav.classList.remove("nav-fixed", "nav-hidden", "nav-no-transition");
      spacer.style.display = "none";
      pinned = false;
    };

    const onScroll = () => {
      ticking = false;
      const currentY = window.scrollY;
      const offset = navOffset();

      if (currentY <= offset) {
        if (pinned) reset();
        lastScrollY = currentY;
        return;
      }

      const diff = currentY - lastScrollY;
      if (Math.abs(diff) < threshold) return; // ignore micro-scroll

      if (diff > 0) {
        if (pinned) nav.classList.add("nav-hidden");   // scroll down → slide up & away
      } else {
        if (!pinned) pin();                            // scroll up → slide down in
        else nav.classList.remove("nav-hidden");
      }

      lastScrollY = currentY;
    };

    window.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    }, { passive: true });
  });
</script><!-- SELECT DROPDOWN SCROLL -->
<script>
document.addEventListener("DOMContentLoaded", function () {
