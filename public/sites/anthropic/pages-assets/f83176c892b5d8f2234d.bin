<!-- IP Address Listener -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  var fields = document.querySelectorAll('input[name="ip-address"]');
  if (!fields.length) return;

  fetch('https://api.ipify.org?format=json')
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (!data || !data.ip) return;
      fields.forEach(function (field) { field.value = data.ip; });
    })
    .catch(function () { /* leave blank if lookup fails */ });
});
</script>

<!-- STYLES -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css"/>

<style>

/* ============================================
   GRANT AWARD
   ============================================ */
@media screen and (max-width: 1024px) {
  .grant-award-item {
    width: 1024px;
  }
}


/* ============================================
   NUCLEI SLIDER
   ============================================ */
.slider-container {
  position: relative;
}

.nuclei-slider {
  overflow: visible !important;
}

.nuclei-slider .slick-list {
  overflow: visible !important;
}

.nuclei-slider .slick-slide {
  margin: 0 22px;
}

.slick-center {
  opacity: 1 !important;
}

@media screen and (min-width: 1025px) {
  .slick-center {
    transform: scale(1) !important;
  }
}

@media screen and (max-width: 479px) {
  .slider-container.nuclei {
    max-width: 450px !important;
  }
}


/* ============================================
   NUCLEI SLIDER ARROWS
   ============================================ */
.slider-arrows {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 10;
}

.slider-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: all;
}

.slick-prev {
  left: 0 !important;
}

.slick-next {
  right: 0 !important;
  transform: translateY(-50%) rotate(180deg) !important;
}

/* ============================================
   TEMPLATES SLIDER
   ============================================ */
.home-slider-container {
  overflow: visible !important;
}

.home-slider-container .slick-list {
  overflow: visible !important;
}

.templates-slider-list .slick-slide {
  margin: 0 12px;
}


/* ============================================
   LOGO CAROUSEL
   ============================================ */
.collection-list-21 {
  display: flex;
  flex-wrap: nowrap;
  width: max-content;
  animation: logo-scroll 30s linear infinite;
}

.collection-list-21:hover {
  animation-play-state: paused;
}

@keyframes logo-scroll {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}


/* ============================================
   ACTIVE NAV PILL
   ============================================ */
.slider-item-wr.active {
  background-image: linear-gradient(90deg, #9e6ae0, #288bfb);
}


/* ============================================
   MOBILE - Hide arrows, show dots
   ============================================ */
@media screen and (max-width: 767px) {
  section#winners {
    padding-left: 0;
    padding-right: 0;
}
.slider-items {
  margin: 0 20px;
}
  /* Hide arrows */
  .slider-arrows {
    display: none !important;
  }
  .splide__arrow--prev,
  .splide__arrow--next {
    display: none !important;
  }

  /* Nuclei - show 20px peek of prev/next */
  .nuclei-slider {
    overflow: visible !important;
  }
  .nuclei-slider .slick-list {
    overflow: hidden !important;
    padding: 0 20px !important;
  }
  .nuclei-slider .slick-slide {
    margin: 0 6px !important;
  }

  /* Fix height jumping */
  .nuclei-slider .slick-track {
    display: flex !important;
  }
  .nuclei-slider .slick-slide {
    height: auto;
    display: flex !important;
    align-items: stretch;
  }
  .nuclei-slider .slick-slide > div {
    width: 100%;
  }

  /* Templates slide margin */
  .templates-slider-list .slick-slide {
    margin: 0 10px;
  }

  /* Center image vertically in templates slide */
  .templates-slider-list .slick-slide {
    display: flex !important;
    align-items: center;
    justify-content: center;
  }

  /* Dot styling to match Figma */
  .slick-dots {
    display: flex !important;
    flex-wrap: wrap !important;
    justify-content: center;
    gap: 8px;
    padding: 16px 0 0;
    list-style: none;
    max-width: 95%;
    margin: 0 auto !important;
    position: relative !important;
    bottom: auto !important;
  }

  .slick-dots li button {
    font-size: 0;
    width: 12px !important;
    height: 12px !important;
    border-radius: 100px;
    border: 1.5px solid #d0d5e0;
    background: transparent;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .slick-dots li.slick-active button {
    background: #0073DF;
    border-color: transparent;
  }
}

</style></head><body><div class="page-wrap"><div class="page-code w-embed"><style>
.biorender-system-project--heading,
.biorender-system-project--paragraph {
 margin: 0 !important; 
}

.flex-column.text-left-align.max-500 {
  gap: 1.25rem;
}
</style></div><div class="page-code w-embed w-script"><style>

/* =========================================================
   ACADEMIA + INDUSTRY — SHARED FORM STYLES
   ========================================================= */


/* =========================================================
   FLOATING LABELS
   ========================================================= */

.form-field-wr {
  position: relative;
}

.form-label {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 1rem;
  line-height: 1;
  color: #4F5763;
  pointer-events: none;
  transition:
    top 0.2s ease,
    transform 0.2s ease,
    font-size 0.2s ease,
    color 0.2s ease;
}


/* Float label when input is focused or has a value */

.form-input:focus + .form-label,
.form-input:not(:placeholder-shown) + .form-label {
  top: 7px;
  transform: none;
  font-size: 0.75rem;
  color: #B5BDC7;
}


/* Keep label floated when the field has an error */

.form-input.error + .form-label {
  top: 7px;
  transform: none;
  font-size: 0.75rem;
  color: var(--_color-semantic---error--error);
}


/* Keep label floated when Chrome autofills the field */

.form-input:-webkit-autofill + .form-label {
  top: 7px;
  transform: none;
  font-size: 0.75rem;
}


/* =========================================================
   INPUTS
   ========================================================= */

.form-input {
  background-color: #FFFFFF;
  color: #4F5763;
}

.form-input::placeholder {
  color: transparent;
}


/* =========================================================
   AUTOFILL
   ========================================================= */

.form-input:-webkit-autofill,
.form-input:-webkit-autofill:hover,
.form-input:-webkit-autofill:focus {
  -webkit-text-fill-color: #4F5763;
  -webkit-box-shadow: 0 0 0px 1000px #FFFFFF inset;
  box-shadow: 0 0 0px 1000px #FFFFFF inset;
}


/* =========================================================
   ERROR STATE
   ========================================================= */

.form-input.error {
  border: 2px solid var(--_color-semantic---error--error);
  box-shadow:
    0 0 0 0.5px var(--_color-semantic---error--error);
}


/* Error message */

.field-error {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 6px;
  color: var(--_color-semantic---error--error);
  font-size: 12px;
  line-height: 130%;
}


/* Error icon is created with CSS.
   The JavaScript does NOT inject an <img>. */

.field-error::before {
  content: "";
  flex: 0 0 14px;
  width: 14px;
  height: 14px;
  background-image: url("https://cdn.prod.website-files.com/621e6f1effebfe03881da9bd/6a46c0b94759d626e6281fe8_error-message.svg");
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}


/* =========================================================
   CUSTOM SELECT ERROR
   ========================================================= */

.form-input.dropdown.error {
  border: 2px solid var(--_color-semantic---error--error);
  box-shadow:
    0 0 0 0.5px var(--_color-semantic---error--error);
}


/* =========================================================
   RADIO ACTIVE STATE
   ========================================================= */

.form-radio-field:has(input[type="radio"]:checked) {
  border-color: var(--blue-scale--bright-blue);
  background: transparent;
}


/* =========================================================
   DISABLE WEBFLOW'S NATIVE VALIDATION STYLING
   ========================================================= */

.w-input.input-validation-error,
.w-select.input-validation-error {
  border-color: inherit !important;
}

input:invalid,
textarea:invalid {
  box-shadow: none;
}

@media (max-width: 991px) {
  .fs-selectcustom_dropdown-list.w--open,
  .fs-selectcustom_dropdown-list-2.w--open {
    max-height: 238px;
  }
}
</style>


<script>
document.addEventListener("DOMContentLoaded", function () {

  /* =========================================================
     ACADEMIA + INDUSTRY MULTI-STEP FORMS
     ========================================================= */


  /* =========================================================
     BLOCKED PERSONAL / DISPOSABLE EMAIL DOMAINS
     ========================================================= */

  const BLOCKED_DOMAINS = [
    "gmail.com", "yahoo.com", "hotmail.com", "outlook.com", "icloud.com",
    "me.com", "mac.com", "live.com", "googlemail.com", "qq.com",
    "mail.ru", "yandex.ru", "yandex.com", "163.com", "126.com",
    "foxmail.com", "sohu.com", "aol.com", "protonmail.com", "proton.me",
    "msn.com", "ymail.com", "rocketmail.com", "gmx.com", "gmx.de",
    "gmx.net", "web.de", "t-online.de", "freenet.de", "orange.fr",
    "laposte.net", "free.fr", "sfr.fr", "wanadoo.fr", "libero.it",
    "virgilio.it", "alice.it", "tiscali.it", "btinternet.com", "sky.com",
    "talktalk.net", "mail.com", "rediffmail.com", "yahoo.co.in", "yahoo.co.uk",
    "yahoo.com.br", "yahoo.com.mx", "yahoo.com.ar", "uol.com.br", "bol.com.br",
    "terra.com.br", "globo.com", "wp.pl", "onet.pl", "o2.pl",
    "interia.pl", "ukr.net", "rambler.ru", "bk.ru", "list.ru",
    "inbox.ru", "123.com", "139.com", "yeah.net", "21cn.com",
    "comcast.net", "verizon.net", "att.net", "sbcglobal.net", "cox.net",
    "bellsouth.net", "charter.net", "earthlink.net", "juno.com", "netzero.com",
    "virginmedia.com", "ntlworld.com", "blueyonder.co.uk", "ziggo.nl", "xs4all.nl",
    "hetnet.nl", "meta.ua", "i.ua", "sify.com", "indiatimes.com",
    "hotmail.co.in", "hotmail.com.br", "emirates.net.ae", "tutanota.com", "tuta.io",
    "yopmail.com", "mailinator.com", "maildrop.cc", "trashmail.com", "guerrillamail.com",
    "sharklasers.com", "tempmail.com", "10minutemail.com", "throwam.com", "dispostable.com",
    "guerrillamailblock.com", "fakeinbox.com"
  ];


  /* =========================================================
     ROLES THAT SKIP THE "JUST ME" SUCCESS SCREEN
     If the selected job title is in this list, choosing
     "Just Me" continues the form instead of showing
     .success-just-me.
     ========================================================= */

  const EXCEPTION_ROLES = {
    academia: [
      "Dean, Provost, Dept Chair, or Institute Director",
      "P.I. or Lab/Group Head (select if you run a lab)",
      "Lab Manager or Lab Operations",
      "Librarian or Library Staff",
      "IT or Information Systems",
      "Procurement or Purchasing",
      "Admin or Operations Staff (Dept, Program, Grants)"
    ],
    industry: [
      "C-Suite Officer",
      "President, VP, or Founder",
      "Director or Head of Department",
      "Lab Manager or Lab Operations",
      "IT or Information Systems",
      "Procurement or Purchasing"
    ]
  };


  /* =========================================================
     LOCALE
     Read from <html lang="..."> set by Webflow Localization
     ========================================================= */

  const LOCALE =
    (document.documentElement.lang || "en")
      .slice(0, 2)
      .toLowerCase();


  /* =========================================================
     SEAT COUNTS — LOCALIZED
     Keys = Choice Values (English, same in all locales)
     Values = number range only; the word is added per locale
     ========================================================= */

  const SEAT_RANGES = {
    /* Industry */
    "2-5": "2–5",
    "6-20": "6–20",
    "21-50": "21–50",
    "50+": "50+",
    "50plus": "50+",

    /* Academia */
    "My Team (2-5 researchers)": "2–5",
    "My Lab, Department, or Institute (6-50 researchers)": "6–50",
    "My College, School, or University (50+ Researchers)": "50+"
  };

  const SEAT_WORDS = {
    en: { one: "seat",           many: "seats" },
    fr: { one: "poste",          many: "postes" },
    de: { one: "Benutzerlizenz", many: "Benutzerlizenzen" },
    es: { one: "puesto",         many: "puestos" },
    it: { one: "utente",         many: "utenti" },
    zh: { one: "个席位",          many: "个席位" },
    ja: { one: "名様",            many: "名様" },
    ko: { one: "석",             many: "석" }
  };

  function seatLabel(range) {

    /* Chinese: "2 至 5 个席位", "50 个以上席位", "1 个席位" */
    if (LOCALE === "zh") {
      if (range.endsWith("+")) return range.slice(0, -1) + " 个以上席位";
      return range.replace("–", " 至 ") + " 个席位";
    }

    /* Japanese: "2〜5名様", "50名様以上", "1名様" */
    if (LOCALE === "ja") {
      if (range.endsWith("+")) return range.slice(0, -1) + "名様以上";
      return range.replace("–", "〜") + "名様";
    }

    /* Italian: "da 2 a 5 utenti", "di oltre 50 utenti", "di 1 utente" */
    if (LOCALE === "it") {
      if (range === "1") return "di 1 utente";
      if (range.endsWith("+")) return "di oltre " + range.slice(0, -1) + " utenti";
      return "da " + range.replace("–", " a ") + " utenti";
    }

    const words =
      SEAT_WORDS[LOCALE] || SEAT_WORDS.en;

    const word =
      range === "1" ? words.one : words.many;

    /* No space in Korean;
       non-breaking space elsewhere so it never wraps */
    const separator =
      LOCALE === "ko" ? "" : "\u00A0";

    return range + separator + word;

  }


  /* =========================================================
     ERROR MESSAGES — LOCALIZED
     ========================================================= */

  const MESSAGES = {
    en: {
      required: "This field is required",
      email: "Please use your institutional email address"
    },
    fr: {
      required: "Ce champ est obligatoire",
      email: "Veuillez utiliser votre adresse e-mail institutionnelle"
    },
    de: {
      required: "Dieses Feld ist erforderlich",
      email: "Bitte verwenden Sie Ihre institutionelle E-Mail-Adresse"
    },
    es: {
      required: "Este campo es obligatorio",
      email: "Utiliza tu dirección de correo electrónico institucional"
    },
    it: {
      required: "Campo obbligatorio",
      email: "Utilizza il tuo indirizzo email istituzionale"
    },
    zh: {
      required: "必填选项",
      email: "请使用您的机构电子邮箱地址"
    },
    ja: {
      required: "この項目は必須です",
      email: "所属機関のメールアドレスをご使用ください"
    },
    ko: {
      required: "필수 입력 항목입니다",
      email: "기관 이메일 주소를 사용해 주세요"
    }
  };

  function t(key) {

    const set =
      MESSAGES[LOCALE] || MESSAGES.en;

    return set[key] || MESSAGES.en[key];

  }


  /* =========================================================
     HELPERS
     ========================================================= */

  function getFieldWrapper(input) {
    return input.closest(".form-field-wr");
  }


  function clearError(input) {

    const wrapper = getFieldWrapper(input);
    if (!wrapper) return;

    input.classList.remove("error");

    const label = wrapper.querySelector(".form-label");
    if (label) label.classList.remove("error");

    const error = wrapper.querySelector(".field-error");
    if (error) error.remove();

  }


  function showError(input, message) {

    const wrapper = getFieldWrapper(input);
    if (!wrapper) return;

    clearError(input);

    input.classList.add("error");

    const label = wrapper.querySelector(".form-label");
    if (label) label.classList.add("error");

    const error = document.createElement("div");
    error.className = "field-error";
    error.textContent = message;

    wrapper.appendChild(error);

  }


  function clearSelectError(input) {

    const wrapper = getFieldWrapper(input);
    if (!wrapper) return;

    input.classList.remove("error");

    const error = wrapper.querySelector(".field-error");
    if (error) error.remove();

  }


  function showSelectError(input, message) {

    const wrapper = getFieldWrapper(input);
    if (!wrapper) return;

    clearSelectError(input);

    input.classList.add("error");

    const error = document.createElement("div");
    error.className = "field-error";
    error.textContent = message;

    wrapper.appendChild(error);

  }


  /* =========================================================
     FORM TYPE
     ========================================================= */

  function getFormType(wrapper) {

    if (wrapper.classList.contains("academia")) return "academia";
    if (wrapper.classList.contains("industry")) return "industry";

    return "";

  }


  /* =========================================================
     EMAIL ERROR MESSAGE
     ========================================================= */

  function getEmailErrorMessage(input) {

    if (input.value.trim() === "") {
      return t("required");
    }

    return t("email");

  }


  /* =========================================================
     EMAIL VALIDATION
     ========================================================= */

  function validateEmail(value) {

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    if (!emailRegex.test(value)) return false;

    const domain = value.split("@")[1].toLowerCase();

    return !BLOCKED_DOMAINS.includes(domain);

  }


  /* =========================================================
     RADIO HELPERS
     ========================================================= */

  function getSelectedRadio(slide) {
    return slide.querySelector('input[type="radio"]:checked');
  }


  /* =========================================================
     RADIO VISUAL RESET
     ========================================================= */

  function clearRadioVisualState(wrapper) {

    wrapper
      .querySelectorAll(".w-form-formradioinput")
      .forEach(function (radioVisual) {
        radioVisual.classList.remove("w--redirected-checked");
      });

    wrapper
      .querySelectorAll('input[type="radio"]')
      .forEach(function (radio) {
        radio.checked = false;
      });

  }


  /* =========================================================
     SLIDE VALIDATION
     ========================================================= */

  function validateSlide(slide) {

    let isValid = true;


    /* Clear existing errors on this slide */

    slide
      .querySelectorAll(".form-input")
      .forEach(function (input) {
        clearError(input);
      });

    slide
      .querySelectorAll("select")
      .forEach(function (select) {
        clearSelectError(select);
      });


    /* Required text / textarea / email inputs */

    slide
      .querySelectorAll("input[required], textarea[required]")
      .forEach(function (input) {

        if (input.type === "radio" || input.type === "checkbox") return;

        if (input.value.trim() === "") {

          showError(input, t("required"));
          isValid = false;
          return;

        }

        if (input.type === "email") {

          if (!validateEmail(input.value.trim().toLowerCase())) {

            showError(input, getEmailErrorMessage(input));
            isValid = false;

          }

        }

      });


    /* Required selects */

    slide
      .querySelectorAll("select[required]")
      .forEach(function (select) {

        if (!select.value || select.value === "") {

          showSelectError(select, t("required"));
          isValid = false;

        }

      });


    /* Radio groups */

    const radioNames = new Set();

    slide
      .querySelectorAll('input[type="radio"][required]')
      .forEach(function (radio) {
        radioNames.add(radio.name);
      });

    radioNames.forEach(function (name) {

      const radios = Array.from(
        slide.querySelectorAll(
          'input[type="radio"][name="' + CSS.escape(name) + '"]'
        )
      );

      const selected = radios.some(function (radio) {
        return radio.checked;
      });

      if (!selected) {

        isValid = false;

        const firstRadio = radios[0];

        if (firstRadio) {

          const wrapper = firstRadio.closest(".form-field-wr");

          if (wrapper) {

            const existingError = wrapper.querySelector(".field-error");

            if (!existingError) {

              const error = document.createElement("div");
              error.className = "field-error";
              error.textContent = t("required");

              wrapper.appendChild(error);

            }

          }

        }

      }

    });


    return isValid;

  }


  /* =========================================================
     FORMS
     ========================================================= */

  document
    .querySelectorAll(".test-modal-wrap.academia, .test-modal-wrap.industry")
    .forEach(function (wrapper) {

      const form = wrapper.querySelector("form");
      if (!form) return;


      /* DISABLE NATIVE BROWSER VALIDATION */

      form.noValidate = true;
      form.setAttribute("novalidate", "novalidate");


      /* FORM TYPE */

      const formType = getFormType(wrapper);


      /* SLIDER */

      const slider = wrapper.querySelector(".form-slider");
      if (!slider) return;


      /* SUCCESS STATES */

      const successJustMe = wrapper.querySelector(".success-just-me");
      const success = wrapper.querySelector(".w-form-done");
      const fail = wrapper.querySelector(".w-form-fail");


      /* ===================================================
         RESET
         =================================================== */

      function resetForm() {

        /* Keep script-filled hidden values (IP, BookIt) through the reset */
        const keepFields = form.querySelectorAll(
          'input[name="ip-address"], input[name="BookIt-Log-ID"]'
        );
        const keptValues = Array.from(keepFields).map(function (f) {
          return f.value;
        });

        form.reset();

        keepFields.forEach(function (f, i) {
          f.value = keptValues[i];
        });

        delete form.dataset.seatCount;


        /* Reset radio visual state */

        clearRadioVisualState(wrapper);


        /* Hide success / fail */

        if (successJustMe) successJustMe.style.display = "none";
        if (success) success.style.display = "none";
        if (fail) fail.style.display = "none";


        /* Show form */

        form.style.display = "";


        /* Remove errors */

        wrapper
          .querySelectorAll(".field-error")
          .forEach(function (error) {
            error.remove();
          });

        wrapper
          .querySelectorAll(".error")
          .forEach(function (element) {
            element.classList.remove("error");
          });


        /* Reset Finsweet custom selects */

        wrapper
          .querySelectorAll(".fs-selectcustom_link:first-of-type")
          .forEach(function (firstOption) {
            firstOption.click();
          });


        /* Reset native selects */

        wrapper
          .querySelectorAll("select")
          .forEach(function (select) {

            select.selectedIndex = 0;

            select.dispatchEvent(
              new Event("change", { bubbles: true })
            );

          });


        /* Return slider to first slide */

        requestAnimationFrame(function () {

          const firstDot = wrapper.querySelector(".w-slider-dot");
          if (firstDot) firstDot.click();

          clearRadioVisualState(wrapper);

        });


        /* Extra cleanup for Webflow radio visuals */

        setTimeout(function () {
          clearRadioVisualState(wrapper);
        }, 50);

      }


      /* ===================================================
         CLOSE MODAL
         =================================================== */

      wrapper.addEventListener("click", function (event) {

        const closeTrigger = event.target.closest(
          ".test-close-x-wr, .test-modal-bg, .test-form-back"
        );

        if (!closeTrigger) return;

        resetForm();

        setTimeout(function () {
          resetForm();
        }, 0);

      });


      /* ===================================================
         MODAL VISIBILITY — RESET ON OPEN
         =================================================== */

      let wasVisible = false;

      function isVisible() {

        const styles = window.getComputedStyle(wrapper);

        return (
          styles.display !== "none" &&
          styles.visibility !== "hidden"
        );

      }

      const visibilityObserver = new MutationObserver(function () {

        const visible = isVisible();

        if (visible && !wasVisible) resetForm();

        wasVisible = visible;

      });

      visibilityObserver.observe(wrapper, {
        attributes: true,
        attributeFilter: ["style", "class"]
      });

      wasVisible = isVisible();


      /* ===================================================
         SLIDE HELPERS
         =================================================== */

      function getCurrentSlide() {

        return (
          wrapper.querySelector(".w-slide[aria-hidden='false']") ||
          wrapper.querySelector(".w-slide:not([aria-hidden='true'])")
        );

      }


      /* ===================================================
         CONTINUE BUTTON
         .form-next has no native Webflow interaction, so
         this handler triggers the slide change itself by
         clicking the hidden native arrow.
         =================================================== */

      wrapper
        .querySelectorAll(".form-next")
        .forEach(function (button) {

          button.addEventListener("click", function (event) {

            event.preventDefault();

            const currentSlide = getCurrentSlide();
            if (!currentSlide) return;

            if (!validateSlide(currentSlide)) return;

            const selectedRadio = getSelectedRadio(currentSlide);

            if (selectedRadio) {

              /* "Just Me" */

              if (selectedRadio.value === "Myself") {

                const roleSelect = wrapper.querySelector(
                  'select[name="job-title"]'
                );

                const roleValue = roleSelect ? roleSelect.value : "";

                const exceptionList = EXCEPTION_ROLES[formType] || [];

                const isException = exceptionList.includes(roleValue);

                if (!isException) {

                  if (successJustMe) successJustMe.style.display = "flex";

                  form.style.display = "none";

                  return;

                }

                /* Exception role: form continues,
                   so it needs its own seat-count text */

                form.dataset.seatCount = seatLabel("1");

              } else {

                /* Seat count — other radio options */

                if (SEAT_RANGES[selectedRadio.value]) {

                  form.dataset.seatCount = seatLabel(
                    SEAT_RANGES[selectedRadio.value]
                  );

                }

              }

            }


            /* Advance the slide via Webflow's own hidden native arrow */

            const rightArrow = wrapper.querySelector(".w-slider-arrow-right");
            if (rightArrow) rightArrow.click();

          });

        });


      /* ===================================================
         BACK BUTTON
         =================================================== */

      wrapper
        .querySelectorAll(".form-back")
        .forEach(function (button) {

          button.addEventListener("click", function (event) {

            event.preventDefault();

            const leftArrow = wrapper.querySelector(".w-slider-arrow-left");
            if (leftArrow) leftArrow.click();

          });

        });


      /* ===================================================
         CLEAR INPUT ERRORS
         =================================================== */

      form.addEventListener("input", function (event) {

        const target = event.target;

        if (target.classList.contains("form-input")) {
          clearError(target);
        }

      });


      /* ===================================================
         CLEAR SELECT / RADIO ERRORS
         =================================================== */

      form.addEventListener("change", function (event) {

        const target = event.target;

        if (target.tagName === "SELECT") {
          clearSelectError(target);
        }

        if (target.type === "radio") {

          const slide = target.closest(".w-slide");
          if (!slide) return;

          const radioNames = new Set();

          slide
            .querySelectorAll('input[type="radio"]')
            .forEach(function (radio) {

              if (radio.name === target.name) {
                radioNames.add(radio.name);
              }

            });

          radioNames.forEach(function (name) {

            slide
              .querySelectorAll(
                'input[type="radio"][name="' + CSS.escape(name) + '"]'
              )
              .forEach(function (radio) {

                const radioWrapper = radio.closest(".form-field-wr");

                if (radioWrapper) {

                  const error = radioWrapper.querySelector(".field-error");
                  if (error) error.remove();

                }

              });

          });

        }

      });


      /* ===================================================
         SUBMIT
         =================================================== */

      form.addEventListener("submit", function (event) {

        /* Honeypot */

        const honeypot = form.querySelector(
          'input[name="website"], input[data-honeypot]'
        );

        if (honeypot && honeypot.value.trim() !== "") {

          event.preventDefault();
          event.stopPropagation();
          return;

        }

        const currentSlide = getCurrentSlide();
        if (!currentSlide) return;

        if (!validateSlide(currentSlide)) {

          event.preventDefault();
          event.stopPropagation();
          return;

        }

      }, false);


      /* ===================================================
         SUCCESS OBSERVER — SEAT COUNT TEXT
         =================================================== */

      if (success) {

        const successObserver = new MutationObserver(function () {

          const display = window.getComputedStyle(success).display;

          if (display !== "none") {

            const seatCount = form.dataset.seatCount;

            if (seatCount) {

              success
                .querySelectorAll(".seat-count")
                .forEach(function (element) {
                  element.textContent = seatCount;
                });

            }

          }

        });

        successObserver.observe(success, {
          attributes: true,
          attributeFilter: ["style", "class"]
        });

      }

    });

});
</script></div><div class="nav-icon-code w-embed"><style>
/* Hide text by default */
.biorender-system-project--nav-icon-link-text {
  opacity: 0;
  transition: opacity 0.2s ease;
}

/* Desktop: show text on hover or keyboard focus */
@media (hover: hover) and (pointer: fine) {
  .biorender-system-project--nav-icon-link:hover
    .biorender-system-project--nav-icon-link-text,
  .biorender-system-project--nav-icon-link:focus-visible
    .biorender-system-project--nav-icon-link-text {
    opacity: 1;
  }
}

/* Tablet and below: always show text */
@media screen and (max-width: 991px) {
  .biorender-system-project--nav-icon-link-text {
    opacity: 1;
  }
}
