<script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>

<script>

/* ============================================
   GRANT AWARD - Equal Height
   ============================================ */
function setEqualHeight() {
  const slides = document.querySelectorAll('.grand-award-component');
  if (!slides.length) return;
  let maxHeight = 0;
  slides.forEach(slide => {
    slide.style.height = 'auto';
    const height = slide.getBoundingClientRect().height;
    maxHeight = Math.max(maxHeight, height);
  });
  slides.forEach(slide => {
    slide.style.height = `${maxHeight}px`;
  });
}
let resizeTimeout;
window.addEventListener('resize', () => {
  clearTimeout(resizeTimeout);
  resizeTimeout = setTimeout(setEqualHeight, 200);
});


/* ============================================
   LOGO CAROUSEL - Duplicate items for infinite scroll
   ============================================ */
document.addEventListener('DOMContentLoaded', function () {
  var list = document.querySelector('.collection-list-21');
  if (list) {
    list.innerHTML += list.innerHTML;
  }
});


$(document).ready(function () {

  /* ============================================
     NUCLEI SLIDER (UPDATED)
     ============================================ */
  $('.nuclei-slider').on('init', function (event, slick) {
    // Play video in the initial real slide
    const initialSlide = $(slick.$slides[slick.currentSlide]);
    const video = initialSlide.find('video')[0];
    if (video) video.play();
  });

  $('.nuclei-slider').slick({
    slidesToShow: 1,
    slidesToScroll: 1,
    infinite: true,
    autoplay: false,
    autoplaySpeed: 3000,
    dots: false,
    adaptiveHeight: true,
    centerMode: true,
    centerPadding: '0px',
    nextArrow: $('.slick-next'),
    prevArrow: $('.slick-prev'),
    responsive: [
      {
        breakpoint: 768,
        settings: {
          slidesToShow: 1,
          centerMode: true,
          centerPadding: '20px',
          adaptiveHeight: false,
          dots: true,
          arrows: false,
        }
      }
    ],
  });

  // Handle slide change: update pills + play correct video
  $('.nuclei-slider').on('afterChange', function (event, slick, currentSlide) {

    // Update active nav pill
    $('.slider-item-wr').removeClass('active');
    $(`.slider-item-wr[data-slide="${currentSlide + 1}"]`).addClass('active');

    // Pause/reset all videos
    $('.nuclei-slider video').each(function () {
      this.pause();
      this.currentTime = 0;
    });

    // Play the video in the true slide (not clone)
    const realSlide = $(slick.$slides[currentSlide]);
    const video = realSlide.find('video')[0];
    if (video) video.play();
  });

  // Nav pill -> go to slide
  $('.slider-item-wr').each(function () {
    $(this).on('click', function (e) {
      e.preventDefault();
      $('.slider-item-wr').removeClass('active');
      $(this).addClass('active');
      const slideIndex = $(this).attr('data-slide');
      $('.nuclei-slider').slick('slickGoTo', slideIndex - 1);
    });
  });


  /* ============================================
     TEMPLATES SLIDER
     ============================================ */
  $('.templates-slider-list').slick({
    slidesToShow: 3,
    slidesToScroll: 1,
    infinite: true,
    autoplay: true,
    autoplaySpeed: 2000,
    speed: 600,
    dots: false,
    arrows: true,
    nextArrow: $('.splide__arrow--next'),
    prevArrow: $('.splide__arrow--prev'),
    responsive: [
      {
        breakpoint: 991,
        settings: {
          slidesToShow: 2,
          slidesToScroll: 2,
        }
      },
      {
        breakpoint: 767,
        settings: {
          slidesToShow: 1,
          slidesToScroll: 1,
          dots: true,
          arrows: false,
        }
      }
    ],
  });

});

</script>

<!-- Top banner 24 hour cookie -->
<script>
document.addEventListener("DOMContentLoaded", function () {

  const banner = document.querySelector(".top-banner");
  const closeBtn = document.querySelector(".top-banner-close");

  if (!banner || !closeBtn) return;

  const STORAGE_KEY = "topBannerClosed";
  const HIDE_TIME = 24 * 60 * 60 * 1000; // 24h

  const closedAt = localStorage.getItem(STORAGE_KEY);

  // Hide banner if still within 24h
  if (closedAt && (Date.now() - closedAt < HIDE_TIME)) {
    banner.style.display = "none";
    return;
  }

  // Remove expired timestamp
  localStorage.removeItem(STORAGE_KEY);

  // Close action
  closeBtn.addEventListener("click", function () {
    banner.style.display = "none";
    localStorage.setItem(STORAGE_KEY, Date.now());
  });

});
</script>

<!-- Hero Form Test Slider Height -->
<script>
document.addEventListener("DOMContentLoaded", function () {
  /* Fit each .form-mask to the height of the slide that's showing */
  document.querySelectorAll(".test-modal-content .form-mask").forEach(function (mask) {
    var slides = [].slice.call(mask.querySelectorAll(":scope > .w-slide"));
    if (!slides.length) return;

    var TRANSITION = "height 300ms ease";
    var wasHidden = true;

    function activeSlide() {
      return mask.querySelector(':scope > .w-slide:not([aria-hidden="true"])') || slides[0];
    }

    function fit() {
      var h = activeSlide().offsetHeight;

      // Modal is closed: keep the last height, just remember it was hidden
      if (!h) { wasHidden = true; return; }

      if (wasHidden) {
        // Modal just opened: jump to the slide height instantly, no animation
        mask.style.transition = "none";
        mask.style.height = h + "px";
        mask.offsetHeight; // force reflow so the jump applies before re-enabling the transition
        mask.style.transition = TRANSITION;
        wasHidden = false;
      } else {
        // Moving between slides: animate
        mask.style.height = h + "px";
      }
    }

    // Slide changes (Continue / Back / reset to first slide)
    new MutationObserver(fit).observe(mask, {
      subtree: true, attributes: true, attributeFilter: ["aria-hidden"]
    });

    // Modal opening and content changes (errors, conditional fields)
    var ro = new ResizeObserver(fit);
    slides.forEach(function (s) { ro.observe(s); });
    ro.observe(mask);

    fit();
  });
});
</script>

<style>
  /* Clip slides sliding in/out at the modal's sides, but let the dropdown overflow downward */
  .test-modal-content .form-mask {
    overflow-x: clip !important;
    overflow-y: visible !important;
  }

  /* Keep slides that aren't showing from appearing outside the modal */
  .test-modal-content .form-mask > .w-slide[aria-hidden="true"],
  .test-modal-content .form-mask > .w-slide[aria-hidden="true"] * {
    visibility: hidden !important;
    transition: none !important;
  }
  /* Fade the radio options in when their slide becomes active */
@keyframes formRadioFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.test-modal-content .form-mask > .w-slide:not([aria-hidden="true"]) .form-radio-field,
.test-modal-content .form-mask > .w-slide:not([aria-hidden="true"]) .form-back {
  animation: formRadioFadeIn 300ms ease both;
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  /* Auto-advance: step 1 dropdown pick, step 2 radio pick, Enter in the email field */
  document.querySelectorAll(".test-modal-content .form-slider").forEach(function (slider) {
    var slides = [].slice.call(slider.querySelectorAll(".w-slide"));
    if (slides.length < 3) return;
    var step1 = slides[0], step2 = slides[1];

    function isActive(slide) {
      return slide.getAttribute("aria-hidden") !== "true";
    }

    function advance(slide) {
      if (!isActive(slide)) return;               // already moved on
      var next = slide.querySelector(".form-next");
      if (next) { next.click(); return; }         // hidden Continue: runs validation + "Myself" logic
      var arrow = slider.querySelector(".w-slider-arrow-right");
      if (arrow) arrow.click();
    }

    // Step 1: pick an option from the custom dropdown (fs-selectcustom_link / fs-selectcustom_link-2)
    step1.addEventListener("click", function (e) {
      var link = e.target.closest('[class*="fs-selectcustom_link"]');
      if (!link) return;
      setTimeout(function () {
        var select = step1.querySelector("select");
        if (select && select.value) advance(step1); // ignore the "Select your job title" placeholder
      }, 200);
    });

    // Step 2: pick a radio option
    step2.addEventListener("click", function (e) {
      var radio = e.target.closest('input[type="radio"]');
      if (!radio) return;
      setTimeout(function () { advance(step2); }, 200);
    });

    // Enter in a field on any step with a Continue button (the work email step)
    slides.forEach(function (slide) {
      if (!slide.querySelector(".form-next")) return;
      slide.addEventListener("keydown", function (e) {
        if (e.key !== "Enter") return;
        if (!e.target.matches('input[type="email"], input[type="text"], input[type="tel"]')) return;
        e.preventDefault(); // stops the native submit and its browser error
        advance(slide);
      });
    });
  });
});
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {
  var CLOSE = ".test-close-x-wr, .test-modal-bg, .test-form-back";

  document.querySelectorAll(".test-modal-wrap").forEach(function (wrap) {
    var holding = false, timer;

    function release() {
      if (!holding) return;
      holding = false;
      clearTimeout(timer);
      wrap.classList.remove("hold-just-me", "hold-slide");
      wrap.querySelectorAll(".w-slide.is-held").forEach(function (s) {
        s.classList.remove("is-held");
      });
    }

    // Capture phase on document: runs before the form script's reset
    document.addEventListener("click", function (e) {
      if (holding || !wrap.contains(e.target) || !e.target.closest(CLOSE)) return;

      var justMe = wrap.querySelector(".success-just-me");
      if (justMe && getComputedStyle(justMe).display !== "none") {
        wrap.classList.add("hold-just-me");
      } else {
        var mask = wrap.querySelector(".form-mask");
        var slide = mask && mask.querySelector(':scope > .w-slide:not([aria-hidden="true"])');
        if (!slide) return;
        wrap.style.setProperty("--hold-h", mask.offsetHeight + "px");
        wrap.style.setProperty("--hold-x", getComputedStyle(slide).transform);
        slide.classList.add("is-held");
        wrap.classList.add("hold-slide");
      }
      holding = true;
      timer = setTimeout(release, 1500); // fallback if the modal doesn't close
    }, true);

    // Release once the modal is fully hidden
    new MutationObserver(function () {
      if (holding && getComputedStyle(wrap).display === "none") release();
    }).observe(wrap, { attributes: true, attributeFilter: ["style"] });
  });
});
</script></body></html>