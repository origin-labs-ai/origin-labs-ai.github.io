 only use data to improve our models when you give permission. Our security standards are designed to meet institutional compliance needs.\"]}]]}],false,[\"$\",\"$L41\",null,{\"ctas\":null,\"variants\":[\"tertiary\"],\"size\":\"small\",\"className\":\"FeatureList-module-scss-module__3G7ECW__ctas\",\"ctaPosition\":\"featureList\"}]]}]]}]\n4b:[\"$\",\"div\",null,{\"className\":\"CtaBanner-module-scss-module__0Cqcuq__text\",\"children\":[[\"$\",\"p\",null,{\"ref\":\"$undefined\",\"className\":\"Heading-module-scss-module__AyGdUq__heading text-headline-5-serif Heading-module-scss-module__AyGdUq__balance CtaBanner-module-scss-module__0Cqcuq__headline\",\"children\":\"K-12 teacher? Claude for Teachers is built for you.\"}],\"$undefined\",false]}]\n4c:[\"$\",\"$L41\",null,{\"ctas\":[{\"_key\":\"014e9dee534d\",\"_type\":\"link\",\"href\":\"/solutions/teachers\",\"label\":\"Get verified\",\"linkType\":\"href\",\"openInNewTab\":false,\"variant\":\"primary\",\"page\":null}],\"variants\":[\"secondary\",\"primary\"],\"size\":\"main\",\"className\":\"CtaBanner-module-scss-module__0Cqcuq__ctas\",\"ctaPosition\":\"ctaBanner\"}]\n4e:[\"$\",\"h3\",null,{\"ref\":\"$undefined\",\"className\":\"Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title\",\"children\":\"Faculty\"}]\n4f:[\"$\",\"div\",null,{\"className\":\"FeatureList-module-scss-module__3G7ECW__itemContent\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-rich-text FeatureList-module-scss-module__3G7ECW__body\",\"style\":\"$undefined\",\"children\":[[\"$\",\"p\",\"021b93a87010\",{\"className\":\"text-body-2\",\"children\":[\"Claude helps you build richer course materials faster, starting from your expertise rather than a blank page. Draft syllabi, design assignments that require original thinking, and work through where students are likely to get stuck before you're in the room with them.\"]}]]}],false,[\"$\",\"$L41\",null,{\"ctas\":null,\"variants\":[\"tertiary\"],\"size\":\"small\",\"className\":\"FeatureList-module-scss-module__3G7ECW__ctas\",\"ctaPosition\":\"featureList\"}]]}]\n64:T4d3,\u003cpath d=\"M14.5 2C15.3284 2 16 2.67157 16 3.5V16.5C16 17.3284 15.3284 18 14.5 18H6.375C5.06332 18 4 16.9367 4 15.625V4.375C4 3.06332 5.06332 2 6.375 2H14.5ZM15 13.9121C14.8434 13.9676 14.6756 14 14.5 14H6.375C5.61561 14 5 14.6156 5 15.375V15.625C5 16.3844 5.61561 17 6.375 17H14.5C14.7761 17 15 16.7761 15 16.5V13.9121ZM6.375 3C5.61561 3 5 3.61561 5 4.375V13.4395C5.38814 13.1632 5.86232 13 6.375 13H14.5C14.7761 13 15 12.7761 15 12.5V3.5C15 3.22386 14.7761 3 14.5 3H6.375ZM12.54 6.30371C12.6486 6.05001 12.9425 5.93174 13.1963 6.04004C13.45 6.14863 13.5683 6.44253 13.46 6.69629C13.1651 7.38527 12.589 8 11.7998 8C11.3132 7.99994 10.908 7.76633 10.5996 7.42578C10.2913 7.76607 9.88667 7.99987 9.40039 8C8.91365 8 8.50769 7.76648 8.19922 7.42578C7.89083 7.76606 7.48636 8 7 8C6.72386 8 6.5 7.77614 6.5 7.5C6.5 7.22386 6.72386 7 7 7C7.21245 7 7.51918 6.8199 7.74023 6.30371L7.77441 6.2373C7.86451 6.09126 8.02513 6 8.2002 6C8.40022 6.00008 8.58145 6.11981 8.66016 6.30371C8.88121 6.8198 9.18796 7 9.40039 7C9.61284 6.99978 9.9197 6.81969 10.1406 6.30371L10.1748 6.2373C10.2649 6.09147 10.4248 6.00014 10.5996 6C10.7997 6 10.9808 6.11975 11.0596 6.30371C11.2806 6.8198 11.5874 6.99989 11.7998 7C12.0122 7 12.319 6.81985 12.54 6.30371Z\" /\u003e50:[\"$\",\"div\",\"a1da50ebbbcb\",{\"className\":\"FeatureList-module-scss-module__3G7ECW__item\",\"children\":[[\"$\",\"div\",null,{\"className\":\"FeatureList-module-scss-module__3G7ECW__itemHeader\",\"children\":[[\"$\",\"span\",null,{\"className\":\"FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3\",\"children\":[[\"$\",\"svg\",null,{\"width\":24,\"height\":24,\"viewBox\":\"0 0 20 20\",\"fill\":\"currentColor\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"className\":\"FeatureList-module-scss-module__3G7ECW__itemIcon\",\"aria-hidden\":\"true\",\"dangerousl