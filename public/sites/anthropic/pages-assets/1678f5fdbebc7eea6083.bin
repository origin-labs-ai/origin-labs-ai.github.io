06 6.71454 13.4868L7.44501 16.8627L10.28 14.892L10.3376 14.8452C10.3909 14.7949 10.4325 14.7332 10.4597 14.6645L13.0974 7.96723L9.37567 6.50141L6.73798 13.1987ZM11.3073 2.96332C11.0504 2.86217 10.7601 2.98864 10.6589 3.24555L9.74188 5.57074L13.4636 7.03754L14.3806 4.71137C14.4817 4.45445 14.3552 4.16413 14.0983 4.06293L11.3073 2.96332Z\\\" /\u003e\"}}],\"prompts\":[\"Create discussion questions that build on yesterday’s lecture about supply chain disruption.\",\"Review this grant proposal draft and suggest stronger evidence for the methodology section.\",\"Analyze themes across these student essays and flag patterns I should address in class.\"]},{\"_key\":\"dacf3544eef1\",\"label\":\"Administrators\",\"icon\":[\"$\",\"svg\",null,{\"width\":20,\"height\":20,\"viewBox\":\"0 0 20 20\",\"fill\":\"currentColor\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"className\":\"$undefined\",\"aria-hidden\":\"true\",\"dangerouslySetInnerHTML\":{\"__html\":\"$79\"}}],\"prompts\":[\"Compare graduation rates across our engineering programs and identify intervention points.\",\"Analyze st"])</script><script nonce="v5wp05ook0i/Ake2Hk8yQQ==">self.__next_f.push([1,"udent course evaluation data to identify which faculty need pedagogical support.\",\"Create a budget narrative explaining why we need three new positions in data science.\"]}],\"tabPrefix\":null,\"submitLabel\":\"Ask Claude\",\"placeholder\":\"Enter your prompt\"}]\n66:[\"$\",\"h3\",null,{\"ref\":\"$undefined\",\"className\":\"Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title\",\"children\":\"Administrators\"}]\n67:[\"$\",\"div\",null,{\"className\":\"FeatureList-module-scss-module__3G7ECW__itemContent\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-rich-text FeatureList-module-scss-module__3G7ECW__body\",\"style\":\"$undefined\",\"children\":[[\"$\",\"p\",\"fe0092810a71\",{\"className\":\"text-body-2\",\"childre