malized="" style="--logo-w:117.22px;--logo-h:36.28px"><source srcSet="https://assets.claude.com/898ef7a2c8b3e56c716be7f389259b0f4869de3c.svg" media="(prefers-color-scheme: dark)"/><img src="https://assets.claude.com/e6c31b180a2aa1d15ddadd865436cf337014beaf.svg" alt="University of Pittsburgh" class="Logo-module-scss-module__j-nrIq__logo" loading="lazy" referrerPolicy="strict-origin-when-cross-origin" width="126" height="39" style="width:117.22px"/></picture></div></li></ul></div></div></section><section id="featureList" data-section="featureList" data-cta-section="featureList" class="SectionWrapper-module-scss-module__NFbz_a__wrapper theme-accent SectionWrapper-module-scss-module__NFbz_a__spacingBottomNone"><div class="SectionWrapper-module-scss-module__NFbz_a__borderTop"></div><div data-wf-width="inset" class="container SectionWrapper-module-scss-module__NFbz_a__insetFrame"><div class="SectionWrapper-module-scss-module__NFbz_a__inset"><div class="grid-12"><div class="FeatureList-module-scss-module__3G7ECW__inner FeatureList-module-scss-module__3G7ECW__fullWidth"><div class="IntroBlock-module-scss-module__0mSC7a__introBlock FeatureList-module-scss-module__3G7ECW__intro" style="--intro-headline-width:30ch"><div class="Illustration-module-scss-module__pBGuRG__base Illustration-module-scss-module__pBGuRG__pictogram Illustration-module-scss-module__pBGuRG__size-large IntroBlock-module-scss-module__0mSC7a__pictogram" role="img" aria-label="Intricate quill pen illustration with ornate feather and pointed nib, rendered in cream and dark brown tones."></div><h2 class="Heading-module-scss-module__AyGdUq__heading text-headline-1-serif Heading-module-scss-module__AyGdUq__balance AnimatedHeading-module-scss-module__KoWePa__heading IntroBlock-module-scss-module__0mSC7a__headline IntroBlock-module-scss-module__0mSC7a__headlineBalance" style="--word-stagger:0.04s" aria-label="How Claude works for higher education"><span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:0" aria-hidden="true">How</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:1" aria-hidden="true">Claude</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:2" aria-hidden="true">works</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:3" aria-hidden="true">for</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:4" aria-hidden="true">higher</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:5" aria-hidden="true">education</span></h2></div><div class="AnimatedReveal-module-scss-module__8zH9eW__container FeatureList-module-scss-module__3G7ECW__list FeatureList-module-scss-module__3G7ECW__horizontal FeatureList-module-scss-module__3G7ECW__cols3" style="--reveal-y:20px;--reveal-duration:0.75s;--reveal-delay:0s;--reveal-stagger:0.1s"><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:0"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="32" height="32" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M9.82227 3.03223C9.95577 2.98149 10.1064 2.99085 10.2344 3.05859L18.7344 7.55859C18.8977 7.64533 19 7.81501 19 8C19 8.185 18.8977 8.35466 18.7344 8.44141L16.9805 9.36914C16.9919 9.41102 17 9.45452 17 9.5V13.1113C16.9999 13.4845 16.8596 13.862 16.5674 14.1377C16.2667 14.4214 15.7273 14.8927 15 15.3721V17.5C15 17.7761 14.7761 18 14.5 18C14.2239 18 14 17.7761 14 17.5V15.957C12.8979 16.5301 11.532 17 10 17C7.15439 17 4.87641 15.3894 3.8125 14.4785L3.43262 14.1377C3.14045 13.862 3.00008 13.4845 3 13.1113V9.5C3 9.45461 3.00722 9.41095 3.01855 9.36914L1.26562 8.44141C1.10227 8.35466 1 8.185 1 8C1.00001 7.81501 1.10227 7.64533 1.26562 7.55859L9.76562 3.05859L9.82227 3.03223ZM4 13.1113C4.00008 13.2383 4.04751 13.3426 4.11914 13.4102L4.47461 13.7295C5.46045 14.5708 7.5074 16 10 16C11.558 16 12.9406 15.4397 14 14.8154V10.9473L10.2344 12.9414C10.088 13.0189 9.91197 13.0189 9.76562 12.9414L4 9.88867V13.1113ZM14.9902 10.4229C14.9942 10.4483 15 10.4737 15 10.5V14.1484C15.3834 13.8602 15.6826 13.5972 15.8809 13.4102C15.9525 13.3426 15.9999 13.2383 16 13.1113V9.88867L14.9902 10.4229ZM2.56738 8L10 11.9336L13.0986 10.293L9.75684 8.4375L9.67383 8.37891C9.49755 8.22746 9.44522 7.96793 9.5625 7.75684C9.67978 7.54585 9.92776 7.45286 10.1494 7.52246L10.2432 7.5625L14.1533 9.73438L17.4316 8L10 4.06543L2.56738 8Z" /></svg></span><h3 class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Built for university rigor</h3></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-3">Whether you’re synthesizing sources for a literature review or working through a problem, Claude engages with complexity without simplifying it away. It pushes back, asks follow-up questions, and helps you develop arguments you couldn’t have reached alone.</p></div></div></div><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:1"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="32" height="32" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M8.99962 2C12.3133 2 14.9996 4.68629 14.9996 8C14.9996 11.3137 12.3133 14 8.99962 14H2.49962C2.30105 13.9998 2.12113 13.8821 2.04161 13.7002C1.96224 13.5181 1.99835 13.3058 2.1334 13.1602L3.93516 11.2178C3.34317 10.2878 2.99962 9.18343 2.99962 8C2.99962 4.68643 5.68609 2.00022 8.99962 2ZM8.99962 3C6.23838 3.00022 3.99961 5.23871 3.99961 8C3.99961 9.11212 4.36265 10.1386 4.97618 10.9688C5.11884 11.1621 5.1035 11.4293 4.94004 11.6055L3.64512 13H8.99962C11.761 13 13.9996 10.7614 13.9996 8C13.9996 5.23858 11.761 3 8.99962 3Z" />
    <path d="M16.5445 9.72754C16.4182 9.53266 16.1678 9.44648 15.943 9.53418C15.7183 9.62215 15.5932 9.85502 15.6324 10.084L15.7369 10.3955C15.9073 10.8986 16.0006 11.438 16.0006 12C16.0006 13.1123 15.6376 14.1386 15.024 14.9687C14.8811 15.1621 14.8956 15.4302 15.0592 15.6064L16.3531 17H11.0006C9.54519 17 8.23527 16.3782 7.32091 15.3848L7.07091 15.1103C6.88996 14.9645 6.62535 14.9606 6.43907 15.1143C6.25267 15.2682 6.20668 15.529 6.31603 15.7344L6.58458 16.0625C7.68048 17.253 9.25377 18 11.0006 18H17.5006C17.6991 17.9998 17.8791 17.8822 17.9586 17.7002C18.038 17.5181 18.0018 17.3058 17.8668 17.1602L16.0631 15.2178C16.6554 14.2876 17.0006 13.1837 17.0006 12C17.0006 11.3271 16.8891 10.6792 16.6842 10.0742L16.5445 9.72754Z" /></svg></span><h3 class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Designed to strengthen thinking</h3></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-3">Claude’s learning mode works like a good tutor: it asks questions that help you find the answers yourself. For students, that means developing transferable skills. For faculty, that means a thinking partner who can hold the thread of a long research conversation.</p></div></div></div><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:2"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="32" height="32" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M10 2C12.2091 2 14 3.79086 14 6V8H15.5C16.3284 8 17 8.67157 17 9.5V16.5C17 17.3284 16.3284 18 15.5 18H4.5C3.67157 18 3 17.3284 3 16.5V9.5C3 8.67157 3.67157 8 4.5 8H6V6C6 3.79086 7.79086 2 10 2ZM4.5 9C4.22386 9 4 9.22386 4 9.5V16.5C4 16.7761 4.22386 17 4.5 17H15.5C15.7761 17 16 16.7761 16 16.5V9.5C16 9.22386 15.7761 9 15.5 9H4.5ZM10 11C10.6904 11 11.25 11.5596 11.25 12.25C11.25 12.7277 10.9817 13.1421 10.5879 13.3525L11 15H9L9.41113 13.3525C9.01775 13.142 8.75 12.7274 8.75 12.25C8.75 11.5596 9.30964 11 10 11ZM10 3C8.34315 3 7 4.34315 7 6V8H13V6C13 4.34315 11.6569 3 10 3Z" /></svg></span><h3 class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Trusted by institutions that take privacy seriously</h3></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-3">Claude meets the compliance requirements higher education institutions have for student data. We only use data to improve our models when you give permission. Our security standards are designed to meet institutional compliance needs.</p></div></div></div></div></div></div></div></div></section><section id="ctaBanner" data-section="ctaBanner" data-cta-section="ctaBanner" class="SectionWrapper-module-scss-module__NFbz_a__wrapper theme-accent SectionWrapper-module-scss-module__NFbz_a__spacingTopSmall"><div class="container"><div class="AnimatedReveal-module-scss-module__8zH9eW__container" style="--reveal-y:20px;--reveal-duration:0.75s;--reveal-delay:0s;--reveal-stagger:0.1s"><div class="CtaBanner-module-scss-module__0Cqcuq__banner CtaBanner-module-scss-module__0Cqcuq__bannerIvory" style="--reveal-index:0"><div class="CtaBanner-module-scss-module__0Cqcuq__content"><div class="Illustration-module-scss-module__pBGuRG__base Illustration-module-scss-module__pBGuRG__pictogram Illustration-module-scss-module__pBGuRG__size-medium" role="img" aria-label="An apple sitting on top of an open book, rendered in beige and dark brown tones with decorative line details."></div><div class="CtaBanner-module-scss-module__0Cqcuq__text"><p class="Heading-module-scss-module__AyGdUq__heading text-headline-5-serif Heading-module-scss-module__AyGdUq__balance CtaBanner-module-scss-module__0Cqcuq__headline">K-12 teacher? Claude for Teachers is built for you.</p></div></div><div role="group" class="ButtonGroup-module-scss-module__HSKYlq__buttonGroup CtaBanner-module-scss-module__0Cqcuq__ctas"><a href="/solutions/teachers" class="Button-module-scss-module__1SItCG__button Button-module-scss-module__1SItCG__variant-primary Button-module-scss-module__1SItCG__size-main text-body-2" data-cta-position="ctaBanner" data-cta-url="/solutions/teachers">Get verified</a></div></div></div></div></section><section id="featureList" data-section="featureList" data-cta-section="featureList" class="SectionWrapper-module-scss-module__NFbz_a__wrapper theme-main SectionWrapper-module-scss-module__NFbz_a__spacingBottomNone"><div class="SectionWrapper-module-scss-module__NFbz_a__borderTop"></div><div class="container"><div class="grid-12"><div class="FeatureList-module-scss-module__3G7ECW__inner FeatureList-module-scss-module__3G7ECW__fullWidth"><div class="IntroBlock-module-scss-module__0mSC7a__introBlock IntroBlock-module-scss-module__0mSC7a__spacingBelowLarge FeatureList-module-scss-module__3G7ECW__intro" style="--intro-headline-width:30ch;--intro-text-width:45ch"><div class="Illustration-module-scss-module__pBGuRG__base Illustration-module-scss-module__pBGuRG__pictogram Illustration-module-scss-module__pBGuRG__size-large IntroBlock-module-scss-module__0mSC7a__pictogram" role="img" aria-label="Books"></div><h2 class="Heading-module-scss-module__AyGdUq__heading text-headline-1-serif Heading-module-scss-module__AyGdUq__balance AnimatedHeading-module-scss-module__KoWePa__heading IntroBlock-module-scss-module__0mSC7a__headline IntroBlock-module-scss-module__0mSC7a__headlineBalance" style="--word-stagger:0.06666666666666667s" aria-label="Claude for higher education"><span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:0" aria-hidden="true">Claude</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:1" aria-hidden="true">for</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:2" aria-hidden="true">higher</span> <span class="AnimatedHeading-module-scss-module__KoWePa__word" style="--word-index:3" aria-hidden="true">education</span></h2><div class="AnimatedReveal-module-scss-module__8zH9eW__container IntroBlock-module-scss-module__0mSC7a__subheadlineAndCtas" style="--reveal-y:10px;--reveal-duration:0.75s;--reveal-delay:0s;--reveal-stagger:0.1s"><p class="IntroBlock-module-scss-module__0mSC7a__subheadline text-body-large-2" style="--reveal-index:0">A comprehensive university-wide plan for institutions, including its students, faculty, and staff.</p><div role="group" class="ButtonGroup-module-scss-module__HSKYlq__buttonGroup IntroBlock-module-scss-module__0mSC7a__ctas"><a href="/contact-sales/education-plan" class="Button-module-scss-module__1SItCG__button Button-module-scss-module__1SItCG__variant-primary Button-module-scss-module__1SItCG__size-main text-body-2" data-cta-position="featureList" data-cta-url="/contact-sales/education-plan">Contact our Education team</a></div></div></div><div class="AsideRails-module-scss-module__sFf8jW__root" data-aside-rails="hidden"><div class="AsideRails-module-scss-module__sFf8jW__content AsideRails-module-scss-module__sFf8jW__contentNarrow"><div class="AnimatedReveal-module-scss-module__8zH9eW__container FeatureList-module-scss-module__3G7ECW__list FeatureList-module-scss-module__3G7ECW__vertical FeatureList-module-scss-module__3G7ECW__railed" style="--reveal-y:20px;--reveal-duration:0.75s;--reveal-delay:0s;--reveal-stagger:0.1s"><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:0"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M9.82227 3.03223C9.95577 2.98149 10.1064 2.99085 10.2344 3.05859L18.7344 7.55859C18.8977 7.64533 19 7.81501 19 8C19 8.185 18.8977 8.35466 18.7344 8.44141L16.9805 9.36914C16.9919 9.41102 17 9.45452 17 9.5V13.1113C16.9999 13.4845 16.8596 13.862 16.5674 14.1377C16.2667 14.4214 15.7273 14.8927 15 15.3721V17.5C15 17.7761 14.7761 18 14.5 18C14.2239 18 14 17.7761 14 17.5V15.957C12.8979 16.5301 11.532 17 10 17C7.15439 17 4.87641 15.3894 3.8125 14.4785L3.43262 14.1377C3.14045 13.862 3.00008 13.4845 3 13.1113V9.5C3 9.45461 3.00722 9.41095 3.01855 9.36914L1.26562 8.44141C1.10227 8.35466 1 8.185 1 8C1.00001 7.81501 1.10227 7.64533 1.26562 7.55859L9.76562 3.05859L9.82227 3.03223ZM4 13.1113C4.00008 13.2383 4.04751 13.3426 4.11914 13.4102L4.47461 13.7295C5.46045 14.5708 7.5074 16 10 16C11.558 16 12.9406 15.4397 14 14.8154V10.9473L10.2344 12.9414C10.088 13.0189 9.91197 13.0189 9.76562 12.9414L4 9.88867V13.1113ZM14.9902 10.4229C14.9942 10.4483 15 10.4737 15 10.5V14.1484C15.3834 13.8602 15.6826 13.5972 15.8809 13.4102C15.9525 13.3426 15.9999 13.2383 16 13.1113V9.88867L14.9902 10.4229ZM2.56738 8L10 11.9336L13.0986 10.293L9.75684 8.4375L9.67383 8.37891C9.49755 8.22746 9.44522 7.96793 9.5625 7.75684C9.67978 7.54585 9.92776 7.45286 10.1494 7.52246L10.2432 7.5625L14.1533 9.73438L17.4316 8L10 4.06543L2.56738 8Z" /></svg></span><h3 class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Faculty</h3></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-2">Claude helps you build richer course materials faster, starting from your expertise rather than a blank page. Draft syllabi, design assignments that require original thinking, and work through where students are likely to get stuck before you&#x27;re in the room with them.</p></div></div></div><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:1"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M14.5 2C15.3284 2 16 2.67157 16 3.5V16.5C16 17.3284 15.3284 18 14.5 18H6.375C5.06332 18 4 16.9367 4 15.625V4.375C4 3.06332 5.06332 2 6.375 2H14.5ZM15 13.9121C14.8434 13.9676 14.6756 14 14.5 14H6.375C5.61561 14 5 14.6156 5 15.375V15.625C5 16.3844 5.61561 17 6.375 17H14.5C14.7761 17 15 16.7761 15 16.5V13.9121ZM6.375 3C5.61561 3 5 3.61561 5 4.375V13.4395C5.38814 13.1632 5.86232 13 6.375 13H14.5C14.7761 13 15 12.7761 15 12.5V3.5C15 3.22386 14.7761 3 14.5 3H6.375ZM12.54 6.30371C12.6486 6.05001 12.9425 5.93174 13.1963 6.04004C13.45 6.14863 13.5683 6.44253 13.46 6.69629C13.1651 7.38527 12.589 8 11.7998 8C11.3132 7.99994 10.908 7.76633 10.5996 7.42578C10.2913 7.76607 9.88667 7.99987 9.40039 8C8.91365 8 8.50769 7.76648 8.19922 7.42578C7.89083 7.76606 7.48636 8 7 8C6.72386 8 6.5 7.77614 6.5 7.5C6.5 7.22386 6.72386 7 7 7C7.21245 7 7.51918 6.8199 7.74023 6.30371L7.77441 6.2373C7.86451 6.09126 8.02513 6 8.2002 6C8.40022 6.00008 8.58145 6.11981 8.66016 6.30371C8.88121 6.8198 9.18796 7 9.40039 7C9.61284 6.99978 9.9197 6.81969 10.1406 6.30371L10.1748 6.2373C10.2649 6.09147 10.4248 6.00014 10.5996 6C10.7997 6 10.9808 6.11975 11.0596 6.30371C11.2806 6.8198 11.5874 6.99989 11.7998 7C12.0122 7 12.319 6.81985 12.54 6.30371Z" /></svg></span><h3 class="Heading-module-scss-module__AyGdUq__heading text-headline-6-serif Heading-module-scss-module__AyGdUq__balance FeatureList-module-scss-module__3G7ECW__title">Researchers</h3></div><div class="FeatureList-module-scss-module__3G7ECW__itemContent"><div class="text-rich-text FeatureList-module-scss-module__3G7ECW__body"><p class="text-body-2">Claude can work through literature spanning hundreds of papers, refine a methodology section, or interpret a dataset. The Claude Science app, an AI workbench for scientists, integrates the tools researchers commonly use, produces auditable artifacts, and provides flexible access to computing resources.</p></div></div></div><div class="FeatureList-module-scss-module__3G7ECW__item" style="--reveal-index:2"><div class="FeatureList-module-scss-module__3G7ECW__itemHeader"><span class="FeatureList-module-scss-module__3G7ECW__eyebrow text-body-3"><svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="FeatureList-module-scss-module__3G7ECW__itemIcon" aria-hidden="true"><path d="M9.9998 13C11.0037 13 12.0092 13.1245 12.8191 13.5342C13.6596 13.9595 14.2662 14.6825 14.4451 15.7861L14.4588 15.917C14.4852 16.5558 13.9246 16.9998 13.3641 17H6.63554C6.0375 16.9996 5.43973 16.4942 5.55448 15.7861C5.73337 14.6825 6.34004 13.9595 7.18046 13.5342C7.99033 13.1245 8.99592 13 9.9998 13ZM9.9998 14C9.05381 14 8.23502 14.122 7.63261 14.4268C7.06101 14.716 6.66665 15.1759 6.54179 15.9463C6.54099 15.9513 6.54156 15.9534 6.54179 15.9541C6.54214 15.9552 6.54387 15.9607 6.55058 15.9678C6.56551 15.9833 6.59564 15.9998 6.63554 16H13.3641C13.404 15.9999 13.434 15.9833 13.449 15.9678C13.4557 15.9608 13.4574 15.9553 13.4578 15.9541V15.9463C13.3329 15.1759 12.9387 14.716 12.367 14.4268C11.7645 14.1221 10.9458 14 9.9998 14ZM6.49979 8C6.77594 8 6.99979 8.22386 6.99979 8.5C6.99979 8.77614 6.77594 9 6.49979 9C5.55381 9.00002 4.73502 9.12205 4.13261 9.42676C3.59664 9.69794 3.21637 10.1191 3.06815 10.8057L3.04178 10.9463C3.04099 10.9513 3.04156 10.9534 3.04178 10.9541C3.04214 10.9552 3.04386 10.9607 3.05057 10.9678C3.06551 10.9833 3.09563 10.9998 3.13553 11H6.49979C6.77594 11 6.99979 