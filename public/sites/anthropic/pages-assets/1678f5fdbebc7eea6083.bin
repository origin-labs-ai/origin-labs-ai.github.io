xt\":\"For workloads that need to run in the US, US-only inference is available at 1.1x pricing for input and output tokens. \u003ca\u003eLearn more\u003c/a\u003e.\",\"x5Tz6MZH82\":\"Report\",\"xDe1e0b5He\":\"Build and deploy agents at scale with a suite of composable APIs. Standard token rates apply.\",\"xEdLVyUWKy\":\"{count, plural, one {# suggestion available} other {# suggestions available}}\",\"xKT9sxXpth\":\"The recording is hosted on Goldcast.\",\"xPocsFdsxB\":\"Download for macOS\",\"xRlCRvq1eb\":\"Mid-Market (500–2,500 employees)\",\"xS8UPT51Av\":\"Frontier intelligence\",\"xZ32TgBrJd\":\"Teach Claude new skills, record them, and share with your team.\",\"xkBp8oUi5D\":\"Seat price + usage at API rates\",\"xm/imQIAg1\":\"Platform Migration to Claude\",\"xmcVZ0BU63\":\"Search\",\"xnIL1QhMex\":\"Assessment / Discovery\",\"xs1IOq2Eot\":\"Professional \u0026 Legal Services\",\"xuvqDom+3a\":\"Showing {shown} of {total, plural, one {# resource} other {# resources}}\",\"xvr9jTOkwd\":\"Per seat / month if billed annually. \u003cstandard\u003e$25\u003c/standard\u003e if billed monthly.\",\"xwEc8KM8zK\":\"API\",\"xxJ2VaKdTD\":\"Full prices shown\",\"xy4ILTz0kb\":\"Redline four clauses, flag two the playbook doesn’t cover\",\"y+5dHFQ7v1\":\"{name} connector\",\"y1RCVb0hLq\":\"Single sign-on is currently available in Team and Enterprise plans. Domain capture is currently available in Enterprise plans.\",\"y2oSYL98Q0\":\"Reply when Claude needs you\",\"y8DOZmSmUC\":\"Add plugins from the marketplace to extend what Claude can do.\",\"yDXILUX2pk\":\"Su"])</script><script nonce="v5wp05ook0i/Ake2Hk8yQQ==">self.__next_f.push([1,"rvey to exec readout\",\"yQXnuUq8b5\":\"Latest models\",\"ySTYWchNUB\":\"Free for everyone\",\"yURinUUif2\":\"Partnership\",\"yYVmNrJxqx\":\"{title} preview\",\"yZJxVSJosU\":\"Developer\",\"yZs9WUVaoC\":\"(opens in new tab)\",\"yhU1etXT1A\":\"Tasks\",\"yifD/aLOux\":\"Deploying through the API or a cloud provider? \u003ca\u003eSee your options\u003c/a