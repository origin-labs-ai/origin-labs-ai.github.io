"width\":174,\"unoptimized\":true}]}],[\"$\",\"p\",null,{\"className\":\"tOQyXa_body-2--serif kMpfDa_tagline\",\"data-component\":\"Body\",\"children\":\"Hybrid reasoning model with fast, cost-efficient intelligence for well-scoped coding and knowledge work, featuring a 1M context window\"}],[\"$\",\"div\",null,{\"className\":\"DBorwq_wrapper kMpfDa_button-group\",\"data-theme\":\"ivory\",\"children\":[[\"$\",\"$L70\",\"0\",{\"className\":\"DBorwq_button\",\"link\":{\"_type\":\"link\",\"text\":\"Try Claude\",\"url\":\"https://claude.ai/\",\"page\":null,\"modalId\":null,\"fileAsset\":null,\"openInNewTab\":null},\"variant\":\"primary\",\"size\":\"medium\",\"tracking\":{\"text\":\"Try Claude\",\"position\":\"heroModel\"}}],[\"$\",\"$L70\",\"1\",{\"className\":\"DBorwq_button\",\"link\":{\"_type\":\"link\",\"text\":\"Get API access\",\"url\":\"https://platform.claude.com/\",\"page\":null,\"modalId\":null,\"fileAsset\":null,\"openInNewTab\":null},\"variant\":\"secondary\",\"size\":\"medium\",\"tracking\":{\"text\":\"Get API access\",\"position\":\"heroModel\"}}]]}]]}]]}]]}],[\"$\",\"$1\",\"1\",{\"children\":[null,[\"$\",\"section\",null,{\"className\":\"ZSMdoa_root theme-ivory theme-surface ZSMdoa_flushBottom ZSMdoa_flushTop\",\"id\":\"$undefined\",\"ref\":\"$undefined\",\"style\":\"$undefined\",\"data-theme\":\"ivory\",\"data-nav-surface\":\"ivory-light\",\"children\":[\"$undefined\",[\"$\",\"$L71\",null,{\"body\":[{\"_key\":\"0b559dcb83f0\",\"_type\":\"block\",\"children\":[{\"_key\":\"62bc8e690f4c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Announcements\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"25b86a8f0b4b\",\"_type\":\"latestUpdates\",\"updates\":[{\"_key\":\"b74612338b055871f82f45a074a5cc6c\",\"date\":\"2026-09-28\",\"label\":\"NEW\",\"summary\":\"A clear upgrade over Sonnet 5 that runs 30% faster and costs up to 30% less for most work.\",\"title\":\"Claude Sonnet 5.5\",\"url\":\"https://www.anthropic.com/claude-sonnet-5-5\",\"link\":null},{\"_key\":\"53242463e1fd\",\"date\":\"2026-06-30\",\"link\":{\"_type\":\"post\",\"slug\":{\"_type\":\"slug\",\"current\":\"claude-sonnet-5\"},\"directories\":[{\"value\":\"news\"}]},\"summary\":\"Our most agentic Sonnet yet. It brings performance that recently required larger, more expensive models to coding, tool use, and everyday work, at Sonnet’s speed and price.\",\"title\":\"Claude Sonnet 5\"},{\"_key\":\"86b9f7165dc1\",\"date\":\"2026-02-17\",\"link\":{\"_type\":\"post\",\"slug\":{\"_type\":\"slug\",\"current\":\"claude-sonnet-4-6\"},\"directories\":[{\"value\":\"news\"}]},\"noSnippet\":true,\"summary\":\"Sonnet 4.6 delivers frontier performance across coding, agents, and professional work at scale. It can compress multi-day coding projects into hours and deliver production-ready solutions.\",\"title\":\"Claude Sonnet 4.6\"},{\"_key\":\"09dce6008071\",\"date\":\"2025-09-29\",\"link\":{\"_type\":\"post\",\"slug\":{\"_type\":\"slug\",\"current\":\"claude-sonnet-4-5\"},\"directories\":[{\"value\":\"news\"}]},\"noSnippet\":true,\"summary\":\"Sonnet 4.5 is the best model in the world for agents, coding, and computer use.  It’s also our most accurate and detailed model for long-running tasks, with enhanced domain knowledge in coding, finance, and cybersecurity.\",\"title\":\"Claude Sonnet 4.5 \"},{\"_key\":\"7d980a6d5387\",\"date\":\"2025-05-22\",\"link\":{\"_type\":\"post\",\"slug\":{\"_type\":\"slug\",\"current\":\"claude-4\"},\"directories\":[{\"value\":\"news\"}]},\"noSnippet\":true,\"summary\":\"Sonnet 4 improves on Sonnet 3.7 across a variety of areas, especially coding. It offers frontier performance that’s practical for most AI use cases, including user-facing AI assistants and high-volume tasks.\",\"title\":\"Claude Sonnet 4\"}],\"markDefs\":null},{\"_key\":\"4a10161c1f6d\",\"_type\":\"block\",\"children\":[{\"_key\":\"402d6c317d950\",\"_type\":\"span\",\"marks\":[],\"text\":\"Availability and pricing\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"4f1e019a4ac0\",\"_type\":\"block\",\"children\":[{\"_key\":\"31d2d9ca9b77\",\"_type\":\"span\",\"marks\":[],\"text\":\"Anyone can chat with Claude using Sonnet 5.5 on Claude.ai, available on web, iOS, and Android.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"228bd124caaa\",\"_type\":\"block\",\"children\":[{\"_key\":\"b3cf7cd5ab79\",\"_type\":\"span\",\"marks\":[],\"text\":\"For developers interested in building agents, Sonnet 5.5 is available on the Claude Platform natively, and in Amazon Web Services, Google Cloud, and Microsoft Foundry.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1a4eee85f885\",\"_type\":\"block\",\"children\":[{\"_key\":\"6a3db3532768\",\"_type\":\"span\",\"marks\":[],\"text\":\"Pricing for Sonnet 5.5 will cost up to an estimated 30% less to run than Sonnet 5 for typical workloads billed by token.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a0c978f35de0\",\"_type\":\"block\",\"children\":[{\"_key\":\"3014a96cd059\",\"_type\":\"span\",\"marks\":[],\"text\":\"Sonnet 5.5 is priced at $2 per million input tokens and $10 per million output tokens, with up to 90% cost savings with \"},{\"_key\":\"5c4f13c71b72\",\"_type\":\"span\",\"marks\":[\"6391cf41ec8c\"],\"text\":\"prompt caching\"},{\"_key\":\"f5e242053331\",\"_type\":\"span\",\"marks\":[],\"text\":\" and 50% cost savings with \"},{\"_key\":\"37e77873c067\",\"_type\":\"span\",\"marks\":[\"b1ba4e392b0c\"],\"text\":\"batch processing\"},{\"_key\":\"f086fdd203ef\",\"_type\":\"span\",\"marks\":[],\"text\":\". To learn more, check out our \"},{\"_key\":\"6fa0670b844e\",\"_type\":\"span\",\"marks\":[\"0bb895ed37a1\"],\"text\":\"pricing page\"},{\"_key\":\"d2cd88d8e5d1\",\"_type\":\"span\",\"marks\":[],\"text\":\". To get started, simply use \"},{\"_key\":\"185e649af5b1\",\"_type\":\"span\",\"marks\":[\"code\"],\"text\":\"claude-sonnet-5-5\"},{\"_key\":\"fc6e70f6fef8\",\"_type\":\"span\",\"marks\":[],\"text\":\" via the \"},{\"_key\":\"dc748f40059c\",\"_type\":\"span\",\"marks\":[\"d55de8932b2f\"],\"text\":\"Claude API\"},{\"_key\":\"9206501c3676\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"6391cf41ec8c\",\"_type\":\"link\",\"href\":\"https://platform.claude.com/docs/en/build-with-claude/prompt-caching\"},{\"_key\":\"b1ba4e392b0c\",\"_type\":\"link\",\"href\":\"https://platform.claude.com/docs/en/build-with-claude/batch-processing#pricing\"},{\"_key\":\"0bb895ed37a1\",\"_type\":\"link\",\"href\":\"https://claude.com/pricing#api\"},{\"_key\":\"d55de8932b2f\",\"_type\":\"link\",\"href\":\"https://platform.claude.com/docs/en/about-claude/models/overview\"}],\"style\":\"normal\"},{\"_key\":\"426935ab8317\",\"_type\":\"block\",\"children\":[{\"_key\":\"4e3337993e76\",\"_type\":\"span\",\"marks\":[],\"text\":\"For workloads that need to run in the US, US-only inference is available at 1.1x pricing for input and output tokens. \"},{\"_key\":\"1c294686ca24\",\"_type\":\"span\",\"marks\":[\"c34e88b0af92\"],\"text\":\"Learn more\"},{\"_key\":\"58aebccc1e97\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"c34e88b0af92\",\"_type\":\"link\",\"href\":\"https://platform.claude.com/docs/en/build-with-claude/data-residency\"}],\"style\":\"normal\"},{\"_key\":\"0bfe64f05759\",\"_type\":\"block\",\"children\":[{\"_key\":\"d53ba738f6380\",\"_type\":\"span\",\"marks\":[],\"text\":\"Use cases\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"ba5962818380\",\"_type\":\"block\",\"children\":[{\"_key\":\"26148d6fe46d\",\"_type\":\"span\",\"marks\":[],\"text\":\"Sonnet 5.5 is a faster, lower-cost complement to Opus 5.5. It excels at well-scoped everyday tasks across coding, agents, and knowledge work.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e1643c52a2ba\",\"_type\":\"block\",\"children\":[{\"_key\":\"3f62361d5b3c\",\"_type\":\"span\",\"marks\":[],\"text\":\"API users have fine-grained control over the model’s thinking effort. Popular use cases include:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"870a15cfda0b\",\"_type\":\"block\",\"children\":[{\"_key\":\"b03ba547ec43\",\"_type\":\"span\",\"marks\":[],\"text\":\"Coding\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"3dd14acf3574\",\"_type\":\"block\",\"children\":[{\"_key\":\"0f2f0d844a9c\",\"_type\":\"span\",\"marks\":[],\"text\":\"Sonnet 5.5 delivers exceptional coding performance across the entire software development lifecycle. It gets up to speed on a codebase quickly, scopes changes before it starts, and keeps edits small enough to review. It’s built for everyday development like building features, fixing bugs, and reviewing code.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5feb54c13361\",\"_type\":\"block\",\"children\":[{\"_key\":\"094e6b4989f10\",\"_type\":\"span\",\"marks\":[],\"text\":\"Agents\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"17b72c013b86\",\"_type\":\"block\",\"children\":[{\"_key\":\"97e86c640c8c\",\"_type\":\"span\",\"marks\":[],\"text\":\"Sonnet 5.5 takes on well-defined agent tasks that need reliable execution, like investigation, review, and drafting. It’s the strongest Sonnet yet on long-horizon tasks, and it needs far fewer tokens than Sonnet 5, making it practical to run repeatedly.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b65f59f97648\",\"_type\":\"block\",\"children\":[{\"_key\":\"26b5e91a078e0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Design and visual work\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"95bd0b7db059\",\"_type\":\"block\",\"children\":[{\"_key\":\"09c7474ec7f6\",\"_type\":\"span\",\"marks\":[],\"text\":\"Sonnet 5.5 is tasteful, with a strong eye for design. It adds polish to user interfaces, creates clearly structured diagrams and user flows, and follows templates to build slides that need minimal editing.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"41bc822a7f26\",\"_type\":\"block\",\"children\":[{\"_key\":\"4a6f622b92d70\",\"_type\":\"span\",\"marks\":[],\"text\":\"Enterprise workflows\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"7caa2f16288f\",\"_type\":\"block\",\"children\":[{\"_key\":\"eb873cab6432\",\"_type\":\"span\",\"marks\":[],\"text\":\"Sonnet 5.5 brings improvements across knowledge work and office tasks, from analysis to documents and slides. Its writing is clearer and more direct, so drafts need less cleanup.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9ea433c74dc3\",\"_type\":\"block\",\"children\":[{\"_key\":\"dfb2666e13c40\",\"_type\":\"span\",\"marks\":[],\"text\":\"Benchmarks\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"0607a533846b\",\"_type\":\"block\",\"children\":[{\"_key\":\"d899493f3d49\",\"_type\":\"span\",\"marks\":[],\"text\":\"Sonnet 5.5 delivers strong results across the benchmarks that matter most for real-world deployment, from coding, and knowledge work to computer use.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6d1f841d5eb0\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-e81e4ffa8b5008c6817036fe1e7ba2f1ac4c1c70-2160x2240-png\",\"_type\":\"reference\"},\"columnWidth\":\"full-width\",\"description\":\"Claude Sonnet 5.5 benchmark table\",\"caption\":null,\"height\":2240,\"mimeType\":\"image/png\",\"url\":\"https://assets.claude.com/e81e4ffa8b5008c6817036fe1e7ba2f1ac4c1c70.png\",\"width\":2160,\"markDefs\":null},{\"_key\":\"8981dd851f83\",\"_type\":\"block\",\"children\":[{\"_key\":\"ce99368807340\",\"_type\":\"span\",\"marks\":[],\"text\":\"Trust \u0026 Safety\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"db46adccaed6\",\"_type\":\"block\",\"children\":[{\"_key\":\"02c3fa2c5cc4\",\"_type\":\"span\",\"marks\":[],\"text\":\"We’ve tested and evaluated Sonnet 5.5 against our standards for safety, security, and reliability. The accompanying \"},{\"_key\":\"01dd5c570a77\",\"_type\":\"span\",\"marks\":[\"8149a99f743c\"],\"text\":\"system card\"},{\"_key\":\"2db4efe85224\",\"_type\":\"span\",\"marks\":[],\"text\":\" covers safety results in depth.\"}],\"markDefs\":[{\"_key\":\"8149a99f743c\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/claude-sonnet-5-5-system-card\"}],\"style\":\"normal\"},{\"_key\":\"ad351de677c3\",\"_type\":\"block\",\"children\":[{\"_key\":\"09623ba929c2\",\"_type\":\"span\",\"marks\":[],\"text\":\"Hear from our customers\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"21d9bda488ce\",\"_type\":\"quoteCarousel\",\"backgroundColor\":\"ivory-medium\",\"quotes\":[{\"_key\":\"8bb1f60824e3\",\"_type\":\"quote\",\"logo\":{\"description\":null,\"height\":32,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/2599436d354b7f746d44ed4345dea6d1f857fd9a.svg\",\"width\":91},\"quote\":[{\"_key\":\"1c844106cfcc\",\"_type\":\"block\",\"children\":[{\"_key\":\"114e39604edf\",\"_type\":\"span\",\"marks\":[],\"text\":\"Without changing any of our prompts, Claude Sonnet 5.5 did better than Sonnet 5 on almost all of our offline Slackbot evals, in fewer steps and with about 14% fewer output tokens. When someone gives Slackbot a task, quality and speed are what matter most, and Sonnet 5.5 allows Slackbot to deliver better outcomes for users, faster.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"speakerName\":\"Curtis Allen\",\"speakerTitle\":\"Principal Engineer\"},{\"_key\":\"965747f81136\",\"_type\":\"quote\",\"logo\":{\"description\":null,\"height\":26,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/67f886abd6698ebbd626826177119c80a728190d.svg\",\"width\":52},\"quote\":[{\"_key\":\"759b7ec8d41b\",\"_type\":\"block\",\"children\":[{\"_key\":\"3ed8ae285cb5\",\"_type\":\"span\",\"marks\":[],\"text\":\"Claude Sonnet 5.5 will give our customers in financial services and healthcare the confidence to use it for their most sensitive work. Sonnet 5.5 rechecks data in source documents, catching errors that Sonnet 5 failed to spot. Compared to the last model, Sonnet 5.5 was more accurate, 2.4x faster, and used 12% fewer total tokens.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"speakerName\":\"Yashodha Bhavnani\",\"speakerTitle\":\"VP of AI Products\"},{\"_key\":\"e9ced0212503\",\"_type\":\"quote\",\"logo\":{\"description\":null,\"height\":34,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/4399b675f18ab031c4d90360f03b115c8e3a8a19.svg\",\"width\":98},\"quote\":[{\"_key\":\"b35ec6a93341\",\"_type\":\"block\",\"children\":[{\"_key\":\"f76e5ec9b4d9\",\"_type\":\"span\",\"marks\":[],\"text\":\"At Unity, we have a high bar for task completion. Projects are reopened and results are checked at runtime, so a task only counts when the change works, not when the model says it's done. The majority of Claude Sonnet 5.5's work passed that check. It also completed 90% of tasks in our multi-step Unity Editor and coding benchmark, beating similar models.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"speakerName\":\"Sam Zhang\",\"speakerTitle\":\"Creative Technologist\"},{\"_key\":\"43c38a3fd8ed\",\"_type\":\"quote\",\"logo\":{\"description\":null,\"height\":64,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/f3a8f51a7cb7298ec517369041d07e7d7a469a50.svg\",\"width\":171},\"quote\":[{\"_key\":\"ca236a35a566\",\"_type\":\"block\",\"children\":[{\"_key\":\"1da80688b92f\",\"_type\":\"span\",\"marks\":[],\"text\":\"Claude Sonnet 5.5 shows better judgment than Sonnet 5 across different levels of complexity, while spending significantly fewer output tokens. Sonnet 5’s tendency to reach for web search too often and its high token use are both gone in this new model. We plan to move simple and moderate reviews over now, and more in the coming weeks.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"speakerName\":\"David Loker\",\"speakerTitle\":\"VP of AI\"},{\"_key\":\"1fb81277c1e5\",\"_type\":\"quote\",\"logo\":{\"description\":null,\"height\":16,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/f6075a23833cc3a64298b9d796786e8b664381cf.svg\",\"width\":84},\"quote\":[{\"_key\":\"07ef64c93b0d\",\"_type\":\"block\",\"children\":[{\"_key\":\"ee5ec995062c\",\"_type\":\"span\",\"marks\":[],\"text\":\"We fed Claude Sonnet 5.5 hundreds of real support use cases across replies and escalation requests. It made fewer wrong decisions and resolved tickets faster than the Claude models we use in production today. Tickets were processed 20% faster, getting our customers the help they need without the wait.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"speakerName\":\"Abhinay Kathuria\",\"speakerTitle\":\"Director of AI\"},{\"_key\":\"fce08ea9bc15\",\"_type\":\"quote\",\"logo\":{\"description\":null,\"height\":24,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/4870b3d6c0253cea01b100c98ad2030b8e4f8ce1.svg\",\"width\":189},\"quote\":[{\"_key\":\"71d597d24988\",\"_type\":\"block\",\"children\":[{\"_key\":\"9ec9fd49ba3f\",\"_type\":\"span\",\"marks\":[],\"text\":\"With millions of AI-assisted actions powering our customers’ workflows each month, execution speed is critical. Claude Sonnet 5.5 will allow teams to run their agents up to 30% faster than they could with Sonnet 5. I’m excited to offer our customers this choice.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"speakerName\":\"Jamil Valliani\",\"speakerTitle\":\"Head of Product, AI\"},{\"_key\":\"4f04f3d507e5\",\"_type\":\"quote\",\"logo\":{\"description\":null,\"height\":25,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/5dd8250e63db6819dbadd73e8bc35953742e3a5c.svg\",\"width\":204},\"quote\":[{\"_key\":\"9060ea12cb56\",\"_type\":\"block\",\"children\":[{\"_key\":\"9569a8d0f507\",\"_type\":\"span\",\"marks\":[],\"text\":\"Claude Sonnet 5.5 delivers frontier-level performance on CursorBench 4.0 at 55.5%, second only to Opus 5.5. We think it will be a hit with developers looking to balance performance with cost.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"speakerName\":\"Sualeh Asif\",\"speakerTitle\":\"Director of ML\"},{\"_key\":\"fb757de643f9\",\"_type\":\"quote\",\"logo\":{\"description\":null,\"height\":751,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/f80d9c77010ed5a30c7e315ffb66df3c883d44a3.svg\",\"width\":647},\"quote\":[{\"_key\":\"9811e908ef28\",\"_type\":\"block\",\"children\":[{\"_key\":\"aa23655fe768\",\"_type\":\"span\",\"marks\":[],\"text\":\"In Epic’s early testing, Claude Sonnet 5.5 cleared the same quality bar you’d expect from a higher-tier model, holding up on a system design audit and a data-flow review. The new model managed tens of thousands of lines of code for gameplay system architecture, kept responses snappy, handled multi-hour tasks, and delivered with less prescriptive prompting.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"speakerName\":\"Daniel Vogel\",\"speakerTitle\":\"Chief Operating Officer\"},{\"_key\":\"9727d468e0df\",\"_type\":\"quote\",\"logo\":{\"description\":null,\"height\":64,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/3917c09ca128a79ca578bfd892b869199094ce00.svg\",\"width\":138},\"quote\":[{\"_key\":\"fcdcaf647e24\",\"_type\":\"block\",\"children\":[{\"_key\":\"5f56a05671ef\",\"_type\":\"span\",\"marks\":[],\"text\":\"Across 118 real app builds, Claude Sonnet 5.5 produced apps that scored level with Opus 5. It got there in 3.6 iterations per build on average, where Opus 5 took 7.7. It had the fewest failed tool calls of any model we compared. It also rarely stopped mid-build to ask the user a question, so fewer builds stall waiting on someone to answer.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"speakerName\":\"Gabriel Grinberg\",\"speakerTitle\":\"AI Engineering Lead\"},{\"_key\":\"9e8a3f9c29c6\",\"_type\":\"quote\",\"logo\":{\"description\":null,\"height\":64,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/7174dce5a19b00932761c60d1833240d2dd9679e.svg\",\"width\":146},\"quote\":[{\"_key\":\"8949f2425c7f\",\"_type\":\"block\",\"children\":[{\"_key\":\"a331f1d44e2d\",\"_type\":\"span\",\"marks\":[],\"text\":\"On our private suite of 2,441 finance tasks covering Q\u0026A, extraction, analysis, and forecasting, Claude Sonnet 5.5 scored ahead of Sonnet 5 and used about 121k tokens per answer where Sonnet 5 used 497k. On our analyst search and retrieval work, it was better than Sonnet 5 in almost every way. For high-volume workflows, it had the best quality-to-cost tradeoff of the seven models we ran.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"speakerName\":\"Joe Poirier\",\"speakerTitle\":\"Senior AI Engineer\"},{\"_key\":\"cc22c4a0fd99\",\"_type\":\"quote\",\"logo\":{\"description\":null,\"height\":64,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/eac384e0d3c30ba54a4b7bf270b7781ab9ce3d9a.svg\",\"width\":115},\"quote\":[{\"_key\":\"93de8a8235fe\",\"_type\":\"block\",\"children\":[{\"_key\":\"76e8eb7d409f\",\"_type\":\"span\",\"marks\":[],\"text\":\"Claude Sonnet 5.5 cooks. Fast at coding and can be steered quickly in iterative workflows. But it can still work long if it needs to. It’s got some of Opus 5.5’s natural writing upgrades, which makes it more fun to work with. I’m switching to it for my day-to-day coding.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"speakerName\":\"Tyler Nishida\",\"speakerTitle\":\"Designer\"},{\"_key\":\"8c0b58aa989c\",\"_type\":\"quote\",\"logo\":{\"description\":null,\"height\":64,\"mimeType\":\"image/svg+xml\",\"url\":\"https://assets.claude.com/0eb54af78f471540004bbb43ae3a68b8a26e9930.svg\",\"width\":133},\"quote\":[{\"_key\":\"080c32b59e12\",\"_type\":\"block\",\"children\":[{\"_key\":\"9eb60bb877f8\",\"_type\":\"span\",\"marks\":[],\"text\":\"Claude Sonnet 5.5 thinks in fewer, more robust steps, so builders wait less to see progress. Our coding evals showed a third fewer tool calls and roughly half the shell runs to finish a task. For everyday coding and higher-effort conversations, that means faster iteration and a smoother build loop.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"speakerName\":\"Fabian Hedin\",\"speakerTitle\":\"Co-founder and CTO\"}],\"markDefs\":null}],\"tableOfContents\":\"$undefined\",\"downloads\":null}]]}]]}],\"$L72\",\"$L73\"]]}]\n18:[[\"$\",\"title\",\"0\",{\"children\":\"Claude Sonnet \\\\ Anthropic\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Hybrid reasoning model with fast, capable intelligence for real-time agents and high-volume work, featuring a 1M context window\"}],[\"$\",\"meta\",\"2\",{\"name\":\"msapplication-TileColor\",\"content\":\"141413\"}],[\"$\",\"meta\",\"3\",{\"name\":\"msapplication-config\",\"content\":\"/browserconfig.xml\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://www.anthropic.com/claude/sonnet\"}],[\"$\",\"meta\",\"5\",{\"name\":\"google-site-verification\",\"content\":\"BqiAW_sWOg-KrPk-Accxm6ge9dtnFEyV6DB6vzVZSGs\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:title\",\"content\":\"Claude Sonnet\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:description\",\"content\":\"Hybrid reasoning model with fast, capable intelligence for real-time agents and high-volume work, featuring a 1M context window\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:url\",\"content\":\"https://www.anthropic.com/claude/sonnet\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:image\",\"content\":\"https://assets.claude.com/9181e8c226d4d79a4b0732bcb8939768ae1a460b.jpg\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:image:alt\",\"content\":\"Claude Sonnet logo\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:site\",\"content\":\"@AnthropicAI\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:creator\",\"content\":\"@AnthropicAI\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:title\",\"content\":\"Claude Sonnet\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:description\",\"content\":\"Hybrid reasoning model with fast, capable intelligence for real-time agents and high-volume work, featuring a 1M context window\"}],[\"$\",\"meta\",\"17\",{\"name\":\"twitter:image\",\"content\":\"https://a