dren\":[[\"$\",\"$L99\",null,{\"size\":\"sm\",\"headingFont\":\"serif\",\"spacing\":\"lg\",\"className\":\"docs-prose\",\"children\":[[\"$\",\"$L9a\",null,{\"title\":\"Mitigate jailbreaks and prompt injections\",\"description\":\"Defend your application against jailbreaks and prompt injection with input screening, hardened system prompts, and safe handling of untrusted tool content.\",\"actions\":[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 print:hidden\",\"children\":[false,[\"$\",\"$L9c\",null,{\"servedLocale\":\"en\"}]]}]}],[\"$\",\"div\",null,{\"data-not-prose\":true,\"className\":\"mt-0 mb-lg lg:hidden print:hidden\",\"children\":\"$7c:props:children:1:2:props:children:1:props:children:0:props:children:0:props:actions\"}],null,null,\"$undefined\",\"$undefined\",[[\"$\",\"p\",\"0\",{\"children\":[\"Jailbreaking and prompt injection are attempts to make Claude ignore its guidelines or your instructions. Although Claude is inherently resilient to such attacks, the additional steps on this page strengthen your guardrails, particularly against uses that violate Anthropic’s \",[\"$\",\"$L9d\",\"1\",{\"href\":\"https://www.anthropic.com/legal/commercial-terms\",\"untracked\":false,\"children\":[\"Terms of Service\"]}],\" or \",[\"$\",\"$L9d\",\"3\",{\"href\":\"https://www.anthropic.com/legal/aup\",\"untracked\":false,\"children\":[\"Usage Policy\"]}],\".\"]}],\"\\n\",[\"$\",\"p\",\"2\",{\"children\":[\"These attacks fall into two categories with different threat models:\"]}],\"\\n\",[\"$\",\"ul\",\"4\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Jailbreaks and direct prompt injection\"]}],\", where the \",[\"$\",\"em\",\"2\",{\"children\":[\"user\"]}],\" of your application is the adversary and crafts inputs intended to bypass your guardrails.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Indirect prompt injection\"]}],\", where the user is trusted but Claude processes \",[\"$\",\"em\",\"2\",{\"children\":[\"third-party content\"]}],\" (webpages, emails, documents, tool results) that contains adversarial instructions.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"h2\",\"6\",{\"id\":\"jailbreaks-and-direct-prompt-injection\",\"className\":\"group\",\"children\":[[\"Jailbreaks and direct prompt injection\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L9e\",null,{\"id\":\"jailbreaks-and-direct-prompt-injection\",\"name\":\"Jailbreaks and direct prompt injection\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}],\"\\n\",[\"$\",\"p\",\"8\",{\"children\":[\"In this threat model, a user is deliberately crafting inputs to manipulate your application into producing content or taking actions you don’t want it to. These mitigations strengthen your application’s guardrails:\"]}],\"\\n\",[\"$\",\"ul\",\"10\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Harmlessness screens:\"]}],\" Use a lightweight model such as Claude Haiku 5.5 to pre-screen user input before it reaches your main conversation. Use \",\"$L9f\",\" to constrain the response to a simple classification. Claude Haiku 5.5 runs \",\"$La0\",\" that can decline the screening request itself, so treat a response with \",\"$La1\",\" as a harmful verdict.\"]}],\"\\n\",\"$La2\",\"\\n\"]}],\"\\n\",\"$La3\",\"\\n\",\"$La4\",\"\\n\",\"$La5\",\"\\n\"]}],\"\\n\",\"$La6\",\"\\n\",\"$La7\",\"\\n\",\"$La8\",\"\\n\",\"\\n\",\"$La9\",\"\\n\",\"$Laa\",\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\"]]}],\"$Lb1\"]}],\"$Lb2\"]}],\"$Lb3\",\"$Lb4\",null,\"$Lb5\"],false,\"$Lb6\"]}]\nb7:I[687430,[\"$17\",\"$18\",\"$19\",\"$1a\",\"$1b\",\"$1c\",\"$1d\",\"$1e\",\"$1f\",\"$20