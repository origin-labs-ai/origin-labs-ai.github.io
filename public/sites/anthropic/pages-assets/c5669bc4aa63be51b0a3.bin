,\"stableId\":\"7da177a8-a67c-49cd-9898-92cfd5c8c08d\"}},\"intercom_account_hash\":null,\"intercom_user_jwt\":null,\"locale\":null,\"system_prompts\":null,\"feature_flags\":{\"user\":{},\"values\":{},\"values_hash\":\"\"},\"served_copy\":{\"auth.code_connect.banner_b\":\"You have an Ultra plan!\",\"auth.code_connect.individual.required\":\"Claude Max, Ultra, or Pro is required to connect to Claude Code\",\"auth.code_connect.individual.signup\":\"Sign up for a Max, Ultra, or Pro subscription to connect your account, or use your API key.\",\"auth.code_connect.individual.upgrade\":\"Upgrade to Max, Ultra, or Pro\",\"auth.code_connect.team.required\":\"Claude Max, Ultra, Pro, or Team is required to connect to Claude Code\",\"auth.code_connect.team.signup\":\"Sign up for a Max, Ultra, Pro, or Team subscription to connect your account, or use your API key.\",\"auth.code_connect.team.upgrade\":\"Upgrade to Max, Ultra, Pro, or Team\",\"auth.office_addin.plans\":\"Claude in {suiteName} is available on Pro, Max, Ultra, Team, and Enterprise plans\",\"auth.office_addin.plans_only\":\"Claude in {suiteName} is only available on Pro, Max, Ultra, Team, and Enterprise plans\",\"console.login.chat_plan_banner\":\"Have a Pro, Max, or Ultra plan? Log in with your chat account\",\"console.oauth.continue_b\":\"Continue with Claude Ultra\",\"console.oauth.includes_code_b\":\"Your Claude Ultra plan includes Claude Code\",\"web.admin.members_max_row_label\":\"Claude Max and Ultra\",\"web.billing.address_changed\":\"Your billing address has changed since your last invoice. To upgrade to {tier, select, max_20x {Ultra} other {Max}}, contact Support for assistance.\",\"web.billing.cancel.keep_named\":\"Keep {tier, select, max_20x {Ultra} other {Max}}\",\"web.billing.cancel.offer_desc\":\"Max has the same models and features with 5x Pro usage every 5 hours and every week.\",\"web.billing.cancel.offer_title\":\"Switch to Max\",\"web.billing.cancel.offer_title_priced\":\"Switch to Max · {price}/month\",\"web.billing.cancel.switch_cta\":\"Switch to Max\",\"web.billing.cancel.switch_instead\":\"Switch to Max instead\",\"web.billing.coupon_applied\":\"Coupon applied. {percentOff}% off Ultra for {durationInMonths, plural, one {# month} other {# months}}.\",\"web.billing.invoice_line_period\":\"{name} plan · {start} – {end}\",\"web.billing.keep_access\":\"You will keep access to Claude {name}.\",\"web.billing.keep_access_dated\":\"You will keep access to Claude {name} and your next charge will be processed on {resumeDate}.\",\"web.billing.past_due_card\":\"Your {amount} {name} plan payment due {date} couldn’t be charged to {card}. Access is paused until the invoice is paid.\",\"web.billing.past_due_nocard\":\"Your {amount} {name} plan payment due {date} didn’t go through. Access is paused until the invoice is paid.\",\"web.billing.past_due_resubscribe\":\"Your subscription is paused, and this invoice can’t be paid here. To get {name} back, cancel this plan in Settings \u003e Billing, then subscribe again with a working card, or contact support.\",\"web.billing.phone_verify_continue\":\"Verify a phone number to continue with {tier, select, max_20x {Ultra} other {Max}}.\",\"web.billing.plan_active_toast\":\"Your {name} plan is active\",\"web.billing.promo_renewal_note\":\"Your subscription includes a time-limited promotional discount. Your subscription will automatically renew at the discounted price of {discountedPrice} / {billingInterval, select, yearly {year} monthly {month} other {month}} (plus applicable taxes) until {promoEndDate} when you will be automatically downgraded back to your current subscription plan, unless you elect to keep {tier, select, max_20x {Ultra} other {Max}}.\",\"web.billing.prorated_credit\":\"Prorated credit for the remainder of {name} plan\",\"web.billing.region_body\":\"Our Max and Ultra plans are not available in your region at this time. See the \u003clink\u003elist of supported regions\u003c/link\u003e for more information.\",\"web.billing.region_title\":\"Max and Ultra plans unavailable\",\"web.billing.renew_current\":\"Renew current {name} plan\",\"web.billing.trial_end_note\":\"{tier, select, max_20x {Your Pro trial will end immediately. Upgrading to Ultra will start your paid subscription and you’ll get 10x Pro usage every week, starting today.} other {Your Pro trial will end immediately. Upgrading to Max will start your paid subscription and you’ll get 5x Pro usage every 5 hours and every week, starting today.}}\",\"web.billing.unpayable_resubscribe\":\"This invoice can’t be paid here — nothing was charged. To get {name} back, cancel this plan in Settings \u003e Billing, then subscribe again with a working card, or contact support.\",\"web.billing.upgrade_tier_cta\":\"Upgrade to Ultra\",\"web.billing.upgraded_toast\":\"Upgraded to {tier, select, max_20x {Ultra} other {Max}} plan\",\"web.billing.welcome_heading\":\"Welcome to {name}\",\"web.billing.welcome_splash_title\":\"Put your new {name} plan to work\",\"web.chat.past_due_title\":\"Your {name} plan payment didn’t go through\",\"web.checkout.line_item_monthly\":\"{tier, select, max_20x {Ultra} other {Max}} monthly\",\"web.checkout.tier_toggle_label\":\"Choose Max or Ultra\",\"web.chrome.plans_faq\":\"Claude in Chrome is available on all paid Claude plans (Pro, Max, Ultra, Team, and Enterprise). Install the extension from the Chrome Web Store, sign in with your Claude account, and you’re ready to go. We recommend reviewing our safety guidelines before getting started.\",\"web.code.settings_upgrade_cta\":\"Upgrade to Pro, Max, or Ultra\",\"web.code_install.welcome\":\"Welcome to {tier, select, max_20x {Claude Ultra} other {Claude Max}}!\",\"web.desktop.code_upgrade_hint\":\"Upgrade to Pro, Max, or Ultra to use Claude Code on the desktop.\",\"web.desktop.computer_use_plans\":\"Computer use is available on the Pro, Max, and Ultra plans.\",\"web.directory.blocked_personal\":\"To submit as an individual instead, switch to a personal Pro, Max, or Ultra account from the account menu.\",\"web.directory.blocked_plans\":\"Pro, Max, Ultra, Team, and Enterprise plans can submit plugins and MCP servers to the Claude Directory for other organizations to install.\",\"web.downgrade.heading\":\"Change to Max plan\",\"web.downgrade.keep_plan_link\":\"Keep your {name} plan\",\"web.downgrade.loss_note\":\"Switching to Max means you’ll have less usage and may hit your limits faster.\",\"web.downgrade.scheduled_toast\":\"Your subscription has been scheduled to downgrade to Max at the end of your current billing cycle.\",\"web.downgrade.target_summary\":\"Max (5x Pro usage every 5 hours and every week)\",\"web.gift.faq_membership\":\"A Claude gift membership gives someone access to Claude Pro, Claude Max, or Claude Ultra for a set period of time. They’ll get all the benefits of a paid subscription, including access to our latest models, Claude Code, and unlimited projects.\",\"web.gift.redeem_higher_tier\":\"You’re currently on {name}, a higher tier than the {tier} plan you were gifted. We’ve added a {credit} credit to your account instead.\",\"web.limits.title_opus\":\"More Opus with Pro, Max, and Ultra plans\",\"web.login.plan_card.subtitle\":\"Max: 5x Pro usage every 5 hours and every week. Ultra: 10x Pro usage every week\",\"web.login.plan_card.title\":\"Max and Ultra\",\"web.login.plans_faq\":\"Claude has six pricing plans available — Free, Pro, Max, Ultra, Team, and Enterprise. The Free plan offers limited use with no payment required. \u003ca\u003eLearn more about available pricing plans\u003c/a\u003e.\",\"web.plan.product_name\":\"Claude {name}\",\"web.plan_label.max_20x\":\"Ultra plan\",\"web.plan_name.max_20x\":\"Ultra\",\"web.plan_name.max_5x\":\"Max\",\"web.plans.cowork_max_sub\":\"Get the most out of Cowork. Max: 5x Pro usage every 5 hours and every week. Ultra: 10x Pro usage every week\",\"web.plans.help_choose_max\":\"To get the most out of Claude: 5x Pro usage every 5 hours and every week with Max, or 10x Pro usage every week with Ultra*, with priority access at high traffic times.\",\"web.plans.max_card_cta\":\"{shown, select, 20x {Get Ultra plan} other {Get Max or Ultra plan}}\",\"web.plans.max_card_heading\":\"Max and Ultra\",\"web.teachers.verification_permanent\":\"Verification is permanent. Once you’re approved, this account becomes a free Claude for Teachers account and any paid plan on it ends: your existing chats stay with it under student-data privacy protections, and it can’t be switched back to a personal Free, Pro, Max, or Ultra plan. If you want a personal plan later, you’ll need a separate Claude account.\",\"web.team.checkout_declined_note\":\"Your existing projects \u0026 chats won’t carry over, and your existing {name} plan subscription will auto-renew until canceled. \u003clink\u003eLearn more\u003c/link\u003e\",\"web.team.checkout_existing_plan_note\":\"Subscribing to a Team plan creates a new account. Your existing projects \u0026 chats won’t carry over, and your existing {name} plan subscription will auto-renew until canceled. \u003clink\u003eLearn more\u003c/link\u003e\",\"web.upgrade.already_subscribed\":\"You’re already on {name}\",\"web.upgrade.code_connect_heading\":\"Claude Code is included in Pro, Max, and Ultra\",\"web.upgrade.from_existing_title\":\"Upgrade your usage with Max or Ultra\",\"web.upgrade.from_usage.headline\":\"Your Usage page comes with Pro, Max, and Ultra\",\"web.upgrade.subline_chrome\":\"Exclusive access for Max and Ultra plan subscribers\",\"web.upgrade.subline_design\":\"Claude Design is included in Pro, Max, and Ultra.\",\"web.upgrade.subline_model\":\"The model you came for is included in Pro, Max, and Ultra.\",\"web.upgrade.subline_opus\":\"Claude Opus is included in Pro, Max, and Ultra.\",\"web.usage.credits_destination\":\"Credits go to \u003cb\u003eyour {name} plan\u003c/b\u003e · {email}\",\"web.usage.free_example.headline\":\"Your Usage page comes with Pro, Max, and Ultra\",\"web.usage.purchase_destination