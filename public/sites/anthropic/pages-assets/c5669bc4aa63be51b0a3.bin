d:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1.25rem * var(--cds-rem-scale, 1));font-weight:433.3" aria-hidden="true"></span></span></button><span role="status" class="sr-only"></span></span></div></div><div data-not-prose="true" class="relative h-full py-4 pl-4 text-code code-block-wrap"><pre class="block w-full pr-4" data-code-source="" translate="no"><code>A user submitted this content:
&lt;content&gt;
{{CONTENT}}
&lt;/content&gt;

Classify whether this content refers to harmful, illegal, or explicit activities.</code></pre></div></div><p>Use <code>output_config</code> with a JSON schema to constrain the response:</p><div data-copy-scope="" class="overflow-hidden rounded-card border bg-surface-2 print:[p+&amp;]:break-before-avoid group relative prose-block [&amp;&gt;[data-not-prose]]:mt-0"><div data-not-prose="true" tabindex="0" class="relative h-full py-4 pl-4 text-code overflow-x-auto focus-visible:-outline-offset-2 print:overflow-visible"><div class="inline-block min-w-full pr-4 print:block" data-code-source="" translate="no"><pre class="shiki"><code><span class="line">{</span>
<span class="line"><span class="l5 dc">  "output_config"</span>: {</span>
<span class="line"><span class="l5 dc">    "format"</span>: {</span>
<span class="line"><span class="l5 dc">      "type"</span>: <span class="l3 dn">"json_schema"</span>,</span>
<span class="line"><span class="l5 dc">      "schema"</span>: {</span>
<span class="line"><span class="l5 dc">        "type"</span>: <span class="l3 dn">"object"</span>,</span>
<span class="line"><span class="l5 dc">        "properties"</span>: {</span>
<span class="line"><span class="l5 dc">          "is_harmful"</span>: { <span class="l5 dc">"type"</span>: <span class="l3 dn">"boolean"</span> }</span>
<span class="line">        },</span>
<span class="line"><span class="l5 dc">        "required"</span>: [<span class="l3 dn">"is_harmful"</span>],</span>
<span class="line"><span class="l5 dc">        "additionalProperties"</span>: <span class="l1 d4">false</span></span>
<span class="line">      }</span>
<span class="line">    }</span>
<span class="line">  }</span>
<span class="line">}</span></code></pre></div></div><div class="absolute top-3 right-3 print:hidden opacity-100 md:opacity-0 md:group-hover:opacity-100 md:focus-within:opacity-100"><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" data-size="sm" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-fizzy-lake-color-icon-only-disabled)] text-muted" aria-label="Copy code" id="_R_fv12vcqalubtabsknr5td9leailb_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] stacks:transition-[box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1.25rem * var(--cds-rem-scale, 1));font-weight:433.3" aria-hidden="true"></span></span></button><span role="status" class="sr-only"></span></div></div></div></div></div></div></div>
</li>
<li>
<p><strong>Input validation:</strong> Filter user input for known injection patterns before it reaches Claude. You can use an LLM to create a generalized validation screen by providing known jailbreaking language as examples.</p>
</li>
<li>
<p><strong>Prompt engineering:</strong> Craft system prompts that emphasize ethical and legal boundaries, and that explicitly tell Claude how to refuse.</p>
<div data-orientation="vertical" data-cds="Accordion" class="group/accordion font-sans divide-y prose-block" style="--accordion-px:var(--cds-pad-md);--accordion-radius:var(--cds-radius)"><div data-orientation="vertical" data-hidden="" data-index="-1" data-closed="" class="group-hover/accordion:[&amp;:has(+*:not([data-disabled])&gt;[data-cds=AccordionHeader]:hover)]:border-b-transparent group-hover/accordion:[&amp;[data-closed]:not([data-disabled]):has(&gt;[data-cds=AccordionHeader]:hover)]:border-b-transparent touch:[&amp;:has(+*:not([data-disabled])&gt;[data-cds=AccordionHeader]:active)]:border-b-transparent touch:[&amp;[data-closed]:not([data-disabled]):has(&gt;[data-cds=AccordionHeader]:active)]:border-b-transparent"><h3 data-orientation="vertical" data-hidden="" data-index="-1" data-closed="" data-cds="AccordionHeader" class="flex mx-outset w-stretch" style="--cds-outset-x:var(--accordion-px)"><button type="button" data-value="" data-orientation="vertical" data-hidden="" data-index="-1" tabindex="0" aria-disabled="false" aria-expanded="false" id="base-ui-_R_132vcqalubtabsknr5td9leailbH2_" data-size="lg" class="cds-reset group/acc flex w-full items-start gap-sm min-h-control rounded-[var(--accordion-radius)] px-[var(--accordion-px)] py-[calc((var(--cds-h-control)_-_1lh)_/_2)] font-sans text-start text-body font-medium font-control text-primary outline-none focus-visible:outline-hidden hover:bg-fill-ghost-hover touch:active:bg-fill-ghost-hover focus-visible:bg-fill-ghost-hover focus-visible:[box-shadow:inset_0_0_0_1px_var(--cds-fill-accent)] data-[disabled]:opacity-disabled data-[disabled]:pointer-events-none stacks:focus-visible:bg-fill-ghost-selected select-text"><span class="min-w-0 flex-1 break-words">Example: Ethical system prompt for an enterprise chatbot</span><span data-cds-accordion-caret="" class="flex h-[1lh] shrink-0 items-center"><span data-cds="Icon" style="font-size:calc(1.5rem * var(--cds-rem-scale, 1));font-weight:433.3;font-variation-settings:&qu