<body data-rsssl=1 class="home wp-singular page-template page-template-page-home page-template-page-home-php page page-id-2 wp-custom-logo wp-embed-responsive wp-theme-betheme wp-child-theme-betheme-child woocommerce-block-theme-has-button-styles  color-custom content-brightness-light input-brightness-light style-simple button-animation-fade layout-full-width no-content-padding hide-love no-shadows header-classic header-boxed sticky-header sticky-tb-color ab-hide menu-link-color menuo-right menuo-no-borders subheader-both-center responsive-overflow-x-mobile mobile-tb-center mobile-side-slide mobile-mini-mr-ll tablet-sticky mobile-sticky mobile-header-mini mobile-icon-user-ss mobile-icon-wishlist-ss mobile-icon-search-ss mobile-icon-wpml-ss mobile-icon-action-ss be-page-2 be-reg-2901 wpb-js-composer js-comp-ver-8.7.2 vc_responsive elementor-default elementor-kit-1305">
<div id="oasis" style="clear: both;">

<img src="/wp-content/uploads/2024/01/open-oasis-projects.png" style="height: 36px; display: block; float: left; margin-right: 30px;">
<ul class="social"><li class="twitter"><a target="_blank" rel="nofollow" href="#" title="X (Twitter)" aria-label="X (Twitter) icon"><i class="icon-x-twitter"></i></a></li><li class="youtube"><a target="_blank" rel="nofollow" href="#" title="YouTube" aria-label="YouTube icon"><i class="icon-play"></i></a></li><li class="linkedin"><a target="_blank" rel="nofollow" href="#" title="LinkedIn" aria-label="LinkedIn icon"><i class="icon-linkedin"></i></a></li><li class="custom"><a target="_blank" rel="nofollow" href="https://github.com/" title="GitHub" aria-label="GitHub icon"><i class="icon-github-circled"></i></a></li></ul>	
</div>
<script>
jQuery(function() {
    //rotation speed and timer
    var speed = 10000;
    
    var run = setInterval(rotate, speed);
    var slides = jQuery('.slide');
    var container = jQuery('#slides ul');
    var elm = container.find(':first-child').prop("tagName");
    var item_width = container.width();
    var previous = 'prev'; //id of previous button
    var next = 'next'; //id of next button
    slides.width(item_width); //set the slides to the correct pixel width
    container.parent().width(item_width);
    container.width(slides.length * item_width); //set the slides container to the correct total width
    container.find(elm + ':first').before(container.find(elm + ':last'));
    resetSlides();
    
    
    //if user clicked on prev button
    
    jQuery('#buttons a').click(function (e) {
        //slide the item
        
        if (container.is(':animated')) {
            return false;
        }
        if (e.target.id == previous) {
            container.stop().animate({
                'opacity': 0
            }, 300, function () {
                container.find(elm + ':first').before(container.find(elm + ':last'));
                resetSlides();
            });
        }
        
        if (e.target.id == next) {
            container.stop().animate({
                'opacity': 0
            }, 300, function () {
                container.find(elm + ':last').after(container.find(elm + ':first'));
                resetSlides();
            });
        }
        
        //cancel the link behavior            
        return false;
        
    });
    
    //if mouse hover, pause the auto rotation, otherwise rotate it    
    container.parent().mouseenter(function () {
        clearInterval(run);
    }).mouseleave(function () {
        run = setInterval(rotate, speed);
    });
    
    
    function resetSlides() {
        //and adjust the container so current is in the frame
        container.css({
            'opacity': 1
        }, 300);
    }
    
});

function rotate() {
    jQuery('#next').click();
}
</script>

<style>
#carousel {
position: relative;
background: #eea411;
margin:0px auto;
}

	
@media (min-width: 33.75rem) {
#carousel { padding-top: 0;}
}
	
	
	
#slides {
overflow: hidden;
position: relative;
width: 100%;
}

#slides ul {
list-style: none;
width:100%;
margin: 0;
padding: 0;
position: relative;
}

 #slides li {
width:100%;
float:left;
text-align: center;
position: relative;
padding: 15px 0;
margin: 0;
}
	#slides li a { color: #fff !important; border: 0 !important; background: none !important; text-decoration: none; box-shadow: none !important;}
	#slides li a:hover {text-decoration: underline;}
		
/* Styling for prev and next buttons */
.btn-bar{
   margin: 0 auto;
    display: block;
    position: absolute;
    right: 20px;
    padding: 10px 0;
	z-index: 99;
}

#buttons {
padding:0;
}
#primary { padding-top: 0;}
.post-header__title {display: none;}
#buttons a {
	text-align: center;
    display: block;
    font-size: 20px;
    float: left;
    outline: 0;
    margin: 0 10px;
    color: #fff;
    text-decoration: none;
    display: block;
    padding: 0;
    width: 20px;
	background: none !important;
	border: 0 !important;
	box-shadow: none;
}

a#prev:hover, a#next:hover {
	border: 0;
	
}


.quoteContainer{
display: block;
width: 100%;
}
.quoteContainer p { padding: 0 40px 0 15px; margin: 0;}
	
@media (max-width: 425px) {
.quoteContainer p { padding: 0 60px 0 15px; margin: 0; line-height: 20px;}
.quoteContainer p a{ font-size: 14px; line-height: 14px;}
#slides li {
padding: 8px 0;
}
#buttons a {
    margin: 0 6px;
    width: 10px;
}
}
</style>

			
<div id="carousel">
  <div class="btn-bar"><div id="buttons"><a id="prev" href="#">&lt;</a><a id="next" href="#">&gt;</a> </div></div>
    <div id="slides">
        <ul>
            				 <li class="slide"><div class="quoteContainer">
<p class="wp-block-paragraph"><a href="https://www.coalitionforsecureai.org/how-much-assurance-does-your-ai-supply-chain-need/" target="_blank" rel="noreferrer noopener">Introducing the Artifact Integrity Maturity Model (AIMM) for AI/ML Supply Chain Trust and Provenance</a></p>
</div></li>
							 <li class="slide"><div class="quoteContainer">
<p class="wp-block-paragraph"><a href="https://www.coalitionforsecureai.org/mcp-security-version-2-0-from-threat-taxonomy-to-a-model-you-can-actually-audit-against/" target="_blank" rel="noreferrer noopener">MCP Security v2.0 moves from threat taxonomy to an auditable model</a></p>
</div></li>
							 <li class="slide"><div class="quoteContainer">
<p class="wp-block-paragraph"><a href="https://www.coalitionforsecureai.org/cosai-hosts-working-session-on-open-delegation-identity-standard-odis/" target="_blank" rel="noreferrer noopener">Inside CoSAI&#8217;s ODIS working session on AI agent identity and delegation</a></p>



<p class="wp-block-paragraph"></p>
</div></li>
							 <li class="slide"><div class="quoteContainer">
<p class="wp-block-paragraph"><a href="https://www.coalitionforsecureai.org/treat-your-agent-like-an-insider-threat-why-ai-sandboxing-cant-wait/">Treat Your Agent Like an Insider Threat: Why AI Sandboxing Can&#8217;t Wait</a></p>
</div></li>
							 <li class="slide"><div class="quoteContainer">
<p class="wp-block-paragraph"><a href="https://www.coalitionforsecureai.org/zero-trust-for-ai-systems-why-authorization-cant-live-inside-the-model/">Zero Trust for AI Systems: Why Authorization Can’t Live Inside the Model</a></p>
</div></li>
			        </ul>
    </div>
</div>
	
	
