form input.display-none{display:none!important}
/* CSS custom variables */

/*# sourceURL=mfn-dynamic-inline-css */
</style>
<style id="mfn-custom-inline-css">
.seo3-heading { display: inline-block; background-color: rgb(53 145 214 / 25%); margin-left: -14px; padding: 2px 15px; border-radius: 15px; }
#Footer a { text-decoration: underline;}
#Footer .widget_mfn_menu ul li a {
    background: rgba(0,0,0,0);
    color: #fff;
    padding: 2px 10px;
    text-decoration: none;
}
#oasis .social {
    padding: 6px 0;
    position: absolute;
    top: 0;
    right: 0px;
    float: right;
}
#oasis .social li {
    display: inline-block;
    margin-right: 6px;
}
#oasis .social li a {
    color: #ffffff !important;
}
#oasis .social li a {
    color: hsla(0,0%,100%,.3);
    font-size: 15px;
    line-height: 15px;
    transition: all .3s ease-in-out;
}
body:not(.home) #Action_bar { display: none;}
body:not(.home) #Top_bar { top: 40px !important;}
body:not(.home) #Header { min-height: 100px;}
#Action_bar {z-index: 99999;}
#Top_bar .menu li ul { top: 63%;}
#Top_bar.is-sticky .menu li ul { top: 100%;}
#Top_bar .menu li ul li a span { font-size: 16px;}
#block-6 a {text-decoration: none;}
#Footer .widget_mfn_menu ul li a:hover { background: rgba(0,0,0,.1);}
#Footer .footer_copy .social { display: none;}

.seo3-wrap { box-shadow: 0px 10px 30px rgba(55,43,125,.2); border-radius: 25px; }
.fixed-nav { display: none;}
lord-icon { display: block; margin: 0 auto;}
.box lord-icon { box-shadow: 0 0 30px #ccc; border-radius: 30px; padding: 0; background: #fff;}
.boxes { box-shadow: 0 0 30px #ccc; border-radius: 30px; padding: 20px; background: #fff;}

.w100 lord-icon { width: 100%; height: auto;}

.mygrad {background-image: linear-gradient(180deg, #ffffff 0%, #fcfcfc 50%, #fcfcfc 90%,#ffffff 100%) !important;}
#oasis {background: #ffffff; padding: 2px 0; max-height: 40px; overflow: hidden;}
#Action_bar {background: #eea411; display: block; position: relative; height: 34px;}
#Action_bar .social { padding: 6px 0; position: absolute; top: 0; right: 20px;}

.button-round .testimonials_slider_ul .button {
    background-color: #ffffff !important;
    color: #0092d3 !important;
}
.testimonials_slider .slider_images li a { height: 30px !important;}
#Action_bar .contact_details li {
    padding: 6px 0;
    color: #fff;
}
#Action_bar .contact_details { float: none;}
#Action_bar .slogan { text-align: center !important; width: 100%;}
#Action_bar .slogan a { color: #fff !important;}
.style-simple th{
    background: #3793d4 !important; color: #fff;
}
#Action_bar .social li a, #Header_creative .social li a, #Action_bar:not(.creative) .social-menu a {
    color: #ffffff;
}
#Top_bar.is-sticky {
    top: 0px !important;
}

.fancy_heading .title {
    font-size: 36px;
    line-height: 36px;
}
.testimonials_slider .slider_images li a { display: none;}
.testimonials_slider .slider_images li.slick-active a { display: block;}

.fancy_heading .inside { color: #666;}

@media only screen and (max-width: 767px) {
.mobile-one.halfonmobile {
    width: 50% !important; float: left !important;
}
body:not(.home) #Header { min-height: 0;}
}

@media only screen and (max-width: 479px) {
body {
    font-size: 20px;
    line-height: 28px;
}
h4 {
    font-size: 24px;
    line-height: 34px;
}
}

/* -------------------------------
   FIX: HIDE META ONLY FOR EVENTS
   ------------------------------- */
.category-events .post-meta,
.category-events .post-meta.clearfix,
.category-events .post-meta .icon-user,
.category-events .post-meta .icon-clock {
    display: none !important;
}

/* (Removed: global hiding rules for .post-meta, .post-header, .title_wrapper) */

#carousel {
    background: #FFC107 !important;
}

@media only screen and (max-width: 480px) {
.mcb-section .mcb-wrap-b008cc6aa .mcb-wrap-inner-b008cc6aa{
    padding-top:250px !important;
    padding-bottom:0px !important;
}
}

.popup-link {
    font-size: 1em;
    font-weight: bold;
    margin: 0;
    padding: 0;
    color: #0d2640;
    text-decoration: underline;
}

.mcb-section .mcb-wrap .mcb-item-5b40lhsh .Latest_news .title {
    margin-top: 30px;
    margin-bottom: 20px;
    letter-spacing: 0px;
    text-align: center;
}



/* Force date visible ONLY on homepage news area */


.event-date {
    font-size: 15px;
    margin-bottom: 10px;
    color: #555;
}

#eventblogger .event-dates-card {
    font-size: 15px;
    color: #0A2A43;
    margin-bottom: 8px;
    font-weight: 600;
}
/* ---------------------------------
   Force date + icons color globally
   except for Events category
   --------------------------------- */
:not(.category-events) .post-meta,
:not(.category-events) .post-meta a,
:not(.category-events) .post-meta .icon-clock,
:not(.category-events) .post-meta .icon-user,
:not(.category-events) .post-meta .date,
:not(.category-events) .date_label {
    color: #0d2640 !important;
}
#homepage-news .date_label {
    display: none !important;
}
/* /* STATIC HEIGHT COMPROMISE (ONLY USE IF FLEXBOX FAILS) */
@media (min-width: 768px) { /* Only apply on desktop/tablet */
    #homepage-news .mfn-queryloop-item-wrapper {
        min-height: 550px !important; /* Choose a height that works for your tallest card */
    }
}


/*# sourceURL=mfn-custom-inline-css */
