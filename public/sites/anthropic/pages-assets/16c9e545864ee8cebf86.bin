e the browser use tool in the same request\"]}],\". The two toolsets work independently, each in its own coordinate frame. The \",[\"$\",\"code\",\"3\",{\"children\":[\"toolset_name\"]}],\" value distinguishes calls to members that share a name, such as \",[\"$\",\"code\",\"5\",{\"children\":[\"screenshot\"]}],\" or \",[\"$\",\"code\",\"7\",{\"children\":[\"key\"]}],\".\"]}]\ndf:[\"$\",\"h3\",\"153\",{\"id\":\"build-a-custom-computer-use-environment\",\"className\":\"group\",\"children\":[[\"Build a custom computer use environment\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"build-a-custom-computer-use-environment\",\"name\":\"Build a custom computer use environment\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ne0:[\"$\",\"p\",\"155\",{\"children\":[\"The \",[\"$\",\"$L97\",\"1\",{\"href\":\"https://github.com/anthropics/claude-quickstarts/tree/main/computer-use-demo\",\"untracked\":false,\"children\":[\"reference implementation\"]}],\" is meant to help you get started with computer use. It includes all of the components needed to have Claude use a computer. However, you can build your own environment for computer use to suit your needs. You need:\"]}]\ne1:[\"$\",\"ul\",\"157\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"A virtualized or containerized environment suitable for computer use with Claude\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"An implementation of the computer use tool’s actions\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"An agent3c:o3e2, loop that interacts with the Claude API and runs the \",[\"$\",\"code\",\"1\",{\"children\":[\"tool_use\"]}],\" results using your tool implementations\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"An API or UI that allows user input to start the agent loop\"]}],\"\\n\"]}]\ne2:[\"$\",\"h3\",\"159\",{\"id\":\"implement-the-computer-use-tool\",\"className\":\"group\",\"children\":[[\"Implement the computer use tool\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"implement-the-computer-use-tool\",\"name\":\"Implement the computer use tool\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ne3:[\"$\",\"p\",\"161\",{\"children\":[\"The computer use tool is implemented as a schema-less tool. When using this tool, you don’t need to provide an input schema as with other tools; the schema is built into Claude’s model and can’t be modified.\"]}]\n15b:T1081,3c:o1081,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e# Placeholder image data; a real executor captures the screen and returns the PNG bytes\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l1\"\u003ePLACEHOLDER_PNG\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003edef\u003c/span\u003e\u003cspan class=\"li dt\"\u003e capture_screenshot\u003c/span\u003e() -\u0026gt; list[ImageBlockParam]:\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e    # screenshot answers with an image block rather than text: return the result content list\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e    return\u003c/span\u003e [\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l3 dn\"\u003e            \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"image\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l3 dn\"\u003e            \"source\"\u003c/span\u003e: {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l3 dn\"\u003e                \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"base64\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l3 dn\"\u003e                \"media_type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"image/png\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l3 dn\"\u003e                \"data\"\u003c/span\u003e: \u003cspan class=\"l1\"\u003ePLACEHOLDER_PNG\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e            },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    ]\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003edef\u003c/span\u003e\u003cspan class=\"li dt\"\u003e click\u003c/span\u003e(\u003cspan class=\"dc\"\u003ecoordinate\u003c/span\u003e\u003cspan class=\"lk\"\u003e=\u003c/span\u003e\u003cspan class=\"l1 d4\"\u003eNone\u003c/span\u003e):\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e    if\u003c/span\u003e coordinate \u003cspan class=\"lk d4\"\u003eis\u003c/span\u003e\u003cspan class=\"l1 d4\"\u003e None\u003c/span\u003e:\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e        return\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"clicked at current cursor\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    x, y \u003cspan class=\"lk\"\u003e=\u003c/span\u003e coordinate\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e    return\u003c/span\u003e\u003cspan class=\"lk d4\"\u003e f\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"clicked at (\u003c/span\u003e\u003cspan class=\"lk d4\"\u003e{\u003c/span\u003ex\u003cspan class=\"lk d4\"\u003e}\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e, \u003c/span\u003e\u003cspan class=\"lk d4\"\u003e{\u003c/span\u003ey\u003cspan class=\"lk d4\"\u003e}\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e)\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003edef\u003c/span\u003e\u003cspan class=\"li dt\"\u003e type_text\u003c/span\u003e(\u003cspan class=\"dc\"\u003etext\u003c/span\u003e):\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e    return\u003c/span\u003e\u003cspan class=\"lk d4\"\u003e f\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"typed: \u003c/span\u003e\u003cspan class=\"lk d4\"\u003e{\u003c/span\u003etext\u003cspan class=\"lk d4\"\u003e}\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003edef\u003c/span\u003e\u003cspan class=\"li dt\"\u003e handle_computer_action\u003c/span\u003e(\u003cspan class=\"dc\"\u003ename\u003c/span\u003e, \u003cspan class=\"dc\"\u003etool_input\u003c/span\u003e):\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e    match\u003c/span\u003e name:\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e        case\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"screenshot\"\u003c/span\u003e:\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e            return\u003c/span\u003e capture_screenshot()\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e        case\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"left_click\"\u003c/span\u003e:\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e            # coordinate is optional; without it, click where the cursor already is\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e            return\u003c/span\u003e click(tool_input.get(\u003cspan class=\"l3 dn\"\u003e\"coordinate\"\u003c/span\u003e))\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e        case\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"type\"\u003c/span\u003e:\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e            return\u003c/span\u003e type_text(tool_input[\u003cspan class=\"l3 dn\"\u003e\"text\"\u003c/span\u003e])\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e    # Handle other actions as needed\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e    raise\u003c/span\u003e\u003cspan class=\"l1 d2\"\u003e ValueError\u003c/span\u003e(\u003cspan class=\"lk d4\"\u003ef\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"Unknown or unimplemented member: \u003c/span\u003e\u003cspan class=\"lk d4\"\u003e{\u003c/span\u003ename\u003cspan class=\"lk d4\"\u003e}\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"\u003c/span\u003e)\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e3c:o75b,e4:[\"$\",\"$L143\",\"163\",{\"children\":[[\"$\",\"$L144\",\"0\",{\"title\":\"Set up your computing environment\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"Create a virtual display or connect to an existing display that Claude interacts with. This typically involves setting up Xvfb (X Virtual Framebuffer) or similar technology.\"]}]]}],[\"$\",\"$L144\",\"1\",{\"title\":\"Implement action handlers\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"Create functions to handle each action type that Claude might request:\"]}],[\"$\",\"$L135\",\"1\",{\"exclude\":\"shell\",\"children\":[[\"$\",\"$L137\",\".$0\",{\"wrap\":false,\"language\":\"python\",\"label\":\"Python\",\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$15b\"}}]}],\"$L15c\",\"$L15d\",\"$L15e\",\"$L15f\",\"$L160\",\"$L161\"]}]]}],\"$L162\",\"$L163\"]}]\ne5:[\"$\",\"h3\",\"165\",{\"id\":\"handle-errors\",\"className\":\"group\",\"children\":[[\"Handle errors\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"handle-errors\",\"name\":\"Handle errors\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ne6:[\"$\",\"p\",\"167\",{\"children\":[\"Report a failed action to Claude as a \",[\"$\",\"code\",\"1\",{\"children\":[\"tool_result\"]}],\" with \",[\"$\",\"code\",\"3\",{\"children\":[\"is_error: true\"]}],\" and a short description, and include \",[\"$\",\"code\",\"5\",{\"children\":[\"\\\"toolset_name\\\": \\\"computer\\\"\"]}],\" as on any other member result. If the failed action was part of a \",[\"$\",\"$L97\",\"7\",{\"href\":\"#batch-actions\",\"untracked\":false,\"children\":[\"batch action\"]}],\", answer the remaining blocks in the batch with the halt text shown there instead of running them.\"]}]\ne7:[\"$\",\"p\",\"169\",{\"children\":[\"For example, when screenshot capture fails:\"]}]\n3c:o57d,e8:[\"$\",\"$L141\",\"171\",{\"language\":\"json\",\"label\":\"$undefined\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L137\",null,{\"wrap\":false,\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cpre class=\\\"shiki\\\"\u003e\u003ccode\u003e\u003cspan class=\\\"line\\\"\u003e{\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"role\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"user\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"content\\\"\u003c/span\u003e: [\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e    {\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e      \\\"type\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"tool_result\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e      \\\"tool_use_id\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"toolu_01A09q90qw90lq917835lq9\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e      \\\"toolset_name\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"computer\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e      \\\"content\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"Error: Failed to capture screenshot. Display may be locked or unavailable.\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e      \\\"is_error\\\"\u003c/span\u003e: \u003cspan class=\\\"l1 d4\\\"\u003etrue\u003c/span\u003e\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e    }\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e  ]\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e}\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\"}}]}]}]\n3c:ob4d,e9:[\"$\",\"p\",\"173\",{\"children\":[\"Use the same shape for coordinates outside the display bounds and for actions that fail to run, with a message that says what went wrong.\"]}]\nea:[\"$\",\"h3\",\"175\",{\"id\":\"handle-coordinate-scaling-for-higher-resolutions\",\"className\":\"group\",\"children\":[[\"Size screenshots to fit image limits\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"handle-coordinate-scaling-for-higher-resolutions\",\"name\":\"Size screenshots to fit image limits\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\neb:[\"$\",\"p\",\"177\",{\"children\":[\"Screenshots and zoom images that you return to the computer use toolset must already fit within your model’s \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/vision#evaluate-image-size\",\"untracked\":false,\"children\":[\"image size limits\"]}],\": the toolset takes no display dimensions and the API doesn’t downscale for you, so an oversized \",[\"$\",\"code\",\"3\",{\"children\":[\"tool_result\"]}],\" image is rejected with a validation error. Because Claude returns coordinates in the pixel space of the image it receives, keep the scale factor you used so you can map those coordinates back to your screen.\"]}]\nec:[\"$\",\"$L96\",\"179\",{\"variant\":\"muted\",\"id\":\"$undefined\",\"icon\":\"$undefined\",\"className\":\"prose-block print:break-inside-avoid print:[:is(h2,h3,h4)+\u0026]:break-after-avoid\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"Limits vary by model. Claude Opus 4.7 and later models, including every model that supports \",[\"$\",\"code\",\"1\",{\"children\":[\"computer_toolset_20260801\"]}],\", accept up to 2,576 pixels on the long edge and 4,784 visual tokens total (\",[\"$\",\"code\",\"3\",{\"children\":[\"⌈width / 28⌉ × ⌈height / 28⌉\"]}],\", approximately 3.75 megapixels); earlier models accept up to 1,568 pixels on the long edge and approximately 1.15 megapixels total (see \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/build-with-claude/vision#evaluate-image-size\",\"untracked\":false,\"children\":[\"Resolution and token cost\"]}],\" for each model’s tier). The following example uses the earlier-model 1,568 px / 1.15 MP limits. For a high-resolution-tier model, size to the visual-token limit rather than a pixel total, for example with the resize helper in \",[\"$\",\"$L97\",\"7\",{\"href\":\"/docs/en/build-with-claude/vision-coordinates#resize-your-image-before-uploading\",\"untracked\":false,\"children\":[\"Resize your image before uploading\"]}],\".\"]}]]}]\ned:[\"$\",\"p\",\"181\",{\"children\":[\"If your screen is larger than the limit, resize each screenshot before returning it and scale Claude’s returned coordinates back to the original screen space. Because the toolset takes no display dimensions, the resize and the coordinate scaling in your application code are all you need:\"]}]\n164:Ta8b,3c:oa8b,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003eimport\u003c/span\u003e math\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003escreen_width, screen_height \u003cspan class=\"lk\"\u003e=\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e 1512\u003c/span\u003e, \u003cspan class=\"l1 di\"\u003e982\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003edef\u003c/span\u003e\u003cspan class=\"li dt\"\u003e get_scale_factor\u003c/span\u003e(\u003cspan class=\"dc\"\u003ewidth\u003c/span\u003e, \u003cspan class=\"dc\"\u003eheight\u003c/span\u003e):\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l3 dn\"\u003e    \"\"\"Calculate scale factor to meet API constraints.\"\"\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    long_edge \u003cspan class=\"lk\"\u003e=\u003c/span\u003e\u003cspan class=\"l1 dt\"\u003e max\u003c/span\u003e(width, height)\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    total_pixels \u003cspan class=\"lk\"\u003e=\u003c/span\u003e width \u003cspan class=\"lk\"\u003e*\u003c/span\u003e height\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    long_edge_scale \u003cspan class=\"lk\"\u003e=\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e 1568\u003c/span\u003e\u003cspan class=\"lk\"\u003e /\u003c/span\u003e long_edge\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    total_pixels_scale \u003cspan class=\"lk\"\u003e=\u003c/span\u003e math.sqrt(\u003cspan class=\"l1 di\"\u003e1_150_000\u003c/span\u003e\u003cspan class=\"lk\"\u003e /\u003c/span\u003e total_pixels)\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e    return\u003c/span\u003e\u003cspan class=\"l1 dt\"\u003e min\u003c/span\u003e(\u003cspan class=\"l1 di\"\u003e1.0\u003c/span\u003e, long_edge_scale, total_pixels_scale)\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e# When capturing screenshot\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003escale \u003cspan class=\"lk\"\u003e=\u003c/span\u003e get_scale_factor(screen_width, screen_height)\u003c/span\u003e\n\u003cspan class=\"line\"\u003escaled_width \u003cspan class=\"lk\"\u003e=\u003c/span\u003e\u003cspan class=\"l1 d2\"\u003e int\u003c/span\u003e(screen_width \u003cspan class=\"lk\"\u003e*\u003c/span\u003e scale)\u003c/span\u003e\n\u003cspan class=\"line\"\u003escaled_height \u003cspan class=\"lk\"\u003e=\u003c/span\u003e\u003cspan class=\"l1 d2\"\u003e int\u003c/span\u003e(screen_height \u003cspan class=\"lk\"\u003e*\u003c/span\u003e scale)\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e# Resize image to scaled dimensions before sending to Claude\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003escreenshot \u003cspan class=\"lk\"\u003e=\u003c/span\u003e capture_and_resize(scaled_width, scaled_height)\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e# When handling Claude's coordinates, scale them back up\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003edef\u003c/span\u003e\u003cspan class=\"li dt\"\u003e execute_click\u003c/span\u003e(\u003cspan class=\"dc\"\u003ex\u003c/span\u003e, \u003cspan class=\"dc\"\u003ey\u003c/span\u003e):\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    screen_x \u003cspan class=\"lk\"\u003e=\u003c/span\u003e x \u003cspan class=\"lk\"\u003e/\u003c/span\u003e scale\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    screen_y \u003cspan class=\"lk\"\u003e=\u003c/span\u003e y \u003cspan class=\"lk\"\u003e/\u003c/span\u003e scale\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    perform_click(screen_x, screen_y)\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e3c:oa,165:T1256,3c:o1256,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003econst\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e screenWidth\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e 1512\u003c/span\u003e;\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003econst\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e screenHeight\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e 982\u003c/span\u003e;\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003econst\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e MAX_LONG_EDGE\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e 1568\u003c/span\u003e;\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003econst\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e MAX_PIXELS\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e 1_150_000\u003c/span\u003e;\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003efunction\u003c/span\u003e\u003cspan class=\"li dt\"\u003e getScaleFactor\u003c/span\u003e(\u003cspan class=\"lj dc\"\u003ewidth\u003c/span\u003e\u003cspan class=\"lk\"\u003e:\u003c/span\u003e\u003cspan class=\"l1 d2\"\u003e number\u003c/span\u003e, \u003cspan class=\"lj dc\"\u003eheight\u003c/span\u003e\u003cspan class=\"lk\"\u003e:\u003c/span\u003e\u003cspan class=\"l1 d2\"\u003e number\u003c/span\u003e)\u003cspan class=\"lk\"\u003e:\u003c/span\u003e\u003cspan class=\"l1 d2\"\u003e number\u003c/span\u003e {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003e  const\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e longEdge\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"dc\"\u003e Math\u003c/span\u003e.\u003cspan class=\"li dt\"\u003emax\u003c/span\u003e(\u003cspan class=\"dc\"\u003ewidth\u003c/span\u003e, \u003cspan class=\"dc\"\u003eheight\u003c/span\u003e);\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003e  const\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e totalPixels\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"dc\"\u003e width\u003c/span\u003e\u003cspan class=\"lk\"\u003e *\u003c/span\u003e\u003cspan class=\"dc\"\u003e height\u003c/span\u003e;\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003e  const\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e longEdgeScale\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e MAX_LONG_EDGE\u003c/span\u003e\u003cspan class=\"lk\"\u003e /\u003c/span\u003e\u003cspan class=\"dc\"\u003e longEdge\u003c/span\u003e;\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003e  const\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e totalPixelsScale\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"dc\"\u003e Math\u003c/span\u003e.\u003cspan class=\"li dt\"\u003esqrt\u003c/span\u003e(\u003cspan class=\"l1 d3\"\u003eMAX_PIXELS\u003c/span\u003e\u003cspan class=\"lk\"\u003e /\u003c/span\u003e\u003cspan class=\"dc\"\u003e totalPixels\u003c/span\u003e);\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e  return\u003c/span\u003e\u003cspan class=\"dc\"\u003e Math\u003c/span\u003e.\u003cspan class=\"li dt\"\u003emin\u003c/span\u003e(\u003cspan class=\"l1 di\"\u003e1.0\u003c/span\u003e, \u003cspan class=\"dc\"\u003elongEdgeScale\u003c/span\u003e, \u003cspan class=\"dc\"\u003etotalPixelsScale\u003c/span\u003e);\u003c/span\u003e\n\u003cspan class=\"line\"\u003e}\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e// When capturing screenshot\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003econst\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e scale\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"li dt\"\u003e getScaleFactor\u003c/span\u003e(\u003cspan class=\"dc\"\u003escreenWidth\u003c/span\u003e, \u003cspan class=\"dc\"\u003escreenHeight\u003c/span\u003e);\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003econst\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e scaledWidth\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"dc\"\u003e Math\u003c/span\u003e.\u003cspan class=\"li dt\"\u003efloor\u003c/span\u003e(\u003cspan class=\"dc\"\u003escreenWidth\u003c/span\u003e\u003cspan class=\"lk\"\u003e *\u003c/span\u003e\u003cspan class=\"dc\"\u003e scale\u003c/span\u003e);\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003econst\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e scaledHeight\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"dc\"\u003e Math\u003c/span\u003e.\u003cspan class=\"li dt\"\u003efloor\u003c/span\u003e(\u003cspan class=\"dc\"\u003escreenHeight\u003c/span\u003e\u003cspan class=\"lk\"\u003e *\u003c/span\u003e\u003cspan class=\"dc\"\u003e scale\u003c/span\u003e);\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e// Resize image to scaled dimensions before sending to Claude\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003econst\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e screenshot\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"li dt\"\u003e captureAndResize\u003c/span\u003e(\u003cspan class=\"dc\"\u003escaledWidth\u003c/span\u003e, \u003cspan class=\"dc\"\u003escaledHeight\u003c/span\u003e);\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e// When handling Claude's coordinates, scale them back up\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003efunction\u003c/span\u003e\u003cspan class=\"li dt\"\u003e executeClick\u003c/span\u003e(\u003cspan class=\"lj dc\"\u003ex\u003c/span\u003e\u003cspan class=\"lk\"\u003e:\u003c/span\u003e\u003cspan class=\"l1 d2\"\u003e number\u003c/span\u003e, \u003cspan class=\"lj dc\"\u003ey\u003c/span\u003e\u003cspan class=\"lk\"\u003e:\u003c/span\u003e\u003cspan class=\"l1 d2\"\u003e number\u003c/span\u003e)\u003cspan class=\"lk\"\u003e:\u003c/span\u003e\u003cspan class=\"l1 d2\"\u003e void\u003c/span\u003e {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003e  const\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e screenX\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"dc\"\u003e x\u003c/span\u003e\u003cspan class=\"lk\"\u003e /\u003c/span\u003e\u003cspan class=\"dc\"\u003e scale\u003c/span\u003e;\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003e  const\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e screenY\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"dc\"\u003e y\u003c/span\u003e\u003cspan class=\"lk\"\u003e /\u003c/span\u003e\u003cspan class=\"dc\"\u003e scale\u003c/span\u003e;\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"li dt\"\u003e  performClick\u003c/span\u003e(\u003cspan class=\"dc\"\u003escreenX\u003c/span\u003e, \u003cspan class=\"dc\"\u003escreenY\u003c/span\u003e);\u003c/span\u003e\n\u003cspan class=\"line\"\u003e}\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e3c:oc10,ee:[\"$\",\"$L135\",\"184\",{\"exclude\":\"shell\",\"children\":[[\"$\",\"$L137\",\".$0\",{\"wrap\":false,\"language\":\"python\",\"label\":\"Python\",\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$164\"}}]}],[\"$\",\"$L137\",\".$1\",{\"wrap\":false,\"language\":\"typescript\",\"label\":\"TypeScript\",\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$165\"}}]}],\"$L166\",\"$L167\",\"$L168\",\"$L169\",\"$L16a\"]}]\nef:[\"$\",\"$L96\",\"186\",{\"variant\":\"muted\",\"id\":\"$undefined\",\"icon\":\"$undefined\",\"className\":\"prose-block print:break-inside-avoid print:[:is(h2,h3,h4)+\u0026]:break-after-avoid\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"macOS Retina displays\"]}],\" capture screenshots at a device pixel ratio of 2, so the image is twice the resolution of the logical screen coordinates. Either downscale the screenshot by 2x before sending, or halve the coordinates Claude returns before issuing the click.\"]}]]}]\nf0:[\"$\",\"p\",\"188\",{\"children\":[\"When you choose a display resolution and return screenshots:\"]}]\nf1:[\"$\",\"ul\",\"190\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"For general desktop tasks, use 1024x768 or 1280x720; for web applications, use 1280x800 or 1366x768.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Avoid resolutions above 1920x1080 to prevent performance issues.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"Encode screenshots as base64 PNG or JPEG, and consider compressing large screenshots to improve performance.\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"Include relevant metadata such as timestamp or display state.\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[\"If you use higher resolutions, ensure coordinates are accurately scaled.\"]}],\"\\n\"]}]\nf2:[\"$\",\"h3\",\"192\",{\"id\":\"manage-screenshot-history\",\"className\":\"group\",\"children\":[[\"Manage screenshot history\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"manage-screenshot-history\",\"name\":\"Manage screenshot history\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nf3:[\"$\",\"p\",\"194\",{\"children\":[\"Long agent loops accumulate screenshots quickly (roughly 1,000–1,800 input tokens each). The API’s \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/vision#request-limits\",\"untracked\":false,\"children\":[\"request limits\"]}],\" also apply. Once a single request carries more than 20 images, every image in it is held to a stricter per-side limit. A loop that keeps its screenshot history reaches that count within a few dozen turns, so either resize each screenshot to stay under that limit or prune older screenshots to keep 20 or fewer in the request.\"]}]\nf4:[\"$\",\"p\",\"196\",{\"children\":[\"To keep \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/prompt-caching\",\"untracked\":false,\"children\":[\"Prompt caching\"]}],\" effective while bounding context:\"]}]\n3c:o9a5,f5:[\"$\",\"ul\",\"198\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Place one \",[\"$\",\"code\",\"1\",{\"children\":[\"cache_control\"]}],\" breakpoint after the system prompt and tool definitions, and up to three more on the last \",[\"$\",\"code\",\"3\",{\"children\":[\"tool_result\"]}],\" block of each of the most recent turns, advancing them each turn. Within a \",[\"$\",\"$L97\",\"5\",{\"href\":\"#batch-actions\",\"untracked\":false,\"children\":[\"batch action\"]}],\", markers on several blocks act as a single breakpoint, but each still counts toward the limit of four, so use at most one in any turn.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Prune old screenshots in \",[\"$\",\"em\",\"1\",{\"children\":[\"batches\"]}],\", not one each turn. Dropping a screenshot every turn changes the prefix every turn and invalidates the cache. A reasonable default is to keep the last three screenshots and prune every 25 turns, so the prefix stays byte-identical between prune events; if your screenshots exceed the stricter limit, choose an interval that keeps each request at 20 or fewer images.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"On Claude 5.1 and later models, avoid pruning on the client: removing an earlier screenshot from a request \",[\"$\",\"$L97\",\"1\",{\"href\":\"/docs/en/build-with-claude/thinking#preserved-in-conversation\",\"untracked\":false,\"children\":[\"invalidates every later thinking block\"]}],\" in that request and in every later request. Resize screenshots to stay under the stricter limit instead and use server-side \",[\"$\",\"$L97\",\"3\",{\"href\":\"/docs/en/build-with-claude/context-editing#tool-result-clearing\",\"untracked\":false,\"children\":[\"tool result clearing\"]}],\" to drop old ones from the context. If you must prune, keep \",[\"$\",\"$L97\",\"5\",{\"href\":\"/docs/en/build-with-claude/thinking#preserved-thinking-controls\",\"untracked\":false,\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"prefix_mismatch_behavior: \\\"drop_block\\\"\"]}]]}],\" set from then on; after each prune, Claude continues without the thinking produced since the pruned screenshot, on that request and every later one. On Claude Sonnet 5.5 and Claude Haiku 5.5, \",[\"$\",\"code\",\"7\",{\"children\":[\"block_binding\"]}],\" works only with \",[\"$\",\"code\",\"9\",{\"children\":[\"thinking: {\\\"type\\\": \\\"adaptive\\\"}\"]}],\". With any other thinking setting on those models, keep the history append-only or strip every \",[\"$\",\"code\",\"11\",{\"children\":[\"thinking\"]}],\" and \",[\"$\",\"code\",\"13\",{\"children\":[\"redacted_thinking\"]}],\" block after the pruned screenshot.\"]}],\"\\n\"]}]\n3c:o229,f6:[\"$\",\"h3\",\"200\",{\"id\":\"diagnose-click-issues\",\"className\":\"group\",\"children\":[[\"Diagnose click issues\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"diagnose-click-issues\",\"name\":\"Diagnose click issues\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nf7:[\"$\",\"p\",\"202\",{\"children\":[\"If clicks miss their targets, the cause is usually one of the following:\"]}]\n3c:o8bf,f8:[\"$\",\"div\",\"204\",{\"className\":\"prose-scroll relative print:overflow-visible\",\"children\":[\"$\",\"table\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"thead\",\"0\",{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"th\",\"0\",{\"children\":[\"Symptom\"]}],[\"$\",\"th\",\"1\",{\"children\":[\"Likely cause\"]}],[\"$\",\"th\",\"2\",{\"children\":[\"Try\"]}]]}]]}],[\"$\",\"tbody\",\"1\",{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"\",\"children\":[\"Clicks consistently offset in one direction\"]}],[\"$\",\"td\",\"1\",{\"className\":\"\",\"children\":[\"Claude’s coordinates, which are in the pixel space of the screenshots you return, are being applied to a display of a different size without scaling\"]}],[\"$\",\"td\",\"2\",{\"className\":\"\",\"children\":[\"Scale each coordinate by the ratio of your screen size to your screenshot size before clicking (see \",[\"$\",\"$L97\",\"1\",{\"href\":\"#handle-coordinate-scaling-for-higher-resolutions\",\"untracked\":false,\"children\":[\"Size screenshots to fit image limits\"]}],\"); on macOS Retina displays, account for the 2x device pixel ratio\"]}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"\",\"children\":[\"Clicks land in the right area but miss the target\"]}],[\"$\",\"td\",\"1\",{\"className\":\"\",\"children\":[\"Target is very small, detail was lost downscaling a 4K+ source, or aspect ratio was distorted\"]}],[\"$\",\"td\",\"2\",{\"className\":\"\",\"children\":[\"Keep the \",[\"$\",\"code\",\"1\",{\"children\":[\"zoom\"]}],\" member enabled and implement it so Claude can inspect the region at full resolution; capture at lower DPI or crop to the relevant region; preserve aspect ratio when resizing\"]}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"\",\"children\":[\"Claude clicks the wrong element entirely\"]}],[\"$\",\"td\",\"1\",{\"className\":\"\",\"children\":[\"Ambiguous instruction, or visually similar elements nearby\"]}],[\"$\",\"td\",\"2\",{\"className\":\"\",\"children\":[\"Use positional prompts (“the blue Submit button in the bottom-right”); break the interaction into smaller steps\"]}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"\",\"children\":[\"Accuracy is consistently poor\"]}],[\"$\",\"td\",\"1\",{\"className\":\"docs-nowrap\",\"children\":[\"Resolution too low\"]}],[\"$\",\"td\",\"2\",{\"className\":\"\",\"children\":[\"Try 1280x720 as a baseline\"]}]]}]]}]]}]}]\n3c:od5d,f9:[\"$\",\"$L96\",\"206\",{\"variant\":\"muted\",\"id\":\"$undefined\",\"icon\":[\"$\",\"$L84\",null,{\"name\":\"Lightbulb\",\"size\":\"auto\"}],\"className\":\"prose-block print:break-inside-avoid print:[:is(h2,h3,h4)+\u0026]:break-after-avoid\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Model choice affects click precision.\"]}],\" Among the models that use the \",[\"$\",\"code\",\"2\",{\"children\":[\"computer_20251124\"]}],\" tool, Claude Sonnet 4.6 is more mechanically precise at clicking than Claude Opus 4.6 and is more robust when screenshots require heavy downscaling. Claude Opus 4.7 narrows that gap: its click precision is roughly comparable to Sonnet 4.6, and its higher resolution limit means less downscaling is needed.\"]}]]}]\nfa:[\"$\",\"h3\",\"208\",{\"id\":\"follow-implementation-best-practices\",\"className\":\"group\",\"children\":[[\"Follow implementation best practices\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$L98\",null,{\"id\":\"follow-implementation-best-practices\",\"name\":\"Follow implementation best practices\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\n16c:T410,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003easync\u003c/span\u003e\u003cspan class=\"lk d4\"\u003e function\u003c/span\u003e\u003cspan class=\"li dt\"\u003e clickAndWait\u003c/span\u003e(\u003cspan class=\"lj dc\"\u003ex\u003c/span\u003e\u003cspan class=\"lk\"\u003e:\u003c/span\u003e\u003cspan class=\"l1 d2\"\u003e number\u003c/span\u003e, \u003cspan class=\"lj dc\"\u003ey\u003c/span\u003e\u003cspan class=\"lk\"\u003e:\u003c/span\u003e\u003cspan class=\"l1 d2\"\u003e number\u003c/span\u003e, \u003cspan class=\"lj dc\"\u003ewaitMs\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e 500\u003c/span\u003e)\u003cspan class=\"lk\"\u003e:\u003c/span\u003e\u003cspan class=\"lj d2\"\u003e Promise\u003c/span\u003e\u0026lt;\u003cspan class=\"l1 d2\"\u003evoid\u003c/span\u003e\u0026gt; {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"li dt\"\u003e  clickAt\u003c/span\u003e(\u003cspan class=\"dc\"\u003ex\u003c/span\u003e, \u003cspan class=\"dc\"\u003ey\u003c/span\u003e);\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e  await\u003c/span\u003e\u003cspan class=\"lk d4\"\u003e new\u003c/span\u003e\u003cspan class=\"l1 d2\"\u003e Promise\u003c/span\u003e((\u003cspan class=\"lj dc\"\u003eresolve\u003c/span\u003e) \u003cspan class=\"lk d4\"\u003e=\u0026gt;\u003c/span\u003e\u003cspan class=\"li dt\"\u003e setTimeout\u003c/span\u003e(\u003cspan class=\"dc\"\u003eresolve\u003c/span\u003e, \u003cspan class=\"dc\"\u003ewaitMs\u003c/span\u003e)); \u003cspan class=\"lg d7\"\u003e// Allow UI to update\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e}\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e16d:T46f,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003efunc\u003c/span\u003e\u003cspan class=\"li dt\"\u003e clickAndWaitFor\u003c/span\u003e(\u003cspan class=\"lj dc\"\u003ex\u003c/