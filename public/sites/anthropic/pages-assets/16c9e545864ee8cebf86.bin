<span class="line"></span>
<span class="line"></span>
<span class="line"><span class="lk d4">def</span><span class="li dt"> validate_action</span>(<span class="dc">action_type</span>, <span class="dc">params</span>):</span>
<span class="line"><span class="lk dl">    if</span> action_type <span class="lk">==</span><span class="l3 dn"> "left_click"</span><span class="lk d4"> and</span><span class="l3 dn"> "coordinate"</span><span class="lk d4"> in</span> params:</span>
<span class="line">        x, y <span class="lk">=</span> params[<span class="l3 dn">"coordinate"</span>]</span>
<span class="line"><span class="lk dl">        if</span><span class="lk d4"> not</span> (<span class="l1 di">0</span><span class="lk"> &lt;=</span> x <span class="lk">&lt;</span> display_width <span class="lk d4">and</span><span class="l1 di"> 0</span><span class="lk"> &lt;=</span> y <span class="lk">&lt;</span> display_height):</span>
<span class="line"><span class="lk dl">            return</span><span class="l1 d4"> False</span>, <span class="l3 dn">"Coordinates out of bounds"</span></span>
<span class="line"><span class="lk dl">    return</span><span class="l1 d4"> True</span>, <span class="l1 d4">None</span></span></code></pre></div></div></div></div></div></div></div></div></div><div data-orientation="vertical" data-hidden="" data-index="-1" data-closed="" class="group-hover/accordion:[&amp;:has(+*:not([data-disabled])&gt;[data-cds=AccordionHeader]:hover)]:border-b-transparent group-hover/accordion:[&amp;[data-closed]:not([data-disabled]):has(&gt;[data-cds=AccordionHeader]:hover)]:border-b-transparent touch:[&amp;:has(+*:not([data-disabled])&gt;[data-cds=AccordionHeader]:active)]:border-b-transparent touch:[&amp;[data-closed]:not([data-disabled]):has(&gt;[data-cds=AccordionHeader]:active)]:border-b-transparent"><h3 data-orientation="vertical" data-hidden="" data-index="-1" data-closed="" data-cds="AccordionHeader" class="flex mx-outset w-stretch" style="--cds-outset-x:var(--accordion-px)"><button type="button" data-value="" data-orientation="vertical" data-hidden="" data-index="-1" tabindex="0" aria-disabled="false" aria-expanded="false" id="base-ui-_R_dkvcqalubtabsknr5td9leailbH2_" data-size="lg" class="cds-reset group/acc flex w-full items-start gap-sm min-h-control rounded-[var(--accordion-radius)] px-[var(--accordion-px)] py-[calc((var(--cds-h-control)_-_1lh)_/_2)] font-sans text-start text-body font-medium font-control text-primary outline-none focus-visible:outline-hidden hover:bg-fill-ghost-hover touch:active:bg-fill-ghost-hover focus-visible:bg-fill-ghost-hover focus-visible:[box-shadow:inset_0_0_0_1px_var(--cds-fill-accent)] data-[disabled]:opacity-disabled data-[disabled]:pointer-events-none stacks:focus-visible:bg-fill-ghost-selected select-text"><span class="min-w-0 flex-1 break-words">Log actions for debugging</span><span data-cds-accordion-caret="" class="flex h-[1lh] shrink-0 items-center"><span data-cds="Icon" style="font-size:calc(1.5rem * var(--cds-rem-scale, 1));font-weight:433.3;font-variation-settings:&quot;opsz&quot; 24;width:0