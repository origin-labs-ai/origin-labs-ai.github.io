3c/span\u003e params:\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        x, y \u003cspan class=\"lk\"\u003e=\u003c/span\u003e params[\u003cspan class=\"l3 dn\"\u003e\"coordinate\"\u003c/span\u003e]\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e        if\u003c/span\u003e\u003cspan class=\"lk d4\"\u003e not\u003c/span\u003e (\u003cspan class=\"l1 di\"\u003e0\u003c/span\u003e\u003cspan class=\"lk\"\u003e \u0026lt;=\u003c/span\u003e x \u003cspan class=\"lk\"\u003e\u0026lt;\u003c/span\u003e display_width \u003cspan class=\"lk d4\"\u003eand\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e 0\u003c/span\u003e\u003cspan class=\"lk\"\u003e \u0026lt;=\u003c/span\u003e y \u003cspan class=\"lk\"\u003e\u0026lt;\u003c/span\u003e display_height):\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e            return\u003c/span\u003e\u003cspan class=\"l1 d4\"\u003e False\u003c/span\u003e, \u003cspan class=\"l3 dn\"\u003e\"Coordinates out of bounds\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e    return\u003c/span\u003e\u003cspan class=\"l1 d4\"\u003e True\u003c/span\u003e, \u003cspan class=\"l1 d4\"\u003eNone\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e3c:o9,1a7:Ta0f,3c:oa0f,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003econst\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e displayWidth\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e 1024\u003c/span\u003e;\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003econst\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e displayHeight\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e 768\u003c/span\u003e;\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspa