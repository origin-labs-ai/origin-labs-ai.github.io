      \"name\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"bash\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e      }\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e    ],\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e    \"messages\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: [\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e      {\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e        \"role\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"user\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l4 dj\"\u003e        \"content\"\u003c/span\u003e\u003cspan class=\"l6 dv\"\u003e: \u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e\"Save a picture of a cat to my desktop.\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e      }\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e    ]\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l6 dv\"\u003e  }\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e'\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003eb8:[\"$\",\"$L14c\",\"28\",{\"children\":[[\"$\",\"$L14e\",\".$0\",{\"wrap\":false,\"language\":\"bash\",\"label\":\"cURL\",\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$14f\"}}]}],\"$L150\",\"$L151\",\"$L152\",\"$L153\",\"$L154\",\"$L155\",\"$L156\",\"$L157\"]}]\nb9:[\"$\",\"p\",\"30\",{\"children\":[\"When Claude acts on the desktop, the response has a \",[\"$\",\"code\",\"1\",{\"children\":[\"stop_reason\"]}],\" of \",[\"$\",\"code\",\"3\",{\"children\":[\"tool_use\"]}],\" and contains one or more member \",[\"$\",\"code\",\"5\",{\"children\":[\"tool_use\"]}],\" blocks, each naming a member tool and carrying \",[\"$\",\"code\",\"7\",{\"children\":[\"\\\"toolset_name\\\": \\\"computer\\\"\"]}],\". Partway through this task, after Claude has received a screenshot of the desktop, a response might look like this:\"]}]\n159:T98a,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e{\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"id\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"msg_01UZ3bXcQH8mTqNhVfL9eK2p\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"message\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"role\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"assistant\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"model\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"claude-opus-5-5\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"content\"\u003c/span\u003e: [\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"text\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"text\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"I'll open the web browser to find a picture of a cat.\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"tool_use\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"id\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"toolu_01WkoTUvSHDzTBu2xnGk8Ep8\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"name\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"left_click\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"toolset_name\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"computer\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"input\"\u003c/span\u003e: { \u003cspan class=\"l5 dc\"\u003e\"coordinate\"\u003c/span\u003e: [\u003cspan class=\"l1 di\"\u003e512\u003c/span\u003e, \u003cspan class=\"l1 di\"\u003e742\u003c/span\u003e] }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"tool_use\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"id\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"toolu_017nJn3RgSCkTMwuZDb4uUov\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"name\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"screenshot\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"toolset_name\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"computer\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"input\"\u003c/span\u003e: {}\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e  ],\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"stop_reason\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"tool_use\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"stop_sequence\"\u003c/span\u003e: \u003cspan class=\"l1 d4\"\u003enull\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e}\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003eba:[\"$\",\"$L158\",\"32\",{\"language\":\"json\",\"label\":\"Output\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L14e\",null,{\"wrap\":false,\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$159\"}}]}]}]\nbb:[\"$\",\"p\",\"34\",{\"children\":[\"Your application runs each call in order in your own environment, returns one \",[\"$\",\"code\",\"1\",{\"children\":[\"tool_result\"]}],\" block for each \",[\"$\",\"code\",\"3\",{\"children\":[\"tool_use\"]}],\" block, and calls the API again; \",[\"$\",\"$Lae\",\"5\",{\"href\":\"#how-computer-use-works\",\"untracked\":false,\"children\":[\"How computer use works\"]}],\" describes that loop, and the rest of this page shows how to implement it.\"]}]\nbc:[\"$\",\"hr\",\"36\",{\"children\":\"$undefined\"}]\nbd:[\"$\",\"h2\",\"38\",{\"id\":\"how-computer-use-works\",\"className\":\"group\",\"children\":[[\"How computer use works\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Laf\",null,{\"id\":\"how-computer-use-works\",\"name\":\"How computer use works\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nbe:[\"$\",\"$L15a\",\"40\",{\"children\":[[\"$\",\"$L15b\",\"0\",{\"title\":\"Provide Claude with the computer use tool and a user prompt\",\"children\":[[\"$\",\"ul\",\"0\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Add the computer use toolset (and optionally other tools) to the \",[\"$\",\"code\",\"1\",{\"children\":[\"tools\"]}],\" array of your API request.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Include a user prompt that requires desktop interaction, for example, “Save a picture of a cat to my desktop.”\"]}],\"\\n\"]}]]}],[\"$\",\"$L15b\",\"1\",{\"title\":\"Claude responds with member tool calls\",\"children\":[[\"$\",\"ul\",\"0\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Claude assesses whether acting on the desktop can help with the user’s query.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"If so, Claude responds with one or more member \",[\"$\",\"code\",\"1\",{\"children\":[\"tool_use\"]}],\" blocks, such as \",[\"$\",\"code\",\"3\",{\"children\":[\"screenshot\"]}],\", \",[\"$\",\"code\",\"5\",{\"children\":[\"left_click\"]}],\", or \",[\"$\",\"code\",\"7\",{\"children\":[\"type\"]}],\", each carrying \",[\"$\",\"code\",\"9\",{\"children\":[\"\\\"toolset_name\\\": \\\"computer\\\"\"]}],\". A response with several of these blocks is a \",[\"$\",\"$Lae\",\"11\",{\"href\":\"#batch-actions\",\"untracked\":false,\"children\":[\"batch action\"]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"The API response has a \",[\"$\",\"code\",\"1\",{\"children\":[\"stop_reason\"]}],\" of \",[\"$\",\"code\",\"3\",{\"children\":[\"tool_use\"]}],\", signaling a tool use request.\"]}],\"\\n\"]}]]}],[\"$\",\"$L15b\",\"2\",{\"title\":\"Run the calls in order and return results\",\"children\":[[\"$\",\"ul\",\"0\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Iterate over every \",[\"$\",\"code\",\"1\",{\"children\":[\"tool_use\"]}],\" block in the response, in order. For each one, dispatch on the member \",[\"$\",\"code\",\"3\",{\"children\":[\"name\"]}],\" together with \",[\"$\",\"code\",\"5\",{\"children\":[\"toolset_name\"]}],\", and perform that action with the block’s \",[\"$\",\"code\",\"7\",{\"children\":[\"input\"]}],\" on your container or virtual machine.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Continue the conversation with a new \",[\"$\",\"code\",\"1\",{\"children\":[\"user\"]}],\" message that contains one \",[\"$\",\"code\",\"3\",{\"children\":[\"tool_result\"]}],\" block for each \",[\"$\",\"code\",\"5\",{\"children\":[\"tool_use\"]}],\" block, matched by \",[\"$\",\"code\",\"7\",{\"children\":[\"tool_use_id\"]}],\" and each echoing \",[\"$\",\"code\",\"9\",{\"children\":[\"\\\"toolset_name\\\": \\\"computer\\\"\"]}],\". Return an image for \",[\"$\",\"code\",\"11\",{\"children\":[\"screenshot\"]}],\" and \",[\"$\",\"code\",\"13\",{\"children\":[\"zoom\"]}],\"; a short text such as \",[\"$\",\"code\",\"15\",{\"children\":[\"OK\"]}],\" is enough for the other actions.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"If an action fails, return \",[\"$\",\"code\",\"1\",{\"children\":[\"is_error: true\"]}],\" for that block and answer the rest of the batch as described in \",[\"$\",\"$Lae\",\"3\",{\"href\":\"#batch-actions\",\"untracked\":false,\"children\":[\"Batch actions\"]}],\".\"]}],\"\\n\"]}]]}],[\"$\",\"$L15b\",\"3\",{\"title\":\"Claude continues until the task is complete\",\"children\":[[\"$\",\"ul\",\"0\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Claude analyzes the tool results to determine if more actions are needed or the task has been completed.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"If Claude determines more actions are needed, it responds with another \",[\"$\",\"code\",\"1\",{\"children\":[\"tool_use\"]}],\" \",[\"$\",\"code\",\"3\",{\"children\":[\"stop_reason\"]}],\"; return to step 3.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"Otherwise, it returns a text response to the user.\"]}],\"\\n\"]}]]}]]}]\nbf:[\"$\",\"p\",\"42\",{\"children\":[\"Steps 3 and 4, repeated without user input, form the “agent loop”: Claude responds with a tool use request, and your application responds to Claude with the results of evaluating that request.\"]}]\nc0:[\"$\",\"h3\",\"44\",{\"id\":\"batch-actions\",\"className\":\"group\",\"children\":[[\"Batch actions\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Laf\",null,{\"id\":\"batch-actions\",\"name\":\"Batch actions\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nc1:[\"$\",\"p\",\"46\",{\"children\":[\"Claude can plan a short sequence of actions, such as click, type, and then take a screenshot, and return them together in one response. This is called a batch action; it uses the same response shape as \",[\"$\",\"$Lae\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/parallel-tool-use\",\"untracked\":false,\"children\":[\"parallel tool use\"]}],\" with one difference: you run the blocks in order rather than concurrently.\"]}]\nc2:[\"$\",\"p\",\"48\",{\"children\":[\"A response with a three-action batch looks like this:\"]}]\n15c:T8c5,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e{\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"role\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"assistant\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"content\"\u003c/span\u003e: [\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"tool_use\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"id\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"toolu_01HqCF3nJ4Vzr8sTkPZ2wxYA\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"name\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"left_click\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"toolset_name\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"computer\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"input\"\u003c/span\u003e: { \u003cspan class=\"l5 dc\"\u003e\"coordinate\"\u003c/span\u003e: [\u003cspan class=\"l1 di\"\u003e640\u003c/span\u003e, \u003cspan class=\"l1 di\"\u003e60\u003c/span\u003e] }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"tool_use\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"id\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"toolu_01Ppr3sZ3TnE9m6VUu4RyH2K\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"name\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"type\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"toolset_name\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"computer\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"input\"\u003c/span\u003e: { \u003cspan class=\"l5 dc\"\u003e\"text\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"pictures of cats\"\u003c/span\u003e }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"tool_use\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"id\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"toolu_01Xf5W1sD8Q9aBcJ7kLmN2pQ\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"name\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"screenshot\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"toolset_name\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"computer\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"input\"\u003c/span\u003e: {}\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e  ]\u003c/span\u003e\n\u003cspan class=\"line\"\u003e}\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003ec3:[\"$\",\"$L158\",\"50\",{\"language\":\"json\",\"label\":\"$undefined\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L14e\",null,{\"wrap\":false,\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$15c\"}}]}]}]\nc4:[\"$\",\"p\",\"52\",{\"children\":[\"Return one \",[\"$\",\"code\",\"1\",{\"children\":[\"tool_result\"]}],\" block for each \",[\"$\",\"code\",\"3\",{\"children\":[\"tool_use\"]}],\" block, matched by \",[\"$\",\"code\",\"5\",{\"children\":[\"tool_use_id\"]}],\", all in the next \",[\"$\",\"code\",\"7\",{\"children\":[\"user\"]}],\" message. Every result for a member tool must carry \",[\"$\",\"code\",\"9\",{\"children\":[\"\\\"toolset_name\\\": \\\"computer\\\"\"]}],\"; a result that omits it, or that names a different toolset from its \",[\"$\",\"code\",\"11\",{\"children\":[\"tool_use\"]}],\" block, is rejected. Only \",[\"$\",\"code\",\"13\",{\"children\":[\"screenshot\"]}],\" and \",[\"$\",\"code\",\"15\",{\"children\":[\"zoom\"]}],\" results need an image; for the other members, a short text acknowledgment such as \",[\"$\",\"code\",\"17\",{\"children\":[\"OK\"]}],\" is enough (\",[\"$\",\"code\",\"19\",{\"children\":[\"cursor_position\"]}],\" returns the coordinates as text):\"]}]\n15d:Taa7,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e{\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"role\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"user\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e  \"content\"\u003c/span\u003e: [\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"tool_result\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"tool_use_id\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"toolu_01HqCF3nJ4Vzr8sTkPZ2wxYA\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"toolset_name\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"computer\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"content\"\u003c/span\u003e: [{ \u003cspan class=\"l5 dc\"\u003e\"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"text\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"text\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"OK\"\u003c/span\u003e }]\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"tool_result\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"tool_use_id\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"toolu_01Ppr3sZ3TnE9m6VUu4RyH2K\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"toolset_name\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"computer\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"content\"\u003c/span\u003e: [{ \u003cspan class=\"l5 dc\"\u003e\"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"text\"\u003c/span\u003e, \u003cspan class=\"l5 dc\"\u003e\"text\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"OK\"\u003c/span\u003e }]\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    },\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"tool_result\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"tool_use_id\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"toolu_01Xf5W1sD8Q9aBcJ7kLmN2pQ\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"toolset_name\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"computer\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e      \"content\"\u003c/span\u003e: [\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"image\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e          \"source\"\u003c/span\u003e: {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e            \"type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"base64\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e            \"media_type\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"image/png\"\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l5 dc\"\u003e            \"data\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"iVBORw0KGgo...\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e          }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e      ]\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e  ]\u003c/span\u003e\n\u003cspan class=\"line\"\u003e}\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003ec5:[\"$\",\"$L158\",\"54\",{\"language\":\"json\",\"label\":\"$undefined\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L14e\",null,{\"wrap\":false,\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$15d\"}}]}]}]\nc6:[\"$\",\"p\",\"56\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Run blocks in order and stop at the first failure.\"]}],\" Later actions in a batch usually depend on earlier ones: the \",[\"$\",\"code\",\"2\",{\"children\":[\"type\"]}],\" in this example enters text into whatever the preceding click focused. Run the blocks sequentially in the order they appear in \",[\"$\",\"code\",\"4\",{\"children\":[\"content\"]}],\", and if one fails, don’t run the rest. Every \",[\"$\",\"code\",\"6\",{\"children\":[\"tool_use\"]}],\" block still needs a \",[\"$\",\"code\",\"8\",{\"children\":[\"tool_result\"]}],\", so answer the batch as follows:\"]}]\nc7:[\"$\",\"ul\",\"58\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"For each action that succeeded, return its normal result.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"For the action that failed, return \",[\"$\",\"code\",\"1\",{\"children\":[\"is_error: true\"]}],\" with a text description of what went wrong.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"For every later action in the batch, return \",[\"$\",\"code\",\"1\",{\"children\":[\"is_error: true\"]}],\" with exactly this text (the browser use tool uses its own \",[\"$\",\"$Lae\",\"3\",{\"href\":\"/docs/en/agents-and-tools/tool-use/browser-use-tool#batch-actions\",\"untracked\":false,\"children\":[\"halt text\"]}],\"):\"]}],\"\\n\"]}]\nc8:[\"$\",\"$L158\",\"60\",{\"language\":\"json\",\"label\":\"$undefined\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L14e\",null,{\"wrap\":false,\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cpre class=\\\"shiki\\\"\u003e\u003ccode\u003e\u003cspan class=\\\"line\\\"\u003e{\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"type\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"tool_result\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"tool_use_id\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"toolu_01Xf5W1sD8Q9aBcJ7kLmN2pQ\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"toolset_name\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"computer\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"is_error\\\"\u003c/span\u003e: \u003cspan class=\\\"l1 d4\\\"\u003etrue\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"content\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"Not executed: an earlier computer action in this turn failed.\\\"\u003c/span\u003e\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e}\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\"}}]}]}]\nc9:[\"$\",\"p\",\"62\",{\"children\":[\"Claude then reads which actions succeeded, which one failed, and which were skipped, and replans on its next turn. A request that leaves any \",[\"$\",\"code\",\"1\",{\"children\":[\"tool_use\"]}],\" block in the batch unanswered is rejected with an \",[\"$\",\"code\",\"3\",{\"children\":[\"invalid_request_error\"]}],\", so an agent loop that reads only the first block fails on its next call. If your application asks a human to confirm consequential actions, make that check before each block runs, because a batch can complete a multistep action within one turn.\"]}]\nca:[\"$\",\"p\",\"64\",{\"children\":[\"Claude typically finishes a batch with \",[\"$\",\"code\",\"1\",{\"children\":[\"screenshot\"]}],\" so it can observe the outcome before determining what to do next. When a batch doesn’t end with one, your application can attach a screenshot as an extra \",[\"$\",\"code\",\"3\",{\"children\":[\"image\"]}],\" block on the last result in the batch so that Claude always receives the current state of the screen, which saves a round trip compared with waiting for Claude to ask. You can also prompt Claude to end every batch with a screenshot (see \",[\"$\",\"$Lae\",\"5\",{\"href\":\"#optimize-model-performance-with-prompting\",\"untracked\":false,\"children\":[\"Optimize model performance with prompting\"]}],\").\"]}]\ncb:[\"$\",\"h3\",\"66\",{\"id\":\"the-computing-environment\",\"className\":\"group\",\"children\":[[\"The computing environment\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Laf\",null,{\"id\":\"the-computing-environment\",\"name\":\"The computing environment\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ncc:[\"$\",\"p\",\"68\",{\"children\":[\"Computer use requires a sandboxed computing environment where Claude can safely interact with applications and the web. This environment includes:\"]}]\ncd:[\"$\",\"ol\",\"70\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Virtual display:\"]}],\" A virtual X11 display server (using Xvfb) that renders the desktop interface that Claude receives as screenshots and controls with mouse/keyboard actions.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Desktop environment:\"]}],\" A lightweight UI with window manager (Mutter) and panel (Tint2) running on Linux, which provides a consistent graphical interface for Claude to interact with.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Applications:\"]}],\" Preinstalled Linux applications such as Firefox, LibreOffice, text editors, and file managers that Claude can use to complete tasks.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Tool implementations:\"]}],\" Integration code that translates Claude’s abstract tool requests (such as “move mouse” or “take screenshot”) into actual operations in the virtual environment.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Agent loop:\"]}],\" A program that handles communication between Claude and the environment, sending Claude’s actions to the environment and returning the results (screenshots, command outputs) back to Claude.\"]}],\"\\n\"]}],\"\\n\"]}]\nce:[\"$\",\"p\",\"72\",{\"children\":[\"When you use computer use, Claude doesn’t directly connect to this environment. Instead, your application:\"]}]\ncf:[\"$\",\"ol\",\"74\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Receives Claude’s tool use requests.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Translates them into actions in your computing environment.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"Captures the results (such as screenshots and command outputs).\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"Returns these results to Claude.\"]}],\"\\n\"]}]\nd0:[\"$\",\"p\",\"76\",{\"children\":[\"For security and isolation, the reference implementation runs all of this inside a Docker container with appropriate port mappings for viewing and interacting with the environment.\"]}]\nd1:[\"$\",\"hr\",\"78\",{\"children\":\"$undefined\"}]\nd2:[\"$\",\"h2\",\"80\",{\"id\":\"how-to-implement-computer-use\",\"className\":\"group\",\"children\":[[\"How to implement computer use\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Laf\",null,{\"id\":\"how-to-implement-computer-use\",\"name\":\"How to implement computer use\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nd3:[\"$\",\"p\",\"82\",{\"children\":[\"Upgrading an existing \",[\"$\",\"code\",\"1\",{\"children\":[\"computer_20251124\"]}],\" integration? Start with \",[\"$\",\"$Lae\",\"3\",{\"href\":\"#migrate-from-computer-20251124\",\"untracked\":false,\"children\":[\"Migrate from \",[\"$\",\"code\",\"1\",{\"children\":[\"computer_20251124\"]}]]}],\"; the rest of this section applies to both new and migrated integrations.\"]}]\nd4:[\"$\",\"$Lad\",\"84\",{\"variant\":\"muted\",\"id\":\"$undefined\",\"icon\":[\"$\",\"$L9b\",null,{\"name\":\"Lightbulb\",\"size\":\"auto\"}],\"className\":\"prose-block print:break-inside-avoid print:[:is(h2,h3,h4)+\u0026]:break-after-avoid\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"The \",[\"$\",\"$Lae\",\"1\",{\"href\":\"https://github.com/anthropics/claude-quickstarts/tree/main/computer-use-demo\",\"untracked\":false,\"children\":[\"computer use reference implementation\"]}],\" is a complete working example: a \",[\"$\",\"$Lae\",\"3\",{\"href\":\"https://github.com/anthropics/claude-quickstarts/blob/main/computer-use-demo/Dockerfile\",\"untracked\":false,\"children\":[\"containerized environment\"]}],\" suitable for computer use, implementations of \",[\"$\",\"$Lae\",\"5\",{\"href\":\"https://github.com/anthropics/claude-quickstarts/tree/main/computer-use-demo/computer_use_demo/tools\",\"untracked\":false,\"children\":[\"the computer use tools\"]}],\", an \",[\"$\",\"$Lae\",\"7\",{\"href\":\"https://github.com/anthropics/claude-quickstarts/blob/main/computer-use-demo/computer_use_demo/loop.py\",\"untracked\":false,\"children\":[\"agent loop\"]}],\" that calls the Claude API and runs the tools, and a web interface for the container, loop, and tools. To use \",[\"$\",\"code\",\"9\",{\"children\":[\"computer_toolset_20260801\"]}],\", choose a \",[\"$\",\"$Lae\",\"11\",{\"href\":\"#availability-feature-support\",\"untracked\":false,\"children\":[\"model that supports it\"]}],\", then select the toolset under \",[\"$\",\"strong\",\"13\",{\"children\":[\"Tool Versions\"]}],\" in the web interface’s sidebar.\"]}]]}]\nd5:[\"$\",\"h3\",\"86\",{\"id\":\"understanding-the-agentic-loop\",\"className\":\"group\",\"children\":[[\"Understand the agent loop\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Laf\",null,{\"id\":\"understanding-the-agentic-loop\",\"name\":\"Understand the agent loop\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nd6:[\"$\",\"p\",\"88\",{\"children\":[\"The core of computer use is the “agent loop”: a cycle where Claude requests tool actions, and your application runs them and returns results to Claude. The loop uses the client you created in the \",[\"$\",\"$Lae\",\"1\",{\"href\":\"#quick-start\",\"untracked\":false,\"children\":[\"Quick start\"]}],\", a \",[\"$\",\"code\",\"3\",{\"children\":[\"tools\"]}],\" array that declares only the computer use toolset, and the tool-call processing helper under \",[\"$\",\"$Lae\",\"5\",{\"href\":\"#implement-the-computer-use-tool\",\"untracked\":false,\"children\":[\"Implement the computer use tool\"]}],\". If you also declare other tools, such as the Quick start’s bash and text editor tools, dispatch their \",[\"$\",\"code\",\"7\",{\"children\":[\"tool_use\"]}],\" blocks in the same pass; the helper answers only computer use member calls, and the loop treats a turn with no answered calls as complete. Here’s a simplified example:\"]}]\n15e:Ta9e,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003edef\u003c/span\u003e\u003cspan class=\"li dt\"\u003e sampling_loop\u003c/span\u003e(\u003cspan class=\"dc\"\u003emodel\u003c/span\u003e: \u003cspan class=\"l1 d2\"\u003estr\u003c/span\u003e, \u003cspan class=\"dc\"\u003emessages\u003c/span\u003e: list[MessageParam], \u003cspan class=\"dc\"\u003emax_iterations\u003c/span\u003e: \u003cspan class=\"l1 d2\"\u003eint\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e 10\u003c/span\u003e):\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l3 dn\"\u003e    \"\"\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l3 dn\"\u003e    Run the computer-use agent loop until Claude stops requesting tools\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l3 dn\"\u003e    or the iteration limit is reached.\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"l3 dn\"\u003e    \"\"\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e    for\u003c/span\u003e _ \u003cspan class=\"lk dl\"\u003ein\u003c/span\u003e\u003cspan class=\"l1 dt\"\u003e range\u003c/span\u003e(max_iterations):\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        response \u003cspan class=\"lk\"\u003e=\u003c/span\u003e client.messages.create(\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lj dc\"\u003e            model\u003c/span\u003e\u003cspan class=\"lk\"\u003e=\u003c/span\u003emodel,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lj dc\"\u003e            max_tokens\u003c/span\u003e\u003cspan class=\"lk\"\u003e=\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e4096\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lj dc\"\u003e            messages\u003c/span\u003e\u003cspan class=\"lk\"\u003e=\u003c/span\u003emessages,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lj dc\"\u003e            tools\u003c/span\u003e\u003cspan class=\"lk\"\u003e=\u003c/span\u003e\u003cspan class=\"l1\"\u003eTOOLS\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        )\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e        # Add Claude's response to the conversation history\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        messages.append({\u003cspan class=\"l3 dn\"\u003e\"role\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"assistant\"\u003c/span\u003e, \u003cspan class=\"l3 dn\"\u003e\"content\"\u003c/span\u003e: response.content})\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e        # Run the actions Claude requested, in order, and collect the results\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        tool_results \u003cspan class=\"lk\"\u003e=\u003c/span\u003e process_tool_calls(response)\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e        if\u003c/span\u003e\u003cspan class=\"lk d4\"\u003e not\u003c/span\u003e tool_results:\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e            return\u003c/span\u003e messages  \u003cspan class=\"lg d7\"\u003e# No more tool use; task complete\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e        # Send every result back to Claude in a single user message\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e        messages.append({\u003cspan class=\"l3 dn\"\u003e\"role\"\u003c/span\u003e: \u003cspan class=\"l3 dn\"\u003e\"user\"\u003c/span\u003e, \u003cspan class=\"l3 dn\"\u003e\"content\"\u003c/span\u003e: tool_results})\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e    return\u003c/span\u003e messages\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e15f:Te00,\u003cpre class=\"shiki\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003easync\u003c/span\u003e\u003cspan class=\"lk d4\"\u003e function\u003c/span\u003e\u003cspan class=\"li dt\"\u003e samplingLoop\u003c/span\u003e(\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lj dc\"\u003e  model\u003c/span\u003e\u003cspan class=\"lk\"\u003e:\u003c/span\u003e\u003cspan class=\"l1 d2\"\u003e string\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lj dc\"\u003e  messages\u003c/span\u003e\u003cspan class=\"lk\"\u003e:\u003c/span\u003e\u003cspan class=\"lj d2\"\u003e Anthropic\u003c/span\u003e.\u003cspan class=\"lj d2\"\u003eMessageParam\u003c/span\u003e[],\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lj dc\"\u003e  maxIterations\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e 10\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e)\u003cspan class=\"lk\"\u003e:\u003c/span\u003e\u003cspan class=\"lj d2\"\u003e Promise\u003c/span\u003e\u0026lt;\u003cspan class=\"lj d2\"\u003eAnthropic\u003c/span\u003e.\u003cspan class=\"lj d2\"\u003eMessageParam\u003c/span\u003e[]\u0026gt; {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e  // Run the computer-use agent loop until Claude stops requesting tools\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e  // or the iteration limit is reached.\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e  for\u003c/span\u003e (\u003cspan class=\"lk d4\"\u003elet\u003c/span\u003e\u003cspan class=\"dc\"\u003e i\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e 0\u003c/span\u003e; \u003cspan class=\"dc\"\u003ei\u003c/span\u003e\u003cspan class=\"lk\"\u003e \u0026lt;\u003c/span\u003e\u003cspan class=\"dc\"\u003e maxIterations\u003c/span\u003e; \u003cspan class=\"dc\"\u003ei\u003c/span\u003e\u003cspan class=\"lk\"\u003e++\u003c/span\u003e) {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003e    const\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e response\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"lk dl\"\u003e await\u003c/span\u003e\u003cspan class=\"dc\"\u003e client\u003c/span\u003e.\u003cspan class=\"dc\"\u003emessages\u003c/span\u003e.\u003cspan class=\"li dt\"\u003ecreate\u003c/span\u003e({\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e      model\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e      max_tokens:\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e 4096\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e      messages\u003c/span\u003e,\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e      tools\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    });\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e    // Add Claude's response to the conversation history\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e    messages\u003c/span\u003e.\u003cspan class=\"li dt\"\u003epush\u003c/span\u003e({ \u003cspan class=\"dc\"\u003erole:\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"assistant\"\u003c/span\u003e, \u003cspan class=\"dc\"\u003econtent:\u003c/span\u003e\u003cspan class=\"dc\"\u003e response\u003c/span\u003e.\u003cspan class=\"dc\"\u003econtent\u003c/span\u003e });\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e    // Run any tools Claude requested and collect results\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk d4\"\u003e    const\u003c/span\u003e\u003cspan class=\"l1 d3\"\u003e toolResults\u003c/span\u003e\u003cspan class=\"lk\"\u003e =\u003c/span\u003e\u003cspan class=\"li dt\"\u003e processToolCalls\u003c/span\u003e(\u003cspan class=\"dc\"\u003eresponse\u003c/span\u003e);\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e    if\u003c/span\u003e (\u003cspan class=\"dc\"\u003etoolResults\u003c/span\u003e.\u003cspan class=\"l1 dc\"\u003elength\u003c/span\u003e\u003cspan class=\"lk\"\u003e ===\u003c/span\u003e\u003cspan class=\"l1 di\"\u003e 0\u003c/span\u003e) {\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e      return\u003c/span\u003e\u003cspan class=\"dc\"\u003e messages\u003c/span\u003e; \u003cspan class=\"lg d7\"\u003e// No more tool use; task complete\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e    }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lg d7\"\u003e    // Send tool results back to Claude for the next iteration\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"dc\"\u003e    messages\u003c/span\u003e.\u003cspan class=\"li dt\"\u003epush\u003c/span\u003e({ \u003cspan class=\"dc\"\u003erole:\u003c/span\u003e\u003cspan class=\"l3 dn\"\u003e \"user\"\u003c/span\u003e, \u003cspan class=\"dc\"\u003econtent:\u003c/span\u003e\u003cspan class=\"dc\"\u003e toolResults\u003c/span\u003e });\u003c/span\u003e\n\u003cspan class=\"line\"\u003e  }\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan class=\"lk dl\"\u003e  return\u003c/span\u003e\u003cspan class=\"dc\"\u003e messages\u003c/span\u003e;\u003c/span\u003e\n\u003cspan class=\"line\"\u003e}\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003ed7:[\"$\",\"$L14c\",\"91\",{\"exclude\":\"shell\",\"children\":[[\"$\",\"$L14e\",\".$0\",{\"wrap\":false,\"language\":\"python\",\"label\":\"Python\",\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$15e\"}}]}],[\"$\",\"$L14e\",\".$1\",{\"wrap\":false,\"language\":\"typescript\",\"label\":\"TypeScript\",\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"$15f\"}}]}],\"$L160\",\"$L161\",\"$L162\",\"$L163\",\"$L164\"]}]\nd8:[\"$\",\"p\",\"93\",{\"children\":[\"The loop continues until either Claude responds without requesting any tools (task completion) or the maximum iteration limit is reached. This safeguard prevents potential infinite loops that could result in unexpected API costs.\"]}]\nd9:[\"$\",\"h3\",\"95\",{\"id\":\"optimize-model-performance-with-prompting\",\"className\":\"group\",\"children\":[[\"Optimize model performance with prompting\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Laf\",null,{\"id\":\"optimize-model-performance-with-prompting\",\"name\":\"Optimize model performance with prompting\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nda:[\"$\",\"ol\",\"97\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[\"Specify simple, well-defined tasks and provide explicit instructions for each step.\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[\"Claude sometimes acts as if its actions succeeded without explicitly checking their results. To prevent this, you can prompt Claude with \",[\"$\",\"code\",\"1\",{\"children\":[\"After each step, take a screenshot and carefully evaluate if you have achieved the right outcome. State in one sentence what the screenshot shows and whether the step succeeded. If it didn't, try again. Only when you confirm a step was executed correctly should you move on to the next one.\"]}]]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[\"Some UI elements (such as dropdowns and scrollbars) might be tricky for Claude to manipulate using mouse movements. If you experience this, try prompting the model to use keyboard shortcuts.\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[\"For repeatable tasks or UI interactions, include example screenshots and tool calls of successful outcomes in your prompt.\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[\"If you need the model to log in, provide it with the username and password in your prompt inside XML tags such as \",[\"$\",\"code\",\"1\",{\"children\":[\"\u003crobot_credentials\u003e\"]}],\". Using computer use within applications that require login increases the risk of bad outcomes as a result of prompt injection. Review \",[\"$\",\"$Lae\",\"3\",{\"href\":\"/docs/en/test-and-evaluate/strengthen-guardrails/mitigate-jailbreaks\",\"untracked\":false,\"children\":[\"Mitigate jailbreaks and prompt injections\"]}],\" before providing the model with login credentials.\"]}],\"\\n\",[\"$\",\"li\",\"11\",{\"children\":[\"When constructing a user turn’s \",[\"$\",\"code\",\"1\",{\"children\":[\"content\"]}],\" array, place the instruction text \",[\"$\",\"em\",\"3\",{\"children\":[\"before\"]}],\" the screenshot image. Providing the target description before the image is processed improves click accuracy.\"]}],\"\\n\",[\"$\",\"li\",\"13\",{\"children\":[\"Claude uses the \",[\"$\",\"code\",\"1\",{\"children\":[\"zoom\"]}],\" action to inspect a region at full resolution when asked about small text or specific UI elements that aren’t legible at the screenshot’s default resolution, such as file names in a sidebar, tab titles, status-bar text, line numbers, or button labels. If Claude isn’t zooming when you expect, ask about a specific region or element rather than the screen as a whole.\"]}],\"\\n\",[\"$\",\"li\",\"15\",{\"children\":[\"If you want every \",[\"$\",\"$Lae\",\"1\",{\"href\":\"#batch-actions\",\"untracked\":false,\"children\":[\"batch action\"]}],\" to end with a screenshot, say so in the system prompt, for example, \",[\"$\",\"code\",\"3\",{\"children\":[\"End each group of actions with a screenshot so you can verify the result before continuing.\"]}]]}],\"\\n\"]}]\ndb:[\"$\",\"$Lad\",\"99\",{\"variant\":\"muted\",\"id\":\"$undefined\",\"icon\":[\"$\",\"$L9b\",null,{\"name\":\"Lightbulb\",\"size\":\"auto\"}],\"className\":\"prose-block print:break-inside-avoid print:[:is(h2,h3,h4)+\u0026]:break-after-avoid\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"If you repeatedly encounter a clear set of issues or know in advance the tasks\\nClaude will need to complete, use the system prompt to provide Claude with\\nexplicit tips or instructions on how to do the tasks successfully.\"]}]]}]\ndc:[\"$\",\"$Lad\",\"101\",{\"variant\":\"muted\",\"id\":\"$undefined\",\"icon\":[\"$\",\"$L9b\",null,{\"name\":\"Lightbulb\",\"size\":\"auto\"}],\"className\":\"prose-block print:break-inside-avoid print:[:is(h2,h3,h4)+\u0026]:break-after-avoid\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"For agents that span multiple sessions, run end-to-end verification at the\\nstart of each session, not only after implementation. Browser-based checks\\ncatch regressions from prior sessions that code-level review alone misses. See\\n\",[\"$\",\"$Lae\",\"1\",{\"href\":\"https://www.anthropic.com/engineering/effective-harnesses-for-long-running-agents\",\"untracked\":false,\"children\":[\"Effective harnesses for long-running agents\"]}],\"\\nfor details.\"]}]]}]\ndd:[\"$\",\"h3\",\"103\",{\"id\":\"system-prompts\",\"className\":\"group\",\"children\":[[\"System prompts\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Laf\",null,{\"id\":\"system-prompts\",\"name\":\"System prompts\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\nde:[\"$\",\"p\",\"105\",{\"children\":[\"When you include the computer use tool in a request, the API generates a computer use-specific system prompt. It’s similar to the \",[\"$\",\"$Lae\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/define-tools#tool-use-system-prompt\",\"untracked\":false,\"children\":[\"tool use system prompt\"]}],\" but starts with:\"]}]\ndf:[\"$\",\"blockquote\",\"107\",{\"children\":[\"\\n\",[\"$\",\"p\",\"1\",{\"children\":[\"You have access to a set of functions you can use to answer the user’s question. This includes access to a sandboxed computing environment. You do NOT currently have the ability to inspect files or interact with external resources, except by invoking the below functions.\"]}],\"\\n\"]}]\ne0:[\"$\",\"p\",\"109\",{\"children\":[\"As with regular tool use, the user-provided \",[\"$\",\"code\",\"1\",{\"children\":[\"system\"]}],\" parameter is still respected and used in the construction of the combined system prompt.\"]}]\ne1:[\"$\",\"h3\",\"111\",{\"id\":\"available-actions\",\"className\":\"group\",\"children\":[[\"Available actions\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Laf\",null,{\"id\":\"available-actions\",\"name\":\"Available actions\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}]\ne2:[\"$\",\"p\",\"113\",{\"children\":[\"Each action is a member tool of the computer use toolset: Claude names the member in a \",[\"$\",\"code\",\"1\",{\"children\":[\"tool_use\"]}],\" block that carries \",[\"$\",\"code\",\"3\",{\"children\":[\"\\\"toolset_name\\\": \\\"computer\\\"\"]}],\", and the block’s \",[\"$\",\"code\",\"5\",{\"children\":[\"input\"]}],\" holds only that member’s parameters, with no \",[\"$\",\"code\",\"7\",{\"children\":[\"action\"]}],\" field. The toolset has 17 member tools:\"]}]\ne3:[\"$\",\"div\",\"115\",{\"className\":\"prose-scroll relative print:overflow-visible\",\"children\":[\"$\",\"table\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"thead\",\"0\",{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"th\",\"0\",{\"children\":[\"Member\"]}],[\"$\",\"th\",\"1\",{\"children\":[\"Input\"]}],[\"$\",\"th\",\"2\",{\"children\":[\"Description\"]}]]}]]}],[\"$\",\"tbody\",\"1\",{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"docs-nowrap\",\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"screenshot\"]}]]}],[\"$\",\"td\",\"1\",{\"className\":\"docs-nowrap\",\"children\":[\"None (\",[\"$\",\"code\",\"1\",{\"children\":[\"{}\"]}],\")\"]}],[\"$\",\"td\",\"2\",{\"className\":\"\",\"children\":[\"Capture the full display and return it as an image.\"]}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"docs-nowrap\",\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"zoom\"]}]]}],[\"$\",\"td\",\"1\",{\"className\":\"\",\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"region\"]}],\": \",[\"$\",\"code\",\"2\",{\"children\":[\"[x0, y0, x1, y1]\"]}],\", the top-left and bottom-right corners of the area to inspect\"]}],[\"$\",\"td\",\"2\",{\"className\":\"\",\"children\":[\"Capture only that region of the display at full resolution and return it as an image, scaled to fit within your usual screenshot dimensions with its aspect ratio preserved. This lets Claude read small text or dense UI that isn’t legible in a downscaled full screenshot.\"]}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"docs-nowrap\",\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"left_click\"]}]]}],[\"$\",\"td\",\"1\",{\"className\":\"\",\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"coordinate\"]}],\" (optional): \",[\"$\",\"code\",\"2\",{\"children\":[\"[x, y]\"]}],\"; \",[\"$\",\"code\",\"4\",{\"children\":[\"text\"]}],\" (optional): modifier keys to hold during the click: \",[\"$\",\"code\",\"6\",{\"children\":[\"shift\"]}],\", \",[\"$\",\"code\",\"8\",{\"children\":[\"ctrl\"]}],\", \",[\"$\",\"code\",\"10\",{\"children\":[\"alt\"]}],\", \",[\"$\",\"code\",\"12\",{\"children\":[\"super\"]}],\" (the Command or Windows key), or a \",[\"$\",\"code\",\"14\",{\"children\":[\"+\"]}],\"-joined combination such as \",[\"$\",\"code\",\"16\",{\"children\":[\"ctrl+shift\"]}]]}],[\"$\",\"td\",\"2\",{\"className\":\"\",\"children\":[\"Click the left mouse button at \",[\"$\",\"code\",\"1\",{\"children\":[\"coordinate\"]}],\", or at the current cursor position when \",[\"$\",\"code\",\"3\",{\"children\":[\"coordinate\"]}],\" is omitted.\"]}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"\",\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"right_click\"]}],\", \",[\"$\",\"code\",\"2\",{\"children\":[\"middle_click\"]}],\", \",[\"$\",\"code\",\"4\",{\"children\":[\"double_click\"]}],\", \",[\"$\",\"code\",\"6\",{\"children\":[\"triple_click\"]}]]}],[\"$\",\"td\",\"1\",{\"className\":\"docs-nowrap\",\"children\":[\"Same as \",[\"$\",\"code\",\"1\",{\"children\":[\"left_click\"]}]]}],[\"$\",\"td\",\"2\",{\"className\":\"\",\"children\":[\"Other mouse buttons and multiple clicks.\"]}]]}],[\"$\",\"tr\",\"4\",{\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"docs-nowrap\",\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"left_click_drag\"]}]]}],[\"$\",\"td\",\"1\",{\"className\":\"\",\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"start_coordinate\"]}],\": \",[\"$\",\"code\",\"2\",{\"children\":[\"[x, y]\"]}],\"; \",[\"$\",\"code\",\"4\",{\"children\":[\"coordinate\"]}],\": \",[\"$\",\"code\",\"6\",{\"children\":[\"[x, y]\"]}],\"; \",[\"$\",\"code\",\"8\",{\"children\":[\"text\"]}],\" (optional): modifier keys\"]}],[\"$\",\"td\",\"2\",{\"className\":\"\",\"children\":[\"Press at \",[\"$\",\"code\",\"1\",{\"children\":[\"start_coordinate\"]}],\", drag to \",[\"$\",\"code\",\"3\",{\"children\":[\"coordinate\"]}],\", and release.\"]}]]}],[\"$\",\"tr\",\"5\",{\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"docs-nowrap\",\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"mouse_move\"]}]]}],[\"$\",\"td\",\"1\",{\"className\":\"docs-nowrap\",\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"coordinate\"]}],\": \",[\"$\",\"code\",\"2\",{\"children\":[\"[x, y]\"]}]]}],[\"$\",\"td\",\"2\",{\"className\":\"\",\"children\":[\"Move the cursor without clicking, for example, to hover.\"]}]]}],[\"$\",\"tr\",\"6\",{\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"\",\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"left_mouse_down\"]}],\", \",[\"$\",\"code\",\"2\",{\"children\":[\"left_mouse_up\"]}]]}],[\"$\",\"td\",\"1\",{\"className\":\"docs-nowrap\",\"children\":[\"None (\",[\"$\",\"code\",\"1\",{\"children\":[\"{}\"]}],\")\"]}],[\"$\",\"td\",\"2\",{\"className\":\"\",\"children\":[\"Press or release the left mouse button at the current cursor position, for drags that \",[\"$\",\"code\",\"1\",{\"children\":[\"left_click_drag\"]}],\" can’t express. Move the cursor with \",[\"$\",\"code\",\"3\",{\"children\":[\"mouse_move\"]}],\" first.\"]}]]}],[\"$\",\"tr\",\"7\",{\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"docs-nowrap\",\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"cursor_position\"]}]]}],[\"$\",\"td\",\"1\",{\"className\":\"docs-nowrap\",\"children\":[\"None (\",[\"$\",\"code\",\"1\",{\"children\":[\"{}\"]}],\")\"]}],[\"$\",\"td\",\"2\",{\"className\":\"\",\"children\":[\"Report the cursor’s current \",\"$L165\",\" position as text.\"]}]]}],\"$L166\",\"$L167\",\"$L168\",\"$L169\",\"$L16a\"]}]]}]}]\ne4:[\"$\",\"p\",\"117\",{\"children\":[\"Keep the following in mind when implementing the members:\"]}]\ne5:[\"$\",\"ul\",\"119\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Coordinates are in screenshot pixels.\"]}],\" Every \",[\"$\",\"code\",\"2\",{\"children\":[\"coordinate\"]}],\", \",[\"$\",\"code\",\"4\",{\"children\":[\"start_coordinate\"]}],\", and \",[\"$\",\"code\",\"6\",{\"children\":[\"region\"]}],\" value, and the position that \",[\"$\",\"code\",\"8\",{\"children\":[\"cursor_position\"]}],\" reports, is in the pixel space of the full-display screenshots you return, with the origin at the top left. Zoom images don’t change this: after a \",[\"$\",\"code\",\"10\",{\"children\":[\"zoom\"]}],\", Claude still expresses coordinates in the full screenshot’s space, never relative to the zoomed image. If you scale screenshots down before returning them, scale Claude’s coordinates back up before applying them to the real display (see \",[\"$\",\"$Lae\",\"12\",{\"href\":\"#handle-coordinate-scaling-for-higher-resolutions\",\"untracked\":false,\"children\":[\"Size screenshots to fit image limits\"]}],\").\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"All members are enabled by default, including \",[\"$\",\"code\",\"1\",{\"children\":[\"zoom\"]}],\".\"]}],\" If your environment can’t produce zoom images, withhold the member with \",[\"$\",\"code\",\"2\",{\"children\":[\"configs\"]}],\" (see \",[\"$\",\"$Lae\",\"4\",{\"href\":\"#tool-parameters\",\"untracked\":false,\"children\":[\"Tool parameters\"]}],\") rather than leaving it enabled and returning errors. If Claude calls a member that you have withheld or don’t implement, return a \",[\"$\",\"code\",\"6\",{\"children\":[\"tool_result\"]}],\" with \",[\"$\",\"code\",\"8\",{\"children\":[\"is_error: true\"]}],\" for that block.\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":[\"Dispatch on the pair (\",[\"$\",\"code\",\"1\",{\"children\":[\"toolset_name\"]}],\", \",[\"$\",\"code\",\"3\",{\"children\":[\"name\"]}],\").\"]}],\" \",[\"$\",\"code\",\"2\",{\"children\":[\"toolset_name\"]}],\" is what marks a block as a computer action: a custom tool in the same request can share a member’s name, and a later toolset version can add members (see \",[\"$\",\"$Lae\",\"4\",{\"href\":\"/docs/en/agents-and-tools/tool-use/tool-reference#client-toolsets\",\"untracked\":false,\"children\":[\"Client toolsets\"]}],\").\"]}],\"\\n\"]}]\ne6:[\"$\",\"$L16b\",\"121\",{\"title\":\"Example actions\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"Each example is a complete \",[\"$\",\"code\",\"1\",{\"children\":[\"tool_use\"]}],\" block as it appears in Claude’s response.\"]}],[\"$\",\"p\",\"1\",{\"children\":[\"Shift+click at a position, for example, to extend a selection. Unlike \",[\"$\",\"code\",\"1\",{\"children\":[\"hold_key\"]}],\", \",[\"$\",\"code\",\"3\",{\"children\":[\"text\"]}],\" holds the modifiers only for the duration of that click or scroll:\"]}],[\"$\",\"$L158\",\"2\",{\"language\":\"json\",\"label\":\"$undefined\",\"className\":\"$undefined\",\"openInPlayground\":\"$undefined\",\"children\":[\"$\",\"$L14e\",null,{\"wrap\":false,\"children\":[\"$\",\"div\",null,{\"className\":\"inline-block min-w-full pr-4 print:block\",\"data-code-source\":\"\",\"translate\":\"no\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cpre class=\\\"shiki\\\"\u003e\u003ccode\u003e\u003cspan class=\\\"line\\\"\u003e{\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"type\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"tool_use\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"id\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"toolu_01Qg8m3XqC5aRy7tD2eS4jUg\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"name\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"left_click\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"toolset_name\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"computer\\\"\u003c/span\u003e,\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan class=\\\"l5 dc\\\"\u003e  \\\"input\\\"\u003c/span\u003e: { \u003cspan class=\\\"l5 dc\\\"\u003e\\\"coordinate\\\"\u003c/span\u003e: [\u003cspan class=\\\"l1 di\\\"\u003e500\u003c/span\u003e, \u003cspan class=\\\"l1 di\\\"\u003e300\u003c/span\u003e], \u003cspan class=\\\"l5 dc\\\"\u003e\\\"text\\\"\u003c/span\u003e: \u003cspan class=\\\"l3 dn\\\"\u003e\\\"shift\\\"\u003c/span\u003e }\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u00