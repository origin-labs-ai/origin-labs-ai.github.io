trol px-md cds-reset whitespace-nowrap select-none outline-none focus-visible:outline-hidden bg-transparent text-body font-medium font-control text-muted before:absolute before:inset-y-0 before:inset-x-px before:rounded before:-z-[1] before:transition-shadow before:duration-fast [&amp;:not([data-active]):not([data-disabled])]:hover:text-secondary [&amp;:not([data-active]):not([data-disabled])]:hover:before:bg-fill-ghost-hover data-[active]:text-primary data-[active]:before:bg-fill-ghost-hover focus-visible:before:shadow-focus data-[disabled]:opacity-disabled data-[disabled]:pointer-events-none stacks:[&amp;[data-active]:not([data-disabled])]:hover:before:layers-1-fill-ghost-hover">PHP</button><button type="button" data-orientation="horizontal" data-activation-direction="none" aria-disabled="false" tabindex="-1" role="tab" aria-selected="false" id="base-ui-_R_ulba997cqalubtabsknr5td9leailb_" class="relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 rounded-none h-control px-md cds-reset whitespace-nowrap select-none outline-none focus-visible:outline-hidden bg-transparent text-body font-medium font-control text-muted before:absolute before:inset-y-0 before:inset-x-px before:rounded before:-z-[1] before:transition-shadow before:duration-fast [&amp;:not([data-active]):not([data-disabled])]:hover:text-secondary [&amp;:not([data-active]):not([data-disabled])]:hover:before:bg-fill-ghost-hover data-[active]:text-primary data-[active]:before:bg-fill-ghost-hover focus-visible:before:shadow-focus data-[disabled]:opacity-disabled data-[disabled]:pointer-events-none stacks:[&amp;[data-active]:not([data-disabled])]:hover:before:layers-1-fill-ghost-hover">Ruby</button></div></div></div></div><span class="hidden text-body font-medium text-primary print:block">Python</span></div><div class="flex shrink-0 items-center gap-1 print:hidden"><span class="contents group-[:not(:has([data-code-source]))]/codegroup:hidden"><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" data-size="sm" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-fizzy-lake-color-icon-only-disabled)] text-muted" aria-label="Copy code" id="_R_7ja997cqalubtabsknr5td9leailb_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] stacks:transition-[box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1.25rem * var(--cds-rem-scale, 1));font-weight:433.3" aria-hidden="true"></span></span></button><span role="status" class="sr-only"></span></span></div></div><div data-orientation="horizontal" data-activation-direction="none" id="base-ui-_R_7a997cqalubtabsknr5td9leailb_" role="tabpanel" tabindex="-1" data-index="-1" class="cds-reset outline-none focus-visible:outline-hidden data-[ending-style]:hidden"><div data-not-prose="true" tabindex="0" class="relative h-full py-4 pl-4 text-code overflow-x-auto focus-visible:-outline-offset-2 print:overflow-visible"><div class="inline-block min-w-full pr-4 print:block" data-code-source="" translate="no"><pre class="shiki"><code><span class="line"><span class="lg d7"># Placeholder image data; a real executor captures the screen and returns the PNG bytes</span></span>
<span class="line"><span class="l1">PLACEHOLDER_PNG</span><span class="lk"> =</span><span class="l3 dn"> "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg=="</span></span>
<span class="line"></span>
<span class="line"></span>
<span class="line"><span class="lk d4">def</span><span class="li dt"> capture_screenshot</span>() -&gt; list[ImageBlockParam]:</span>
<span class="line"><span class="lg d7">    # screenshot answers with an image block rather than text: return the result content list</span></span>
<span class="line"><span class="lk dl">    return</span> [</span>
<span class="line">        {</span>
<span class="line"><span class="l3 dn">            "type"</span>: <span class="l3 dn">"image"</span>,</span>
<span class="line"><span class="l3 dn">            "source"</span>: {</span>
<span class="line"><span class="l3 dn">                "type"</span>: <span class="l3 dn">"base64"</span>,</span>
<span class="line"><span class="l3 dn">                "media_type"</span>: <span class="l3 dn">"image/png"</span>,</span>
<span class="line"><span class="l3 dn">                "data"</span>: <span class="l1">PLACEHOLDER_PNG</span>,</span>
<span class="line">            },</span>
<span class="line">        }</span>
<span class="line">    ]</span>
<span class="line"></span>
<span class="line"></span>
<span class="line"><span class="lk d4">def</span><span class="li dt"> click</span>(<span class="dc">coordinate</span><span class="lk">=</span><span class="l1 d4">None</span>):</span>
<span class="line"><span class="lk dl">    if</span> coordinate <span class="lk d4">is</span><span class="l1 d4"> None</span>:</span>
<span class="line"><span class="lk dl">        return</span><span class="l3 dn"> "clicked at current cursor"</span></span>
<span class="line">    x, y <span class="lk">=</span> coordinate</span>
<span class="line"><span class="lk dl">    return</span><span class="lk d4"> f</span><span class="l3 dn">"clicked at (</span><span class="lk d4">{</span>x<span class="lk d4">}</span><span class="l3 dn">, </span><span class="lk d4">{</span>y<span class="lk d4">}</span><span class="l3 dn">)"</span></span>
<span class="line"></span>
<span class="line"></span>
<span class="line"><span class="lk d4">def</span><span class="li dt"> type_text</span>(<span class="dc">text</span>):</span>
<span class="line"><span class="lk dl">    return</span><span class="lk d4"> f</span><span class="l3 dn">"typed: </span><span class="lk d4">{</span>text<span class="lk d4">}</span><span class="l3 dn">"</span></span>
<span class="line"></span>
<span class="line"></span>
<span class="line"><span class="lk d4">def</span><span class="li dt"> handle_computer_action</span>(<span class="dc">name</span>, <span class="dc">tool_input</span>):</span>
<span class="line"><span class="lk dl">    match</span> name:</span>
<span class="line"><span class="lk dl">        case</span><span class="l3 dn"> "screenshot"</span>:</span>
<span class="line"><span class="lk dl">            return</span> capture_screenshot()</span>
<span class="line"><span class="lk dl">        case</span><span class="l3 dn"> "left_click"</span>:</span>
<span class="line"><span class="lg d7">            # coordinate is optional; without it, click where the cursor already is</span></span>
<span class="line"><span class="lk dl">            return</span> click(tool_input.get(<span class="l3 dn">"coordinate"</span>))</span>
<span class="line"><span class="lk dl">        case</span><span class="l3 dn"> "type"</span>:</span>
<span class="line"><span class="lk dl">            return</span> type_text(tool_input[<span class="l3 dn">"text"</span>])</span>
<span class="line"><span class="lg d7">    # Handle other actions as needed</span></span>
<span class="line"><span class="lk dl">    raise</span><span class="l1 d2"> ValueError</span>(<span class="lk d4">f</span><span class="l3 dn">"Unknown or unimplemented member: </span><span class="lk d4">{</span>name<span class="lk d4">}</span><span class="l3 dn">"</span>)</span></code></pre></div></div></div></div></div></div></li><li class="m-0 flex gap-md p-0"><div class="flex flex-col items-center" aria-hidden="true"><span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-fill-control font-sans text-body font-medium text-primary print:break-inside-avoid">3</span><span class="w-px flex-1 bg-border print:hidden"></span></div><div class="min-w-0 flex-1 pb-xl"><h3 class="mt-0 flex min-h-7 items-center">Process Claude’s tool calls</h3><p>Extract and run tool calls from Claude’s responses:</p><div class="overflow-hidden rounded-card border bg-surface-2 print:[p+&amp;]:break-before-avoid group/codegroup prose-block"><div data-orientation="horizontal" data-activation-direction="none" data-cds="Tabs"><div class="flex items-center justify-between gap-2 border-b px-4 py-1 print:break-after-avoid print:py-sm not-prose"><div class="flex min-w-0 items-center gap-2 text-caption text-muted"><div class="-my-1 min-w-0 overflow-x-auto py-1 u-hidden-scrollbar scroll-fade-x print:hidden"><div data-size="sm" class="contents"><div data-cds-part="scroll-pager-scroller" class="contents"><div data-orientation="horizontal" data-activation-direction="none" role="tablist" aria-label="Code block tabs" data-print-language="Python" data-size="sm" class="flex items-center font-sans data-[orientation=horizontal]:[&amp;&gt;[role=tab]:first-child]:before:start-0 data-[orientation=horizontal]:[&amp;&gt;:first-child&gt;[data-orientation][role=tab]:first-child]:before:start-0 data-[orientation=horizontal]:[&amp;&gt;:first-child&gt;:first-child&gt;[data-orientation][role=tab]:first-child]:before:start-0 data-[orientation=horizontal]:[&amp;&gt;[role=tab]:last-child]:before:end-0 da