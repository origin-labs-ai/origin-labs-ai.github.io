before:-z-[1] before:transition-shadow before:duration-fast [&amp;:not([data-active]):not([data-disabled])]:hover:text-secondary [&amp;:not([data-active]):not([data-disabled])]:hover:before:bg-fill-ghost-hover data-[active]:text-primary data-[active]:before:bg-fill-ghost-hover focus-visible:before:shadow-focus data-[disabled]:opacity-disabled data-[disabled]:pointer-events-none stacks:[&amp;[data-active]:not([data-disabled])]:hover:before:layers-1-fill-ghost-hover">Ruby</button></div></div></div></div><span class="hidden text-body font-medium text-primary print:block">Python</span></div><div class="flex shrink-0 items-center gap-1 print:hidden"><span class="contents group-[:not(:has([data-code-source]))]/codegroup:hidden"><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" data-size="sm" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-fizzy-lake-color-icon-only-disabled)] text-muted" aria-label="Copy code" id="_R_f5efcqalubtabsknr5td9leailb_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] stacks:transition-[box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1.25rem * var(--cds-rem-scale, 1));font-weight:433.3" aria-hidden="true"></span></span></button><span role="status" class="sr-only"></span></span></div></div><div data-orientation="horizontal" data-activation-direction="none" id="base-ui-_R_defcqalubtabsknr5td9leailb_" role="tabpanel" tabindex="-1" data-index="-1" class="cds-reset outline-none focus-visible:outline-hidden data-[ending-style]:hidden"><div data-not-prose="true" tabindex="0" class="relative h-full py-4 pl-4 text-code overflow-x-auto focus-visible:-outline-offset-2 print:overflow-visible"><div class="inline-block min-w-full pr-4 print:block" data-code-source="" translate="no"><pre class="shiki"><code><span class="line"><span class="lk dl">import</span> math</span>
<span class="line"></span>
<span class="line">screen_width, screen_height <span class="lk">=</span><span class="l1 di"> 1512</span>, <span class="l1 di">982</span></span>
<span class="line"></span>
<span class="line"></span>
<span class="line"><span class="lk d4">def</span><span class="li dt"> get_scale_factor</span>(<span class="dc">width</span>, <span class="dc">height</span>):</span>
<span class="line"><span class="l3 dn">    """Calculate scale factor to meet API constraints."""</span></span>
<span class="line">    long_edge <span class="lk">=</span><span class="l1 dt"> max</span>(width, height)</span>
<span class="line">    total_pixels <span class="lk">=</span> width <span class="lk">*</span> height</span>
<span class="line"></span>
<span class="line">    long_edge_scale <span class="lk">=</span><span class="l1 di"> 1568</span><span class="lk"> /</span> long_edge</span>
<span class="line">    total_pixels_scale <span class="lk">=</span> math.sqrt(<span class="l1 di">1_150_000</span><span class="lk"> /</span> total_pixels)</span>
<span class="line"></span>
<span class="line"><span class="lk dl">    return</span><span class="l1 dt"> min</span>(<span class="l1 di">1.0</span>, long_edge_scale, total_pixels_scale)</span>
<span class="line"></span>
<span class="line"></span>
<span class="line"><span class="lg d7"># When capturing screenshot</span></span>
<span class="line">scale <span class="lk">=</span> get_scale_factor(screen_width, screen_height)</span>
<span class="line">scaled_width <span class="lk">=</span><span class="l1 d2"> int</span>(screen_width <span class="lk">*</span> scale)</span>
<span class="line">scaled_height <span class="lk">=</span><span class="l1 d2"> int</span>(screen_height <span class="lk">*</span> scale)</span>
<span class="line"></span>
<span class="line"><span class="lg d7"># Resize image to scaled dimensions before sending to Claude</span></span>
<span class="line">screenshot <span class="lk">=</span> capture_and_resize(scaled_width, scaled_height)</span>
<span class="line"></span>
<span class="line"></span>
<span class="line"><span class="lg d7"># When handling Claude's coordinates, scale them back up</span></span>
<span class="line"><span class="lk d4">def</span><span class="li dt"> execute_click</span>(<span class="dc">x</span>, <span class="dc">y</span>):</span>
<span class="line">    screen_x <span class="lk">=</span> x <span class="lk">/</span> scale</span>
<span class="line">    screen_y <span class="lk">=</span> y <span class="lk">/</span> scale</span>
<span class="line">    perform_click(screen_x, screen_y)</span></code></pre></div></div></div></div></div>
<aside data-cds="Aside" data-prose-box="" data-icon-layout="first-line" role="note" class="flex items-start gap-xs rounded-card px-lg py-md font-sans text-body font-normal break-words bg-surface-1 layers-1-[color:var(--cds-banner-neutral-tint)] text-primary shadow-[inset_0_0_0_var(--cds-ring-inner)_var(--cds-banner-neutral-ring,var(--cds-ring-color)),0_0_0_var(--cds-ring-outer)_var(--cds-banner-neutral-ring,var(--cds-ring-color))] [--cds-prose-code-color:initial] [--cds-prose-marker-color:var(--cds-text-secondary)] [--cds-text-link-color:initial] prose-block print:break-inside-avoid print:[:is(h2,h3,h4)+&amp;]:break-after-avoid"><span class="flex min-h-[1lh] shrink-0 items-center"><span data-cds="Icon" style="font-size:calc(1.25rem * var(--cds-rem-scale, 1));font-weight:433.3" aria-hidden="true"></span></span><div class="min-w-0 flex-1"><p><strong>macOS Retina displays</strong> capture screenshots at a device pixel ratio of 2, so the image is twice the resolution of the logical screen coordinates. Either downscale the screenshot by 2x before sending, or halve the coordinates Claude returns before issuing the click.</p></div></aside>
<p>When you choose a display resolution and return screenshots:</p>
<ul>
<li>For general desktop tasks, use 1024x768 or 1280x720; for web applications, use 1280x800 or 1366x768.</li>
<li>Avoid resolutions above 1920x1080 to prevent performance issues.</li>
<li>Encode screenshots as base64 PNG or JPEG, and consider compressing large screenshots to improve performance.</li>
<li>Include relevant metadata such as timestamp or display state.</li>
<li>If you use higher resolutions, ensure coordinates are accurately scaled.</li>
</ul>
<h3 id="manage-screenshot-history" class="group">Manage screenshot history<span class="relative hidden h-[1em] w-0 align-middle lg:inline-block"><span role="status" aria-live="polite" class="sr-only"></span><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" data-size="xs" class="cds-reset group/btn isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-fizzy-lake-color-icon-only-disabled)] absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100" aria-label="Copy link to Manage screenshot history" id="_R_19gfcqalubtabsknr5td9leailb_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] stacks:transition-[box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1rem * var(--cds-rem-scale, 1));font-weight:533.3" aria-hidden="true"></span></span></button></span></h3>
<p>Long agent loops accumulate screenshots quickly (roughly 1,000–1,800 input tokens each). The API’s <a href="/docs/en/build-with-claude/vision#request-limits">request limits</a> also apply. Once a single request carries more than 20 images, every image in it is held to a stricter per-side limit. A loop that keeps its screenshot history reaches that count within a few dozen turns, so either resize each screenshot to stay under that limit or prune older screenshots to keep 20 or fewer in the request.</p>
<p>To keep <a href="/docs/en/build-with-claude/prompt-caching">Prompt caching</a> effective while bounding context:</p>
<ul>
<li>Place one <code>cache_control</code> breakpoint after the system prompt and tool definitions, and up to three more on the last <code>tool_result</code> block of each of the most recent turns, advancing them each turn. Within a <a href="#batch-actions">batch action</a>, markers on several blocks act as a single breakpoint, but each still counts toward the limit of four, so use at most one in any turn.</li>
<li>Prune old screenshots in <em>batches</em>, not one each turn. Dropping a screenshot every turn changes the prefix every turn and invalidates the cache. A reasonable default is to keep the last three screenshots and prune every 25 turns, so the prefix stays byte-identical between prune events; if your screenshots exceed the stricter limit, choose an interval that keeps each request at 20 or fewer images.</li>
<li>On Claude 5.1 and later models, avoid pruning on the client: removing an earlier screenshot from a request <a href="/docs/en/build-with-claude/thinking#preserved-in-conversation">invalidates every later thinking block</a> in that request and in every later request. Resize screenshots to stay under the stricter limit instead and use server-side <a href="/docs/en/build-with-claude/context-editing#tool-result-clearing">tool result clearing</a> to drop old ones from the context. If you must prune, keep <a href="/docs/en/build-with-claude/thinking#preserved-thinking-controls"><code>prefix_mismatch_behavior: &quot;drop_block&quot;</code></a> set from then on; after each prune, Claude continues without the thinking produced since the pruned screenshot, on that request and every later one. On Claude Sonnet 5.5 and Claude Haiku 5.5, <code>block_binding</code> works only with <code>thinking: {&quot;type&quot;: &quot;adaptive&quot;}</code>. With any other thinking setting on those models, keep the history append-only or strip every <code>thinking</code> and <code>redacted_thinking</code> block after the pruned screenshot.</li>
</ul>
<h3 id="diagnose-click-issues" class="group">Diagnose click issues<span class="relative hidden h-[1em] w-0 align-middle lg:inline-block"><span role="status" aria-live="polite" class="sr-only"></span><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" data-size="xs" class="cds-reset group/btn isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-fizzy-lake-color-icon-only-disabled)] absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100" aria-label="Copy link to Diagnose click issues" id="_R_19ifcqalubtabsknr5td9leailb_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish stacks:transform-none!"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] stacks:transition-[box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent  stacks:group-hover/btn:bg-fill-button-ghost-hover stacks:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-button-ghost-hover stacks:group-hover/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:layers-1-fill-button-layer stacks:group-[:disabled:not([aria-busy])]/btn:bg-transparent stacks:group-[:disabled:not([aria-busy])]/btn:group-[[aria-haspopup][aria-expanded=true]]/btn:bg-transparent stacks:group-hover/btn:group-aria-pressed/btn:layers-1-accent-layer stacks:group-active/btn:bg-fill-button-ghost-hover stacks:group-has-[:active]/btn:bg-fill-button-ghost-hover stacks:group-active/btn:layers-1-fill-button-layer stacks:group-has-[:active]/btn:layers-1-fill-button-layer "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" style="font-size:calc(1rem * var(--cds-rem-scale, 1));font-weight:533.3" aria-hidden="true"></span></span></button></span></h3>
<p>If clicks miss their targets, the cause is usually one of the following:</p>
<div class="prose-scroll relative print:overflow-visible"><table><thead><tr><th>Symptom</th><th>Likely cause</th><th>Try</th></tr></thead><tbody><tr><td class="">Clicks consistently offset in one direction</td><td class="">Claude’s coordinates, which are in the pixel space of the screenshots you return, are being applied to a display of a different size without scaling</td><td class="">Scale each coordinate by the ratio of your screen size to your screenshot size before clicking (see <a href="#handle-coordinate-scaling-for-higher-resolutions">Size screenshots to fit image limits</a>); on macOS Retina displays, account for the 2x device pixel ratio</td></tr><tr><td class="">Clicks land in the right area but miss the target</td><td class="">Target is very small, detail was lost downscaling a 4K+ source, or aspect ratio was distorted</td><td class="">Keep the <code>zoom</code> member enabled and implement it so Claude can inspect the region at full resolution; capture at lower DPI or crop to the relevant region; preserve aspect ratio when resizing</td></tr><tr><td class="">Claude clicks the wrong element entirely</td><td class="">Ambiguous instruction, or visually similar elements nearby</td><td class="">Use positional prompts (“the blue Submit button in the bottom-right”); break the interaction into smaller steps</td></tr><tr><td class="">Accuracy is consistently poor</td><td class="docs-nowrap">Resolution too low</td><td class="">Try 1280x720 as a baseline</td></tr></tbody></table></div>
<aside data-cds="Aside" data-prose-box="" data-icon-layout="first-line" role="note" class="flex items-start gap-xs rounded-card px-lg py-md font-sans text-body font-normal break-words bg-surface-1 layers-1-[color:var(--cds-banner-neutral-tint)] text-primary shadow-[inset_0_0_0_var(--cds-ring-inner)_var(--cds-banner-neutral-ring,var(--cds-ring-color)),0_0_0_var(--cds-ring-outer)_var(--cds-banner-neutral-ring,var(--cds-ring-color))] [--cds-prose-code-color:initial] [--cds-prose-marker-color:var(--cds-text-secondary)] [--cds-text-link-color:initial] prose-block print:break-inside-avoid print:[:is(h2,h3,h4)+&amp;]:break-after-avoid"><span class="flex min-h-[1lh] shrink-0 items-center"><span data-cds="Icon" style="font-size:calc(1.25rem * var(--cds-rem-scale, 1));font-weight:433.3" aria-hidden="true"></span></span><div class="min-w-0 flex-1"><p><strong>Model choice affects click precision.</strong> Among the models that use the <code>computer_20251124</code> tool, Claude Sonnet 4.6 is more mechanically precise at clicking than Claude Opus 4.6 and is more robust when screenshots require heavy downscaling. Claude Opus 4.7 narrows that gap: its click precision is roughly comparable to Sonnet 4.6, and its higher resolution limit means less downscaling is needed.</p></div></aside>
