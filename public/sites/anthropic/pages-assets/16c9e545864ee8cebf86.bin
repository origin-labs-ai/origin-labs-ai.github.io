<span class="line"><span class="l5 dc">  "name"</span>: <span class="l3 dn">"computer"</span>,</span>
<span class="line"><span class="l5 dc">  "display_width_px"</span>: <span class="l1 di">1024</span>,</span>
<span class="line"><span class="l5 dc">  "display_height_px"</span>: <span class="l1 di">768</span>,</span>
<span class="line"><span class="l5 dc">  "display_number"</span>: <span class="l1 di">1</span></span>
