-menu-cta-buttons-wrapper"><a href="/nonprofits" class="button is-secondary is-nav-v2 w-variant-ddfe9e92-d432-5a55-160d-3bf3123efd3f w-nav-link">For nonprofits</a><a href="/demo-enterprise-impact-platform" data-wf-event-ids="157058193-157060706-157062551" class="button is-nav w-nav-link">Get a tour</a></div></div></div></nav><div class="navbar_button w-nav-button"><svg data-w-id="12e97f92-06b8-58c8-56dd-204c414e8ce0" xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 18 2" fill="none" class="navbar_button-line"><path d="M0 0V2H18V0H0Z" fill="currentColor"></path></svg><svg data-w-id="12e97f92-06b8-58c8-56dd-204c414e8ce2" xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 18 2" fill="none" class="navbar_button-line"><path d="M0 0V2H18V0H0Z" fill="currentColor"></path></svg><svg data-w-id="12e97f92-06b8-58c8-56dd-204c414e8ce4" xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 18 2" fill="none" class="navbar_button-line"><path d="M0 0V2H18V0H0Z" fill="currentColor"></path></svg></div></div></div></div><main class="main-wrapper"><section class="section_home-hero"><div class="background-color-moonshot"><div class="home_hero-position-wrapper"><div class="padding-global padding-section-home_hero"><div class="container-large"><div class="grid-2x-hp"><div id="w-node-_3c5233fd-956e-ac8c-e57d-29205d1ae233-1a9848fb" class="home_hero-content_wrapper"><div class="eyebrow-wrapper"><div class="eyebrow text-color-aqua">PURPOSE AT WORK</div></div><div class="flex-v-left-top gap-1-75rem"><h1 class="heading-style-h1 hp">Trust at scale.<br/>Undeniably proven. </h1><div class="flex-v-left-top gap--5rem max-width-95"><div class="text-size-large hp">The Benevity® Enterprise Impact Platform is one trusted platform for employee giving, volunteering, grants and reporting.</div><div><div class="hero-stat-card"><a href="https://www.g2.com/products/benevity/reviews" target="_blank" class="grid-2x-g2 w-inline-block"><div><div class="icon-embed-xsmall w-embed"><svg x