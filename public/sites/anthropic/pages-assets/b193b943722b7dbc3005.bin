3l1.253 4.385L12 15.798V5.429z" fill="currentColor"></path></svg></div></div></a></div></div></div></div><div class="button-group"><a href="/demo-enterprise-impact-platform" data-wf-event-ids="157036969-157060706-157062551" class="button w-button">Get a personalized demo</a><a href="/interactive-demo" class="button is-icon-white-transparent w-button">Watch an interactive demo →</a></div></div><div class="image-wrapper-ar-5-4"><img src="https://cdn.prod.website-files.com/680946676a0dac031a9848fc/6a1700e52e3e5a942222ae72_Benevity-WIP.webp" width="1696" height="1357" alt="Smiling man and woman in business attire looking at a tablet in an office setting." sizes="(max-width: 1696px) 100vw, 1696px" loading="eager" fetchpriority="high" srcset="https://cdn.prod.website-files.com/680946676a0dac031a9848fc/6a1700e52e3e5a942222ae72_Benevity-WIP-p-500.webp 500w, https://cdn.prod.website-files.com/680946676a0dac031a9848fc/6a1700e52e3e5a942222ae72_Benevity-WIP-p-800.webp 800w, https://cdn.prod.website-files.com/680946676a0dac031a9848fc/6a1700e52e3e5a942222ae72_Benevity-WIP-p-1080.webp 1080w, https://cdn.prod.website-files.com/680946676a0dac031a9848fc/6a1700e52e3e5a942222ae72_Benevity-WIP-p-1600.webp 1600w, https://cdn.prod.website-files.com/680946676a0dac031a9848fc/6a1700e52e3e5a942222ae72_Benevity-WIP.webp 1696w"/></div></div></div></div></div></div></section><section class="section_home-top-marquee"><div class="padding-global padding-section-small"><div class="container-large"><div class="flex-h-center-center"><h2 class="heading-style-h5">Trusted by nearly 1,000 of the world&#x27;s most admired companies</h2></div></div><div data-wf--logo-marquee--variant="grey-bg" class="home_top-marquee-position-wrapper"><div class="global_top-marquee_layout-wrapper"></div><div class="home_top-marquee-left-grad"></div><div class="home_top-marquee-right-grad"></div><div class="container-custom-home-top-marquee"><div class="home_top-marquee-component"><div class="swiper"><div class="home_top-marquee-flex-wrapper swiper-wrapper"><div class="home_top-marquee-item swiper-slide"><img src="https://cdn.prod.website-files.com/680946676a0dac031a9848fc/680946676a0dac031a984976_Logo-1.svg" loading="eager" width="135" height="80" alt="Levi&#x27;s logo" class="logo-img"/></div><div class="home_top-marquee-item swiper-slide"><img src="https://cdn.prod.website-files.com/680946676a0dac031a9848fc/680946676a0dac031a984956_Logo-2.svg" loading="eager" width="163" height="80" alt="Merck Logo" class="logo-img"/></div><div class="home_top-marquee-item swiper-slide"><img src="https://cdn.prod.website-files.com/680946676a0dac031a9848fc/687929cbfe6d0b91eb73cc1a_Cisco-logo2.avif" loading="eager" width="110" height="58" alt="Cisco | Benevity Client"/></div><div class="home_top-marquee-item swiper-slide"><img src="https://cdn.prod.website-files.com/680946676a0dac031a9848fc/680946676a0dac031a984958_Logo-4.svg" loading="eager" width="100" height="80" alt="Prudential logo" class="logo-img"/></div><div class="home_top-marquee-item swiper-slide"><img src="https://cdn.prod.website-files.com/680946676a0dac031a9848fc/680946676a0dac031a984957_Logo-5.svg" loading="eager" width="129" height="80" alt="Visa logo" class="logo-img"/></div><div class="home_top-marquee-item swiper-slide"><img src="https://cdn.prod.website-files.com/680946676a0dac031a9848fc/680946676a0dac031a984978_Logo-6.svg" loading="eager" width="105" height="80" alt="Starbucks logo" class="logo-img"/></div><div class="home_top-marquee-item swiper-slide"><img src="https://cdn.prod.website-files.com/680946676a0dac031a9848fc/680946676a0dac031a984975_Logo-7.svg" loading="eager" width="95" height="80" alt="UPS logo" class="logo-img"/></div><div class="home_top-marquee-item swiper-slide"><img src="https://cdn.prod.website-files.com/680946676a0dac031a9848fc/680946676a0dac031a98495a_Logo-8.svg" loading="eager" width="168" height="80" alt="GE Appliances logo" class="logo-img"/></div></div></div></div></div><div class="w-embed w-script"><script src="https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.js"></script>
<script>
(() => {
  const SELECTOR = ".home_top-marquee-component";
  const WRAPPER_SELECTOR = ".home_top-marquee-flex-wrapper";
  const SPEED = 30; // px per second

  function waitForImages(root) {
    const imgs = [...root.querySelectorAll("img")];
    if (!imgs.length) return Promise.resolve();
    return Promise.all(
      imgs.map(img =>
        img.complete
          ? Promise.resolve()
          : new Promise(r => {
              img.addEventListener("load", r, { once: true });
              img.addEventListener("error", r, { once: true });
            })
      )
    );
  }

  function px(v) {
    const n = parseFloat(v);
    return Number.isFinite(n) ? n : 0;
  }

  function measureSlides(slides) {
    let w = 0;
    slides.forEach(el => {
      const r = el.getBoundingClientRect();
      const s = getComputedStyle(el);
      w += r.width + px(s.marginRight);
    });
    return w;
  }

  function initOne(component) {
    if (component.__marqueeInit) return;
    component.__marqueeInit = true;

    const swiper = component.querySelector(".swiper");
    const wrapper = component.querySelector(WRAPPER_SELECTOR);
    if (!swiper || !wrapper) return;

    // Neutralize Swiper side effects
    swiper.style.overflow = "hidden";
    wrapper.style.display = "flex";
    wrapper.style.flexWrap = "nowrap";
    wrapper.style.transition = "none";
    wrapper.style.willChange = "transform";

    // Original slides only (ignore Swiper duplicates)
    const originals = [...wrapper.children].filter(
      el => !el.classList.contains("swiper-slide-duplicate")
    );

    let seqWidth = 0;
    let x = 0;
    let lastT = 0;

    function build() {
      wrapper.innerHTML = "";

      // Build two sequences for accurate measurement
      for (let i = 0; i < 2; i++) {
        originals.forEach(el => wrapper.appendChild(el.cloneNode(true)));
      }

      // Measure first rendered sequence
      const firstSeq = [...wrapper.children].slice(0, originals.length);
      seqWidth = measureSlides(firstSeq);

      const viewport = component.getBoundingClientRect().width;
      const needed = Math.ceil(viewport / seqWidth) + 2;

      // Rebuild with enough sequences to avoid dead zones
      wrapper.innerHTML = "";
      for (let i = 0; i < needed; i++) {
        originals.forEach(el => wrapper.appendChild(el.cloneNode(true)));
      }

      // Normalize position to avoid jumps
      x = x % seqWidth;
      if (x > 0) x -= seqWidth;
      wrapper.style.transform = `translate3d(${x}px,0,0)`;
    }

    function tick(t) {
      if (!lastT) lastT = t;
      const dt = (t - lastT) / 1000;
      lastT = t;

      x -= SPEED * dt;
      if (x <= -seqWidth) x += seqWidth;

      wrapper.style.transform = `translate3d(${x}px,0,0)`;
      requestAnimationFrame(tick);
    }

    (async () => {
      await waitForImages(wrapper);
      await new Promise(r =>
        requestAnimationFrame(() => requestAnimationFrame(r))
      );
      build();
      requestAnimationFrame(tick);
    })();

    window.addEventListener("resize", () => {
      lastT = 0;
      build();
    });
  }

  function initAll() {
    document.querySelectorAll(SELECTOR).forEach(initOne);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAll);
  } else {
    initAll();
  }
})();
</script></div></div></div></section><div class="background-color-tint-1"><div class="padding-global padding-section-large-copy alt"><div class="container-large"><div class="grid-2x-equal gap-large-4rem"><div class="flex-v-left-top gap-1-75rem"><div class="flex-v-left-top gap-1-75rem"><h2 class="heading-style-h2">What is the Benevity Enterprise Impact Platform?</h2><div class="text-size-small homepage">Running a purpose program in 2026 means justifying it in every room — to finance, legal, the board, the CFO. The Benevity Enterprise Impact Platform is a unified system for corporate social responsibility — bringing employee giving, volunteering, grants management, employee groups, challenges and impact reporting together in one place. <br/><br/>Built with the trusted global engine that supports every single action on the platform: risk mitigation, benchmarking, nonprofit due diligence, secure and compliant global disbursement, responsible and AI-native development.<br/><br/>Benevity is your partner for your social impact programs.</div><div class="flex-v-left-top gap--25rem"><div class="grid-3x-equal"><div class="stat-box"><div class="heading-style-h4"><strong>$16.6B</strong></div><div class="text-size-small homepage">Total donated </div></div><div class="stat-box"><div class="heading-style-h4">122.9M </div><div class="text-size-small homepage">Total volunteer hours</div></div><div class="stat-box"><div class="heading-style-h4"><strong>$20.1B</strong></div><div class="text-size-small homepage">Total grants managed</div></div></div><div class="text-size-footnote link"><a href="/annual-impact-report/2025" class="link-16">Source: 2025 Annual Impact Report</a></div></div></div><div class="button-group margin-top margin-small"><a href="/enterprise-impact-platform" class="button w-button">Learn about the platform</a></div></div><div><img src="https://cdn.prod.website-files.com/680946676a0dac031a9848fc/6a15fdcadc30ee1f0fb885ae_e0bf3d0263b07ea2d85c9eabe5745f08_Benevity-EIP.webp" loading="lazy" width="682" height="573" alt="Smiling woman inside a purple circular graphic with icons of gears, shield, pie chart, coin, and globe." srcset="https://cdn.prod.website-files.com/680946676a0dac031a9848fc/6a15fdcadc30ee1f0fb885ae_e0bf3d0263b07ea2d85c9eabe5745f08_Benevity-EIP-p-500.webp 500w, https://cdn.prod.website-files.com/680946676a0dac031a9848fc/6a15fdcadc30ee1f0fb885ae_e0bf3d0263b07ea2d85c9eabe5745f08_Benevity-EIP-p-800.webp 800w, https://cdn.prod.website-files.com/680946676a0dac031a9848fc/6a15fdcadc30ee1f0fb885ae_e0bf3d0263b07ea2d85c9eabe5745f08_Benevity-EIP-p-1080.webp 1080w, https://cdn.prod.website-files.com/680946676a0dac031a9848fc/6a15fdcadc30ee1f0fb885ae_e0bf3d0263b07ea2d85c9eabe5745f08_Benevity-EIP.webp 1364w" sizes="(max-width: 767px) 100vw, 682px"/></div></div></div></div></div><section class="section_global-tabs"><div class="padding-global padding-section-large-copy"><div class="container-large"><div class="global-heading-medium-container"><div class="eyebrow-wrapper"><div class="eyebrow eyebrow-color-blue">BENEVITY ENTERPRISE IMPACT PLATFORM</div></div><div class="global-heading-copy-wrapper"><div class="text-color-primary"><h2 class="heading-style-h2">One platform — not five point solutions.</h2></div><div class="global-heading-copy-text-container"><div class="text-size-medium">Giving. Volunteering. Grants. ERGs. Impact reporting.<br/><br/>One unified platform so every dollar is tracked, every action is measurable and every decision is defensible in any room, all operating on a responsible AI model that saves your team time to focus on what matters most.</div></div></div></div><div class="margin-top margin-medium"><div class="grid-3x-equal _1-column-mobile"><div class="homepage-feature-card"><a href="/products/donate" class="card-background w-inline-block"><div class="module-feature-wrapper gap-1rem"><div class="flex-v-left-top gap-1-25rem"><div class="icon-background purple"><div class="c text-color-white w-embed"><svg xmlns="ht