document.addEventListener("DOMContentLoaded", function () {
  const navBars = document.querySelectorAll(".nav_bar");
  const topbar = document.querySelector(".topbar-nav-wrapper");

  if (!navBars.length || !topbar) return;

  navBars.forEach(navBar => {
    // Only apply to transparent variant
    const isTransparentVariant =
      navBar.getAttribute("data-wf--global---navbar--variant") === "transparent";

    if (!isTransparentVariant) return;

    // Smooth transition
    navBar.style.transition = 'top 0.3s ease';

    function adjustNavbarPosition() {
      const topbarVisible =
        topbar.style.display !== 'none' &&
        window.scrollY === 0;

      navBar.style.top = topbarVisible
        ? topbar.offsetHeight + 'px'
        : '0px';
    }

    // Initial adjustment
    adjustNavbarPosition();

    // Adjust on scroll
    window.addEventListener('scroll', adjustNavbarPosition);

    // Watch for topbar visibility changes
    const observer = new MutationObserver(adjustNavbarPosition);
    observer.observe(topbar, {
      attributes: true,
      attributeFilter: ['style']
    });

    // Handle close button
    const closeButton = topbar.querySelector('.close-button');
    if (closeButton) {
      closeButton.addEventListener('click', function () {
        setTimeout(adjustNavbarPosition, 10);
      });
    }
  });
});
</script>




<script>

	// Detecting if it is an iOS device, true/false
var iOS = !!navigator.platform && /iPad|iPhone|iPod/.test(navigator.platform);

$(document).ready(function () {
  // Defining that "overlay" is the element that has a changing display value
  var overlay = document.querySelector('.w-nav-overlay');

  // Creating our mutation observer, which we attach to overlay later
  var observer = new MutationObserver(function (mutations) {
    mutations.forEach(function (mutationRecord) {

      // Checking if it's the style attribute got changed and if display value now set to 'none'?
      if (mutationRecord.attributeName === 'style' && window.getComputedStyle(overlay)
        .getPropertyValue('display') !== 'none') {

        //Overlay's  display value is no longer 'none', now changing the "body" styles:
        if (iOS) {
          // for iOS devices:
          var x = $(window).scrollTop().toFixed()

          $('body').css({
            'overflow': 'hidden',
            'position': 'fixed',
            'top': '-' + x + 'px',
            'width': '100vw'
          });
        }
        // for all other devices:
        $('body').css('overflow', 'hidden');
      }
      //Overlay's  display value back to 'none' , now changing the "body" styles again:
      else {
        if (iOS) {
          //  for iOS devices:
          var t = $('body').css('top').replace('-', '').replace('px', '')
          $('body').css({
            'overflow': 'auto',
            'position': '',
            'width': '100vw'
          });
          $('body').animate({ scrollTop: t }, 0);
        }
        // for all other devices:
        $('body').css('overflow', '');

      }

    });
  });
  // Attach the mutation observer to overlay, and only when attribute values change
  observer.observe(overlay, { attributes: true, attributeFilter: ['style'] });

});

</script>

<script>
  //Update copyright year in global footer component
document.addEventListener("DOMContentLoaded", function () {
  const yearElements = document.querySelectorAll("[data-copyright-year]");
  if (!yearElements.length) return;

  const currentYear = new Date().getFullYear();

  yearElements.forEach(el => {
    const displayedYear = parseInt(el.textContent.trim(), 10);

    // Update only when current year surpasses displayed year
    if (currentYear > displayedYear) {
      el.textContent = currentYear;
    }
  });
});
</script>

<script>
 // Convert am/pm to a.m./p.m. in rendered time text
document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll("[data-format-ampm]").forEach(el => {
    el.textContent = el.textContent
      .replace(/\bam\b/gi, "a.m.")
      .replace(/\bpm\b/gi, "p.m.");
  });
});
</script>
<!--- BENEVITY PERSISTENT UTM + WEBINAR LINK DECORATION (v3 — whitelist: tracking params only) --->
<script>
  (function() {
    window.addEventListener('load', function() {

      // --- SECTION 1: CONFIGURATION ---
      const config = {
        maxDays: 30,  // How long to store UTMs in the browser
        storageKey: 'benevity_utm_params',
        debug: true   // Set to false to hide console logs in production
      };

      const log = (message) => {
        if (config.debug) console.log('Benevity Log:', message);
      };

      // --- SECTION 2: DEFINE TARGET PAGE ---
      const isWebinarPage = window.location.pathname.includes('/webinars');

      // --- SECTION 3: PARAMETER HANDLING ---
      // WHITELIST: only real tracking params are ever stored or copied onto
      // links. Page-functional params (goldcast_event_id for the webinar form,
      // data for the Business Impact Calculator report, A/B test params, etc.)
      // are automatically excluded — no per-param blacklist to maintain.
      const TRACKED_PARAMS = /^(utm_|gclid$|fbclid$|li_fat_id$|msclkid$)/;

      const filterTracked = (source) => {
        const out = new URLSearchParams();
        source.forEach((value, key) => {
          if (TRACKED_PARAMS.test(key)) out.set(key, value);
        });
        return out;
      };

      // 'params' is our LIVE list used for link decoration on this page.
      var params = filterTracked(new URLSearchParams(window.location.search));

      // 'storageParams' is what we persist. Same whitelist.
      let storageParams = new URLSearchParams(params.toString());

      // --- SECTION 4: STORAGE LOGIC (Runs on every page) ---
      if (storageParams.toString().length > 0) {
        try {
          localStorage.setItem(config.storageKey, storageParams.toString());
          localStorage.setItem(config.storageKey + '_timestamp', Date.now());
          log('Tracking parameters saved to memory (whitelist applied)');
        } catch (error) {
          console.warn('Error saving to localStorage:', error);
        }
      } else {
        try {
          const storedParams = localStorage.getItem(config.storageKey);
          const storedTime = localStorage.getItem(config.storageKey + '_timestamp');

          if (storedParams && storedTime) {
            const daysPassed = (Date.now() - parseInt(storedTime, 10)) / (1000 * 60 * 60 * 24);

            if (daysPassed < config.maxDays) {
              // Whitelist applied on retrieval too — this also cleans out any
              // non-tracking params (e.g. 'data') stored before this fix shipped.
              const savedValues = filterTracked(new URLSearchParams(storedParams));
              savedValues.forEach((value, key) => {
                if (!params.has(key)) params.set(key, value);
              });
              log('Retrieved valid tracking params from memory');
            }
          }
        } catch (error) {
          console.warn('Error retrieving from localStorage:', error);
        }
      }

      // --- SECTION 5: LINK UPDATING (Webinar Pages Only) ---
      if (!isWebinarPage) {
        log('Not a webinar page. Script idle (Parameters are stored but links not modified).');
        return;
      }

      // Only whitelisted tracking params can reach this point.
      if (params.toString().length > 0) {
        const links = document.querySelectorAll('a[href]');

        links.forEach(function(link) {
          try {
            const url = new URL(link.href);
            params.forEach((value, key) => {
              url.searchParams.set(key, value);
            });
            link.href = url.toString();
          } catch (error) {
            // Safety: Skip non-standard links like 'mailto:' or 'tel:'
          }
        });

        log('Applied tracking params to ' + links.length + ' links (whitelist applied).');
      }
    });
  })();

  console.log("BENEVITY WEBINAR TRACKING LOADED");
</script>
