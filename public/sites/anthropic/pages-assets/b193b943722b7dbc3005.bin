<script>
  var Webflow = Webflow || [];
    Webflow.push(function() {
      //DISABLE WEBFLOW SMOOTH SCROLL
      $(function() {
          $(document).off('click.wf-scroll');
    });
  });
</script>
<script>
// Transparent navbar custom functionality
document.addEventListener("DOMContentLoaded", function () {
  const navBar = document.querySelector(".nav_bar");
  const secondaryButtons = document.querySelectorAll(".button.is-secondary.is-small, .button.is-secondary.is-nav-v2");
  const navLogoIcon = document.querySelector(".nav-logo_icon");
  const dropdownToggles = document.querySelectorAll(".nav-dropdown_toggle");
  const navbarButton = document.querySelector(".navbar_button");
  const navSearchInput = document.querySelector(".nav-menu-cta_nav-search_btn");
  const isTransparentVariant =
    navBar && navBar.getAttribute("data-wf--global---navbar--variant") === "transparent";

  if (!navBar || !isTransparentVariant) return;

  let hasScrolled = window.scrollY > 0;
  let lastState = null;

  // Prepare logo path groups by class
  let st0Paths = [];
  let st1Paths = [];

  if (navLogoIcon) {
    st0Paths = Array.from(navLogoIcon.querySelectorAll(".st0"));
    st1Paths = Array.from(navLogoIcon.querySelectorAll(".st1"));

    // Initial logo state: white
    st0Paths.forEach(path => path.style.fill = "#FFFFFF");
    st1Paths.forEach(path => {
      path.style.fill = "#4ba4da";
      path.style.opacity = "0.5";
    });
  }

  // Custom hover for secondary buttons on desktop
  if (window.innerWidth > 991 && isTransparentVariant) {
    secondaryButtons.forEach((btn) => {
      btn.style.borderColor = "var(--button--primary-border)";
      btn.addEventListener("mouseenter", () => {
        btn.style.borderColor = "var(--button--primary-border)";
        
        // Check if scrolled OR if any dropdown is open
        const isDropdownOpen = Array.from(dropdownToggles).some(
          (el) => el.getAttribute("aria-expanded") === "true"
        );
        
        if (hasScrolled || isDropdownOpen) {
          btn.style.color = "var(--button--primary-text)";
        }
      });
      btn.addEventListener("mouseleave", () => {
        // Check if scrolled OR if any dropdown is open
        const isDropdownOpen = Array.from(dropdownToggles).some(
          (el) => el.getAttribute("aria-expanded") === "true"
        );
        
        if (hasScrolled || isDropdownOpen) {
          btn.style.borderColor = "var(--button--primary-border)";
          btn.style.color = "var(--button--primary-border)";
        } else {
          btn.style.borderColor = "var(--border-color--border-light)";
          btn.style.color = "var(--border-color--border-light)";
        }
      });
    });
  }

  const applyScrolledStyles = () => {
    navSearchInput.style.filter = "invert(0)";
    navBar.style.backgroundColor = "var(--background-color--background-alternate)";
    navBar.style.color = "var(--base-color-neutral--content-primary)";

    if (window.innerWidth >= 992) {
      secondaryButtons.forEach((btn) => {
        btn.style.borderColor = "var(--button--primary-border)";
        btn.style.color = "var(--button--primary-border)";
      });
    }

    // Logo colored state
    st0Paths.forEach(path => path.style.fill = "#1d174e");
    st1Paths.forEach(path => {
      path.style.fill = "#4ba4da";
      path.style.opacity = "1";
    });
  };

  const resetStyles = () => {
    navSearchInput.style.filter = "invert(1)";
    navBar.style.backgroundColor = "transparent";
    navBar.style.color = "";

    if (window.innerWidth >= 992) {
      secondaryButtons.forEach((btn) => {
        btn.style.borderColor = "var(--border-color--border-light)";
        btn.style.color = "var(--border-color--border-light)";
      });
    }

    // Logo white state
    st0Paths.forEach(path => path.style.fill = "#FFFFFF");
    st1Paths.forEach(path => {
      path.style.fill = "#4ba4da";
      path.style.opacity = "0.5";
    });
  };

  const updateDropdownColors = () => {
    const isAnyDropdownOpen = Array.from(dropdownToggles).some(
      (el) => el.getAttribute("aria-expanded") === "true"
    );

    if (isTransparentVariant && (isAnyDropdownOpen || hasScrolled)) {
      dropdownToggles.forEach((el) => {
        el.style.color = "#333";
      });
    } else {
      dropdownToggles.forEach((el) => {
        el.style.color = "";
      });
    }
  };

  const updateNavbarButtonColor = () => {
    if (!navbarButton) return;
    const isNavbarOpen = navbarButton.classList.contains("w--open");

    if (window.innerWidth < 992 && isTransparentVariant) {
      if (hasScrolled || isNavbarOpen) {
        navbarButton.style.color = "#333";
      } else {
        navbarButton.style.color = "#fff";
      }
    } else {
      navbarButton.style.color = "";
    }
  };

  const updateStateAndApplyStyles = () => {
    const isDropdownOpen = Array.from(dropdownToggles).some(
      (el) => el.getAttribute("aria-expanded") === "true"
    );
    const isNavbarButtonOpen =
      navbarButton && navbarButton.classList.contains("w--open");

    hasScrolled = window.scrollY > 0;
    const shouldApply = hasScrolled || isDropdownOpen || isNavbarButtonOpen;
    const currentState = `${shouldApply}`;
    if (currentState === lastState) return;
    lastState = currentState;

    shouldApply ? applyScrolledStyles() : resetStyles();

    updateDropdownColors();
    updateNavbarButtonColor();
  };

  if (window.innerWidth >= 992) {
    secondaryButtons.forEach((btn) => {
      btn.style.borderColor = "var(--border-color--border-light)";
      btn.style.color = "var(--border-color--border-light)";
    });
  }

  updateStateAndApplyStyles();

  window.addEventListener("scroll", () => {
    hasScrolled = window.scrollY > 0;
    updateStateAndApplyStyles();
    updateDropdownColors();
    updateNavbarButtonColor();
  });

  dropdownToggles.forEach((el) => {
    const observer = new MutationObserver(() => {
      updateStateAndApplyStyles();
      updateDropdownColors();
      updateNavbarButtonColor();
    });
    observer.observe(el, { attributes: true, attributeFilter: ["aria-expanded"] });
  });

  if (navbarButton) {
    const observer = new MutationObserver(() => {
      updateStateAndApplyStyles();
      updateNavbarButtonColor();
    });
    observer.observe(navbarButton, { attributes: true, attributeFilter: ["class"] });
  }

  // Smooth scroll with navbar offset
  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      const href = this.getAttribute("href");
      const targetID = href.substring(1);
      const target = document.getElementById(targetID);
      if (!target || !navBar) return;

      e.preventDefault();

      const navHeight = navBar.offsetHeight;
      const startY = window.scrollY;
      const targetY = target.getBoundingClientRect().top + startY - navHeight;
      const distance = targetY - startY;
      const duration = 1000;
      let startTime = null;

      function easeInOutQuad(t) {
        return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
      }

      function animateScroll(currentTime) {
        if (!startTime) startTime = currentTime;
        const timeElapsed = currentTime - startTime;
        const progress = Math.min(timeElapsed / duration, 1);
        const easedProgress = easeInOutQuad(progress);
        const newY = startY + distance * easedProgress;

        window.scrollTo(0, newY);
        if (timeElapsed < duration) {
          requestAnimationFrame(animateScroll);
        }
      }

      requestAnimationFrame(animateScroll);
    });
  });
});
</script>

