/*  Custom styles for resolutions above 1441px  */


@media (min-width: 1441px) {
    :root {
      --_responsive---font-size--h1: 4.68125rem;
      --_responsive---font-size--h2: 3.1875rem;
      --_responsive---font-size--h3: 2.4375rem;
      --_responsive---font-size--h4: 1.875rem;
      --_responsive---font-size--h5: 1.5rem;

      --_responsive---font-size--text-large: 1.375rem;
      --_responsive---font-size--text-medium: 1.125rem;
      --_responsive---font-size--text-regular: 1rem;
      --_responsive---font-size--text-small: 0.875rem;

      --_responsive---font-size--misc-stat: 4.75rem;
      --_responsive---font-size--misc-quote: 2rem;
      --_responsive---font-size--misc-global: 1.25rem;
      --_responsive---font-size--misc-overline: 0.875rem;
      --_responsive---font-size--misc-button-medium: 1rem;
      --_responsive---font-size--misc-button-small: 0.875rem;
    }
    
		.padding-section-home_hero{
    	padding:10.75rem 0;
    }

  }

	/* Nav cards width */
  .nav-dropdown_toggle.w-dropdown-toggle.w--open {
    background-color: #F0F7FC;
  }

  .nav-products-left_col .nav-dropdown-layout_wrapper .nav-dropdown-card_link {
      width: calc((100% - (1.5rem * 2)) / 3);
  }
  .nav-products-right_col .nav-dropdown-card_link {
      width: 100%;
      max-width: 17.4375rem;
  }

  /* Fix nav bar lines not displaying on designer  */
  @media screen and (max-width: 991px) {
    .w-nav[data-collapse="medium"] .w-nav-button {
      display: flex !important;
    }

    .w-nav-link {
      margin: 0;
    }
  }

	/*  Nav logo transition  */
  .nav-logo_icon path {
    transition: fill 0.3s ease;
  }
  
  
	.button.is-icon-white-transparent .icon-height-play,.button.is-icon-black-transparent .icon-height-play{
		color: #D1305E;
  }
  
	.button.is-icon-white-transparent:hover .icon-height-play, .button.is-icon-black-transparent:hover .icon-height-play{
		color: #B91C1C;
  }

.w-dropdown-toggle div {
	white-space: normal;
}


.nav-logo_icon path,
.nav-logo_icon rect,
.nav-logo_icon circle {
  transition: fill 0.3s ease, opacity 0.3s ease;
}


svg.footer-logo.white .st0 {
	fill: #fff;
}
  
  
svg.footer-logo.white	.st1 {
	opacity: .5;
}

  
  
svg.nav-logo_icon .st0 {
	fill: #1d174e;
}

svg.nav-logo_icon .st1 {
	fill: #4ba4da;
}
@media (min-width: 992px) {
.nav-dropdown-card_link:hover .nav_title {
 color: var(--base-color-neutral--white);
}
}
