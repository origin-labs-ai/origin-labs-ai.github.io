=\"-10.73312629199899\" width=\"21.46625258399798\" height=\"21.46625258399798\" clip-path=\"url(#_R_19rpbsnpfkq6btb_)\" preserveAspectRatio=\"xMidYMid slice\"></image></g></g><g transform=\"translate(250.34744, 35.22447782455064)\"><g style=\"transform:none;transform-origin:50% 50%;transform-box:fill-box\"><circle cx=\"0\" cy=\"0\" r=\"10.73312629199899\" class=\"_74-EFW_nodeBg\"></circle><image href=\"https://assets.claude.com/16c346d44a310e746657cd16ea275a2da5efa719.png\" x=\"-10.73312629199899\" y=\"-10.73312629199899\" width=\"21.46625258399798\" height=\"21.46625258399798\" clip-path=\"url(#_R_19rpbsnpfkq6btb_)\" preserveAspectRatio=\"xMidYMid slice\"></image></g></g><g transform=\"translate(89.7876, 61.64210566748654)\"><g style=\"transform:none;transform-origin:50% 50%;transform-box:fill-box\"><circle cx=\"0\" cy=\"0\" r=\"10.73312629199899\" class=\"_74-EFW_nodeBg\"></circle><image href=\"https://assets.claude.com/1755639b93c7cec99475de59cb9802d0e13e6207.png\" x=\"-10.73312629199899\" y=\"-10.73312629199899\" width=\"21.46625258399798\" height=\"21.46625258399798\" clip-path=\"url(#_R_19rpbsnpfkq6btb_)\" preserveAspectRatio=\"xMidYMid slice\"></image></g></g><g transform=\"translate(29.652559999999998, 69.77552217544937)\"><g style=\"transform:none;transform-origin:50% 50%;transform-box:fill-box\"><circle cx=\"0\" cy=\"0\" r=\"10.73312629199899\" class=\"_74-EFW_nodeBg\"></circle><image href=\"https://assets.claude.com/18636e2f18982e3166a613b3f028e27b196bfe2f.png\" x=\"-10.73312629199899\" y=\"-10.73312629199899\" width=\"21.46625258399798\" height=\"21.46625258399798\" clip-path=\"url(#_R_19rpbsnpfkq6btb_)\" preserveAspectRatio=\"xMidYMid slice\"></image></g></g><circle cx=\"141.69847999999996\" cy=\"46.85438051740289\" r=\"16.733126291998992\" fill=\"transparent\" class=\"_74-EFW_nodeHit\"></circle><a aria-label=\"KPMG integrates Claude across its core business and workforce of more than 276,000 in strategic alliance\" href=\"/news/anthropic-kpmg\"><circle cx=\"199.9228\" cy=\"38.11442764794455\" r=\"16.733126291998992\" fill=\"transparent\" class=\"_74-EFW_nodeHit\"></circle></a><a aria-label=\"Snowflake and Anthropic announce $200 million partnership to bring agentic AI to global enterprises\" href=\"/news/snowflake-anthropic-expanded-partnership\"><circle cx=\"250.34744\" cy=\"35.22447782455064\" r=\"16.733126291998992\" fill=\"transparent\" class=\"_74-EFW_nodeHit\"></circle></a><a aria-label=\"Claude 3 models on Vertex AI\" href=\"/news/google-vertex-general-availability\"><circle cx=\"89.7876\" cy=\"61.64210566748654\" r=\"16.733126291998992\" fill=\"transparent\" class=\"_74-EFW_nodeHit\"></circle></a><a aria-label=\"Claude 3 Haiku: our fastest model yet\" href=\"/news/claude-3-haiku\"><circle cx=\"29.652559999999998\" cy=\"69.77552217544937\" r=\"16.733126291998992\" fill=\"transparent\" class=\"_74-EFW_nodeHit\"></circle></a></svg></div></div><div class=\"tOQyXa_headline-6 yApI1G_headline\" data-component=\"Headline\">Related articles</div><ul class=\"yApI1G_list\"><li><div class=\"yApI1G_card _8J1zJG_card\"><header class=\"_8J1zJG_cardHeader\"><div class=\"_8J1zJG_eyebrowsWrapper\"><p>Partnerships</p><p>May 19, 2026</p></div></header><div class=\"_8J1zJG_text\" data-lines=\"3\" style=\"--text-lines:3\"><a class=\"_8J1zJG_link\" href=\"/news/anthropic-kpmg\">KPMG integrates Claude across its core business and workforce of more than 276,000 in strategic alliance</a></div></div></li></ul><a data-component=\"AnchorButton\" data-variant=\"tertiary\" class=\"f9ZZrG_button f9ZZrG_corner-small f9ZZrG_variant-tertiary f9ZZrG_size-small f9ZZrG_icon-format-trailing yApI1G_cta\" rel=\"nofollow\" href=\"/search?topic=partnerships\">View more<span class=\"f9ZZrG_icon\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"currentColor\" xmlns=\"http://www.w3.org/2000/svg\" style=\"flex-shrink:0\" aria-hidden=\"true\"><path d=\"M11.1465 4.64648C11.3417 4.45127 11.6582 4.45136 11.8535 4.64648L16.8535 9.64649L16.916 9.72267C16.9703 9.80418 17 9.90061 17 10C17 10.1326 16.9473 10.2598 16.8535 10.3535L11.8535 15.3535C11.6583 15.5486 11.3417 15.5487 11.1465 15.3535C10.9513 15.1583 10.9514 14.8418 11.1465 14.6465L15.293 10.5H3.5C3.2239 10.5 3.00006 10.2761 3 10C3 9.72387 3.22386 9.50001 3.5 9.50001H15.293L11.1465 5.35352C10.9514 5.15826 10.9513 4.8417 11.1465 4.64648Z\"></path></svg></span></a></div></aside></div><div class=\"PA4F1q_body\" data-article-body=\"true\" data-theme=\"ivory\"><p class=\"PA4F1q_reading-column post-text\">Salesforce customers can now select <a href=\"/claude\">Claude models</a> for AI-powered Salesforce applications and experiences built with the Salesforce Platform. The latest Claude models—Claude 3.5 Sonnet, Claude 3 Opus, and Claude 3 Haiku—are now available to Salesforce customers using Amazon Bedrock.</p><p class=\"PA4F1q_reading-column post-text\">Now, Claude can help Salesforce enterprises improve efficiency, insight, and personalization across their entire operation, including sales, customer service, marketing, commerce, and IT, among others.</p><p class=\"PA4F1q_reading-column post-text\">Claude is designed for enterprise-grade security and accuracy, with industry-leading skills that lead to near-human voice and tone and less hallucination than other LLMs. Salesforce customers can now select Claude models in prompt templates that power custom AI experiences or, most recently, custom actions for <a id=\"base-ui-_R_1u3drpbsnpfkq6btb_\" data-base-ui-tooltip-trigger=\"\" href=\"https://www.salesforce.com/agentforce/\">Agentforce Agents</a>, which can plan and take action on behalf of employees and customers.</p><div class=\"PA4F1q_reading-column\"><blockquote class=\"PA4F1q_blockquote post-text\">Through our partnership with Anthropic, customers gain the flexibility to integrate their own LLMs, introducing Claude models with diverse levels of intelligence, speed, and cost-effectiveness. This empowers users to tailor their CRM applications to their unique requirements.</blockquote></div><p class=\"PA4F1q_reading-column post-text\"><em>– Kaushal Kurapati, Senior Vice President of Product for AI at Salesforce</em></p><h3 class=\"tOQyXa_headline-5 PA4F1q_reading-column post-section\" data-component=\"Headline\" id=\"use-cases-across-industries\">Use Cases Across Industries:</h3><ul class=\"PA4F1q_reading-column text-body-1-serif post-text\"><li><strong>Sales and Marketing</strong>: Generate tailored pitches, analyze call transcripts, create personalized content, and evaluate campaign performance.</li><li><strong>Customer Service</strong>: Summarize cases and generate personalized responses.</li><li><strong>Healthcare and Financial Services</strong>: Summarize records, generate education materials, analyze reports, and create investment recommendations.</li><li><strong>Legal and Technology</strong>: Analyze contracts and user feedback, generate product descriptions.</li><li><strong>Media and Entertainment</strong>: Generate content ideas and create personalized recommendations.</li></ul><h3 class=\"tOQyXa_headline-5 PA4F1q_reading-column post-section\" data-component=\"Headline\" id=\"integration-details-\">Integration Details: </h3><p class=\"PA4F1q_reading-column post-text\">Salesforce customers can now access the latest Claude 3.5 Sonnet, Claude 3 Opus, and Claude 3 Haiku models through the Bring Your Own Large Language Model (BYO LLM) feature in Salesforce’s tools that make it easy for admins and developers to create and customize AI applications without needing advanced coding skills. These tools help Salesforce admins and developers customize, build, and extend their AI applications. </p><p class=\"PA4F1q_reading-column post-text\">This integration allows users to:</p><ol class=\"PA4F1q_reading-column text-body-1-serif post-text\"><li>Connect Claude models via existing AWS Bedrock environments</li><li>Choose between Claude 3.5 Sonnet, Claude 3 Opus, and Claude 3 Haiku in custom prompt templates within Salesforce</li><li>Maintain security and compliance standards while leveraging advanced AI capabilities</li></ol><p class=\"PA4F1q_reading-column post-text\">All interactions with Claude flow through Salesforce's secure AI systems, ensuring responsible AI use with safeguards like dynamic grounding and toxicity detection through the <a id=\"base-ui-_R_1ucdrpbsnpfkq6btb_\" data-base-ui-tooltip-trigger=\"\" href=\"https://www.salesforce.com/products/secure-ai/?d=cta-body-promo-8\">Einstein Trust Layer</a>.</p><h3 class=\"tOQyXa_headline-5 PA4F1q_reading-column post-section\" data-component=\"Headline\" id=\"getting-started\">Getting Started:</h3><ol class=\"PA4F1q_reading-column text-body-1-serif post-text\"><li>Access <a id=\"base-ui-_R_fhedrpbsnpfkq6btb_\" data-base-ui-tooltip-trigger=\"\" href=\"https://www.salesforce.com/artificial-intelligence/ai-builder/\">Einstein Studio</a> in Salesforce Data Cloud</li><li>Select the Foundation Models tab and click \"Add Foundation Model\"</li><li>Choose to connect via Amazon Bedrock</li><li>Enter required credentials (e.g., API keys, region information)</li><li>Configure and test the model in the Model Playground</li><li>Create custom prompt templates using Prompt Builder</li></ol><p class=\"PA4F1q_reading-column post-text\">For more information on how to leverage Claude within your Salesforce environment, contact your Salesforce representative. Check out this <a id=\"base-ui-_R_3qfdrpbsnpfkq6btb_\" data-base-ui-tooltip-trigger=\"\" href=\"https://aws.amazon.com/blogs/machine-learning/build-generative-ai-powered-salesforce-applications-with-amazon-bedrock/\">AWS Developer blog</a> to learn how you can <a id=\"base-ui-_R_3sfdrpbsnpfkq6btb_\" data-base-ui-tooltip-trigger=\"\" href=\"https://developer.salesforce.com/blogs/2024/03/bring-your-own-large-language-model-in-einstein-1-studio\">build generative AI–powered Salesforce applications</a> with Amazon Bedrock.</p><p class=\"PA4F1q_reading-column post-text\"><strong><em>Screenshots: </em></strong></p><p class=\"PA4F1q_reading-column post-text\"><em>In Summer ’24, Salesforce added Anthropic Claude 3 models hosted on Amazon Bedrock to their AI platform. This is in addition to their existing LLM options.</em></p><div class=\"PA4F1q_media-column\" data-type=\"image\" data-width=\"inline-width\"><figure class=\"Duq99q_e-imageWithCaption\"><img alt=\"Salesforce product screen\" loading=\"lazy\" width=\"2880\" height=\"1620\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/sites/anthropic/pages-assets/9e08267f3d8379367656.jpg\"></figure></div><div class=\"PA4F1q_media-column\" data-type=\"image\" data-width=\"inline-width\"><figure class=\"Duq99q_e-imageWithCaption\"><img alt=\"Salesforce product screenshot\" loading=\"lazy\" width=\"2880\" height=\"1620\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/sites/anthropic/pages-assets/49e3a45931ae9875f24e.jpg\"></figure></div></div></div></article></div><!--$--><!--/$-->","canvases":0}