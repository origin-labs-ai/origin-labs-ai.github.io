form: translate(0px, 0px); opacity: 1;\" data-animated=\"true\"><h3 class=\"tOQyXa_headline-5 NEQLZG_heading\" data-component=\"Headline\">Bridging research and policy</h3><p class=\"tOQyXa_body-3\" data-component=\"Body\">Our researchers work to translate technical findings into useful evidence for decision-makers in national security, policy, and industry.</p></div></div></div></div></div></section><section class=\"ZSMdoa_root\" data-theme=\"ivory\"><div class=\"_5NNTzG_inset-frame\"><div class=\"_5NNTzG_hero-carousel _5NNTzG_unthemed _5NNTzG_inset\" style=\"visibility: visible; translate: none; rotate: none; scale: none; transform: translate(0px, 0px); opacity: 0;\"><div class=\"_5NNTzG_carousel-wrapper\"><div class=\"_5NNTzG_embla-viewport\"><ul class=\"_5NNTzG_embla-container\" style=\"transform: translate3d(0px, 0px, 0px);\"><li class=\"_5NNTzG_embla-slide\" style=\"transform: translate3d(0px, 0px, 0px);\"><a class=\"_5NNTzG_slide-link\" tabindex=\"-1\" aria-hidden=\"true\" href=\"/research/formal-verification\"><img alt=\"LLMs are making formal software verification feasible at a much larger scale\" loading=\"eager\" width=\"1407\" height=\"793\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" sizes=\"100vw\" src=\"/sites/anthropic/pages-assets/634ee8159ad7de27ac46.webp\"></a></li><li class=\"_5NNTzG_embla-slide\"><a class=\"_5NNTzG_slide-link\" tabindex=\"-1\" aria-hidden=\"true\" href=\"/research/ecdsa-curve-origins\"><img alt=\"Claude reveals ECDSA curve origins\" loading=\"eager\" width=\"1407\" height=\"793\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" sizes=\"100vw\" src=\"/sites/anthropic/pages-assets/f8ff3194237a29cfced5.webp\"></a></li><li class=\"_5NNTzG_embla-slide\"><a class=\"_5NNTzG_slide-link\" tabindex=\"-1\" aria-hidden=\"true\" href=\"/research/launching-opt-in-vuln-finding-service-for-open-source\"><img alt=\"Launching an opt-in vulnerability-finding service for open-source software\" loading=\"eager\" widt