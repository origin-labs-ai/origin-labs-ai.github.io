61 3 10C3 9.72386 3.22386 9.5 3.5 9.5H12.1963L8.16504 5.87207L8.09766 5.79688C7.95931 5.60979 7.96622 5.34471 8.12793 5.16504Z\"></path></svg></span></button></div></li><li class=\"MdMSIq_cell\"><div class=\"MdMSIq_card\"><span class=\"tOQyXa_caption-1 MdMSIq_eyebrow\" data-component=\"Caption\">Pillar 4</span><span class=\"tOQyXa_headline-6 MdMSIq_title\" data-component=\"Headline\">AI expands prosperity and human flourishing.</span><span class=\"tOQyXa_body-4 MdMSIq_summary\" data-component=\"Body\">AI enables unprecedented economic growth, and the resulting prosperity empowers every person to pursue a good life.</span><button type=\"button\" aria-haspopup=\"dialog\" aria-expanded=\"false\" aria-label=\"Read more about pillar 4\" data-component=\"Button\" data-variant=\"tertiary\" class=\"f9ZZrG_button f9ZZrG_corner-small f9ZZrG_variant-tertiary f9ZZrG_size-small f9ZZrG_icon-format-trailing MdMSIq_more\">Read more<span class=\"f9ZZrG_icon\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"currentColor\" xmlns=\"http://www.w3.org/2000/svg\" style=\"flex-shrink:0\" aria-hidden=\"true\"><path d=\"M16.5 3C16.7761 3 17 3.22386 17 3.5V16.5L16.9902 16.6006C16.9437 16.8286 16.7417 17 16.5 17C16.2583 17 16.0563 16.8286 16.0098 16.6006L16 16.5V3.5C16 3.22386 16.2239 3 16.5 3ZM8.12793 5.16504C8.28958 4.98547 8.5524 4.95058 8.75293 5.06836L8.83496 5.12793L13.835 9.62793C13.9403 9.72275 14 9.85828 14 10C14 10.1063 13.9667 10.2093 13.9053 10.2939L13.835 10.3721L8.83496 14.8721C8.62972 15.0568 8.31267 15.0402 8.12793 14.835C7.94322 14.6297 7.95984 14.3127 8.16504 14.1279L12.1963 10.5H3.5C3.22386 10.5 3 10.2761 3 10C3 9.72386 3.22386 9.5 3.5 9.5H12.1963L8.16504 5.87207L8.09766 5.79688C7.95931 5.60979 7.96622 5.34471 8.12793 5.16504Z\"></path></svg></span></button></div></li><li class=\"MdMSIq_cell\"><div class=\"MdMSIq_card\"><span class=\"tOQyXa_caption-1 MdMSIq_eyebrow\" data-component=\"Caption\">Pillar 5</span><span class=\"tOQyXa_headline-6 MdMSIq_title\" data-component=\"Headline\">AI’s benefits are shared by everyone.</span><span class=\"tOQyXa_body-4 MdMSIq_summary\" data-component=\"Body\">AI delivers transformative benefits that reach people everywhere, and the opportunities AI creates are distributed.</span><button type=\"button\" aria-haspopup=\"dialog\" aria-expanded=\"false\" aria-label=\"Read more about pillar 5\" data-component=\"Button\" data-variant=\"tertiary\" class=\"f9ZZrG_button f9ZZrG_corner-small f9ZZrG_variant-tertiary f9ZZrG_size-small f9ZZrG_icon-format-trailing MdMSIq_more\">Read more<span class=\"f9ZZrG_icon\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"currentColor\" xmlns=\"http://www.w3.org/2000/svg\" style=\"flex-shrink:0\" aria-hidden=\"true\"><path d=\"M16.5 3C16.7761 3 17 3.22386 17 3.5V16.5L16.9902 16.6006C16.9437 16.8286 16.7417 17 16.5 17C16.2583 17 16.0563 16.8286 16.0098 16.6006L16 16.5V3.5C16 3.22386 16.2239 3 16.5 3ZM8.12793 5.16504C8.28958 4.98547 8.5524 4.95058 8.75293 5.06836L8.83496 5.12793L13.835 9.62793C13.9403 9.72275 14 9.85828 14 10C14 10.1063 13.9667 10.2093 13.9053 10.2939L13.835 10.3721L8.83496 14.8721C8.62972 15.0568 8.31267 15.0402 8.12793 14.835C7.94322 14.6297 7.95984 14.3127 8.16504 14.1279L12.1963 10.5H3.5C3.22386 10.5 3 10.2761 3 10C3 9.72386 3.22386 9.5 3.5 9.5H12.1963L8.16504 5.87207L8.09766 5.79688C7.95931 5.60979 7.96622 5.34471 8.12793 5.16504Z\"></path></svg></span></button></div></li></ul></div></section><section id=\"ledger\" aria-label=\"Explore the work\"><div class=\"Bo9kyq_container _2w9DrG_heading\" data-component=\"CSSGrid.Container\"><div class=\"Bo9kyq_standard\" data-component=\"CSSGrid.Standard\"><div class=\"Bo9kyq_m-full Bo9kyq_t-span-8 Bo9kyq_t-start-3 Bo9kyq_d-span-6 Bo9kyq_d-start-4 _2w9DrG_column\" data-component=\"CSSGrid.Item\"><h2 class=\"tOQyXa_headline-3 _2w9DrG_title\" data-component=\"Headline\">Explore the work</h2><p class=\"tOQyXa_body-3 _2w9DrG_intro\" data-component=\"Body\">Learn more about our research, policies, and programs. We plan to add to this record over time.</p></div></div></div><div class=\"_6VooCa_anchors\"><span id=\"pillar-1\" tabindex=\"-1\"></span><span id=\"pillar-2\" tabindex=\"-1\"></span><span id=\"pillar-3\" tabindex=\"-1\"></span><span id=\"pillar-4\" tabindex=\"-1\"></span><span id=\"pillar-5\" tabindex=\"-1\"></span></div><div class=\"V6KWnW_frame\"><span data-nav-hide-on-scroll=\"true\" hidden=\"\"></span><div class=\"P3ot9a_story  P3ot9a_d4 P3ot9a_prelude     P3ot9a_compact\"><div class=\"P3ot9a_stage\"><div class=\"j6pAcG_tour P3ot9a_modal P3ot9a_splash\" role=\"dialog\" aria-label=\"The public ledger\" data-ctrl=\"true\"><p class=\"P3ot9a_card P3ot9a_cardOn P3ot9a_modalText\">Our work under the charter, from 2021 to today — every paper, policy and product in one ledger.</p><div class=\"P3ot9a_splashWays\"><button type=\"button\" data-component=\"Button\" data-variant=\"secondary\" class=\"f9ZZrG_button f9ZZrG_corner-small f9ZZrG_variant-secondary f9ZZrG_size-small\">About the work</button><button type=\"button\" data-component=\"Button\" data-variant=\"primary\" class=\"f9ZZrG_button f9ZZrG_corner-small f9ZZrG_variant-primary f9ZZrG_size-small\">Explore the work</button></div></div></div></div></div></section><section id=\"report\" aria-label=\"Public Benefit Report\"><div class=\"theme-slate HZedEa_block\"><div class=\"Bo9kyq_container\" data-component=\"CSSGrid.Container\"><div class=\"Bo9kyq_standard\" data-component=\"CSSGrid.Standard\"><div class=\"Bo9kyq_m-full Bo9kyq_d-span-8 Bo9kyq_d-start-3\" data-component=\"CSSGrid.Item\"><figure class=\"HZedEa_figure\"><blockquote class=\"HZedEa_quote\"><div class=\"tOQyXa_headline-4--serif\" data-component=\"Headline\">Building advanced AI in a way that is safe, trustworthy, and accountable to the people it affects isn’t a niche concern or a competitive differentiator. It is a necessary step toward making the benefits real. We’re already seeing what’s possible—in research labs, in classrooms, and in the everyday work of people solving hard problems. If we get this right, I believe that some of humanity’s greatest moments await us on the other side.</div></blockquote><figcaption class=\"HZedEa_attribution\"><div class=\"tOQyXa_headline-4--serif\" data-component=\"Headline\">Daniela Amodei</div><div class=\"tOQyXa_headline-4--serif\" data-component=\"Headline\">Co-Founder and President, Anthropic</div></figcaption></figure><a data-component=\"AnchorButton\" data-variant=\"primary\" class=\"f9ZZrG_button f9ZZrG_corner-small f9ZZrG_variant-primary f9ZZrG_size-small f9ZZrG_icon-format-trailing HZedEa_report\" target=\"_blank\" rel=\"noopener\" href=\"/sites/anthropic/pages-assets/f367357e073e499ca43f.pdf\">Read our 2026 Public Benefit Report<span class=\"f9ZZrG_icon\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"currentColor\" xmlns=\"http://www.w3.org/2000/svg\" style=\"flex-shrink:0\" aria-hidden=\"true\"><path d=\"M16.5 13C16.7761 13 17 13.2239 17 13.5V15.5C17 16.3284 16.3284 17 15.5 17H4.5C3.67157 17 3 16.3284 3 15.5V13.5C3 13.2239 3.22386 13 3.5 13C3.77614 13 4 13.2239 4 13.5V15.5C4 15.7761 4.22386 16 4.5 16H15.5C15.7761 16 16 15.7761 16 15.5V13.5C16 13.2239 16.2239 13 16.5 13ZM10 3C10.2761 3 10.5 3.22386 10.5 3.5V12.1855L13.626 8.66797C13.8094 8.46166 14.1256 8.44275 14.332 8.62598C14.5383 8.80936 14.5573 9.12563 14.374 9.33203L10.374 13.832L10.2949 13.9033C10.21 13.9654 10.107 14 10 14C9.85718 14 9.72086 13.9388 9.62598 13.832L5.62598 9.33203L5.56738 9.25C5.45079 9.04872 5.48735 8.78653 5.66797 8.62598C5.84854 8.46567 6.1127 8.46039 6.29883 8.59961L6.37402 8.66797L9.5 12.1855V3.5C9.5 3.22386 9.72386 3 10 3Z\"></path></svg></span></a></div></div></div></div></section><div class=\"dYIffW_wash\" aria-hidden=\"true\"></div></div><!--$--><!--/$-->","canvases":0}